import Workspace.AlternatingSimple
import Workspace.OrbitBudget
import Mathlib.Data.Nat.Choose.Basic
import Mathlib.Data.Fintype.Powerset

/-!
# Lemma A.11: the three mathematical steps

1. `iso_reduction`: if actual automorphisms of `x` map onto `H₀/K`, then an
   `H₀`-transporter exists exactly when a `K`-transporter exists, and the
   `H₀`-automorphism group is generated by the `K`-automorphisms and those lifts.
2. `pure_alternating`: if `L ≤ Sym(Φ) × Sym(C)` restricts onto a group containing
   `Alt(Φ)` and `|C|! < |Alt(Φ)|`, then `L` contains `Alt(Φ) × 1`.
3. `orbit_half`: if `K` fixes a set `Φ` of more than half the ideal points, then each
   physical `K`-orbit above a Johnson block map with `1 ≤ h ≤ q/2` has at most half
   the points.
-/

namespace GI.LargeSymmetry

open Equiv

/-! ### Step 1: reduction to the kernel -/

section Reduction

variable {G Q X : Type*} [Group G] [Group Q] [MulAction G X]

/-- Paper: "any `H₀`-transporter can be multiplied on the source side by an
automorphism with the same image in `H₀/K`, leaving a `K`-transporter". Here
`H₀ = G`, `K = ker θ`, and `A` is a group of automorphisms of `x` mapping onto `Q`. -/
theorem iso_reduction (θ : G →* Q) (A : Subgroup G) (x : X) (hA : ∀ a ∈ A, a • x = x)
    (honto : ∀ y : Q, ∃ a ∈ A, θ a = y) (z : X) :
    (∃ g : G, g • x = z) ↔ ∃ k ∈ θ.ker, k • x = z := by
  constructor
  · rintro ⟨g, hg⟩
    obtain ⟨a, ha, hθ⟩ := honto (θ g)
    refine ⟨g * a⁻¹, ?_, ?_⟩
    · rw [MonoidHom.mem_ker, map_mul, map_inv, hθ, mul_inv_cancel]
    · have hx : a⁻¹ • x = x := by
        rw [inv_smul_eq_iff]; exact (hA a ha).symm
      rw [mul_smul, hx, hg]
  · rintro ⟨k, -, hk⟩
    exact ⟨k, hk⟩

/-- "`Aut_{H₀}(x) = ⟨Aut_K(x), a₁, a₂⟩`": every automorphism of `x` is a
`K`-automorphism times an element of `A`. -/
theorem aut_generation (θ : G →* Q) (A : Subgroup G) (x : X) (hA : ∀ a ∈ A, a • x = x)
    (honto : ∀ y : Q, ∃ a ∈ A, θ a = y) (g : G) :
    g • x = x ↔ ∃ k ∈ θ.ker, k • x = x ∧ ∃ a ∈ A, g = k * a := by
  constructor
  · intro hg
    obtain ⟨a, ha, hθ⟩ := honto (θ g)
    refine ⟨g * a⁻¹, ?_, ?_, a, ha, by group⟩
    · rw [MonoidHom.mem_ker, map_mul, map_inv, hθ, mul_inv_cancel]
    · have hx : a⁻¹ • x = x := by
        rw [inv_smul_eq_iff]; exact (hA a ha).symm
      rw [mul_smul, hx, hg]
  · rintro ⟨k, -, hk, a, ha, rfl⟩
    rw [mul_smul, hA a ha, hk]

/-- "If `t ∈ Iso_K(x, z)` is found, the full answer is `Aut_{H₀}(x) t`" (written for
left actions: `t · Aut_{H₀}(x)`). -/
theorem full_answer {x z : X} {t : G} (ht : t • x = z) (g : G) :
    g • x = z ↔ (t⁻¹ * g) • x = x := by
  rw [mul_smul, inv_smul_eq_iff, ht]

end Reduction

/-! ### Step 2: the pure supported alternating group -/

section Pure

variable {Φ C : Type*} [Fintype Φ] [DecidableEq Φ] [Fintype C] [DecidableEq C]

omit [DecidableEq C] in
/-- Paper: "`L` contains the pure supported `Alt(Φ) × 1_C`". The hypothesis
`|C|! < |Alt(Φ)|` is the paper's "`|Alt(Φ)| > |C|!` above the fixed base degree". -/
theorem pure_alternating (L : Subgroup (Perm Φ × Perm C)) (h5 : 5 ≤ Fintype.card Φ)
    (honto : ∀ σ ∈ alternatingGroup Φ, ∃ l ∈ L, l.1 = σ)
    (hsmall : (Fintype.card C).factorial < Nat.card (alternatingGroup Φ)) :
    ∀ σ ∈ alternatingGroup Φ, (σ, (1 : Perm C)) ∈ L := by
  classical
  letI : IsSimpleGroup (alternatingGroup Φ) := GI.AlternatingSimple.isSimple h5
  -- `E`: the elements of `L` whose `Φ`-part is even.
  let E : Subgroup (Perm Φ × Perm C) := L ⊓ (alternatingGroup Φ).comap (MonoidHom.fst _ _)
  let r : E →* alternatingGroup Φ :=
    { toFun := fun e => ⟨e.val.1, e.property.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hr : Function.Surjective r := by
    intro σ
    obtain ⟨l, hl, h1⟩ := honto σ.val σ.property
    exact ⟨⟨l, hl, by change l.1 ∈ alternatingGroup Φ; rw [h1]; exact σ.property⟩,
      Subtype.ext h1⟩
  let s : E →* Perm C := (MonoidHom.snd _ _).comp E.subtype
  -- `E_(C) = ker s` is normal in `E`, so its image is normal in `Alt(Φ)`.
  have hn : (s.ker.map r).Normal := (inferInstance : s.ker.Normal).map r hr
  rcases hn.eq_bot_or_eq_top with hbot | htop
  · -- "The first possibility would make `Alt(Φ)` a quotient of a subgroup of
    -- `Sym(C)`. This is impossible."
    exfalso
    have kills : s.rangeRestrict.ker ≤ r.ker := by
      intro e he
      have he' : e ∈ s.ker := by
        rw [MonoidHom.mem_ker] at he ⊢
        exact congrArg Subtype.val he
      have hm : r e ∈ s.ker.map r := ⟨e, he', rfl⟩
      rw [hbot] at hm
      exact hm
    let f := GI.HomDescent.factor s.rangeRestrict (MonoidHom.rangeRestrict_surjective s) r kills
    have hf : Function.Surjective f := GI.HomDescent.factor_surjective _ _ _ _ hr
    have h1 := Nat.card_le_card_of_surjective f hf
    have h2 : Nat.card s.range ≤ Nat.card (Perm C) :=
      Nat.card_le_card_of_injective _ Subtype.val_injective
    rw [Nat.card_perm, Nat.card_eq_fintype_card (α := C)] at h2
    omega
  · intro σ hσ
    have hm : (⟨σ, hσ⟩ : alternatingGroup Φ) ∈ s.ker.map r := by rw [htop]; trivial
    obtain ⟨e, he, hre⟩ := hm
    have h1 : e.val.1 = σ := congrArg Subtype.val hre
    have h2 : e.val.2 = 1 := he
    have : e.val = (σ, 1) := Prod.ext h1 h2
    rw [← this]
    exact e.property.1

end Pure

/-! ### Step 3: the physical half-degree bound -/

section Half

/-- `2 C(q-1, h-1) ≤ C(q, h)` for `1 ≤ h`, `2h ≤ q`: "the fraction of all Johnson
blocks containing `a` is `h/q ≤ 1/2`". -/
theorem choose_containing_half {q h : ℕ} (h1 : 1 ≤ h) (h2 : 2 * h ≤ q) :
    2 * (q - 1).choose (h - 1) ≤ q.choose h := by
  obtain ⟨q, rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  obtain ⟨h, rfl⟩ : ∃ h', h = h' + 1 := ⟨h - 1, by omega⟩
  simp only [Nat.add_sub_cancel]
  have e := Nat.add_one_mul_choose_eq q h
  -- `(q+1) C(q,h) = C(q+1,h+1) (h+1)`
  have : 2 * (h + 1) * q.choose h ≤ (q + 1) * q.choose h := Nat.mul_le_mul_right _ (by omega)
  nlinarith [Nat.zero_le (q.choose h)]

/-- `C(c, h) q ≤ c C(q, h)` for `c ≤ q`, `1 ≤ h`: "the fraction ... is at most `|C|/q`". -/
theorem choose_subset_fraction {c q h : ℕ} (hcq : c ≤ q) (h1 : 1 ≤ h) :
    c.choose h * q ≤ c * q.choose h := by
  obtain ⟨h, rfl⟩ : ∃ h', h = h' + 1 := ⟨h - 1, by omega⟩
  rcases Nat.eq_zero_or_pos c with rfl | hc
  · simp
  obtain ⟨c, rfl⟩ : ∃ c', c = c' + 1 := ⟨c - 1, by omega⟩
  obtain ⟨q, rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  have ec := Nat.add_one_mul_choose_eq c h
  have eq' := Nat.add_one_mul_choose_eq q h
  have hmono : c.choose h ≤ q.choose h := Nat.choose_le_choose h (by omega)
  -- `C(c+1,h+1)(h+1)(q+1) = (c+1) C(c,h) (q+1) ≤ (c+1) C(q,h) (q+1) = (c+1) C(q+1,h+1)(h+1)`
  have key : (c + 1).choose (h + 1) * (q + 1) * (h + 1) ≤
      (c + 1) * (q + 1).choose (h + 1) * (h + 1) := by
    calc (c + 1).choose (h + 1) * (q + 1) * (h + 1)
        = (c + 1) * c.choose h * (q + 1) := by rw [mul_right_comm, ← ec]
      _ ≤ (c + 1) * q.choose h * (q + 1) := by
        apply Nat.mul_le_mul_right; exact Nat.mul_le_mul_left _ hmono
      _ = (c + 1) * (q + 1).choose (h + 1) * (h + 1) := by
        rw [mul_assoc (c + 1), mul_comm (q.choose h), eq', mul_assoc]
  exact Nat.le_of_mul_le_mul_right key (by omega)

variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]

/-- The number of `h`-subsets `B` with `B ∩ Φ` prescribed is at most half of all
`h`-subsets, when `|Φ| > q/2`, `1 ≤ h ≤ q/2`. -/
theorem trace_count_half (Φ A : Finset Γ) {h : ℕ} (h1 : 1 ≤ h)
    (h2 : 2 * h ≤ Fintype.card Γ) (hΦ : Fintype.card Γ < 2 * Φ.card) :
    2 * ((Finset.univ : Finset Γ).powersetCard h |>.filter (fun B => B ∩ Φ = A ∩ Φ)).card ≤
      (Fintype.card Γ).choose h := by
  classical
  set q := Fintype.card Γ with hqdef
  by_cases hne : (A ∩ Φ).Nonempty
  · -- "If `A ∩ Φ` contains `a`, every block in the orbit contains this fixed point."
    obtain ⟨a, ha⟩ := hne
    have hsub : ((Finset.univ : Finset Γ).powersetCard h |>.filter (fun B => B ∩ Φ = A ∩ Φ)) ⊆
        ((Finset.univ.erase a).powersetCard (h - 1)).image (insert a) := by
      intro B hB
      simp only [Finset.mem_filter, Finset.mem_powersetCard] at hB
      have haB : a ∈ B := by
        have : a ∈ B ∩ Φ := hB.2 ▸ ha
        exact (Finset.mem_inter.mp this).1
      refine Finset.mem_image.mpr ⟨B.erase a, ?_, Finset.insert_erase haB⟩
      rw [Finset.mem_powersetCard]
      refine ⟨Finset.erase_subset_erase a (Finset.subset_univ B), ?_⟩
      rw [Finset.card_erase_of_mem haB, hB.1.2]
    have hcard := (Finset.card_le_card hsub).trans Finset.card_image_le
    rw [Finset.card_powersetCard, Finset.card_erase_of_mem (Finset.mem_univ a),
      Finset.card_univ] at hcard
    exact (Nat.mul_le_mul_left 2 hcard).trans (choose_containing_half h1 h2)
  · -- "If `A ∩ Φ = ∅`, the orbit stays among the `h`-subsets of `C`."
    have hempty : A ∩ Φ = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
    have hsub : ((Finset.univ : Finset Γ).powersetCard h |>.filter (fun B => B ∩ Φ = A ∩ Φ)) ⊆
        (Finset.univ \ Φ).powersetCard h := by
      intro B hB
      simp only [Finset.mem_filter, Finset.mem_powersetCard, hempty] at hB
      rw [Finset.mem_powersetCard]
      refine ⟨fun b hb => Finset.mem_sdiff.mpr ⟨Finset.mem_univ b, fun hbΦ => ?_⟩, hB.1.2⟩
      have : b ∈ B ∩ Φ := Finset.mem_inter.mpr ⟨hb, hbΦ⟩
      rw [hB.2] at this
      simp at this
    have hcard := Finset.card_le_card hsub
    rw [Finset.card_powersetCard, Finset.card_sdiff_of_subset (Finset.subset_univ Φ),
      Finset.card_univ, ← hqdef] at hcard
    have hfrac := choose_subset_fraction (Nat.sub_le q Φ.card) h1 (q := q)
    have hq : 0 < q := by omega
    -- `2 C(c,h) q ≤ 2 c C(q,h) < q C(q,h)`
    have : 2 * (q - Φ.card).choose h * q ≤ q.choose h * q := by
      have h3 : 2 * (q - Φ.card) ≤ q := by omega
      calc 2 * (q - Φ.card).choose h * q = 2 * ((q - Φ.card).choose h * q) := by ring
        _ ≤ 2 * ((q - Φ.card) * q.choose h) := Nat.mul_le_mul_left 2 hfrac
        _ = (2 * (q - Φ.card)) * q.choose h := by ring
        _ ≤ q * q.choose h := Nat.mul_le_mul_right _ h3
        _ = q.choose h * q := by ring
    have := Nat.le_of_mul_le_mul_right this hq
    omega

/-- **The physical half-degree bound of Lemma A.11.** `p : Ω → (Γ choose h)` is an
equivariant block map whose fibers all have size `f`, and `K` acts on `Γ` fixing
every point of `Φ`, `|Φ| > q/2`. Then every `K`-orbit on `Ω` has at most `|Ω|/2`
points. "The kernel need not be transitive in the fibers for this upper bound." -/
theorem orbit_half {G Ω : Type*} [Group G] [MulAction G Ω] [Fintype Ω] [DecidableEq Ω]
    (π : G →* Perm Γ) (p : Ω → Finset Γ) {h f : ℕ}
    (hp : ∀ (g : G) ω, p (g • ω) = (p ω).map (π g).toEmbedding)
    (hcard : ∀ ω, (p ω).card = h)
    (hfib : ∀ B : Finset Γ, B.card = h → (Finset.univ.filter fun ω => p ω = B).card = f)
    (h1 : 1 ≤ h) (h2 : 2 * h ≤ Fintype.card Γ) (Φ : Finset Γ)
    (hΦ : Fintype.card Γ < 2 * Φ.card) (K : Subgroup G) (hK : ∀ k ∈ K, ∀ a ∈ Φ, π k a = a)
    (ω : Ω) [Fintype (MulAction.orbit K ω)] :
    2 * Fintype.card (MulAction.orbit K ω) ≤ Fintype.card Ω := by
  classical
  set S := (Finset.univ : Finset Γ).powersetCard h |>.filter (fun B => B ∩ Φ = p ω ∩ Φ)
  -- Every block in the orbit has the same trace on `Φ`.
  have htrace : ∀ k ∈ K, p (k • ω) ∩ Φ = p ω ∩ Φ := by
    intro k hk
    ext b
    rw [hp, Finset.mem_inter, Finset.mem_inter, Finset.mem_map]
    constructor
    · rintro ⟨⟨a, ha, hab⟩, hb⟩
      have : a = b := (π k).injective (by rw [hK k hk b hb]; exact hab)
      exact ⟨this ▸ ha, hb⟩
    · rintro ⟨hb, hbΦ⟩
      exact ⟨⟨b, hb, hK k hk b hbΦ⟩, hbΦ⟩
  have horbit : Fintype.card (MulAction.orbit K ω) ≤
      (Finset.univ.filter fun ω' => p ω' ∈ S).card := by
    rw [← Set.toFinset_card]
    apply Finset.card_le_card
    intro x hx
    rw [Set.mem_toFinset] at hx
    obtain ⟨k, rfl⟩ := hx
    simp only [S, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_powersetCard,
      Finset.subset_univ]
    exact ⟨hcard _, htrace k.val k.property⟩
  have hS : (Finset.univ.filter fun ω' => p ω' ∈ S).card = S.card * f := by
    rw [Finset.card_eq_sum_card_fiberwise (f := p) (t := S) (fun x hx => by
      simpa using hx)]
    rw [Finset.sum_const_nat]
    intro B hB
    have hBh : B.card = h := (Finset.mem_powersetCard.mp (Finset.mem_filter.mp hB).1).2
    rw [← hfib B hBh]
    congr 1
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_iff_right_iff_imp]
    rintro rfl
    exact hB
  have hall : Fintype.card Ω = (Fintype.card Γ).choose h * f := by
    rw [← Finset.card_univ, Finset.card_eq_sum_card_fiberwise (f := p)
      (t := (Finset.univ : Finset Γ).powersetCard h) (fun x _ => by
        simp [Finset.mem_powersetCard, hcard x])]
    rw [Finset.sum_const_nat (m := f), Finset.card_powersetCard, Finset.card_univ]
    intro B hB
    rw [← hfib B (Finset.mem_powersetCard.mp hB).2]
  have hcount := trace_count_half Φ (p ω) h1 h2 hΦ
  rw [hall]
  calc 2 * Fintype.card (MulAction.orbit K ω) ≤ 2 * (S.card * f) := by
        rw [← hS]; exact Nat.mul_le_mul_left 2 horbit
    _ = (2 * S.card) * f := by ring
    _ ≤ _ := Nat.mul_le_mul_right f hcount

end Half

end GI.LargeSymmetry
