/-
The mathematics of the orbit algorithm with a transversal (`Workspace.Lang.Lib.OrbitT`).

A group `G = ⟨gs⟩ ≤ Sym(n)` acts on a type `X` through a function `act` (`IsAct`). The
algorithm keeps a list `L` of pairs `(y, t)` with `t ∈ G` and `t · x₀ = y`, whose points are
distinct (`Good`). It starts with `[(x₀, 1)]`. Step `i` takes the pair `L[i]` (if there is one)
and, for each generator `g`, adds the pair `(g · y, g t)` when the point `g · y` is new
(`addImg`, `procStep`). After `B` steps (`orbitPairs`), every pair of the list has been
processed when the orbit has at most `B` points, because the points of a good list lie in the
orbit and are distinct. Then the points of the list are closed under the generators, so they
form the whole orbit (`orbitPairs_spec`).
-/
module

public import Workspace.Lang.Lib.OrbitMath
public import Mathlib.Data.Set.Card

@[expose] public section

namespace GI.Lang

open Equiv

variable {n : ℕ} {X : Type}

/-- `act` is an action of `Sym(n)` on `X`. -/
structure IsAct (act : Perm (Fin n) → X → X) : Prop where
  one : ∀ x, act 1 x = x
  mul : ∀ g h x, act (g * h) x = act g (act h x)

/-- The orbit of `x₀` under the group generated by `gs`. -/
def actOrbit (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (x₀ : X) : Set X :=
  {y | ∃ g ∈ genGroup gs, act g x₀ = y}

/-- The pairs `(y, t)` of `L` have `t ∈ G` and `t · x₀ = y`, and their points are distinct. -/
def Good (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (x₀ : X)
    (L : List (X × Perm (Fin n))) : Prop :=
  (L.map Prod.fst).Nodup ∧ ∀ p ∈ L, p.2 ∈ genGroup gs ∧ act p.2 x₀ = p.1

variable [DecidableEq X]

/-- Add the image of the pair `p` under `g`, if its point is new. -/
def addImg (act : Perm (Fin n) → X → X) (p : X × Perm (Fin n)) (L : List (X × Perm (Fin n)))
    (g : Perm (Fin n)) : List (X × Perm (Fin n)) :=
  if L.findIdx (fun q => decide (q.1 = act g p.1)) < L.length then L
  else L ++ [(act g p.1, g * p.2)]

/-- Step `i`: add the images of the pair `L[i]` under all generators. -/
def procStep (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n)))
    (L : List (X × Perm (Fin n))) (i : ℕ) : List (X × Perm (Fin n)) :=
  if h : i < L.length then gs.foldl (addImg act L[i]) L else L

/-- The list after `B` steps. -/
def orbitPairs (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (x₀ : X) (B : ℕ) :
    List (X × Perm (Fin n)) :=
  (List.range B).foldl (procStep act gs) [(x₀, 1)]

/-! ### One image -/

theorem findIdx_lt_iff (L : List (X × Perm (Fin n))) (y : X) :
    L.findIdx (fun q => decide (q.1 = y)) < L.length ↔ y ∈ L.map Prod.fst := by
  rw [List.findIdx_lt_length]
  simp only [decide_eq_true_eq, List.mem_map]

theorem addImg_eq (act : Perm (Fin n) → X → X) (p : X × Perm (Fin n))
    (L : List (X × Perm (Fin n))) (g : Perm (Fin n)) :
    addImg act p L g = if act g p.1 ∈ L.map Prod.fst then L else L ++ [(act g p.1, g * p.2)] := by
  unfold addImg
  by_cases h : act g p.1 ∈ L.map Prod.fst
  · rw [if_pos ((findIdx_lt_iff L _).mpr h), if_pos h]
  · rw [if_neg (fun h' => h ((findIdx_lt_iff L _).mp h')), if_neg h]

theorem prefix_addImg (act : Perm (Fin n) → X → X) (p : X × Perm (Fin n))
    (L : List (X × Perm (Fin n))) (g : Perm (Fin n)) : L <+: addImg act p L g := by
  rw [addImg_eq]; split_ifs
  · exact List.prefix_refl _
  · exact List.prefix_append _ _

theorem mem_addImg (act : Perm (Fin n) → X → X) (p : X × Perm (Fin n))
    (L : List (X × Perm (Fin n))) (g : Perm (Fin n)) :
    act g p.1 ∈ (addImg act p L g).map Prod.fst := by
  rw [addImg_eq]; split_ifs with h
  · exact h
  · simp

theorem good_addImg {act : Perm (Fin n) → X → X} (hact : IsAct act) {gs : List (Perm (Fin n))}
    {x₀ : X} {L : List (X × Perm (Fin n))} (hL : Good act gs x₀ L) {p : X × Perm (Fin n)}
    (hp : p.2 ∈ genGroup gs ∧ act p.2 x₀ = p.1) {g : Perm (Fin n)} (hg : g ∈ gs) :
    Good act gs x₀ (addImg act p L g) := by
  rw [addImg_eq]; split_ifs with h
  · exact hL
  · refine ⟨?_, fun q hq => ?_⟩
    · rw [List.map_append, List.nodup_append]
      refine ⟨hL.1, by simp, ?_⟩
      simp only [List.map_cons, List.map_nil, List.mem_singleton]
      rintro a ha b rfl rfl
      exact h ha
    · rcases List.mem_append.mp hq with hq | hq
      · exact hL.2 q hq
      · rw [List.mem_singleton] at hq
        subst hq
        exact ⟨(genGroup gs).mul_mem (Subgroup.subset_closure hg) hp.1,
          by rw [hact.mul, hp.2]⟩

/-! ### All generators -/

theorem prefix_foldl_addImg (act : Perm (Fin n) → X → X) (p : X × Perm (Fin n))
    (hs : List (Perm (Fin n))) (L : List (X × Perm (Fin n))) :
    L <+: hs.foldl (addImg act p) L := by
  induction hs generalizing L with
  | nil => exact List.prefix_refl _
  | cons g hs ih => exact (prefix_addImg act p L g).trans (ih _)

theorem mem_foldl_addImg (act : Perm (Fin n) → X → X) (p : X × Perm (Fin n))
    (hs : List (Perm (Fin n))) (L : List (X × Perm (Fin n))) :
    ∀ g ∈ hs, act g p.1 ∈ (hs.foldl (addImg act p) L).map Prod.fst := by
  induction hs generalizing L with
  | nil => simp
  | cons g hs ih =>
    intro g' hg'
    rcases List.mem_cons.mp hg' with rfl | hg'
    · exact ((prefix_foldl_addImg act p hs (addImg act p L g')).map Prod.fst).subset
        (mem_addImg act p L g')
    · exact ih _ g' hg'

theorem good_foldl_addImg {act : Perm (Fin n) → X → X} (hact : IsAct act)
    {gs : List (Perm (Fin n))} {x₀ : X} {p : X × Perm (Fin n)}
    (hp : p.2 ∈ genGroup gs ∧ act p.2 x₀ = p.1) (hs : List (Perm (Fin n)))
    (hhs : ∀ g ∈ hs, g ∈ gs) {L : List (X × Perm (Fin n))} (hL : Good act gs x₀ L) :
    Good act gs x₀ (hs.foldl (addImg act p) L) := by
  induction hs generalizing L with
  | nil => exact hL
  | cons g hs ih =>
    exact ih (fun g' hg' => hhs g' (by simp [hg'])) (good_addImg hact hL hp (hhs g (by simp)))

/-! ### Steps -/

theorem prefix_procStep (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n)))
    (L : List (X × Perm (Fin n))) (i : ℕ) : L <+: procStep act gs L i := by
  unfold procStep; split_ifs
  · exact prefix_foldl_addImg _ _ _ _
  · exact List.prefix_refl _

theorem good_procStep {act : Perm (Fin n) → X → X} (hact : IsAct act)
    {gs : List (Perm (Fin n))} {x₀ : X} {L : List (X × Perm (Fin n))} (hL : Good act gs x₀ L)
    (i : ℕ) : Good act gs x₀ (procStep act gs L i) := by
  unfold procStep; split_ifs with h
  · exact good_foldl_addImg hact (hL.2 _ (List.getElem_mem h)) gs (fun _ h => h) hL
  · exact hL

/-- The pairs before position `i` have been processed. -/
def Closed (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (i : ℕ)
    (L : List (X × Perm (Fin n))) : Prop :=
  ∀ j (hj : j < L.length), j < i → ∀ g ∈ gs, act g L[j].1 ∈ L.map Prod.fst

theorem getElem_of_prefix {α : Type} {l l' : List α} (h : l <+: l') {j : ℕ} (hj : j < l.length) :
    l'[j]'(lt_of_lt_of_le hj h.length_le) = l[j] := by
  obtain ⟨t, rfl⟩ := h
  exact List.getElem_append_left hj

theorem closed_procStep (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (i : ℕ)
    (L : List (X × Perm (Fin n))) (hc : Closed act gs i L) :
    Closed act gs (i + 1) (procStep act gs L i) := by
  have hpre := prefix_procStep act gs L i
  intro j hj hji g hg
  by_cases hjL : j < L.length
  · rw [getElem_of_prefix hpre hjL]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hji with hji | rfl
    · exact (hpre.map Prod.fst).subset (hc j hjL hji g hg)
    · unfold procStep
      rw [dif_pos hjL]
      exact mem_foldl_addImg act _ gs L g hg
  · -- a pair added at step `i` sits at position `≥ |L|`, so `i < |L|` and `j > i`
    exfalso
    unfold procStep at hj
    split_ifs at hj with h
    · omega
    · omega

/-! ### The final list -/

theorem orbitPairs_succ (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (x₀ : X)
    (i : ℕ) : orbitPairs act gs x₀ (i + 1) = procStep act gs (orbitPairs act gs x₀ i) i := by
  simp [orbitPairs, List.range_succ, List.foldl_append]

theorem orbitPairs_inv {act : Perm (Fin n) → X → X} (hact : IsAct act)
    (gs : List (Perm (Fin n))) (x₀ : X) (i : ℕ) :
    Good act gs x₀ (orbitPairs act gs x₀ i) ∧ Closed act gs i (orbitPairs act gs x₀ i) ∧
      [(x₀, 1)] <+: orbitPairs act gs x₀ i := by
  induction i with
  | zero =>
    have e : orbitPairs act gs x₀ 0 = [(x₀, 1)] := rfl
    rw [e]
    refine ⟨⟨by simp, fun p hp => ?_⟩, fun j _ hj => absurd hj (Nat.not_lt_zero _),
      List.prefix_refl _⟩
    rw [List.mem_singleton] at hp
    subst hp
    exact ⟨(genGroup gs).one_mem, hact.one x₀⟩
  | succ i ih =>
    rw [orbitPairs_succ]
    exact ⟨good_procStep hact ih.1 i, closed_procStep act gs i _ ih.2.1,
      ih.2.2.trans (prefix_procStep _ _ _ _)⟩

omit [DecidableEq X] in
/-- The orbit is finite. -/
theorem actOrbit_finite (act : Perm (Fin n) → X → X) (gs : List (Perm (Fin n))) (x₀ : X) :
    (actOrbit act gs x₀).Finite := by
  have : actOrbit act gs x₀ = Set.range fun g : genGroup gs => act g x₀ := by
    ext y; simp [actOrbit]
  rw [this]; exact Set.finite_range _

/-- A good list has at most as many pairs as the orbit has points. -/
theorem Good.length_le {act : Perm (Fin n) → X → X} {gs : List (Perm (Fin n))} {x₀ : X}
    {L : List (X × Perm (Fin n))} (hL : Good act gs x₀ L) :
    L.length ≤ (actOrbit act gs x₀).ncard := by
  classical
  have hsub : ((L.map Prod.fst).toFinset : Set X) ⊆ actOrbit act gs x₀ := by
    intro y hy
    simp only [List.coe_toFinset, List.mem_map, Set.mem_setOf_eq] at hy
    obtain ⟨p, hp, rfl⟩ := hy
    exact ⟨p.2, (hL.2 p hp).1, (hL.2 p hp).2⟩
  have h1 := Set.ncard_le_ncard hsub (actOrbit_finite act gs x₀)
  rw [Set.ncard_coe_finset, List.toFinset_card_of_nodup hL.1, List.length_map] at h1
  exact h1

omit [DecidableEq X] in
/-- An injective map of a finite set into itself is onto, so its inverse maps the set into
itself too. -/
theorem mapsTo_inv_of_mapsTo {act : Perm (Fin n) → X → X} (hact : IsAct act) {T : Set X}
    (hT : T.Finite) {g : Perm (Fin n)} (hg : Set.MapsTo (act g) T T) :
    Set.MapsTo (act g⁻¹) T T := by
  have hinj : Set.InjOn (act g) T := fun a _ b _ hab => by
    have := congrArg (act g⁻¹) hab
    rwa [← hact.mul, ← hact.mul, inv_mul_cancel, hact.one, hact.one] at this
  have hbij := (hT.injOn_iff_bijOn_of_mapsTo hg).mp hinj
  intro y hy
  obtain ⟨x, hx, rfl⟩ := hbij.surjOn hy
  rwa [← hact.mul, inv_mul_cancel, hact.one]

omit [DecidableEq X] in
/-- A finite set that contains `x₀` and is mapped into itself by the generators contains the
orbit of `x₀`. -/
theorem orbit_subset_of_closed {act : Perm (Fin n) → X → X} (hact : IsAct act)
    {gs : List (Perm (Fin n))} {x₀ : X} {T : Set X} (hT : T.Finite) (h0 : x₀ ∈ T)
    (hc : ∀ g ∈ gs, Set.MapsTo (act g) T T) : actOrbit act gs x₀ ⊆ T := by
  rintro y ⟨h, hh, rfl⟩
  suffices H : Set.MapsTo (act h) T T from H h0
  induction hh using Subgroup.closure_induction'' with
  | mem g hg => exact hc g hg
  | inv_mem g hg => exact mapsTo_inv_of_mapsTo hact hT (hc g hg)
  | one => intro x hx; rwa [hact.one]
  | mul a b _ _ ha hb => intro x hx; rw [hact.mul]; exact ha (hb hx)

/-- **The orbit algorithm with a transversal.** If the orbit of `x₀` has at most `B` points,
the list after `B` steps has distinct points, which are exactly the orbit; each pair `(y, t)`
has `t ∈ G` and `t · x₀ = y`; and the list starts with `(x₀, 1)`. -/
theorem orbitPairs_spec {act : Perm (Fin n) → X → X} (hact : IsAct act)
    (gs : List (Perm (Fin n))) (x₀ : X) {B : ℕ} (hB : (actOrbit act gs x₀).ncard ≤ B) :
    Good act gs x₀ (orbitPairs act gs x₀ B) ∧
      (∀ y, y ∈ (orbitPairs act gs x₀ B).map Prod.fst ↔ y ∈ actOrbit act gs x₀) ∧
      [(x₀, 1)] <+: orbitPairs act gs x₀ B := by
  obtain ⟨hg, hc, hpre⟩ := orbitPairs_inv hact gs x₀ B
  refine ⟨hg, fun y => ⟨fun hy => ?_, fun hy => ?_⟩, hpre⟩
  · obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hy
    exact ⟨p.2, (hg.2 p hp).1, (hg.2 p hp).2⟩
  · set L := orbitPairs act gs x₀ B
    have hlen : L.length ≤ B := hg.length_le.trans hB
    have hT : ({y | y ∈ L.map Prod.fst} : Set X).Finite := (L.map Prod.fst).finite_toSet
    have h0 : x₀ ∈ L.map Prod.fst := (hpre.map Prod.fst).subset (by simp)
    refine orbit_subset_of_closed hact hT h0 (fun g hgs z hz => ?_) hy
    obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem (show z ∈ L.map Prod.fst from hz)
    rw [List.length_map] at hj
    simp only [List.getElem_map]
    exact hc j hj (by omega) g hgs

end GI.Lang
