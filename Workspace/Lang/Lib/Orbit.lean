/-
**Example: the orbits of a permutation group given by generators.**

`orbitFuns b` is a program of 32 functions at base `b`. On `encPerms gs` it returns the labels
`orbitLabels gs` of `Workspace.Lang.Lib.OrbitMath` as a list of numbers: entry `x` is the least
point of the orbit of `x` under the group generated by `gs`. So two points lie in the same orbit
if and only if their entries are equal (`orbits_spec`).

The program is built from the library: it maps `inverse` over the generators, starts from the
labels `range n`, and iterates `n * n + 1` rounds. A round is a `foldl` over the inverses `h` of
the generators, and each step is a `map` over the points that takes
`min (lab x) (lab (h x))`. Its cost is at most `orbitK * ((m + 1) * (n + 1)) ^ 5` for `m`
generators.
-/
module

public import Workspace.Lang.Lib.Perm
public import Workspace.Lang.Lib.OrbitMath

@[expose] public section

namespace GI.Lang

open GI.Machine (BinOp len len_le_self)
open GI.Cited (Val encPerm encPerms)
open Equiv

variable {n : ℕ}

theorem wt_encFun_le_sq (lab : Fin n → ℕ) (h : ∀ x, lab x ≤ n) :
    (encFun lab).wt ≤ 4 * (n + 1) ^ 2 := by
  have := wt_encFun_le lab h
  nlinarith

/-- The identity labels, as a value: the list `[0, …, n - 1]`. -/
theorem encFun_id : encFun (fun x : Fin n => (x : ℕ)) = natList (List.range n) := by
  rw [range_eq_encPerm_one]; rfl

/-! ### One step: `min (lab x) (lab (h x))` for every point -/

/-- On `[[lab, h], x]`: `min (lab x) (lab (h x))`. -/
def minF : Expr :=
  .letE (.get (.get (arg 0) (.nat 0)) (arg 1))
    (.letE (.get (.get (arg 0) (.nat 0)) (.get (.get (arg 0) (.nat 1)) (arg 1)))
      (.ite (.arith .lt (.var 2) (.var 1)) (.var 2) (.var 1)))

theorem minF_spec {P : Program} {f : ℕ} (hf : P.funs[f]? = some minF) (lab : Fin n → ℕ)
    (hlab : ∀ x, lab x ≤ n) (h : Perm (Fin n)) (x : Fin n) :
    FunDet P f (.list [.list [encFun lab, encPerm h], .nat x]) (.nat (minStep lab h x))
      (3000 * (n + 1) ^ 2) := by
  set A := Val.list [.list [encFun lab, encPerm h], .nat x] with hA
  have hu := Det.get' (P := P) (env := [A])
    (Det.get' (Det.arg' (j := 0) rfl) (Det.nat 0) rfl) (Det.arg' (j := 1) rfl)
    (encFun_getElem? lab x)
  have hv := Det.get' (P := P) (env := [A, .nat (lab x)])
    (Det.get' (Det.arg' (j := 0) rfl) (Det.nat 0) rfl)
    (Det.applyPerm (Det.get' (Det.arg' (j := 0) rfl) (Det.nat 1) rfl) (Det.arg' (j := 1) rfl))
    (encFun_getElem? lab (h x))
  have hc := Det.arith' (P := P) (env := [A, .nat (lab x), .nat (lab (h x))]) (op := .lt)
    (Det.var' (i := 2) rfl) (Det.var' (i := 1) rfl) rfl
  have hb := Det.ite' hc (Det.var' (i := 2) rfl) (Det.var' (i := 1) rfl)
  have hval : (if BinOp.eval .lt (lab (h x)) (lab x) = 0 then Val.nat (lab x)
      else .nat (lab (h x))) = .nat (minStep lab h x) := by
    simp only [BinOp.eval, minStep]
    by_cases hlt : lab (h x) < lab x
    · simp [hlt, min_eq_right hlt.le]
    · simp [hlt, min_eq_left (not_lt.mp hlt)]
  rw [hval] at hb
  refine FunDet.intro hf ((Det.letE hu (Det.letE hv hb)).mono ?_)
  have hE := wt_encFun_le_sq lab hlab
  have hP := wt_encPerm_le h
  have h1 := wt_list2_le (encFun lab) (encPerm h)
  have h2 := wt_list2_le (.list [encFun lab, encPerm h]) (.nat x)
  have h3 := wt_nat_le x
  have h4 := wt_nat_le (lab x)
  have h5 := wt_nat_le (lab (h x))
  have h6 := wt_nat_le (minStep lab h x)
  have h7 := wt_nat_le (h x)
  have := hlab x
  have := hlab (h x)
  have := x.isLt
  have := (h x).isLt
  have : minStep lab h x ≤ n := (min_le_left _ _).trans (hlab x)
  have h8 : BinOp.eval .lt (lab (h x)) (lab x) ≤ 1 := by
    simp only [BinOp.eval]; split_ifs <;> omega
  have e : (Val.list [Val.list [encFun lab, encPerm h], Val.nat x]).wt = A.wt := rfl
  have e2 : (encFun lab).wt = (Val.list ((List.finRange n).map fun i => Val.nat (lab i))).wt := rfl
  have e3 : (encPerm h).wt = (Val.list ((List.finRange n).map fun i => Val.nat (h i))).wt := rfl
  have hN : n + 1 ≤ (n + 1) ^ 2 := Nat.le_self_pow (by omega) _
  omega

end GI.Lang

namespace GI.Lang

open GI.Machine (BinOp len len_le_self)
open GI.Cited (Val encPerm encPerms)
open Equiv

variable {n : ℕ}

/-- `map minF`, at base `b` (four functions): on `[[lab, h], [0, …, n - 1]]`, the labels
`minStep lab h`. -/
def minMapFuns (b : ℕ) : List Expr := mapFuns b (b + 3) ++ [minF]

theorem sum_const_finRange (n C : ℕ) (f : Fin n → Val) :
    ((List.finRange n).map ((fun _ => C) ∘ f)).sum = n * C := by
  rw [show ((fun _ => C) ∘ f) = fun _ => C from rfl, List.map_const', List.sum_replicate,
    List.length_finRange, smul_eq_mul]

theorem minMap_spec {P : Program} {b : ℕ} (h : P.HasAt b (minMapFuns b)) (lab : Fin n → ℕ)
    (hlab : ∀ x, lab x ≤ n) (hp : Perm (Fin n)) :
    FunDet P b (.list [.list [encFun lab, encPerm hp], encFun fun x : Fin n => (x : ℕ)])
      (encFun (minStep lab hp)) (70000 * (n + 1) ^ 3) := by
  have hf : P.funs[b + 3]? = some minF := by
    simpa [minMapFuns, mapFuns, loopFuns] using h.right.single
  have hM := map_spec (c := .list [encFun lab, encPerm hp])
    (xs := (List.finRange n).map fun i : Fin n => Val.nat (i : ℕ)) h.left
    (R := fun x w => ∀ i : Fin n, x = .nat i → w = .nat (minStep lab hp i))
    (B := fun _ => 3000 * (n + 1) ^ 2) (by
      intro x hx
      obtain ⟨i, -, rfl⟩ := List.mem_map.mp hx
      refine FunAll.mono (minF_spec hf lab hlab hp i) fun w c hw => ⟨fun j hj => ?_, hw.2⟩
      have : j = i := Fin.ext (by simpa using hj.symm)
      rw [hw.1, this])
  refine hM.mono fun w cost hw => ?_
  obtain ⟨ws, rfl, hws, hc⟩ := hw
  have hws' : ws = (List.finRange n).map fun i => Val.nat (minStep lab hp i) :=
    forall₂_map_eq (h := hws) fun a _ w hw => hw a rfl
  subst hws'
  refine ⟨rfl, ?_⟩
  simp only [List.map_map, List.length_map, List.length_finRange, sum_const_finRange] at hc
  have h1 := wt_encFun_le_sq lab hlab
  have h2 := wt_encPerm_le hp
  have h3 := wt_encFun_le_sq (minStep lab hp) fun x => (min_le_left _ _).trans (hlab x)
  have h4 := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
  have h5 := wt_list2_le (encFun lab) (encPerm hp)
  have h6 := wt_list2_le (.list [encFun lab, encPerm hp]) (encFun fun x : Fin n => (x : ℕ))
  have e1 : (Val.list [.list [encFun lab, encPerm hp],
      .list ((List.finRange n).map fun i : Fin n => Val.nat (i : ℕ))]).wt =
    (Val.list [.list [encFun lab, encPerm hp], encFun fun x : Fin n => (x : ℕ)]).wt := rfl
  have e2 : (Val.list ((List.finRange n).map fun i => Val.nat (minStep lab hp i))).wt =
    (encFun (minStep lab hp)).wt := rfl
  rw [e1, e2] at hc
  have h7 : mapK * (n + 1) * ((Val.list [.list [encFun lab, encPerm hp],
      encFun fun x : Fin n => (x : ℕ)]).wt + (encFun (minStep lab hp)).wt + 1) ≤
      mapK * (n + 1) * (63 * (n + 1) ^ 2) := Nat.mul_le_mul_left _ (by
        have : 1 ≤ (n + 1) ^ 2 := Nat.one_le_pow _ _ (by omega)
        omega)
  have h8 : mapK * (n + 1) * (63 * (n + 1) ^ 2) = 63000 * (n + 1) ^ 3 := by
    simp only [mapK]; ring
  have h9 : n * (3000 * (n + 1) ^ 2) ≤ 3000 * (n + 1) ^ 3 := by
    rw [pow_succ]; nlinarith
  omega

/-- The step function of the round's `foldl`: on `[ids, lab, h]`, `minStep lab h`. -/
def stepF (mm : ℕ) : Expr := .call mm (mk2 (mk2 (arg 1) (arg 2)) (arg 0))

theorem stepF_spec {P : Program} {f mm : ℕ} (hf : P.funs[f]? = some (stepF mm))
    (hm : P.HasAt mm (minMapFuns mm)) (lab : Fin n → ℕ) (hlab : ∀ x, lab x ≤ n)
    (hp : Perm (Fin n)) :
    FunDet P f (.list [encFun fun x : Fin n => (x : ℕ), encFun lab, encPerm hp])
      (encFun (minStep lab hp)) (71000 * (n + 1) ^ 3) := by
  refine FunDet.intro hf ((Det.call (Det.mk2 (Det.mk2 (Det.arg' (rest := []) (j := 1) rfl)
    (Det.arg' (j := 2) rfl)) (Det.arg' (j := 0) rfl)) (minMap_spec hm lab hlab hp)).mono ?_)
  have h1 := wt_encFun_le_sq lab hlab
  have h2 := wt_encPerm_le hp
  have h3 := wt_encFun_le_sq (minStep lab hp) fun x => (min_le_left _ _).trans (hlab x)
  have h4 := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
  have h5 := wt_list2_le (encFun lab) (encPerm hp)
  have h6 := wt_list2_le (.list [encFun lab, encPerm hp]) (encFun fun x : Fin n => (x : ℕ))
  have h7 := wt_list3_le (encFun fun x : Fin n => (x : ℕ)) (encFun lab) (encPerm hp)
  have h8 : (n + 1) ^ 2 ≤ (n + 1) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  have h9 : 1 ≤ (n + 1) ^ 2 := Nat.one_le_pow _ _ (by omega)
  omega

/-! ### A round: a `foldl` of `stepF` over the inverses of the generators -/

/-- The round's `foldl`, at base `b` (four functions). -/
def roundFoldFuns (b mm : ℕ) : List Expr := foldlFuns b (b + 3) ++ [stepF mm]

/-- `S` bounds both the number of generators plus one and `n + 1`. -/
theorem wt_list_encPerms_le (hs : List (Perm (Fin n))) :
    (Val.list (hs.map encPerm)).wt ≤ 13 * ((hs.length + 1) * (n + 1)) ^ 2 := by
  have h1 := wt_list_le (hs.map encPerm)
  have h2 : ((hs.map encPerm).map Val.wt).sum ≤ hs.length * (4 * (n + 1) ^ 2) := by
    have := List.sum_le_card_nsmul ((hs.map encPerm).map Val.wt) (4 * (n + 1) ^ 2) (by
      simp only [List.map_map, List.mem_map, Function.comp_apply, forall_exists_index, and_imp]
      rintro _ g - rfl; exact wt_encPerm_le g)
    simpa using this
  simp only [List.length_map] at h1
  have h3 : (hs.length + 1) * (n + 1) ^ 2 ≤ ((hs.length + 1) * (n + 1)) ^ 2 := by
    rw [mul_pow]; exact Nat.mul_le_mul_right _ (Nat.le_self_pow (by omega) _)
  have h4 : 1 ≤ (n + 1) ^ 2 := Nat.one_le_pow _ _ (by omega)
  nlinarith

theorem foldl_minStep_bound (hs : List (Perm (Fin n))) {lab : Fin n → ℕ} (hlab : ∀ x, lab x ≤ n)
    (x : Fin n) : hs.foldl minStep lab x ≤ n :=
  (foldl_minStep_le hs lab x).trans (hlab x)

theorem roundFold_spec {P : Program} {b mm : ℕ} (h : P.HasAt b (roundFoldFuns b mm))
    (hm : P.HasAt mm (minMapFuns mm)) (hs : List (Perm (Fin n))) (lab : Fin n → ℕ)
    (hlab : ∀ x, lab x ≤ n) :
    FunDet P b (.list [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm), encFun lab])
      (encFun (orbitRound hs lab)) (130000 * ((hs.length + 1) * (n + 1)) ^ 3) := by
  have hf : P.funs[b + 3]? = some (stepF mm) := by
    simpa [roundFoldFuns, foldlFuns, loopFuns] using h.right.single
  have hF := foldl_spec h.left (c := encFun fun x : Fin n => (x : ℕ)) (xs := hs.map encPerm)
    (acc0 := encFun lab) (Inv := fun i acc => acc = encFun ((hs.take i).foldl minStep lab))
    (M := 4 * (n + 1) ^ 2) (B := fun _ => 71000 * (n + 1) ^ 3) (by simp)
    (fun i acc _ hacc => hacc ▸ wt_encFun_le_sq _ (foldl_minStep_bound _ hlab))
    (fun i acc hi hacc => by
      subst hacc
      have hi' : i < hs.length := by simpa using hi
      have e : (hs.map encPerm)[i] = encPerm hs[i] := List.getElem_map ..
      rw [e]
      refine FunAll.mono (stepF_spec hf hm _ (foldl_minStep_bound _ hlab) hs[i]) fun w c hw => ⟨?_, hw.2⟩
      beta_reduce
      rw [hw.1, List.take_add_one, List.getElem?_eq_getElem hi', Option.toList_some,
        List.foldl_append]
      rfl)
  refine hF.mono fun w cost hw => ?_
  obtain ⟨hw1, hc⟩ := hw
  simp only [List.length_map, Finset.sum_const, Finset.card_range, smul_eq_mul] at hc
  refine ⟨by rw [hw1, List.length_map, List.take_length]; rfl, ?_⟩
  have h1 := wt_encFun_le_sq lab hlab
  have h4 := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
  have h5 := wt_list_encPerms_le hs
  have h6 := wt_list3_le (encFun fun x : Fin n => (x : ℕ)) (.list (hs.map encPerm)) (encFun lab)
  set S := (hs.length + 1) * (n + 1) with hS
  have hNS : n + 1 ≤ S := Nat.le_mul_of_pos_left _ (by omega)
  have hmS : hs.length + 1 ≤ S := Nat.le_mul_of_pos_right _ (by omega)
  have hN2 : (n + 1) ^ 2 ≤ S ^ 2 := Nat.pow_le_pow_left hNS 2
  have hS1 : 1 ≤ S := le_trans (by omega) hNS
  have hS2 : S ≤ S ^ 2 := Nat.le_self_pow (by omega) _
  have h7 : loopModK * (hs.length + 1) * ((Val.list [encFun fun x : Fin n => (x : ℕ),
      .list (hs.map encPerm), encFun lab]).wt + hs.length + 4 * (n + 1) ^ 2 + 1) ≤
      loopModK * S * (59 * S ^ 2) :=
    Nat.mul_le_mul (Nat.mul_le_mul_left _ hmS) (by omega)
  have h8 : loopModK * S * (59 * S ^ 2) = 59000 * S ^ 3 := by simp only [loopModK]; ring
  have h9 : hs.length * (71000 * (n + 1) ^ 3) ≤ 71000 * S ^ 3 := by
    have : hs.length * (n + 1) ^ 3 ≤ S ^ 3 := by
      calc hs.length * (n + 1) ^ 3 ≤ (hs.length + 1) ^ 3 * (n + 1) ^ 3 :=
            Nat.mul_le_mul_right _ (le_trans (Nat.le_succ _) (Nat.le_self_pow (by norm_num) _))
        _ = S ^ 3 := by rw [hS, mul_pow]
    have e : hs.length * (71000 * (n + 1) ^ 3) = 71000 * (hs.length * (n + 1) ^ 3) := by ring
    omega
  omega

end GI.Lang

namespace GI.Lang

open GI.Machine (BinOp len len_le_self)
open GI.Cited (Val encPerm encPerms)
open Equiv

variable {n : ℕ}

/-! ### The inverses of the generators -/

/-- On `[c, encPerm g]`: `encPerm g⁻¹`. -/
def invWrapF (inv : ℕ) : Expr := .call inv (arg 1)

theorem invWrap_spec {P : Program} {f inv : ℕ} (hf : P.funs[f]? = some (invWrapF inv))
    (hinv : P.HasAt inv (invFuns inv)) (g : Perm (Fin n)) :
    FunDet P f (.list [.nat 0, encPerm g]) (encPerm g⁻¹) (100100 * (n + 1) ^ 4) := by
  refine FunDet.intro hf ((Det.call (Det.arg' (rest := []) (j := 1) rfl) (inv_spec hinv g)).mono ?_)
  have h1 := wt_encPerm_le g
  have h2 := wt_encPerm_le g⁻¹
  have h3 := wt_list2_le (.nat 0) (encPerm g)
  have h4 := wt_nat_le 0
  have h5 : (n + 1) ^ 2 ≤ (n + 1) ^ 4 := Nat.pow_le_pow_right (by omega) (by omega)
  have h6 : 1 ≤ (n + 1) ^ 2 := Nat.one_le_pow _ _ (by omega)
  simp only [invK]
  omega

/-- `map inverse`, at base `b` (sixteen functions): on `[0, [encPerm g | g ∈ gs]]`, the list of
the `encPerm g⁻¹`. -/
def invMapFuns (b : ℕ) : List Expr := mapFuns b (b + 3) ++ [invWrapF (b + 4)] ++ invFuns (b + 4)

theorem invMap_spec {P : Program} {b : ℕ} (h : P.HasAt b (invMapFuns b))
    (gs : List (Perm (Fin n))) :
    FunDet P b (.list [.nat 0, .list (gs.map encPerm)]) (.list ((gs.map (·⁻¹)).map encPerm))
      (200000 * ((gs.length + 1) * (n + 1)) ^ 4) := by
  have hf : P.funs[b + 3]? = some (invWrapF (b + 4)) := by
    simpa [mapFuns, loopFuns] using h.left.right.single
  have hinv : P.HasAt (b + 4) (invFuns (b + 4)) := by
    simpa [mapFuns, loopFuns, Nat.add_assoc] using h.right
  have hM := map_spec h.left.left (c := .nat 0) (xs := gs.map encPerm)
    (R := fun x w => ∀ g, x = encPerm g → w = encPerm g⁻¹)
    (B := fun _ => 100100 * (n + 1) ^ 4) (by
      intro x hx
      obtain ⟨g, -, rfl⟩ := List.mem_map.mp hx
      refine FunAll.mono (invWrap_spec hf hinv g) fun w c hw => ⟨fun g' hg' => ?_, hw.2⟩
      rw [hw.1, encPerm_injective hg'])
  refine FunAll.mono hM fun w cost hw => ?_
  obtain ⟨ws, rfl, hws, hc⟩ := hw
  have hws' : ws = gs.map fun g => encPerm g⁻¹ :=
    forall₂_map_eq (h := hws) fun a _ w hw => hw a rfl
  have e : gs.map (fun g => encPerm g⁻¹) = (gs.map (·⁻¹)).map encPerm := by
    rw [List.map_map]; rfl
  rw [hws', e] at hc ⊢
  refine ⟨rfl, ?_⟩
  rw [List.map_const', List.sum_replicate, List.length_map, smul_eq_mul] at hc
  have h1 := wt_list_encPerms_le gs
  have h2 := wt_list_encPerms_le (gs.map (·⁻¹))
  rw [List.length_map] at h2
  have h3 := wt_list2_le (.nat 0) (.list (gs.map encPerm))
  have h4 := wt_nat_le 0
  set S := (gs.length + 1) * (n + 1) with hS
  have hNS : n + 1 ≤ S := Nat.le_mul_of_pos_left _ (by omega)
  have hmS : gs.length + 1 ≤ S := Nat.le_mul_of_pos_right _ (by omega)
  have hS1 : 1 ≤ S := le_trans (by omega) hNS
  have hS2 : 1 ≤ S ^ 2 := Nat.one_le_pow _ _ hS1
  have h5 : mapK * (gs.length + 1) * ((Val.list [.nat 0, .list (gs.map encPerm)]).wt +
      (Val.list ((gs.map (·⁻¹)).map encPerm)).wt + 1) ≤ mapK * S * (60 * S ^ 2) :=
    Nat.mul_le_mul (Nat.mul_le_mul_left _ hmS) (by omega)
  have h6 : mapK * S * (60 * S ^ 2) ≤ 60000 * S ^ 4 := by
    have : S ^ 3 ≤ S ^ 4 := Nat.pow_le_pow_right hS1 (by omega)
    have e : mapK * S * (60 * S ^ 2) = 60000 * S ^ 3 := by simp only [mapK]; ring
    omega
  have h7 : gs.length * (100100 * (n + 1) ^ 4) ≤ 100100 * S ^ 4 := by
    have : gs.length * (n + 1) ^ 4 ≤ S ^ 4 := by
      calc gs.length * (n + 1) ^ 4 ≤ (gs.length + 1) ^ 4 * (n + 1) ^ 4 :=
            Nat.mul_le_mul_right _ (le_trans (Nat.le_succ _) (Nat.le_self_pow (by norm_num) _))
        _ = S ^ 4 := by rw [hS, mul_pow]
    have e : gs.length * (100100 * (n + 1) ^ 4) = 100100 * (gs.length * (n + 1) ^ 4) := by ring
    omega
  omega

/-! ### The rounds -/

/-- The body of the iteration: on `[[ids, invs], i, lab]`, one round. -/
def roundF (fold : ℕ) : Expr :=
  .call fold (mk3 (.get (arg 0) (.nat 0)) (.get (arg 0) (.nat 1)) (arg 2))

theorem roundF_spec {P : Program} {f fb mm : ℕ} (hf : P.funs[f]? = some (roundF fb))
    (hfold : P.HasAt fb (roundFoldFuns fb mm)) (hm : P.HasAt mm (minMapFuns mm))
    (hs : List (Perm (Fin n))) (lab : Fin n → ℕ) (hlab : ∀ x, lab x ≤ n) (i : ℕ) :
    FunDet P f (.list [.list [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)], .nat i,
        encFun lab]) (encFun (orbitRound hs lab))
      (130000 * ((hs.length + 1) * (n + 1)) ^ 3 + 1000 * (((hs.length + 1) * (n + 1)) ^ 2 + i + 1)) := by
  set c := Val.list [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)] with hc
  set A := Val.list [c, .nat i, encFun lab] with hA
  have g0 := Det.get' (P := P) (env := [A]) (Det.arg' (rest := []) (j := 0) rfl) (Det.nat 0)
    (show [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)][0]? = some _ from rfl)
  have g1 := Det.get' (P := P) (env := [A]) (Det.arg' (rest := []) (j := 0) rfl) (Det.nat 1)
    (show [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)][1]? = some _ from rfl)
  have g2 := Det.arg' (P := P) (rest := []) (vs := [c, .nat i, encFun lab]) (j := 2) rfl
  refine FunDet.intro hf ((Det.call (Det.mk3 g0 g1 g2) (roundFold_spec hfold hm hs lab hlab)).mono ?_)
  have e1 : (Val.list [c, .nat i, encFun lab]).wt = A.wt := rfl
  have e2 : (Val.list [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)]).wt = c.wt := rfl
  have h1 := wt_encFun_le_sq lab hlab
  have h2 := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
  have h3 := wt_encFun_le_sq (orbitRound hs lab) fun x => foldl_minStep_bound hs hlab x
  have h4 := wt_list_encPerms_le hs
  have h5 := wt_list2_le (encFun fun x : Fin n => (x : ℕ)) (.list (hs.map encPerm))
  have h6 := wt_list3_le c (.nat i) (encFun lab)
  have h7 := wt_list3_le (encFun fun x : Fin n => (x : ℕ)) (.list (hs.map encPerm)) (encFun lab)
  have h8 := wt_nat_le i
  set S := (hs.length + 1) * (n + 1) with hS
  have hNS : n + 1 ≤ S := Nat.le_mul_of_pos_left _ (by omega)
  have hN2 : (n + 1) ^ 2 ≤ S ^ 2 := Nat.pow_le_pow_left hNS 2
  omega

end GI.Lang

namespace GI.Lang

open GI.Machine (BinOp len len_le_self)
open GI.Cited (Val encPerm encPerms)
open Equiv

variable {n : ℕ}

/-! ### The iteration of the rounds -/

theorem orbit_iter_spec {P : Program} {b g fb mm : ℕ} (h : P.HasAt b (iterFuns b g))
    (hf : P.funs[g]? = some (roundF fb))
    (hfold : P.HasAt fb (roundFoldFuns fb mm)) (hm : P.HasAt mm (minMapFuns mm))
    (gs : List (Perm (Fin n))) :
    FunDet P b (.list [.list [encFun fun x : Fin n => (x : ℕ), .list ((gs.map (·⁻¹)).map encPerm)],
        .nat (n * n + 1), encFun fun x : Fin n => (x : ℕ)]) (encFun (orbitLabels gs))
      (400000 * ((gs.length + 1) * (n + 1)) ^ 5) := by
  generalize hS : (gs.length + 1) * (n + 1) = S
  set hs := gs.map (·⁻¹) with hhs
  have hlen : hs.length = gs.length := List.length_map _
  have hbound : ∀ i x, (orbitRound hs)^[i] (fun x : Fin n => (x : ℕ)) x ≤ n :=
    fun i x => (labelsOK_iterate gs i x).1.le
  have hI := iter_spec h (c := .list [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)])
    (k := n * n + 1) (acc0 := encFun fun x : Fin n => (x : ℕ))
    (Inv := fun i acc => acc = encFun ((orbitRound hs)^[i] fun x : Fin n => (x : ℕ)))
    (M := 4 * (n + 1) ^ 2)
    (B := fun _ => 130000 * S ^ 3 + 1000 * (S ^ 2 + (n * n + 1) + 1)) rfl
    (fun i acc _ hacc => hacc ▸ wt_encFun_le_sq _ (hbound i))
    (fun i acc hi hacc => by
      subst hacc
      refine FunAll.mono (roundF_spec hf hfold hm hs _ (hbound i) i) fun w c hw => ⟨?_, ?_⟩
      · beta_reduce
        rw [hw.1, Function.iterate_succ_apply']
      · have h1 : c ≤ 130000 * S ^ 3 + 1000 * (S ^ 2 + i + 1) := by
          have := hw.2
          rwa [hlen, hS] at this
        exact le_trans h1 (Nat.add_le_add_left (Nat.mul_le_mul_left _ (by omega)) _))
  refine FunAll.mono hI fun w cost hw => ⟨hw.1, ?_⟩
  have hc := hw.2
  rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at hc
  have h1 := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
  have h2 := wt_list_encPerms_le hs
  rw [hlen, hS] at h2
  have h3 := wt_list2_le (encFun fun x : Fin n => (x : ℕ)) (.list (hs.map encPerm))
  have h4 := wt_list3_le (.list [encFun fun x : Fin n => (x : ℕ), .list (hs.map encPerm)])
    (.nat (n * n + 1)) (encFun fun x : Fin n => (x : ℕ))
  have h5 := wt_nat_le (n * n + 1)
  have hNS : n + 1 ≤ S := hS ▸ Nat.le_mul_of_pos_left _ (by omega)
  have hS1 : 1 ≤ S := le_trans (by omega) hNS
  have hN2 : (n + 1) ^ 2 ≤ S ^ 2 := Nat.pow_le_pow_left hNS 2
  have hK : n * n + 1 ≤ S ^ 2 := le_trans (by nlinarith) hN2
  have hS23 : S ^ 2 ≤ S ^ 3 := Nat.pow_le_pow_right hS1 (by omega)
  have hS34 : S ^ 3 ≤ S ^ 4 := Nat.pow_le_pow_right hS1 (by omega)
  have hS45 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right hS1 (by omega)
  -- the rounds
  have h6 : (n * n + 1) * (130000 * S ^ 3 + 1000 * (S ^ 2 + (n * n + 1) + 1)) ≤
      S ^ 2 * (133000 * S ^ 3) :=
    Nat.mul_le_mul hK (by omega)
  have e6 : S ^ 2 * (133000 * S ^ 3) = 133000 * S ^ 5 := by ring
  -- the loop itself
  have h7 : loopModK * (n * n + 1 + 1) * ((Val.list [.list [encFun fun x : Fin n => (x : ℕ),
      .list (hs.map encPerm)], .nat (n * n + 1), encFun fun x : Fin n => (x : ℕ)]).wt +
      (n * n + 1) + 4 * (n + 1) ^ 2 + 1) ≤ loopModK * (2 * S ^ 2) * (120 * S ^ 2) :=
    Nat.mul_le_mul (Nat.mul_le_mul_left _ (by omega)) (by omega)
  have e7 : loopModK * (2 * S ^ 2) * (120 * S ^ 2) = 240000 * S ^ 4 := by
    simp only [loopModK]; ring
  omega

/-! ### The whole program -/

/-- The entry: on `encPerms gs = [n, gens]`, compute `ids = range n` and the inverses, then run
`n * n + 1` rounds starting from `ids`. -/
def orbitEntry (b : ℕ) : Expr :=
  .letE (.call (b + 1) (.get (.var 0) (.nat 0)))
    (.letE (.call (b + 4) (mk2 (.nat 0) (.get (.var 0) (.nat 1))))
      (.call (b + 20) (mk3 (mk2 (.var 1) (.var 2))
        (.arith .add (.arith .mul (.get (.var 0) (.nat 0)) (.get (.var 0) (.nat 0))) (.nat 1))
        (.var 1))))

/-- **The orbit program**, at base `b` (32 functions). -/
def orbitFuns (b : ℕ) : List Expr :=
  [orbitEntry b] ++ rangeFuns (b + 1) ++ invMapFuns (b + 4) ++ iterFuns (b + 20) (b + 23) ++
    [roundF (b + 24)] ++ roundFoldFuns (b + 24) (b + 28) ++ minMapFuns (b + 28)

theorem length_orbitFuns (b : ℕ) : (orbitFuns b).length = 32 := by
  simp [orbitFuns, rangeFuns, invMapFuns, mapFuns, loopFuns, invFuns, findFuns, iterFuns,
    roundFoldFuns, foldlFuns, minMapFuns]

/-- The constant of the cost bound of the orbit program. -/
def orbitK : ℕ := 1000000

/-- **The orbit program computes the orbit labels**, in polynomial cost: for `m` generators the
cost is at most `orbitK * ((m + 1) * (n + 1)) ^ 5`. -/
theorem orbitFuns_spec {P : Program} {b : ℕ} (h : P.HasAt b (orbitFuns b))
    (gs : List (Perm (Fin n))) :
    FunDet P b (encPerms gs) (encFun (orbitLabels gs))
      (orbitK * ((gs.length + 1) * (n + 1)) ^ 5) := by
  simp only [orbitFuns] at h
  have hentry : P.funs[b]? = some (orbitEntry b) := h.left.left.left.left.left.left.single
  have hrange : P.HasAt (b + 1) (rangeFuns (b + 1)) := by
    simpa using h.left.left.left.left.left.right
  have hinv : P.HasAt (b + 4) (invMapFuns (b + 4)) := by
    simpa [rangeFuns, loopFuns, Nat.add_assoc] using h.left.left.left.left.right
  have hiter : P.HasAt (b + 20) (iterFuns (b + 20) (b + 23)) := by
    simpa [rangeFuns, loopFuns, invMapFuns, mapFuns, invFuns, findFuns, Nat.add_assoc]
      using h.left.left.left.right
  have hround : P.funs[b + 23]? = some (roundF (b + 24)) := by
    simpa [rangeFuns, loopFuns, invMapFuns, mapFuns, invFuns, findFuns, iterFuns, Nat.add_assoc]
      using h.left.left.right.single
  have hfold : P.HasAt (b + 24) (roundFoldFuns (b + 24) (b + 28)) := by
    simpa [rangeFuns, loopFuns, invMapFuns, mapFuns, invFuns, findFuns, iterFuns, Nat.add_assoc]
      using h.left.right
  have hmin : P.HasAt (b + 28) (minMapFuns (b + 28)) := by
    simpa [rangeFuns, loopFuns, invMapFuns, mapFuns, invFuns, findFuns, iterFuns, roundFoldFuns,
      foldlFuns, Nat.add_assoc] using h.right
  set E := encPerms gs with hE
  set ids := encFun fun x : Fin n => (x : ℕ) with hids
  set invs := Val.list ((gs.map (·⁻¹)).map encPerm) with hinvs
  -- `range n`
  have hR : FunDet P (b + 1) (.nat n) ids (8000 * (n + 1) ^ 3) := by
    refine FunAll.mono (range_spec hrange n) fun w c hw => ⟨?_, ?_⟩
    · rw [hw.1, hids, encFun_id]
    · have hc := hw.2
      rw [hw.1, ← encFun_id] at hc
      have := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
      have := wt_nat_le n
      have h1 : loopModK * (n + 1) * ((Val.nat n).wt + n + (encFun fun x : Fin n => (x : ℕ)).wt
          + 1) ≤ loopModK * (n + 1) * (8 * (n + 1) ^ 2) := Nat.mul_le_mul_left _ (by nlinarith)
      have e : loopModK * (n + 1) * (8 * (n + 1) ^ 2) = 8000 * (n + 1) ^ 3 := by
        simp only [loopModK]; ring
      omega
  have d0 : Det P [E] (.get (.var 0) (.nat 0)) (.nat n) _ :=
    Det.get' (Det.var' (i := 0) rfl) (Det.nat 0) (show [Val.nat n, _][0]? = some _ from rfl)
  have d1 := Det.call d0 hR
  have d2 : Det P [E, ids] (.get (.var 0) (.nat 1)) (.list (gs.map encPerm)) _ :=
    Det.get' (Det.var' (i := 0) rfl) (Det.nat 1)
      (show [Val.nat n, .list (gs.map encPerm)][1]? = some _ from rfl)
  have d3 := Det.call (Det.mk2 (Det.nat 0) d2) (invMap_spec hinv gs)
  have d4 : Det P [E, ids, invs] (.get (.var 0) (.nat 0)) (.nat n) _ :=
    Det.get' (Det.var' (i := 0) rfl) (Det.nat 0) (show [Val.nat n, _][0]? = some _ from rfl)
  have d5 := Det.arith' (op := .add) (z := n * n + 1)
    (Det.arith' (op := .mul) (z := n * n) d4 d4 rfl) (Det.nat 1) rfl
  have d6 := Det.mk3 (Det.mk2 (Det.var' (P := P) (env := [E, ids, invs]) (i := 1) rfl)
    (Det.var' (i := 2) rfl)) d5 (Det.var' (i := 1) rfl)
  have d7 := Det.call d6 (orbit_iter_spec hiter hround hfold hmin gs)
  refine FunDet.intro hentry ((Det.letE d1 (Det.letE d3 d7)).mono ?_)
  -- the cost
  have w1 := wt_encFun_le_sq (fun x : Fin n => (x : ℕ)) fun x => x.isLt.le
  have w2 : (encFun (orbitLabels gs)).wt ≤ 4 * (n + 1) ^ 2 :=
    wt_encFun_le_sq (orbitLabels gs) fun x => (labelsOK_iterate gs _ x).1.le
  have eids : ids.wt = (encFun fun x : Fin n => (x : ℕ)).wt := rfl
  have einvs : invs.wt = (Val.list ((gs.map (·⁻¹)).map encPerm)).wt := rfl
  have w3 := wt_list_encPerms_le gs
  have w4 := wt_list_encPerms_le (gs.map (·⁻¹))
  rw [List.length_map] at w4
  have w5 := wt_list2_le (.nat n) (.list (gs.map encPerm))
  have w6 := wt_list2_le (.nat 0) (.list (gs.map encPerm))
  have w7 := wt_list2_le ids invs
  have w8 := wt_list3_le (.list [ids, invs]) (.nat (n * n + 1)) ids
  have w9 := wt_nat_le n
  have w10 := wt_nat_le 0
  have w11 := wt_nat_le (n * n + 1)
  have w12 := wt_nat_le 1
  have eE : E.wt = (Val.list [.nat n, .list (gs.map encPerm)]).wt := rfl
  generalize hS : (gs.length + 1) * (n + 1) = S at w3 w4 ⊢
  have hNS : n + 1 ≤ S := hS ▸ Nat.le_mul_of_pos_left _ (by omega)
  have hS1 : 1 ≤ S := le_trans (by omega) hNS
  have hN2 : (n + 1) ^ 2 ≤ S ^ 2 := Nat.pow_le_pow_left hNS 2
  have hN3 : (n + 1) ^ 3 ≤ S ^ 3 := Nat.pow_le_pow_left hNS 3
  have hK : n * n + 1 ≤ S ^ 2 := le_trans (by nlinarith) hN2
  have hS23 : S ^ 2 ≤ S ^ 3 := Nat.pow_le_pow_right hS1 (by omega)
  have hS34 : S ^ 3 ≤ S ^ 4 := Nat.pow_le_pow_right hS1 (by omega)
  have hS45 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right hS1 (by omega)
  have hS12 : S ≤ S ^ 2 := Nat.le_self_pow (by omega) _
  simp only [orbitK]
  omega

/-- **Orbits of a permutation group given by generators.** The orbit program, run on
`encPerms gs`, returns the list whose entry `x` is the least point of the orbit of `x` under the
group generated by `gs`. In particular, entries `x` and `y` are equal if and only if `y` is in the
orbit of `x`. The cost is at most `orbitK * ((m + 1) * (n + 1)) ^ 5` for `m` generators. -/
theorem orbits_spec {P : Program} {b : ℕ} (h : P.HasAt b (orbitFuns b))
    (gs : List (Perm (Fin n))) :
    ∃ lab : Fin n → ℕ, FunDet P b (encPerms gs) (encFun lab)
        (orbitK * ((gs.length + 1) * (n + 1)) ^ 5) ∧
      (∀ x y, lab x = lab y ↔ y ∈ genOrbit gs x) ∧
      ∀ x, ∃ hx : lab x < n, (⟨lab x, hx⟩ : Fin n) ∈ genOrbit gs x ∧
        ∀ y ∈ genOrbit gs x, lab x ≤ y :=
  ⟨orbitLabels gs, orbitFuns_spec h gs, orbitLabels_spec gs⟩

end GI.Lang
