/-
The mathematics of the orbit algorithm of `Workspace.Lang.Lib.Orbit`.

Each point `x` of `Fin n` carries a label, at first `x` itself. A round goes through the
inverses `h` of the generators and replaces every label `lab x` by `min (lab x) (lab (h x))`.
After `n * n + 1` rounds the labels no longer change: each round that changes them lowers their
sum, which starts below `n * n`. A label that no round changes is constant along every
generator, so it is constant on orbits; and every label is a point of the orbit of its point.
So the final label of `x` is the least point of the orbit of `x` (`orbitLabels_spec`).
-/
module

public import Mathlib.GroupTheory.Perm.Basic
public import Mathlib.GroupTheory.GroupAction.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Data.Fintype.Fin

@[expose] public section

namespace GI.Lang

variable {n : ℕ}

open Equiv

/-- One step of a round: lower each label to the label of its image under `h`. -/
def minStep (lab : Fin n → ℕ) (h : Perm (Fin n)) : Fin n → ℕ := fun x => min (lab x) (lab (h x))

/-- A round: one step for each permutation of `hs`. -/
def orbitRound (hs : List (Perm (Fin n))) (lab : Fin n → ℕ) : Fin n → ℕ := hs.foldl minStep lab

/-- The labels after `n * n + 1` rounds over the inverses of the generators. -/
def orbitLabels (gs : List (Perm (Fin n))) : Fin n → ℕ :=
  (orbitRound (gs.map (·⁻¹)))^[n * n + 1] fun x => x

/-- The group generated by `gs`. -/
abbrev genGroup (gs : List (Perm (Fin n))) : Subgroup (Perm (Fin n)) := Subgroup.closure {g | g ∈ gs}

/-- The orbit of `x` under the group generated by `gs`. -/
abbrev genOrbit (gs : List (Perm (Fin n))) (x : Fin n) : Set (Fin n) :=
  MulAction.orbit (genGroup gs) x

theorem mem_genOrbit {gs : List (Perm (Fin n))} {x y : Fin n} :
    y ∈ genOrbit gs x ↔ ∃ g ∈ genGroup gs, g x = y := by
  constructor
  · rintro ⟨⟨g, hg⟩, rfl⟩; exact ⟨g, hg, rfl⟩
  · rintro ⟨g, hg, rfl⟩; exact ⟨⟨g, hg⟩, rfl⟩

/-! ### Labels only go down -/

theorem foldl_minStep_le (hs : List (Perm (Fin n))) (lab : Fin n → ℕ) (x : Fin n) :
    hs.foldl minStep lab x ≤ lab x := by
  induction hs generalizing lab with
  | nil => exact le_rfl
  | cons h hs ih => exact (ih _).trans (min_le_left _ _)

/-- If a round leaves the labels unchanged, then every step does. -/
theorem minStep_eq_of_foldl_eq {hs : List (Perm (Fin n))} {lab : Fin n → ℕ}
    (heq : hs.foldl minStep lab = lab) : ∀ h ∈ hs, minStep lab h = lab := by
  induction hs generalizing lab with
  | nil => simp
  | cons h hs ih =>
    rw [List.foldl_cons] at heq
    have h1 : minStep lab h = lab := funext fun x => le_antisymm (min_le_left _ _) (by
      have := foldl_minStep_le hs (minStep lab h) x
      rw [heq] at this; exact this)
    rw [h1] at heq
    intro h' hh'
    rcases List.mem_cons.mp hh' with rfl | hh'
    · exact h1
    · exact ih heq h' hh'

/-- A round that changes the labels lowers their sum. -/
theorem sum_lt_of_round_ne {hs : List (Perm (Fin n))} {lab : Fin n → ℕ}
    (hne : orbitRound hs lab ≠ lab) :
    ∑ x, orbitRound hs lab x < ∑ x, lab x := by
  have hle : ∀ x, orbitRound hs lab x ≤ lab x := foldl_minStep_le hs lab
  obtain ⟨x, hx⟩ : ∃ x, orbitRound hs lab x ≠ lab x := by
    by_contra h; push_neg at h; exact hne (funext h)
  exact Finset.sum_lt_sum (fun x _ => hle x) ⟨x, Finset.mem_univ _, lt_of_le_of_ne (hle x) hx⟩

/-- After `n * n + 1` rounds from the identity labels, a round changes nothing. -/
theorem orbitLabels_fixed (gs : List (Perm (Fin n))) :
    orbitRound (gs.map (·⁻¹)) (orbitLabels gs) = orbitLabels gs := by
  set f := orbitRound (gs.map (·⁻¹))
  have hstart : ∑ x : Fin n, (x : ℕ) < n * n + 1 := by
    have : ∑ x : Fin n, (x : ℕ) ≤ ∑ _x : Fin n, n :=
      Finset.sum_le_sum fun x _ => x.isLt.le
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at this
    omega
  -- if no round in the first `k` fixes the labels, the sum drops by `k`
  by_contra hne
  have key : ∀ k ≤ n * n + 1, (∀ j < k, f (f^[j] fun x => (x : ℕ)) ≠ f^[j] fun x => x) →
      ∑ x, f^[k] (fun x => (x : ℕ)) x + k ≤ ∑ x : Fin n, (x : ℕ) := by
    intro k
    induction k with
    | zero => intro _ _; simp
    | succ k ih =>
      intro hk h
      have h1 := ih (by omega) fun j hj => h j (by omega)
      have h2 : ∑ x, f (f^[k] fun x => (x : ℕ)) x < ∑ x, f^[k] (fun x => (x : ℕ)) x :=
        sum_lt_of_round_ne (h k (by omega))
      rw [Function.iterate_succ_apply']
      omega
  have hall : ∀ j < n * n + 1, f (f^[j] fun x => (x : ℕ)) ≠ f^[j] fun x => x := by
    intro j hj hfix
    apply hne
    have : ∀ d, f^[j + d] (fun x => (x : ℕ)) = f^[j] fun x => x := by
      intro d
      induction d with
      | zero => rfl
      | succ d ih => rw [← Nat.add_assoc, Function.iterate_succ_apply', ih, hfix]
    show f (f^[n * n + 1] fun x => (x : ℕ)) = f^[n * n + 1] fun x => x
    rw [show n * n + 1 = j + (n * n + 1 - j) by omega, this]
    exact hfix
  have := key (n * n + 1) le_rfl hall
  omega

/-! ### Invariants of the labels -/

/-- Every label is below `n`, is a point of the orbit of its point, and is at most that
point. -/
def LabelsOK (gs : List (Perm (Fin n))) (lab : Fin n → ℕ) : Prop :=
  ∀ x, lab x < n ∧ (∃ y ∈ genOrbit gs x, (y : ℕ) = lab x) ∧ lab x ≤ x

theorem labelsOK_id (gs : List (Perm (Fin n))) : LabelsOK gs fun x => x :=
  fun x => ⟨x.isLt, ⟨x, MulAction.mem_orbit_self x, rfl⟩, le_rfl⟩

theorem LabelsOK.minStep {gs : List (Perm (Fin n))} {lab : Fin n → ℕ} (hl : LabelsOK gs lab)
    {h : Perm (Fin n)} (hh : h ∈ genGroup gs) : LabelsOK gs (GI.Lang.minStep lab h) := by
  intro x
  obtain ⟨h1, h2, h3⟩ := hl x
  obtain ⟨h4, ⟨y, hy, hy'⟩, h6⟩ := hl (h x)
  have h7 : genOrbit gs (h x) = genOrbit gs x := by
    have : h x = (⟨h, hh⟩ : genGroup gs) • x := rfl
    show MulAction.orbit (genGroup gs) _ = _
    rw [this, MulAction.orbit_smul]
  simp only [GI.Lang.minStep]
  rcases le_total (lab x) (lab (h x)) with hle | hle
  · rw [min_eq_left hle]; exact ⟨h1, h2, h3⟩
  · rw [min_eq_right hle]
    exact ⟨h4, ⟨y, h7 ▸ hy, hy'⟩, hle.trans h3⟩

theorem LabelsOK.foldl {gs : List (Perm (Fin n))} {lab : Fin n → ℕ} (hl : LabelsOK gs lab)
    {hs : List (Perm (Fin n))} (hhs : ∀ h ∈ hs, h ∈ genGroup gs) :
    LabelsOK gs (hs.foldl GI.Lang.minStep lab) := by
  induction hs generalizing lab with
  | nil => exact hl
  | cons h hs ih =>
    exact ih (hl.minStep (hhs h (by simp))) fun h' hh' => hhs h' (by simp [hh'])

theorem inv_mem_genGroup {gs : List (Perm (Fin n))} :
    ∀ h ∈ gs.map (·⁻¹), h ∈ genGroup gs := by
  intro h hh
  obtain ⟨g, hg, rfl⟩ := List.mem_map.mp hh
  exact (genGroup gs).inv_mem (Subgroup.subset_closure hg)

theorem labelsOK_iterate (gs : List (Perm (Fin n))) (k : ℕ) :
    LabelsOK gs ((orbitRound (gs.map (·⁻¹)))^[k] fun x => x) := by
  induction k with
  | zero => exact labelsOK_id gs
  | succ k ih =>
    rw [Function.iterate_succ_apply']
    exact ih.foldl inv_mem_genGroup

/-! ### Labels that a round fixes are constant on orbits -/

theorem const_of_fixed {gs : List (Perm (Fin n))} {lab : Fin n → ℕ}
    (hfix : orbitRound (gs.map (·⁻¹)) lab = lab) :
    ∀ g ∈ genGroup gs, ∀ y, lab (g y) = lab y := by
  have hsteps := minStep_eq_of_foldl_eq hfix
  -- each generator does not raise labels
  have hdown : ∀ g ∈ gs, ∀ y, lab (g y) ≤ lab y := by
    intro g hg y
    have := congrFun (hsteps g⁻¹ (List.mem_map.mpr ⟨g, hg, rfl⟩)) (g y)
    simp only [GI.Lang.minStep] at this
    rw [show g⁻¹ (g y) = y by simp] at this
    rw [← this]; exact min_le_right _ _
  -- so it keeps them, since some power of it is the identity
  have hgen : ∀ g ∈ gs, ∀ y, lab (g y) = lab y := by
    intro g hg y
    refine le_antisymm (hdown g hg y) ?_
    have hpow : ∀ j, lab ((g ^ (j + 1)) y) ≤ lab (g y) := by
      intro j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [pow_succ', Perm.mul_apply]
        exact (hdown g hg _).trans ih
    obtain ⟨k, hk, hgk⟩ := isOfFinOrder_of_finite g |>.exists_pow_eq_one
    have := hpow (k - 1)
    rw [Nat.sub_add_cancel hk, hgk, Perm.one_apply] at this
    exact this
  intro g hg
  induction hg using Subgroup.closure_induction with
  | mem g hg => exact hgen g hg
  | one => intro y; rfl
  | mul a b _ _ ha hb => intro y; rw [Perm.mul_apply, ha, hb]
  | inv a _ ha => intro y; rw [← ha (a⁻¹ y), show a (a⁻¹ y) = y by simp]

/-- **The orbit labels.** Two points get the same label if and only if they lie in the same
orbit of the group generated by `gs`, and the label of `x` is the least point of its orbit. -/
theorem orbitLabels_spec (gs : List (Perm (Fin n))) :
    (∀ x y, orbitLabels gs x = orbitLabels gs y ↔ y ∈ genOrbit gs x) ∧
      ∀ x, ∃ h : orbitLabels gs x < n, (⟨orbitLabels gs x, h⟩ : Fin n) ∈ genOrbit gs x ∧
        ∀ y ∈ genOrbit gs x, orbitLabels gs x ≤ y := by
  have hok : LabelsOK gs (orbitLabels gs) := labelsOK_iterate gs _
  have hconst := const_of_fixed (orbitLabels_fixed gs)
  have hsame : ∀ x y, y ∈ genOrbit gs x → orbitLabels gs y = orbitLabels gs x := by
    intro x y hy
    obtain ⟨g, hg, rfl⟩ := mem_genOrbit.mp hy
    exact hconst g hg x
  have hlab : ∀ x, (⟨orbitLabels gs x, (hok x).1⟩ : Fin n) ∈ genOrbit gs x := by
    intro x
    obtain ⟨-, ⟨y, hy, hy'⟩, -⟩ := hok x
    have : y = ⟨orbitLabels gs x, (hok x).1⟩ := Fin.ext hy'
    exact this ▸ hy
  refine ⟨fun x y => ⟨fun hxy => ?_, fun hy => (hsame x y hy).symm⟩, fun x => ?_⟩
  · have h2 := hlab x
    have h4 := hlab y
    have e : (⟨orbitLabels gs x, (hok x).1⟩ : Fin n) = ⟨orbitLabels gs y, (hok y).1⟩ := Fin.ext hxy
    rw [e] at h2
    -- `y` and `x` both have the orbit of their common label
    have o1 := MulAction.orbit_eq_iff.mpr h2
    have o2 := MulAction.orbit_eq_iff.mpr h4
    have : genOrbit gs y = genOrbit gs x := o2.symm.trans o1
    rw [← this]; exact MulAction.mem_orbit_self y
  · refine ⟨(hok x).1, hlab x, fun y hy => ?_⟩
    rw [← hsame x y hy]
    exact (hok y).2.2

end GI.Lang
