/-
**Generator reduction and the coset normal form.**

A step of the recursion that combines the answers of its children (the union of the pieces of
an aggregation, the products in a normalization or a dispatch) gets generating lists whose
length grows with the number of children. A canonical answer (`GI.Impl.AnsC`) may have at most
`n²` generators. This file shrinks a generating list to at most `n²` generators of the same
group.

**The doubling filter.** Go through the generators `σ₀, σ₁, …` in order and keep `σᵢ` only when
it is not in the group generated by the generators kept so far (one call of the cited
`Membership` algorithm per generator). The kept list generates the same group as the input
list, since a dropped generator lies in the group of the kept ones (`gens_keepList`). Each kept
generator at least doubles the order of the kept group (Lagrange,
`GI.CitedChecks.two_mul_card_le_of_lt`), so `2 ^ (number kept) ≤ |G| ≤ n! ≤ 2 ^ (n²)` and at
most `n²` generators are kept (`length_keepList_le`).

* `reduceFuns b j`: on a group value `encGroup gs`, the group value `encGroup (keepList gs)`
  (`reduce_spec`), at cost at most `(m + 1) memCost + reduceK ((m + 2) (n + 1))⁶` with
  `m = gs.length` and `memCost` the bound of one membership call (`memCost`).
* `cosetNFFuns b j`: on a coset-or-empty value (`CosetOrEmpty`), the same coset with at most
  `n²` generators (`CosetC`, `cosetNF_spec`).

The membership primitive must sit at index `j` of the program.
-/
module

public import Workspace.Lang.Prims.CosetOps
public import Workspace.Lang.Prims.PermGroups

@[expose] public section

namespace GI.Lang

open GI.Machine (BinOp len len_le_self)
open GI.Cited
open Equiv
open scoped Pointwise

variable {n : ℕ}

/-! ### The doubling filter as a function on lists -/

open Classical in
/-- One step of the filter: keep `σ` when it is not in the group of the kept list. -/
noncomputable def keepStep (kept : List (Perm (Fin n))) (σ : Perm (Fin n)) :
    List (Perm (Fin n)) :=
  if σ ∈ gens kept then kept else kept ++ [σ]

/-- The kept generators of `σ₀, σ₁, …`. -/
noncomputable def keepList (l : List (Perm (Fin n))) : List (Perm (Fin n)) := l.foldl keepStep []

/-- Adding a generator that lies in the group does not change the group. -/
theorem gens_append_cons_of_mem {a l : List (Perm (Fin n))} {σ : Perm (Fin n)}
    (h : σ ∈ gens a) : gens (a ++ σ :: l) = gens (a ++ l) := by
  have hal : gens a ≤ gens (a ++ l) :=
    Subgroup.closure_mono fun g hg => List.mem_append_left _ hg
  apply le_antisymm
  · rw [gens, Subgroup.closure_le]
    intro g hg
    simp only [Set.mem_setOf_eq, List.mem_append, List.mem_cons] at hg
    rcases hg with hg | rfl | hg
    · exact Subgroup.subset_closure (List.mem_append_left _ hg)
    · exact hal h
    · exact Subgroup.subset_closure (List.mem_append_right _ hg)
  · refine Subgroup.closure_mono fun g hg => ?_
    simp only [Set.mem_setOf_eq, List.mem_append, List.mem_cons] at hg ⊢
    tauto

/-- The filter keeps the group: the kept list after `l` generates the group of `kept ++ l`. -/
theorem gens_foldl_keepStep :
    ∀ (l kept : List (Perm (Fin n))), gens (l.foldl keepStep kept) = gens (kept ++ l)
  | [], kept => by simp
  | σ :: l, kept => by
    rw [List.foldl_cons, gens_foldl_keepStep l]
    unfold keepStep
    split_ifs with h
    · exact (gens_append_cons_of_mem h).symm
    · simp

/-- **The kept list generates the same group.** -/
theorem gens_keepList (l : List (Perm (Fin n))) : gens (keepList l) = gens l := by
  simp [keepList, gens_foldl_keepStep]

/-- Each kept generator at least doubles the order of the kept group. -/
theorem card_foldl_keepStep :
    ∀ (l kept : List (Perm (Fin n))), 2 ^ kept.length ≤ Nat.card (gens kept) →
      2 ^ (l.foldl keepStep kept).length ≤ Nat.card (gens (l.foldl keepStep kept))
  | [], _, h => h
  | σ :: l, kept, h => by
    rw [List.foldl_cons]
    apply card_foldl_keepStep l
    unfold keepStep
    split_ifs with hσ
    · exact h
    · have hle : gens kept ≤ gens (kept ++ [σ]) :=
        Subgroup.closure_mono fun g hg => List.mem_append_left _ hg
      have hmem : σ ∈ gens (kept ++ [σ]) := Subgroup.subset_closure (by simp)
      have hlt : gens kept < gens (kept ++ [σ]) := lt_of_le_of_ne hle fun e => hσ (e ▸ hmem)
      have := GI.CitedChecks.two_mul_card_le_of_lt hlt
      rw [List.length_append, List.length_singleton, pow_succ]
      omega

/-- **At most `n²` generators are kept**: `2 ^ (number kept) ≤ |G| ≤ n! ≤ 2 ^ (n²)`. -/
theorem length_foldl_keepStep_le (l : List (Perm (Fin n))) :
    (l.foldl keepStep []).length ≤ n ^ 2 := by
  have h := card_foldl_keepStep l [] Nat.card_pos
  have h2 : Nat.card (gens (l.foldl keepStep [])) ≤ 2 ^ (n ^ 2) := by
    have := Subgroup.card_le_of_le (le_top : gens (l.foldl keepStep []) ≤ ⊤)
    rw [Subgroup.card_top] at this
    exact this.trans (GI.CitedChecks.card_perm_le n)
  exact (Nat.pow_le_pow_iff_right (by norm_num)).mp (h.trans h2)

theorem length_keepList_le (l : List (Perm (Fin n))) : (keepList l).length ≤ n ^ 2 :=
  length_foldl_keepStep_le l

/-! ### The program -/

/-- The step of the filter, on `[c, acc, x]` with `acc = [n, L]`: `acc` when `x` lies in the
group generated by `L` (membership primitive at `j`), and `[n, L ++ [x]]` otherwise. -/
def keepStepE (j : ℕ) : Expr :=
  .ite (.prim j (mk2 (arg 1) (arg 2))) (arg 1)
    (mk2 (.get (arg 1) (.nat 0)) (.snoc (.get (arg 1) (.nat 1)) (arg 2)))

/-- The entry of the reduction, on `[n, L]`: fold the step over `L` from `[n, [L[0]]]`, the
group value of the empty list (the first entry of `L` is the identity). -/
def reduceEntry (b : ℕ) : Expr :=
  .call (b + 1) (mk3 .nil (.get (.var 0) (.nat 1))
    (mk2 (.get (.var 0) (.nat 0)) (mk1 (.get (.get (.var 0) (.nat 1)) (.nat 0)))))

/-- **The program of the reduction**, at base `b` (five functions), with the membership
primitive at index `j`. -/
def reduceFuns (b j : ℕ) : List Expr := [reduceEntry b] ++ foldlFuns (b + 1) (b + 4) ++ [keepStepE j]

/-- The cost of one membership call on a group with at most `n²` generators. -/
noncomputable def memCost (h : Membership) (n : ℕ) : ℕ :=
  (membershipPrim h).c * (400 * (n + 1) ^ 6) ^ (membershipPrim h).k

theorem encGroup_snoc (kept : List (Perm (Fin n))) (σ : Perm (Fin n)) :
    encGroup (kept ++ [σ]) = .list [.nat n, .list ((1 :: kept).map encPerm ++ [encPerm σ])] := by
  simp [encGroup, encPerms]

theorem wt_encGroup_sq {kept : List (Perm (Fin n))} (hl : kept.length ≤ n ^ 2) :
    (encGroup kept).wt ≤ 160 * (n + 1) ^ 6 := by
  have h1 := wt_encGroup_le kept
  have h2 : (kept.length + 2) * (n + 1) ≤ 2 * (n + 1) ^ 3 := by
    have e : (n + 1) ^ 3 = (n + 1) ^ 2 * (n + 1) := by ring
    have e2 : (n + 1) ^ 2 = n ^ 2 + 2 * n + 1 := by ring
    rw [e]
    exact le_trans (Nat.mul_le_mul_right _ (show kept.length + 2 ≤ 2 * (n + 1) ^ 2 by omega))
      (by rw [Nat.mul_assoc])
  have h3 : ((kept.length + 2) * (n + 1)) ^ 2 ≤ (2 * (n + 1) ^ 3) ^ 2 := Nat.pow_le_pow_left h2 2
  have e : (2 * (n + 1) ^ 3) ^ 2 = 4 * (n + 1) ^ 6 := by ring
  omega

/-- **One step of the filter.** -/
theorem keepStep_spec (h : Membership) {P : Program} {f j : ℕ}
    (hf : P.funs[f]? = some (keepStepE j)) (hj : P.prims[j]? = some (membershipPrim h))
    (c : Val) {kept : List (Perm (Fin n))} (hl : kept.length ≤ n ^ 2) (σ : Perm (Fin n)) :
    FunDet P f (.list [c, encGroup kept, encPerm σ]) (encGroup (keepStep kept σ))
      (memCost h n + 40 * (Val.list [c, encGroup kept, encPerm σ]).wt + 1000 * (n + 1) ^ 6) := by
  classical
  set A : List Val := [c, encGroup kept, encPerm σ] with hA
  have d1 := Det.arg' (P := P) (vs := A) (rest := []) (j := 1) (v := encGroup kept) rfl
  have d2 := Det.arg' (P := P) (vs := A) (rest := []) (j := 2) (v := encPerm σ) rfl
  have dm := Det.prim (P := P) (env := [.list A]) hj (Det.mk2 d1 d2)
    (membershipPrim_spec h ⟨kept, rfl, rfl⟩ σ).1
    (w := .nat (if σ ∈ gens kept then 1 else 0)) (fun w hw => by
      rcases (membershipPrim_spec h ⟨kept, rfl, rfl⟩ σ).2 w hw with ⟨rfl, hm⟩ | ⟨rfl, hm⟩
      · rw [if_pos hm]
      · rw [if_neg hm])
  have d0 := Det.get' d1 (Det.nat 0) (show [Val.nat n, .list ((1 :: kept).map encPerm)][0]? =
    some (.nat n) from rfl)
  have dL := Det.get' d1 (Det.nat 1) (show [Val.nat n, .list ((1 :: kept).map encPerm)][1]? =
    some (.list ((1 :: kept).map encPerm)) from rfl)
  have dE := Det.mk2 d0 (Det.snoc dL d2)
  rw [← encGroup_snoc] at dE
  have dI := Det.ite dm (v := encGroup (keepStep kept σ)) (fun hx => by
      have hm : σ ∈ gens kept := by by_contra hm; simp [hm] at hx
      unfold keepStep; rw [if_pos hm]; exact d1)
    (fun hx => by
      have hm : σ ∉ gens kept := by intro hm; simp [hm] at hx
      unfold keepStep; rw [if_neg hm]; exact dE)
  refine FunDet.intro hf (dI.mono ?_)
  clear dI dE dL d0 dm
  -- the weights
  have wA := wt_list3_le c (encGroup kept) (encPerm σ)
  have wA' : c.wt + (encGroup kept).wt + (encPerm σ).wt < (Val.list A).wt := by
    have := sum_wt_lt_wt_list A
    simpa [hA, Nat.add_assoc] using this
  have wG := wt_encGroup_sq hl
  have wσ := wt_encPerm_le σ
  have w2 := wt_list2_le (encGroup kept) (encPerm σ)
  have hsz := (Val.list [encGroup kept, encPerm σ]).size_le_wt
  have hb : (membershipPrim h).bound (.list [encGroup kept, encPerm σ]) ≤ memCost h n := by
    unfold Prim.bound memCost
    refine Nat.mul_le_mul_left _ (Nat.pow_le_pow_left ?_ _)
    have : (n + 1) ^ 2 ≤ (n + 1) ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
    have : 1 ≤ (n + 1) ^ 6 := Nat.one_le_pow _ _ (by omega)
    omega
  have wn := wt_nat_le n
  have wb : (Val.nat (if σ ∈ gens kept then 1 else 0)).wt ≤ 3 := by
    split_ifs <;> simp [wt_nat, GI.Machine.len_zero]
  -- the kept group after the step
  have hl' : (keepStep kept σ).length ≤ kept.length + 1 := by
    unfold keepStep; split_ifs <;> simp
  have wK : (encGroup (keepStep kept σ)).wt ≤ 360 * (n + 1) ^ 6 := by
    have h1 := wt_encGroup_le (keepStep kept σ)
    have h2 : ((keepStep kept σ).length + 2) * (n + 1) ≤ 3 * (n + 1) ^ 3 := by
      have e : (n + 1) ^ 3 = (n + 1) ^ 2 * (n + 1) := by ring
      have e2 : (n + 1) ^ 2 = n ^ 2 + 2 * n + 1 := by ring
      rw [e]
      exact le_trans (Nat.mul_le_mul_right _ (show (keepStep kept σ).length + 2 ≤ 3 * (n + 1) ^ 2
        by omega)) (by rw [Nat.mul_assoc])
    have h3 := Nat.pow_le_pow_left h2 2
    have e : (3 * (n + 1) ^ 3) ^ 2 = 9 * (n + 1) ^ 6 := by ring
    omega
  have wL := wt_list_snoc_le ((1 :: kept).map encPerm) (encPerm σ)
  have wLA : (Val.list ((1 :: kept).map encPerm)).wt < (encGroup kept).wt :=
    wt_le_wt_list (by simp)
  have w2' := wt_list2_le (.nat n) (.list ((1 :: kept).map encPerm ++ [encPerm σ]))
  have eA : (Val.list A).wt = (Val.list [c, encGroup kept, encPerm σ]).wt := rfl
  have eS : (encGroup (kept ++ [σ])).wt =
      (Val.list [.nat n, .list ((1 :: kept).map encPerm ++ [encPerm σ])]).wt := by
    rw [encGroup_snoc]
  have hn : n ≤ (n + 1) ^ 2 := by nlinarith
  have h26 : (n + 1) ^ 2 ≤ (n + 1) ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
  rw [Nat.max_eq_right (by omega)]
  omega

/-- The identity is dropped first: it lies in the trivial group. -/
theorem keepList_one_cons (gs : List (Perm (Fin n))) : keepList (1 :: gs) = keepList gs := by
  have : keepStep ([] : List (Perm (Fin n))) 1 = [] := by
    unfold keepStep; rw [if_pos (Subgroup.one_mem _)]
  simp only [keepList, List.foldl_cons, this]

/-- The constant of the reduction. -/
def reduceK : ℕ := 10 ^ 7

/-- The cost bound of the reduction of `m` generators of degree `n`. -/
noncomputable def reduceCost (h : Membership) (n m : ℕ) : ℕ :=
  (m + 1) * memCost h n + reduceK * ((m + 2) * (n + 1)) ^ 6

theorem le_T (m n : ℕ) : m + 2 ≤ (m + 2) * (n + 1) ∧ n + 1 ≤ (m + 2) * (n + 1) :=
  ⟨Nat.le_mul_of_pos_right _ (by omega), Nat.le_mul_of_pos_left _ (by omega)⟩

/-- **The reduction.** On a group value `encGroup gs`, the program returns the group value of
the kept list `keepList gs`: at most `n²` generators (`length_keepList_le`) of the same group
(`gens_keepList`). It makes one membership call per generator. -/
theorem reduce_spec (h : Membership) {P : Program} {b j : ℕ} (hP : P.HasAt b (reduceFuns b j))
    (hj : P.prims[j]? = some (membershipPrim h)) (gs : List (Perm (Fin n))) :
    FunDet P b (encGroup gs) (encGroup (keepList gs)) (reduceCost h n gs.length) := by
  simp only [reduceFuns] at hP
  have he : P.funs[b]? = some (reduceEntry b) := hP.left.left.single
  have hF : P.HasAt (b + 1) (foldlFuns (b + 1) (b + 4)) := by simpa using hP.left.right
  have hs : P.funs[b + 4]? = some (keepStepE j) := by
    simpa [foldlFuns, loopFuns, Nat.add_assoc] using hP.right.single
  set xs : List Val := (1 :: gs).map encPerm with hxs
  have hgv : encGroup gs = .list [.nat n, .list xs] := rfl
  have h0 : encGroup ([] : List (Perm (Fin n))) = .list [.nat n, .list [encPerm 1]] := rfl
  -- the argument of the fold
  have dX := Det.get' (P := P) (env := [encGroup gs]) (Det.var' (i := 0) rfl) (Det.nat 1)
    (show [Val.nat n, .list xs][1]? = some (.list xs) from rfl)
  have dN := Det.get' (P := P) (env := [encGroup gs]) (Det.var' (i := 0) rfl) (Det.nat 0)
    (show [Val.nat n, .list xs][0]? = some (.nat n) from rfl)
  have d1 := Det.get' dX (Det.nat 0) (show xs[0]? = some (encPerm 1) from rfl)
  have dA := Det.mk3 Det.nil dX (Det.mk2 dN (Det.mk1 d1))
  rw [← h0] at dA
  -- the fold
  have hfold := foldl_spec hF (c := .list []) (xs := xs) (acc0 := encGroup [])
    (Inv := fun i acc => acc = encGroup (((1 :: gs).take i).foldl keepStep []))
    (M := 160 * (n + 1) ^ 6) (B := fun _ => memCost h n + 30000 * (n + 1) ^ 6) rfl
    (fun i acc _ hacc => by
      rw [hacc]
      exact wt_encGroup_sq (length_foldl_keepStep_le _))
    (fun i acc hi hacc => by
      have hi' : i < (1 :: gs).length := by simpa [hxs] using hi
      have hx : xs[i] = encPerm ((1 :: gs)[i]'hi') := by simp only [hxs, List.getElem_map]
      rw [hacc, hx]
      refine FunAll.mono (keepStep_spec h hs hj (.list []) (length_foldl_keepStep_le _)
        ((1 :: gs)[i]'hi')) fun w cost hw => ⟨?_, ?_⟩
      · beta_reduce
        rw [hw.1, List.take_add_one, List.getElem?_eq_getElem hi', Option.toList_some,
          List.foldl_append]
        rfl
      · have w1 := wt_list3_le (.list []) (encGroup (((1 :: gs).take i).foldl keepStep []))
          (encPerm ((1 :: gs)[i]'hi'))
        have w2 := wt_encGroup_sq (length_foldl_keepStep_le (((1 :: gs).take i)))
        have w3 := wt_encPerm_le ((1 :: gs)[i]'hi')
        have w4 : (n + 1) ^ 2 ≤ (n + 1) ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
        have w5 : 1 ≤ (n + 1) ^ 6 := Nat.one_le_pow _ _ (by omega)
        have w0 : (Val.list []).wt = 4 := wt_list_nil
        have hc := hw.2
        beta_reduce
        omega)
  have hlen : xs.length = gs.length + 1 := by simp [hxs]
  rw [hlen] at hfold
  have hres : List.take (gs.length + 1) (1 :: gs) = 1 :: gs := List.take_of_length_le (by simp)
  refine FunDet.intro he ((Det.call dA (FunAll.mono hfold fun w cost hw => ⟨?_, hw.2⟩)).mono ?_)
  · rw [hw.1, hres, ← keepList_one_cons]; rfl
  -- the cost
  clear hfold dA d1 dN dX
  simp only [Finset.sum_const, Finset.card_range, smul_eq_mul]
  have wG := wt_encGroup_le gs
  have wX : (Val.list xs).wt < (encGroup gs).wt := by
    rw [hgv]; exact wt_le_wt_list (List.mem_cons_of_mem _ (List.mem_singleton_self _))
  have w0 := wt_encGroup_sq (n := n) (kept := []) (by simp)
  have wa := wt_list3_le (.list []) (.list xs) (encGroup ([] : List (Perm (Fin n))))
  have wK := wt_encGroup_sq (length_keepList_le gs)
  have wN := wt_nat_le n
  have wP1 := wt_encPerm_le (1 : Perm (Fin n))
  have wl1 := wt_list1_le (encPerm (1 : Perm (Fin n)))
  have wl2 := wt_list2_le (.nat n) (.list [encPerm (1 : Perm (Fin n))])
  have wx0 : (encPerm (1 : Perm (Fin n))).wt < (Val.list xs).wt :=
    wt_le_wt_list (by rw [hxs]; exact List.mem_cons_self ..)
  have eG : (encGroup gs).wt = (Val.list [.nat n, .list xs]).wt := rfl
  have eG' : (Val.list [Val.nat n, Val.list (List.map encPerm (1 :: gs))]).wt = (encGroup gs).wt := rfl
  have eX : (Val.list (List.map encPerm (1 :: gs))).wt = (Val.list xs).wt := rfl
  obtain ⟨hT1, hT2⟩ := le_T gs.length n
  unfold reduceCost
  generalize hT : (gs.length + 2) * (n + 1) = T at *
  have hn2 : (n + 1) ^ 2 ≤ T ^ 2 := Nat.pow_le_pow_left hT2 2
  have hn6 : (n + 1) ^ 6 ≤ T ^ 6 := Nat.pow_le_pow_left hT2 6
  have hT12 : T ≤ T ^ 2 := Nat.le_self_pow (by norm_num) _
  have hT26 : T ^ 2 ≤ T ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
  have hmT : (gs.length + 2) * T ^ 2 ≤ T ^ 6 := by
    calc (gs.length + 2) * T ^ 2 ≤ T * T ^ 2 := Nat.mul_le_mul_right _ hT1
      _ = T ^ 3 := by ring
      _ ≤ T ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
  have hm6 : (gs.length + 2) * (n + 1) ^ 6 ≤ T ^ 6 := by
    rw [← hT, mul_pow]
    exact Nat.mul_le_mul_right _ (Nat.le_self_pow (by norm_num) _)
  have e1 : (gs.length + 1) * (memCost h n + 30000 * (n + 1) ^ 6) =
      (gs.length + 1) * memCost h n + 30000 * ((gs.length + 1) * (n + 1) ^ 6) := by ring
  have e2 : (gs.length + 1) * (n + 1) ^ 6 ≤ (gs.length + 2) * (n + 1) ^ 6 :=
    Nat.mul_le_mul_right _ (by omega)
  have e3 : loopModK * (gs.length + 1 + 1) *
      ((Val.list [.list [], .list xs, encGroup ([] : List (Perm (Fin n)))]).wt + (gs.length + 1) + 160 * (n + 1) ^ 6 + 1) ≤
      1000 * (gs.length + 2) * (300 * T ^ 2 + 500 * (n + 1) ^ 6) := by
    simp only [loopModK]
    refine Nat.mul_le_mul (le_of_eq (by ring)) ?_
    simp only [wt_list_nil] at wa
    omega
  have e4 : 1000 * (gs.length + 2) * (300 * T ^ 2 + 500 * (n + 1) ^ 6) ≤ 800000 * T ^ 6 := by
    have : 1000 * (gs.length + 2) * (300 * T ^ 2 + 500 * (n + 1) ^ 6) =
        300000 * ((gs.length + 2) * T ^ 2) + 500000 * ((gs.length + 2) * (n + 1) ^ 6) := by ring
    omega
  have w00 : (Val.list []).wt = 4 := wt_list_nil
  simp only [reduceK]
  omega

/-! ### The coset normal form -/

/-- `u = []` and `C = ∅`, or `u` is a coset value of `C` with at most `n²` generators. -/
def CosetC (n : ℕ) (u : Val) (C : Set (Perm (Fin n))) : Prop :=
  (u = .list [] ∧ C = ∅) ∨ ∃ (x : Perm (Fin n)) (hs : List (Perm (Fin n))),
    u = .list [encPerm x, encGroup hs] ∧ hs.length ≤ n ^ 2 ∧
      C = x • (gens hs : Set (Perm (Fin n)))

theorem CosetC.cosetOrEmpty {u : Val} {C : Set (Perm (Fin n))} (h : CosetC n u C) :
    CosetOrEmpty n u C := by
  rcases h with h | ⟨x, hs, rfl, -, rfl⟩
  · exact Or.inl h
  · exact Or.inr ⟨x, hs, rfl, rfl⟩

/-- The body of the normal form: `[]` stays `[]`; `[x, gv]` becomes `[x, reduce gv]`. -/
def cosetNFE (b : ℕ) : Expr :=
  .ite (.length (.var 0)) (mk2 (.get (.var 0) (.nat 0)) (.call (b + 1) (.get (.var 0) (.nat 1))))
    (.var 0)

/-- **The program of the coset normal form**, at base `b` (six functions), with the membership
primitive at index `j`. -/
def cosetNFFuns (b j : ℕ) : List Expr := [cosetNFE b] ++ reduceFuns (b + 1) j

/-- The cost bound of the normal form of a value of weight `w`. -/
noncomputable def cosetNFCost (h : Membership) (n w : ℕ) : ℕ :=
  reduceCost h n w + 20 * w + 2000 * (n + 1) ^ 6

theorem reduceCost_mono (h : Membership) (n : ℕ) {m m' : ℕ} (hm : m ≤ m') :
    reduceCost h n m ≤ reduceCost h n m' := by
  unfold reduceCost
  have h1 : (m + 1) * memCost h n ≤ (m' + 1) * memCost h n := Nat.mul_le_mul_right _ (by omega)
  have h2 : ((m + 2) * (n + 1)) ^ 6 ≤ ((m' + 2) * (n + 1)) ^ 6 :=
    Nat.pow_le_pow_left (Nat.mul_le_mul_right _ (by omega)) 6
  have h3 := Nat.mul_le_mul_left reduceK h2
  omega

/-- **The coset normal form.** On a coset-or-empty value `v` of `C`, the program returns the
same coset with at most `n²` generators (`CosetC`): the generators are reduced by `reduceFuns`. -/
theorem cosetNF_spec (h : Membership) {P : Program} {b j : ℕ} (hP : P.HasAt b (cosetNFFuns b j))
    (hj : P.prims[j]? = some (membershipPrim h)) {v : Val} {C : Set (Perm (Fin n))}
    (hv : CosetOrEmpty n v C) :
    FunAll P b v (fun u cost => CosetC n u C ∧ cost ≤ cosetNFCost h n v.wt) := by
  simp only [cosetNFFuns] at hP
  have he : P.funs[b]? = some (cosetNFE b) := hP.left.single
  have hr : P.HasAt (b + 1) (reduceFuns (b + 1) j) := by simpa using hP.right
  have hpos : 1 ≤ (n + 1) ^ 6 := Nat.one_le_pow _ _ (by omega)
  rcases hv with ⟨rfl, rfl⟩ | ⟨x, gs, rfl, rfl⟩
  · refine FunAll.intro he ((Det.ite_zero (Det.length (Det.var' (P := P)
      (env := [.list []]) (i := 0) rfl)) (Det.var' (i := 0) rfl)).post fun c hc => ⟨Or.inl
        ⟨rfl, rfl⟩, ?_⟩)
    have w0 : (Val.list []).wt = 4 := wt_list_nil
    unfold cosetNFCost
    simp only [List.length_nil, w0] at hc ⊢
    omega
  · set vs : List Val := [encPerm x, encGroup gs] with hvs
    have dl := Det.length (Det.var' (P := P) (env := [.list vs]) (i := 0) rfl)
    have d0 := Det.get' (Det.var' (P := P) (env := [.list vs]) (i := 0) rfl) (Det.nat 0)
      (show vs[0]? = some (encPerm x) from rfl)
    have d1 := Det.get' (Det.var' (P := P) (env := [.list vs]) (i := 0) rfl) (Det.nat 1)
      (show vs[1]? = some (encGroup gs) from rfl)
    have dc := Det.call d1 (reduce_spec h hr hj gs)
    have dt := Det.ite_pos dl (by simp [hvs]) (Det.mk2 d0 dc) (e := .var 0)
    refine FunAll.intro he (dt.post fun c hc => ⟨Or.inr ⟨x, keepList gs, rfl,
      length_keepList_le gs, by rw [gens_keepList]⟩, ?_⟩)
    clear dt dc d1 d0 dl
    have hlen : gs.length ≤ (Val.list vs).wt := by
      have h1 := length_lt_wt_list ((1 :: gs).map encPerm)
      have h2 : (Val.list ((1 :: gs).map encPerm)).wt < (encGroup gs).wt :=
        wt_le_wt_list (List.mem_cons_of_mem _ (List.mem_singleton_self _))
      have h3 : (encGroup gs).wt < (Val.list vs).wt := wt_le_wt_list (by simp [hvs])
      simp only [List.length_map, List.length_cons] at h1
      omega
    have hm := reduceCost_mono h n hlen
    have wK := wt_encGroup_sq (length_keepList_le gs)
    have wx := wt_encPerm_le x
    have w2 := wt_list2_le (encPerm x) (encGroup (keepList gs))
    have wx' : (encPerm x).wt < (Val.list vs).wt := wt_le_wt_list (by simp [hvs])
    have wg' : (encGroup gs).wt < (Val.list vs).wt := wt_le_wt_list (by simp [hvs])
    have h26 : (n + 1) ^ 2 ≤ (n + 1) ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
    have e : (Val.list [encPerm x, encGroup gs]).wt = (Val.list vs).wt := rfl
    unfold cosetNFCost
    simp only [hvs, List.length_cons, List.length_nil] at hc
    omega

end GI.Lang
