/-
**The action on blocks, as permutations of the points.**

A partition of `Fin n` is given by representative labels `r : Fin n → Fin n` (`r i` is a point of
the class of `i`, and `r (r i) = r i`). A permutation `g` that preserves the partition
(`g ∈ presR r`) permutes the classes; `hat r g` records this action on the representatives:
it sends a representative `y` to the representative `r (g y)` of the class of `g y`, and fixes
every other point. So `hat r` is a homomorphism on `presR r` (`hat_mul`), its kernel is the
kernel of the action on the classes (`hat_eq_one_iff`), and `hat r g (r a) = r (g a)`
(`hat_apply_rep`).

`psi r g = g ⊕ hat r g` is the graph of `hat r`, a permutation of `Fin n ⊕ Fin n`; the graph
group of `G` is generated by the `psi r g` for generators `g` of `G` (`mem_closure_image_of_mul`). The
preimage task applied to this graph group computes kernels and block stabilizers
(`Workspace.Lang.Prims.Blocks`).
-/
module

public import Workspace.Lang.Prims.Ops

@[expose] public section

namespace GI.Lang

open GI.Cited
open Equiv

variable {n : ℕ}

/-- The permutations that preserve the partition with representative labels `r`. -/
def presR (r : Fin n → Fin n) : Subgroup (Perm (Fin n)) where
  carrier := {g | ∀ i j, r (g i) = r (g j) ↔ r i = r j}
  one_mem' := fun i j => Iff.rfl
  mul_mem' := fun {a b} ha hb i j => by
    simp only [Perm.mul_apply]
    exact (ha (b i) (b j)).trans (hb i j)
  inv_mem' := fun {a} ha i j => by
    have := ha (a⁻¹ i) (a⁻¹ j)
    simp only [← Perm.mul_apply, mul_inv_cancel, Perm.one_apply] at this
    exact this.symm

/-- The action of `g` on the representatives, as a function. -/
def hatFun (r : Fin n → Fin n) (g : Perm (Fin n)) (y : Fin n) : Fin n :=
  if r y = y then r (g y) else y

/-- `r` is a representative labeling: `r (r i) = r i`. -/
def IsRepr (r : Fin n → Fin n) : Prop := ∀ i, r (r i) = r i

theorem hatFun_injective {r : Fin n → Fin n} (hr : IsRepr r) {g : Perm (Fin n)}
    (hg : g ∈ presR r) : Function.Injective (hatFun r g) := by
  intro a b hab
  unfold hatFun at hab
  by_cases ha : r a = a <;> by_cases hb : r b = b <;> simp only [ha, hb, if_true, if_false] at hab
  · rw [← ha, ← hb]; exact (hg a b).mp hab
  · exact absurd (by rw [← hab, hr]) hb
  · exact absurd (by rw [hab, hr]) ha
  · exact hab

open Classical in
/-- The action of `g` on the representatives, as a permutation (the identity when `r` is not a
representative labeling or `g` does not preserve the partition). -/
noncomputable def hat (r : Fin n → Fin n) (g : Perm (Fin n)) : Perm (Fin n) :=
  if h : IsRepr r ∧ g ∈ presR r then
    Equiv.ofBijective _ (Finite.injective_iff_bijective.mp (hatFun_injective h.1 h.2))
  else 1

theorem hat_apply {r : Fin n → Fin n} (hr : IsRepr r) {g : Perm (Fin n)} (hg : g ∈ presR r)
    (y : Fin n) : hat r g y = hatFun r g y := by
  simp only [hat, dif_pos (And.intro hr hg), Equiv.ofBijective_apply]

theorem hat_apply_rep {r : Fin n → Fin n} (hr : IsRepr r) {g : Perm (Fin n)} (hg : g ∈ presR r)
    (a : Fin n) : hat r g (r a) = r (g a) := by
  rw [hat_apply hr hg, hatFun, if_pos (hr a)]
  exact (hg (r a) a).mpr (hr a)

theorem hat_one {r : Fin n → Fin n} (hr : IsRepr r) : hat r 1 = 1 := by
  ext y
  rw [hat_apply hr (presR r).one_mem, hatFun]
  split_ifs with h <;> simp [h]

theorem hat_mul {r : Fin n → Fin n} (hr : IsRepr r) {a b : Perm (Fin n)} (ha : a ∈ presR r)
    (hb : b ∈ presR r) : hat r (a * b) = hat r a * hat r b := by
  ext y
  rw [Perm.mul_apply, hat_apply hr ((presR r).mul_mem ha hb), hat_apply hr hb, hat_apply hr ha]
  unfold hatFun
  by_cases hy : r y = y
  · rw [if_pos hy, if_pos hy, if_pos (hr _), Perm.mul_apply]
    exact congrArg Fin.val ((ha (r (b y)) (b y)).mpr (hr _)).symm
  · rw [if_neg hy, if_neg hy, if_neg hy]

theorem hat_eq_one_iff {r : Fin n → Fin n} (hr : IsRepr r) {g : Perm (Fin n)}
    (hg : g ∈ presR r) : hat r g = 1 ↔ ∀ i, r (g i) = r i := by
  constructor
  · intro h i
    have := congrArg (fun σ : Perm (Fin n) => σ (r i)) h
    simp only [hat_apply_rep hr hg, Perm.coe_one, id] at this
    exact this
  · intro h
    ext y
    rw [hat_apply hr hg, hatFun]
    split_ifs with hy
    · rw [h y, hy]; rfl
    · rfl

/-- The graph of `hat r`: `g ⊕ hat r g`. -/
noncomputable def psi (r : Fin n → Fin n) (g : Perm (Fin n)) : Perm (Fin n ⊕ Fin n) :=
  Equiv.sumCongr g (hat r g)

theorem psi_mul {r : Fin n → Fin n} (hr : IsRepr r) {a b : Perm (Fin n)} (ha : a ∈ presR r)
    (hb : b ∈ presR r) : psi r (a * b) = psi r a * psi r b := by
  rw [psi, psi, psi, Perm.sumCongr_mul, hat_mul hr ha hb]

theorem psi_one {r : Fin n → Fin n} (hr : IsRepr r) : psi r 1 = 1 := by
  rw [psi, hat_one hr]; exact Perm.sumCongr_one

theorem sumCongr_inj {a b c d : Perm (Fin n)} (h : Equiv.sumCongr a b = Equiv.sumCongr c d) :
    a = c ∧ b = d := by
  constructor
  · refine Equiv.ext fun i => ?_
    have := congrArg (fun σ : Perm (Fin n ⊕ Fin n) => σ (Sum.inl i)) h
    simpa using this
  · refine Equiv.ext fun i => ?_
    have := congrArg (fun σ : Perm (Fin n ⊕ Fin n) => σ (Sum.inr i)) h
    simpa using this

/-! ### Closures of images -/

/-- **The subgroup generated by images.** If `f` is multiplicative on a subgroup that contains
the generators `gs`, the subgroup generated by the `f g`, `g ∈ gs`, is the image of `⟨gs⟩`. -/
theorem mem_closure_image_of_mul {M : Type*} [Group M] (K : Subgroup (Perm (Fin n)))
    (f : Perm (Fin n) → M) (hf : ∀ a ∈ K, ∀ b ∈ K, f (a * b) = f a * f b)
    {gs : List (Perm (Fin n))} (hgs : ∀ g ∈ gs, g ∈ K) (x : M) :
    x ∈ Subgroup.closure {y | ∃ g ∈ gs, f g = y} ↔ ∃ g ∈ gens gs, f g = x := by
  have hle : gens gs ≤ K := by
    unfold gens; rw [Subgroup.closure_le]; exact fun g hg => hgs g hg
  have f1 : f 1 = 1 := by
    have h := hf 1 K.one_mem 1 K.one_mem
    rw [mul_one] at h
    exact mul_left_cancel (h.symm.trans (mul_one (f 1)).symm)
  have finv : ∀ g ∈ K, f g⁻¹ = (f g)⁻¹ := fun g hg => by
    have h := hf g⁻¹ (K.inv_mem hg) g hg
    rw [inv_mul_cancel, f1] at h
    exact eq_inv_of_mul_eq_one_left h.symm
  constructor
  · intro hx
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨g, hg, rfl⟩ := hy
      exact ⟨g, Subgroup.subset_closure hg, rfl⟩
    | one => exact ⟨1, Subgroup.one_mem _, f1⟩
    | mul y z _ _ ihy ihz =>
      obtain ⟨a, ha, rfl⟩ := ihy
      obtain ⟨b, hb, rfl⟩ := ihz
      exact ⟨a * b, Subgroup.mul_mem _ ha hb, hf a (hle ha) b (hle hb)⟩
    | inv y _ ihy =>
      obtain ⟨a, ha, rfl⟩ := ihy
      exact ⟨a⁻¹, Subgroup.inv_mem _ ha, finv a (hle ha)⟩
  · rintro ⟨g, hg, rfl⟩
    induction hg using Subgroup.closure_induction with
    | mem y hy => exact Subgroup.subset_closure ⟨y, hy, rfl⟩
    | one => rw [f1]; exact Subgroup.one_mem _
    | mul a b ha hb iha ihb =>
      rw [hf a (hle ha) b (hle hb)]; exact Subgroup.mul_mem _ iha ihb
    | inv a ha iha =>
      rw [finv a (hle ha)]; exact Subgroup.inv_mem _ iha

/-! ### The partition as a relation -/

/-- The representative labels of a `ReprVal`. -/
theorem ReprVal.elim {v : Val} {R : Fin n → Fin n → Prop} (h : ReprVal n v R) :
    ∃ r : Fin n → Fin n, v = encFun (fun i => (r i : ℕ)) ∧ (∀ i j, r i = r j ↔ R i j) ∧
      IsRepr r := h

/-- A group that preserves the relation `R` lies in `presR r`. -/
theorem le_presR {r : Fin n → Fin n} {R : Fin n → Fin n → Prop} (hR : ∀ i j, r i = r j ↔ R i j)
    {G : Subgroup (Perm (Fin n))} (hG : ∀ g ∈ G, ∀ i j, R (g i) (g j) ↔ R i j) : G ≤ presR r :=
  fun g hg i j => by rw [hR, hR]; exact hG g hg i j

/-! ### The preimage instances -/

/-- The graph `psi r g` preserves the first part. -/
theorem psi_preserves (r : Fin n → Fin n) (g : Perm (Fin n)) (i : Fin n) :
    ∃ j : Fin n, psi r g (Sum.inl i) = Sum.inl j := ⟨g i, by simp [psi]⟩

/-- The preimage instance of the graph group with `ms` (which must lie in the image). -/
noncomputable def graphInst (r : Fin n → Fin n) (gs ms : List (Perm (Fin n)))
    (hms : ∀ m ∈ ms, ∃ g : Perm (Fin n), Equiv.sumCongr g m ∈
      Subgroup.closure {d | d ∈ gs.map (psi r)}) : PreimageInst where
  n := n
  n' := n
  ds := gs.map (psi r)
  ms := ms
  preserves := fun d hd i => by
    obtain ⟨g, -, rfl⟩ := List.mem_map.mp hd
    exact psi_preserves r g i
  ms_le := hms

/-- The graph group: generated by the `psi r g`, `g ∈ gs`, it is the image of `⟨gs⟩`. -/
theorem mem_graph {r : Fin n → Fin n} (hr : IsRepr r) {gs : List (Perm (Fin n))}
    (hgs : ∀ g ∈ gs, g ∈ presR r) (x : Perm (Fin n ⊕ Fin n)) :
    x ∈ Subgroup.closure {d | d ∈ gs.map (psi r)} ↔ ∃ g ∈ gens gs, psi r g = x := by
  have e : {d | d ∈ gs.map (psi r)} = {y | ∃ g ∈ gs, psi r g = y} := by
    ext d; simp
  rw [e]
  exact mem_closure_image_of_mul (presR r) (psi r) (fun a ha b hb => psi_mul hr ha hb) hgs x

/-- The image group `π(G)`: generated by the `hat r g`, `g ∈ gs`. -/
theorem mem_hatGens {r : Fin n → Fin n} (hr : IsRepr r) {gs : List (Perm (Fin n))}
    (hgs : ∀ g ∈ gs, g ∈ presR r) (x : Perm (Fin n)) :
    x ∈ gens (gs.map (hat r)) ↔ ∃ g ∈ gens gs, hat r g = x := by
  have e : {d | d ∈ gs.map (hat r)} = {y | ∃ g ∈ gs, hat r g = y} := by
    ext d; simp
  unfold gens at *
  rw [e]
  exact mem_closure_image_of_mul (presR r) (hat r) (fun a ha b hb => hat_mul hr ha hb) hgs x

/-- **The kernel as a preimage.** With no generators of `M`, the preimage of the graph group is
the kernel of the action on the classes. -/
theorem graphInst_kernel {r : Fin n → Fin n} (hr : IsRepr r) {gs : List (Perm (Fin n))}
    (hgs : ∀ g ∈ gs, g ∈ presR r) (g : Perm (Fin n)) :
    g ∈ GI.CitedChecks.preimageSubgroup (graphInst r gs [] (by simp)) ↔
      g ∈ gens gs ∧ ∀ i, r (g i) = r i := by
  have hle : gens gs ≤ presR r := by
    unfold gens; rw [Subgroup.closure_le]; exact fun g hg => hgs g hg
  show (∃ h ∈ Subgroup.closure {m | m ∈ ([] : List (Perm (Fin n)))},
    Equiv.sumCongr g h ∈ Subgroup.closure {d | d ∈ gs.map (psi r)}) ↔ _
  simp only [List.not_mem_nil, Set.setOf_false, Subgroup.closure_empty, Subgroup.mem_bot,
    exists_eq_left, mem_graph hr hgs]
  constructor
  · rintro ⟨g', hg', he⟩
    obtain ⟨rfl, h1⟩ := sumCongr_inj he
    exact ⟨hg', (hat_eq_one_iff hr (hle hg')).mp h1⟩
  · rintro ⟨hg, h1⟩
    exact ⟨g, hg, by rw [psi, (hat_eq_one_iff hr (hle hg)).mpr h1]⟩

/-- The generators of the stabilizer of `r a` in `π(G)` lie in the image of the graph group. -/
theorem graphInst_ms_le {r : Fin n → Fin n} (hr : IsRepr r) {gs ms : List (Perm (Fin n))}
    (hgs : ∀ g ∈ gs, g ∈ presR r) (a : Fin n)
    (hms : gens ms = pointwiseStab (gens (gs.map (hat r))) [r a]) :
    ∀ m ∈ ms, ∃ g : Perm (Fin n), Equiv.sumCongr g m ∈
      Subgroup.closure {d | d ∈ gs.map (psi r)} := by
  intro m hm
  have hm' : m ∈ pointwiseStab (gens (gs.map (hat r))) [r a] :=
    hms ▸ Subgroup.subset_closure hm
  obtain ⟨g, hg, rfl⟩ := (mem_hatGens hr hgs m).mp hm'.1
  exact ⟨g, (mem_graph hr hgs _).mpr ⟨g, hg, rfl⟩⟩

/-- **The block stabilizer as a preimage.** The preimage of the stabilizer of `r a` in `π(G)` is
the set of `g ∈ G` that map the class of `a` to itself. -/
theorem graphInst_block {r : Fin n → Fin n} (hr : IsRepr r) {gs ms : List (Perm (Fin n))}
    (hgs : ∀ g ∈ gs, g ∈ presR r) (a : Fin n)
    (hms : gens ms = pointwiseStab (gens (gs.map (hat r))) [r a]) (g : Perm (Fin n)) :
    g ∈ GI.CitedChecks.preimageSubgroup (graphInst r gs ms (graphInst_ms_le hr hgs a hms)) ↔
      g ∈ gens gs ∧ r (g a) = r a := by
  have hle : gens gs ≤ presR r := by
    unfold gens; rw [Subgroup.closure_le]; exact fun g hg => hgs g hg
  show (∃ h ∈ Subgroup.closure {m | m ∈ ms},
    Equiv.sumCongr g h ∈ Subgroup.closure {d | d ∈ gs.map (psi r)}) ↔ _
  have hms' : Subgroup.closure {m | m ∈ ms} = pointwiseStab (gens (gs.map (hat r))) [r a] := hms
  simp only [hms', mem_graph hr hgs]
  constructor
  · rintro ⟨h, hh, g', hg', he⟩
    obtain ⟨rfl, h1⟩ := sumCongr_inj he
    refine ⟨hg', ?_⟩
    have := hh.2 (r a) (List.mem_singleton_self _)
    rw [← h1, hat_apply_rep hr (hle hg')] at this
    exact this
  · rintro ⟨hg, h1⟩
    refine ⟨hat r g, ⟨(mem_hatGens hr hgs _).mpr ⟨g, hg, rfl⟩, fun i hi => ?_⟩, g, hg, rfl⟩
    rw [List.mem_singleton.mp hi, hat_apply_rep hr (hle hg), h1]

end GI.Lang
