module

public import Workspace.Proved.VsQSplit1
public import Workspace.Impl.VsQAnaLC
public import Workspace.Proved.VsFAlgSpanMath
public import Workspace.Proved.VsWAlgMath
public import Workspace.Proved.VsWEigMath
public import Workspace.Proved.VsFAlgPiece

@[expose] public section

/-!
# The local algebra of an abelian state

For a valid state `s` with local dimension `D`, the program computes a basis `Bm` of the algebra
`B = 𝔽_p[Λ(H)]` spanned by the local matrices (`vsQBm`). This file proves what the abelian
branch of the analysis uses.

* `vsQ_alg_span`: in the local convention (`vsWM`, a transpose of `vsFMatrix`), the span of the
  basis is the algebra generated by the generator matrices.
* `vsQ_rows`: if `dim B < D`, the first columns `B e₀` span a proper nonzero invariant subspace.
* `vsQ_ann`: the common kernel of the nilpotent elements is nonzero and invariant; if it is all
  of `𝔽_p^D`, `B` has no nonzero nilpotent elements.
* `vsQ_piece`: a joint eigenspace of the Frobenius fixed points is nonzero and invariant; if it
  is everything (and `B` is reduced), `B` is a field (`vsQ_field`).
-/

open Matrix

set_option backward.isDefEq.respectTransparency false

namespace GI.Proved

open GI.Impl GI.Cited GI.Lang Equiv

section General

variable {p : ℕ}

theorem vsQ_adjoin_transpose {D : ℕ} (S : Set (Matrix (Fin D) (Fin D) (ZMod p)))
    {Z : Matrix (Fin D) (Fin D) (ZMod p)} (hZ : Z ∈ Algebra.adjoin (ZMod p) S) :
    Zᵀ ∈ Algebra.adjoin (ZMod p) (Matrix.transpose '' S) := by
  induction hZ using Algebra.adjoin_induction with
  | mem x hx => exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, transpose_smul, transpose_one]
    exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) r
  | add x y _ _ hx hy => rw [transpose_add]; exact Subalgebra.add_mem _ hx hy
  | mul x y _ _ hx hy => rw [transpose_mul]; exact Subalgebra.mul_mem _ hy hx

theorem vsWId_sq (hp : 1 < p) (D : ℕ) : VsFSq p D (vsWId D) :=
  ⟨by simp [vsWId], fun a ha => vsWId_fit hp D a ha⟩

theorem vsFMatrix_vsWId (D : ℕ) : vsFMatrix p D (vsWId D) = 1 := by
  ext i j
  simp only [vsFMatrix, vsWId, Matrix.one_apply]
  rw [List.getD_eq_getElem _ _ (by simp)]
  simp only [List.getElem_map, List.getElem_range]
  rw [vsF_vsUnit i.2]
  by_cases h : i = j
  · subst h; simp
  · rw [Pi.single_apply, if_neg (fun e => h (Fin.ext e.symm)), if_neg h]

theorem vsWZ_zero (hp : 0 < p) (D : ℕ) : VsFZero p D (vsWZ D) :=
  ⟨fun y hy => by simp [vsWZ] at hy; omega, by simp [vsWZ], by
    funext j; simp [vsWZ, vsF]⟩

theorem vsFSq_of_wSq {D : ℕ} {A : List (List ℕ)} (h : VsWSq p D A) : VsFSq p D A :=
  ⟨h.2, h.1⟩

/-- **The algebra basis, in the local convention.** The span of the matrices `vsWM M` of the
basis `Bm` computed by `vsFAlgSpan` is the algebra generated by the `vsWM g`. -/
theorem vsQ_alg_span (hp : p.Prime) {D : ℕ} {gs : List (List (List ℕ))}
    (hgs : ∀ g ∈ gs, VsWSq p D g) (X : Matrix (Fin D) (Fin D) (ZMod p)) :
    X ∈ Submodule.span (ZMod p)
        {X | ∃ M ∈ (vsFAlgSpanL p (vsWZ D) (vsWId D) gs (D * D)).2, vsWM p D M = X} ↔
      X ∈ Algebra.adjoin (ZMod p) {X | ∃ g ∈ gs, vsWM p D g = X} := by
  have hspan := (vsFAlgSpanL_span hp (vsWZ_zero hp.pos D) (vsWId_sq hp.one_lt D)
    (vsFMatrix_vsWId D) fun g hg => vsFSq_of_wSq (hgs g hg)).2
  set Bm := (vsFAlgSpanL p (vsWZ D) (vsWId D) gs (D * D)).2
  have e1 : Submodule.span (ZMod p) {X | ∃ M ∈ Bm, vsWM p D M = X} =
      (vsFMatSpan p D Bm).map (transposeLinearEquiv (Fin D) (Fin D) (ZMod p) (ZMod p)).toLinearMap := by
    rw [vsFMatSpan, Submodule.map_span]
    congr 1
    ext Y
    simp [vsWM]
  have tW : Matrix.transpose '' {X | ∃ g ∈ gs, vsFMatrix p D g = X} = {X | ∃ g ∈ gs, vsWM p D g = X} := by
    ext Y; simp [vsWM]
  have tF : Matrix.transpose '' {X | ∃ g ∈ gs, vsWM p D g = X} = {X | ∃ g ∈ gs, vsFMatrix p D g = X} := by
    ext Y; simp [vsWM]
  rw [e1]
  constructor
  · rintro ⟨Z, hZ, rfl⟩
    rw [hspan] at hZ
    have := vsQ_adjoin_transpose _ hZ
    rw [tW] at this
    exact this
  · intro hX
    refine ⟨Xᵀ, ?_, by simp⟩
    rw [hspan]
    have := vsQ_adjoin_transpose _ hX
    rw [tF] at this
    exact this


theorem vsFAnnL_fit (hp : 1 < p) {D : ℕ} :
    ∀ (Ys : List (List (List ℕ))) (us : List (List ℕ)), VsWFit p D us →
      VsWFit p D (Ys.foldl (vsWCut p D) us)
  | [], _, h => h
  | y :: Ys, _, _ => vsFAnnL_fit hp Ys _ (vsWCut_fit (by omega))

theorem vsWSp_finrank_le (hp : p.Prime) {D : ℕ} (us : List (List ℕ)) :
    Module.finrank (ZMod p) (vsWSp p D us) ≤ us.length := by
  haveI := Fact.mk hp
  rw [← vsWComb_range]
  exact (LinearMap.finrank_range_le _).trans (by simp)

theorem vsWSp_top_of_bas (hp : p.Prime) {D : ℕ} {us : List (List ℕ)} (h : VsWFit p D us)
    (hl : D ≤ (vsWBas p us).length) : vsWSp p D us = ⊤ := by
  haveI := Fact.mk hp
  apply Submodule.eq_top_of_finrank_eq
  rw [← vsWBas_length hp h, Module.finrank_fin_fun]
  have := Submodule.finrank_le (vsWSp p D (vsWBas p us))
  rw [vsWBas_span hp h, ← vsWBas_length hp h, Module.finrank_fin_fun] at this
  omega

theorem vsWSp_ne_top_of_bas (hp : p.Prime) {D : ℕ} {us : List (List ℕ)} (h : VsWFit p D us)
    (hl : (vsWBas p us).length < D) : vsWSp p D us ≠ ⊤ := by
  haveI := Fact.mk hp
  intro e
  have := vsWBas_length hp h
  rw [e, finrank_top, Module.finrank_fin_fun] at this
  omega

end General

variable {I : VecStabInst}

theorem vsQ_fact (I : VecStabInst) : Fact I.p.Prime := ⟨I.prime⟩

attribute [local instance] vsQ_fact

/-- The algebra basis of a state. -/
noncomputable def vsQBm (s : VsQSt I) : List (List (List ℕ)) :=
  (vsFAlgSpanL I.p (vsWZ (vsQD s)) (vsWId (vsQD s)) (vsQMs s) (vsQD s * vsQD s)).2

/-- The first columns of a list of stored matrices. -/
def vsQRows0 (Bm : List (List (List ℕ))) : List (List ℕ) := Bm.map fun M => M.getD 0 []

/-- The common kernel of the nilpotent elements of the algebra of a state. -/
noncomputable def vsQAnnL (s : VsQSt I) : List (List ℕ) :=
  vsFAnnL I.p (vsQD s) (vsFNilL I.p (vsQD s) (vsQBm s))

/-- The pieces of the algebra of a state. -/
noncomputable def vsQPcs (s : VsQSt I) : List (List (List ℕ)) :=
  vsFEigL I.p (vsQD s) (vsFFixL I.p (vsQD s) (vsQBm s))

/-- The local algebra of a state. -/
noncomputable def vsQBl (s : VsQSt I) :
    Subalgebra (ZMod I.p) (Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) :=
  Algebra.adjoin (ZMod I.p) {X | ∃ g ∈ vsQMs s, vsWM I.p (vsQD s) g = X}

/-- The local algebra as maps. -/
noncomputable def vsQBe (s : VsQSt I) :
    Subalgebra (ZMod I.p) (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) :=
  (vsQBl s).map (Matrix.toLinAlgEquiv' : _ ≃ₐ[ZMod I.p] _).toAlgHom

section State

variable (s : VsQSt I)

theorem vsQBm_mem (X : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) :
    X ∈ Submodule.span (ZMod I.p) {X | ∃ M ∈ vsQBm s, vsWM I.p (vsQD s) M = X} ↔ X ∈ vsQBl s :=
  vsQ_alg_span I.prime (vsQMs_sq s) X

theorem vsQBm_inv :
    VsFAInv I.p (vsQD s) (vsFAlgOf I.p (vsQD s) (vsQMs s))
      (vsFAlgSpanL I.p (vsWZ (vsQD s)) (vsWId (vsQD s)) (vsQMs s) (vsQD s * vsQD s)) :=
  (vsFAlgSpanL_span I.prime (vsWZ_zero I.prime.pos _) (vsWId_sq I.prime.one_lt _)
    (vsFMatrix_vsWId _) fun g hg => vsFSq_of_wSq (vsQMs_sq s g hg)).1

theorem vsQBm_sq : ∀ M ∈ vsQBm s, VsWSq I.p (vsQD s) M := fun M hM =>
  ⟨((vsQBm_inv s).sq M hM).rows, ((vsQBm_inv s).sq M hM).len⟩

theorem vsQBm_length : (vsQBm s).length ≤ vsQD s * vsQD s := by
  have h := vsQBm_inv s
  rw [vsQBm, ← h.nb]
  exact vsFA_ech_length I.prime h.ech fun r hr => (h.len r hr).1

theorem vsQBm_wM_mem {M : List (List ℕ)} (hM : M ∈ vsQBm s) : vsWM I.p (vsQD s) M ∈ vsQBl s :=
  (vsQBm_mem s _).1 (Submodule.subset_span ⟨M, hM, rfl⟩)

theorem vsQLam_mem_Bl {g : Perm (Fin I.n)} (hg : g ∈ 1 :: s.hs) : vsQLam s g ∈ vsQBl s :=
  Algebra.subset_adjoin ⟨_, List.mem_map_of_mem hg, rfl⟩

theorem vsQBl_eq (hs : VsQStOK s) : vsQBl s = Algebra.adjoin (ZMod I.p) {X | ∃ g ∈ s.hs, vsQLam s g = X} := by
  apply le_antisymm
  · rw [vsQBl, Algebra.adjoin_le_iff]
    rintro _ ⟨M, hM, rfl⟩
    simp only [vsQMs, List.mem_map] at hM
    obtain ⟨g, hg, rfl⟩ := hM
    rcases List.mem_cons.mp hg with rfl | hg
    · change vsQLam s 1 ∈ _
      rw [vsQLam_one hs]; exact Subalgebra.one_mem _
    · exact Algebra.subset_adjoin ⟨g, hg, rfl⟩
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨g, hg, rfl⟩
    exact vsQLam_mem_Bl s (List.mem_cons_of_mem _ hg)

variable {s} (hs : VsQStOK s)
include hs

theorem vsQBl_comm (hab : s.Ab) : ∀ X ∈ vsQBl s, ∀ Y ∈ vsQBl s, Commute X Y := by
  have hg : ∀ X ∈ {X | ∃ g ∈ vsQMs s, vsWM I.p (vsQD s) g = X},
      ∀ Y ∈ {X | ∃ g ∈ vsQMs s, vsWM I.p (vsQD s) g = X}, Commute X Y := by
    rintro _ ⟨_, hM, rfl⟩ _ ⟨_, hM', rfl⟩
    simp only [vsQMs, List.mem_map] at hM hM'
    obtain ⟨g, hg, rfl⟩ := hM
    obtain ⟨h, hh, rfl⟩ := hM'
    have mem : ∀ k ∈ 1 :: s.hs, k ∈ gens s.hs := fun k hk => by
      rcases List.mem_cons.mp hk with rfl | hk
      · exact one_mem _
      · exact Subgroup.subset_closure hk
    exact (vsQAb_iff hs).1 hab g (mem g hg) h (mem h hh)
  intro X hX Y hY
  refine Algebra.commute_of_mem_adjoin_of_forall_mem_commute hY fun Y' hY' => ?_
  exact (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hX fun X' hX' =>
    (hg X' hX' Y' hY').symm).symm

theorem vsQBm_comm (hab : s.Ab) : VsWComm I.p (vsQD s) (vsQBm s) := fun _ hM _ hM' =>
  vsQBl_comm hs hab _ (vsQBm_wM_mem s hM) _ (vsQBm_wM_mem s hM')

omit hs in
theorem vsQBe_mem (f : Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) :
    f ∈ vsQBe s ↔ ∃ x ∈ Submodule.span (ZMod I.p) {X | ∃ M ∈ vsQBm s, vsWM I.p (vsQD s) M = X},
      Matrix.toLinAlgEquiv' x = f := by
  simp only [vsQBe, Subalgebra.mem_map, vsQBm_mem]
  rfl

theorem vsQBe_comm (hab : s.Ab) : ∀ x ∈ vsQBe s, ∀ y ∈ vsQBe s, Commute x y := by
  rintro _ ⟨X, hX, rfl⟩ _ ⟨Y, hY, rfl⟩
  have := vsQBl_comm hs hab X hX Y hY
  exact this.map _

theorem vsQ_toLin_lam_comm (hab : s.Ab) {g : Perm (Fin I.n)} (hg : g ∈ s.hs)
    {X : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)} (hX : X ∈ vsQBl s)
    (v : Fin (vsQD s) → ZMod I.p) :
    X *ᵥ (vsQLam s g *ᵥ v) = vsQLam s g *ᵥ (X *ᵥ v) := by
  rw [mulVec_mulVec, mulVec_mulVec,
    (vsQBl_comm hs hab X hX _ (vsQLam_mem_Bl s (List.mem_cons_of_mem _ hg))).eq]

/-! ### The first columns -/

omit hs in
/-- The column map `X ↦ X e₀`. -/
theorem vsQ_rows_span (hD : 1 ≤ vsQD s) :
    vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)) =
      (Subalgebra.toSubmodule (vsQBl s)).map
        ({ toFun := fun X => X *ᵥ Pi.single (⟨0, hD⟩ : Fin (vsQD s)) (1 : ZMod I.p)
           map_add' := fun X Y => add_mulVec X Y _
           map_smul' := fun c X => smul_mulVec c X _ } :
          Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p) →ₗ[ZMod I.p] (Fin (vsQD s) → ZMod I.p)) := by
  have e : Subalgebra.toSubmodule (vsQBl s) =
      Submodule.span (ZMod I.p) {X | ∃ M ∈ vsQBm s, vsWM I.p (vsQD s) M = X} := by
    ext X; rw [vsQBm_mem]; rfl
  rw [e, Submodule.map_span, vsWSp]
  congr 1
  ext v
  simp only [vsQRows0, List.mem_map, Set.mem_setOf_eq, Set.mem_image, LinearMap.coe_mk,
    AddHom.coe_mk]
  have key : ∀ M : List (List ℕ), vsWM I.p (vsQD s) M *ᵥ Pi.single (⟨0, hD⟩ : Fin (vsQD s)) 1 =
      vsWV I.p (vsQD s) (M.getD 0 []) := by
    intro M
    rw [mulVec_single_one, vsWM]
    funext k
    rw [col_apply, transpose_apply]
    rfl
  constructor
  · rintro ⟨_, ⟨M, hM, rfl⟩, rfl⟩
    exact ⟨_, ⟨M, hM, rfl⟩, key M⟩
  · rintro ⟨_, ⟨M, hM, rfl⟩, rfl⟩
    exact ⟨_, ⟨M, hM, rfl⟩, (key M).symm⟩

omit hs in
/-- The first columns `B e₀` span a nonzero subspace, invariant because `B` is closed under
products and contains every `Λ(g)`. -/
theorem vsQ_rows' (hD : 1 ≤ vsQD s) :
    VsWFit I.p (vsQD s) (vsQRows0 (vsQBm s)) ∧
      vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)) ≠ ⊥ ∧
      ∀ g ∈ s.hs, ∀ a ∈ vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)),
        vsQLam s g *ᵥ a ∈ vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)) := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  rw [vsQ_rows_span hD]
  refine ⟨?_, ?_, ?_⟩
  · intro u hu
    simp only [vsQRows0, List.mem_map] at hu
    obtain ⟨M, hM, rfl⟩ := hu
    have hsq := vsQBm_sq s M hM
    rw [List.getD_eq_getElem _ _ (by rw [hsq.2]; exact hD)]
    exact hsq.1 _ (List.getElem_mem _)
  · intro h0
    have : (1 : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) *ᵥ
        Pi.single (⟨0, hD⟩ : Fin (vsQD s)) 1 ∈ (⊥ : Submodule (ZMod I.p) _) :=
      h0 ▸ Submodule.mem_map_of_mem (Subalgebra.one_mem (vsQBl s))
    rw [Submodule.mem_bot, one_mulVec] at this
    exact one_ne_zero (congrFun this ⟨0, hD⟩ ▸ (Pi.single_eq_same _ _).symm)
  · rintro g hg _ ⟨X, hX, rfl⟩
    refine ⟨vsQLam s g * X, Subalgebra.mul_mem _ (vsQLam_mem_Bl s (List.mem_cons_of_mem _ hg)) hX, ?_⟩
    simp only [LinearMap.coe_mk, AddHom.coe_mk, mulVec_mulVec]

omit hs in
/-- **Split by the first columns.** If `dim B < D`, the columns `B e₀` span a proper nonzero
subspace, invariant because `B` is closed under products and contains every `Λ(g)`. -/
theorem vsQ_rows (hD : 1 ≤ vsQD s) (hlt : (vsQBm s).length < vsQD s) :
    VsWFit I.p (vsQD s) (vsQRows0 (vsQBm s)) ∧
      vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)) ≠ ⊥ ∧
      vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)) ≠ ⊤ ∧
      ∀ g ∈ s.hs, ∀ a ∈ vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)),
        vsQLam s g *ᵥ a ∈ vsWSp I.p (vsQD s) (vsQRows0 (vsQBm s)) := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  rw [vsQ_rows_span hD]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro u hu
    simp only [vsQRows0, List.mem_map] at hu
    obtain ⟨M, hM, rfl⟩ := hu
    have hsq := vsQBm_sq s M hM
    rw [List.getD_eq_getElem _ _ (by rw [hsq.2]; exact hD)]
    exact hsq.1 _ (List.getElem_mem _)
  · intro h0
    have : (1 : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) *ᵥ
        Pi.single (⟨0, hD⟩ : Fin (vsQD s)) 1 ∈ (⊥ : Submodule (ZMod I.p) _) :=
      h0 ▸ Submodule.mem_map_of_mem (Subalgebra.one_mem (vsQBl s))
    rw [Submodule.mem_bot, one_mulVec] at this
    exact one_ne_zero (congrFun this ⟨0, hD⟩ ▸ (Pi.single_eq_same _ _).symm)
  · intro htop
    have h1 := vsWSp_finrank_le I.prime (D := vsQD s) (vsQRows0 (vsQBm s))
    rw [vsQ_rows_span hD, htop, finrank_top, Module.finrank_fin_fun] at h1
    simp [vsQRows0] at h1
    omega
  · rintro g hg _ ⟨X, hX, rfl⟩
    refine ⟨vsQLam s g * X, Subalgebra.mul_mem _ (vsQLam_mem_Bl s (List.mem_cons_of_mem _ hg)) hX, ?_⟩
    simp only [LinearMap.coe_mk, AddHom.coe_mk, mulVec_mulVec]

/-! ### The kernel of the nilpotent part -/

omit hs in
theorem vsQAnnL_fit : VsWFit I.p (vsQD s) (vsQAnnL s) :=
  vsFAnnL_fit I.prime.one_lt _ _ (vsWId_fit I.prime.one_lt _)

theorem vsQ_ann_span (hab : s.Ab) : vsWSp I.p (vsQD s) (vsQAnnL s) = vsFAnn (vsQBe s) :=
  vsFAnnL_nil I.prime (vsQBm_sq s) (vsQBm_comm hs hab) (vsQBe s) vsQBe_mem

/-- **The kernel of the nilpotent part.** It is nonzero (`B` is commutative) and invariant
(`Λ(g) ∈ B` commutes with `B`). -/
theorem vsQ_ann (hab : s.Ab) (hD : 1 ≤ vsQD s) :
    vsWSp I.p (vsQD s) (vsQAnnL s) ≠ ⊥ ∧
      ∀ g ∈ s.hs, ∀ a ∈ vsWSp I.p (vsQD s) (vsQAnnL s),
        vsQLam s g *ᵥ a ∈ vsWSp I.p (vsQD s) (vsQAnnL s) := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  haveI : Nontrivial (Fin (vsQD s) → ZMod I.p) := by
    haveI : Nonempty (Fin (vsQD s)) := ⟨⟨0, hD⟩⟩
    infer_instance
  rw [vsQ_ann_span hs hab]
  refine ⟨vsFAnn_ne_bot _ (vsQBe_comm hs hab), fun g hg a ha => ?_⟩
  rw [mem_vsFAnn] at ha ⊢
  rintro _ ⟨X, hX, rfl⟩ hyp
  have h1 := ha _ ⟨X, hX, rfl⟩ hyp
  change Matrix.toLin' X a = 0 at h1
  change Matrix.toLin' X (vsQLam s g *ᵥ a) = 0
  rw [Matrix.toLin'_apply] at h1 ⊢
  rw [vsQ_toLin_lam_comm hs hab hg hX, h1, mulVec_zero]

/-- If the kernel of the nilpotent part is everything, `B` has no nonzero nilpotent elements. -/
theorem vsQ_ann_top (hab : s.Ab) (htop : vsWSp I.p (vsQD s) (vsQAnnL s) = ⊤) :
    ∀ y ∈ vsQBe s, y ^ I.p = 0 → y = 0 := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  rw [vsQ_ann_span hs hab] at htop
  intro y hy hyp
  refine LinearMap.ext fun v => ?_
  have hv : v ∈ vsFAnn (vsQBe s) := htop ▸ Submodule.mem_top
  rw [LinearMap.zero_apply]
  exact (mem_vsFAnn _ v).1 hv y hy hyp

/-! ### Pieces -/

omit hs in
theorem vsQFix_sq : ∀ M ∈ vsFFixL I.p (vsQD s) (vsQBm s), VsWSq I.p (vsQD s) M := by
  intro M hM
  simp only [vsFFixL, List.mem_map] at hM
  obtain ⟨a, -, rfl⟩ := hM
  exact vsWMC_sq I.prime.pos _ a

theorem vsQFix_mem (hab : s.Ab) {M : List (List ℕ)} (hM : M ∈ vsFFixL I.p (vsQD s) (vsQBm s)) :
    vsWM I.p (vsQD s) M ∈ vsQBl s ∧ vsWM I.p (vsQD s) M ^ I.p = vsWM I.p (vsQD s) M := by
  have := (vsFFixL_span I.prime (vsQBm_sq s) (vsQBm_comm hs hab) (vsWM I.p (vsQD s) M)).1
    (Submodule.subset_span ⟨M, hM, rfl⟩)
  exact ⟨(vsQBm_mem s _).1 this.1, this.2⟩

/-- **A piece is nonzero and invariant.** -/
theorem vsQ_piece (hab : s.Ab) {Q : List (List ℕ)} (hQ : Q ∈ vsQPcs s) :
    VsWFit I.p (vsQD s) Q ∧ vsWSp I.p (vsQD s) Q ≠ ⊥ ∧
      ∀ g ∈ s.hs, ∀ a ∈ vsWSp I.p (vsQD s) Q, vsQLam s g *ᵥ a ∈ vsWSp I.p (vsQD s) Q := by
  obtain ⟨hfit, hne, c, hc⟩ := (vsFEigL_pieces I.prime _ (vsQFix_sq (s := s))).1 Q hQ
  refine ⟨hfit, hne, fun g hg a ha => ?_⟩
  rw [hc, mem_vsFEig] at ha ⊢
  intro i
  have hX := (vsQFix_mem hs hab (List.getElem_mem i.2)).1
  have := ha i
  simp only [vsWLin, Matrix.toLin'_apply, Fin.getElem_fin] at this ⊢
  rw [vsQ_toLin_lam_comm hs hab hg hX, this, mulVec_smul]

/-- The family of the Frobenius fixed points, as maps. -/
noncomputable def vsQFixF (s : VsQSt I) :
    Fin (vsFFixL I.p (vsQD s) (vsQBm s)).length → Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p) :=
  fun i => vsWLin I.p (vsQD s) (vsFFixL I.p (vsQD s) (vsQBm s))[i]

theorem vsQFixF_mem (hab : s.Ab) (i) : vsQFixF s i ∈ vsQBe s ∧ vsQFixF s i ^ I.p = vsQFixF s i := by
  have h := vsQFix_mem hs hab (List.getElem_mem i.2)
  refine ⟨⟨_, h.1, rfl⟩, ?_⟩
  have e := congrArg (Matrix.toLinAlgEquiv' : _ ≃ₐ[ZMod I.p] _) h.2
  rw [map_pow] at e
  change vsQFixF s i ^ I.p = vsQFixF s i at e
  exact e

/-- **There is a piece.** -/
theorem vsQPcs_ne (hab : s.Ab) (hD : 1 ≤ vsQD s) : vsQPcs s ≠ [] := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  haveI : Nontrivial (Fin (vsQD s) → ZMod I.p) := by
    haveI : Nonempty (Fin (vsQD s)) := ⟨⟨0, hD⟩⟩
    infer_instance
  have hsup := vsFEig_iSup (vsQBe s) (vsQBe_comm hs hab) (vsQFixF s)
    (fun i => (vsQFixF_mem hs hab i).1) (fun i => (vsQFixF_mem hs hab i).2)
  by_contra hnil
  have hall : ∀ a, vsFEig (vsQFixF s) a = ⊥ := by
    intro a
    by_contra ha
    obtain ⟨Q, hQ, -⟩ := (vsFEigL_pieces I.prime _ (vsQFix_sq (s := s))).2 a ha
    rw [vsQPcs] at hnil
    rw [hnil] at hQ
    exact List.not_mem_nil hQ
  simp only [hall, iSup_bot] at hsup
  exact bot_ne_top hsup

/-- **The field case.** If the kernel of the nilpotent part and a piece are everything, every
element of the algebra generated by the `Λ(g)` is zero or injective. -/
theorem vsQ_field (hab : s.Ab) (hann : vsWSp I.p (vsQD s) (vsQAnnL s) = ⊤)
    {Q : List (List ℕ)} (hQ : Q ∈ vsQPcs s) (htop : vsWSp I.p (vsQD s) Q = ⊤) :
    ∀ X ∈ Algebra.adjoin (ZMod I.p) {X | ∃ g ∈ s.hs, vsQLam s g = X},
      X = 0 ∨ ∀ v, X *ᵥ v = 0 → v = 0 := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  obtain ⟨-, -, c, hc⟩ := (vsFEigL_pieces I.prime _ (vsQFix_sq (s := s))).1 Q hQ
  have hspan : ∀ t ∈ vsQBe s, t ^ I.p = t → t ∈ Submodule.span (ZMod I.p) (Set.range (vsQFixF s)) := by
    rintro _ ⟨x, hx, rfl⟩ hfix
    rw [← map_pow] at hfix
    have hx' : x ^ I.p = x := Matrix.toLinAlgEquiv'.injective hfix
    have hmem := (vsFFixL_span I.prime (vsQBm_sq s) (vsQBm_comm hs hab) x).2
      ⟨(vsQBm_mem s x).2 hx, hx'⟩
    have hle : (Submodule.span (ZMod I.p)
        {X | ∃ y ∈ vsFFixL I.p (vsQD s) (vsQBm s), vsWM I.p (vsQD s) y = X}).map
          (Matrix.toLinAlgEquiv' : _ ≃ₐ[ZMod I.p] _).toLinearMap ≤
        Submodule.span (ZMod I.p) (Set.range (vsQFixF s)) := by
      rw [Submodule.map_span, Submodule.span_le]
      rintro _ ⟨_, ⟨y, hy, rfl⟩, rfl⟩
      obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hy
      exact Submodule.subset_span ⟨⟨i, hi⟩, rfl⟩
    exact hle ⟨x, hmem, rfl⟩
  have hdom := vsFField_of_top (vsQBe s) (vsQ_ann_top hs hab hann) (vsQFixF s) c hspan
    (hc.symm.trans htop)
  intro X hX
  rw [← vsQBl_eq s hs] at hX
  rcases hdom _ ⟨X, hX, rfl⟩ with h | h
  · left
    exact Matrix.toLinAlgEquiv'.injective (by simpa using h)
  · right
    intro v hv
    exact h v (by simpa [Matrix.toLin'_apply] using hv)

end State

end GI.Proved
