import Workspace.Proved.VsTCyc
import Workspace.Proved.VsFAlgPiece

/-!
# Step 1 of LM Proposition 5.12 without irreducibility

Let `A` be an abelian normal subgroup of a linear group `G`, and `B = 𝔽_p[A]`. LM use
Clifford's theorem for `A` (their Problem 15). Without irreducibility we get one of three
results (`vsT_cliff`):

* outcome (i) of Theorem 5.1 with `H = G`: the nonzero joint eigenspaces of the Frobenius
  fixed points of `B` are at least two, and `G` permutes them transitively;
* outcome (iii): a proper nonzero `G`-invariant subspace. It is `vsFAnn B` when `B` has a
  nonzero `y` with `y ^ p = 0`, and otherwise the sum of one `G`-orbit of pieces;
* every nonzero element of `B` is injective (`vsTDom`), the input of `VsTCyc.lean`.

The pieces and their properties come from `Proved/VsFAlgPiece.lean`.
-/

namespace GI.Proved

open Module

variable {p : ℕ} [hp : Fact p.Prime] {V : Type*} [AddCommGroup V] [Module (ZMod p) V]

theorem vsT_unit_inj (u : (End (ZMod p) V)ˣ) : Function.Injective (u : End (ZMod p) V) := by
  intro x y h
  have := congrArg (↑u⁻¹ : End (ZMod p) V) h
  simpa [← Module.End.mul_apply] using this

theorem vsT_map_eq_bot (u : (End (ZMod p) V)ˣ) (W : Submodule (ZMod p) V) :
    W.map (u : End (ZMod p) V) = ⊥ ↔ W = ⊥ := by
  constructor
  · intro h
    rw [eq_bot_iff]
    intro v hv
    have h1 : (u : End (ZMod p) V) v ∈ W.map (u : End (ZMod p) V) := ⟨v, hv, rfl⟩
    rw [h, Submodule.mem_bot] at h1
    exact (Submodule.mem_bot _).2 (vsT_unit_inj u (h1.trans (map_zero _).symm))
  · rintro rfl
    exact Submodule.map_bot _

/-- Conjugation by an element of `G` maps `𝔽_p[A]` into itself (induction over the algebra
generated by `A`; on `A` itself this is normality). -/
theorem vsT_conj_mem {G A : Subgroup (End (ZMod p) V)ˣ} (hA : VsTAbNormal G A)
    {g : (End (ZMod p) V)ˣ} (hg : g ∈ G) {x : End (ZMod p) V} (hx : x ∈ vsTAlg A) :
    (g : End (ZMod p) V) * x * ↑g⁻¹ ∈ vsTAlg A := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    exact Algebra.subset_adjoin ⟨_, hA.conj_mem hg ha, by simp⟩
  | algebraMap r =>
    rw [← Algebra.commutes, mul_assoc, Units.mul_inv, mul_one]
    exact Subalgebra.algebraMap_mem _ r
  | add x y _ _ hx hy =>
    rw [mul_add, add_mul]
    exact add_mem hx hy
  | mul x y _ _ hx hy =>
    have : (g : End (ZMod p) V) * (x * y) * ↑g⁻¹ =
        ((g : End (ZMod p) V) * x * ↑g⁻¹) * ((g : End (ZMod p) V) * y * ↑g⁻¹) := by
      simp only [mul_assoc, Units.inv_mul_cancel_left]
    rw [this]
    exact mul_mem hx hy

theorem vsTAlg_comm {A : Subgroup (End (ZMod p) V)ˣ} (hA : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a) :
    ∀ x ∈ vsTAlg A, ∀ y ∈ vsTAlg A, Commute x y := by
  haveI : IsMulCommutative (vsTAlg A) :=
    Algebra.isMulCommutative_adjoin (ZMod p) (vsTSet_comm hA)
  intro x hx y hy
  have h : (⟨x, hx⟩ : vsTAlg A) * ⟨y, hy⟩ = ⟨y, hy⟩ * ⟨x, hx⟩ :=
    IsMulCommutative.is_comm.comm _ _
  exact congrArg Subtype.val h

/-- **Step 1 of LM Proposition 5.12.** For an abelian normal `A ≤ G`: outcome (i) with
`H = G`, or outcome (iii), or every nonzero element of `𝔽_p[A]` is injective. -/
theorem vsT_cliff [FiniteDimensional (ZMod p) V] [Nontrivial V]
    {G A : Subgroup (End (ZMod p) V)ˣ} (hA : VsTAbNormal G A) :
    (∃ (m : ℕ) (W : Fin m → Submodule (ZMod p) V), VsTImprim G G W) ∨
      (∃ W, VsTSub G W) ∨ vsTDom (vsTAlg A) := by
  classical
  haveI : Finite V := Module.finite_of_finite (ZMod p)
  set B := vsTAlg A
  have hB := vsTAlg_comm hA.2.2
  have hT : ∀ g ∈ G, ∀ x ∈ B, (↑g⁻¹ : End (ZMod p) V) * x * ↑g ∈ B := fun g hg x hx => by
    simpa using vsT_conj_mem hA (G.inv_mem hg) hx
  have hT' : ∀ g ∈ G, ∀ x ∈ B, (↑g : End (ZMod p) V) * x * ↑g⁻¹ ∈ B := fun g hg x hx =>
    vsT_conj_mem hA hg hx
  -- Case 1: a nonzero element with `y ^ p = 0`
  by_cases hN : ∃ y ∈ B, y ^ p = 0 ∧ y ≠ 0
  · obtain ⟨y, hy, hyp, hy0⟩ := hN
    refine Or.inr (Or.inl ⟨vsFAnn B, fun g hg v hv => vsFAnn_map B g (hT g hg) hv,
      vsFAnn_ne_bot B hB, vsFAnn_ne_top B hy hyp hy0⟩)
  push Not at hN
  have hN' : ∀ y ∈ B, y ^ p = 0 → y = 0 := hN
  -- the pieces
  let ι := {s : End (ZMod p) V // s ∈ B ∧ s ^ p = s}
  let f : ι → End (ZMod p) V := Subtype.val
  have hfB : ∀ i, f i ∈ B := fun i => i.2.1
  have hf : ∀ i, f i ^ p = f i := fun i => i.2.2
  have hspan : ∀ s ∈ B, s ^ p = s → s ∈ Submodule.span (ZMod p) (Set.range f) :=
    fun s hs hsp => Submodule.subset_span ⟨⟨s, hs, hsp⟩, rfl⟩
  set E := vsFEig f
  have hindep : iSupIndep E := vsFEig_indep B hB f hfB hf
  have hsup : ⨆ a, E a = ⊤ := vsFEig_iSup B hB f hfB hf
  set P : Set (ι → ZMod p) := {a | E a ≠ ⊥}
  have hmap : ∀ g ∈ G, ∀ a ∈ P, ∃ a' ∈ P, (E a).map (g : End (ZMod p) V) = E a' := by
    intro g hg a ha
    obtain ⟨a', h⟩ := vsFEig_map B f hfB hf hspan g (hT g hg) (hT' g hg) a ha
    change (E a).map (g : End (ZMod p) V) = E a' at h
    refine ⟨a', ?_, h⟩
    intro h0
    apply ha
    rw [h0, vsT_map_eq_bot] at h
    exact h
  have hzero : ∀ a ∉ P, E a = ⊥ := fun a ha => by
    by_contra h
    exact ha h
  -- some piece is nonzero
  have hPne : P.Nonempty := by
    by_contra h
    rw [Set.not_nonempty_iff_eq_empty] at h
    have : (⊤ : Submodule (ZMod p) V) = ⊥ := by
      rw [← hsup, eq_bot_iff, iSup_le_iff]
      intro a
      rw [hzero a (by rw [h]; exact Set.notMem_empty a)]
    exact top_ne_bot this
  obtain ⟨a0, ha0⟩ := hPne
  -- Case 2a: only one piece
  by_cases hone : ∀ a ∈ P, a = a0
  · refine Or.inr (Or.inr (vsFField_of_top B hN' f a0 hspan ?_))
    rw [eq_top_iff, ← hsup, iSup_le_iff]
    intro a
    by_cases ha : a ∈ P
    · rw [hone a ha]
    · rw [hzero a ha]
      exact bot_le
  push Not at hone
  obtain ⟨a1, ha1, ha10⟩ := hone
  -- the `G`-orbit of the piece `a0`
  set O : Set (ι → ZMod p) := {a | ∃ g ∈ G, (E a0).map (g : End (ZMod p) V) = E a}
  set U := ⨆ a ∈ O, E a
  have hO : ∀ g ∈ G, ∀ a ∈ O, ∃ a' ∈ O, (E a).map (g : End (ZMod p) V) = E a' := by
    rintro g hg a ⟨h, hh, hha⟩
    have haP : a ∈ P := by
      intro h0
      rw [h0, vsT_map_eq_bot] at hha
      exact ha0 hha
    obtain ⟨a', -, ha'⟩ := hmap g hg a haP
    refine ⟨a', ⟨g * h, G.mul_mem hg hh, ?_⟩, ha'⟩
    rw [← ha', ← hha, Units.val_mul, Module.End.mul_eq_comp, Submodule.map_comp]
  have hUinv : palfyInv G U := by
    intro g hg v hv
    have hle : U ≤ U.comap (g : End (ZMod p) V) := by
      refine iSup₂_le fun a ha => ?_
      rw [← Submodule.map_le_iff_le_comap]
      obtain ⟨a', ha', h⟩ := hO g hg a ha
      rw [h]
      exact le_iSup₂ (f := fun a (_ : a ∈ O) => E a) a' ha'
    exact hle hv
  have ha0O : a0 ∈ O := ⟨1, G.one_mem, by
    rw [Units.val_one, Module.End.one_eq_id, Submodule.map_id]⟩
  have hU0 : U ≠ ⊥ := by
    intro h
    apply ha0
    rw [eq_bot_iff, ← h]
    exact le_iSup₂ (f := fun a (_ : a ∈ O) => E a) a0 ha0O
  by_cases hUtop : U = ⊤
  swap
  · exact Or.inr (Or.inl ⟨U, hUinv, hU0, hUtop⟩)
  -- `G` is transitive on the pieces
  have htrans : ∀ a ∈ P, a ∈ O := by
    intro a ha
    by_contra haO
    have hd := hindep.disjoint_biSup haO
    rw [show (⨆ i ∈ O, E i) = U from rfl, hUtop, disjoint_top] at hd
    exact ha hd
  -- Case 2b: outcome (i) with `H = G`
  left
  haveI : Finite P := Set.toFinite P
  set m := Nat.card P
  let e : P ≃ Fin m := Finite.equivFin P
  let W : Fin m → Submodule (ZMod p) V := fun i => E (e.symm i).1
  have hm : 2 ≤ m := by
    have h1 : (⟨a0, ha0⟩ : P) ≠ ⟨a1, ha1⟩ := fun h => ha10 (congrArg Subtype.val h).symm
    exact Finite.one_lt_card_iff_nontrivial.2 ⟨⟨_, _, h1⟩⟩
  have hrank : ∀ a ∈ P, finrank (ZMod p) (E a) = finrank (ZMod p) (E a0) := by
    intro a ha
    obtain ⟨g, -, hg⟩ := htrans a ha
    rw [← hg]
    exact (Submodule.equivMapOfInjective _ (vsT_unit_inj g) (E a0)).finrank_eq.symm
  refine ⟨m, W, le_rfl, ?_, hm, ?_, ?_, ?_, ?_, ?_⟩
  · rw [Subgroup.subgroupOf_self]
    exact Subgroup.normal_top
  · exact hindep.comp (Subtype.val_injective.comp e.symm.injective)
  · rw [eq_top_iff, ← hsup, iSup_le_iff]
    intro a
    by_cases ha : a ∈ P
    · have : E a = W (e ⟨a, ha⟩) := by simp [W]
      rw [this]
      exact le_iSup W _
    · rw [hzero a ha]
      exact bot_le
  · intro i j
    rw [hrank _ (e.symm i).2, hrank _ (e.symm j).2]
  · intro g hg i
    obtain ⟨a', ha', h⟩ := hmap g hg _ (e.symm i).2
    exact ⟨e ⟨a', ha'⟩, by simp [W, h]⟩
  · rw [Subgroup.relIndex_self]
    exact Nat.one_le_pow _ _ (by omega)

end GI.Proved
