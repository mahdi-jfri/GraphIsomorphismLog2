import Workspace.Proved.VsPLb
import Workspace.Proved.VsPDerMath

/-!
# Why the grow output is correct

`A' = ⟨g y g⁻¹ : g ∈ H, y ∈ as ++ xs⟩` with `xs ⊆ N`, where `N ≤ H` is normalized by `H`,
`N̄` is abelian and centralizes `Ā`.

* `vsP_grow_le`: `⟨as⟩ ≤ A' ≤ ⟨as⟩ ⊔ N ≤ H`, and `A'` is normalized by `H`.
* `vsP_grow_abel`: `Ā'` is abelian.
* `vsP_grow_lt`: if some `x ∈ xs` has `Λ(x) ∉ L`, then `𝔽_p[Ā] < 𝔽_p[Ā']`.
-/

namespace GI.Proved

open GI.Impl GI.Cited GI.Lang Equiv

variable {I : VecStabInst} {s : VsQSt I}

/-- The normal closure computed by the grow program. -/
def vsPNcl (H : Subgroup (Perm (Fin I.n))) (ys : List (Perm (Fin I.n))) :
    Subgroup (Perm (Fin I.n)) :=
  Subgroup.closure {x | ∃ g ∈ H ⊔ gens ys, ∃ y ∈ ys, x = g * y * g⁻¹}

/-- `H` normalizes `K`. -/
def VsPNormd (H K : Subgroup (Perm (Fin I.n))) : Prop := ∀ h ∈ H, ∀ x ∈ K, h * x * h⁻¹ ∈ K

theorem vsPNcl_le {H K : Subgroup (Perm (Fin I.n))} {ys : List (Perm (Fin I.n))}
    (hyH : gens ys ≤ H) (hK : VsPNormd H K) (hy : ∀ y ∈ ys, y ∈ K) : vsPNcl H ys ≤ K := by
  refine (Subgroup.closure_le _).2 ?_
  rintro _ ⟨g, hg, y, hy', rfl⟩
  rw [sup_eq_left.2 hyH] at hg
  exact hK g hg y (hy y hy')

theorem vsPNcl_mem {H : Subgroup (Perm (Fin I.n))} {ys : List (Perm (Fin I.n))} {y : Perm (Fin I.n)}
    (hy : y ∈ ys) : y ∈ vsPNcl H ys :=
  Subgroup.subset_closure ⟨1, one_mem _, y, hy, by simp⟩

theorem vsPNcl_normd {H : Subgroup (Perm (Fin I.n))} {ys : List (Perm (Fin I.n))}
    (hyH : gens ys ≤ H) : VsPNormd H (vsPNcl H ys) := by
  intro h hh x hx
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨g, hg, y, hy, rfl⟩ := hx
    rw [sup_eq_left.2 hyH] at hg
    refine Subgroup.subset_closure ⟨h * g, ?_, y, hy, by group⟩
    rw [sup_eq_left.2 hyH]; exact mul_mem hh hg
  | one => simp
  | mul x y _ _ hx hy =>
    have : h * (x * y) * h⁻¹ = (h * x * h⁻¹) * (h * y * h⁻¹) := by group
    rw [this]; exact mul_mem hx hy
  | inv x _ hx =>
    have : h * x⁻¹ * h⁻¹ = (h * x * h⁻¹)⁻¹ := by group
    rw [this]; exact inv_mem hx

/-- The subgroup generated by the conjugates of the generators contains the generated group. -/
theorem vsPNcl_ge {H : Subgroup (Perm (Fin I.n))} {as xs : List (Perm (Fin I.n))} :
    gens as ≤ vsPNcl H (as ++ xs) :=
  (Subgroup.closure_le _).2 fun a ha => vsPNcl_mem (List.mem_append_left _ (by simpa using ha))

/-- The sup of two subgroups normalized by `H` is normalized by `H`. -/
theorem vsP_normd_sup {H K M : Subgroup (Perm (Fin I.n))} (hK : VsPNormd H K) (hM : VsPNormd H M) :
    VsPNormd H (K ⊔ M) := by
  intro h hh x hx
  rw [Subgroup.sup_eq_closure] at hx
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with hx | hx
    · exact Subgroup.mem_sup_left (hK h hh x hx)
    · exact Subgroup.mem_sup_right (hM h hh x hx)
  | one => simp
  | mul x y _ _ hx hy =>
    have : h * (x * y) * h⁻¹ = (h * x * h⁻¹) * (h * y * h⁻¹) := by group
    rw [this]; exact mul_mem hx hy
  | inv x _ hx =>
    have : h * x⁻¹ * h⁻¹ = (h * x * h⁻¹)⁻¹ := by group
    rw [this]; exact inv_mem hx

/-- **The local image of `A'` is abelian.** -/
theorem vsP_grow_abel (hs : VsQStOK s) {K N A' : Subgroup (Perm (Fin I.n))}
    (hK : K ≤ gens s.hs) (hN : N ≤ gens s.hs) (hA' : A' ≤ K ⊔ N)
    (hKab : vsPBar hs K ≤ Subgroup.centralizer (vsPBar hs K))
    (hNab : vsPBar hs N ≤ Subgroup.centralizer (vsPBar hs N))
    (hNK : vsPBar hs N ≤ Subgroup.centralizer (vsPBar hs K)) :
    vsPBar hs A' ≤ Subgroup.centralizer (vsPBar hs A') := by
  have hU : vsPBar hs A' ≤ vsPBar hs K ⊔ vsPBar hs N := by
    unfold vsPBar
    rw [← Subgroup.map_sup, ← Subgroup.subgroupOf_sup hK hN]
    exact Subgroup.map_mono fun x hx => by
      rw [Subgroup.mem_subgroupOf] at hx ⊢; exact hA' hx
  have hUab : vsPBar hs K ⊔ vsPBar hs N ≤
      Subgroup.centralizer ((vsPBar hs K ⊔ vsPBar hs N : Subgroup _) : Set _) := by
    have h1 : vsPBar hs K ⊔ vsPBar hs N ≤ Subgroup.centralizer (vsPBar hs K) := sup_le hKab hNK
    have h2 : vsPBar hs K ⊔ vsPBar hs N ≤ Subgroup.centralizer (vsPBar hs N) :=
      sup_le (Subgroup.le_centralizer_iff.1 hNK) hNab
    refine sup_le (Subgroup.le_centralizer_iff.1 h1) (Subgroup.le_centralizer_iff.1 h2)
  exact hU.trans (hUab.trans (Subgroup.centralizer_le (SetLike.coe_subset_coe.2 hU)))

theorem vsPBar_mono (hs : VsQStOK s) {K K' : Subgroup (Perm (Fin I.n))} (h : K ≤ K') :
    vsPBar hs K ≤ vsPBar hs K' :=
  Subgroup.map_mono fun x hx => by rw [Subgroup.mem_subgroupOf] at hx ⊢; exact h hx

theorem vsPBar_mem (hs : VsQStOK s) {K : Subgroup (Perm (Fin I.n))} {x : Perm (Fin I.n)}
    (hx : x ∈ gens s.hs) (hxK : x ∈ K) : vsQRho hs ⟨x, hx⟩ ∈ vsPBar hs K :=
  Subgroup.mem_map.2 ⟨⟨x, hx⟩, by rw [Subgroup.mem_subgroupOf]; exact hxK, rfl⟩

/-- **Strict growth.** -/
theorem vsP_grow_lt [Fact I.p.Prime] (hs : VsQStOK s) {K K' : Subgroup (Perm (Fin I.n))}
    (hle : K ≤ K') {x : Perm (Fin I.n)} (hx : x ∈ gens s.hs) (hxK : x ∈ K')
    (hxS : vsQRho hs ⟨x, hx⟩ ∉ vsMScal (vsPBar hs K)) :
    vsTAlg (vsPBar hs K) < vsTAlg (vsPBar hs K') := by
  have hmono : vsTAlg (vsPBar hs K) ≤ vsTAlg (vsPBar hs K') := by
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨u, hu, rfl⟩
    exact ⟨u, vsPBar_mono hs hle hu, rfl⟩
  refine lt_of_le_of_ne hmono fun he => hxS ?_
  rw [vsM_mem_scal_iff, he]
  exact Algebra.subset_adjoin ⟨_, vsPBar_mem hs hx hxK, rfl⟩

/-- The derived subgroup of a subgroup normalized by `H` is normalized by `H`. -/
theorem vsP_normd_commutator {H K : Subgroup (Perm (Fin I.n))} (hK : VsPNormd H K) :
    VsPNormd H ⁅K, K⁆ := by
  intro h hh x hx
  rw [Subgroup.commutator_def] at hx ⊢
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    refine Subgroup.subset_closure ⟨h * a * h⁻¹, hK h hh a ha, h * b * h⁻¹, hK h hh b hb, ?_⟩
    simp only [commutatorElement_def]; group
  | one => simp
  | mul x y _ _ hx hy =>
    have : h * (x * y) * h⁻¹ = (h * x * h⁻¹) * (h * y * h⁻¹) := by group
    rw [this]; exact mul_mem hx hy
  | inv x _ hx =>
    have : h * x⁻¹ * h⁻¹ = (h * x * h⁻¹)⁻¹ := by group
    rw [this]; exact inv_mem hx

theorem vsPDer_normd {H C : Subgroup (Perm (Fin I.n))} (hC : VsPNormd H C) :
    ∀ j, VsPNormd H (vsPDer C j)
  | 0 => hC
  | j + 1 => vsP_normd_commutator (vsPDer_normd hC j)

/-- A generator outside a subgroup. -/
theorem vsP_exists_gen_not_mem {ns : List (Perm (Fin I.n))} {Sp : Subgroup (Perm (Fin I.n))}
    (h : ¬ gens ns ≤ Sp) : ∃ x ∈ ns, x ∉ Sp := by
  by_contra hc
  push Not at hc
  exact h ((Subgroup.closure_le _).2 fun x hx => hc x (by simpa using hx))

end GI.Proved

namespace GI.Proved

open GI.Impl GI.Cited GI.Lang Equiv

variable {I : VecStabInst} {s : VsQSt I}

/-- A matrix commuting with `Λ(y)` commutes with `Λ(y⁻¹)`. -/
theorem vsQLam_comm_inv (hs : VsQStOK s) {M : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)}
    {y : Perm (Fin I.n)} (hy : y ∈ gens s.hs) (h : M * vsQLam s y = vsQLam s y * M) :
    M * vsQLam s y⁻¹ = vsQLam s y⁻¹ * M := by
  have h1 := vsQLam_inv hs hy
  have h2 : vsQLam s y⁻¹ * vsQLam s y = 1 := Matrix.mul_eq_one_comm.1 h1
  calc M * vsQLam s y⁻¹ = vsQLam s y⁻¹ * (vsQLam s y * M) * vsQLam s y⁻¹ := by
        rw [← mul_assoc, h2, one_mul]
    _ = vsQLam s y⁻¹ * (M * vsQLam s y) * vsQLam s y⁻¹ := by rw [h]
    _ = vsQLam s y⁻¹ * M := by rw [mul_assoc, mul_assoc, h1, mul_one]

/-- If the local matrices of the generators commute, so do those of the generated group. -/
theorem vsQLam_comm_closure (hs : VsQStOK s) {ns : List (Perm (Fin I.n))}
    (hns : gens ns ≤ gens s.hs)
    (hc : ∀ g ∈ ns, ∀ h ∈ ns, vsQLam s g * vsQLam s h = vsQLam s h * vsQLam s g) :
    ∀ x ∈ gens ns, ∀ y ∈ gens ns, vsQLam s x * vsQLam s y = vsQLam s y * vsQLam s x := by
  -- first: generators against the group
  have step : ∀ (M : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)),
      (∀ h ∈ ns, M * vsQLam s h = vsQLam s h * M) →
      ∀ y ∈ gens ns, M * vsQLam s y = vsQLam s y * M := by
    intro M hM y hy
    induction hy using Subgroup.closure_induction with
    | mem y hy => exact hM y (by simpa using hy)
    | one => rw [vsQLam_one hs, mul_one, one_mul]
    | mul a b ha hb iha ihb =>
      rw [vsQLam_mul hs (hns ha) (hns hb), ← mul_assoc, iha, mul_assoc, ihb, mul_assoc]
    | inv a ha iha => exact vsQLam_comm_inv hs (hns ha) iha
  intro x hx y hy
  have hxg : ∀ h ∈ ns, vsQLam s x * vsQLam s h = vsQLam s h * vsQLam s x := by
    intro h hh
    exact (step (vsQLam s h) (fun g hg => hc h hh g hg) x hx).symm
  exact step (vsQLam s x) hxg y hy

/-- **From commuting stored local matrices to an abelian local image.** -/
theorem vsP_bar_abel (hs : VsQStOK s) {ns : List (Perm (Fin I.n))} (hns : gens ns ≤ gens s.hs)
    (hc : ∀ g ∈ ns, ∀ h ∈ ns, vsQLam s (g * h) = vsQLam s (h * g)) :
    vsPBar hs (gens ns) ≤ Subgroup.centralizer (vsPBar hs (gens ns) : Set _) := by
  have hc' : ∀ g ∈ ns, ∀ h ∈ ns, vsQLam s g * vsQLam s h = vsQLam s h * vsQLam s g := by
    intro g hg h hh
    have hg' := hns (Subgroup.subset_closure (by simpa using hg))
    have hh' := hns (Subgroup.subset_closure (by simpa using hh))
    rw [← vsQLam_mul hs hg' hh', ← vsQLam_mul hs hh' hg']; exact hc g hg h hh
  have hall := vsQLam_comm_closure hs hns hc'
  rintro _ ⟨⟨x, hx⟩, hxK, rfl⟩
  rw [Subgroup.mem_centralizer_iff]
  rintro _ ⟨⟨y, hy⟩, hyK, rfl⟩
  rw [SetLike.mem_coe, Subgroup.mem_subgroupOf] at hxK hyK
  apply Units.ext
  simp only [Units.val_mul, vsQRho_eq_toLin' hs]
  rw [Module.End.mul_eq_comp, Module.End.mul_eq_comp, ← Matrix.toLin'_mul, ← Matrix.toLin'_mul,
    hall y hyK x hxK]

end GI.Proved
