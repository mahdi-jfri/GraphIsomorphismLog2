import Workspace.Proved.VsPBridge
import Workspace.Proved.VsPHardMath

/-!
# The facts for `N₂ = ⟨x₂⟩^H`

Let `N₀ ≤ ⟨hs⟩` be normalized by `hs`, with local image centralizing `Ā` and commutators in
`S = vsMScal Ā`. Let `x₂ ∈ N₀` with `Λ(x₂)^r ∈ S`. The normal closure `N₂` of `x₂` lies in `N₀`,
and its local image `N̄₂`
* centralizes `Ā`, has commutators in `S`, and is normalized by the images of `hs`;
* has all `r`-th powers in `S` (`vsM_pair`, since the generators are conjugates of `x₂`).
-/

namespace GI.Proved

open GI.Impl GI.Cited GI.Lang Equiv Module
open scoped commutatorElement

variable {I : VecStabInst} {s : VsQSt I} (hs : VsQStOK s)

/-- The local image of a generated subgroup is generated by the images. -/
theorem vsPBar_closure {X : Set (Perm (Fin I.n))} (hX : X ⊆ gens s.hs) :
    vsPBar hs (Subgroup.closure X) = Subgroup.closure (vsPRho hs '' X) := by
  have hle : Subgroup.closure X ≤ gens s.hs := (Subgroup.closure_le _).2 hX
  apply le_antisymm
  · intro u hu
    obtain ⟨x, hx, -, rfl⟩ := (vsPBar_mem_iff hs).1 hu
    clear hu
    induction hx using Subgroup.closure_induction with
    | mem x hx => exact Subgroup.subset_closure ⟨x, hx, rfl⟩
    | one => rw [vsPRho_one]; exact one_mem _
    | mul x y hx hy ihx ihy => rw [vsPRho_mul hs (hle hx) (hle hy)]; exact mul_mem ihx ihy
    | inv x hx ihx => rw [vsPRho_inv hs (hle hx)]; exact inv_mem ihx
  · refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨y, hy, rfl⟩
    exact vsPRho_mem_vsPBar hs (Subgroup.subset_closure hy) (hX hy)

/-- Images of perms normalized by `hs` are normalized by the images of `hs`. -/
theorem vsPBar_normd {K : Subgroup (Perm (Fin I.n))} (hK : K ≤ gens s.hs)
    (hKn : VsPNormd (gens s.hs) K) :
    ∀ h ∈ vsPRho hs '' {y | y ∈ s.hs}, ∀ x ∈ vsPBar hs K, h * x * h⁻¹ ∈ vsPBar hs K := by
  rintro _ ⟨h, hh, rfl⟩ u hu
  obtain ⟨x, hxK, hx, rfl⟩ := (vsPBar_mem_iff hs).1 hu
  have hhg : h ∈ gens s.hs := Subgroup.subset_closure hh
  rw [← vsPRho_conj hs hx hhg]
  exact vsPRho_mem_vsPBar hs (hKn h hhg x hxK) (hK (hKn h hhg x hxK))

variable [Fact I.p.Prime]

/-- **The facts for `N̄₂`.** -/
theorem vsP_N2_facts [Nontrivial (Fin (vsQD s) → ZMod I.p)] {as : List (Perm (Fin I.n))}
    (hAN : VsTAbNormal (vsPBar hs (gens s.hs)) (vsPBar hs (gens as)))
    {N0 : Subgroup (Perm (Fin I.n))} (hN0 : N0 ≤ gens s.hs) (hN0n : VsPNormd (gens s.hs) N0)
    (hN0C : vsPBar hs N0 ≤ Subgroup.centralizer (vsPBar hs (gens as) : Set _))
    (hN0c : ∀ x ∈ N0, ∀ y ∈ N0, vsPRho hs ⁅x, y⁆ ∈ vsMScal (vsPBar hs (gens as)))
    {x2 : Perm (Fin I.n)} (hx2 : x2 ∈ N0) {r : ℕ}
    (hx2r : vsPRho hs (x2 ^ r) ∈ vsMScal (vsPBar hs (gens as))) :
    vsPNcl (gens s.hs) [x2] ≤ N0 ∧
      vsPBar hs (vsPNcl (gens s.hs) [x2]) ≤
        Subgroup.centralizer (vsPBar hs (gens as) : Set _) ∧
      (∀ x ∈ vsPBar hs (vsPNcl (gens s.hs) [x2]), ∀ y ∈ vsPBar hs (vsPNcl (gens s.hs) [x2]),
        ⁅x, y⁆ ∈ vsMScal (vsPBar hs (gens as))) ∧
      (∀ x ∈ vsPBar hs (vsPNcl (gens s.hs) [x2]), x ^ r ∈ vsMScal (vsPBar hs (gens as))) ∧
      (∀ h ∈ vsPRho hs '' {y | y ∈ s.hs}, ∀ x ∈ vsPBar hs (vsPNcl (gens s.hs) [x2]),
        h * x * h⁻¹ ∈ vsPBar hs (vsPNcl (gens s.hs) [x2])) := by
  set S := vsMScal (vsPBar hs (gens as))
  have hx2g : x2 ∈ gens s.hs := hN0 hx2
  have hyH : gens [x2] ≤ gens s.hs := (Subgroup.closure_le _).2 fun y hy => by
    simp at hy; rw [hy]; exact hx2g
  have hle : vsPNcl (gens s.hs) [x2] ≤ N0 := vsPNcl_le hyH hN0n (by simpa using hx2)
  have hN2g : vsPNcl (gens s.hs) [x2] ≤ gens s.hs := hle.trans hN0
  have hbarle : vsPBar hs (vsPNcl (gens s.hs) [x2]) ≤ vsPBar hs N0 := by
    intro u hu
    obtain ⟨x, hxK, hx, rfl⟩ := (vsPBar_mem_iff hs).1 hu
    exact vsPRho_mem_vsPBar hs (hle hxK) hx
  have hcomm : ∀ x ∈ vsPBar hs (vsPNcl (gens s.hs) [x2]), ∀ y ∈ vsPBar hs (vsPNcl (gens s.hs) [x2]),
      ⁅x, y⁆ ∈ S := by
    intro u hu v hv
    obtain ⟨x, hxK, hx, rfl⟩ := (vsPBar_mem_iff hs).1 hu
    obtain ⟨y, hyK, hy, rfl⟩ := (vsPBar_mem_iff hs).1 hv
    rw [← vsPRho_comm hs hx hy]
    exact hN0c x (hle hxK) y (hle hyK)
  refine ⟨hle, hbarle.trans hN0C, hcomm, ?_, vsPBar_normd hs hN2g (vsPNcl_normd hyH)⟩
  -- the `r`-th powers, through the generators `ρ(g x₂ g⁻¹)`
  set X : Set (Perm (Fin I.n)) := {x | ∃ g ∈ gens s.hs ⊔ gens [x2], ∃ y ∈ [x2], x = g * y * g⁻¹}
  have hX : X ⊆ gens s.hs := fun x hx => hN2g (Subgroup.subset_closure hx)
  have hbar : vsPBar hs (vsPNcl (gens s.hs) [x2]) = Subgroup.closure (vsPRho hs '' X) :=
    vsPBar_closure hs hX
  have hT : vsPRho hs '' X ⊆ (Subgroup.centralizer (vsPBar hs (gens as) : Set (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ) : Set _) := by
    intro u hu
    refine hN0C (hbarle ?_)
    rw [hbar]; exact Subgroup.subset_closure hu
  obtain ⟨-, -, hpw⟩ := vsM_pair (p := I.p) (V := Fin (vsQD s) → ZMod I.p)
    (vsPBar hs (gens as)) (vsPRho hs '' X) r hT (by rw [← hbar]; exact hcomm)
  intro u hu
  rw [hbar] at hu
  refine hpw ?_ u hu
  rintro _ ⟨x, ⟨g, hg, y, hy, rfl⟩, rfl⟩
  simp only [List.mem_singleton] at hy
  rw [hy]
  rw [sup_eq_left.2 hyH] at hg
  have hc : g * x2 * g⁻¹ ∈ gens s.hs := mul_mem (mul_mem hg hx2g) (inv_mem hg)
  rw [← vsPRho_pow hs hc, conj_pow, vsPRho_conj hs (pow_mem hx2g r) hg]
  exact vsM_scal_norm hAN _ (vsPRho_mem_vsPBar hs hg hg) _ hx2r

end GI.Proved
