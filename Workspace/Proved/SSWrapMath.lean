module

public import Workspace.Proved.SSConstr

@[expose] public section

/-!
# The answers read off a closed table

* The entries at levels `≥ k₀` are the entries in the slots `k₀ n, …, |B| n - 1`
  (`ss_stab_set`), so they form the list `ssStabList T k₀ ((|B| - k₀) n)` of at most
  `(|B| - k₀) n` permutations.
* The count `ssCnt T k` of filled slots at level `k` is the length of a filter over `range n`
  (`ssCnt_eq`).
-/

namespace GI.Proved

open Equiv GI.Cited

variable {n : ℕ}

/-- The entries in the slots `k₀ n + q`, `q < m`, in order. -/
def ssStabList (T : List (SsSlot n)) (k0 m : ℕ) : List (Perm (Fin n)) :=
  (List.range m).filterMap fun q => ((T[k0 * n + q]?).join).map Prod.fst

theorem length_ssStabList (T : List (SsSlot n)) (k0 m : ℕ) : (ssStabList T k0 m).length ≤ m := by
  unfold ssStabList
  exact (List.length_filterMap_le _ _).trans (by simp)

/-- **The entries at levels `≥ k₀` are the listed ones.** -/
theorem ss_stab_set {B : List (Fin n)} {T : List (SsSlot n)} (hwf : SsWF B T) {k0 : ℕ}
    (hk : k0 ≤ B.length) :
    {g | SsEnt T k0 g} = {g | g ∈ ssStabList T k0 ((B.length - k0) * n)} := by
  ext g
  simp only [Set.mem_setOf_eq, ssStabList, List.mem_filterMap, List.mem_range]
  constructor
  · rintro ⟨i, j, e, hki, he, rfl⟩
    obtain ⟨hi, -⟩ := hwf.slot i j e he
    refine ⟨(i - k0) * n + j, ?_, ?_⟩
    · have : (i - k0) * n + (j : ℕ) < (i - k0) * n + n := by have := j.isLt; omega
      calc (i - k0) * n + (j : ℕ) < (i - k0 + 1) * n := by rw [Nat.add_mul, one_mul]; exact this
        _ ≤ (B.length - k0) * n := Nat.mul_le_mul_right _ (by omega)
    · have e1 : k0 * n + ((i - k0) * n + (j : ℕ)) = i * n + (j : ℕ) := by
        rw [← Nat.add_assoc, ← Nat.add_mul, Nat.add_sub_cancel' hki]
      rw [e1]
      unfold ssGet at he
      rw [he]; rfl
  · rintro ⟨q, hq, hqe⟩
    have hn : 0 < n := by
      rcases Nat.eq_zero_or_pos n with h | h
      · subst h; simp at hq
      · exact h
    cases hs : (T[k0 * n + q]?).join with
    | none => rw [hs] at hqe; simp at hqe
    | some e =>
      rw [hs] at hqe
      simp only [Option.map_some, Option.some.injEq] at hqe
      refine ⟨k0 + q / n, ⟨q % n, Nat.mod_lt _ hn⟩, e, Nat.le_add_right _ _, ?_, hqe⟩
      unfold ssGet
      have : (k0 + q / n) * n + q % n = k0 * n + q := by
        rw [Nat.add_mul, Nat.add_assoc, Nat.div_add_mod' q n]
      simp only
      rw [this, hs]

/-- **The pointwise stabilizer is generated by the listed entries.** -/
theorem ss_stab_gens {B S C : List (Fin n)} {T : List (SsSlot n)} (hBS : B = S ++ C)
    (hB : ∀ x, x ∈ B) (hwf : SsWF B T) (hc : SsClosed B T) {gs : List (Perm (Fin n))}
    (hent : ∀ i j e, ssGet T i j = some e → e.1 ∈ gens gs)
    (hgen : ∀ g ∈ gs, ssThru T B 0 g = true) :
    gens (ssStabList T S.length ((B.length - S.length) * n)) = pointwiseStab (gens gs) S := by
  rw [ss_pointwiseStab_eq hBS hB hwf hc hent hgen,
    ss_stab_set hwf (by rw [hBS, List.length_append]; omega)]
  rfl

/-- The number of filled slots at level `k`, as a filter. -/
theorem ssCnt_eq (T : List (SsSlot n)) (k : ℕ) :
    ssCnt T k = ((List.range n).filter fun j => ((T[k * n + j]?).join).isSome).length := by
  unfold ssCnt
  rw [← List.map_coe_finRange_eq_range, List.filter_map, List.length_map]
  rw [← List.toFinset_card_of_nodup ((List.nodup_finRange n).filter _)]
  congr 1
  ext j
  rw [Finset.mem_filter, List.mem_toFinset]
  simp [ssGet, Function.comp_def]

end GI.Proved
