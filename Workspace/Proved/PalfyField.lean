module

public import Workspace.Proved.PalfyImprim
public import Workspace.Proved.SolvOrderPrimitive

@[expose] public section

/-!
# The field step

Let `H` be an irreducible solvable linear group on `V` over a finite field `K`, and `A` an
abelian normal subgroup of `H`. Let `R = K[A] ⊆ End_K(V)` be the algebra generated by `A`
(`GI.Proved.palfyAdj`). It is commutative and normalized by `H` (`GI.Proved.palfyAdj_alg`).

Suppose `R` is a field `L` larger than `K`. Then `V` is an `L`-space, and the centralizer
`C = C_H(A)` acts `L`-linearly. We bound `|H|` through `C` (`GI.Proved.palfy_field_step`):
* `A` embeds in `L^×`, so it is cyclic. If `a` generates `A`, then `h ↦ h a h⁻¹` is a map from
  `H` to `A` whose fibers lie in cosets of `C`. So `|H| ≤ |A| |C| ≤ |L| |C|`.
* `C` is completely reducible over `K` by Clifford (`GI.Proved.palfy_clifford`), and a
  `C`-invariant subspace is `A`-invariant, hence `L`-invariant, since `A ≤ C`. So `C` is
  completely reducible over `L`.
* `|L| ≥ |K|^2`, because `L ≠ K` and `|L|` is a power of `|K|`.
With the bound `24 |L|^6 |C|^3 ≤ |V|^E` over `L`, we get
`24 |K|^6 |H|^3 ≤ 24 |L|^3 |L|^3 |C|^3 ≤ |V|^E`.
-/

namespace GI.Proved

/-- The induction hypothesis over larger fields, for spaces of size exactly `n`. -/
def PalfyIH2 (E n m : ℕ) : Prop :=
  ∀ (L : Type) [Field L] [Finite L] (W : Type) [AddCommGroup W] [Module L W] [Finite W]
    [Nontrivial W], Nat.card W = n → m < Nat.card L →
    ∀ G : Subgroup (Module.End L W)ˣ, IsSolvable G → palfyCR G →
      24 * Nat.card L ^ 6 * Nat.card G ^ 3 ≤ Nat.card W ^ E

variable {K V : Type} [Field K] [AddCommGroup V] [Module K V]

/-- The algebra generated by a subgroup of `GL(V)`. -/
def palfyAdj (A : Subgroup (Module.End K V)ˣ) : Subalgebra K (Module.End K V) :=
  Algebra.adjoin K ((fun u : (Module.End K V)ˣ => (u : Module.End K V)) '' (A : Set _))

theorem palfyAdj_mem {A : Subgroup (Module.End K V)ˣ} {a : (Module.End K V)ˣ} (ha : a ∈ A) :
    (a : Module.End K V) ∈ palfyAdj A :=
  Algebra.subset_adjoin ⟨a, ha, rfl⟩

/-- An operator commuting with every element of `A` commutes with all of `K[A]`. -/
theorem palfyAdj_comm_of {A : Subgroup (Module.End K V)ˣ} {x : Module.End K V}
    (hx : ∀ a ∈ A, x * (a : Module.End K V) = (a : Module.End K V) * x) :
    ∀ r ∈ palfyAdj A, x * r = r * x := by
  have : palfyAdj A ≤ Subalgebra.centralizer K {x} := by
    apply Algebra.adjoin_le
    rintro _ ⟨a, ha, rfl⟩
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    rintro _ rfl
    exact hx a ha
  intro r hr
  have := (Subalgebra.mem_centralizer_iff K).mp (this hr) x rfl
  exact this

/-- A subspace invariant under `A` is invariant under `K[A]`. -/
theorem palfyAdj_inv {A : Subgroup (Module.End K V)ˣ} {X : Submodule K V} (hX : palfyInv A X) :
    ∀ r ∈ palfyAdj A, ∀ v ∈ X, r v ∈ X := by
  intro r hr
  induction hr using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    exact hX a ha
  | algebraMap k =>
    intro v hv
    rw [Module.algebraMap_end_apply]
    exact X.smul_mem k hv
  | add x y _ _ ihx ihy =>
    intro v hv
    rw [LinearMap.add_apply]
    exact X.add_mem (ihx v hv) (ihy v hv)
  | mul x y _ _ ihx ihy =>
    intro v hv
    rw [Module.End.mul_apply]
    exact ihx _ (ihy v hv)

/-- `K[A]` is commutative and normalized by `H`. -/
theorem palfyAdj_alg {A H : Subgroup (Module.End K V)ˣ} (hAH : palfyNormal A H)
    (hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x) : PalfyAlg H (palfyAdj A) := by
  constructor
  · intro x hx y hy
    have hxc : ∀ a ∈ A, x * (a : Module.End K V) = (a : Module.End K V) * x := by
      intro a ha
      exact (palfyAdj_comm_of (A := A) (x := (a : Module.End K V))
        (fun b hb => congrArg Units.val (hAc a ha b hb)) x hx).symm
    exact palfyAdj_comm_of hxc y hy
  · intro h hh x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      have := palfyAdj_mem (A := A) (hAH.2 h hh a ha)
      simpa using this
    | algebraMap k =>
      rw [mul_assoc, Algebra.commutes, ← mul_assoc, Units.mul_inv, one_mul]
      exact Subalgebra.algebraMap_mem _ k
    | add x y _ _ ihx ihy =>
      rw [mul_add, add_mul]
      exact Subalgebra.add_mem _ ihx ihy
    | mul x y _ _ ihx ihy =>
      have : (h : Module.End K V) * (x * y) * ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V) =
          ((h : Module.End K V) * x * ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V)) *
          ((h : Module.End K V) * y * ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V)) := by
        have h1 : ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V) * (h : Module.End K V) = 1 :=
          Units.inv_mul h
        simp only [mul_assoc]
        rw [← mul_assoc ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V), h1, one_mul]
      rw [this]
      exact Subalgebra.mul_mem _ ihx ihy

/-- The centralizer of `A` in `H`. -/
def palfyCent (H A : Subgroup (Module.End K V)ˣ) : Subgroup (Module.End K V)ˣ :=
  H ⊓ Subgroup.centralizer (A : Set (Module.End K V)ˣ)

theorem palfyCent_normal {A H : Subgroup (Module.End K V)ˣ} (hAH : palfyNormal A H) :
    palfyNormal (palfyCent H A) H := by
  refine ⟨inf_le_left, ?_⟩
  intro h hh c hc'
  obtain ⟨hc, hcA⟩ := Subgroup.mem_inf.mp hc'
  refine Subgroup.mem_inf.mpr ⟨H.mul_mem (H.mul_mem hh hc) (H.inv_mem hh), ?_⟩
  rw [Subgroup.mem_centralizer_iff] at hcA ⊢
  intro a ha
  have ha' : h⁻¹ * a * h ∈ A := by
    have := hAH.2 _ (H.inv_mem hh) a ha
    rwa [inv_inv] at this
  have := hcA _ ha'
  calc a * (h * c * h⁻¹) = h * ((h⁻¹ * a * h) * c) * h⁻¹ := by group
    _ = h * (c * (h⁻¹ * a * h)) * h⁻¹ := by rw [this]
    _ = h * c * h⁻¹ * a := by group

/-- A field acting on a nonzero space has at most as many elements as the space. -/
theorem palfy_card_field_le (L W : Type) [Field L] [AddCommGroup W] [Module L W] [Finite W]
    [Nontrivial W] : Nat.card L ≤ Nat.card W := by
  obtain ⟨w, hw⟩ := exists_ne (0 : W)
  exact Nat.card_le_card_of_injective (fun c : L => c • w) (smul_left_injective L hw)

section field

variable [Finite V] (A : Subgroup (Module.End K V)ˣ) (hF : IsField (palfyAdj A))

/-- The field structure on `K[A]`. -/
noncomputable abbrev palfyFld : Field (palfyAdj A) := hF.toField

/-- `V` as a vector space over `K[A]`. -/
noncomputable abbrev palfyMod : @Module (palfyAdj A)
    V (@DivisionSemiring.toSemiring _ (@Semifield.toDivisionSemiring _
      (@Field.toSemifield _ (palfyFld A hF)))) _ :=
  Module.compHom V (palfyAdj A).val.toRingHom

/-- An operator commuting with `K[A]`, as a `K[A]`-linear map. -/
noncomputable def palfyLin (x : Module.End K V)
    (hx : ∀ r ∈ palfyAdj A, x * r = r * x) :
    @Module.End (palfyAdj A) V (@DivisionSemiring.toSemiring _ (@Semifield.toDivisionSemiring _
      (@Field.toSemifield _ (palfyFld A hF)))) _ (palfyMod A hF) :=
  letI := palfyFld A hF
  letI := palfyMod A hF
  { toFun := x
    map_add' := map_add x
    map_smul' := fun r v => by
      change x ((r : Module.End K V) v) = (r : Module.End K V) (x v)
      rw [← Module.End.mul_apply, hx r r.2, Module.End.mul_apply] }

end field

/-- `|K[A]| ≥ |K|^2` when `K[A] ≠ K`. -/
theorem palfy_card_adj [Finite K] [Finite V] [Nontrivial V] {A : Subgroup (Module.End K V)ˣ}
    (hne : palfyAdj A ≠ ⊥) : Nat.card K ^ 2 ≤ Nat.card (palfyAdj A) := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Fintype (palfyAdj A) := Fintype.ofFinite _
  haveI : Module.Finite K (palfyAdj A) := Module.Finite.of_finite
  have h1 : 1 < Nat.card (palfyAdj A) := Finite.one_lt_card
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card,
    Module.card_eq_pow_finrank (K := K) (V := palfyAdj A)] at *
  apply Nat.pow_le_pow_right Fintype.card_pos
  by_contra hlt
  push Not at hlt
  interval_cases hd : Module.finrank K (palfyAdj A)
  · simp at h1
  · exact hne (Subalgebra.eq_bot_of_finrank_one hd)

/-- **The field step.** -/
theorem palfy_field_step [Finite K] [Finite V] [Nontrivial V] {E : ℕ}
    (ih : PalfyIH2 E (Nat.card V) (Nat.card K))
    {H A : Subgroup (Module.End K V)ˣ} [Group.IsSolvable H] (hH : palfyIrr H)
    (hAH : palfyNormal A H) (hAc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x)
    (hF : IsField (palfyAdj A)) (hne : palfyAdj A ≠ ⊥) :
    24 * Nat.card K ^ 6 * Nat.card H ^ 3 ≤ Nat.card V ^ E := by
  classical
  have hKR := palfy_card_adj hne
  have hK2 : 1 < Nat.card K := Finite.one_lt_card
  letI := palfyFld A hF
  letI := palfyMod A hF
  set C := palfyCent H A
  have hcR : ∀ c ∈ C, ∀ r ∈ (palfyAdj A), (c : Module.End K V) * r = r * (c : Module.End K V) := by
    intro c hc
    apply palfyAdj_comm_of
    intro a ha
    exact congrArg Units.val (Subgroup.mem_centralizer_iff.mp (Subgroup.mem_inf.mp hc).2 a ha).symm
  let ψ : C →* (Module.End (palfyAdj A) V)ˣ :=
    { toFun := fun c =>
        { val := palfyLin A hF ((c : (Module.End K V)ˣ) : Module.End K V) (hcR c c.2)
          inv := palfyLin A hF (((c⁻¹ : C) : (Module.End K V)ˣ) : Module.End K V) (hcR _ (C.inv_mem c.2))
          val_inv := LinearMap.ext fun v => by
            change ((c * c⁻¹ : (Module.End K V)ˣ) : Module.End K V) v = v
            simp
          inv_val := LinearMap.ext fun v => by
            change ((c⁻¹ * c : (Module.End K V)ˣ) : Module.End K V) v = v
            simp }
      map_one' := Units.ext (LinearMap.ext fun v => rfl)
      map_mul' := fun a b => Units.ext (LinearMap.ext fun v => rfl) }
  have hψ : ∀ c : C, ∀ v : V, (((ψ c : (Module.End (palfyAdj A) V)ˣ) : Module.End (palfyAdj A) V) v) =
      ((c : (Module.End K V)ˣ) : Module.End K V) v := fun _ _ => rfl
  have hψinj : Function.Injective ψ := by
    intro a b hab
    apply Subtype.ext; apply Units.ext; apply LinearMap.ext
    intro v
    rw [← hψ, ← hψ, hab]
  have hCcard : Nat.card C = Nat.card ψ.range :=
    Nat.card_congr (MonoidHom.ofInjective hψinj).toEquiv
  haveI : Group.IsSolvable C := solvable_of_solvable_injective (Subgroup.inclusion_injective
    (inf_le_left : C ≤ H))
  haveI : Group.IsSolvable ψ.range := solvable_of_surjective ψ.rangeRestrict_surjective
  have hAC : ∀ a ∈ A, a ∈ C := by
    intro a ha
    refine Subgroup.mem_inf.mpr ⟨hAH.1 ha, Subgroup.mem_centralizer_iff.mpr ?_⟩
    intro b hb
    exact hAc b hb a ha
  have hCR : palfyCR ψ.range := by
    intro W hW
    let WK : Submodule K V :=
      { carrier := W
        add_mem' := W.add_mem
        zero_mem' := W.zero_mem
        smul_mem' := fun k v hv => by
          have : (⟨algebraMap K (Module.End K V) k, (palfyAdj A).algebraMap_mem k⟩ : (palfyAdj A)) • v ∈ W :=
            W.smul_mem _ hv
          exact (Module.algebraMap_end_apply K K V k v) ▸ this }
    have hWK : palfyInv C WK := by
      intro c hc v hv
      exact hW _ ⟨⟨c, hc⟩, rfl⟩ v hv
    obtain ⟨X, hX, hc⟩ := palfy_clifford hH (palfyCent_normal hAH) WK hWK
    have hXA : palfyInv A X := fun a ha => hX a (hAC a ha)
    let XR : Submodule (palfyAdj A) V :=
      { carrier := X
        add_mem' := X.add_mem
        zero_mem' := X.zero_mem
        smul_mem' := fun r v hv => palfyAdj_inv hXA r r.2 v hv }
    refine ⟨XR, ?_, ?_, ?_⟩
    · rintro _ ⟨c, rfl⟩ v hv
      exact hX c c.2 v hv
    · rw [disjoint_iff, eq_bot_iff]
      intro v hv
      have : v ∈ WK ⊓ X := hv
      rw [hc.inf_eq_bot, Submodule.mem_bot] at this
      exact (Submodule.mem_bot (palfyAdj A)).mpr this
    · rw [codisjoint_iff, eq_top_iff]
      intro v _
      have : v ∈ WK ⊔ X := by rw [hc.sup_eq_top]; exact Submodule.mem_top
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp this
      exact Submodule.add_mem_sup (S := W) (T := XR) hy hz
  have hKlt : Nat.card K < Nat.card (palfyAdj A) := by nlinarith
  have hbound := ih (palfyAdj A) V rfl hKlt ψ.range (inferInstance : Group.IsSolvable ψ.range) hCR
  -- `A` is cyclic
  let f : A →* (palfyAdj A) :=
    { toFun := fun a => ⟨((a : (Module.End K V)ˣ) : Module.End K V), palfyAdj_mem a.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hfinj : Function.Injective f := by
    intro a b hab
    exact Subtype.ext (Units.ext (congrArg Subtype.val hab))
  haveI : IsCyclic A := isCyclic_of_injective_ringHom f hfinj
  obtain ⟨a0, ha0⟩ := IsCyclic.exists_generator (α := A)
  have hfib := solv_card_le_mul_of_fibers H C inf_le_left
    (fun h : H => (⟨(h : (Module.End K V)ˣ) * a0 * (h : (Module.End K V)ˣ)⁻¹,
      hAH.2 h h.2 a0 a0.2⟩ : A)) (by
      intro x y hxy
      have hxy' := congrArg Subtype.val hxy
      simp only at hxy'
      refine Subgroup.mem_inf.mpr ⟨H.mul_mem (H.inv_mem x.2) y.2,
        Subgroup.mem_centralizer_iff.mpr ?_⟩
      intro a ha
      obtain ⟨n, hn⟩ := ha0 ⟨a, ha⟩
      have hcomm : Commute ((x : (Module.End K V)ˣ)⁻¹ * y) (a0 : (Module.End K V)ˣ) := by
        change _ * _ = _ * _
        calc (x : (Module.End K V)ˣ)⁻¹ * y * a0
            = (x : (Module.End K V)ˣ)⁻¹ * (y * a0 * (y : (Module.End K V)ˣ)⁻¹) * y := by group
          _ = (x : (Module.End K V)ˣ)⁻¹ * (x * a0 * (x : (Module.End K V)ˣ)⁻¹) * y := by
            rw [hxy']
          _ = a0 * ((x : (Module.End K V)ˣ)⁻¹ * y) := by group
      have := (hcomm.zpow_right n).eq
      have hn' : (a0 : (Module.End K V)ˣ) ^ n = a := by
        have := congrArg Subtype.val hn
        simpa using this
      rw [hn'] at this
      exact this.symm)
  have hAR : Nat.card A ≤ Nat.card (palfyAdj A) := Nat.card_le_card_of_injective f hfinj
  rw [hCcard] at hfib
  calc 24 * Nat.card K ^ 6 * Nat.card H ^ 3
      ≤ 24 * Nat.card K ^ 6 * (Nat.card A * Nat.card ψ.range) ^ 3 := by gcongr
    _ = 24 * (Nat.card K ^ 2) ^ 3 * Nat.card A ^ 3 * Nat.card ψ.range ^ 3 := by ring
    _ ≤ 24 * Nat.card (palfyAdj A) ^ 3 * Nat.card (palfyAdj A) ^ 3 * Nat.card ψ.range ^ 3 := by gcongr
    _ = 24 * Nat.card (palfyAdj A) ^ 6 * Nat.card ψ.range ^ 3 := by ring
    _ ≤ Nat.card V ^ E := hbound

end GI.Proved
