module

public import Workspace.Proved.SSGroup

@[expose] public section

/-!
# The order and the pointwise stabilizer from a closed table

* `ss_card_gens`: the order of `⟨gs⟩` is the product over the levels of one plus the number of
  entries of the level. Level `i` is in bijection with pairs (an entry of level `i` or the
  identity, an element of level `i + 1`), since the first factor is determined by the image of
  `B[i]`.
* `ss_pointwiseStab_eq`: if the base starts with the points `S`, the pointwise stabilizer of `S`
  in `⟨gs⟩` is generated by the entries of the levels `≥ |S|`.
-/

namespace GI.Proved

open Equiv GI.Cited

variable {n : ℕ}

section Order

variable {B : List (Fin n)} {T : List (SsSlot n)}

/-- The representative of point `j` at level `i`: the entry, or the identity. -/
def ssRep (T : List (SsSlot n)) (i : ℕ) (j : Fin n) : Perm (Fin n) :=
  ((ssGet T i j).map Prod.fst).getD 1

/-- The points of level `i` with a representative: `B[i]` and the filled slots. -/
noncomputable def ssJ (B : List (Fin n)) (T : List (SsSlot n)) (i : ℕ) (hi : i < B.length) :
    Finset (Fin n) :=
  by classical exact Finset.univ.filter fun j => j = B[i] ∨ (ssGet T i j).isSome = true

theorem ssRep_apply (hwf : SsWF B T) {i : ℕ} (hi : i < B.length) {j : Fin n}
    (hj : j ∈ ssJ B T i hi) : ssRep T i j B[i] = j := by
  classical
  unfold ssJ at hj
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj
  unfold ssRep
  cases he : ssGet T i j with
  | none =>
    rw [he] at hj
    simp only [Option.isSome_none, Bool.false_eq_true, or_false] at hj
    simp [hj]
  | some e =>
    obtain ⟨_, -, h2, -⟩ := hwf.slot _ _ _ he
    simpa using h2

theorem ssRep_mul_mem (hwf : SsWF B T) {i : ℕ} (hi : i < B.length) (j : Fin n) {h : Perm (Fin n)} (hh : h ∈ ssS B T (i + 1)) :
    ssRep T i j * h ∈ ssS B T i := by
  unfold ssRep
  cases he : ssGet T i j with
  | none => simpa using ssS_succ_subset hi hh
  | some e => simpa using ssS_mul_entry hwf he hh

/-- **One level.** The size of level `i` is the number of its representatives times the size of
level `i + 1`. -/
theorem ssS_card_succ (hwf : SsWF B T) {i : ℕ} (hi : i < B.length) :
    (ssS B T i).card = (ssJ B T i hi).card * (ssS B T (i + 1)).card := by
  classical
  rw [← Finset.card_product]
  have himg : ((ssJ B T i hi) ×ˢ (ssS B T (i + 1))).image (fun p => ssRep T i p.1 * p.2) =
      ssS B T i := by
    ext g
    simp only [Finset.mem_image, Finset.mem_product, Prod.exists]
    constructor
    · rintro ⟨j, h, ⟨hj, hh⟩, rfl⟩
      exact ssRep_mul_mem hwf hi j hh
    · intro hg
      rcases ssS_decomp hwf hi hg with h1 | ⟨j, e, he, h1⟩
      · refine ⟨B[i], g, ⟨?_, h1⟩, ?_⟩
        · unfold ssJ; simp
        · have : ssGet T i B[i] = none := by
            cases he : ssGet T i B[i] with
            | none => rfl
            | some e => exact absurd rfl (hwf.slot _ _ _ he).2.2.2
          simp [ssRep, this]
      · refine ⟨j, e.1⁻¹ * g, ⟨?_, h1⟩, ?_⟩
        · unfold ssJ; simp [he]
        · simp [ssRep, he]
  rw [← himg, Finset.card_image_of_injOn]
  rintro ⟨j, h⟩ hp ⟨j', h'⟩ hp' heq
  simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at hp hp'
  simp only at heq
  have hh : h B[i] = B[i] := ((mem_ssS_succ_iff hi).mp hp.2).2
  have hh' : h' B[i] = B[i] := ((mem_ssS_succ_iff hi).mp hp'.2).2
  have hjj : j = j' := by
    have := congrArg (fun g : Perm (Fin n) => g B[i]) heq
    simp only [Perm.mul_apply, hh, hh'] at this
    rwa [ssRep_apply hwf hi hp.1, ssRep_apply hwf hi hp'.1] at this
  subst hjj
  simp only [Prod.mk.injEq, true_and]
  exact mul_left_cancel heq

/-- The number of representatives of level `i`: one plus the number of filled slots. -/
theorem ssJ_card (hwf : SsWF B T) {i : ℕ} (hi : i < B.length) :
    (ssJ B T i hi).card =
      (Finset.univ.filter fun j : Fin n => (ssGet T i j).isSome = true).card + 1 := by
  classical
  have h : ssJ B T i hi = insert B[i] (Finset.univ.filter fun j : Fin n =>
      (ssGet T i j).isSome = true) := by
    ext j; unfold ssJ; simp
  rw [h, Finset.card_insert_of_notMem]
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  cases he : ssGet T i B[i] with
  | none => simp
  | some e => exact absurd rfl (hwf.slot _ _ _ he).2.2.2

/-- The number of filled slots of level `i`. -/
noncomputable def ssCnt (T : List (SsSlot n)) (i : ℕ) : ℕ :=
  (Finset.univ.filter fun j : Fin n => (ssGet T i j).isSome = true).card

/-- The size of level `i`, as a product over the levels `≥ i`. -/
theorem ssS_card_eq (hB : ∀ x, x ∈ B) (hwf : SsWF B T) :
    ∀ i ≤ B.length, (ssS B T i).card = ∏ k ∈ Finset.Ico i B.length, (ssCnt T k + 1) := by
  intro i hi
  induction h : B.length - i generalizing i with
  | zero =>
    obtain rfl : i = B.length := by omega
    rw [Finset.Ico_self, Finset.prod_empty, Finset.card_eq_one]
    refine ⟨1, Finset.eq_singleton_iff_unique_mem.mpr ⟨one_mem_ssS, fun g hg => ssS_length hB hg⟩⟩
  | succ d ih =>
    have hiL : i < B.length := by omega
    rw [ssS_card_succ hwf hiL, ih (i + 1) (by omega) (by omega), ssJ_card hwf hiL,
      Finset.prod_eq_prod_Ico_succ_bot hiL]
    rfl

/-- **The order.** For a closed, well-formed table whose base contains every point, whose
entries lie in `⟨gs⟩` and through which every generator sifts, the order of `⟨gs⟩` is the
product over the levels of one plus the number of entries of the level. -/
theorem ss_card_gens (hB : ∀ x, x ∈ B) (hwf : SsWF B T) (hc : SsClosed B T)
    {gs : List (Perm (Fin n))} (hent : ∀ i j e, ssGet T i j = some e → e.1 ∈ gens gs)
    (hgen : ∀ g ∈ gs, ssThru T B 0 g = true) :
    Nat.card (gens gs) = ∏ k ∈ Finset.range B.length, (ssCnt T k + 1) := by
  have hset : ((gens gs : Subgroup (Perm (Fin n))) : Set (Perm (Fin n))) =
      ((ssS B T 0 : Finset (Perm (Fin n))) : Set (Perm (Fin n))) := by
    ext x; simp only [SetLike.mem_coe]; exact ss_mem_gens_iff hB hwf hc hent hgen x
  have h1 : Nat.card (gens gs) = Nat.card ((gens gs : Subgroup (Perm (Fin n))) :
      Set (Perm (Fin n))) := rfl
  rw [h1, hset, Nat.card_coe_set_eq, Set.ncard_coe_finset, ssS_card_eq hB hwf 0 (Nat.zero_le _),
    Finset.range_eq_Ico]

end Order

section Stab

variable {B : List (Fin n)} {T : List (SsSlot n)}

/-- **The pointwise stabilizer.** If the base is `S ++ C`, the pointwise stabilizer of `S` in
`⟨gs⟩` is generated by the entries of the levels `≥ |S|`. -/
theorem ss_pointwiseStab_eq {S C : List (Fin n)} (hBS : B = S ++ C) (hB : ∀ x, x ∈ B)
    (hwf : SsWF B T) (hc : SsClosed B T) {gs : List (Perm (Fin n))}
    (hent : ∀ i j e, ssGet T i j = some e → e.1 ∈ gens gs)
    (hgen : ∀ g ∈ gs, ssThru T B 0 g = true) :
    pointwiseStab (gens gs) S = Subgroup.closure {g | SsEnt T S.length g} := by
  have htake : B.take S.length = S := by rw [hBS, List.take_left]
  have hSL : S.length ≤ B.length := by rw [hBS, List.length_append]; omega
  apply le_antisymm
  · rintro g ⟨hg, hfix⟩
    rw [ss_mem_gens_iff hB hwf hc hent hgen, mem_ssS] at hg
    rw [← ss_level_eq hB hwf hc hSL]
    exact mem_ssS_of_thru hSL (by simpa using hg.2) (by rw [htake]; exact hfix)
  · refine (Subgroup.closure_le _).mpr ?_
    rintro s ⟨k, j, e, hk, he, rfl⟩
    refine ⟨hent _ _ _ he, fun b hb => ?_⟩
    obtain ⟨_, hf, -⟩ := hwf.slot _ _ _ he
    exact hf b (List.take_subset_take_left _ hk (by rw [htake]; exact hb))

end Stab

end GI.Proved
