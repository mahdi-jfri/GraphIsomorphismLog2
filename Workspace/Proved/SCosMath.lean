import Mathlib.GroupTheory.Perm.Basic
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Data.Fintype.Card
import Workspace.Cited.AlgoPermGroups
import Workspace.Compat

/-!
# The subcoset problem of Luks–Miyazaki, Proposition 3.9

We want `G x ∩ H` for a solvable `G`. Following [LM, Proposition 3.9] (Luks–Miyazaki, DMTCS 13:4
(2011), pp. 71–72) we pass to pairs. A pair is an element of `Sym(n) × Sym(n)`. For a subgroup
`𝒢` of pairs, a pair `x` and a set of points `Φ`, the **subcoset** `scosC x 𝒢 Φ` is the set of
pairs `y ∈ x 𝒢` whose two coordinates agree on `Φ`. When the first coordinates of `𝒢` map `Φ`
into itself (`ScosInv`), the subcoset is empty or a left coset of the subgroup
`scosL 𝒢 Φ = 𝒢 ⊓ scosStab Φ` of the elements of `𝒢` whose coordinates agree on `Φ`
(`scosC_eq`).

The divide and conquer of [LM] rests on four facts, proved here.
* `scosC_empty`: for `Φ = ∅` the subcoset is the coset `x 𝒢`.
* `scosC_split`: for `Φ₁ ⊆ Φ`, the subcoset on `Φ` is the subcoset on `Φ \ Φ₁` of the subcoset
  on `Φ₁` (the intransitive case).
* `scosC_union`, `scosL_paste`: if `𝒢` is the union of the cosets `yᵢ K`, the subcoset is the
  union of the subcosets of the `x yᵢ K`, and the group `scosL 𝒢 Φ` is generated by
  `scosL K Φ` and the quotients `z₁⁻¹ zⱼ` of points of the nonempty pieces (the transitive case).
* `scosC_single`: for `Φ = {α}`, the subcoset is the set of `x g` with `g ∈ 𝒢` and
  `g₂ α = x₂⁻¹ (x₁ α)` (the base case).

`scos_top` reads the answer to the original problem off the subcoset for `𝒢 = G × H`,
the pair `(x⁻¹, 1)` and `Φ` the whole set.

Permutations compose as functions: `(g * h) a = g (h a)`.
-/

namespace GI.Proved

open Equiv
open scoped Pointwise

variable {n : ℕ}

/-- Pairs of permutations. -/
abbrev ScosPair (n : ℕ) := Perm (Fin n) × Perm (Fin n)

/-- The first coordinates of `𝒢` map `Φ` into itself. -/
def ScosInv (𝒢 : Subgroup (ScosPair n)) (Φ : Finset (Fin n)) : Prop :=
  ∀ g ∈ 𝒢, ∀ a ∈ Φ, g.1 a ∈ Φ

/-- The two coordinates of `y` agree on `Φ`. -/
def scosAgree (Φ : Finset (Fin n)) (y : ScosPair n) : Prop := ∀ a ∈ Φ, y.1 a = y.2 a

/-- A permutation that maps a finite set into itself maps it onto itself. -/
theorem scos_perm_onto {σ : Perm (Fin n)} {Φ : Finset (Fin n)} (h : ∀ a ∈ Φ, σ a ∈ Φ)
    {a : Fin n} (ha : a ∈ Φ) : σ⁻¹ a ∈ Φ := by
  classical
  have hsub : Φ.image σ ⊆ Φ := by
    intro b hb
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hb
    exact h c hc
  have heq : Φ.image σ = Φ :=
    Finset.eq_of_subset_of_card_le hsub (by rw [Finset.card_image_of_injective _ σ.injective])
  rw [← heq] at ha
  obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp ha
  simpa using hc

/-- The pairs whose first coordinate maps `Φ` into itself and whose coordinates agree on `Φ`.
They form a group: a permutation that maps the finite set `Φ` into itself maps it onto
itself (`scos_perm_onto`). -/
def scosStab (Φ : Finset (Fin n)) : Subgroup (ScosPair n) where
  carrier := {u | ∀ a ∈ Φ, u.1 a ∈ Φ ∧ u.1 a = u.2 a}
  one_mem' := fun a ha => ⟨ha, rfl⟩
  mul_mem' := by
    intro u v hu hv a ha
    obtain ⟨hv1, hv2⟩ := hv a ha
    obtain ⟨hu1, hu2⟩ := hu _ hv1
    refine ⟨by simpa [Perm.mul_apply] using hu1, ?_⟩
    simp only [Prod.fst_mul, Prod.snd_mul, Perm.mul_apply]
    rw [hu2, hv2]
  inv_mem' := by
    intro u hu a ha
    have hb : u.1⁻¹ a ∈ Φ := scos_perm_onto (fun c hc => (hu c hc).1) ha
    have h2 := (hu _ hb).2
    simp only [Perm.apply_inv_self] at h2
    refine ⟨by simpa using hb, ?_⟩
    simp only [Prod.fst_inv, Prod.snd_inv]
    exact (Perm.inv_eq_iff_eq.mpr h2).symm

/-- The group `L(𝒢, Φ)`: the elements of `𝒢` whose first coordinate maps `Φ` into itself and
whose coordinates agree on `Φ`. -/
def scosL (𝒢 : Subgroup (ScosPair n)) (Φ : Finset (Fin n)) : Subgroup (ScosPair n) :=
  𝒢 ⊓ scosStab Φ

/-- The subcoset: the pairs of `x 𝒢` whose coordinates agree on `Φ`. -/
def scosC (x : ScosPair n) (𝒢 : Subgroup (ScosPair n)) (Φ : Finset (Fin n)) :
    Set (ScosPair n) :=
  {y | ∃ g ∈ 𝒢, y = x * g ∧ scosAgree Φ y}

theorem mem_scosL {𝒢 : Subgroup (ScosPair n)} {Φ : Finset (Fin n)} (h : ScosInv 𝒢 Φ)
    {u : ScosPair n} : u ∈ scosL 𝒢 Φ ↔ u ∈ 𝒢 ∧ scosAgree Φ u := by
  constructor
  · rintro ⟨hu, hs⟩
    exact ⟨hu, fun a ha => (hs a ha).2⟩
  · rintro ⟨hu, hs⟩
    exact ⟨hu, fun a ha => ⟨h u hu a ha, hs a ha⟩⟩

theorem scosL_le (𝒢 : Subgroup (ScosPair n)) (Φ : Finset (Fin n)) : scosL 𝒢 Φ ≤ 𝒢 :=
  inf_le_left

theorem scosInv_mono {𝒢 K : Subgroup (ScosPair n)} {Φ : Finset (Fin n)} (h : ScosInv 𝒢 Φ)
    (hK : K ≤ 𝒢) : ScosInv K Φ := fun g hg => h g (hK hg)

/-- **The subcoset is a coset.** If `y` lies in the subcoset, the subcoset is `y L(𝒢, Φ)`. -/
theorem scosC_eq {x y : ScosPair n} {𝒢 : Subgroup (ScosPair n)} {Φ : Finset (Fin n)}
    (h : ScosInv 𝒢 Φ) (hy : y ∈ scosC x 𝒢 Φ) :
    scosC x 𝒢 Φ = y • (scosL 𝒢 Φ : Set (ScosPair n)) := by
  obtain ⟨g, hg, rfl, hag⟩ := hy
  ext z
  constructor
  · rintro ⟨g', hg', rfl, hag'⟩
    refine ⟨g⁻¹ * g', (mem_scosL h).2 ⟨𝒢.mul_mem (𝒢.inv_mem hg) hg', fun a ha => ?_⟩, ?_⟩
    · -- Compare at the point `b = g₁⁻¹ g'₁ a ∈ Φ`.
      have hb : g.1⁻¹ (g'.1 a) ∈ Φ := by
        have := h _ (𝒢.mul_mem (𝒢.inv_mem hg) hg') a ha
        simpa [Perm.mul_apply] using this
      have e1 : x.1 (g.1 (g.1⁻¹ (g'.1 a))) = x.2 (g.2 (g.1⁻¹ (g'.1 a))) := hag _ hb
      have e2 : x.1 (g'.1 a) = x.2 (g'.2 a) := hag' a ha
      rw [Perm.apply_inv_self, e2] at e1
      have e3 : g'.2 a = g.2 (g.1⁻¹ (g'.1 a)) := x.2.injective e1
      show (g⁻¹ * g').1 a = (g⁻¹ * g').2 a
      simp only [Prod.fst_mul, Prod.snd_mul, Prod.fst_inv, Prod.snd_inv, Perm.mul_apply]
      rw [e3, Perm.inv_apply_self]
    · simp [smul_eq_mul, mul_assoc]
  · rintro ⟨u, hu, rfl⟩
    have hu : u ∈ scosL 𝒢 Φ := hu
    rw [mem_scosL h] at hu
    refine ⟨g * u, 𝒢.mul_mem hg hu.1, by simp [smul_eq_mul, mul_assoc], fun a ha => ?_⟩
    have hb : u.1 a ∈ Φ := h u hu.1 a ha
    have e1 := hag _ hb
    have e2 := hu.2 a ha
    simp only [smul_eq_mul, Prod.fst_mul, Prod.snd_mul, Perm.mul_apply] at e1 e2 ⊢
    rw [e1, e2]

/-- For `Φ = ∅` the subcoset is the coset `x 𝒢`. -/
theorem scosC_empty (x : ScosPair n) (𝒢 : Subgroup (ScosPair n)) :
    x ∈ scosC x 𝒢 ∅ ∧ scosL 𝒢 ∅ = 𝒢 := by
  refine ⟨⟨1, 𝒢.one_mem, by simp, fun a ha => by simp at ha⟩, ?_⟩
  refine le_antisymm (scosL_le _ _) fun u hu => ⟨hu, fun a ha => by simp at ha⟩

/-- **The intransitive case.** For `Φ₁ ⊆ Φ` the subcoset on `Φ` consists of the points of the
subcoset on `Φ₁` that agree on `Φ \ Φ₁`. -/
theorem scosC_split (x : ScosPair n) (𝒢 : Subgroup (ScosPair n)) {Φ Φ₁ : Finset (Fin n)}
    (h1 : Φ₁ ⊆ Φ) : scosC x 𝒢 Φ = {y | y ∈ scosC x 𝒢 Φ₁ ∧ scosAgree (Φ \ Φ₁) y} := by
  classical
  ext y
  constructor
  · rintro ⟨g, hg, rfl, hag⟩
    exact ⟨⟨g, hg, rfl, fun a ha => hag a (h1 ha)⟩,
      fun a ha => hag a (Finset.mem_sdiff.mp ha).1⟩
  · rintro ⟨⟨g, hg, rfl, hag⟩, hag'⟩
    refine ⟨g, hg, rfl, fun a ha => ?_⟩
    by_cases ha1 : a ∈ Φ₁
    · exact hag a ha1
    · exact hag' a (Finset.mem_sdiff.mpr ⟨ha, ha1⟩)

/-- The intransitive case with the subcoset on `Φ₁` written as `z L₁`: the subcoset on `Φ` is
the subcoset of `z L₁` on `Φ \ Φ₁`. -/
theorem scosC_split_coset {x z : ScosPair n} {𝒢 L₁ : Subgroup (ScosPair n)}
    {Φ Φ₁ : Finset (Fin n)} (h1 : Φ₁ ⊆ Φ)
    (hz : scosC x 𝒢 Φ₁ = z • (L₁ : Set (ScosPair n))) :
    scosC x 𝒢 Φ = scosC z L₁ (Φ \ Φ₁) := by
  rw [scosC_split x 𝒢 h1, hz]
  ext y
  constructor
  · rintro ⟨⟨u, hu, rfl⟩, hag⟩
    exact ⟨u, hu, rfl, hag⟩
  · rintro ⟨u, hu, rfl, hag⟩
    exact ⟨⟨u, hu, rfl⟩, hag⟩

/-- In the intransitive case an empty subcoset on `Φ₁` gives an empty subcoset on `Φ`. -/
theorem scosC_split_empty {x : ScosPair n} {𝒢 : Subgroup (ScosPair n)}
    {Φ Φ₁ : Finset (Fin n)} (h1 : Φ₁ ⊆ Φ) (he : scosC x 𝒢 Φ₁ = ∅) : scosC x 𝒢 Φ = ∅ := by
  rw [scosC_split x 𝒢 h1, he]
  ext y
  simp

/-- `Φ \ Φ₁` is invariant when `Φ` and `Φ₁` are. -/
theorem scosInv_sdiff {𝒢 : Subgroup (ScosPair n)} {Φ Φ₁ : Finset (Fin n)} (h : ScosInv 𝒢 Φ)
    (h1 : ScosInv 𝒢 Φ₁) : ScosInv 𝒢 (Φ \ Φ₁) := by
  classical
  intro g hg a ha
  obtain ⟨haΦ, ha1⟩ := Finset.mem_sdiff.mp ha
  refine Finset.mem_sdiff.mpr ⟨h g hg a haΦ, fun hb => ha1 ?_⟩
  -- `g⁻¹` maps `Φ₁` into itself.
  have := h1 g⁻¹ (𝒢.inv_mem hg) _ hb
  simpa using this

/-- In the intransitive case the group of `Φ` is the group of `Φ \ Φ₁` inside the group of
`Φ₁`. -/
theorem scosL_split (𝒢 : Subgroup (ScosPair n)) {Φ Φ₁ : Finset (Fin n)} (h : ScosInv 𝒢 Φ)
    (h1 : ScosInv 𝒢 Φ₁) (hsub : Φ₁ ⊆ Φ) :
    scosL 𝒢 Φ = scosL (scosL 𝒢 Φ₁) (Φ \ Φ₁) := by
  classical
  have h2 : ScosInv (scosL 𝒢 Φ₁) (Φ \ Φ₁) :=
    scosInv_mono (scosInv_sdiff h h1) (scosL_le _ _)
  ext u
  rw [mem_scosL h, mem_scosL h2, mem_scosL h1]
  constructor
  · rintro ⟨hu, hag⟩
    exact ⟨⟨hu, fun a ha => hag a (hsub ha)⟩, fun a ha => hag a (Finset.mem_sdiff.mp ha).1⟩
  · rintro ⟨⟨hu, hag⟩, hag'⟩
    refine ⟨hu, fun a ha => ?_⟩
    by_cases ha1 : a ∈ Φ₁
    · exact hag a ha1
    · exact hag' a (Finset.mem_sdiff.mpr ⟨ha, ha1⟩)

/-- **The transitive case, union.** If every element of `𝒢` lies in some `yᵢ K`, with
`yᵢ ∈ 𝒢` and `K ≤ 𝒢`, then the subcoset of `x 𝒢` is the union of the subcosets of the
`x yᵢ K`. -/
theorem scosC_union {x : ScosPair n} {𝒢 K : Subgroup (ScosPair n)} {Φ : Finset (Fin n)}
    (ys : List (ScosPair n)) (hys : ∀ y ∈ ys, y ∈ 𝒢) (hK : K ≤ 𝒢)
    (hcov : ∀ g ∈ 𝒢, ∃ y ∈ ys, y⁻¹ * g ∈ K) {z : ScosPair n} :
    z ∈ scosC x 𝒢 Φ ↔ ∃ y ∈ ys, z ∈ scosC (x * y) K Φ := by
  constructor
  · rintro ⟨g, hg, rfl, hag⟩
    obtain ⟨y, hy, hk⟩ := hcov g hg
    exact ⟨y, hy, y⁻¹ * g, hk, by simp [mul_assoc], hag⟩
  · rintro ⟨y, hy, k, hk, rfl, hag⟩
    exact ⟨y * k, 𝒢.mul_mem (hys y hy) (hK hk), by simp [mul_assoc], hag⟩

/-- **The transitive case, pasting.** Suppose the points `zs` lie in the subcoset of `x 𝒢`, and
every point of the subcoset lies in `z L'` for some `z ∈ zs`, where `L' ≤ L(𝒢, Φ)`. Then
`L(𝒢, Φ)` is generated by `L'` and the `z₀⁻¹ z` for `z ∈ zs`, for any `z₀ ∈ zs`. -/
theorem scosL_paste {x z₀ : ScosPair n} {𝒢 L' : Subgroup (ScosPair n)} {Φ : Finset (Fin n)}
    (h : ScosInv 𝒢 Φ) (zs : List (ScosPair n)) (hz₀ : z₀ ∈ zs)
    (hzs : ∀ z ∈ zs, z ∈ scosC x 𝒢 Φ) (hL' : L' ≤ scosL 𝒢 Φ)
    (hcov : ∀ y ∈ scosC x 𝒢 Φ, ∃ z ∈ zs, z⁻¹ * y ∈ L') :
    scosL 𝒢 Φ = L' ⊔ Subgroup.closure {u | ∃ z ∈ zs, u = z₀⁻¹ * z} := by
  have hC := scosC_eq h (hzs z₀ hz₀)
  apply le_antisymm
  · intro u hu
    -- `z₀ u` is in the subcoset, so it lies in some `z L'`.
    have hmem : z₀ * u ∈ scosC x 𝒢 Φ := by
      rw [hC]; exact ⟨u, hu, rfl⟩
    obtain ⟨z, hz, hw⟩ := hcov _ hmem
    have e : u = (z₀⁻¹ * z) * (z⁻¹ * (z₀ * u)) := by group
    rw [e]
    exact Subgroup.mul_mem _
      (Subgroup.mem_sup_right (Subgroup.subset_closure ⟨z, hz, rfl⟩))
      (Subgroup.mem_sup_left hw)
  · refine sup_le hL' ((Subgroup.closure_le _).2 ?_)
    rintro u ⟨z, hz, rfl⟩
    have hmem := hzs z hz
    rw [hC] at hmem
    obtain ⟨w, hw, hwe⟩ := hmem
    simp only [smul_eq_mul] at hwe
    rw [← hwe]
    simpa using hw

/-- **The base case.** For `Φ = {α}` the subcoset is the set of `x g` with `g ∈ 𝒢` and
`g₂ α = x₂⁻¹ (x₁ α)`. -/
theorem scosC_single {x : ScosPair n} {𝒢 : Subgroup (ScosPair n)} {α : Fin n}
    (h : ScosInv 𝒢 {α}) {y : ScosPair n} :
    y ∈ scosC x 𝒢 {α} ↔ ∃ g ∈ 𝒢, y = x * g ∧ g.2 α = x.2⁻¹ (x.1 α) := by
  constructor
  · rintro ⟨g, hg, rfl, hag⟩
    refine ⟨g, hg, rfl, ?_⟩
    have h1 : g.1 α = α := Finset.mem_singleton.mp (h g hg α (Finset.mem_singleton_self α))
    have e := hag α (Finset.mem_singleton_self α)
    simp only [Prod.fst_mul, Prod.snd_mul, Perm.mul_apply, h1] at e
    rw [e, Perm.inv_apply_self]
  · rintro ⟨g, hg, rfl, hg2⟩
    refine ⟨g, hg, rfl, fun a ha => ?_⟩
    rw [Finset.mem_singleton.mp ha]
    have h1 : g.1 α = α := Finset.mem_singleton.mp (h g hg α (Finset.mem_singleton_self α))
    simp only [Prod.fst_mul, Prod.snd_mul, Perm.mul_apply, h1, hg2]
    exact (Perm.apply_inv_self _ _).symm

/-- In the base case the group is the stabilizer of `α` in the second coordinate. -/
theorem mem_scosL_single {𝒢 : Subgroup (ScosPair n)} {α : Fin n} (h : ScosInv 𝒢 {α})
    {u : ScosPair n} : u ∈ scosL 𝒢 {α} ↔ u ∈ 𝒢 ∧ u.2 α = α := by
  rw [mem_scosL h]
  constructor
  · rintro ⟨hu, hag⟩
    have h1 : u.1 α = α := Finset.mem_singleton.mp (h u hu α (Finset.mem_singleton_self α))
    exact ⟨hu, (hag α (Finset.mem_singleton_self α)).symm.trans h1⟩
  · rintro ⟨hu, h2⟩
    refine ⟨hu, fun a ha => ?_⟩
    rw [Finset.mem_singleton.mp ha, h2]
    exact Finset.mem_singleton.mp (h u hu α (Finset.mem_singleton_self α))

/-! ### The top level -/

/-- The set of all points is invariant for every group. -/
theorem scosInv_univ (𝒢 : Subgroup (ScosPair n)) : ScosInv 𝒢 Finset.univ :=
  fun _ _ _ _ => Finset.mem_univ _

/-- **The top level, a point.** For `𝒢 = G × H` and the pair `(x⁻¹, 1)`, a point `y'` of the
subcoset on all points has equal coordinates, and `y = y'₁⁻¹` lies in `G x ∩ H`. -/
theorem scos_top_mem {G H : Subgroup (Perm (Fin n))} {x : Perm (Fin n)} {y' : ScosPair n}
    (hy : y' ∈ scosC (x⁻¹, 1) (G.prod H) Finset.univ) :
    (∃ g ∈ G, y'.1⁻¹ = g * x) ∧ y'.1⁻¹ ∈ H := by
  obtain ⟨g, hg, rfl, hag⟩ := hy
  have he : x⁻¹ * g.1 = g.2 := by
    ext a; exact congrArg Fin.val (by simpa using hag a (Finset.mem_univ a))
  refine ⟨⟨g.1⁻¹, G.inv_mem hg.1, by simp⟩, ?_⟩
  simp only [Prod.fst_mul]
  rw [he]
  exact H.inv_mem hg.2

/-- **The top level, emptiness.** If the subcoset is empty, then `G x ∩ H` is empty. -/
theorem scos_top_empty {G H : Subgroup (Perm (Fin n))} {x : Perm (Fin n)}
    (he : ∀ y', y' ∉ scosC (x⁻¹, 1) (G.prod H) Finset.univ) :
    ∀ g ∈ G, g * x ∉ H := by
  intro g hg hgx
  apply he ((g * x)⁻¹, (g * x)⁻¹)
  refine ⟨(g⁻¹, (g * x)⁻¹), ⟨G.inv_mem hg, H.inv_mem hgx⟩, ?_, fun a _ => rfl⟩
  ext a <;> simp [mul_inv_rev]

/-- On all points, the group `L(G × H, Ω)` is the diagonal of `G ⊓ H`. -/
theorem mem_scosL_top {G H : Subgroup (Perm (Fin n))} {u : ScosPair n} :
    u ∈ scosL (G.prod H) Finset.univ ↔ u.1 ∈ G ⊓ H ∧ u.2 = u.1 := by
  rw [mem_scosL (scosInv_univ _)]
  constructor
  · rintro ⟨⟨h1, h2⟩, hag⟩
    have e : u.2 = u.1 := by ext a; exact congrArg Fin.val (hag a (Finset.mem_univ a)).symm
    exact ⟨⟨h1, e ▸ h2⟩, e⟩
  · rintro ⟨⟨h1, h2⟩, e⟩
    exact ⟨⟨h1, e ▸ h2⟩, fun a _ => by rw [e]⟩

/-- **The top level, the group.** If a list generates `L(G × H, Ω)`, its first coordinates
generate `G ⊓ H`. -/
theorem scos_top_gens {G H : Subgroup (Perm (Fin n))} (ls : List (ScosPair n))
    (hls : Subgroup.closure {u | u ∈ ls} = scosL (G.prod H) Finset.univ) :
    GI.Cited.gens (ls.map Prod.fst) = G ⊓ H := by
  have hmap : (scosL (G.prod H) Finset.univ).map (MonoidHom.fst _ _) = G ⊓ H := by
    ext a
    simp only [Subgroup.mem_map, MonoidHom.coe_fst]
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact (mem_scosL_top.mp hu).1
    · intro ha
      exact ⟨(a, a), mem_scosL_top.mpr ⟨ha, rfl⟩, rfl⟩
  rw [← hmap, ← hls, MonoidHom.map_closure]
  unfold GI.Cited.gens
  congr 1
  ext a
  simp

end GI.Proved
