module

public import Workspace.Proved.VsMHardA

@[expose] public section

/-!
# The greedy isotropic family

A greedy pass over a list `L` keeps an element `y` when `y` is good, commutes with the kept
elements, and is not in the subgroup generated by the kept elements and `S`. If `L` covers `Y`
modulo `S`, goodness and commuting do not change modulo `S`, then the kept family is a maximal
good isotropic family (`vsH_greedy_iso`), which is what `VsMIso` asks.
-/

namespace GI.Proved

variable {α G : Type*} [Group G]

/-- The greedy pass. -/
def vsHGreedy (t : List α → α → Bool) (L : List α) : List α :=
  L.foldl (fun kept y => if t kept y then kept ++ [y] else kept) []

/-- What the test means, for a kept list `kept`. -/
def VsHTest (f : α → G) (S : Subgroup G) (good : G → Prop) (t : List α → α → Bool)
    (kept : List α) (y : α) : Prop :=
  t kept y = true ↔ (good (f y) ∧ (∀ e ∈ kept, f y * f e = f e * f y) ∧
    f y ∉ Subgroup.closure (f '' {e | e ∈ kept}) ⊔ S)

variable {f : α → G} {S : Subgroup G} {good : G → Prop} {t : List α → α → Bool}

/-- The invariant of the greedy pass on a prefix. -/
structure VsHInv (f : α → G) (S : Subgroup G) (good : G → Prop) (L kept : List α) : Prop where
  sub : ∀ e ∈ kept, e ∈ L
  hgood : ∀ e ∈ kept, good (f e)
  comm : ∀ e ∈ kept, ∀ e' ∈ kept, f e * f e' = f e' * f e
  indep : ∀ (i : ℕ) (hi : i < kept.length),
    f kept[i] ∉ Subgroup.closure (f '' {e | e ∈ kept.take i}) ⊔ S
  max : ∀ y ∈ L, y ∉ kept → ¬ good (f y) ∨ (∃ e ∈ kept, f y * f e ≠ f e * f y) ∨
    f y ∈ Subgroup.closure (f '' {e | e ∈ kept}) ⊔ S

theorem vsHGreedy_inv (Pr : α → Prop)
    (ht : ∀ kept y, (∀ e ∈ kept, Pr e) → Pr y → VsHTest f S good t kept y) :
    ∀ (L0 L : List α), (∀ y ∈ L0 ++ L, Pr y) → ∀ (kept : List α), VsHInv f S good L0 kept →
      VsHInv f S good (L0 ++ L) (L.foldl (fun kept y => if t kept y then kept ++ [y] else kept) kept) := by
  intro L0 L
  induction L generalizing L0 with
  | nil => intro _ kept h; simpa using h
  | cons y L ih =>
    intro hP kept h
    have := ih (L0 ++ [y]) (by simpa using hP) (if t kept y then kept ++ [y] else kept) ?_
    · simpa using this
    have hPk : ∀ e ∈ kept, Pr e := fun e he => hP e (List.mem_append_left _ (h.sub e he))
    have hPy : Pr y := hP y (by simp)
    have hmono : ∀ T : Set α, ∀ T' : Set α, T ⊆ T' →
        Subgroup.closure (f '' T) ⊔ S ≤ Subgroup.closure (f '' T') ⊔ S := fun T T' hT =>
      sup_le_sup_right (Subgroup.closure_mono (Set.image_mono hT)) S
    by_cases hy : t kept y = true
    · rw [if_pos hy]
      obtain ⟨hg, hc, hn⟩ := (ht kept y hPk hPy).1 hy
      refine ⟨fun e he => ?_, fun e he => ?_, fun e he e' he' => ?_, fun i hi => ?_, fun z hz hzk => ?_⟩
      · rcases List.mem_append.1 he with he | he
        · exact List.mem_append_left _ (h.sub e he)
        · simp at he; subst he; simp
      · rcases List.mem_append.1 he with he | he
        · exact h.hgood e he
        · simp at he; subst he; exact hg
      · have hm : ∀ x, x ∈ kept ++ [y] → x ∈ kept ∨ x = y := fun x hx => by simpa using hx
        rcases hm e he with h1 | h1 <;> rcases hm e' he' with h2 | h2
        · exact h.comm e h1 e' h2
        · rw [h2]; exact (hc e h1).symm
        · rw [h1]; exact hc e' h2
        · rw [h1, h2]
      · rw [List.length_append, List.length_singleton] at hi
        rcases Nat.lt_or_ge i kept.length with hik | hik
        · rw [List.getElem_append_left hik, List.take_append_of_le_length hik.le]
          exact h.indep i hik
        · have hi' : i = kept.length := by omega
          subst hi'
          rw [List.getElem_append_right (le_refl _)]
          simp only [Nat.sub_self, List.getElem_singleton, List.take_left' rfl]
          exact hn
      · rcases List.mem_append.1 hz with hz | hz
        · have hzk' : z ∉ kept := fun h' => hzk (List.mem_append_left _ h')
          rcases h.max z hz hzk' with h1 | ⟨e, he, h2⟩ | h3
          · exact Or.inl h1
          · exact Or.inr (Or.inl ⟨e, List.mem_append_left _ he, h2⟩)
          · refine Or.inr (Or.inr (hmono _ _ (fun e he => ?_) h3))
            exact List.mem_append_left _ he
        · simp at hz; subst hz; exact absurd (by simp) hzk
    · rw [if_neg hy]
      refine ⟨fun e he => List.mem_append_left _ (h.sub e he), h.hgood, h.comm, h.indep,
        fun z hz hzk => ?_⟩
      rcases List.mem_append.1 hz with hz | hz
      · exact h.max z hz hzk
      · simp at hz; subst hz
        have : ¬ (good (f z) ∧ (∀ e ∈ kept, f z * f e = f e * f z) ∧
            f z ∉ Subgroup.closure (f '' {e | e ∈ kept}) ⊔ S) := fun h' => hy ((ht kept z hPk hPy).2 h')
        by_cases hg : good (f z)
        · by_cases hc : ∀ e ∈ kept, f z * f e = f e * f z
          · exact Or.inr (Or.inr (by by_contra hn; exact this ⟨hg, hc, hn⟩))
          · push Not at hc; exact Or.inr (Or.inl hc)
        · exact Or.inl hg

/-- **The greedy family.** -/
theorem vsH_greedy_iso (Pr : α → Prop)
    (ht : ∀ kept y, (∀ e ∈ kept, Pr e) → Pr y → VsHTest f S good t kept y) {Y : Set G} (L : List α)
    (hLP : ∀ y ∈ L, Pr y) (hLY : ∀ y ∈ L, f y ∈ Y)
    (hcov : ∀ y ∈ Y, ∃ z ∈ L, (f z)⁻¹ * y ∈ S)
    (hgood : ∀ y ∈ Y, ∀ s ∈ S, good (y * s) → good y)
    (hSY : ∀ s ∈ S, ∀ y ∈ Y, s * y = y * s) :
    let e := vsHGreedy t L
    (∀ x ∈ e, f x ∈ Y) ∧ (∀ x ∈ e, good (f x)) ∧ (∀ x ∈ e, ∀ x' ∈ e, f x * f x' = f x' * f x) ∧
      (∀ (i : ℕ) (hi : i < e.length), f e[i] ∉ Subgroup.closure (f '' {x | x ∈ e.take i}) ⊔ S) ∧
      (∀ y ∈ Y, good y → (∀ x ∈ e, y * f x = f x * y) →
        y ∈ Subgroup.closure (f '' {x | x ∈ e}) ⊔ S) := by
  intro e
  have h := vsHGreedy_inv Pr ht [] L (by simpa using hLP) []
    ⟨by simp, by simp, by simp, by simp, fun z hz => by simp at hz⟩
  simp only [List.nil_append] at h
  refine ⟨fun x hx => hLY x (h.sub x hx), h.hgood, h.comm, h.indep, fun y hy hg hc => ?_⟩
  obtain ⟨z, hz, hzs⟩ := hcov y hy
  have hye : y = f z * ((f z)⁻¹ * y) := by group
  have hzY := hLY z hz
  have hcz : ∀ x ∈ e, f z * f x = f x * f z := by
    intro x hx
    have h1 := hc x hx
    have hxY := hLY x (h.sub x hx)
    have hs := hSY _ hzs _ hxY
    rw [hye] at h1
    calc f z * f x = f z * f x * ((f z)⁻¹ * y) * ((f z)⁻¹ * y)⁻¹ := by group
      _ = f z * (f x * ((f z)⁻¹ * y)) * ((f z)⁻¹ * y)⁻¹ := by group
      _ = f z * (((f z)⁻¹ * y) * f x) * ((f z)⁻¹ * y)⁻¹ := by rw [hs]
      _ = (f z * ((f z)⁻¹ * y)) * f x * ((f z)⁻¹ * y)⁻¹ := by group
      _ = f x * (f z * ((f z)⁻¹ * y)) * ((f z)⁻¹ * y)⁻¹ := by rw [h1]
      _ = f x * f z := by group
  have hgz : good (f z) := hgood _ hzY _ hzs (by rw [← hye]; exact hg)
  have hmemz : f z ∈ Subgroup.closure (f '' {x | x ∈ e}) ⊔ S := by
    by_cases hze : z ∈ e
    · exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨z, hze, rfl⟩)
    · rcases h.max z hz hze with h1 | ⟨x, hx, h2⟩ | h3
      · exact absurd hgz h1
      · exact absurd (hcz x hx) h2
      · exact h3
  rw [hye]
  exact mul_mem hmemz (Subgroup.mem_sup_right hzs)

end GI.Proved
