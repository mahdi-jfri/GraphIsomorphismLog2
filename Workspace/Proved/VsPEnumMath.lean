module

public import Workspace.Proved.VsPSpinMath
public import Workspace.Impl.VsPEnum

@[expose] public section

/-!
# The enumerated words cover the key span

`vsPEnum r B` lists the words `b_1^{c_1} ⋯ b_t^{c_t}` with `c_i < r`. Under a map `f` that is
multiplicative on a subgroup holding `B`, and a key `κ` additive on `N ⊇ f(B)`, every vector of
the span of the keys of `f(B)` is the key of `f w` for a listed word `w` (`vsPEnum_cover`), and
every listed word lies in the subgroup generated by `B` (`vsPEnum_mem`).
-/

namespace GI.Proved

open GI.Impl Equiv

variable {n : ℕ} {G : Type*} [Group G] {r : ℕ} {M : Type*} [AddCommGroup M] [Module (ZMod r) M]

theorem vsPEnum_mem (B : List (Perm (Fin n))) :
    ∀ w ∈ vsPEnum r B, w ∈ Subgroup.closure {x | x ∈ B} := by
  have key : ∀ (B0 B : List (Perm (Fin n))) (E : List (Perm (Fin n))),
      (∀ e ∈ E, e ∈ Subgroup.closure {x | x ∈ B0}) →
      ∀ w ∈ B.foldl (fun E b => E.flatMap fun e => (List.range r).map fun c => e * b ^ c) E,
        w ∈ Subgroup.closure {x | x ∈ B0 ++ B} := by
    intro B0 B
    induction B generalizing B0 with
    | nil =>
      intro E hE w hw
      simpa using hE w hw
    | cons b B ih =>
      intro E hE w hw
      have := ih (B0 ++ [b]) _ ?_ w hw
      · simpa using this
      · intro e he
        simp only [List.mem_flatMap, List.mem_map, List.mem_range] at he
        obtain ⟨e0, he0, c, -, rfl⟩ := he
        have hmono : Subgroup.closure {x | x ∈ B0} ≤ Subgroup.closure {x | x ∈ B0 ++ [b]} :=
          Subgroup.closure_mono fun x hx => by simp [Set.mem_setOf_eq] at hx ⊢; exact Or.inl hx
        exact mul_mem (hmono (hE e0 he0))
          (pow_mem (Subgroup.subset_closure (by simp)) c)
  intro w hw
  simpa using key [] B [1] (by simp) w hw

/-- **The words cover the key span.** -/
theorem vsPEnum_cover [NeZero r] {N S : Subgroup G} {κ : G → M} (hk : VsPKeyHyp N S κ)
    {f : Perm (Fin n) → G} {P : Subgroup (Perm (Fin n))}
    (hf : ∀ a ∈ P, ∀ b ∈ P, f (a * b) = f a * f b) (B : List (Perm (Fin n)))
    (hBP : ∀ b ∈ B, b ∈ P) (hBN : ∀ b ∈ B, f b ∈ N) :
    ∀ v ∈ Submodule.span (ZMod r) (κ '' (f '' {x | x ∈ B})), ∃ w ∈ vsPEnum r B, κ (f w) = v := by
  have hf1 : f 1 = 1 := by
    have := hf 1 P.one_mem 1 P.one_mem
    rw [one_mul] at this
    exact (mul_eq_left.1 this.symm)
  have hfpow : ∀ b ∈ P, ∀ c : ℕ, f (b ^ c) = f b ^ c := by
    intro b hb c
    induction c with
    | zero => simp [hf1]
    | succ c ih => rw [pow_succ, hf _ (pow_mem hb c) _ hb, ih, pow_succ]
  -- the words lie in `P` and map into `N`
  have hPN : ∀ w ∈ Subgroup.closure {x | x ∈ B}, w ∈ P ∧ f w ∈ N := by
    intro w hw
    have hle : Subgroup.closure {x | x ∈ B} ≤ P := (Subgroup.closure_le _).2 fun x hx => hBP x hx
    refine ⟨hle hw, ?_⟩
    induction hw using Subgroup.closure_induction with
    | mem x hx => exact hBN x hx
    | one => rw [hf1]; exact N.one_mem
    | mul x y hx hy ihx ihy => rw [hf x (hle hx) y (hle hy)]; exact N.mul_mem ihx ihy
    | inv x hx ihx =>
      have e := hf x⁻¹ (P.inv_mem (hle hx)) x (hle hx)
      rw [inv_mul_cancel, hf1] at e
      rw [eq_inv_of_mul_eq_one_left e.symm]; exact N.inv_mem ihx
  have key : ∀ (B0 B' : List (Perm (Fin n))) (E : List (Perm (Fin n))), B0 ++ B' = B →
      (∀ e ∈ E, e ∈ Subgroup.closure {x | x ∈ B}) →
      (∀ v ∈ Submodule.span (ZMod r) (κ '' (f '' {x | x ∈ B0})), ∃ e ∈ E, κ (f e) = v) →
      ∀ v ∈ Submodule.span (ZMod r) (κ '' (f '' {x | x ∈ B0 ++ B'})),
        ∃ w ∈ B'.foldl (fun E b => E.flatMap fun e => (List.range r).map fun c => e * b ^ c) E,
          κ (f w) = v := by
    intro B0 B'
    induction B' generalizing B0 with
    | nil => intro E _ _ hcov; simpa using hcov
    | cons b B' ih =>
      intro E hB hE hcov
      have hbB : b ∈ B := by rw [← hB]; simp
      have hb := hPN b (Subgroup.subset_closure (k := {x | x ∈ B}) hbB)
      have e1 : B0 ++ b :: B' = B0 ++ [b] ++ B' := by simp
      rw [e1, List.foldl_cons]
      refine ih (B0 ++ [b]) (E.flatMap fun e => (List.range r).map fun c => e * b ^ c)
        (by rw [← hB, e1]) ?_ ?_
      · intro e he
        simp only [List.mem_flatMap, List.mem_map, List.mem_range] at he
        obtain ⟨e0, he0, c, -, rfl⟩ := he
        exact mul_mem (hE e0 he0) (pow_mem (Subgroup.subset_closure (k := {x | x ∈ B}) hbB) c)
      · intro v hv
        have himg : κ '' (f '' {x | x ∈ B0 ++ [b]}) = κ '' (f '' {x | x ∈ B0}) ∪ {κ (f b)} := by
          ext u; simp [or_and_right, exists_or]
          exact ⟨fun h => h.elim (fun h => Or.inr h) (fun h => Or.inl h.symm),
            fun h => h.elim (fun h => Or.inr h.symm) (fun h => Or.inl h)⟩
        rw [himg, Submodule.span_union, Submodule.mem_sup] at hv
        obtain ⟨u, hu, t, ht, rfl⟩ := hv
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 ht
        obtain ⟨e, he, rfl⟩ := hcov u hu
        have hePN := hPN e (hE e he)
        refine ⟨e * b ^ c.val, ?_, ?_⟩
        · simp only [List.mem_flatMap, List.mem_map, List.mem_range]
          exact ⟨e, he, c.val, ZMod.val_lt c, rfl⟩
        · rw [hf e hePN.1 _ (pow_mem hb.1 _), hfpow b hb.1, hk.mul _ hePN.2 _ (pow_mem hb.2 _),
            hk.npow hb.2, ← Nat.cast_smul_eq_nsmul (ZMod r), ZMod.natCast_zmod_val]
  intro v hv
  refine key [] B [1] (by simp) (fun e he => by simp at he; rw [he]; exact one_mem _) ?_ v
    (by simpa using hv)
  intro v hv
  have : κ '' (f '' {x | x ∈ ([] : List (Perm (Fin n)))}) = ∅ := by simp
  rw [this, Submodule.span_empty, Submodule.mem_bot] at hv
  exact ⟨1, by simp, by rw [hv, hf1, hk.one]⟩

end GI.Proved
