module

public import Workspace.Proved.VsQProb
public import Workspace.Lang.Prims.Reduce
public import Workspace.Proved.VsWBasic
public import Workspace.Proved.VsQCost

@[expose] public section

/-!
# Answers of the driver and how they are pasted

An answer to the problem `(H, W, W', x, y)` is `none` (no solution) or `some (h, ks)`: a solution
`h` and at most `n²` generators `ks` of the stabilizer (`VsQAnsOK`). The driver splits `H` into
cosets `t • C` and solves the problem for `C` in each coset; the answers, multiplied by `t`, are
pasted by `vsQPaste` (`vsQ_paste`): the first solution `h₀`, and the stabilizer generated by the
stabilizer of `C` and the elements `h₀⁻¹ g` for the other solutions `g`.
-/

namespace GI.Proved

open Matrix
open GI.Cited GI.Lang Equiv
open scoped Pointwise

variable {I : VecStabInst}

/-- A correct answer. -/
def VsQAnsOK {H : Subgroup (Perm (Fin I.n))} {W W' : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP : VsQProb I H W W' x y) :
    Option (Perm (Fin I.n) × List (Perm (Fin I.n))) → Prop
  | none => vsQSol I H W' x y = ∅
  | some (h, ks) => h ∈ vsQSol I H W' x y ∧ gens ks = vsQStab H W' x hP.le hP.invW' ∧
      ks.length ≤ I.n ^ 2

/-- The answer of one coset `t • C`, multiplied by `t`. -/
def VsQCosOK {H C : Subgroup (Perm (Fin I.n))} {W W' : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP : VsQProb I H W W' x y) (hC : C ≤ H) (t : Perm (Fin I.n)) :
    Option (Perm (Fin I.n) × List (Perm (Fin I.n))) → Prop
  | none => vsQSol I C W' x ((vsQPhi I t⁻¹).mulVec y) = ∅
  | some (g, ks) => t⁻¹ * g ∈ vsQSol I C W' x ((vsQPhi I t⁻¹).mulVec y) ∧
      gens ks = vsQStab C W' x (hC.trans hP.le) (hP.invW'.mono hC) ∧ ks.length ≤ I.n ^ 2

/-- The pasted answer. -/
noncomputable def vsQPaste {n : ℕ} (rs : List (Option (Perm (Fin n) × List (Perm (Fin n))))) :
    Option (Perm (Fin n) × List (Perm (Fin n))) :=
  match rs.findSome? id with
  | none => none
  | some (h₀, ks) => some (h₀, keepList (ks ++ rs.map fun r =>
      match r with
      | some (g, _) => h₀⁻¹ * g
      | none => h₀⁻¹ * h₀))

/-- **Pasting.** -/
theorem vsQ_paste {H C : Subgroup (Perm (Fin I.n))} {W W' : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP : VsQProb I H W W' x y) (hC : C ≤ H) (T : List (Perm (Fin I.n)))
    (hT : ∀ t ∈ T, t ∈ H) (hcov : ∀ h ∈ H, ∃ t ∈ T, t⁻¹ * h ∈ C)
    (rs : List (Option (Perm (Fin I.n) × List (Perm (Fin I.n))))) (hlen : rs.length = T.length)
    (hok : ∀ i (hi : i < T.length), VsQCosOK hP hC T[i] (rs[i]'(hlen ▸ hi))) :
    VsQAnsOK hP (vsQPaste rs) := by
  have hU := vsQSol_cosets hP hC T hT hcov
  -- the solutions in the coset of `T[i]`
  have hsol : ∀ i (hi : i < T.length), ∀ g ks, rs[i]'(hlen ▸ hi) = some (g, ks) →
      g ∈ vsQSol I H W' x y := by
    intro i hi g ks he
    have := hok i hi
    rw [he] at this
    rw [hU, Set.mem_iUnion₂]
    exact ⟨T[i], List.getElem_mem hi, T[i]⁻¹ * g, this.1, by simp [smul_eq_mul]⟩
  unfold vsQPaste
  cases hf : rs.findSome? id with
  | none =>
    show vsQSol I H W' x y = ∅
    rw [hU]
    simp only [Set.iUnion_eq_empty]
    intro t ht
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem ht
    have hn : rs[i]'(hlen ▸ hi) = none := by
      have := List.findSome?_eq_none_iff.mp hf (rs[i]'(hlen ▸ hi)) (List.getElem_mem _)
      simpa using this
    have := hok i hi
    rw [hn] at this
    change vsQSol I C W' x ((vsQPhi I T[i]⁻¹).mulVec y) = ∅ at this
    rw [this, Set.smul_set_empty]
  | some a =>
    obtain ⟨h₀, ks₀⟩ := a
    obtain ⟨r, hr, hr'⟩ := List.exists_of_findSome?_eq_some hf
    simp only [id] at hr'
    subst hr'
    obtain ⟨i₀, hi₀, hri⟩ := List.getElem_of_mem hr
    have hi₀' : i₀ < T.length := hlen ▸ hi₀
    have hok₀ := hok i₀ hi₀'
    rw [hri] at hok₀
    obtain ⟨hg₀, hks₀, -⟩ := hok₀
    have hh₀ : h₀ ∈ vsQSol I H W' x y := hsol i₀ hi₀' h₀ ks₀ hri
    refine ⟨hh₀, ?_, length_keepList_le _⟩
    rw [gens_keepList]
    have hCH : ∀ k, k ∈ vsQStab C W' x (hC.trans hP.le) (hP.invW'.mono hC) →
        k ∈ vsQStab H W' x hP.le hP.invW' := fun k hk => ⟨hC hk.1, hk.2⟩
    -- solutions differ by the stabilizer
    have hdiff : ∀ g ∈ vsQSol I H W' x y, h₀⁻¹ * g ∈ vsQStab H W' x hP.le hP.invW' := by
      intro g hg
      have := vsQSol_coset hP hh₀
      rw [this] at hg
      obtain ⟨k, hk, rfl⟩ := hg
      simpa using hk
    apply le_antisymm
    · apply (Subgroup.closure_le _).mpr
      intro k hk
      simp only [Set.mem_setOf_eq, List.mem_append, List.mem_map] at hk
      rcases hk with hk | ⟨r', hr'', rfl⟩
      · apply hCH
        rw [← hks₀]
        exact Subgroup.subset_closure hk
      · obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hr''
        have hj' : j < T.length := hlen ▸ hj
        cases hrj : rs[j] with
        | none =>
          simp only
          rw [inv_mul_cancel]
          exact (vsQStab H W' x hP.le hP.invW').one_mem
        | some b =>
          obtain ⟨g, ks⟩ := b
          simp only
          exact hdiff g (hsol j hj' g ks hrj)
    · intro s hs
      have hhs : h₀ * s ∈ vsQSol I H W' x y := by
        rw [vsQSol_coset hP hh₀]; exact ⟨s, hs, rfl⟩
      rw [hU, Set.mem_iUnion₂] at hhs
      obtain ⟨t, ht, c, hc, hce⟩ := hhs
      obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem ht
      have hj' : j < rs.length := hlen ▸ hj
      have hokj := hok j hj
      cases hrj : rs[j]'hj' with
      | none =>
        rw [hrj] at hokj
        change vsQSol I C W' x ((vsQPhi I T[j]⁻¹).mulVec y) = ∅ at hokj
        rw [hokj] at hc
        exact absurd hc (Set.notMem_empty _)
      | some b =>
        obtain ⟨g, ks⟩ := b
        rw [hrj] at hokj
        obtain ⟨hgj, hksj, -⟩ := hokj
        -- `c` and `T[j]⁻¹ g` are solutions of the coset problem
        have hPc := hP.coset hC (hT _ ht)
        have hcs := vsQSol_coset hPc hgj
        rw [hcs] at hc
        obtain ⟨k, hk, rfl⟩ := hc
        have hk' : k ∈ vsQStab C W' x (hC.trans hP.le) (hP.invW'.mono hC) := hk
        have es : s = (h₀⁻¹ * g) * k := by
          have : h₀ * s = g * k := by rw [← hce]; simp [smul_eq_mul, mul_assoc]
          calc s = h₀⁻¹ * (h₀ * s) := by group
            _ = (h₀⁻¹ * g) * k := by rw [this]; group
        rw [es]
        refine Subgroup.mul_mem _ (Subgroup.subset_closure ?_) ?_
        · simp only [Set.mem_setOf_eq, List.mem_append, List.mem_map]
          exact Or.inr ⟨some (g, ks), by rw [← hrj]; exact List.getElem_mem _, rfl⟩
        · have : k ∈ gens ks₀ := by rw [hks₀]; exact hk'
          exact (Subgroup.closure_mono (fun z hz => by
            simp only [Set.mem_setOf_eq, List.mem_append]; exact Or.inl hz)) this

/-! ### Chains -/

/-- **One step of a chain.** If the problem modulo `U` has answer `some (z, ks)`, the problem
inside `U` for `⟨ks⟩` with target `φ(z)⁻¹ y` gives the answer of the whole problem. -/
theorem vsQ_chain_ans {H : Subgroup (Perm (Fin I.n))} {W W' U : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP : VsQProb I H W W' x y) (hWU : W' ≤ U) (hUW : U ≤ W)
    (hU : VsQInv I H U) {z : Perm (Fin I.n)} {ks : List (Perm (Fin I.n))}
    (h1 : VsQAnsOK (hP.upper hUW hU) (some (z, ks))) :
    ∃ hP' : VsQProb I (gens ks) U W' x ((vsQPhi I z⁻¹).mulVec y),
      ∀ a, VsQAnsOK hP' a → VsQAnsOK hP (a.map fun r => (z * r.1, r.2)) := by
  obtain ⟨hz, hks, -⟩ := h1
  have hP2 := hP.lower hWU hU hz
  rw [← hks] at hP2
  refine ⟨hP2, fun a ha => ?_⟩
  have hch := vsQSol_chain hP hWU hU hz
  have hst := vsQSol_chain_stab hP hWU hU
  cases a with
  | none =>
    change vsQSol I H W' x y = ∅
    change vsQSol I (gens ks) W' x ((vsQPhi I z⁻¹).mulVec y) = ∅ at ha
    rw [hch, ← hks, ha, Set.smul_set_empty]
  | some r =>
    obtain ⟨z', ks'⟩ := r
    obtain ⟨hz', hks', hl⟩ := ha
    refine ⟨?_, ?_, hl⟩
    · rw [hch, ← hks]
      exact ⟨z', hz', rfl⟩
    · rw [hks']
      ext g
      have := congrArg (g ∈ ·) hst
      change g ∈ vsQSol I (gens ks) W' x x ↔ g ∈ vsQSol I H W' x x
      rw [← this, hks]

/-! ### States of the driver -/

/-- The span of a list of vectors, in `𝔽_p^d`. -/
abbrev vsQSp (I : VecStabInst) (us : List (List ℕ)) : Submodule (ZMod I.p) (VsQV I) :=
  vsWSp I.p I.d us

/-- The rank of the span of a list of vectors. -/
noncomputable def vsQRk (I : VecStabInst) (us : List (List ℕ)) : ℕ :=
  Module.finrank (ZMod I.p) (vsQSp I us)

/-- `φ(H)` acts on `W/W'` as an abelian group. -/
def VsQAb (I : VecStabInst) (H : Subgroup (Perm (Fin I.n))) (W W' : Submodule (ZMod I.p) (VsQV I)) :
    Prop :=
  ∀ g ∈ H, ∀ h ∈ H, ∀ w ∈ W,
    (vsQPhi I g).mulVec ((vsQPhi I h).mulVec w) - (vsQPhi I h).mulVec ((vsQPhi I g).mulVec w) ∈ W'

theorem VsQAb.mono {H K : Subgroup (Perm (Fin I.n))} {W W' U U' : Submodule (ZMod I.p) (VsQV I)}
    (h : VsQAb I H W W') (hK : K ≤ H) (hU : U ≤ W) (hU' : W' ≤ U') : VsQAb I K U U' :=
  fun g hg k hk w hw => hU' (h g (hK hg) k (hK hk) w (hU hw))

/-- The ranks of the steps of a chain. -/
noncomputable def vsQDims (I : VecStabInst) (L : List (List (List ℕ))) : List ℕ :=
  List.zipWith (fun a b => vsQRk I a - vsQRk I b) L L.tail

/-- A strictly decreasing chain of spans. -/
def VsQChain (I : VecStabInst) (L : List (List (List ℕ))) : Prop :=
  L.IsChain fun a b => vsQSp I b < vsQSp I a

theorem vsQDims_cons_cons (a b : List (List ℕ)) (L : List (List (List ℕ))) :
    vsQDims I (a :: b :: L) = (vsQRk I a - vsQRk I b) :: vsQDims I (b :: L) := rfl

theorem vsQDims_single (a : List (List ℕ)) : vsQDims I [a] = [] := rfl

theorem vsQDims_length (L : List (List (List ℕ))) : (vsQDims I L).length = L.length - 1 := by
  simp [vsQDims]

/-- The steps of a strict chain are positive and add up to the rank difference of its ends. -/
theorem vsQDims_chain : ∀ (a : List (List ℕ)) (L : List (List (List ℕ))), VsQChain I (a :: L) →
    (∀ e ∈ vsQDims I (a :: L), 1 ≤ e) ∧
      (vsQDims I (a :: L)).sum + vsQRk I ((a :: L).getLast (List.cons_ne_nil _ _)) = vsQRk I a
  | a, [], _ => by simp [vsQDims_single]
  | a, b :: L, h => by
    haveI : Fact I.p.Prime := ⟨I.prime⟩
    have hab : vsQSp I b < vsQSp I a := (List.isChain_cons_cons.mp h).1
    have hlt : vsQRk I b < vsQRk I a := by
      set_option backward.isDefEq.respectTransparency false in
        exact Submodule.finrank_lt_finrank_of_lt hab
    obtain ⟨ih1, ih2⟩ := vsQDims_chain b L (List.isChain_cons_cons.mp h).2
    rw [vsQDims_cons_cons]
    refine ⟨fun e he => ?_, ?_⟩
    · rcases List.mem_cons.mp he with rfl | he
      · omega
      · exact ih1 e he
    · rw [List.getLast_cons_cons, List.sum_cons]
      omega

/-- A state of the driver: generators of `H`, bases of `W'` and `W`, and the vectors `x, y`. -/
structure VsQSt (I : VecStabInst) where
  hs : List (Perm (Fin I.n))
  ws' : List (List ℕ)
  ws : List (List ℕ)
  x : List ℕ
  y : List ℕ

/-- The problem of a state. -/
abbrev VsQSt.Prob (s : VsQSt I) : Prop :=
  VsQProb I (gens s.hs) (vsQSp I s.ws) (vsQSp I s.ws') (vsWV I.p I.d s.x) (vsWV I.p I.d s.y)

/-- A valid state. -/
structure VsQStOK (s : VsQSt I) : Prop where
  prob : s.Prob
  hsl : s.hs.length ≤ I.n ^ 2
  fit : VsWFit I.p I.d s.ws
  fit' : VsWFit I.p I.d s.ws'
  wl : s.ws.length ≤ I.d
  wl' : s.ws'.length ≤ I.d
  fx : VsWFit I.p I.d [s.x]
  fy : VsWFit I.p I.d [s.y]

/-- The rank of `W/W'`. -/
noncomputable def VsQSt.dim (s : VsQSt I) : ℕ := vsQRk I s.ws - vsQRk I s.ws'

/-- `H` acts on `W/W'` as an abelian group. -/
abbrev VsQSt.Ab (s : VsQSt I) : Prop := VsQAb I (gens s.hs) (vsQSp I s.ws) (vsQSp I s.ws')

open Classical in
/-- The measure of the induction: `2 D`, plus one if the action is not abelian. -/
noncomputable def VsQSt.mu (s : VsQSt I) : ℕ := 2 * s.dim + if s.Ab then 0 else 1

open Classical in
/-- The cost bound of the driver. -/
noncomputable def vsQBd (c K D : ℕ) (ab : Prop) : ℕ :=
  if ab then vsQFa c (max D 1) else vsQFn c K (max D 1)

/-- The bound of a step, by the flag of the coset group. -/
noncomputable def vsQPsi (c K : ℕ) (ab : Prop) (D : ℕ) : ℕ := vsQBd c K D ab

open Classical in
theorem vsQBd_of_pos {c K D : ℕ} (ab : Prop) (hD : 1 ≤ D) :
    vsQBd c K D ab = if ab then vsQFa c D else vsQFn c K D := by
  unfold vsQBd; rw [max_eq_left hD]

theorem vsQBd_le_Fn {c K D : ℕ} (ab : Prop) (hD : 1 ≤ D) (hK : 2 ≤ K) :
    vsQBd c K D ab ≤ vsQFn c K D := by
  rw [vsQBd_of_pos ab hD]
  split_ifs
  · exact vsQFa_le_Fn hD hK
  · exact le_rfl

/-- The bound gets larger when the action is not known to be abelian. -/
theorem vsQBd_mono {c K D : ℕ} {ab ab' : Prop} (h : ab' → ab) (hK : 2 ≤ K) :
    vsQBd c K D ab ≤ vsQBd c K D ab' := by
  unfold vsQBd
  by_cases h1 : ab'
  · rw [if_pos (h h1), if_pos h1]
  · rw [if_neg h1]
    split_ifs
    · exact vsQFa_le_Fn (le_max_right _ _) hK
    · exact le_rfl

/-- **The cost of a split node.** `T` cosets, steps of ranks `ds`, overhead `2 Cn` per coset
and step. -/
theorem vsQ_node_cost {c Cn K E D T : ℕ} (hc : 20 * Cn ≤ c) (hK : 2 * E + 2 ≤ K) (hK8 : 8 ≤ K)
    {ds : List ℕ} {ab abC : Prop} (hds : ∀ e ∈ ds, 1 ≤ e) (hsum : ds.sum = D) (habC : ab → abC)
    (hcase : (T = 1 ∧ 2 ≤ ds.length) ∨
      (¬ ab ∧ 2 ≤ ds.length ∧ (∃ e, ∀ x ∈ ds, x = e) ∧ T ≤ (ds.length + 1) ^ E) ∨
      (¬ ab ∧ ds.length = 1 ∧ abC ∧ 2 ≤ D ∧ T ≤ 24 * D)) :
    2 * Cn * (1 + T * (ds.length + 1)) + T * (ds.map fun e => vsQBd c K e abC).sum ≤
      vsQBd c K D ab := by
  have hc' : 10 * (2 * Cn) ≤ c := by omega
  have hK2 : 2 ≤ K := by omega
  have hFn : (ds.map fun e => vsQBd c K e abC).sum ≤ (ds.map (vsQFn c K)).sum :=
    List.sum_le_sum fun e he => vsQBd_le_Fn abC (hds e he) hK2
  rcases hcase with ⟨rfl, hb⟩ | ⟨hab, hb, ⟨e, he⟩, hT⟩ | ⟨hab, hb, hC, hD, hT⟩
  · have hD : 1 ≤ D := by
      rw [← hsum]
      obtain ⟨x, hx⟩ := List.exists_mem_of_length_pos (by omega : 0 < ds.length)
      exact (hds x hx).trans (List.le_sum_of_mem hx)
    by_cases hab : ab
    · have hA : (ds.map fun e => vsQBd c K e abC).sum = (ds.map (vsQFa c)).sum := by
        congr 1
        apply List.map_congr_left
        intro e he
        rw [vsQBd_of_pos abC (hds e he), if_pos (habC hab)]
      have := vsQ_cost_chainA hc' hb hds
      rw [vsQBd_of_pos ab hD, if_pos hab, ← hsum, hA]
      simpa using this
    · have := vsQ_cost_chainN hc' hK2 hb hds
      rw [vsQBd_of_pos ab hD, if_neg hab, ← hsum]
      simp only [one_mul] at this ⊢
      omega
  · have he1 : 1 ≤ e := by
      obtain ⟨x, hx⟩ := List.exists_mem_of_length_pos (by omega : 0 < ds.length)
      rw [← he x hx]; exact hds x hx
    have hds' : ds = List.replicate ds.length e := List.eq_replicate_iff.mpr ⟨rfl, he⟩
    have hsum' : D = ds.length * e := by rw [← hsum, hds']; simp
    have hFn' : (ds.map (vsQFn c K)).sum = ds.length * vsQFn c K e := by
      rw [hds']; simp
    have := vsQ_cost_equal hc' hK hb he1 hT
    rw [vsQBd_of_pos ab (by rw [hsum']; nlinarith), if_neg hab, hsum']
    have h2 := Nat.mul_le_mul_left T hFn
    rw [hFn'] at h2
    omega
  · obtain ⟨x, rfl⟩ := List.length_eq_one_iff.mp hb
    simp only [List.sum_cons, List.sum_nil, add_zero] at hsum
    subst hsum
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero,
      List.length_cons, List.length_nil]
    rw [vsQBd_of_pos abC (by omega), if_pos hC, vsQBd_of_pos ab (by omega), if_neg hab]
    exact vsQ_cost_abel hc' hK8 hD hT

/-- An answer for one subspace `W'` is an answer for any equal subspace. -/
theorem VsQAnsOK.congr {H : Subgroup (Perm (Fin I.n))} {W W₁ W₂ : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP₁ : VsQProb I H W W₁ x y) (hP₂ : VsQProb I H W W₂ x y) (he : W₁ = W₂)
    {a : Option (Perm (Fin I.n) × List (Perm (Fin I.n)))} (h : VsQAnsOK hP₁ a) : VsQAnsOK hP₂ a := by
  subst he; exact h

/-- An answer for one target is an answer for an equal target. -/
theorem VsQAnsOK.congr_y {H : Subgroup (Perm (Fin I.n))} {W W' : Submodule (ZMod I.p) (VsQV I)}
    {x y₁ y₂ : VsQV I} (hP₁ : VsQProb I H W W' x y₁) (hP₂ : VsQProb I H W W' x y₂) (he : y₁ = y₂)
    {a : Option (Perm (Fin I.n) × List (Perm (Fin I.n)))} (h : VsQAnsOK hP₁ a) : VsQAnsOK hP₂ a := by
  subst he; exact h

/-- An answer for a group is an answer for an equal group. -/
theorem VsQAnsOK.congr_H {H₁ H₂ : Subgroup (Perm (Fin I.n))} {W W' : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP₁ : VsQProb I H₁ W W' x y) (hP₂ : VsQProb I H₂ W W' x y) (he : H₁ = H₂)
    {a : Option (Perm (Fin I.n) × List (Perm (Fin I.n)))} (h : VsQAnsOK hP₁ a) : VsQAnsOK hP₂ a := by
  subst he; exact h

/-- With `W' = W` the answer is `(1, ks)` for generators `ks` of `H`. -/
theorem vsQ_ans_top {H : Subgroup (Perm (Fin I.n))} {W : Submodule (ZMod I.p) (VsQV I)}
    {x y : VsQV I} (hP : VsQProb I H W W x y) {ks : List (Perm (Fin I.n))} (hks : gens ks = H)
    (hl : ks.length ≤ I.n ^ 2) : VsQAnsOK hP (some (1, ks)) := by
  refine ⟨?_, ?_, hl⟩
  · rw [vsQSol_top hP]; exact H.one_mem
  · have hP' : VsQProb I H W W x x := ⟨hP.le, hP.sub, hP.invW, hP.invW', hP.cx, by simp⟩
    ext g
    rw [hks]
    change g ∈ H ↔ g ∈ vsQSol I H W x x
    rw [vsQSol_top hP']
    rfl

/-- A strict chain has at most as many steps as the rank of its top. -/
theorem vsQChain_length {a : List (List ℕ)} {L : List (List (List ℕ))} (h : VsQChain I (a :: L)) :
    L.length ≤ vsQRk I a := by
  obtain ⟨h1, h2⟩ := vsQDims_chain a L h
  have hl : (vsQDims I (a :: L)).length = L.length := by rw [vsQDims_length]; simp
  have : (vsQDims I (a :: L)).length ≤ (vsQDims I (a :: L)).sum := by
    have := List.length_le_sum_of_one_le _ h1
    exact this
  omega

theorem vsQRk_le (us : List (List ℕ)) : vsQRk I us ≤ I.d := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  unfold vsQRk
  exact (Submodule.finrank_le _).trans (by simp)

end GI.Proved
