module

public import Workspace.Proved.PalfyBasic

@[expose] public section

/-!
# Commutative algebras of operators normalized by an irreducible group

Let `H` be an irreducible linear group on a finite `K`-space `V`, and let `R ⊆ End_K(V)` be a
commutative subalgebra that `H` normalizes. In the order bound, `R` is the algebra generated by
an abelian normal subgroup of `H`. We show:
* `GI.Proved.palfy_nilpotent_eq_zero`: `R` has no nonzero nilpotent element. The common kernel of
  the nilpotent elements is nonzero and `H`-invariant, so it is `V`.
* `GI.Proved.palfy_isField`: if `0` and `1` are the only idempotents of `R`, then `R` is a field.
  Every element has an idempotent power, so it is a unit or nilpotent.
* Otherwise the minimal nonzero idempotents of `R` (the set `palfyMinIdem R`) are pairwise
  orthogonal (`palfy_minIdem_mul`), sum to `1` (`palfy_minIdem_sum`), there are at least two of
  them (`palfy_minIdem_two_le`), and `H` permutes them by conjugation (`palfy_minIdem_conj`).
-/

namespace GI.Proved

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- In a finite monoid every element has an idempotent positive power. -/
theorem palfy_exists_idem_pow {M : Type*} [Monoid M] [Finite M] (x : M) :
    ∃ n, 1 ≤ n ∧ IsIdempotentElem (x ^ n) := by
  obtain ⟨i, j, hij, he⟩ := Finite.exists_ne_map_eq_of_infinite (fun n : ℕ => x ^ n)
  wlog h : i < j generalizing i j
  · exact this j i hij.symm he.symm (lt_of_le_of_ne (not_lt.mp h) hij.symm)
  have he' : x ^ i = x ^ j := he
  obtain ⟨d, hd⟩ : ∃ d, j = i + (d + 1) := ⟨j - i - 1, by omega⟩
  have key : ∀ m, i ≤ m → ∀ t, x ^ (m + (d + 1) * t) = x ^ m := by
    intro m hm t
    induction t with
    | zero => simp
    | succ t ih =>
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hm
      have : i + k + (d + 1) * (t + 1) = (i + (d + 1)) + (k + (d + 1) * t) := by ring
      rw [this, pow_add, ← hd, ← he', ← pow_add, ← add_assoc, ih]
  refine ⟨(d + 1) * (i + 1), Nat.one_le_iff_ne_zero.mpr (by positivity), ?_⟩
  unfold IsIdempotentElem
  rw [← pow_add, key _ ?_ (i + 1)]
  nlinarith

/-- A nilpotent operator kills some nonzero vector of the form `y^j w`. -/
theorem palfy_exists_ker_of_nilpotent {y : Module.End K V} (hy : IsNilpotent y) {w : V}
    (hw : w ≠ 0) : ∃ j, (y ^ j) w ≠ 0 ∧ y ((y ^ j) w) = 0 := by
  classical
  obtain ⟨n, hn⟩ := hy
  have hex : ∃ j, (y ^ (j + 1)) w = 0 := ⟨n, by rw [pow_succ, hn, zero_mul]; rfl⟩
  refine ⟨Nat.find hex, ?_, ?_⟩
  · intro h0
    rcases Nat.eq_zero_or_eq_succ_pred (Nat.find hex) with h | h
    · rw [h, pow_zero] at h0
      exact hw h0
    · have := Nat.find_min hex (show Nat.find hex - 1 < Nat.find hex by omega)
      rw [show Nat.find hex - 1 + 1 = Nat.find hex by omega] at this
      exact this h0
  · have := Nat.find_spec hex
    rwa [pow_succ', Module.End.mul_apply] at this

theorem palfy_pow_mem {y : Module.End K V} {W : Submodule K V} (hW : ∀ v ∈ W, y v ∈ W) (j : ℕ)
    {v : V} (hv : v ∈ W) : (y ^ j) v ∈ W := by
  induction j with
  | zero => simpa using hv
  | succ j ih => rw [pow_succ', Module.End.mul_apply]; exact hW _ ih

/-- Commuting nilpotent operators have a common nonzero kernel vector in every nonzero subspace
they preserve. -/
theorem palfy_common_ker (s : Finset (Module.End K V)) (hs : ∀ x ∈ s, IsNilpotent x)
    (hc : ∀ x ∈ s, ∀ y ∈ s, x * y = y * x) :
    ∀ W : Submodule K V, W ≠ ⊥ → (∀ x ∈ s, ∀ v ∈ W, x v ∈ W) →
      ∃ v ∈ W, v ≠ 0 ∧ ∀ x ∈ s, x v = 0 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro W hW _
    obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW
    exact ⟨v, hv, hv0, by simp⟩
  | insert y s hy ih =>
    intro W hW hinv
    have hs' : ∀ x ∈ s, IsNilpotent x := fun x hx => hs x (Finset.mem_insert_of_mem hx)
    have hc' : ∀ x ∈ s, ∀ z ∈ s, x * z = z * x := fun x hx z hz =>
      hc x (Finset.mem_insert_of_mem hx) z (Finset.mem_insert_of_mem hz)
    have hyW : ∀ v ∈ W, y v ∈ W := hinv y (Finset.mem_insert_self y s)
    obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW
    obtain ⟨j, hj0, hj⟩ := palfy_exists_ker_of_nilpotent (hs y (Finset.mem_insert_self y s)) hw0
    have hW' : W ⊓ LinearMap.ker y ≠ ⊥ := by
      intro h0
      apply hj0
      have : (y ^ j) w ∈ W ⊓ LinearMap.ker y := ⟨palfy_pow_mem hyW j hw, hj⟩
      rwa [h0, Submodule.mem_bot] at this
    have hinv' : ∀ x ∈ s, ∀ v ∈ W ⊓ LinearMap.ker y, x v ∈ W ⊓ LinearMap.ker y := by
      intro x hx v hv
      refine ⟨hinv x (Finset.mem_insert_of_mem hx) v hv.1, ?_⟩
      have hxy := hc y (Finset.mem_insert_self y s) x (Finset.mem_insert_of_mem hx)
      change y (x v) = 0
      rw [← Module.End.mul_apply, hxy, Module.End.mul_apply, LinearMap.mem_ker.mp hv.2,
        map_zero]
    obtain ⟨v, hv, hv0, hvs⟩ := ih hs' hc' _ hW' hinv'
    refine ⟨v, hv.1, hv0, ?_⟩
    intro x hx
    rcases Finset.mem_insert.mp hx with rfl | hx
    · exact hv.2
    · exact hvs x hx

/-- `R` is commutative and normalized by `H`. -/
structure PalfyAlg (H : Subgroup (Module.End K V)ˣ) (R : Subalgebra K (Module.End K V)) :
    Prop where
  comm : ∀ x ∈ R, ∀ y ∈ R, x * y = y * x
  norm : ∀ h ∈ H, ∀ x ∈ R, (h : Module.End K V) * x * ((h⁻¹ : (Module.End K V)ˣ) :
    Module.End K V) ∈ R

theorem PalfyAlg.norm' {H : Subgroup (Module.End K V)ˣ} {R : Subalgebra K (Module.End K V)}
    (hR : PalfyAlg H R) {h : (Module.End K V)ˣ} (hh : h ∈ H) {x : Module.End K V} (hx : x ∈ R) :
    ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V) * x * (h : Module.End K V) ∈ R := by
  have := hR.norm _ (H.inv_mem hh) x hx
  rwa [inv_inv] at this

/-- **No nilpotents.** -/
theorem palfy_nilpotent_eq_zero [Finite V] [Nontrivial V] {H : Subgroup (Module.End K V)ˣ}
    (hH : palfyIrr H) {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R)
    {x : Module.End K V} (hxR : x ∈ R) (hx : IsNilpotent x) : x = 0 := by
  classical
  let S : Submodule K V := ⨅ (y : Module.End K V) (_ : y ∈ R ∧ IsNilpotent y), LinearMap.ker y
  have hmem : ∀ v, v ∈ S ↔ ∀ y ∈ R, IsNilpotent y → y v = 0 := by
    intro v
    simp only [S, Submodule.mem_iInf, LinearMap.mem_ker, and_imp]
  have hS : palfyInv H S := by
    intro g hg v hv
    rw [hmem] at hv ⊢
    intro y hy hyn
    have hconj : ((g⁻¹ : (Module.End K V)ˣ) : Module.End K V) * y * (g : Module.End K V) ∈ R :=
      hR.norm' hg hy
    have hnil : IsNilpotent (((g⁻¹ : (Module.End K V)ˣ) : Module.End K V) * y *
        (g : Module.End K V)) := by
      obtain ⟨n, hn⟩ := hyn
      exact ⟨n, by rw [Units.conj_pow', hn, mul_zero, zero_mul]⟩
    have h0 := hv _ hconj hnil
    have : y ((g : Module.End K V) v) = (g : Module.End K V) ((((g⁻¹ : (Module.End K V)ˣ) : Module.End K V) * y *
        (g : Module.End K V)) v) := by
      change _ = ((g * g⁻¹ : (Module.End K V)ˣ) : Module.End K V) (y ((g : Module.End K V) v))
      simp
    rw [this, h0, map_zero]
  have hfin : Set.Finite {y : Module.End K V | y ∈ R ∧ IsNilpotent y} := Set.toFinite _
  obtain ⟨v, -, hv0, hv⟩ := palfy_common_ker hfin.toFinset
    (fun y hy => ((Set.Finite.mem_toFinset _).mp hy).2)
    (fun y hy z hz => hR.comm y ((Set.Finite.mem_toFinset _).mp hy).1 z
      ((Set.Finite.mem_toFinset _).mp hz).1) ⊤ top_ne_bot (fun _ _ _ _ => Submodule.mem_top)
  rcases hH S hS with h0 | h0
  · exfalso
    apply hv0
    have : v ∈ S := (hmem v).mpr (fun y hy hyn => hv y ((Set.Finite.mem_toFinset _).mpr ⟨hy, hyn⟩))
    rwa [h0, Submodule.mem_bot] at this
  · ext w
    have : w ∈ S := by rw [h0]; exact Submodule.mem_top
    exact (hmem w).mp this x hxR hx

/-- **Field case.** If `0` and `1` are the only idempotents of `R`, then `R` is a field. -/
theorem palfy_isField [Finite V] [Nontrivial V] {H : Subgroup (Module.End K V)ˣ}
    (hH : palfyIrr H) {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R)
    (hidem : ∀ e ∈ R, IsIdempotentElem e → e = 0 ∨ e = 1) : IsField R := by
  refine ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩, ?_, ?_⟩
  · intro a b
    exact Subtype.ext (hR.comm a a.2 b b.2)
  · intro a ha
    obtain ⟨n, hn, hidn⟩ := palfy_exists_idem_pow a
    have hidn' : IsIdempotentElem ((a : Module.End K V) ^ n) := by
      have := congrArg Subtype.val hidn.eq
      exact this
    rcases hidem _ (Subalgebra.pow_mem R a.2 n) hidn' with h0 | h1
    · exfalso
      exact ha (Subtype.ext (palfy_nilpotent_eq_zero hH hR a.2 ⟨n, h0⟩))
    · refine ⟨a ^ (n - 1), Subtype.ext ?_⟩
      change (a : Module.End K V) * (a : Module.End K V) ^ (n - 1) = 1
      rw [← pow_succ', Nat.sub_add_cancel hn, h1]

/-- The minimal nonzero idempotents of `R`. -/
def palfyMinIdem (R : Subalgebra K (Module.End K V)) : Set (Module.End K V) :=
  {e | e ∈ R ∧ IsIdempotentElem e ∧ e ≠ 0 ∧
    ∀ f ∈ R, IsIdempotentElem f → f * e = 0 ∨ f * e = e}

/-- Every nonzero idempotent lies above a minimal one. -/
theorem palfy_exists_minIdem [Finite V] {H : Subgroup (Module.End K V)ˣ}
    {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R) {f : Module.End K V} (hfR : f ∈ R)
    (hf : IsIdempotentElem f) (hf0 : f ≠ 0) : ∃ e ∈ palfyMinIdem R, e * f = e := by
  haveI : Module.Finite K V := Module.Finite.of_finite
  obtain ⟨g, ⟨hgR, hg, hg0, hgf⟩, hmin⟩ :=
    (measure (fun g : Module.End K V => Module.finrank K (LinearMap.range g))).wf.has_min
      {g | g ∈ R ∧ IsIdempotentElem g ∧ g ≠ 0 ∧ g * f = g} ⟨f, hfR, hf, hf0, hf.eq⟩
  refine ⟨g, ⟨hgR, hg, hg0, ?_⟩, hgf⟩
  intro f' hf'R hf'
  by_cases h0 : f' * g = 0
  · exact Or.inl h0
  right
  have hcomm : f' * g = g * f' := hR.comm f' hf'R g hgR
  have hmemT : f' * g ∈ {g | g ∈ R ∧ IsIdempotentElem g ∧ g ≠ 0 ∧ g * f = g} := by
    refine ⟨R.mul_mem hf'R hgR, ?_, h0, by rw [mul_assoc, hgf]⟩
    unfold IsIdempotentElem
    calc f' * g * (f' * g) = f' * (g * f') * g := by simp [mul_assoc]
      _ = f' * (f' * g) * g := by rw [hcomm]
      _ = f' * g := by rw [← mul_assoc, hf'.eq, mul_assoc, hg.eq]
  have hle : LinearMap.range (f' * g) ≤ LinearMap.range g := by
    rintro _ ⟨v, rfl⟩
    rw [hcomm]
    exact ⟨f' v, rfl⟩
  have hge := not_lt.mp (show ¬ (Module.finrank K (LinearMap.range (f' * g)) <
    Module.finrank K (LinearMap.range g)) from hmin _ hmemT)
  have heq := Submodule.eq_of_le_of_finrank_le hle hge
  ext v
  have : g v ∈ LinearMap.range (f' * g) := by rw [heq]; exact ⟨v, rfl⟩
  obtain ⟨w, hw⟩ := this
  change f' (g v) = g v
  rw [← hw]
  change f' ((f' * g) w) = (f' * g) w
  rw [← Module.End.mul_apply, ← mul_assoc, hf'.eq]

theorem palfy_minIdem_mul {H : Subgroup (Module.End K V)ˣ}
    {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R) {e e' : Module.End K V}
    (he : e ∈ palfyMinIdem R) (he' : e' ∈ palfyMinIdem R) (hne : e ≠ e') : e * e' = 0 := by
  have hc := hR.comm e he.1 e' he'.1
  rcases he'.2.2.2 e he.1 he.2.1 with h | h
  · exact h
  rcases he.2.2.2 e' he'.1 he'.2.1 with h' | h'
  · rw [hc]; exact h'
  · exact absurd (h'.symm.trans (hc.symm.trans h)) hne

theorem palfy_minIdem_finite [Finite V] (R : Subalgebra K (Module.End K V)) :
    (palfyMinIdem R).Finite := Set.toFinite _

/-- The minimal idempotents sum to `1`. -/
theorem palfy_minIdem_sum [Finite V] {H : Subgroup (Module.End K V)ˣ}
    {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R) :
    ∑ e ∈ (palfy_minIdem_finite R).toFinset, e = 1 := by
  classical
  set P := (palfy_minIdem_finite R).toFinset
  set σ := ∑ e ∈ P, e
  have hmul : ∀ e ∈ palfyMinIdem R, e * σ = e := by
    intro e he
    rw [Finset.mul_sum, Finset.sum_eq_single e]
    · exact he.2.1.eq
    · intro b hb hbe
      exact palfy_minIdem_mul hR he ((Set.Finite.mem_toFinset _).mp hb) (Ne.symm hbe)
    · intro h
      exact absurd ((Set.Finite.mem_toFinset _).mpr he) h
  have hσR : σ ∈ R := Subalgebra.sum_mem R (fun e he => ((Set.Finite.mem_toFinset _).mp he).1)
  have hσ : IsIdempotentElem σ := by
    unfold IsIdempotentElem
    conv_lhs => rw [show σ = ∑ e ∈ P, e from rfl, Finset.sum_mul]
    exact Finset.sum_congr rfl (fun e he => hmul e ((Set.Finite.mem_toFinset _).mp he))
  by_contra hne
  have hu0 : 1 - σ ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
  obtain ⟨e, he, heu⟩ := palfy_exists_minIdem hR (R.sub_mem R.one_mem hσR) hσ.one_sub hu0
  rw [mul_sub, mul_one, hmul e he, sub_self] at heu
  exact he.2.2.1 heu.symm

/-- A nontrivial idempotent gives at least two minimal idempotents. -/
theorem palfy_minIdem_two_le [Finite V] {H : Subgroup (Module.End K V)ˣ}
    {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R) {f : Module.End K V} (hfR : f ∈ R)
    (hf : IsIdempotentElem f) (hf0 : f ≠ 0) (hf1 : f ≠ 1) :
    2 ≤ (palfy_minIdem_finite R).toFinset.card := by
  classical
  obtain ⟨e1, he1, h1⟩ := palfy_exists_minIdem hR hfR hf hf0
  obtain ⟨e2, he2, h2⟩ := palfy_exists_minIdem hR (R.sub_mem R.one_mem hfR) hf.one_sub
    (sub_ne_zero.mpr (Ne.symm hf1))
  have hne : e1 ≠ e2 := by
    rintro rfl
    rw [mul_sub, mul_one, h1, sub_self] at h2
    exact he1.2.2.1 h2.symm
  have : ({e1, e2} : Finset _) ⊆ (palfy_minIdem_finite R).toFinset := by
    intro x hx
    rw [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact (Set.Finite.mem_toFinset _).mpr he1
    · exact (Set.Finite.mem_toFinset _).mpr he2
  have := Finset.card_le_card this
  rwa [Finset.card_pair hne] at this

/-- `H` permutes the minimal idempotents by conjugation. -/
theorem palfy_minIdem_conj {H : Subgroup (Module.End K V)ˣ}
    {R : Subalgebra K (Module.End K V)} (hR : PalfyAlg H R) {h : (Module.End K V)ˣ}
    (hh : h ∈ H) {e : Module.End K V} (he : e ∈ palfyMinIdem R) :
    (h : Module.End K V) * e * ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V) ∈
      palfyMinIdem R := by
  set u : Module.End K V := (h : Module.End K V)
  set u' : Module.End K V := ((h⁻¹ : (Module.End K V)ˣ) : Module.End K V)
  have h1 : u' * u = 1 := Units.inv_mul h
  have h2 : u * u' = 1 := Units.mul_inv h
  refine ⟨hR.norm h hh e he.1, ?_, ?_, ?_⟩
  · unfold IsIdempotentElem
    calc u * e * u' * (u * e * u') = u * (e * (u' * u) * e) * u' := by simp [mul_assoc]
      _ = u * e * u' := by rw [h1, mul_one, he.2.1.eq]
  · intro h0
    apply he.2.2.1
    calc e = u' * (u * e * u') * u := by
          simp only [← mul_assoc, h1, one_mul]; rw [mul_assoc, h1, mul_one]
      _ = 0 := by rw [h0, mul_zero, zero_mul]
  · intro f hfR hf
    have hf' : u' * f * u ∈ R := hR.norm' hh hfR
    have hfi : IsIdempotentElem (u' * f * u) := by
      unfold IsIdempotentElem
      calc u' * f * u * (u' * f * u) = u' * (f * (u * u') * f) * u := by simp [mul_assoc]
        _ = u' * f * u := by rw [h2, mul_one, hf.eq]
    have key : f * (u * e * u') = u * ((u' * f * u) * e) * u' := by
      calc f * (u * e * u') = (u * u') * f * (u * e * u') := by rw [h2, one_mul]
        _ = u * ((u' * f * u) * e) * u' := by simp [mul_assoc]
    rcases he.2.2.2 _ hf' hfi with h0 | h0
    · left; rw [key, h0, mul_zero, zero_mul]
    · right; rw [key, h0]

end GI.Proved
