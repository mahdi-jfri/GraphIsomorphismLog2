import Workspace.Impl.VsFAlgSpan
import Workspace.Proved.VsFMatPowMath
import Workspace.Proved.VStabLinKer
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Algebra.Field.ZMod

/-!
# The program's matrices span the algebra

`vsFAlgSpanL` (`Impl/VsFAlgSpan.lean`) keeps a list `Bm` of matrices and an echelon basis of
their flattened forms. We show that at the end the span of the matrices of `Bm` is the algebra
generated by the input matrices (`vsFAlgSpanL_span`).

The plan of the proof:
1. Flattening (`vsFAUnflat_flatten`): the linear map `vsFAUnflat` reads a vector of length `d²`
   as a matrix, and it sends a flattened matrix back to the matrix.
2. Echelon rows have distinct pivots below the vector length, so there are at most `d²` of them
   (`vsFA_ech_length`).
3. The invariant `VsFAInv` (echelon rows, their span is the span of the flattened `Bm`, and the
   matrices of `Bm` lie in the algebra) holds after each insertion (`vsFAInner_inv`).
4. After pass `i`, every product `Bm[k] g` with `k < i` lies in the span (`vsFAOuter_inv`).
5. Since `Bm` has at most `d²` matrices, `d²` passes reach all of them, so the span is closed
   under right multiplication by the generators. It contains `1`, so it holds the algebra.
-/

namespace GI.Proved

open GI.Impl

variable {p : ℕ}

/-! ### Flattening -/

theorem vsFA_flatten_length {d : ℕ} : ∀ {M : List (List ℕ)}, (∀ r ∈ M, r.length = d) →
    M.flatten.length = M.length * d
  | [], _ => by simp
  | r :: M, h => by
    rw [List.flatten_cons, List.length_append, h r (by simp),
      vsFA_flatten_length (fun r' hr' => h r' (by simp [hr'])), List.length_cons]
    ring

theorem vsFA_flatten_getD {d : ℕ} : ∀ {M : List (List ℕ)}, (∀ r ∈ M, r.length = d) →
    ∀ (i j : ℕ), j < d → M.flatten.getD (i * d + j) 0 = (M.getD i []).getD j 0
  | [], _, i, j, _ => by simp
  | r :: M, h, i, j, hj => by
    have hr := h r (by simp)
    rw [List.flatten_cons]
    cases i with
    | zero =>
      simp only [zero_mul, zero_add, List.getD_cons_zero]
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega),
        ← List.getD_eq_getElem?_getD]
    | succ i =>
      rw [List.getD_cons_succ, ← vsFA_flatten_getD (fun r' hr' => h r' (by simp [hr'])) i j hj,
        List.getD_eq_getElem?_getD, List.getElem?_append_right (by rw [hr, Nat.succ_mul]; omega),
        ← List.getD_eq_getElem?_getD, hr, Nat.succ_mul]
      congr 1
      omega

theorem vsFA_flatten_lt {M : List (List ℕ)} (h : ∀ r ∈ M, ∀ y ∈ r, y < p) :
    ∀ y ∈ M.flatten, y < p := by
  intro y hy
  obtain ⟨r, hr, hyr⟩ := List.mem_flatten.mp hy
  exact h r hr y hyr

/-- A vector of length `d²`, read as a `d × d` matrix. -/
def vsFAUnflat (p d : ℕ) : (ℕ → ZMod p) →ₗ[ZMod p] Matrix (Fin d) (Fin d) (ZMod p) where
  toFun f := fun i j => f (i * d + j)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem vsFAUnflat_flatten {d : ℕ} {M : List (List ℕ)} (hM : VsFSq p d M) :
    vsFAUnflat p d (vsF p M.flatten) = vsFMatrix p d M := by
  ext i j
  change vsF p M.flatten (i * d + j) = vsF p (M.getD i []) j
  rw [vsF_apply, vsF_apply, vsFA_flatten_getD (fun r hr => (hM.rows r hr).2) i j j.2]

/-! ### Echelon rows are few -/

theorem vsFA_ech_one : ∀ {rows : List VsRow}, VsEch p rows → ∀ r ∈ rows, vsF p r.x r.j = 1
  | [], _, r, hr => by simp at hr
  | r :: rs, ⟨h1, _, h3⟩, r', hr' => by
    rcases List.mem_cons.mp hr' with rfl | hr'
    · exact h1
    · exact vsFA_ech_one h3 r' hr'

theorem vsFA_ech_pivots (hp : p.Prime) : ∀ {rows : List VsRow}, VsEch p rows →
    (rows.map VsRow.j).Nodup
  | [], _ => List.nodup_nil
  | r :: rs, ⟨_, h2, h3⟩ => by
    haveI := Fact.mk hp
    rw [List.map_cons, List.nodup_cons]
    refine ⟨fun hm => ?_, vsFA_ech_pivots hp h3⟩
    obtain ⟨r', hr', hj⟩ := List.mem_map.mp hm
    have h0 := h2 r' hr'
    rw [← hj, vsFA_ech_one h3 r' hr'] at h0
    exact one_ne_zero h0

/-- **Echelon rows are few.** Echelon rows of vectors of length `lx` number at most `lx`, since
their pivots are distinct and below `lx`. -/
theorem vsFA_ech_length (hp : p.Prime) {rows : List VsRow} {lx : ℕ} (he : VsEch p rows)
    (hl : ∀ r ∈ rows, r.x.length = lx) : rows.length ≤ lx := by
  classical
  haveI := Fact.mk hp
  have hsub : (rows.map VsRow.j).toFinset ⊆ Finset.range lx := by
    intro j hj
    rw [List.mem_toFinset] at hj
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hj
    rw [Finset.mem_range]
    by_contra hge
    have h1 := vsFA_ech_one he r hr
    rw [vsF_apply, List.getD_eq_default _ _ (by rw [hl r hr]; omega)] at h1
    simp at h1
  have := Finset.card_le_card hsub
  rwa [List.toFinset_card_of_nodup (vsFA_ech_pivots hp he), List.length_map,
    Finset.card_range] at this

/-! ### The invariant -/

/-- The span of the flattened matrices. -/
def vsFASpan (p : ℕ) (Bm : List (List (List ℕ))) : Submodule (ZMod p) (ℕ → ZMod p) :=
  Submodule.span (ZMod p) {v | v ∈ Bm.map fun M => vsF p M.flatten}

theorem vsFASpan_append (Bm : List (List (List ℕ))) (M : List (List ℕ)) :
    vsFASpan p (Bm ++ [M]) = vsFASpan p Bm ⊔ Submodule.span (ZMod p) {vsF p M.flatten} := by
  unfold vsFASpan
  rw [← Submodule.span_union]
  congr 1
  ext v
  simp [eq_comm, or_comm]

theorem vsFASpan_mono (Bm T : List (List (List ℕ))) : vsFASpan p Bm ≤ vsFASpan p (Bm ++ T) :=
  Submodule.span_mono fun v hv => by simp only [Set.mem_setOf_eq] at hv ⊢; simp [hv]

/-- The invariant: echelon rows of length `d²` with empty tags, one row for each matrix, the
rows span the flattened matrices, and the matrices are `d × d` and lie in `A`. -/
structure VsFAInv (p d : ℕ) (A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p)))
    (st : (List VsRow × List (List ℕ)) × List (List (List ℕ))) : Prop where
  ech : VsEch p st.1.1
  len : ∀ r ∈ st.1.1, r.x.length = d * d ∧ r.t.length = 0
  nb : st.1.1.length = st.2.length
  span : vsSpan p st.1.1 = vsFASpan p st.2
  sq : ∀ M ∈ st.2, VsFSq p d M
  mem : ∀ M ∈ st.2, vsFMatrix p d M ∈ A

theorem VsFAInv.mono {d : ℕ} {A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p))}
    {st st' : (List VsRow × List (List ℕ)) × List (List (List ℕ))} (hI : VsFAInv p d A st)
    (hI' : VsFAInv p d A st') {T : List (List (List ℕ))} (hT : st'.2 = st.2 ++ T) :
    vsSpan p st.1.1 ≤ vsSpan p st'.1.1 := by
  rw [hI.span, hI'.span, hT]
  exact vsFASpan_mono _ _

theorem vsFAInv_nil {d : ℕ} (A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p))) :
    VsFAInv p d A (([], []), []) :=
  ⟨trivial, by simp, rfl, by simp [vsSpan, vsFASpan], by simp, by simp⟩

/-- A zero start vector of length `d`. -/
structure VsFZero (p d : ℕ) (z : List ℕ) : Prop where
  lt : ∀ y ∈ z, y < p
  len : z.length = d
  zero : vsF p z = 0

/-- **One insertion.** The invariant is kept, the matrices grow by appending, and the
flattened product lies in the new span. -/
theorem vsFAInner_inv (hp : p.Prime) {d : ℕ}
    {A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p))}
    {st : (List VsRow × List (List ℕ)) × List (List (List ℕ))} (hI : VsFAInv p d A st)
    {z : List ℕ} (hz : VsFZero p d z) {M g : List (List ℕ)} (hM : VsFSq p d M)
    (hMA : vsFMatrix p d M ∈ A) (hg : VsFSq p d g) (hgA : vsFMatrix p d g ∈ A) :
    VsFAInv p d A (vsFAInner p z M st g) ∧
    (∃ T, (vsFAInner p z M st g).2 = st.2 ++ T) ∧
    vsF p (vsFMatMulL p M g z).flatten ∈ vsSpan p (vsFAInner p z M st g).1.1 := by
  have hp0 := hp.pos
  have hMg := vsFMatMulL_sq hp0 hM hz.lt hz.len (X := g)
  have hMgA : vsFMatrix p d (vsFMatMulL p M g z) ∈ A := by
    rw [vsFMatMulL_matrix hM.len hg hz.len hz.zero]
    exact A.mul_mem hMA hgA
  set Mg := vsFMatMulL p M g z with hMgdef
  have hfl : Mg.flatten.length = d * d := by
    rw [vsFA_flatten_length (fun r hr => (hMg.rows r hr).2), hMg.len]
  have hb : VsBelow p (Mg.flatten, []) := vsFA_flatten_lt fun r hr => (hMg.rows r hr).1
  have hs : VsShort (Mg.flatten, []) st.1.1 := fun r hr => by
    rw [(hI.len r hr).1, (hI.len r hr).2, hfl]; exact ⟨le_rfl, le_rfl⟩
  obtain ⟨e1, e2⟩ := vsSift_length p st.1.1 (Mg.flatten, [])
  by_cases hk : vsNzIdx (vsSift p st.1.1 (Mg.flatten, [])).1 <
      (vsSift p st.1.1 (Mg.flatten, [])).1.length
  · obtain ⟨hech, hsp, -⟩ := vsInsert_new hp hI.ech hb hs hk
    have ea : vsAllStep p st.1 (Mg.flatten, []) = (st.1.1 ++ [vsNewRow p
        (vsSift p st.1.1 (Mg.flatten, [])) (vsNzIdx (vsSift p st.1.1 (Mg.flatten, [])).1)],
        st.1.2) := by
      rw [vsAllStep, if_pos hk]
    have eS : vsFAInner p z M st g = ((st.1.1 ++ [vsNewRow p
        (vsSift p st.1.1 (Mg.flatten, [])) (vsNzIdx (vsSift p st.1.1 (Mg.flatten, [])).1)],
        st.1.2), st.2 ++ [Mg]) := by
      rw [vsFAInner, ← hMgdef, ea, vsFAUpd, if_pos (by simp)]
    rw [eS]
    refine ⟨⟨hech, fun r hr => ?_, by simp [hI.nb], ?_, fun M' hM' => ?_, fun M' hM' => ?_⟩,
      ⟨[Mg], rfl⟩, ?_⟩
    · simp only [List.mem_append, List.mem_singleton] at hr
      rcases hr with hr | rfl
      · exact hI.len r hr
      · simp only [vsNewRow, vsLin_length]
        exact ⟨e1.trans hfl, e2⟩
    · dsimp only
      rw [hsp, hI.span, vsFASpan_append]
    · simp only [List.mem_append, List.mem_singleton] at hM'
      rcases hM' with hM' | rfl
      · exact hI.sq M' hM'
      · exact hMg
    · simp only [List.mem_append, List.mem_singleton] at hM'
      rcases hM' with hM' | rfl
      · exact hI.mem M' hM'
      · exact hMgA
    · dsimp only
      rw [hsp]
      exact Submodule.mem_sup_right (Submodule.subset_span rfl)
  · obtain ⟨hmem, -⟩ := vsInsert_rel hp0 hI.ech hb hs hk
    have ea : vsAllStep p st.1 (Mg.flatten, []) =
        (st.1.1, st.1.2 ++ [(vsSift p st.1.1 (Mg.flatten, [])).2]) := by
      rw [vsAllStep, if_neg hk]
    have eS : vsFAInner p z M st g =
        ((st.1.1, st.1.2 ++ [(vsSift p st.1.1 (Mg.flatten, [])).2]), st.2) := by
      rw [vsFAInner, ← hMgdef, ea, vsFAUpd, if_neg (lt_irrefl _)]
    rw [eS]
    exact ⟨⟨hI.ech, hI.len, hI.nb, hI.span, hI.sq, hI.mem⟩, ⟨[], by simp⟩, hmem⟩

/-- **A pass over the generators.** -/
theorem vsFAFold_inv (hp : p.Prime) {d : ℕ}
    {A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p))} {z : List ℕ} (hz : VsFZero p d z)
    {M : List (List ℕ)} (hM : VsFSq p d M) (hMA : vsFMatrix p d M ∈ A) :
    ∀ (gs : List (List (List ℕ))) (st : (List VsRow × List (List ℕ)) × List (List (List ℕ))),
    VsFAInv p d A st → (∀ g ∈ gs, VsFSq p d g ∧ vsFMatrix p d g ∈ A) →
    VsFAInv p d A (gs.foldl (vsFAInner p z M) st) ∧
    (∃ T, (gs.foldl (vsFAInner p z M) st).2 = st.2 ++ T) ∧
    ∀ g ∈ gs, vsF p (vsFMatMulL p M g z).flatten ∈ vsSpan p (gs.foldl (vsFAInner p z M) st).1.1
  | [], st, hI, _ => ⟨hI, ⟨[], by simp⟩, by simp⟩
  | g :: gs, st, hI, hgs => by
    obtain ⟨hg, hgA⟩ := hgs g (by simp)
    obtain ⟨hI1, ⟨T1, hT1⟩, hm1⟩ := vsFAInner_inv hp hI hz hM hMA hg hgA
    obtain ⟨hI2, ⟨T2, hT2⟩, hm2⟩ :=
      vsFAFold_inv hp hz hM hMA gs _ hI1 fun g' hg' => hgs g' (by simp [hg'])
    rw [List.foldl_cons]
    refine ⟨hI2, ⟨T1 ++ T2, by rw [hT2, hT1, List.append_assoc]⟩, fun g' hg' => ?_⟩
    rcases List.mem_cons.mp hg' with rfl | hg'
    · exact hI1.mono hI2 hT2 hm1
    · exact hm2 g' hg'

/-- Every product `Bm[k] g` with `k < i` lies in the span. -/
def VsFAClo (p : ℕ) (z : List ℕ) (gs : List (List (List ℕ))) (i : ℕ)
    (st : (List VsRow × List (List ℕ)) × List (List (List ℕ))) : Prop :=
  ∀ k < i, k < st.2.length → ∀ g ∈ gs,
    vsF p (vsFMatMulL p (st.2.getD k []) g z).flatten ∈ vsSpan p st.1.1

theorem vsFA_getD_append {α : Type*} (l T : List α) (d : α) {k : ℕ} (hk : k < l.length) :
    (l ++ T).getD k d = l.getD k d := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_append_left hk, ← List.getD_eq_getElem?_getD]

/-- **One pass.** -/
theorem vsFAOuter_inv (hp : p.Prime) {d : ℕ}
    {A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p))} {z : List ℕ} (hz : VsFZero p d z)
    {gs : List (List (List ℕ))} (hgs : ∀ g ∈ gs, VsFSq p d g ∧ vsFMatrix p d g ∈ A) {i : ℕ}
    {st : (List VsRow × List (List ℕ)) × List (List (List ℕ))} (hI : VsFAInv p d A st)
    (hC : VsFAClo p z gs i st) :
    VsFAInv p d A (vsFAOuter p z gs st i) ∧ (∃ T, (vsFAOuter p z gs st i).2 = st.2 ++ T) ∧
    VsFAClo p z gs (i + 1) (vsFAOuter p z gs st i) := by
  unfold vsFAOuter
  split_ifs with hi
  · have hMm : st.2.getD i [] ∈ st.2 := by
      rw [List.getD_eq_getElem _ _ hi]; exact List.getElem_mem hi
    obtain ⟨hI', ⟨T, hT⟩, hm⟩ := vsFAFold_inv hp hz (hI.sq _ hMm) (hI.mem _ hMm) gs st hI hgs
    refine ⟨hI', ⟨T, hT⟩, fun k hk hkl g hg => ?_⟩
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | rfl
    · rw [hT, vsFA_getD_append _ _ _ (hk.trans hi)]
      exact hI.mono hI' hT (hC k hk (hk.trans hi) g hg)
    · rw [hT, vsFA_getD_append _ _ _ hi]
      exact hm g hg
  · refine ⟨hI, ⟨[], by simp⟩, fun k hk hkl g hg => hC k (by omega) hkl g hg⟩

/-- The state after `i` passes. -/
theorem vsFAPasses_inv (hp : p.Prime) {d : ℕ}
    {A : Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p))} {z : List ℕ} (hz : VsFZero p d z)
    {gs : List (List (List ℕ))} (hgs : ∀ g ∈ gs, VsFSq p d g ∧ vsFMatrix p d g ∈ A)
    {st : (List VsRow × List (List ℕ)) × List (List (List ℕ))} (hI : VsFAInv p d A st) :
    ∀ i, VsFAInv p d A ((List.range i).foldl (vsFAOuter p z gs) st) ∧
      (∃ T, ((List.range i).foldl (vsFAOuter p z gs) st).2 = st.2 ++ T) ∧
      VsFAClo p z gs i ((List.range i).foldl (vsFAOuter p z gs) st)
  | 0 => ⟨hI, ⟨[], by simp⟩, fun k hk => absurd hk (Nat.not_lt_zero k)⟩
  | i + 1 => by
    obtain ⟨hI1, ⟨T1, hT1⟩, hC1⟩ := vsFAPasses_inv hp hz hgs hI i
    obtain ⟨hI2, ⟨T2, hT2⟩, hC2⟩ := vsFAOuter_inv hp hz hgs hI1 hC1
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]
    exact ⟨hI2, ⟨T1 ++ T2, by rw [hT2, hT1, List.append_assoc]⟩, hC2⟩

/-! ### The span is the algebra -/

/-- The algebra generated by the matrices of a list. -/
def vsFAlgOf (p d : ℕ) (gs : List (List (List ℕ))) :
    Subalgebra (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p)) :=
  Algebra.adjoin (ZMod p) {X | ∃ g ∈ gs, vsFMatrix p d g = X}

/-- The span of the matrices of a list. -/
def vsFMatSpan (p d : ℕ) (Bm : List (List (List ℕ))) :
    Submodule (ZMod p) (Matrix (Fin d) (Fin d) (ZMod p)) :=
  Submodule.span (ZMod p) {X | ∃ M ∈ Bm, vsFMatrix p d M = X}

theorem vsFASpan_le {d : ℕ} {Bm : List (List (List ℕ))} (h : ∀ M ∈ Bm, VsFSq p d M) :
    vsFASpan p Bm ≤ (vsFMatSpan p d Bm).comap (vsFAUnflat p d) := by
  refine Submodule.span_le.mpr fun v hv => ?_
  simp only [Set.mem_setOf_eq, List.mem_map] at hv
  obtain ⟨M, hM, rfl⟩ := hv
  simp only [SetLike.mem_coe, Submodule.mem_comap]
  rw [vsFAUnflat_flatten (h M hM)]
  exact Submodule.subset_span ⟨M, hM, rfl⟩

/-- **The span of the matrices is the algebra.** If `I` is the identity, `z` a zero vector
and the generators are `d × d`, then the matrices found by `vsFAlgSpanL` with `d²` passes lie
in the generated algebra and span it. The invariant `VsFAInv` also holds at the end. -/
theorem vsFAlgSpanL_span (hp : p.Prime) {d : ℕ} {z : List ℕ} (hz : VsFZero p d z)
    {I : List (List ℕ)} (hI : VsFSq p d I) (hI1 : vsFMatrix p d I = 1)
    {gs : List (List (List ℕ))} (hgs : ∀ g ∈ gs, VsFSq p d g) :
    VsFAInv p d (vsFAlgOf p d gs) (vsFAlgSpanL p z I gs (d * d)) ∧
    vsFMatSpan p d (vsFAlgSpanL p z I gs (d * d)).2 =
      Subalgebra.toSubmodule (vsFAlgOf p d gs) := by
  set A := vsFAlgOf p d gs
  have hgs' : ∀ g ∈ gs, VsFSq p d g ∧ vsFMatrix p d g ∈ A := fun g hg =>
    ⟨hgs g hg, Algebra.subset_adjoin ⟨g, hg, rfl⟩⟩
  have hIA : vsFMatrix p d I ∈ A := by rw [hI1]; exact A.one_mem
  obtain ⟨hI0, -, hm0⟩ := vsFAInner_inv hp (vsFAInv_nil A) hz hI hIA hI hIA
  obtain ⟨hIf, ⟨T, hT⟩, hC⟩ := vsFAPasses_inv hp hz hgs' hI0 (d * d)
  set st := vsFAlgSpanL p z I gs (d * d) with hst
  have hst' : st = (List.range (d * d)).foldl (vsFAOuter p z gs)
      (vsFAInner p z I (([], []), []) I) := rfl
  rw [← hst'] at hIf hT hC
  refine ⟨hIf, ?_⟩
  set S := vsFMatSpan p d st.2
  have hle := vsFASpan_le hIf.sq
  rw [← hIf.span] at hle
  have hlen : st.2.length ≤ d * d := by
    rw [← hIf.nb]; exact vsFA_ech_length hp hIf.ech fun r hr => (hIf.len r hr).1
  -- products of basis matrices with generators
  have hgen : ∀ M ∈ st.2, ∀ g ∈ gs, vsFMatrix p d M * vsFMatrix p d g ∈ S := by
    intro M hM g hg
    obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hM
    have h1 := hle (hC k (by omega) hk g hg)
    rw [List.getD_eq_getElem _ _ hk, Submodule.mem_comap,
      vsFAUnflat_flatten (vsFMatMulL_sq hp.pos (hIf.sq _ hM) hz.lt hz.len),
      vsFMatMulL_matrix (hIf.sq _ hM).len (hgs g hg) hz.len hz.zero] at h1
    exact h1
  have hright : ∀ g ∈ gs, ∀ x ∈ S, x * vsFMatrix p d g ∈ S := by
    intro g hg x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨M, hM, rfl⟩ := hx
      exact hgen M hM g hg
    | zero => rw [zero_mul]; exact S.zero_mem
    | add x y _ _ hx hy => rw [add_mul]; exact S.add_mem hx hy
    | smul a x _ hx => rw [smul_mul_assoc]; exact S.smul_mem a hx
  have h1 : (1 : Matrix (Fin d) (Fin d) (ZMod p)) ∈ S := by
    have := hle (hI0.mono hIf hT hm0)
    rw [Submodule.mem_comap, vsFAUnflat_flatten (vsFMatMulL_sq hp.pos hI hz.lt hz.len),
      vsFMatMulL_matrix hI.len hI hz.len hz.zero, hI1, one_mul] at this
    exact this
  have hall : ∀ a ∈ A, ∀ x ∈ S, x * a ∈ S := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem X hX =>
      obtain ⟨g, hg, rfl⟩ := hX
      exact hright g hg
    | algebraMap r =>
      intro x hx
      rw [← Algebra.commutes, ← Algebra.smul_def]
      exact S.smul_mem r hx
    | add a b _ _ ha hb => intro x hx; rw [mul_add]; exact S.add_mem (ha x hx) (hb x hx)
    | mul a b _ _ ha hb => intro x hx; rw [← mul_assoc]; exact hb _ (ha x hx)
  apply le_antisymm
  · refine Submodule.span_le.mpr fun X hX => ?_
    obtain ⟨M, hM, rfl⟩ := hX
    exact hIf.mem M hM
  · intro a ha
    have := hall a ha 1 h1
    rwa [one_mul] at this

end GI.Proved
