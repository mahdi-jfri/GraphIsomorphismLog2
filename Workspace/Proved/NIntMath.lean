import Workspace.Impl.LinSlp
import Workspace.Impl.DomMath

/-!
# The group `K` of a normalized pair

Let `G` normalize `N`, both subgroups of `Sym(n)`. Following [LM] (Luks–Miyazaki, DMTCS 13:4
(2011), Theorem 3.1(viii)(b),(c); Luks 1993, Prop. 7.1), we use the group
`K = {(g, g m) : g ∈ G, m ∈ N}`, written here as the subgroup `nintPairs G N` of
`Sym(n) × Sym(n)` of the pairs `(a, b)` with `a ∈ G` and `a⁻¹ b ∈ N`.

* `nint_normalizer`: if every generator of `G` conjugates `N` into `N`, then `G` lies in the
  normalizer of `N`. The inverse inclusion holds because the groups are finite.
* `nintPairs`: `K` is a subgroup, because `G` normalizes `N`.
* `nint_closure_pairs`: `K` is generated by the `(g, g)` for `g` in a generating list of `G`
  and the `(1, m)` for `m` in a generating list of `N`.
* `nint_factor`: **factorization**. A straight-line program that reaches `x` from the list
  `gs ++ ns`, evaluated with each entry of `ns` replaced by `1`, gives `y ∈ G` with
  `y⁻¹ x ∈ N`. (Evaluate the program in `K`: its value is `(y, x)`.)
* `nint_inter`: **intersection**. On `Fin (n + n)`, `K` acts by `(a, b) ↦ a ⊕ b`. The pointwise
  stabilizer of the second copy is the image of the pairs `(a, 1)` of `K`, and the first
  coordinates of these pairs are exactly `G ∩ N`.
-/

namespace GI.Proved

open GI.Cited GI.Impl Equiv

variable {n : ℕ}

/-! ### Normalizing -/

/-- **Generators that conjugate `N` into `N` normalize it.** Conjugation by `g` is injective,
so it maps the finite group `N` onto a subgroup of the same order inside `N`, hence onto `N`. -/
theorem nint_mem_normalizer {N : Subgroup (Perm (Fin n))} {g : Perm (Fin n)}
    (h : ∀ x ∈ N, g * x * g⁻¹ ∈ N) : g ∈ Subgroup.normalizer (N : Set (Perm (Fin n))) := by
  have hle : N.map (MulAut.conj g).toMonoidHom ≤ N := by
    rintro _ ⟨x, hx, rfl⟩
    exact h x hx
  have hcard : Nat.card (N.map (MulAut.conj g).toMonoidHom) = Nat.card N :=
    Subgroup.card_map_of_injective (MulEquiv.injective _)
  have heq : N.map (MulAut.conj g).toMonoidHom = N :=
    Subgroup.eq_of_le_of_card_ge hle hcard.ge
  refine Subgroup.mem_normalizer_iff.mpr fun x => ⟨h x, fun hx => ?_⟩
  rw [← heq] at hx
  obtain ⟨y, hy, hxy⟩ := hx
  have : y = x := by
    simpa using hxy
  exact this ▸ hy

/-- The group generated by `gs` normalizes `N` when each generator does. -/
theorem nint_normalizer {gs : List (Perm (Fin n))} {N : Subgroup (Perm (Fin n))}
    (h : ∀ g ∈ gs, ∀ x ∈ N, g * x * g⁻¹ ∈ N) : gens gs ≤ Subgroup.normalizer (N : Set (Perm (Fin n))) :=
  (Subgroup.closure_le _).mpr fun g hg => nint_mem_normalizer (h g hg)

/-! ### The group `K` -/

/-- **The group `K`**: the pairs `(a, b)` with `a ∈ G` and `a⁻¹ b ∈ N`, that is, `(g, g m)`
with `g ∈ G` and `m ∈ N`. It is a group because `G` normalizes `N` (`hn`). -/
def nintPairs (G N : Subgroup (Perm (Fin n))) (hn : G ≤ Subgroup.normalizer (N : Set (Perm (Fin n)))) :
    Subgroup (Perm (Fin n) × Perm (Fin n)) where
  carrier := {p | p.1 ∈ G ∧ p.1⁻¹ * p.2 ∈ N}
  one_mem' := ⟨G.one_mem, by simp [N.one_mem]⟩
  mul_mem' := by
    rintro ⟨a, b⟩ ⟨c, d⟩ ⟨ha, hab⟩ ⟨hc, hcd⟩
    refine ⟨G.mul_mem ha hc, ?_⟩
    -- `(a c)⁻¹ (b d) = c⁻¹ (a⁻¹ b) c · c⁻¹ d`, and `c⁻¹` normalizes `N`.
    have h1 : c⁻¹ * (a⁻¹ * b) * c⁻¹⁻¹ ∈ N :=
      (Subgroup.mem_normalizer_iff.mp (hn (G.inv_mem hc)) _).mp hab
    have e : (a * c)⁻¹ * (b * d) = c⁻¹ * (a⁻¹ * b) * c⁻¹⁻¹ * (c⁻¹ * d) := by group
    simpa only [Prod.fst_mul, Prod.snd_mul, e] using N.mul_mem h1 hcd
  inv_mem' := by
    rintro ⟨a, b⟩ ⟨ha, hab⟩
    refine ⟨G.inv_mem ha, ?_⟩
    -- `a b⁻¹ = a (a⁻¹ b)⁻¹ a⁻¹`, and `a` normalizes `N`.
    have h1 : a * (a⁻¹ * b)⁻¹ * a⁻¹ ∈ N :=
      (Subgroup.mem_normalizer_iff.mp (hn ha) _).mp (N.inv_mem hab)
    have e : a⁻¹⁻¹ * b⁻¹ = a * (a⁻¹ * b)⁻¹ * a⁻¹ := by group
    simpa only [Prod.fst_inv, Prod.snd_inv, e] using h1

theorem mem_nintPairs {G N : Subgroup (Perm (Fin n))} {hn : G ≤ Subgroup.normalizer (N : Set (Perm (Fin n)))}
    {p : Perm (Fin n) × Perm (Fin n)} : p ∈ nintPairs G N hn ↔ p.1 ∈ G ∧ p.1⁻¹ * p.2 ∈ N :=
  Iff.rfl

/-- The diagonal `a ↦ (a, a)`. -/
def nintDiag : Perm (Fin n) →* Perm (Fin n) × Perm (Fin n) :=
  (MonoidHom.id _).prod (MonoidHom.id _)

/-- The generators of `K`: the `(g, g)` and the `(1, m)`. -/
def nintPairGens (gs ns : List (Perm (Fin n))) : List (Perm (Fin n) × Perm (Fin n)) :=
  gs.map nintDiag ++ ns.map (MonoidHom.inr _ _)

/-- **`K` is generated by the `(g, g)` and the `(1, m)`.** -/
theorem nint_closure_pairs {gs ns : List (Perm (Fin n))} (hn : gens gs ≤ Subgroup.normalizer (gens ns : Set (Perm (Fin n)))) :
    Subgroup.closure {p | p ∈ nintPairGens gs ns} = nintPairs (gens gs) (gens ns) hn := by
  apply le_antisymm
  · -- Each generator lies in `K`.
    refine (Subgroup.closure_le _).mpr fun p hp => ?_
    rcases List.mem_append.mp hp with hp | hp
    · obtain ⟨g, hg, rfl⟩ := List.mem_map.mp hp
      exact ⟨Subgroup.subset_closure hg, by simp [nintDiag]⟩
    · obtain ⟨m, hm, rfl⟩ := List.mem_map.mp hp
      exact ⟨Subgroup.one_mem _, by
        simpa using (Subgroup.subset_closure (show m ∈ {g | g ∈ ns} from hm) : m ∈ gens ns)⟩
  · -- `(a, b) = (a, a) (1, a⁻¹ b)`, and both factors lie in the closure: the image of
    -- `gens gs` under the diagonal, and of `gens ns` under `inr`, are generated by the images.
    rintro ⟨a, b⟩ ⟨ha, hab⟩
    have hd : nintDiag a ∈ Subgroup.closure {p | p ∈ nintPairGens gs ns} := by
      have : (gens gs).map nintDiag ≤ Subgroup.closure {p | p ∈ nintPairGens gs ns} := by
        rw [gens, MonoidHom.map_closure]
        refine Subgroup.closure_mono ?_
        rintro _ ⟨g, hg, rfl⟩
        exact List.mem_append_left _ (List.mem_map_of_mem hg)
      exact this ⟨a, ha, rfl⟩
    have hr : MonoidHom.inr _ _ (a⁻¹ * b) ∈ Subgroup.closure {p | p ∈ nintPairGens gs ns} := by
      have : (gens ns).map (MonoidHom.inr (Perm (Fin n)) (Perm (Fin n))) ≤
          Subgroup.closure {p | p ∈ nintPairGens gs ns} := by
        rw [gens, MonoidHom.map_closure]
        refine Subgroup.closure_mono ?_
        rintro _ ⟨m, hm, rfl⟩
        exact List.mem_append_right _ (List.mem_map_of_mem hm)
      exact this ⟨_, hab, rfl⟩
    have e : ((a, b) : Perm (Fin n) × Perm (Fin n)) = nintDiag a * MonoidHom.inr _ _ (a⁻¹ * b) := by
      ext1 <;> simp [nintDiag]
    rw [e]
    exact Subgroup.mul_mem _ hd hr

/-! ### Factorization -/

/-- The list `gs ++ ns` with each entry of `ns` replaced by `1`. -/
def nintLeft (gs ns : List (Perm (Fin n))) : List (Perm (Fin n)) :=
  gs ++ ns.map fun _ => 1

theorem nintPairGens_fst (gs ns : List (Perm (Fin n))) :
    (nintPairGens gs ns).map (MonoidHom.fst _ _) = nintLeft gs ns := by
  simp [nintPairGens, nintLeft, nintDiag, Function.comp_def]

theorem nintPairGens_snd (gs ns : List (Perm (Fin n))) :
    (nintPairGens gs ns).map (MonoidHom.snd _ _) = gs ++ ns := by
  simp [nintPairGens, nintDiag, Function.comp_def]

/-- **Factorization.** Let `G = ⟨gs⟩` normalize `N = ⟨ns⟩`, and let `prog` reach `x` from
`gs ++ ns`. Then `prog` evaluated on `nintLeft gs ns` has some value `y`, with `y ∈ G` and
`y⁻¹ x ∈ N`. -/
theorem nint_factor {gs ns : List (Perm (Fin n))} (hn : gens gs ≤ Subgroup.normalizer (gens ns : Set (Perm (Fin n))))
    {prog : List SlpInstr} {x : Perm (Fin n)} (hx : SlpReaches (gs ++ ns) prog x) :
    ∃ y, linSlpValue (nintLeft gs ns) prog = some y ∧ y ∈ gens gs ∧ y⁻¹ * x ∈ gens ns := by
  set K := nintPairs (gens gs) (gens ns) hn
  have hk : ∀ p ∈ nintPairGens gs ns, p ∈ K := fun p hp => by
    have h1 : p ∈ Subgroup.closure {p | p ∈ nintPairGens gs ns} := Subgroup.subset_closure hp
    rwa [nint_closure_pairs hn] at h1
  set ks := linSubgroupGenerators K (nintPairGens gs ns) hk
  -- The value in `K`, read through the second coordinate, is `x`.
  have hsnd : ks.map ((MonoidHom.snd _ _).comp K.subtype) = gs ++ ns := by
    rw [MonoidHom.coe_comp, ← List.map_map, linSubgroupGenerators_map, nintPairGens_snd]
  have hfst : ks.map ((MonoidHom.fst _ _).comp K.subtype) = nintLeft gs ns := by
    rw [MonoidHom.coe_comp, ← List.map_map, linSubgroupGenerators_map, nintPairGens_fst]
  have hv : linSlpValue (gs ++ ns) prog = some x := by
    obtain ⟨es, he, hx⟩ := hx
    simp only [linSlpValue, linSlpEntries_perm, he, Option.map_some, hx]
  rw [← hsnd, linSlpValue_map] at hv
  obtain ⟨z, hz, hzx⟩ := Option.map_eq_some_iff.mp hv
  refine ⟨(z : Perm (Fin n) × Perm (Fin n)).1, ?_, z.2.1, ?_⟩
  · rw [← hfst, linSlpValue_map, hz]; rfl
  · have := z.2.2
    simp only [MonoidHom.coe_comp, Subgroup.coe_subtype, Function.comp_apply,
      MonoidHom.coe_snd] at hzx
    rwa [hzx] at this

/-! ### Intersection -/

/-- `(a, b) ↦ a ⊕ b` on `Fin (n + n)`. -/
def nintSum : Perm (Fin n) × Perm (Fin n) →* Perm (Fin (n + n)) :=
  finSumFinEquiv.permCongrHom.toMonoidHom.comp (Perm.sumCongrHom (Fin n) (Fin n))

theorem nintSum_apply (p : Perm (Fin n) × Perm (Fin n)) :
    nintSum p = sumToFin (Perm.sumCongr p.1 p.2) := rfl

theorem nintSum_injective : Function.Injective (nintSum (n := n)) := by
  intro p q h
  simp only [nintSum, MonoidHom.coe_comp, Function.comp_apply] at h
  have h' := (MulEquiv.injective _) h
  exact Prod.ext (GI.Impl.sumCongr_inj h').1 (GI.Impl.sumCongr_inj h').2

/-- The points `n, …, 2n - 1` of `Fin (n + n)`: the second copy. -/
def nintPts (n : ℕ) : List (Fin (n + n)) := (List.finRange n).map (Fin.natAdd n)

/-- `a ⊕ b` fixes the second copy exactly when `b = 1`. -/
theorem nintSum_fix_iff (p : Perm (Fin n) × Perm (Fin n)) :
    (∀ i ∈ nintPts n, nintSum p i = i) ↔ p.2 = 1 := by
  constructor
  · intro h
    ext j
    have := congrArg Fin.val (h (Fin.natAdd n j) (List.mem_map_of_mem (List.mem_finRange j)))
    rw [nintSum_apply, sumToFin_sumCongr_natAdd] at this
    simp only [Fin.val_natAdd] at this
    simp only [Perm.coe_one, id_eq]
    omega
  · intro h i hi
    obtain ⟨j, -, rfl⟩ := List.mem_map.mp hi
    apply Fin.ext
    rw [nintSum_apply, sumToFin_sumCongr_natAdd, h]
    simp only [Perm.coe_one, id_eq, Fin.val_natAdd]

/-- A list whose entries lie in the range of a map is the image of a list. -/
theorem nint_list_lift {α β : Type*} (f : α → β) (l : List β) (h : ∀ b ∈ l, ∃ a, f a = b) :
    ∃ l' : List α, l'.map f = l := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons b l ih =>
    obtain ⟨a, ha⟩ := h b (List.mem_cons_self ..)
    obtain ⟨l', hl'⟩ := ih fun b hb => h b (List.mem_cons_of_mem _ hb)
    exact ⟨a :: l', by simp [ha, hl']⟩

/-- **Intersection.** Let `G = ⟨gs⟩` normalize `N = ⟨ns⟩`, and let `hs` generate the pointwise
stabilizer of the second copy in the group generated by the `g ⊕ g` (`g ∈ gs`) and the `1 ⊕ m`
(`m ∈ ns`). Then each `h ∈ hs` is `a ⊕ 1` for some `a`, and these `a` generate `G ∩ N`. -/
theorem nint_inter {gs ns : List (Perm (Fin n))} (hn : gens gs ≤ Subgroup.normalizer (gens ns : Set (Perm (Fin n))))
    {hs : List (Perm (Fin (n + n)))}
    (hhs : gens hs = pointwiseStab (gens ((nintPairGens gs ns).map nintSum)) (nintPts n)) :
    ∃ as : List (Perm (Fin n)), hs = as.map (fun a => nintSum (a, 1)) ∧
      gens as = gens gs ⊓ gens ns := by
  set K := nintPairs (gens gs) (gens ns) hn
  have hK : gens ((nintPairGens gs ns).map nintSum) = K.map nintSum := by
    rw [show K = _ from (nint_closure_pairs hn).symm, MonoidHom.map_closure, gens]
    congr 1
    ext; simp
  -- The stabilizer is the image of the pairs `(a, 1)` of `K`.
  have hstab : ∀ h, h ∈ pointwiseStab (gens ((nintPairGens gs ns).map nintSum)) (nintPts n) ↔
      ∃ a, (a, 1) ∈ K ∧ nintSum (a, 1) = h := by
    intro h
    constructor
    · rintro ⟨hh, hfix⟩
      rw [hK] at hh
      obtain ⟨p, hp, rfl⟩ := hh
      have h2 := (nintSum_fix_iff p).mp hfix
      refine ⟨p.1, ?_, ?_⟩ <;> rw [← h2]
      · exact hp
    · rintro ⟨a, ha, rfl⟩
      refine ⟨hK ▸ ⟨_, ha, rfl⟩, (nintSum_fix_iff (a, 1)).mpr rfl⟩
  have hmem : ∀ h ∈ hs, ∃ a, (a, 1) ∈ K ∧ nintSum (a, 1) = h := fun h hh =>
    (hstab h).mp (hhs ▸ Subgroup.subset_closure hh)
  obtain ⟨as, rfl⟩ := nint_list_lift (fun a => nintSum (a, 1)) hs fun h hh =>
    (hmem h hh).imp fun _ ha => ha.2
  refine ⟨as, rfl, ?_⟩
  -- `a ↦ a ⊕ 1` is an injective homomorphism, so it is enough to compare the images.
  set ι : Perm (Fin n) →* Perm (Fin (n + n)) := nintSum.comp (MonoidHom.inl _ _)
  have hι : Function.Injective ι := fun a b h => by
    simpa using nintSum_injective h
  apply Subgroup.map_injective hι
  have e1 : (gens as).map ι = gens (as.map fun a => nintSum (a, 1)) := by
    rw [gens, gens, MonoidHom.map_closure]
    congr 1
    ext; simp [ι]
  rw [e1, hhs]
  ext h
  rw [hstab h]
  constructor
  · rintro ⟨a, ha, rfl⟩
    refine ⟨a, ⟨ha.1, ?_⟩, rfl⟩
    have := (gens ns).inv_mem ha.2
    simpa using this
  · rintro ⟨a, ⟨ha, hb⟩, rfl⟩
    exact ⟨a, ⟨ha, by simpa using (gens ns).inv_mem hb⟩, rfl⟩

end GI.Proved
