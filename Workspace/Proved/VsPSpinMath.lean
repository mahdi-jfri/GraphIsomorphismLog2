import Workspace.Proved.VsPPairMath
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Spins seen through keys

We work in a finite group `G` with subgroups `N` and `S`, and a key map `κ : G → M` into a
vector space over `ZMod r`. The key is additive on `N`, it vanishes on `N ∩ S`, and two
elements of `N` with the same key differ by an element of `S` (`VsPKeyHyp`). A set `Hg`
generates the acting group, and it normalizes `N` and `S`.

The orbit program gives a finite set `Ob` of conjugates of `x0` such that each conjugate of an
element of `Ob` by a generator has the key of an element of `Ob` (`VsPOrbHyp`). We show:
* the spin of `x0`, modulo `S`, is generated by `Ob` (`vsP_spin_eq`);
* the keys of a smaller spin span a smaller space (`vsP_span_le`), and equal spans give equal
  subgroups modulo `S` (`vsP_sup_le_of_span`);
* if every key of the span of `Ob` is the key of a listed element `w`, and no listed `w` outside
  `S` has a spin of smaller dimension, then the spin of `x0` is minimal modulo `S`
  (`vsP_min`).
-/

namespace GI.Proved

variable {G : Type*} [Group G] {r : ℕ} {M : Type*} [AddCommGroup M] [Module (ZMod r) M]

/-- The subgroup generated by the conjugates `g y g⁻¹`, `g` in the group generated by `Hg`. -/
def vsPSpin (Hg : Set G) (y : G) : Subgroup G :=
  Subgroup.closure {x | ∃ g ∈ Subgroup.closure Hg, x = g * y * g⁻¹}

/-- The key hypotheses. -/
structure VsPKeyHyp (N S : Subgroup G) (κ : G → M) : Prop where
  mul : ∀ x ∈ N, ∀ y ∈ N, κ (x * y) = κ x + κ y
  inj : ∀ x ∈ N, ∀ y ∈ N, κ x = κ y → x⁻¹ * y ∈ S
  zero : ∀ x ∈ N, x ∈ S → κ x = 0
  sc : ∀ s ∈ S, ∀ x ∈ N, s * x = x * s

variable {N S : Subgroup G} {κ : G → M}

theorem VsPKeyHyp.one (h : VsPKeyHyp N S κ) : κ 1 = 0 := by
  have := h.mul 1 N.one_mem 1 N.one_mem
  rw [one_mul] at this
  exact (add_eq_left.1 this.symm)

theorem VsPKeyHyp.inv (h : VsPKeyHyp N S κ) {x : G} (hx : x ∈ N) : κ x⁻¹ = -κ x := by
  have := h.mul x⁻¹ (N.inv_mem hx) x hx
  rw [inv_mul_cancel, h.one] at this
  exact eq_neg_of_add_eq_zero_left this.symm

theorem VsPKeyHyp.npow (h : VsPKeyHyp N S κ) {x : G} (hx : x ∈ N) :
    ∀ a : ℕ, κ (x ^ a) = a • κ x
  | 0 => by rw [pow_zero, h.one, zero_smul]
  | a + 1 => by rw [pow_succ, h.mul _ (pow_mem hx a) _ hx, h.npow hx a, succ_nsmul]

/-- Keys of a generated subgroup lie in the span of the keys of the generators. -/
theorem VsPKeyHyp.closure (h : VsPKeyHyp N S κ) {T : Set G} (hT : T ⊆ N) :
    ∀ x ∈ Subgroup.closure T, κ x ∈ Submodule.span (ZMod r) (κ '' T) := by
  intro x hx
  have hTN : Subgroup.closure T ≤ N := (Subgroup.closure_le _).2 hT
  induction hx using Subgroup.closure_induction with
  | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
  | one => rw [h.one]; exact Submodule.zero_mem _
  | mul x y hx hy ihx ihy => rw [h.mul x (hTN hx) y (hTN hy)]; exact Submodule.add_mem _ ihx ihy
  | inv x hx ihx => rw [h.inv (hTN hx)]; exact Submodule.neg_mem _ ihx

/-- Every vector of the span of the keys of `T` is the key of an element of `⟨T⟩`. -/
theorem VsPKeyHyp.span [NeZero r] (h : VsPKeyHyp N S κ) {T : Set G} (hT : T ⊆ N) :
    ∀ v ∈ Submodule.span (ZMod r) (κ '' T), ∃ x ∈ Subgroup.closure T, κ x = v := by
  intro v hv
  have hTN : Subgroup.closure T ≤ N := (Subgroup.closure_le _).2 hT
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨x, hx, rfl⟩ := hv
    exact ⟨x, Subgroup.subset_closure hx, rfl⟩
  | zero => exact ⟨1, one_mem _, h.one⟩
  | add v w _ _ hv hw =>
    obtain ⟨x, hx, rfl⟩ := hv
    obtain ⟨y, hy, rfl⟩ := hw
    exact ⟨x * y, mul_mem hx hy, h.mul x (hTN hx) y (hTN hy)⟩
  | smul c v _ hv =>
    obtain ⟨x, hx, rfl⟩ := hv
    refine ⟨x ^ c.val, pow_mem hx _, ?_⟩
    rw [h.npow (hTN hx), ← Nat.cast_smul_eq_nsmul (ZMod r), ZMod.natCast_zmod_val]

/-- Keys of `⟨T⟩ ⊔ S` (inside `N`) lie in the span of the keys of `T`. -/
theorem VsPKeyHyp.sup (h : VsPKeyHyp N S κ) {T : Set G} (hT : T ⊆ N) {x : G}
    (hx : x ∈ Subgroup.closure T ⊔ S) (hxN : x ∈ N) :
    κ x ∈ Submodule.span (ZMod r) (κ '' T) := by
  have hTN : Subgroup.closure T ≤ N := (Subgroup.closure_le _).2 hT
  obtain ⟨a, ha, s, hs, rfl⟩ := vsM_mem_sup_comm
    (fun a ha s hs => (h.sc s hs a (hTN ha)).symm) hx
  have hsN : s ∈ N := by
    have := N.mul_mem (N.inv_mem (hTN ha)) hxN
    rwa [inv_mul_cancel_left] at this
  rw [h.mul a (hTN ha) s hsN, h.zero s hsN hs, add_zero]
  exact h.closure hT a ha

/-- The orbit hypotheses for `x0` and a set `Ob`. -/
structure VsPOrbHyp (Hg : Set G) (κ : G → M) (x0 : G) (Ob : Set G) : Prop where
  sub : ∀ x ∈ Ob, ∃ g ∈ Subgroup.closure Hg, x = g * x0 * g⁻¹
  mem : x0 ∈ Ob
  closed : ∀ x ∈ Ob, ∀ h ∈ Hg, ∃ x' ∈ Ob, κ (h * x * h⁻¹) = κ x'

variable [Finite G] {Hg : Set G}

/-- The group generated by `Hg` normalizes a subgroup normalized by `Hg`. -/
theorem vsP_norm_closure {K : Subgroup G} (hK : ∀ h ∈ Hg, ∀ x ∈ K, h * x * h⁻¹ ∈ K) :
    ∀ g ∈ Subgroup.closure Hg, ∀ x ∈ K, g * x * g⁻¹ ∈ K :=
  vsP_conj_closed (S := ⊥) (Cl := (K : Set G)) (fun h _ s hs => by
      rw [Subgroup.mem_bot] at hs ⊢; rw [hs]; group)
    (fun x hx s hs => by rw [Subgroup.mem_bot] at hs; rw [hs, mul_one]; exact hx) hK

theorem VsPOrbHyp.subset_N {x0 : G} {Ob : Set G} (hO : VsPOrbHyp Hg κ x0 Ob)
    (hNn : ∀ h ∈ Hg, ∀ x ∈ N, h * x * h⁻¹ ∈ N) (hx0 : x0 ∈ N) : Ob ⊆ N := by
  intro x hx
  obtain ⟨g, hg, rfl⟩ := hO.sub x hx
  exact vsP_norm_closure hNn g hg x0 hx0

theorem VsPOrbHyp.subset_spin {x0 : G} {Ob : Set G} (hO : VsPOrbHyp Hg κ x0 Ob) :
    Ob ⊆ vsPSpin Hg x0 := fun x hx => Subgroup.subset_closure (hO.sub x hx)

/-- `⟨Ob⟩ ⊔ S` is normalized by the generators. -/
theorem VsPOrbHyp.norm (hk : VsPKeyHyp N S κ) {x0 : G} {Ob : Set G}
    (hO : VsPOrbHyp Hg κ x0 Ob) (hNn : ∀ h ∈ Hg, ∀ x ∈ N, h * x * h⁻¹ ∈ N)
    (hSn : ∀ h ∈ Hg, ∀ s ∈ S, h * s * h⁻¹ ∈ S) (hx0 : x0 ∈ N) :
    ∀ h ∈ Hg, ∀ x ∈ Subgroup.closure Ob ⊔ S, h * x * h⁻¹ ∈ Subgroup.closure Ob ⊔ S := by
  intro h hh x hx
  have hON := hO.subset_N hNn hx0
  let K' : Subgroup G := (Subgroup.closure Ob ⊔ S).comap (MulAut.conj h).toMonoidHom
  have hle : Subgroup.closure Ob ⊔ S ≤ K' := by
    refine sup_le ((Subgroup.closure_le _).2 fun (y : G) (hy : y ∈ Ob) => ?_)
      fun (s : G) (hs : s ∈ S) => ?_
    · rw [SetLike.mem_coe, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      obtain ⟨y', hy', e⟩ := hO.closed y hy h hh
      have hc : h * y * h⁻¹ ∈ N := hNn h hh y (hON hy)
      have := hk.inj y' (hON hy') _ hc e.symm
      have e2 : h * y * h⁻¹ = y' * (y'⁻¹ * (h * y * h⁻¹)) := by group
      rw [e2]
      exact mul_mem (Subgroup.mem_sup_left (Subgroup.subset_closure hy'))
        (Subgroup.mem_sup_right this)
    · rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]; exact Subgroup.mem_sup_right (hSn h hh s hs)
  have := hle hx
  simpa [K', MulAut.conj_apply] using this

/-- **The spin modulo `S` is generated by the orbit set.** -/
theorem vsP_spin_eq (hk : VsPKeyHyp N S κ) {x0 : G} {Ob : Set G}
    (hO : VsPOrbHyp Hg κ x0 Ob) (hNn : ∀ h ∈ Hg, ∀ x ∈ N, h * x * h⁻¹ ∈ N)
    (hSn : ∀ h ∈ Hg, ∀ s ∈ S, h * s * h⁻¹ ∈ S) (hx0 : x0 ∈ N) :
    vsPSpin Hg x0 ⊔ S = Subgroup.closure Ob ⊔ S := by
  apply le_antisymm
  · refine sup_le ((Subgroup.closure_le _).2 ?_) le_sup_right
    rintro _ ⟨g, hg, rfl⟩
    exact vsP_norm_closure (hO.norm hk hNn hSn hx0) g hg x0
      (Subgroup.mem_sup_left (Subgroup.subset_closure hO.mem))
  · exact sup_le_sup_right ((Subgroup.closure_le _).2 hO.subset_spin) S

/-- **Keys of a smaller spin.** If `w` lies in `⟨Ob⟩ ⊔ S` (and in `N`), the keys of an orbit set
of `w` span a subspace of the span of the keys of `Ob`. -/
theorem vsP_span_le (hk : VsPKeyHyp N S κ) {x0 w : G} {Ob Ow : Set G}
    (hO : VsPOrbHyp Hg κ x0 Ob) (hW : VsPOrbHyp Hg κ w Ow)
    (hNn : ∀ h ∈ Hg, ∀ x ∈ N, h * x * h⁻¹ ∈ N) (hSn : ∀ h ∈ Hg, ∀ s ∈ S, h * s * h⁻¹ ∈ S)
    (hx0 : x0 ∈ N) (hwN : w ∈ N) (hw : w ∈ Subgroup.closure Ob ⊔ S) :
    Submodule.span (ZMod r) (κ '' Ow) ≤ Submodule.span (ZMod r) (κ '' Ob) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨x, hx, rfl⟩
  obtain ⟨g, hg, rfl⟩ := hW.sub x hx
  exact hk.sup (hO.subset_N hNn hx0) (vsP_norm_closure (hO.norm hk hNn hSn hx0) g hg w hw)
    (vsP_norm_closure hNn g hg w hwN)

/-- **Equal key spans give the same subgroup modulo `S`.** -/
theorem vsP_sup_le_of_span [NeZero r] (hk : VsPKeyHyp N S κ) {Ob Ow : Set G} (hOb : Ob ⊆ N)
    (hOw : Ow ⊆ N) (hle : Submodule.span (ZMod r) (κ '' Ob) ≤ Submodule.span (ZMod r) (κ '' Ow)) :
    Subgroup.closure Ob ⊔ S ≤ Subgroup.closure Ow ⊔ S := by
  refine sup_le ((Subgroup.closure_le _).2 fun x hx => ?_) le_sup_right
  obtain ⟨b, hb, e⟩ := hk.span hOw _ (hle (Submodule.subset_span ⟨x, hx, rfl⟩))
  have hbN : b ∈ N := (Subgroup.closure_le _).2 hOw hb
  have := hk.inj b hbN x (hOb hx) e
  have e2 : x = b * (b⁻¹ * x) := by group
  rw [e2]
  exact mul_mem (Subgroup.mem_sup_left hb) (Subgroup.mem_sup_right this)

/-- The spin of `a` is inside the spin of `a s` and `S`, for `s ∈ S`. -/
theorem vsP_spin_mul_le (hSn : ∀ h ∈ Hg, ∀ s ∈ S, h * s * h⁻¹ ∈ S) {a s : G} (hs : s ∈ S) :
    vsPSpin Hg a ≤ vsPSpin Hg (a * s) ⊔ S := by
  refine (Subgroup.closure_le _).2 ?_
  rintro _ ⟨g, hg, rfl⟩
  have e : g * a * g⁻¹ = g * (a * s) * g⁻¹ * (g * s⁻¹ * g⁻¹) := by group
  rw [e]
  exact mul_mem (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨g, hg, rfl⟩))
    (Subgroup.mem_sup_right (vsP_norm_closure hSn g hg _ (S.inv_mem hs)))

/-- **Minimality.** Let `Ob` be a finite orbit set of `x0`. Suppose every key in the span of the
keys of `Ob` is the key of a listed element `w ∈ ⟨Ob⟩`, and every listed `w ∉ S` has an orbit
set whose key span has dimension at least that of `Ob`. Then every `y ∈ ⟨Ob⟩ ⊔ S` outside `S`
spins all of `⟨Ob⟩ ⊔ S` modulo `S`. -/
theorem vsP_min [Fact r.Prime] (hk : VsPKeyHyp N S κ) {x0 : G} {Ob : Set G}
    (hO : VsPOrbHyp Hg κ x0 Ob) (hfin : Ob.Finite)
    (hNn : ∀ h ∈ Hg, ∀ x ∈ N, h * x * h⁻¹ ∈ N) (hSn : ∀ h ∈ Hg, ∀ s ∈ S, h * s * h⁻¹ ∈ S)
    (hx0 : x0 ∈ N) {Wd : Set G} (hWd : ∀ w ∈ Wd, w ∈ Subgroup.closure Ob)
    (hcov : ∀ v ∈ Submodule.span (ZMod r) (κ '' Ob), ∃ w ∈ Wd, κ w = v)
    (hdesc : ∀ w ∈ Wd, w ∉ S → ∃ Ow : Set G, VsPOrbHyp Hg κ w Ow ∧
      Module.finrank (ZMod r) (Submodule.span (ZMod r) (κ '' Ob)) ≤
        Module.finrank (ZMod r) (Submodule.span (ZMod r) (κ '' Ow))) :
    ∀ y ∈ Subgroup.closure Ob ⊔ S, y ∉ S → Subgroup.closure Ob ⊔ S ≤ vsPSpin Hg y ⊔ S := by
  intro y hy hyS
  have hON := hO.subset_N hNn hx0
  have hClN : Subgroup.closure Ob ≤ N := (Subgroup.closure_le _).2 hON
  obtain ⟨a, ha, s, hs, rfl⟩ := vsM_mem_sup_comm
    (fun a ha s hs => (hk.sc s hs a (hClN ha)).symm) hy
  have haS : a ∉ S := fun h' => hyS (mul_mem h' hs)
  obtain ⟨w, hw, e⟩ := hcov _ (hk.closure hON a ha)
  have hwN : w ∈ N := hClN (hWd w hw)
  have hwa : w⁻¹ * a ∈ S := hk.inj w hwN a (hClN ha) e
  have hwS : w ∉ S := fun h' => haS (by
    have := mul_mem h' hwa; rwa [mul_inv_cancel_left] at this)
  obtain ⟨Ow, hOw, hdim⟩ := hdesc w hw hwS
  have hOwN := hOw.subset_N hNn hwN
  haveI : FiniteDimensional (ZMod r) (Submodule.span (ZMod r) (κ '' Ob)) :=
    FiniteDimensional.span_of_finite _ (hfin.image _)
  have hle := vsP_span_le (r := r) hk hO hOw hNn hSn hx0 hwN (Subgroup.mem_sup_left (hWd w hw))
  have heq := Submodule.eq_of_le_of_finrank_le hle hdim
  calc Subgroup.closure Ob ⊔ S ≤ Subgroup.closure Ow ⊔ S :=
        vsP_sup_le_of_span hk hON hOwN heq.symm.le
    _ = vsPSpin Hg w ⊔ S := (vsP_spin_eq hk hOw hNn hSn hwN).symm
    _ ≤ vsPSpin Hg a ⊔ S := by
        have hsa : a⁻¹ * w ∈ S := by
          have := S.inv_mem hwa; rwa [mul_inv_rev, inv_inv] at this
        have h1 := vsP_spin_mul_le (Hg := Hg) (a := w) hSn (S.inv_mem hsa)
        have e2 : w * (a⁻¹ * w)⁻¹ = a := by group
        rw [e2] at h1
        exact sup_le h1 le_sup_right
    _ ≤ vsPSpin Hg (a * s) ⊔ S := sup_le (vsP_spin_mul_le hSn hs) le_sup_right

end GI.Proved
