import Workspace.Proved.JohnScheme
import Workspace.Impl.CamTransport
import Workspace.Cited.AlgoJohnson
import Workspace.Lang.Lib.OrbitMath

/-!
# The orbitals of a Johnson group

Let `ι` identify the points `Fin n` with the `k`-subsets of `Fin m` so that `G` acts as `Alt(m)`
(`IsJohnsonId G ι`). We show:

* `john_isJohnsonId_trans`: renaming `Fin m` by any permutation `π` keeps `IsJohnsonId`, since
  `Alt(m)` is normal in `Sym(m)`. So the program only has to find `ι` up to such a renaming.
* `john_orbital_iff`: two ordered pairs of points lie in one orbit of `G` exactly when the
  `k`-sets of their points meet in the same number of elements. One direction holds because
  `G` acts by permutations of `Fin m`; the other is `john_exists_alt_pair`.
* `john_pair_orbit_iff`: the orbits of `G` on pairs are the orbits of the group generated by the
  permutations `johnPairPerm g` of `Fin (n * n)`, where the pair `(x, y)` is the index
  `n * x + y`. This is how the program computes the orbitals.
-/

namespace GI.Proved

open Equiv Finset GI.Cited

variable {n m k : ℕ}

/-- The number of elements that the `k`-sets of two points share. -/
def johnInter (ι : Fin n ≃ {A : Finset (Fin m) // A.card = k}) (x y : Fin n) : ℕ :=
  #((ι x).1 ∩ (ι y).1)

/-- **Renaming `Fin m`.** -/
theorem john_isJohnsonId_trans {G : Subgroup (Perm (Fin n))}
    {ι : Fin n ≃ {A : Finset (Fin m) // A.card = k}} (π : Perm (Fin m)) (h : IsJohnsonId G ι) :
    IsJohnsonId G (ι.trans (kSetPerm π)) := by
  intro g
  rw [h g]
  have hn := (inferInstance : (alternatingGroup (Fin m)).Normal)
  constructor
  · rintro ⟨a, ha, hga⟩
    refine ⟨π * a * π⁻¹, hn.conj_mem a ha π, fun x => ?_⟩
    simp only [Equiv.trans_apply, hga x, GI.Impl.cam_kSetPerm_mul, Perm.mul_apply]
    rw [← GI.Impl.cam_kSetPerm_symm, Equiv.symm_apply_apply]
  · rintro ⟨a, ha, hga⟩
    refine ⟨π⁻¹ * a * π, by simpa using hn.conj_mem a ha π⁻¹, fun x => ?_⟩
    have := congrArg (kSetPerm π).symm (hga x)
    simp only [Equiv.trans_apply, Equiv.symm_apply_apply] at this
    rw [this, GI.Impl.cam_kSetPerm_conj]

/-- The action of `kSetPerm` keeps intersection sizes. -/
theorem john_card_inter_kSetPerm (a : Perm (Fin m)) (A B : {A : Finset (Fin m) // A.card = k}) :
    #((kSetPerm a A).1 ∩ (kSetPerm a B).1) = #(A.1 ∩ B.1) := by
  rw [GI.Impl.cam_kSetPerm_apply, GI.Impl.cam_kSetPerm_apply, ← map_inter, card_map]

/-- **The orbitals.** -/
theorem john_orbital_iff {G : Subgroup (Perm (Fin n))}
    {ι : Fin n ≃ {A : Finset (Fin m) // A.card = k}} (h : IsJohnsonId G ι) (hm : 2 * k + 2 ≤ m)
    (x y x' y' : Fin n) :
    (∃ g ∈ G, g x = x' ∧ g y = y') ↔ johnInter ι x y = johnInter ι x' y' := by
  constructor
  · rintro ⟨g, hg, rfl, rfl⟩
    obtain ⟨a, -, hga⟩ := (h g).mp hg
    unfold johnInter
    rw [hga x, hga y, john_card_inter_kSetPerm]
  · intro he
    have hout : 2 ≤ #((ι x').1 ∪ (ι y').1)ᶜ := by
      have := card_union_le (ι x').1 (ι y').1
      rw [card_compl, Fintype.card_fin, (ι x').2, (ι y').2] at *
      omega
    obtain ⟨a, ha, hax, hay⟩ := john_exists_alt_pair (A := (ι x).1) (B := (ι y).1)
      (A' := (ι x').1) (B' := (ι y').1) (by rw [(ι x).2, (ι x').2]) (by rw [(ι y).2, (ι y').2])
      he hout
    let g : Perm (Fin n) := (ι.trans (kSetPerm a)).trans ι.symm
    have hg : ∀ z, ι (g z) = kSetPerm a (ι z) := fun z => by
      simp only [g, Equiv.trans_apply, Equiv.apply_symm_apply]
    refine ⟨g, (h g).mpr ⟨a, ha, hg⟩, ?_, ?_⟩
    · apply ι.injective
      rw [hg]
      exact Subtype.ext hax
    · apply ι.injective
      rw [hg]
      exact Subtype.ext hay

/-! ### Pairs as points of `Fin (n * n)` -/

/-- The pair `(x, y)` as the point `n * x + y` of `Fin (n * n)`. -/
def johnPair (x y : Fin n) : Fin (n * n) := finProdFinEquiv (x, y)

theorem john_pair_val (x y : Fin n) : (johnPair x y : ℕ) = n * x + y := by
  simp only [johnPair, finProdFinEquiv_apply_val]
  ring

/-- The action of `g` on pairs. -/
def johnPairPerm (g : Perm (Fin n)) : Perm (Fin (n * n)) :=
  finProdFinEquiv.permCongr (Equiv.prodCongr g g)

theorem john_pairPerm_pair (g : Perm (Fin n)) (x y : Fin n) :
    johnPairPerm g (johnPair x y) = johnPair (g x) (g y) := by
  simp [johnPairPerm, johnPair, Equiv.permCongr_apply]

/-- `johnPairPerm` as a homomorphism. -/
def johnPairHom : Perm (Fin n) →* Perm (Fin (n * n)) where
  toFun := johnPairPerm
  map_one' := by ext p; simp [johnPairPerm, Equiv.permCongr_apply, Nat.mod_add_div]
  map_mul' a b := by ext p; simp [johnPairPerm, Equiv.permCongr_apply]

theorem john_pair_surj (p : Fin (n * n)) : ∃ x y : Fin n, johnPair x y = p :=
  ⟨(finProdFinEquiv.symm p).1, (finProdFinEquiv.symm p).2, by
    show finProdFinEquiv ((finProdFinEquiv.symm p).1, (finProdFinEquiv.symm p).2) = p
    rw [Prod.mk.eta]
    exact finProdFinEquiv.apply_symm_apply p⟩

/-- The group generated by the pair actions of `1 :: gs` is the image of `gens gs`. -/
theorem john_genGroup_pair (gs : List (Perm (Fin n))) :
    GI.Lang.genGroup ((1 :: gs).map johnPairPerm) = (gens gs).map johnPairHom := by
  unfold GI.Lang.genGroup gens
  rw [MonoidHom.map_closure]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro h hh
    simp only [Set.mem_setOf_eq, List.mem_map, List.mem_cons] at hh
    obtain ⟨g, hg | hg, rfl⟩ := hh
    · subst hg
      have h1 : johnPairPerm (1 : Perm (Fin n)) = 1 := map_one johnPairHom
      rw [h1]
      exact one_mem _
    · exact Subgroup.subset_closure ⟨g, hg, rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ ⟨g, hg, rfl⟩
    exact Subgroup.subset_closure (List.mem_map.mpr ⟨g, List.mem_cons_of_mem _ hg, rfl⟩)

/-- **Orbits on pairs.** -/
theorem john_pair_orbit_iff (gs : List (Perm (Fin n))) (x y x' y' : Fin n) :
    johnPair x' y' ∈ GI.Lang.genOrbit ((1 :: gs).map johnPairPerm) (johnPair x y) ↔
      ∃ g ∈ gens gs, g x = x' ∧ g y = y' := by
  rw [GI.Lang.mem_genOrbit, john_genGroup_pair]
  constructor
  · rintro ⟨_, ⟨g, hg, rfl⟩, he⟩
    change johnPairPerm g (johnPair x y) = _ at he
    rw [john_pairPerm_pair] at he
    have := finProdFinEquiv.injective he
    simp only [Prod.mk.injEq] at this
    exact ⟨g, hg, this.1, this.2⟩
  · rintro ⟨g, hg, rfl, rfl⟩
    exact ⟨johnPairHom g, ⟨g, hg, rfl⟩, john_pairPerm_pair g x y⟩

/-- **The labels of pairs.** If `lab` labels the orbits of the pair actions, then two pairs have
the same label exactly when their `k`-sets meet in the same number of elements. -/
theorem john_lab_iff {gs : List (Perm (Fin n))} {ι : Fin n ≃ {A : Finset (Fin m) // A.card = k}}
    (h : IsJohnsonId (gens gs) ι) (hm : 2 * k + 2 ≤ m) {lab : Fin (n * n) → ℕ}
    (hlab : ∀ p q, lab p = lab q ↔ q ∈ GI.Lang.genOrbit ((1 :: gs).map johnPairPerm) p)
    (x y x' y' : Fin n) :
    lab (johnPair x y) = lab (johnPair x' y') ↔ johnInter ι x y = johnInter ι x' y' := by
  rw [hlab, john_pair_orbit_iff, john_orbital_iff h hm]

end GI.Proved
