import Workspace.Proved.VsPKeyMath
import Workspace.Proved.VsPSpinMath

/-!
# From permutations to local units

`vsPRho hs g` is the local unit of a permutation `g ∈ ⟨hs⟩` (and `1` outside), so it is
multiplicative on `⟨hs⟩`. We record:
* `vsPBar_mem_iff`, `vsPBar_gens`: the local image of `⟨ys⟩` is generated by the images of `ys`;
* `vsPRho_W`: the image of a word is the word of the images;
* `vsPKey_eq`: the program key of `y` lists the discrete logarithms `dl(ρ y, ρ g_j)`, and as a
  vector it is `vsPKV r ζ (gs.map ρ) (ρ y)` (`vsF_vsPKey`).
-/

namespace GI.Proved

open GI.Impl GI.Cited GI.Lang Equiv
open scoped commutatorElement

variable {I : VecStabInst} {s : VsQSt I}

open Classical in
/-- The local unit of a permutation (`1` outside `⟨hs⟩`). -/
noncomputable def vsPRho (hs : VsQStOK s) (g : Perm (Fin I.n)) :
    (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ :=
  if h : g ∈ gens s.hs then vsQRho hs ⟨g, h⟩ else 1

variable (hs : VsQStOK s)

theorem vsPRho_of {g : Perm (Fin I.n)} (hg : g ∈ gens s.hs) : vsPRho hs g = vsQRho hs ⟨g, hg⟩ := by
  rw [vsPRho, dif_pos hg]

theorem vsPRho_mul {g h : Perm (Fin I.n)} (hg : g ∈ gens s.hs) (hh : h ∈ gens s.hs) :
    vsPRho hs (g * h) = vsPRho hs g * vsPRho hs h := by
  rw [vsPRho_of hs hg, vsPRho_of hs hh, vsPRho_of hs (mul_mem hg hh), ← map_mul]; rfl

theorem vsPRho_one : vsPRho hs 1 = 1 := by
  rw [vsPRho_of hs (one_mem _)]; exact map_one _

theorem vsPRho_inv {g : Perm (Fin I.n)} (hg : g ∈ gens s.hs) : vsPRho hs g⁻¹ = (vsPRho hs g)⁻¹ := by
  rw [vsPRho_of hs hg, vsPRho_of hs (inv_mem hg), ← map_inv]; rfl

theorem vsPRho_pow {g : Perm (Fin I.n)} (hg : g ∈ gens s.hs) (a : ℕ) :
    vsPRho hs (g ^ a) = vsPRho hs g ^ a := by
  rw [vsPRho_of hs hg, vsPRho_of hs (pow_mem hg a), ← map_pow]; rfl

theorem vsPRho_conj {g h : Perm (Fin I.n)} (hg : g ∈ gens s.hs) (hh : h ∈ gens s.hs) :
    vsPRho hs (h * g * h⁻¹) = vsPRho hs h * vsPRho hs g * (vsPRho hs h)⁻¹ := by
  rw [vsPRho_mul hs (mul_mem hh hg) (inv_mem hh), vsPRho_mul hs hh hg, vsPRho_inv hs hh]

theorem vsPRho_comm {g h : Perm (Fin I.n)} (hg : g ∈ gens s.hs) (hh : h ∈ gens s.hs) :
    vsPRho hs ⁅g, h⁆ = ⁅vsPRho hs g, vsPRho hs h⁆ := by
  rw [vsPRho_of hs hg, vsPRho_of hs hh]
  have hc : ⁅g, h⁆ ∈ gens s.hs := by
    rw [commutatorElement_def]; exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  rw [vsPRho_of hs hc]
  have : (⟨⁅g, h⁆, hc⟩ : gens s.hs) = ⁅(⟨g, hg⟩ : gens s.hs), ⟨h, hh⟩⁆ := rfl
  rw [this, map_commutatorElement]

theorem vsPBar_mem_iff {K : Subgroup (Perm (Fin I.n))} {u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ} :
    u ∈ vsPBar hs K ↔ ∃ x ∈ K, x ∈ gens s.hs ∧ vsPRho hs x = u := by
  unfold vsPBar
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨⟨x, hx⟩, hxK, rfl⟩
    rw [Subgroup.mem_subgroupOf] at hxK
    exact ⟨x, hxK, hx, vsPRho_of hs hx⟩
  · rintro ⟨x, hxK, hx, rfl⟩
    exact ⟨⟨x, hx⟩, by rw [Subgroup.mem_subgroupOf]; exact hxK, (vsPRho_of hs hx).symm⟩

theorem vsPRho_mem_vsPBar {K : Subgroup (Perm (Fin I.n))} {x : Perm (Fin I.n)} (hxK : x ∈ K)
    (hx : x ∈ gens s.hs) : vsPRho hs x ∈ vsPBar hs K :=
  (vsPBar_mem_iff hs).2 ⟨x, hxK, hx, rfl⟩

/-- **The local image of `⟨ys⟩` is generated by the images of `ys`.** -/
theorem vsPBar_gens {ys : List (Perm (Fin I.n))} (hys : ∀ y ∈ ys, y ∈ gens s.hs) :
    vsPBar hs (gens ys) = Subgroup.closure (vsPRho hs '' {y | y ∈ ys}) := by
  have hle : gens ys ≤ gens s.hs := (Subgroup.closure_le _).2 fun y hy => hys y hy
  apply le_antisymm
  · intro u hu
    obtain ⟨x, hx, -, rfl⟩ := (vsPBar_mem_iff hs).1 hu
    clear hu
    induction hx using Subgroup.closure_induction with
    | mem x hx => exact Subgroup.subset_closure ⟨x, hx, rfl⟩
    | one => rw [vsPRho_one]; exact one_mem _
    | mul x y hx hy ihx ihy => rw [vsPRho_mul hs (hle hx) (hle hy)]; exact mul_mem ihx ihy
    | inv x hx ihx => rw [vsPRho_inv hs (hle hx)]; exact inv_mem ihx
  · refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨y, hy, rfl⟩
    exact vsPRho_mem_vsPBar hs (Subgroup.subset_closure hy) (hys y hy)

/-- The local image of `⟨hs⟩`. -/
theorem vsPBar_top_eq : vsPBar hs (gens s.hs) = Subgroup.closure (vsPRho hs '' {y | y ∈ s.hs}) :=
  vsPBar_gens hs fun y hy => Subgroup.subset_closure hy

/-- **Words.** The image of a word is the word of the images. -/
theorem vsPRho_W {gs : List (Perm (Fin I.n))} (hgs : ∀ g ∈ gs, g ∈ gens s.hs) :
    ∀ e : List ℕ, vsPRho hs (vsPW gs e) = vsPW (gs.map (vsPRho hs)) e := by
  induction gs with
  | nil => intro e; rw [vsPW_nil, List.map_nil, vsPW_nil, vsPRho_one]
  | cons g gs ih =>
    intro e
    cases e with
    | nil => simp [vsPW, vsPRho_one]
    | cons a e =>
      have hg := hgs g (by simp)
      rw [vsPW_cons, List.map_cons, vsPW_cons,
        vsPRho_mul hs (pow_mem hg a) (vsPW_mem (N := gens s.hs) (fun x hx => hgs x (by simp [hx])) e),
        vsPRho_pow hs hg, ih (fun x hx => hgs x (by simp [hx]))]

/-! ### The program key -/

/-- The key vector of `x`: `dl(x, g_i)` at `i < |gs|`, `0` beyond. -/
noncomputable def vsPKV {G : Type*} [Group G] (r : ℕ) (ζ : G) (gs : List G) (x : G) : ℕ → ZMod r :=
  fun i => if h : i < gs.length then vsPDl r ζ x gs[i] else 0

/-- **The program key entry** of `y` at `g` is `dl(ρ y, ρ g)`. -/
theorem vsPKeyIdx_rho {N : Subgroup (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ} {r : ℕ}
    [NeZero r] {c0 : Perm (Fin I.n)} (hc0 : c0 ∈ gens s.hs)
    (hP : VsPPairHyp N r (vsPRho hs c0)) {y g : Perm (Fin I.n)} (hy : y ∈ gens s.hs)
    (hg : g ∈ gens s.hs) (hyN : vsPRho hs y ∈ N) (hgN : vsPRho hs g ∈ N) :
    vsPKeyIdx I s.ws' (vsQCs s) (vsPZp I s.ws' (vsQCs s) c0 r) y g =
      (vsPDl r (vsPRho hs c0) (vsPRho hs y) (vsPRho hs g)).val := by
  have hord : orderOf (vsQRho hs ⟨c0, hc0⟩) = r := by rw [← vsPRho_of hs hc0]; exact hP.ord
  refine vsPKeyIdx_dl hs hc0 hy hg hord ?_
  rw [← vsPRho_of hs hy, ← vsPRho_of hs hg, ← vsPRho_of hs hc0]
  exact hP.spec hyN hgN

/-- **The program key** as a vector. -/
theorem vsF_vsPKey {N : Subgroup (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ} {r : ℕ}
    [NeZero r] {c0 : Perm (Fin I.n)} (hc0 : c0 ∈ gens s.hs)
    (hP : VsPPairHyp N r (vsPRho hs c0)) {gs : List (Perm (Fin I.n))}
    (hgs : ∀ g ∈ gs, g ∈ gens s.hs) (hgN : ∀ g ∈ gs, vsPRho hs g ∈ N) {y : Perm (Fin I.n)}
    (hy : y ∈ gens s.hs) (hyN : vsPRho hs y ∈ N) :
    vsF r (vsPKey I s.ws' (vsQCs s) (vsPZp I s.ws' (vsQCs s) c0 r) gs y) =
      vsPKV r (vsPRho hs c0) (gs.map (vsPRho hs)) (vsPRho hs y) := by
  funext i
  simp only [vsF_apply, vsPKV, vsPKey, List.length_map]
  by_cases hi : i < gs.length
  · rw [dif_pos hi, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hi,
      Option.map_some, Option.getD_some,
      vsPKeyIdx_rho hs hc0 hP hy (hgs _ (List.getElem_mem hi)) hyN (hgN _ (List.getElem_mem hi)),
      ZMod.natCast_zmod_val, List.getElem_map]
  · rw [dif_neg hi, List.getD_eq_default _ _ (by simp; omega), Nat.cast_zero]

/-- The program key entries are below `r`, and there are `|gs|` of them. -/
theorem vsPKey_fit {N : Subgroup (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ} {r : ℕ}
    [NeZero r] {c0 : Perm (Fin I.n)} (hc0 : c0 ∈ gens s.hs)
    (hP : VsPPairHyp N r (vsPRho hs c0)) {gs : List (Perm (Fin I.n))}
    (hgs : ∀ g ∈ gs, g ∈ gens s.hs) (hgN : ∀ g ∈ gs, vsPRho hs g ∈ N) {y : Perm (Fin I.n)}
    (hy : y ∈ gens s.hs) (hyN : vsPRho hs y ∈ N) :
    (∀ x ∈ vsPKey I s.ws' (vsQCs s) (vsPZp I s.ws' (vsQCs s) c0 r) gs y, x < r) ∧
      (vsPKey I s.ws' (vsQCs s) (vsPZp I s.ws' (vsQCs s) c0 r) gs y).length = gs.length := by
  refine ⟨fun x hx => ?_, by simp [vsPKey]⟩
  simp only [vsPKey, List.mem_map] at hx
  obtain ⟨g, hg, rfl⟩ := hx
  rw [vsPKeyIdx_rho hs hc0 hP hy (hgs g hg) hyN (hgN g hg)]
  exact ZMod.val_lt _

/-! ### The key vector as a key map -/

variable {G : Type*} [Group G]

/-- **The key hypotheses** for `vsPKV`: from the pairing, the radical in `S`, and `S`
commuting with `N`. -/
theorem vsPKV_hyp {N S : Subgroup G} {r : ℕ} [NeZero r] {ζ : G} (hP : VsPPairHyp N r ζ)
    {gs : List G} (hN : N = Subgroup.closure {g | g ∈ gs})
    (hrad : ∀ x ∈ N, (∀ g ∈ gs, x * g = g * x) → x ∈ S)
    (hsc : ∀ s ∈ S, ∀ x ∈ N, s * x = x * s) : VsPKeyHyp N S (vsPKV r ζ gs) := by
  have hgN : ∀ g ∈ gs, g ∈ N := fun g hg => hN ▸ Subgroup.subset_closure hg
  refine ⟨fun x hx y hy => ?_, fun x hx y hy e => ?_, fun x hx hxS => ?_, hsc⟩
  · funext i
    simp only [vsPKV, Pi.add_apply]
    split_ifs with hi
    · exact hP.dl_mul hx hy (hgN _ (List.getElem_mem hi))
    · rw [add_zero]
  · refine vsP_key_inj hP hN hrad hx hy fun g hg => ?_
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hg
    have := congrFun e i
    simpa [vsPKV, hi] using this
  · funext i
    simp only [vsPKV, Pi.zero_apply]
    split_ifs with hi
    · exact (hP.dl_eq_zero_iff hx (hgN _ (List.getElem_mem hi))).2
        (hsc x hxS _ (hgN _ (List.getElem_mem hi)))
    · rfl

end GI.Proved
