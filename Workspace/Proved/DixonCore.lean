import Workspace.Proved.DixonCyclic

/-!
# Derived length of a solvable group acting irreducibly on a commutative group

Let `H` be a finite solvable group acting faithfully by automorphisms on a finite commutative
group `V` with `|V| = n ≥ 2`, such that the only `H`-invariant subgroups of `V` are `1` and `V`.
Assume the permutation bound `dl ≤ solvL` in every degree below `n`. Then
`H^{(solvL n - 1)} = 1` (`GI.Proved.dixon_core`).

*Proof.* Write `L = solvL`. By `GI.Proved.dixon_solvL_add_three`, it is enough to find `m ≥ 1`
with `2m ≤ n` and `dl(H) ≤ L(m) + 2`.
* If `H` is not transitive on `V \ {1}`, two disjoint orbits lie in `V \ {1}`, so one orbit `O`
  has `2|O| ≤ n`. The subgroup generated by `O` is invariant and not `1`, so it is `V`. Hence
  `H` acts faithfully on `O`, and the bound in degree `|O|` gives `dl(H) ≤ L(|O|)`
  (`GI.Proved.dixon_intransitive`).
* If `H ≠ 1` is transitive on `V \ {1}`, take the last nontrivial term `A` of the derived series
  and `a ∈ A` of prime order. By `GI.Proved.dixon_conj_mem_zpowers` the subgroup `⟨a⟩` is
  normal, and by `GI.Proved.dixon_semiregular` its orbits on `V \ {1}` have at least two points.
  `H` permutes these orbits; let `K` be the kernel. The derived subgroup of `H` centralizes `a`
  (`GI.Proved.dixon_commutator_le_centralizer`), and elements of `K` that centralize `a`
  commute (`h v = a^i v` and `g v = a^j v` give `h g v = a^{i+j} v = g h v`). The bound in degree
  `m`, the number of orbits, gives `H^{(L(m))} ≤ K`, so `H^{(L(m) + 1)}` is commutative and
  `dl(H) ≤ L(m) + 2` (`GI.Proved.dixon_transitive`).
-/

namespace GI.Proved

open MulAction Subgroup Pointwise
open scoped commutatorElement

variable {H V : Type} [Group H] [CommGroup V] [MulDistribMulAction H V] [FaithfulSMul H V]

omit [FaithfulSMul H V] in
theorem dixon_smul_ne_one {h : H} {v : V} (hv : v ≠ 1) : h • v ≠ 1 := by
  intro h1
  apply hv
  rw [← inv_smul_smul h v, h1, smul_one]

/-- `H` acts faithfully on the orbit of any `v ≠ 1`, because the orbit generates `V`. -/
theorem dixon_orbit_injective
    (hirr : ∀ W : Subgroup V, (∀ h : H, ∀ w ∈ W, h • w ∈ W) → W = ⊥ ∨ W = ⊤)
    {v : V} (hv : v ≠ 1) (hs : ∀ (h : H) (x : V), h • x ∈ orbit H v ↔ x ∈ orbit H v) :
    Function.Injective (solvRes (orbit H v) hs) := by
  rw [injective_iff_map_eq_one]
  intro h hh
  have hfix : ∀ x ∈ orbit H v, h • x = x := fun x hx => by
    have := congrArg Subtype.val (Equiv.ext_iff.mp hh ⟨x, hx⟩)
    simpa [solvRes_apply] using this
  have hinv : ∀ (g : H), ∀ w ∈ closure (orbit H v), g • w ∈ closure (orbit H v) := by
    intro g w hw
    have hle : closure (orbit H v) ≤
        (closure (orbit H v)).comap (MulDistribMulAction.toMonoidHom V g) := by
      rw [closure_le]
      intro x hx
      exact subset_closure (mem_orbit_of_mem_orbit g hx)
    exact hle hw
  have hW : closure (orbit H v) = ⊤ := by
    rcases hirr (closure (orbit H v)) hinv with h0 | h0
    · exfalso
      apply hv
      have : v ∈ closure (orbit H v) := subset_closure (mem_orbit_self v)
      rw [h0] at this
      exact mem_bot.mp this
    · exact h0
  have hle : closure (orbit H v) ≤
      MonoidHom.eqLocus (MulDistribMulAction.toMonoidHom V h) (MonoidHom.id V) := by
    rw [closure_le]
    intro x hx
    exact hfix x hx
  rw [hW] at hle
  exact eq_of_smul_eq_smul (α := V) fun x => by rw [one_smul]; exact hle (mem_top x)

/-- The bound through the action on one orbit. -/
theorem dixon_orbit_derived [Finite V] [IsSolvable H] (ih : SolvDLIH.{0} (Nat.card V))
    (hirr : ∀ W : Subgroup V, (∀ h : H, ∀ w ∈ W, h • w ∈ W) → W = ⊥ ∨ W = ⊤)
    {v : V} (hv : v ≠ 1) (hlt : Nat.card (orbit H v) < Nat.card V) :
    derivedSeries H (solvL (Nat.card (orbit H v))) = ⊥ := by
  have hs : ∀ (h : H) (x : V), h • x ∈ orbit H v ↔ x ∈ orbit H v := by
    intro g x
    rw [← orbit_eq_iff, orbit_smul, orbit_eq_iff]
  haveI : Nonempty (orbit H v) := ⟨⟨v, mem_orbit_self v⟩⟩
  have h1 : 1 ≤ Nat.card (orbit H v) := Nat.card_pos
  have hr := ih.range h1 hlt (solvRes (orbit H v) hs)
  exact solv_derivedSeries_eq_bot_of_injective _
    (MonoidHom.rangeRestrict_injective_iff.mpr (dixon_orbit_injective hirr hv hs)) _ hr

/-- **The intransitive case.** -/
theorem dixon_intransitive [Finite V] [IsSolvable H] (ih : SolvDLIH.{0} (Nat.card V))
    (hirr : ∀ W : Subgroup V, (∀ h : H, ∀ w ∈ W, h • w ∈ W) → W = ⊥ ∨ W = ⊤)
    {v w : V} (hv : v ≠ 1) (hw : w ≠ 1) (hvw : w ∉ orbit H v) :
    ∃ m, 1 ≤ m ∧ 2 * m ≤ Nat.card V ∧ derivedSeries H (solvL m) = ⊥ := by
  have hdisj : Disjoint (orbit H v) (orbit H w) := by
    rw [Set.disjoint_left]
    intro x hxv hxw
    apply hvw
    rw [← orbit_eq_iff.mpr hxv, orbit_eq_iff.mpr hxw]
    exact mem_orbit_self w
  have hone : ∀ u : V, u ≠ 1 → (1 : V) ∉ orbit H u := fun u hu h1 => by
    obtain ⟨g, hg⟩ := mem_orbit_iff.mp h1
    exact dixon_smul_ne_one hu hg
  have hcount : (orbit H v).ncard + (orbit H w).ncard + 1 ≤ Nat.card V := by
    have hd2 : Disjoint (orbit H v ∪ orbit H w) {1} := by
      rw [Set.disjoint_singleton_right, Set.mem_union, not_or]
      exact ⟨hone v hv, hone w hw⟩
    rw [← Set.ncard_union_eq hdisj, ← Set.ncard_singleton (1 : V), ← Set.ncard_union_eq hd2,
      ← Set.ncard_univ]
    exact Set.ncard_le_ncard (Set.subset_univ _)
  have hpos : ∀ u : V, 1 ≤ (orbit H u).ncard := fun u =>
    (Set.ncard_pos (Set.toFinite _)).mpr ⟨u, mem_orbit_self u⟩
  have key : ∀ u : V, u ≠ 1 → 2 * (orbit H u).ncard < Nat.card V →
      ∃ m, 1 ≤ m ∧ 2 * m ≤ Nat.card V ∧ derivedSeries H (solvL m) = ⊥ := by
    intro u hu h2
    refine ⟨(orbit H u).ncard, hpos u, h2.le, ?_⟩
    rw [← Nat.card_coe_set_eq]
    apply dixon_orbit_derived ih hirr hu
    rw [Nat.card_coe_set_eq]
    have := hpos u
    omega
  rcases le_total (orbit H v).ncard (orbit H w).ncard with h | h
  · exact key v hv (by omega)
  · exact key w hw (by omega)

/-- The last nontrivial term of the derived series is a commutative normal subgroup. -/
theorem dixon_exists_abelian_normal {G : Type*} [Group G] [IsSolvable G] [Nontrivial G] :
    ∃ A : Subgroup G, A.Normal ∧ A ≠ ⊥ ∧ ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := by
  classical
  have hex : ∃ n, derivedSeries G n = ⊥ := IsSolvable.solvable
  set n₀ := Nat.find hex with hn₀
  have hspec : derivedSeries G n₀ = ⊥ := Nat.find_spec hex
  have hn0 : n₀ ≠ 0 := by
    intro h
    rw [h, derivedSeries_zero] at hspec
    exact top_ne_bot hspec
  have hmin : derivedSeries G (n₀ - 1) ≠ ⊥ := Nat.find_min hex (by omega)
  refine ⟨derivedSeries G (n₀ - 1), derivedSeries_normal G _, hmin, ?_⟩
  intro x hx y hy
  have hc : ⁅x, y⁆ ∈ ⁅derivedSeries G (n₀ - 1), derivedSeries G (n₀ - 1)⁆ :=
    commutator_mem_commutator hx hy
  rw [← derivedSeries_succ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hn0), hspec,
    mem_bot, commutatorElement_eq_one_iff_mul_comm] at hc
  exact hc

/-- **The transitive case.** -/
theorem dixon_transitive [Finite V] [Finite H] [IsSolvable H] [Nontrivial H] [Nontrivial V]
    (ih : SolvDLIH.{0} (Nat.card V))
    (htr : ∀ v w : V, v ≠ 1 → w ≠ 1 → ∃ h : H, h • v = w) :
    ∃ m, 1 ≤ m ∧ 2 * m ≤ Nat.card V ∧ derivedSeries H (solvL m + 2) = ⊥ := by
  classical
  obtain ⟨A, hAn, hA1, hA⟩ := dixon_exists_abelian_normal (G := H)
  haveI := hAn
  obtain ⟨q, hqp, hqd⟩ := Nat.exists_prime_and_dvd (fun h => hA1 (Subgroup.card_eq_one.mp h))
  haveI : Fact q.Prime := ⟨hqp⟩
  obtain ⟨a', ha'⟩ := exists_prime_orderOf_dvd_card' q hqd
  set a : H := (a' : H) with ha_def
  have haA : a ∈ A := a'.2
  have hao : orderOf a = q := by rw [ha_def, Subgroup.orderOf_coe, ha']
  have hn := dixon_conj_mem_zpowers htr A hA haA hao
  have ha1 : a ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hao
    exact hqp.one_lt.ne hao
  have hsr : ∀ u : V, u ≠ 1 → a • u ≠ u := fun u hu hau =>
    ha1 (dixon_semiregular htr A hA haA hu hau)
  set Z := zpowers a with hZdef
  haveI hZ : Z.Normal := ⟨fun z hz g => by
    obtain ⟨m, rfl⟩ := mem_zpowers_iff.mp hz
    rw [← conj_zpow]
    exact zpow_mem (hn g) m⟩
  -- `H` permutes the `Z`-orbits
  have hequi : ∀ (h : H) (u : V), h • orbit Z u = orbit Z (h • u) := by
    intro h u
    ext x
    rw [Set.mem_smul_set, mem_orbit_iff]
    constructor
    · rintro ⟨y, hy, rfl⟩
      obtain ⟨z, rfl⟩ := mem_orbit_iff.mp hy
      refine ⟨⟨h * z * h⁻¹, hZ.conj_mem z z.2 h⟩, ?_⟩
      show (h * (z : H) * h⁻¹) • h • u = h • ((z : H) • u)
      rw [mul_smul, mul_smul, inv_smul_smul]
    · rintro ⟨z, rfl⟩
      have hz' : h⁻¹ * (z : H) * h ∈ Z := by simpa using hZ.conj_mem z z.2 h⁻¹
      refine ⟨(⟨h⁻¹ * z * h, hz'⟩ : Z) • u, mem_orbit _ _, ?_⟩
      show h • ((h⁻¹ * (z : H) * h) • u) = (z : H) • h • u
      rw [mul_smul, mul_smul, smul_inv_smul]
  let β : Set (Set V) := {S | ∃ u : V, u ≠ 1 ∧ S = orbit Z u}
  have hs : ∀ (h : H) (S : Set V), h • S ∈ β ↔ S ∈ β := by
    intro h S
    constructor
    · rintro ⟨u, hu, hS⟩
      refine ⟨h⁻¹ • u, dixon_smul_ne_one hu, ?_⟩
      rw [← hequi, ← hS, inv_smul_smul]
    · rintro ⟨u, hu, rfl⟩
      exact ⟨h • u, dixon_smul_ne_one hu, hequi h u⟩
  set ρ := solvRes β hs with hρ
  -- counting the orbits
  have hr : ∀ S : β, ∃ u : V, u ≠ 1 ∧ (S : Set V) = orbit Z u := fun S => S.2
  choose r hr1 hrS using hr
  let g : β × Bool → V := fun p => if p.2 then a • r p.1 else r p.1
  have hgmem : ∀ p, g p ∈ orbit Z (r p.1) := by
    rintro ⟨S, b⟩
    cases b
    · exact mem_orbit_self _
    · exact mem_orbit (r S) (⟨a, mem_zpowers a⟩ : Z)
  have hg1 : ∀ p, g p ≠ 1 := by
    rintro ⟨S, b⟩
    cases b
    · exact hr1 S
    · exact dixon_smul_ne_one (hr1 S)
  have hginj : Function.Injective g := by
    rintro ⟨S, b⟩ ⟨S', b'⟩ heq
    have hSS : S = S' := by
      apply Subtype.ext
      rw [hrS S, hrS S', ← orbit_eq_iff.mpr (hgmem (S, b)), heq,
        orbit_eq_iff.mpr (hgmem (S', b'))]
    subst hSS
    cases b <;> cases b'
    · rfl
    · exact absurd heq.symm (hsr _ (hr1 S))
    · exact absurd heq (hsr _ (hr1 S))
    · rfl
  have hcount : 2 * Nat.card β + 1 ≤ Nat.card V := by
    let f : Option (β × Bool) → V := fun o => o.elim 1 g
    have hf : Function.Injective f := by
      rintro (_ | p) (_ | p') h
      · rfl
      · exact absurd h.symm (hg1 p')
      · exact absurd h (hg1 p)
      · exact congrArg some (hginj h)
    have := Nat.card_le_card_of_injective f hf
    rw [Finite.card_option, Nat.card_prod, Nat.card_eq_fintype_card (α := Bool), Fintype.card_bool]
      at this
    omega
  obtain ⟨u₀, hu₀⟩ := exists_ne (1 : V)
  haveI : Nonempty β := ⟨⟨orbit Z u₀, u₀, hu₀, rfl⟩⟩
  have hβ1 : 1 ≤ Nat.card β := Nat.card_pos
  -- the kernel
  have hker : ∀ x ∈ ρ.ker, ∀ u : V, u ≠ 1 → ∃ z ∈ Z, x • u = z • u := by
    intro x hx u hu
    have h1 := congrArg Subtype.val
      (Equiv.ext_iff.mp (MonoidHom.mem_ker.mp hx) ⟨orbit Z u, u, hu, rfl⟩)
    rw [hρ, solvRes_apply, Equiv.Perm.one_apply] at h1
    change x • orbit Z u = orbit Z u at h1
    have h2 : x • u ∈ orbit Z u := by
      rw [← h1]
      exact Set.smul_mem_smul_set (mem_orbit_self u)
    obtain ⟨z, hz⟩ := mem_orbit_iff.mp h2
    exact ⟨z, z.2, hz.symm⟩
  have hcz : ∀ x ∈ centralizer {a}, ∀ z ∈ Z, x * z = z * x := by
    intro x hx z hz
    obtain ⟨m, rfl⟩ := mem_zpowers_iff.mp hz
    have hax : Commute a x := mem_centralizer_iff.mp hx a rfl
    exact ((hax.zpow_left m).eq).symm
  have hK : ∀ x ∈ ρ.ker ⊓ centralizer {a}, ∀ y ∈ ρ.ker ⊓ centralizer {a}, x * y = y * x := by
    intro x hx y hy
    apply eq_of_smul_eq_smul (α := V)
    intro u
    by_cases hu : u = 1
    · rw [hu, smul_one, smul_one]
    obtain ⟨z₁, hz₁, hxu⟩ := hker x (mem_inf.mp hx).1 u hu
    obtain ⟨z₂, hz₂, hyu⟩ := hker y (mem_inf.mp hy).1 u hu
    obtain ⟨m₁, rfl⟩ := mem_zpowers_iff.mp hz₁
    obtain ⟨m₂, rfl⟩ := mem_zpowers_iff.mp hz₂
    rw [mul_smul, mul_smul, hyu, hxu, ← mul_smul, ← mul_smul,
      hcz x (mem_inf.mp hx).2 _ hz₂, hcz y (mem_inf.mp hy).2 _ hz₁, mul_smul, mul_smul, hxu, hyu,
      ← mul_smul, ← mul_smul, (Commute.zpow_zpow_self a m₁ m₂).eq]
  -- the derived series
  have hβlt : Nat.card β < Nat.card V := by omega
  have hrange := ih.range hβ1 hβlt ρ
  set s := solvL (Nat.card β)
  have hDs : derivedSeries H s ≤ ρ.ker := fun x hx =>
    MonoidHom.mem_ker.mpr (solv_map_derived_eq_one ρ s hrange hx)
  have hD1 : derivedSeries H 1 ≤ centralizer {a} := by
    rw [derivedSeries_one]
    exact dixon_commutator_le_centralizer hn
  have hDs1 : derivedSeries H (s + 1) ≤ ρ.ker ⊓ centralizer {a} :=
    le_inf ((derivedSeries_antitone H (by omega)).trans hDs)
      ((derivedSeries_antitone H (by omega)).trans hD1)
  refine ⟨Nat.card β, hβ1, by omega, ?_⟩
  rw [eq_bot_iff, derivedSeries_succ]
  refine (commutator_mono hDs1 hDs1).trans ?_
  rw [commutator_le]
  intro x hx y hy
  rw [mem_bot, commutatorElement_eq_one_iff_mul_comm]
  exact hK x hx y hy

/-- **The core bound.** -/
theorem dixon_core [Finite V] [Finite H] [IsSolvable H] [Nontrivial V]
    (ih : SolvDLIH.{0} (Nat.card V))
    (hirr : ∀ W : Subgroup V, (∀ h : H, ∀ w ∈ W, h • w ∈ W) → W = ⊥ ∨ W = ⊤) :
    derivedSeries H (solvL (Nat.card V) - 1) = ⊥ := by
  by_cases htr : ∀ v w : V, v ≠ 1 → w ≠ 1 → ∃ h : H, h • v = w
  · rcases subsingleton_or_nontrivial H with hH | hH
    · exact Subgroup.eq_bot_of_subsingleton _
    · obtain ⟨m, hm1, hm2, hm⟩ := dixon_transitive ih htr
      have := dixon_solvL_add_three hm1 hm2
      exact solv_derivedSeries_bot_mono (by omega) hm
  · push Not at htr
    obtain ⟨v, w, hv, hw, hvw⟩ := htr
    obtain ⟨m, hm1, hm2, hm⟩ := dixon_intransitive ih hirr hv hw (fun h => by
      obtain ⟨g, hg⟩ := mem_orbit_iff.mp h
      exact hvw g hg)
    have := dixon_solvL_add_three hm1 hm2
    exact solv_derivedSeries_bot_mono (by omega) hm

end GI.Proved
