import Workspace.Proved.VsHCoverMath
import Workspace.Proved.VsHGreedyMath

/-!
# Membership in `⟨kept⟩ S` by words

For a list `K` of pairwise commuting elements with `r`-th powers in `S`, where `S` commutes
with them, an element `y` lies in `⟨K⟩ ⊔ S` iff some word `w` of `K` (exponents `< r`) has
`w⁻¹ y ∈ S` (`vsH_mem_sup_iff`).
-/

namespace GI.Proved

open scoped commutatorElement

variable {G : Type*} [Group G]

/-- A subgroup generated by pairwise commuting elements is abelian. -/
theorem vsH_closure_comm {T : Set G} (hT : ∀ a ∈ T, ∀ b ∈ T, a * b = b * a) :
    ∀ x ∈ Subgroup.closure T, ∀ y ∈ Subgroup.closure T, x * y = y * x := by
  have h1 : Subgroup.closure T ≤ Subgroup.centralizer T := by
    refine (Subgroup.closure_le _).2 fun a ha => ?_
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    exact fun b hb => (hT a ha b hb).symm
  have h2 : Subgroup.closure T ≤ Subgroup.centralizer (Subgroup.closure T : Set G) := by
    rw [Subgroup.le_centralizer_iff]
    exact (Subgroup.closure_le _).2 fun a ha x hx => (Subgroup.mem_centralizer_iff.1 (h1 hx) a ha).symm
  intro x hx y hy
  exact Subgroup.mem_centralizer_iff.1 (h2 hy) x hx

/-- **Membership in `⟨K⟩ ⊔ S` by words.** -/
theorem vsH_mem_sup_iff {S : Subgroup G} {r : ℕ} (hr : 0 < r) {K : List G}
    (hc : ∀ a ∈ K, ∀ b ∈ K, a * b = b * a) (hp : ∀ a ∈ K, a ^ r ∈ S)
    (hsc : ∀ s ∈ S, ∀ x ∈ Subgroup.closure {a | a ∈ K}, s * x = x * s) (y : G) :
    y ∈ Subgroup.closure {a | a ∈ K} ⊔ S ↔
      ∃ e : List ℕ, e.length = K.length ∧ (∀ c ∈ e, c < r) ∧ (vsPW K e)⁻¹ * y ∈ S := by
  constructor
  · intro hy
    have hab := vsH_closure_comm (T := {a | a ∈ K}) hc
    refine vsH_cover_W hr ⟨hsc, fun x hx z hz => ?_, fun x hx => ?_⟩ rfl y hy
    · rw [show ⁅x, z⁆ = (1 : G) by rw [commutatorElement_eq_one_iff_mul_comm]; exact hab x hx z hz]
      exact one_mem _
    · induction hx using Subgroup.closure_induction with
      | mem x hx => exact hp x hx
      | one => rw [one_pow]; exact one_mem _
      | mul x z hx hz ihx ihz =>
        rw [(Commute.mul_pow (hab x hx z hz) r)]; exact mul_mem ihx ihz
      | inv x hx ihx => rw [inv_pow]; exact inv_mem ihx
  · rintro ⟨e, -, -, he⟩
    have hW : vsPW K e ∈ Subgroup.closure {a | a ∈ K} :=
      vsPW_mem (fun g hg => Subgroup.subset_closure hg) e
    have : y = vsPW K e * ((vsPW K e)⁻¹ * y) := by group
    rw [this]
    exact mul_mem (Subgroup.mem_sup_left hW) (Subgroup.mem_sup_right he)

end GI.Proved
