module

public import Workspace.Proved.SolvNumeric
public import Workspace.PrimitiveAbelianNormal
public import Workspace.PrimitiveSolvableNormal
public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.Subgroup.Centralizer

@[expose] public section

/-!
# Order of a primitive solvable group

Let `G` act faithfully and primitively on a finite set `V` of size `n`, with `G` solvable and
nontrivial. Then `|G| ≤ n · solvB n n 1` (`GI.Proved.solvPrim_card_le`).

*Proof.* `G` has an abelian minimal normal subgroup `N`. It is transitive, hence regular, so
`|N| = n`. Fix a point `a`. For a subgroup `H ≤ N` let `C(H)` be the set of elements of the
stabilizer `G_a` that commute with every element of `H`.
* `C(N) = 1`: an element of `C(N)` fixes `x • a` for every `x ∈ N`, so it fixes every point.
* If `H < N`, pick `x ∈ N \ H` and let `H'` be generated by `H` and `x`. For `g ∈ C(H)`, the
  conjugate `g x g⁻¹` lies in `N` but not in `H`, and two elements of `C(H)` give the same
  conjugate exactly when they lie in the same coset of `C(H')`. So
  `|C(H)| ≤ (n - |H|) |C(H')|`. Also `|H|` divides `|H'|`, which divides `n`.
Iterating from `H = 1` gives `|G_a| ≤ solvB n n 1`, and `|G| = n |G_a|` by orbit-stabilizer.
-/

namespace GI.Proved

open GI.RadicalSocle GI.PrimitiveStructure

/-- If every fiber of a map `f` on `L` lies in a coset of `K`, then `|L| ≤ |T| |K|`. -/
theorem solv_card_le_mul_of_fibers {G T : Type*} [Group G] [Finite G] [Finite T]
    (L K : Subgroup G) (hKL : K ≤ L) (f : L → T)
    (hf : ∀ a b : L, f a = f b → (a : G)⁻¹ * b ∈ K) :
    Nat.card L ≤ Nat.card T * Nat.card K := by
  let K' : Subgroup L := K.subgroupOf L
  have h1 := Subgroup.card_mul_index K'
  have h2 : Nat.card K' = Nat.card K := Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKL).toEquiv
  have h3 : K'.index ≤ Nat.card T := by
    rw [Subgroup.index]
    apply Nat.card_le_card_of_injective (fun q : L ⧸ K' => f q.out)
    intro q1 q2 hq
    rw [← QuotientGroup.out_eq' q1, ← QuotientGroup.out_eq' q2]
    apply QuotientGroup.eq.mpr
    exact hf _ _ hq
  rw [← h1, h2, mul_comm]
  exact Nat.mul_le_mul_right _ h3

variable {G V : Type*} [Group G] [MulAction G V] [FaithfulSMul G V]

/-- The elements of the stabilizer of `a` that commute with all of `H`. -/
def solvCent (a : V) (H : Subgroup G) : Subgroup G :=
  MulAction.stabilizer G a ⊓ Subgroup.centralizer (H : Set G)

omit [FaithfulSMul G V] in
/-- The centralizer step: `|C(H)| ≤ (|N| - |H|) |C(H')|` for `H' = ⟨H, x⟩`, `x ∈ N \ H`. -/
theorem solvCent_step [Finite G] (a : V) (N H : Subgroup G) [N.Normal] (hHN : H ≤ N)
    (x : G) (hxN : x ∈ N) (hxH : x ∉ H) :
    Nat.card (solvCent a H) ≤ (Nat.card N - Nat.card H) *
      Nat.card (solvCent a (Subgroup.closure ((H : Set G) ∪ {x}))) := by
  classical
  set H' := Subgroup.closure ((H : Set G) ∪ {x})
  have hKL : solvCent a H' ≤ solvCent a H := by
    apply inf_le_inf_left
    apply Subgroup.centralizer_le
    exact (Set.subset_union_left).trans Subgroup.subset_closure
  let T : Set G := (N : Set G) \ (H : Set G)
  have hT : Nat.card T = Nat.card N - Nat.card H := by
    rw [Nat.card_coe_set_eq, Set.ncard_diff hHN]
    rfl
  have hmem : ∀ g : solvCent a H, (g : G) * x * (g : G)⁻¹ ∈ T := by
    intro g
    refine ⟨Subgroup.Normal.conj_mem inferInstance x hxN g, ?_⟩
    intro hc
    apply hxH
    have hg : (g : G) ∈ Subgroup.centralizer (H : Set G) := g.property.2
    have hcomm := Subgroup.mem_centralizer_iff.mp hg _ hc
    have e : x = (g : G)⁻¹ * ((g : G) * x * (g : G)⁻¹) * (g : G) := by group
    rw [e, mul_assoc, hcomm, ← mul_assoc, inv_mul_cancel, one_mul]
    exact hc
  let f : solvCent a H → T := fun g => ⟨(g : G) * x * (g : G)⁻¹, hmem g⟩
  have hf : ∀ g1 g2 : solvCent a H, f g1 = f g2 → (g1 : G)⁻¹ * g2 ∈ solvCent a H' := by
    intro g1 g2 h12
    have h12' : (g1 : G) * x * (g1 : G)⁻¹ = (g2 : G) * x * (g2 : G)⁻¹ :=
      congrArg Subtype.val h12
    have hk : (g1 : G)⁻¹ * g2 ∈ solvCent a H := (solvCent a H).mul_mem
      ((solvCent a H).inv_mem g1.property) g2.property
    refine ⟨hk.1, ?_⟩
    change _ ∈ Subgroup.centralizer ((Subgroup.closure ((H : Set G) ∪ {x})) : Set G)
    rw [Subgroup.centralizer_closure]
    rw [Subgroup.mem_centralizer_iff]
    rintro h (hh | hh)
    · exact Subgroup.mem_centralizer_iff.mp hk.2 h hh
    · rw [Set.mem_singleton_iff] at hh
      subst hh
      have e1 : h = (g1 : G)⁻¹ * ((g1 : G) * h * (g1 : G)⁻¹) * (g1 : G) := by group
      rw [h12'] at e1
      calc h * ((g1 : G)⁻¹ * g2) = (g1 : G)⁻¹ * ((g2 : G) * h * (g2 : G)⁻¹) * (g1 : G) *
            ((g1 : G)⁻¹ * g2) := by rw [← e1]
        _ = (g1 : G)⁻¹ * g2 * h := by group
  have := solv_card_le_mul_of_fibers (solvCent a H) (solvCent a H') hKL f hf
  rw [hT] at this
  exact this

/-- `C(N) = 1` for a transitive normal subgroup `N`. -/
theorem solvCent_top_eq_bot (a : V) (N : Subgroup G) [MulAction.IsPretransitive N V] :
    solvCent a N = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  rw [Subgroup.mem_bot]
  apply eq_of_smul_eq_smul (α := V)
  intro v
  obtain ⟨y, rfl⟩ := MulAction.exists_smul_eq N a v
  have hga : g • a = a := hg.1
  have hcomm : (y : G) * g = g * y := Subgroup.mem_centralizer_iff.mp hg.2 y y.property
  change g • ((y : G) • a) = (1 : G) • ((y : G) • a)
  rw [one_smul, smul_smul, ← hcomm, mul_smul, hga]

/-- The chain bound: `|C(H)| ≤ solvB k n |H|` for `H ≤ N` and enough fuel `k`. -/
theorem solvCent_chain [Finite G] (a : V) (N : Subgroup G) [N.Normal]
    [MulAction.IsPretransitive N V] :
    ∀ k (H : Subgroup G), H ≤ N → Nat.card N - Nat.card H ≤ k →
      Nat.card (solvCent a H) ≤ solvB k (Nat.card N) (Nat.card H) := by
  intro k
  induction k with
  | zero =>
    intro H hHN hk
    have hHeq : H = N := Subgroup.eq_of_le_of_card_ge hHN (by omega)
    subst hHeq
    rw [solvCent_top_eq_bot, Subgroup.card_bot]
    simp [solvB]
  | succ k ih =>
    intro H hHN hk
    by_cases hle : Nat.card N ≤ Nat.card H
    · have hHeq : H = N := Subgroup.eq_of_le_of_card_ge hHN hle
      subst hHeq
      rw [solvCent_top_eq_bot, Subgroup.card_bot, solvB, if_pos hle]
    · have hne : ¬ N ≤ H := fun h => hle (Subgroup.card_le_of_le h)
      obtain ⟨x, hxN, hxH⟩ := Set.not_subset.mp hne
      set H' := Subgroup.closure ((H : Set G) ∪ {x})
      have hHH' : H ≤ H' := (Set.subset_union_left).trans Subgroup.subset_closure
      have hxH' : x ∈ H' := Subgroup.subset_closure (Set.mem_union_right _ rfl)
      have hH'N : H' ≤ N := by
        rw [Subgroup.closure_le]
        exact Set.union_subset hHN (Set.singleton_subset_iff.mpr hxN)
      have hlt : Nat.card H < Nat.card H' := by
        rcases (Subgroup.card_le_of_le hHH').lt_or_eq with h | h
        · exact h
        · exact absurd ((Subgroup.eq_of_le_of_card_ge hHH' h.ge) ▸ hxH') hxH
      have hdiv1 : Nat.card H ∣ Nat.card H' := Subgroup.card_dvd_of_le hHH'
      have hdiv2 : Nat.card H' ∣ Nat.card N := Subgroup.card_dvd_of_le hH'N
      have hstep := solvCent_step a N H hHN x hxN hxH
      have hih := ih H' hH'N (by omega)
      calc Nat.card (solvCent a H) ≤ (Nat.card N - Nat.card H) * Nat.card (solvCent a H') :=
            hstep
        _ ≤ (Nat.card N - Nat.card H) * solvB k (Nat.card N) (Nat.card H') :=
            Nat.mul_le_mul_left _ hih
        _ ≤ solvB (k + 1) (Nat.card N) (Nat.card H) := solvB_step hle ⟨hdiv1, hdiv2, hlt⟩

/-- **Order of a primitive solvable group.** If a nontrivial solvable group `G` acts faithfully
and primitively on a finite set `V`, then `|G| ≤ |V| · solvB |V| |V| 1`. -/
theorem solvPrim_card_le [Finite G] [Group.IsSolvable G] [Nontrivial G]
    [MulAction.IsPreprimitive G V] :
    Nat.card G ≤ Nat.card V * solvB (Nat.card V) (Nat.card V) 1 := by
  haveI : Group.IsSolvable (⊤ : Subgroup G) :=
    solvable_of_solvable_injective (Subgroup.subtype_injective ⊤)
  obtain ⟨N, hN, -, hc⟩ := exists_abelian_normal_of_solvable_normal (⊤ : Subgroup G) top_ne_bot
  haveI := hN.1
  haveI := normal_pretransitive (V := V) N hN.2.1
  have hV : Nonempty V := by
    by_contra hV
    rw [not_nonempty_iff] at hV
    obtain ⟨g, h, hgh⟩ := exists_pair_ne G
    exact hgh (eq_of_smul_eq_smul (α := V) (fun v => isEmptyElim v))
  obtain ⟨a⟩ := hV
  have hcard : Nat.card N = Nat.card V := abelian_normal_card N hN.2.1 hc a
  have h1 := Subgroup.card_mul_index (MulAction.stabilizer G a)
  rw [MulAction.index_stabilizer_of_transitive] at h1
  have hstab : MulAction.stabilizer G a = solvCent a ⊥ := by
    rw [solvCent, Subgroup.coe_bot, Subgroup.centralizer_eq_top_iff_subset.mpr
      (Set.singleton_subset_iff.mpr (Subgroup.mem_center_iff.mpr (fun g => by group))),
      inf_top_eq]
  have h2 := solvCent_chain a N (Nat.card N) ⊥ bot_le (by omega)
  rw [Subgroup.card_bot, ← hstab, hcard] at h2
  rw [← h1, mul_comm]
  exact Nat.mul_le_mul_left _ h2

end GI.Proved
