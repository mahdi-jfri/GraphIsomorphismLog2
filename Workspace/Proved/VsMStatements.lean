import Workspace.Proved.VsTCliff
import Workspace.Cited.AlgoPermGroups

/-!
# Statements of the mathematics M2–M7 of the vector stabilizer algorithm

This file fixes the definitions and the exact statements (as `Prop`s) that the analysis program
of the vector stabilizer (Luks–Miyazaki, Section 5) uses. The proofs are in the other `Proved/VsM*.lean` files.
Everything is about a linear group on a finite-dimensional space `V` over `K = ZMod p`.
The program applies the statements to the local matrices `φ'(H)` on `M' = W/W'`.

Notation. `A ≤ H` is abelian and normal, `L = 𝔽_p[A] = vsTAlg A`. When `L` is a field
(`vsTDom L`), the units of `End V` lying in `L` form the subgroup `S = vsMScal A`
("scalars"). A group `N` with `N ≤ C(A)` commutes with all of `L`.
-/

namespace GI.Proved

open Module
open scoped commutatorElement

section Defs

variable {p : ℕ} [Fact p.Prime] {V : Type} [AddCommGroup V] [Module (ZMod p) V]

/-- The units `u` with `u, u⁻¹ ∈ 𝔽_p[A]`. When `V` is finite-dimensional, `u ∈ 𝔽_p[A]`
is enough (`mem_vsMScal_iff`). -/
def vsMScal (A : Subgroup (End (ZMod p) V)ˣ) : Subgroup (End (ZMod p) V)ˣ where
  carrier := {u | (u : End (ZMod p) V) ∈ vsTAlg A ∧ ((u⁻¹ : (End (ZMod p) V)ˣ) : End (ZMod p) V) ∈ vsTAlg A}
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨?_, ?_⟩
    · rw [Units.val_mul]; exact mul_mem ha hb
    · rw [mul_inv_rev, Units.val_mul]; exact mul_mem hb' ha'
  one_mem' := ⟨by rw [Units.val_one]; exact one_mem _, by rw [inv_one, Units.val_one]; exact one_mem _⟩
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    exact ⟨ha', by rw [inv_inv]; exact ha⟩

/-- `H` normalizes `N`: `h x h⁻¹ ∈ N` for `h ∈ H`, `x ∈ N`. -/
def VsMNorm (H N : Subgroup (End (ZMod p) V)ˣ) : Prop :=
  ∀ h ∈ H, ∀ x ∈ N, h * x * h⁻¹ ∈ N

/-- The units that map each subspace `X i` onto itself. -/
def vsMStab {ι : Type*} (X : ι → Submodule (ZMod p) V) : Subgroup (End (ZMod p) V)ˣ where
  carrier := {g | ∀ i, (X i).map (g : End (ZMod p) V) = X i}
  mul_mem' := by
    intro a b ha hb i
    rw [Units.val_mul, Module.End.mul_eq_comp, Submodule.map_comp, hb i, ha i]
  one_mem' := by
    intro i
    rw [Units.val_one, Module.End.one_eq_id, Submodule.map_id]
  inv_mem' := by
    intro a ha i
    have h1 : (X i).map ((a⁻¹ : (End (ZMod p) V)ˣ) : End (ZMod p) V) =
        ((X i).map (a : End (ZMod p) V)).map ((a⁻¹ : (End (ZMod p) V)ˣ) : End (ZMod p) V) := by
      rw [ha i]
    rw [h1, ← Submodule.map_comp, ← Module.End.mul_eq_comp, ← Units.val_mul, inv_mul_cancel,
      Units.val_one, Module.End.one_eq_id, Submodule.map_id]

/-- The subgroup generated by the `H`-conjugates of `y` ("spinning" `y`). -/
def vsMSpin (H : Subgroup (End (ZMod p) V)ˣ) (y : (End (ZMod p) V)ˣ) : Subgroup (End (ZMod p) V)ˣ :=
  Subgroup.closure {x | ∃ h ∈ H, x = h * y * h⁻¹}

/-- `Y` is minimal `H`-invariant modulo `S`: each `y ∈ Y` outside `S` spins all of `Y`
modulo `S`. -/
def VsMMin (H S Y : Subgroup (End (ZMod p) V)ˣ) : Prop :=
  ∀ y ∈ Y, y ∉ S → Y ≤ vsMSpin H y ⊔ S

/-- `y` is *good*: `y ^ r` is the `r`-th power of a scalar. -/
def vsMGood (A : Subgroup (End (ZMod p) V)ˣ) (r : ℕ) (y : (End (ZMod p) V)ˣ) : Prop :=
  ∃ l ∈ vsMScal A, y ^ r = l ^ r

/-- The algebra `𝔽_p[A ∪ {e_i}]`. -/
def vsMAlgE (A : Subgroup (End (ZMod p) V)ˣ) {k : ℕ} (e : Fin k → (End (ZMod p) V)ˣ) :
    Subalgebra (ZMod p) (End (ZMod p) V) :=
  Algebra.adjoin (ZMod p) (vsTSet A ∪ Set.range fun i => ((e i : (End (ZMod p) V)ˣ) : End (ZMod p) V))

/-- The sum of the pieces `U i` with label `c`. -/
def vsMBlockSum {m : ℕ} (U : Fin m → Submodule (ZMod p) V) (lab : Fin m → ℕ) (c : ℕ) :
    Submodule (ZMod p) V :=
  ⨆ (i) (_ : lab i = c), U i

/-- **The hard case** (design step 4, last part). `H` is solvable, `A ≤ H` abelian normal,
`L = 𝔽_p[A]` a field, `r` prime. `Y` is normalized by `H`, centralizes `A`, has commutators
and `r`-th powers in `S`, is minimal `H`-invariant modulo `S`, and is not abelian. -/
def VsMHard (H A Y : Subgroup (End (ZMod p) V)ˣ) (r : ℕ) : Prop :=
  IsSolvable H ∧ VsTAbNormal H A ∧ vsTDom (vsTAlg A) ∧ r.Prime ∧
  VsMNorm H Y ∧ Y ≤ Subgroup.centralizer (A : Set (End (ZMod p) V)ˣ) ∧
  (∀ x ∈ Y, ∀ y ∈ Y, ⁅x, y⁆ ∈ vsMScal A) ∧ (∀ y ∈ Y, y ^ r ∈ vsMScal A) ∧
  VsMMin H (vsMScal A) Y ∧ ∃ x ∈ Y, ∃ y ∈ Y, x * y ≠ y * x

/-- **The isotropic `E`** (design step 5): `e_1, …, e_k ∈ Y` good, pairwise commuting,
independent modulo `S` (each `e_i` is outside the span of the earlier ones and `S`), and
maximal: every good `y ∈ Y` that commutes with all `e_i` lies in their span with `S`. This is
what a greedy pass over the elements of `Ȳ` produces. -/
def VsMIso (A Y : Subgroup (End (ZMod p) V)ˣ) (r : ℕ) {k : ℕ} (e : Fin k → (End (ZMod p) V)ˣ) :
    Prop :=
  (∀ i, e i ∈ Y) ∧ (∀ i, vsMGood A r (e i)) ∧ (∀ i j, e i * e j = e j * e i) ∧
  (∀ i, e i ∉ Subgroup.closure (e '' {j | j < i}) ⊔ vsMScal A) ∧
  ∀ y ∈ Y, vsMGood A r y → (∀ i, y * e i = e i * y) →
    y ∈ Subgroup.closure (Set.range e) ⊔ vsMScal A

/-- The output of a split by the pieces of a commutative algebra `B`: `B` has no nonzero
`y` with `y ^ p = 0`; and for every family `f` of Frobenius fixed points of `B` spanning them
(as computed by the program), there are exactly `m` nonzero joint eigenspaces `vsFEig f a`,
all of the same dimension, and the units fixing each of them have index at most `bound`
in `H`. -/
def VsMPiecesOut (H : Subgroup (End (ZMod p) V)ˣ) (B : Subalgebra (ZMod p) (End (ZMod p) V))
    (m bound : ℕ) : Prop :=
  (∀ y ∈ B, y ^ p = 0 → y = 0) ∧
  ∀ {ι : Type} (f : ι → End (ZMod p) V), (∀ i, f i ∈ B) → (∀ i, f i ^ p = f i) →
    (∀ s ∈ B, s ^ p = s → s ∈ Submodule.span (ZMod p) (Set.range f)) →
    {a | vsFEig f a ≠ ⊥}.ncard = m ∧
    (∀ a b, vsFEig f a ≠ ⊥ → vsFEig f b ≠ ⊥ →
      finrank (ZMod p) (vsFEig f a) = finrank (ZMod p) (vsFEig f b)) ∧
    (vsMStab (fun a : {a // vsFEig f a ≠ ⊥} => vsFEig f a.1)).relIndex H ≤ bound

end Defs

section Statements

variable (p : ℕ) [Fact p.Prime] (V : Type) [AddCommGroup V] [Module (ZMod p) V]
  [FiniteDimensional (ZMod p) V] [Nontrivial V]

/-! ### Basic facts on `S` -/

/-- `u ∈ S` iff `u ∈ 𝔽_p[A]`. -/
def VsMScalIffStmt : Prop :=
  ∀ (A : Subgroup (End (ZMod p) V)ˣ) (u : (End (ZMod p) V)ˣ),
    u ∈ vsMScal A ↔ (u : End (ZMod p) V) ∈ vsTAlg A

/-- `H` normalizes `S`, and normalizing passes to `N ⊓ C(M)` (used for `C = C_H(A)`, the
radical `N ⊓ C(N)`, and `C_C(Y)`). -/
def VsMNormStmt : Prop :=
  (∀ H A : Subgroup (End (ZMod p) V)ˣ, VsTAbNormal H A → VsMNorm H (vsMScal A)) ∧
  ∀ H N M : Subgroup (End (ZMod p) V)ˣ, VsMNorm H N → VsMNorm H M →
    VsMNorm H (N ⊓ Subgroup.centralizer (M : Set (End (ZMod p) V)ˣ))

/-- When `L` is a field, `|S| + 1 = |L|`, and `c ∈ S` is an `r`-th power in `S` iff
`c ^ (|S| / r) = 1` (for `r ∣ |S|`). This is the test for good elements. -/
def VsMGoodTestStmt : Prop :=
  ∀ (A : Subgroup (End (ZMod p) V)ˣ), (∀ a ∈ A, ∀ b ∈ A, a * b = b * a) →
    vsTDom (vsTAlg A) →
    Nat.card (vsMScal A) + 1 = Nat.card (vsTAlg A) ∧
    ∀ (r : ℕ) (c : (End (ZMod p) V)ˣ), r.Prime → r ∣ Nat.card (vsMScal A) → c ∈ vsMScal A →
      ((∃ l ∈ vsMScal A, c = l ^ r) ↔ c ^ (Nat.card (vsMScal A) / r) = 1)

/-! ### M2: Clifford, blocks, Pálfy -/

/-- Distinct pieces permuted by `H` give a permutation action. -/
def VsMPermStmt : Prop :=
  ∀ (H : Subgroup (End (ZMod p) V)ˣ) {m : ℕ} (U : Fin m → Submodule (ZMod p) V),
    (∀ i, U i ≠ ⊥) → iSupIndep U →
    (∀ h ∈ H, ∀ i, ∃ j, (U i).map ((h : (End (ZMod p) V)ˣ) : End (ZMod p) V) = U j) →
    ∃ π : H →* Equiv.Perm (Fin m),
      ∀ (h : H) i, (U i).map ((h : (End (ZMod p) V)ˣ) : End (ZMod p) V) = U (π h i)

/-- The sum of an `H`-stable set of pieces is `H`-invariant (intransitive case). -/
def VsMOrbitSumStmt : Prop :=
  ∀ (H : Subgroup (End (ZMod p) V)ˣ) {m : ℕ} (U : Fin m → Submodule (ZMod p) V)
    (π : H →* Equiv.Perm (Fin m)) (O : Set (Fin m)),
    (∀ (h : H) i, (U i).map ((h : (End (ZMod p) V)ˣ) : End (ZMod p) V) = U (π h i)) →
    (∀ (h : H), ∀ i ∈ O, π h i ∈ O) → palfyInv H (⨆ i ∈ O, U i)

/-- **M2.** `H` solvable permutes the nonzero independent pieces `U i` (sum `V`) transitively,
and `lab` is a minimal block system of the induced permutation group. Then there are
`b ≥ 2` blocks; the block sums are independent with sum `V`, have dimension `dim V / b`,
are permuted by `H`, and the units fixing every block sum have index at most `(b+1)^24`
in `H` (Pálfy, `palfyBound`). -/
def VsMBlocksStmt : Prop :=
  ∀ (H : Subgroup (End (ZMod p) V)ˣ) {m : ℕ} (U : Fin m → Submodule (ZMod p) V)
    (π : H →* Equiv.Perm (Fin m)) (lab : Fin m → ℕ),
    IsSolvable H → (∀ i, U i ≠ ⊥) → iSupIndep U → iSup U = ⊤ →
    (∀ (h : H) i, (U i).map ((h : (End (ZMod p) V)ˣ) : End (ZMod p) V) = U (π h i)) →
    (∀ i j, ∃ h : H, π h i = j) → GI.Cited.IsMinimalBlocks π.range lab →
    2 ≤ (Set.range lab).ncard ∧
    iSupIndep (fun c : Set.range lab => vsMBlockSum U lab c) ∧
    (⨆ c : Set.range lab, vsMBlockSum U lab c) = ⊤ ∧
    (∀ c ∈ Set.range lab,
      (Set.range lab).ncard * finrank (ZMod p) (vsMBlockSum U lab c) = finrank (ZMod p) V) ∧
    (∀ h ∈ H, ∀ c ∈ Set.range lab, ∃ c' ∈ Set.range lab,
      (vsMBlockSum U lab c).map ((h : (End (ZMod p) V)ˣ) : End (ZMod p) V) = vsMBlockSum U lab c') ∧
    (vsMStab (fun c : Set.range lab => vsMBlockSum U lab c)).relIndex H ≤
      ((Set.range lab).ncard + 1) ^ 24

/-! ### M3: LM Lemma 5.2 -/

/-- **M3** (`vsT_index_centralizer`). -/
def VsMCentStmt : Prop :=
  ∀ H A : Subgroup (End (ZMod p) V)ˣ, VsTAbNormal H A → vsTDom (vsTAlg A) →
    (Subgroup.centralizer (A : Set (End (ZMod p) V)ˣ)).relIndex H ≤ finrank (ZMod p) V

/-! ### M4: the commutator pairing -/

/-- `A` grows: an abelian `N ≤ C(A)` normalized by `H`, not inside `A`. -/
def VsMGrowStmt : Prop :=
  ∀ H A N : Subgroup (End (ZMod p) V)ˣ, VsTAbNormal H A → N ≤ H → VsMNorm H N →
    N ≤ Subgroup.centralizer (A : Set (End (ZMod p) V)ˣ) →
    (∀ x ∈ N, ∀ y ∈ N, x * y = y * x) → ¬ N ≤ A →
    VsTAbNormal H (A ⊔ N) ∧ A < A ⊔ N

/-- Pairing facts for `N ≤ C(A)` with commutators in `S`: the pairing is bimultiplicative;
`⁅x, y⁆ ^ r = 1` when `x ^ r ∈ S`; and if generators have `r`-th powers in `S`, so do all
elements. -/
def VsMPairStmt : Prop :=
  ∀ (A : Subgroup (End (ZMod p) V)ˣ) (T : Set (End (ZMod p) V)ˣ) (r : ℕ),
    T ⊆ Subgroup.centralizer (A : Set (End (ZMod p) V)ˣ) →
    (∀ x ∈ Subgroup.closure T, ∀ y ∈ Subgroup.closure T, ⁅x, y⁆ ∈ vsMScal A) →
    (∀ x ∈ Subgroup.closure T, ∀ y ∈ Subgroup.closure T, ∀ z ∈ Subgroup.closure T,
      ⁅x * y, z⁆ = ⁅x, z⁆ * ⁅y, z⁆ ∧ ⁅x, y * z⁆ = ⁅x, y⁆ * ⁅x, z⁆) ∧
    (∀ x ∈ Subgroup.closure T, ∀ y ∈ Subgroup.closure T, x ^ r ∈ vsMScal A → ⁅x, y⁆ ^ r = 1) ∧
    ((∀ t ∈ T, t ^ r ∈ vsMScal A) → ∀ x ∈ Subgroup.closure T, x ^ r ∈ vsMScal A)

/-- Discrete logarithm in `μ_r ⊆ L` by search. -/
def VsMDlogStmt : Prop :=
  ∀ (A : Subgroup (End (ZMod p) V)ˣ) (r : ℕ) (ζ c : (End (ZMod p) V)ˣ),
    (∀ a ∈ A, ∀ b ∈ A, a * b = b * a) → vsTDom (vsTAlg A) → r.Prime →
    ζ ∈ vsMScal A → ζ ≠ 1 → ζ ^ r = 1 → c ∈ vsMScal A → c ^ r = 1 → ∃ j < r, c = ζ ^ j

/-- **M4, nondegenerate case.** If `N ≤ C(A)` has commutators in `S` and every element of `N`
central in `N` lies in `S`, then `|N : N ∩ S| ≤ (dim V)^2` (Artin independence). -/
def VsMIndepStmt : Prop :=
  ∀ A N : Subgroup (End (ZMod p) V)ˣ, (∀ a ∈ A, ∀ b ∈ A, a * b = b * a) →
    vsTDom (vsTAlg A) → N ≤ Subgroup.centralizer (A : Set (End (ZMod p) V)ˣ) →
    (∀ x ∈ N, ∀ y ∈ N, ⁅x, y⁆ ∈ vsMScal A) →
    (∀ x ∈ N, (∀ y ∈ N, x * y = y * x) → x ∈ vsMScal A) →
    (vsMScal A).relIndex N ≤ finrank (ZMod p) V ^ 2

/-! ### M5: minimal invariant subgroup -/

/-- **M5.** A spun element of least size modulo `S` spins a minimal `H`-invariant subgroup
modulo `S`. (The Pálfy bound for `H` on `Ȳ` is part of the index bound in M6.) -/
def VsMLeastStmt : Prop :=
  ∀ (H S : Subgroup (End (ZMod p) V)ˣ) (x0 : (End (ZMod p) V)ˣ), VsMNorm H S → x0 ∉ S →
    (∀ x ∈ vsMSpin H x0, x ∉ S → S.relIndex (vsMSpin H x0 ⊔ S) ≤ S.relIndex (vsMSpin H x ⊔ S)) →
    VsMMin H S (vsMSpin H x0)

/-! ### M6: the good isotropic `E` -/

/-- **M6.** In the hard case with a maximal good isotropic `E` of dimension `k`:
`|Ȳ| ≤ r^(2k+2)` (so `k ≥ ℓ - 1`, Chevalley–Warning type argument for `r = 2`); `k = 0` only
for `r = 2`; and the pieces of `𝔽_p[A ∪ E]` are exactly `r^k`, of equal dimension, with
stabilizer of index at most `|Ȳ|^69 · r · r^k` in `H`. -/
def VsMHardStmt : Prop :=
  ∀ (H A Y : Subgroup (End (ZMod p) V)ˣ) (r k : ℕ) (e : Fin k → (End (ZMod p) V)ˣ),
    VsMHard H A Y r → VsMIso A Y r e →
    (vsMScal A).relIndex Y ≤ r ^ (2 * k + 2) ∧ (k = 0 → r = 2) ∧
    VsMPiecesOut H (vsMAlgE A e) (r ^ k) ((vsMScal A).relIndex Y ^ 69 * r * r ^ k)

/-! ### M7: the `Q₈` case (LM Proposition 5.11) -/

/-- **M7, first part.** If `E = 0` (so `r = 2`, `|Ȳ| = 4`), the centralizer of `Y` has index
at most `24` in any `C ≤ H` centralizing `A`. -/
def VsMQ8CentStmt : Prop :=
  ∀ (H A Y C : Subgroup (End (ZMod p) V)ˣ) (e : Fin 0 → (End (ZMod p) V)ˣ),
    VsMHard H A Y 2 → VsMIso A Y 2 e → C ≤ H →
    C ≤ Subgroup.centralizer (A : Set (End (ZMod p) V)ˣ) →
    (Subgroup.centralizer (Y : Set (End (ZMod p) V)ˣ)).relIndex C ≤ 24

/-- **M7, second part.** Two commuting `Q₈`-type `Y`, `Y'`: for `y ∈ Y`, `y' ∈ Y'` outside
`S`, the algebra `𝔽_p[A ∪ {y y'}]` has exactly `2` pieces, of equal dimension, with
stabilizer of index at most `72` in `H`. -/
def VsMQ8TwoStmt : Prop :=
  ∀ (H A Y Y' : Subgroup (End (ZMod p) V)ˣ) (e : Fin 0 → (End (ZMod p) V)ˣ)
    (y y' : (End (ZMod p) V)ˣ),
    VsMHard H A Y 2 → VsMIso A Y 2 e → VsMHard H A Y' 2 → VsMIso A Y' 2 e →
    Y' ≤ Subgroup.centralizer (Y : Set (End (ZMod p) V)ˣ) →
    y ∈ Y → y ∉ vsMScal A → y' ∈ Y' → y' ∉ vsMScal A →
    VsMPiecesOut H (vsMAlgE A ![y * y']) 2 72

end Statements

end GI.Proved
