/-!
# Paper statements: the width `aw`, Lemma A.12 (`lem:exact-configuration`)

Section A.5, "Exact coherent-configuration replacement".

* `aw A`: the largest `t ≥ 5` such that a subgroup of `A` has a quotient `Alt(t)`,
  and `0` if there is none. For a finite group, `aw A ≤ b` is exactly
  `GI.SectionCaps.Cap A b` (`aw_le_iff`), the form used in the library.
* the displayed properties of `aw`: monotone under subgroups and quotients, and
  `aw A ≤ max (aw N) (aw (A/N))` for a normal subgroup (stated with a hom `f`, whose
  kernel is `N` and whose image contains `A/N`).
* Lemma A.12, mathematical content.
-/

namespace GI.Paper

open Equiv GI.PairRefinement GI.ExactConfiguration

/-- `aw(A)` (Section A.5): the largest `t ≥ 5` for which a subgroup of `A` has a
quotient isomorphic to `Alt(t)`, with value zero if there is none. -/
noncomputable def aw (A : Type*) [Group A] : ℕ :=
  sSup {t | 5 ≤ t ∧ ∃ (U : Subgroup A) (q : U →* alternatingGroup (Fin t)),
    Function.Surjective q}

theorem cap_card (A : Type*) [Group A] [Finite A] : SectionCaps.Cap A (Nat.card A) := by
  haveI := Fintype.ofFinite A
  have h := SectionCaps.of_injective (MulAction.toPermHom A A)
    (fun a b hab => by
      have := congrArg (fun p : Perm A => p 1) hab
      simpa using this)
    (SectionCaps.permutations (V := A))
  rwa [← Nat.card_eq_fintype_card] at h

/-- For a finite group, `aw A ≤ b` is the library's `SectionCaps.Cap A b`. -/
theorem aw_le_iff {A : Type*} [Group A] [Finite A] (b : ℕ) :
    aw A ≤ b ↔ SectionCaps.Cap A b := by
  have hbdd : BddAbove {t | 5 ≤ t ∧ ∃ (U : Subgroup A) (q : U →* alternatingGroup (Fin t)),
      Function.Surjective q} :=
    ⟨Nat.card A, fun t ⟨ht, U, q, hq⟩ => cap_card A U t ht q hq⟩
  constructor
  · intro h U t ht q hq
    exact (le_csSup hbdd ⟨ht, U, q, hq⟩).trans h
  · intro h
    apply csSup_le'
    rintro t ⟨ht, U, q, hq⟩
    exact h U t ht q hq

theorem cap_aw (A : Type*) [Group A] [Finite A] : SectionCaps.Cap A (aw A) :=
  (aw_le_iff _).mp le_rfl

/-- `aw` is nonincreasing under subgroups. -/
theorem aw_subgroup {A : Type*} [Group A] [Finite A] (U : Subgroup A) : aw U ≤ aw A :=
  (aw_le_iff _).mpr (SectionCaps.subgroup (cap_aw A) U)

/-- `aw` is nonincreasing under quotients (surjective images). -/
theorem aw_quotient {A H : Type*} [Group A] [Group H] [Finite A] [Finite H] (f : A →* H)
    (hf : Function.Surjective f) : aw H ≤ aw A :=
  (aw_le_iff _).mpr (SectionCaps.of_surjective f hf (cap_aw A))

/-- "If `N ◁ A`, then `aw(A) ≤ max {aw(N), aw(A/N)}`", with `N = ker f`. -/
theorem aw_extension {A H : Type*} [Group A] [Group H] [Finite A] [Finite H] (f : A →* H) :
    aw A ≤ max (aw f.ker) (aw H) :=
  (aw_le_iff _).mpr (SectionCaps.extension f (cap_aw _) (cap_aw H))

/-- **Lemma A.12** (Exact-configuration oracle replacement), mathematical content.

Fix `β > max {1 - δ, 1/2}`. There is `q₀` such that, for every nontrivial
homogeneous coherent configuration `c` on `C = ι(Fin n) ⊆ Γ` with `|C| ≥ δ q`,
`q = |Γ| ≥ q₀`:
1. the oracle string lives on `C²`, so it has `n² ≤ q²` positions;
2. the oracle answer, the configuration transporter (`configTransporter`), is empty
   or a coset of the configuration group `configGroup ι c side`;
3. every subgroup `K` of the configuration group has `aw(K) ≤ β q`. The paper's `K`
   (configuration automorphisms, combined with Young groups on the outer color
   classes, fixed individualized points and alternating parity) is such a subgroup.

The parent isomorphisms of the branch map the two configurations onto each other,
so their ideal images lie in the transporter of item 2 by definition.

Deviation (cited input replaced): the primitive case uses Bochert's
bound (proved) instead of Cameron--Maróti, through
`GI.PrimitiveWidth.primitive_cap`; the clique argument is
`GI.PairRefinement.coherent_clique_half`, which proves [H, Exercise 2.15].

Stage 2 (machine level, not stated here): the oracle call itself, "explicitly generated by its kernel and
lifts of generators", and "Bounded `q` is handled by enumerating the original
alternating quotient". -/
theorem lem_exact_configuration {δ β : ℝ} (hβ : max (1 - δ) (1 / 2) < β) :
    ∃ q₀ : ℕ, ∀ (Γ : Type) [Fintype Γ] [DecidableEq Γ] (n : ℕ) (c : Coloring n)
      (side : Bool) (ι : Fin n ↪ Γ), Coherent c → Homogeneous c side →
      NontrivialOffDiagonal c side → δ * Fintype.card Γ ≤ n → q₀ ≤ Fintype.card Γ →
      n * n ≤ Fintype.card Γ * Fintype.card Γ ∧
      (∀ (target : Bool) (g₀ : Perm Γ), g₀ ∈ configTransporter ι c side target →
        ∀ g, g ∈ configTransporter ι c side target ↔ g₀⁻¹ * g ∈ configGroup ι c side) ∧
      ∀ K : Subgroup (Perm Γ), K ≤ configGroup ι c side →
        (aw K : ℝ) ≤ β * Fintype.card Γ := by
  have hδβ : 1 - δ < β := lt_of_le_of_lt (le_max_left _ _) hβ
  have hβ12 : 1 / 2 < β := lt_of_le_of_lt (le_max_right _ _) hβ
  -- Choose `N ≥ 4` with `1/2 + 1/N ≤ β`.
  set N := max 4 ⌈1 / (β - 1 / 2)⌉₊ with hNdef
  have hN : 4 ≤ N := le_max_left _ _
  have hβN : 1 / 2 + 1 / (N : ℝ) ≤ β := by
    have hpos : 0 < β - 1 / 2 := by linarith
    have h1 : 1 / (β - 1 / 2) ≤ (N : ℝ) :=
      (Nat.le_ceil _).trans (by exact_mod_cast le_max_right _ _)
    have hN0 : (0 : ℝ) < N := by exact_mod_cast (by omega : 0 < N)
    have h2 : 1 / (N : ℝ) ≤ β - 1 / 2 := by
      rw [div_le_iff₀ hN0]
      rw [div_le_iff₀ hpos] at h1
      linarith
    linarith
  refine ⟨2 * (4 * 4 ^ N + 8), fun Γ _ _ n c side ι hc hh hn hC hq => ⟨?_, ?_, ?_⟩⟩
  · have : n ≤ Fintype.card Γ := by simpa using Fintype.card_le_of_injective ι ι.injective
    exact Nat.mul_le_mul this this
  · exact fun target g₀ h₀ g => configTransporter_coset ι c side target h₀ g
  · intro K hK
    have hcap := config_cap c hc side hh hn ι K hK hN hβN hδβ hC hq
    have hle := (aw_le_iff _).mpr hcap
    have hβq : 0 ≤ β * Fintype.card Γ := by
      have : (0 : ℝ) ≤ Fintype.card Γ := Nat.cast_nonneg _
      nlinarith
    exact (Nat.cast_le.mpr hle).trans (Nat.floor_le hβq)

/-! ### Lemma A.11 -/

section A11

/-- **Lemma A.11** (Large symmetry at an actual Johnson constituent), first step:
"Consequently `L` contains the pure supported `Alt(Φ) × 1_C`."
`L = π(F_x)` is modeled as a subgroup of `Sym(Φ) × Sym(C)` (its elements preserve the
dominant orbit `Φ` and `C = Γ \ Φ`). Hypotheses: the restriction of `L` to `Φ`
contains `Alt(Φ)`, `|Φ| ≥ 5`, and `|C|! < |Alt(Φ)|` (the paper's
"`|Alt(Φ)| > |C|!` above the fixed base degree"; it holds when `|C| < |Φ|` and
`|Φ| ≥ 5`, since then `|C|! ≤ (|Φ|-1)! < |Φ|!/2`). -/
theorem lem_large_symmetry_constant_cert_pure {Φ C : Type*} [Fintype Φ] [DecidableEq Φ]
    [Fintype C] [DecidableEq C] (L : Subgroup (Perm Φ × Perm C)) (h5 : 5 ≤ Fintype.card Φ)
    (honto : ∀ σ ∈ alternatingGroup Φ, ∃ l ∈ L, l.1 = σ)
    (hsmall : (Fintype.card C).factorial < Nat.card (alternatingGroup Φ)) :
    ∀ σ ∈ alternatingGroup Φ, (σ, (1 : Perm C)) ∈ L :=
  GI.LargeSymmetry.pure_alternating L h5 honto hsmall

/-- **Lemma A.11**, the reduction to the kernel. `H₀` acts on strings `X`,
`θ : H₀ → H₀/K ≅ Alt(Φ)` has kernel `K`, and `A = ⟨a₁, a₂⟩ ≤ Aut_{H₀}(x)` maps onto
`H₀/K` (the lifts of two generators of `Alt(Φ) × 1`, by the first step). Then
1. `Iso_{H₀}(x, z) ≠ ∅ ⟺ Iso_K(x, z) ≠ ∅`;
2. `Aut_{H₀}(x) = Aut_K(x) · A`, i.e. `⟨Aut_K(x), a₁, a₂⟩`;
3. if `t ∈ Iso_K(x, z)`, then `Iso_{H₀}(x, z) = t · Aut_{H₀}(x)`.
So no giant quotient is enumerated. -/
theorem lem_large_symmetry_constant_cert_reduction {G Q X : Type*} [Group G] [Group Q]
    [MulAction G X] (θ : G →* Q) (A : Subgroup G) (x : X) (hA : ∀ a ∈ A, a • x = x)
    (honto : ∀ y : Q, ∃ a ∈ A, θ a = y) :
    (∀ z : X, (∃ g : G, g • x = z) ↔ ∃ k ∈ θ.ker, k • x = z) ∧
    (∀ g : G, g • x = x ↔ ∃ k ∈ θ.ker, k • x = x ∧ ∃ a ∈ A, g = k * a) ∧
    (∀ (z : X) (t : G), t ∈ θ.ker → t • x = z → ∀ g : G, g • x = z ↔ (t⁻¹ * g) • x = x) :=
  ⟨fun z => GI.LargeSymmetry.iso_reduction θ A x hA honto z,
    fun g => GI.LargeSymmetry.aut_generation θ A x hA honto g,
    fun _ _ _ ht g => GI.LargeSymmetry.full_answer ht g⟩

/-- **Lemma A.11**, the physical degree decrease: "every physical `K`-orbit has size at
most `n/2`". Here `p` is the actual Johnson block map, equivariant through
`π : G → Sym(Γ)`, with all fibers of size `f` (the paper's `n / C(q,h)`, by
transitivity of `G`), `1 ≤ h ≤ q/2`, and `π(K)` fixes the dominant orbit
`Φ`, `|Φ| > q/2`, pointwise (`K = π⁻¹(1_Φ × Alt(C))`). -/
theorem lem_large_symmetry_constant_cert_half {Γ G Ω : Type*} [Fintype Γ] [DecidableEq Γ]
    [Group G] [MulAction G Ω] [Fintype Ω] [DecidableEq Ω]
    (π : G →* Perm Γ) (p : Ω → Finset Γ) {h f : ℕ}
    (hp : ∀ (g : G) ω, p (g • ω) = (p ω).map (π g).toEmbedding)
    (hcard : ∀ ω, (p ω).card = h)
    (hfib : ∀ B : Finset Γ, B.card = h → (Finset.univ.filter fun ω => p ω = B).card = f)
    (h1 : 1 ≤ h) (h2 : 2 * h ≤ Fintype.card Γ) (Φ : Finset Γ)
    (hΦ : Fintype.card Γ < 2 * Φ.card) (K : Subgroup G) (hK : ∀ k ∈ K, ∀ a ∈ Φ, π k a = a)
    (ω : Ω) [Fintype (MulAction.orbit K ω)] :
    2 * Fintype.card (MulAction.orbit K ω) ≤ Fintype.card Ω :=
  GI.LargeSymmetry.orbit_half π p hp hcard hfib h1 h2 Φ hΦ K hK ω

/-! #### The groups `H ≥ H₀ ≥ K` and the parity twists

`π : G ↠ Alt(Γ)`; `Φ` is the dominant orbit and `C = Γ \ Φ` is `Φᶜ`.
* `H = π⁻¹((Sym(Φ) × Sym(C)) ∩ Alt(Γ))` is `(permitted Φ Φᶜ).comap π`;
* `H₀ = π⁻¹(Alt(Φ) × Alt(C))` is `(evenSides Φ Φᶜ).comap π`;
* `K = π⁻¹(1_Φ × Alt(C))` is the kernel of the `Φ`-side map `H₀ → Alt(Φ)`. -/

open GI.Rectangle in
/-- **Lemma A.11**, alignment: "choose an even ideal permutation aligning their
dominant orbits, lift it through `π`, and absorb it into the target string. We may
therefore assume that both dominant orbits are the same set `Φ`." If the dominant
orbits `Φ`, `Φ'` of the two strings have the same size (at least two), some `t ∈ G`
has `π(t) Φ = Φ'`, and every `g ∈ G` with `π(g) Φ = Φ'` lies in `t H`. -/
theorem lem_large_symmetry_constant_cert_align {Γ G : Type*} [Fintype Γ] [DecidableEq Γ]
    [Group G] (π : G →* alternatingGroup Γ) (hπ : Function.Surjective π) {Φ Φ' : Finset Γ}
    (hcard : Φ.card = Φ'.card) (h2 : 2 ≤ Φ.card) :
    ∃ t : G, ((π t : Perm Γ) '' (Φ : Set Γ) = Φ') ∧
      ∀ g : G, (π g : Perm Γ) '' (Φ : Set Γ) = Φ' → t⁻¹ * g ∈ (permitted Φ Φᶜ).comap π := by
  obtain ⟨a, ha, -⟩ := exists_even_alignment (R := ∅) (R' := ∅) (Finset.disjoint_empty_right Φ)
    (Finset.disjoint_empty_right Φ') hcard rfl h2
  obtain ⟨t, rfl⟩ := hπ a
  refine ⟨t, ha, fun g hg => ?_⟩
  have compl : ∀ x : G, (π x : Perm Γ) '' (Φ : Set Γ) = Φ' →
      (π x : Perm Γ) '' ((Φᶜ : Finset Γ) : Set Γ) = ((Φ'ᶜ : Finset Γ) : Set Γ) := by
    intro x hx
    rw [Finset.coe_compl, Finset.coe_compl, Set.image_compl_eq (π x : Perm Γ).bijective, hx]
  have := (alignment_coset (π t) ha (compl t ha) (π g)).mp ⟨hg, compl g hg⟩
  rw [Subgroup.mem_comap, map_mul, map_inv]
  exact this

open GI.Rectangle in
/-- **Lemma A.11**, "The index `[H:H₀]` is at most two" (and `H₀ ≤ H`). -/
theorem lem_large_symmetry_constant_cert_index {Γ G : Type*} [Fintype Γ] [DecidableEq Γ]
    [Group G] (π : G →* alternatingGroup Γ) (hπ : Function.Surjective π) (Φ : Finset Γ) :
    (evenSides Φ Φᶜ).comap π ≤ (permitted Φ Φᶜ).comap π ∧
      ((evenSides Φ Φᶜ).comap π).relIndex ((permitted Φ Φᶜ).comap π) ≤ 2 := by
  refine ⟨Subgroup.comap_mono evenSides_le, ?_⟩
  rw [Subgroup.relIndex_comap, Subgroup.map_comap_eq_self_of_surjective hπ]
  exact evenSides_relIndex_le_two Φ

open GI.Rectangle in
/-- **Lemma A.11**, "Here `K ◁ H₀` and `H₀/K ≅ Alt(Φ)`": the `Φ`-side map
`θ : H₀ → Alt(Φ)` is onto, and its kernel `K` consists of the elements whose ideal
image fixes `Φ` pointwise, i.e. `K = π⁻¹(1_Φ × Alt(C))`. This `θ` is the map of
`lem_large_symmetry_constant_cert_reduction`. -/
theorem lem_large_symmetry_constant_cert_quotient {Γ G : Type*} [Fintype Γ] [DecidableEq Γ]
    [Group G] (π : G →* alternatingGroup Γ) (hπ : Function.Surjective π) (Φ : Finset Γ) :
    ∃ θ : (evenSides Φ Φᶜ).comap π →* alternatingGroup Φ, Function.Surjective θ ∧
      ∀ g : (evenSides Φ Φᶜ).comap π, θ g = 1 ↔ ∀ a ∈ Φ, (π g.val : Perm Γ) a = a := by
  refine ⟨(evenLeft Φ Φᶜ).comp (π.subgroupComap (evenSides Φ Φᶜ)), ?_, fun g => ?_⟩
  · intro σ
    obtain ⟨y, rfl⟩ := evenLeft_surjective disjoint_compl_right σ
    obtain ⟨g, hg⟩ := hπ y
    have hmem : g ∈ (evenSides Φ Φᶜ).comap π := by
      rw [Subgroup.mem_comap, hg]; exact y.property
    refine ⟨⟨g, hmem⟩, ?_⟩
    change evenLeft Φ Φᶜ ⟨π g, _⟩ = evenLeft Φ Φᶜ y
    congr 1
    exact Subtype.ext hg
  · exact evenLeft_eq_one_iff _

open GI.Rectangle in
/-- **Lemma A.11**, the second coset: "When a second coset exists, an even paired
transposition, one transposition in each of `Φ` and `C`, supplies its
representative." If `π(t) = (a b)(c d)` with `a ≠ b` in `Φ` and `c ≠ d` in `C`, then
`t ∈ H \ H₀` and `H = H₀ ∪ t H₀`. -/
theorem lem_large_symmetry_constant_cert_twist {Γ G : Type*} [Fintype Γ] [DecidableEq Γ]
    [Group G] (π : G →* alternatingGroup Γ) {Φ : Finset Γ} {a b c d : Γ} (ha : a ∈ Φ)
    (hb : b ∈ Φ) (hab : a ≠ b) (hc : c ∉ Φ) (hd : d ∉ Φ) (hcd : c ≠ d) (t : G)
    (ht : (π t : Perm Γ) = swap a b * swap c d) :
    t ∈ (permitted Φ Φᶜ).comap π ∧ t ∉ (evenSides Φ Φᶜ).comap π ∧
      ∀ g ∈ (permitted Φ Φᶜ).comap π,
        g ∈ (evenSides Φ Φᶜ).comap π ∨ t⁻¹ * g ∈ (evenSides Φ Φᶜ).comap π := by
  have htP : t ∈ (permitted Φ Φᶜ).comap π := by
    change (π t : Perm Γ) ∈ sides Φ Φᶜ
    rw [ht]
    exact (twist_mem_permitted ha hb hab hc hd hcd).2
  have hsign := twist_side_sign ha hb hab hc hd ⟨π t, htP⟩ ht
  refine ⟨htP, fun h => ?_, fun g hg => ?_⟩
  · exact (mem_evenSides_or_twist Φ ⟨π t, htP⟩ ⟨π t, htP⟩ hsign).1 h
  · have := (mem_evenSides_or_twist Φ ⟨π t, htP⟩ ⟨π g, hg⟩ hsign).2
    rw [Subgroup.mem_comap, Subgroup.mem_comap, map_mul, map_inv]
    exact this

open GI.Rectangle in
/-- **Lemma A.11**: a second coset exists only when `|C| ≥ 2`. If `|C| ≤ 1`, then
`H = H₀`. -/
theorem lem_large_symmetry_constant_cert_no_twist {Γ G : Type*} [Fintype Γ] [DecidableEq Γ]
    [Group G] (π : G →* alternatingGroup Γ) (Φ : Finset Γ) (hC : Φᶜ.card ≤ 1) :
    (permitted Φ Φᶜ).comap π = (evenSides Φ Φᶜ).comap π :=
  le_antisymm (Subgroup.comap_mono (permitted_le_evenSides_of_small Φ hC))
    (Subgroup.comap_mono evenSides_le)

/-- **Lemma A.11**, "the parity issue requires at most two target twists": if
`H₀ ≤ H` and `H = H₀ ∪ t H₀`, the full `H`-transporter from `x` to `z` is the
`H₀`-transporter to `z` together with `t` times the `H₀`-transporter to the twisted
target `t⁻¹ z`. -/
theorem lem_large_symmetry_constant_cert_parity_twists {G X : Type*} [Group G] [MulAction G X]
    (H H₀ : Subgroup G) (hle : H₀ ≤ H) (t : G) (htH : t ∈ H)
    (hsplit : ∀ g ∈ H, g ∈ H₀ ∨ t⁻¹ * g ∈ H₀) (x z : X) :
    {g | g ∈ H ∧ g • x = z} =
      {g | g ∈ H₀ ∧ g • x = z} ∪ (fun g => t * g) '' {g | g ∈ H₀ ∧ g • x = t⁻¹ • z} := by
  ext g
  constructor
  · rintro ⟨hg, hgx⟩
    rcases hsplit g hg with h | h
    · exact Or.inl ⟨h, hgx⟩
    · refine Or.inr ⟨t⁻¹ * g, ⟨h, ?_⟩, by simp⟩
      rw [mul_smul, hgx]
  · rintro (⟨h, hgx⟩ | ⟨g', ⟨h, hgx⟩, rfl⟩)
    · exact ⟨hle h, hgx⟩
    · refine ⟨H.mul_mem htH (hle h), ?_⟩
      change (t * g') • x = z
      rw [mul_smul, hgx, smul_inv_smul]

end A11

/-! ### Corollary A.13 -/

section A13

/-- **Corollary A.13** (Fixed-floor reduction), "Every primitive quotient selected
above it is a section of the original block group, so its giant degree is at most
`λ`": if the block action `f : G → B` has `aw(B) ≤ λ`, then every alternating
quotient `Alt(t)`, `t ≥ 5`, of a subgroup `U ≤ G` whose kernel contains `U ∩ ker f`
(a quotient selected above the floor) has `t ≤ λ`. -/
theorem cor_fixed_floor_section_degree {G B : Type*} [Group G] [Group B] [Finite B]
    (f : G →* B) {lam : ℕ} (hB : aw B ≤ lam) (U : Subgroup G) {t : ℕ} (ht : 5 ≤ t)
    (q : U →* alternatingGroup (Fin t)) (hq : Function.Surjective q)
    (habove : ∀ u : U, f u = 1 → q u = 1) : t ≤ lam :=
  SectionCaps.quotient_degree_le ((aw_le_iff lam).mp hB) ht (f.comp U.subtype) q hq
    (fun u hu => habove u hu)

/-- Corollary A.13 and equation (`eq:rho`): "Splitting one ratio into `t` nontrivial
factors decreases `ρ` by at least `t - 1`", for `t = 2`; repeated splitting gives the
general case. `GI.towerRank d = 2⌊log₂ d⌋ - 1` for `d ≥ 2`. -/
theorem cor_fixed_floor_rho_split {a b : ℕ} (ha : 2 ≤ a) (hb : 2 ≤ b) :
    GI.towerRank a + GI.towerRank b + 1 ≤ GI.towerRank (a * b) :=
  GI.tower_rank_split ha hb

/-- Corollary A.13, "A refinement splits a ratio into factors with inherited caps,
so the additivity of `log d` makes `Q` nonincreasing": the term of `d = ab` with cap
`c` equals the sum of the terms of `a` and `b` with the same cap. -/
theorem cor_fixed_floor_Q_split {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (c : ℝ) :
    Real.log (a * b) * Real.log c = Real.log a * Real.log c + Real.log b * Real.log c := by
  rw [Real.log_mul ha.ne' hb.ne', add_mul]

/-- Corollary A.13, "A selected alternating-interval cap decrease `q ↦ β q` reduces `Q`
by `Ω(log d)`": the term `log d · log c` drops by exactly `log d · log (1/β)` when the
cap `c` is replaced by `β c` (both at least `2`, so `max {·, 2}` is inactive). -/
theorem cor_fixed_floor_cap_decrease {d c β : ℝ} (hc : 0 < c) (hβ : 0 < β) :
    Real.log d * Real.log c - Real.log d * Real.log (β * c) =
      Real.log d * Real.log (1 / β) := by
  rw [Real.log_mul hβ.ne' hc.ne', one_div, Real.log_inv]
  ring

end A13

end GI.Paper
