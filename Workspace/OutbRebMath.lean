module

public import Workspace.Impl.TermRepsMath
public import Workspace.Impl.TermCosetMath

@[expose] public section

/-!
# Rebasing a coset table into a subgroup (the mathematics)

Given a subgroup `R ≤ H` and a coset representative `r ∈ H`, for any `z, w : Ω`:
`Iso_R(z, w^{r⁻¹}) = {u ∈ R : u r ∈ Iso_H(z, w)}`.
When `Iso_H(z, w) = g K` with `K = ⟨gs⟩ ≤ H`, we conjugate `K` to `K' = r K r⁻¹ ≤ H` and
enumerate right coset representatives `reps` of `R ∩ K'` in `K'` (at most `[K' : R ∩ K'] ≤ [H : R]`
of them). Then:
1. `{u ∈ R : u r ∈ g K}` is nonempty if and only if `(g r⁻¹) s⁻¹ ∈ R` for some `s ∈ reps`, in which
   case `u₀ = (g r⁻¹) s⁻¹` is a representative.
2. When nonempty, `{u ∈ R : u r ∈ g K} = u₀ (K' ∩ R)`, and `K' ∩ R` is generated by the Schreier
   generators `(s k') s'⁻¹` for `s ∈ reps` and `k'` a generator of `K'`.
-/

namespace GI.Impl

open GI.Multicoset Equiv
open GI.Cited (gens)

/-! ### Transporter in a subgroup after shifting the target -/

section IsoShift

variable {G : Type*} [Group G] {Ω : Type*} [RAct G Ω]

/-- **Transporters in `R ≤ H` to `w^{r⁻¹}` are elements of `R` whose right-translate by `r`
lies in `Iso_H(z, w)`.** -/
theorem outbReb_iso_eq {H R : Subgroup G} (hRH : R ≤ H) {r : G} (hr : r ∈ H) (z w : Ω) :
    Iso R z (w ↼ r⁻¹) = {u | u ∈ R ∧ u * r ∈ Iso H z w} := by
  ext u
  simp only [mem_iso, Set.mem_setOf_eq]
  refine ⟨fun ⟨huR, hzw⟩ => ⟨huR, H.mul_mem (hRH huR) hr, ?_⟩, fun ⟨huR, _, hzw⟩ => ⟨huR, ?_⟩⟩
  · rw [← act_act, hzw, act_act, inv_mul_cancel, act_one]
  · rw [← hzw, act_act, mul_inv_cancel_right]

theorem outbReb_iso_empty {H R : Subgroup G} (hRH : R ≤ H) {r : G} (hr : r ∈ H) {z w : Ω}
    (he : Iso H z w = ∅) : Iso R z (w ↼ r⁻¹) = ∅ := by
  rw [outbReb_iso_eq hRH hr, he]; simp

end IsoShift

/-! ### Relative index and uniqueness of coset representatives -/

section RelIndex

variable {G : Type*} [Group G]

/-- **Relative index is monotone in the ambient subgroup.** -/
theorem outbReb_relIndex_le [Finite G] {H R K : Subgroup G} (hKH : K ≤ H) :
    (R.subgroupOf K).index ≤ (R.subgroupOf H).index := by
  rw [Subgroup.index_eq_card, Subgroup.index_eq_card]
  let f : K ⧸ R.subgroupOf K → H ⧸ R.subgroupOf H :=
    Quotient.lift (fun x : K => (QuotientGroup.mk (Subgroup.inclusion hKH x) : H ⧸ R.subgroupOf H))
      (fun a b hab => by
        rw [QuotientGroup.eq]
        have := QuotientGroup.leftRel_apply.1 hab
        exact this)
  refine Nat.card_le_card_of_injective f ?_
  intro x y hxy
  induction x using QuotientGroup.induction_on with
  | H a =>
    induction y using QuotientGroup.induction_on with
    | H b =>
      change (QuotientGroup.mk (Subgroup.inclusion hKH a) : H ⧸ R.subgroupOf H) =
        QuotientGroup.mk (Subgroup.inclusion hKH b) at hxy
      rw [QuotientGroup.eq] at hxy ⊢
      exact hxy

/-- **At most one listed representative lies in the right coset of `x`.** -/
theorem outbReb_unique {R : Subgroup G} {reps : List G}
    (hd : reps.Pairwise (fun a b => a * b⁻¹ ∉ R)) {x s₁ s₂ : G}
    (h1 : s₁ ∈ reps) (h2 : s₂ ∈ reps) (hx1 : x * s₁⁻¹ ∈ R) (hx2 : x * s₂⁻¹ ∈ R) :
    s₁ = s₂ := by
  have h12 : s₁ * s₂⁻¹ ∈ R := by
    have := R.mul_mem (R.inv_mem hx1) hx2
    convert this using 1; group
  have h21 : s₂ * s₁⁻¹ ∈ R := by
    have := R.inv_mem h12
    convert this using 1; group
  induction hd with
  | nil => cases h1
  | @cons a l ha hd ih =>
    rcases List.mem_cons.1 h1 with h1e | h1m <;> rcases List.mem_cons.1 h2 with h2e | h2m
    · rw [h1e, h2e]
    · subst h1e; exact (ha _ h2m h12).elim
    · subst h2e; exact (ha _ h1m h21).elim
    · exact ih h1m h2m

/-- The index of the first representative `s ∈ reps` with `x s⁻¹ ∈ R`. -/
noncomputable def outbRebIdx (R : Subgroup G) (reps : List G) (x : G) : ℕ := by
  classical
  exact reps.findIdx (fun s => decide (x * s⁻¹ ∈ R))

theorem outbRebIdx_lt_iff (R : Subgroup G) (reps : List G) (x : G) :
    outbRebIdx R reps x < reps.length ↔ TmRpCov R reps x := by
  classical
  unfold outbRebIdx TmRpCov
  simp [List.findIdx_lt_length]

theorem outbRebIdx_mem {R : Subgroup G} {reps : List G} {x : G}
    (h : outbRebIdx R reps x < reps.length) :
    reps[outbRebIdx R reps x] ∈ reps ∧ x * (reps[outbRebIdx R reps x])⁻¹ ∈ R := by
  classical
  refine ⟨List.getElem_mem h, ?_⟩
  have := List.findIdx_getElem (xs := reps) (p := fun s => decide (x * s⁻¹ ∈ R)) (w := h)
  exact of_decide_eq_true this

/-- The element `x s⁻¹ ∈ R` for the first `s ∈ reps` with `x s⁻¹ ∈ R` (or `1` if none). -/
noncomputable def outbRebElem (R : Subgroup G) (reps : List G) (x : G) : G :=
  if h : outbRebIdx R reps x < reps.length then x * (reps[outbRebIdx R reps x]'h)⁻¹ else 1

theorem outbRebElem_spec {R : Subgroup G} {reps : List G} {x : G} (hc : TmRpCov R reps x) :
    outbRebElem R reps x ∈ R ∧
      ∃ s ∈ reps, outbRebElem R reps x = x * s⁻¹ := by
  have hlt : outbRebIdx R reps x < reps.length := (outbRebIdx_lt_iff R reps x).2 hc
  obtain ⟨hs, hxR⟩ := outbRebIdx_mem hlt
  unfold outbRebElem
  rw [dif_pos hlt]
  exact ⟨hxR, reps[outbRebIdx R reps x], hs, rfl⟩

/-- The Schreier generators for one representative `s` across `σ`. -/
noncomputable def outbSchreierRow (R : Subgroup G) (reps σ : List G) (s : G) : List G :=
  σ.map (fun k => outbRebElem R reps (s * k))

/-- All Schreier generators across `reps` and `σ`. -/
noncomputable def outbSchreierGens (R : Subgroup G) (reps σ : List G) : List G :=
  reps.foldl (fun acc s => acc ++ outbSchreierRow R reps σ s) []

theorem mem_foldl_append {α β : Type*} (f : α → List β) (l : List α) (init : List β) (y : β) :
    y ∈ l.foldl (fun acc s => acc ++ f s) init ↔ y ∈ init ∨ ∃ s ∈ l, y ∈ f s := by
  induction l generalizing init with
  | nil => simp
  | cons a l ih =>
    simp only [List.foldl_cons, ih, List.mem_append, List.mem_cons]
    constructor
    · rintro ((h | h) | ⟨s, hs, h⟩)
      · exact Or.inl h
      · exact Or.inr ⟨a, Or.inl rfl, h⟩
      · exact Or.inr ⟨s, Or.inr hs, h⟩
    · rintro (h | ⟨s, rfl | hs, h⟩)
      · exact Or.inl (Or.inl h)
      · exact Or.inl (Or.inr h)
      · exact Or.inr ⟨s, hs, h⟩

theorem mem_outbSchreierGens {R : Subgroup G} {reps σ : List G} {y : G} :
    y ∈ outbSchreierGens R reps σ ↔
      ∃ s ∈ reps, ∃ k ∈ σ, y = outbRebElem R reps (s * k) := by
  unfold outbSchreierGens outbSchreierRow
  rw [mem_foldl_append]
  simp [eq_comm]

theorem length_foldl_append {α β : Type*} (f : α → List β) (c : ℕ)
    (hf : ∀ a, (f a).length = c) (l : List α) (init : List β) :
    (l.foldl (fun acc s => acc ++ f s) init).length = init.length + l.length * c := by
  induction l generalizing init with
  | nil => simp
  | cons a l ih =>
    simp only [List.foldl_cons, ih, List.length_append, hf a, List.length_cons]
    ring

theorem length_outbSchreierGens (R : Subgroup G) (reps σ : List G) :
    (outbSchreierGens R reps σ).length = reps.length * σ.length := by
  unfold outbSchreierGens
  have := length_foldl_append (outbSchreierRow R reps σ) σ.length
    (fun s => by unfold outbSchreierRow; exact List.length_map _) reps []
  simpa using this

theorem foldl_append_init {α β : Type*} (f : α → List β) (l : List α) (a b : List β) :
    l.foldl (fun acc s => acc ++ f s) (a ++ b) =
      a ++ l.foldl (fun acc s => acc ++ f s) b := by
  induction l generalizing b with
  | nil => simp
  | cons x l ih =>
    simp only [List.foldl_cons, List.append_assoc, ih (b ++ f x)]

theorem outbSchreierGens_init_one (R : Subgroup G) (reps σ : List G) :
    reps.foldl (fun acc s => acc ++ outbSchreierRow R reps σ s) [1] =
      1 :: outbSchreierGens R reps σ := by
  have := foldl_append_init (outbSchreierRow R reps σ) reps [1] []
  simpa [outbSchreierGens] using this

end RelIndex

/-! ### Schreier generators and coset intersection in `Perm (Fin n)` -/

section PermSchreier

variable {n : ℕ}

/-- **Schreier's lemma**: the Schreier generators generate `K' ∩ R`. -/
theorem outbSchreier_gens_eq {K' R : Subgroup (Perm (Fin n))}
    {σ : List (Perm (Fin n))} (hK' : gens σ = K')
    {reps : List (Perm (Fin n))} (h1 : (1 : Perm (Fin n)) ∈ reps)
    (hsub : ∀ s ∈ reps, s ∈ K')
    (hd : reps.Pairwise (fun a b => a * b⁻¹ ∉ R))
    (hcov : ∀ x ∈ K', TmRpCov R reps x) :
    gens (outbSchreierGens R reps σ) = K' ⊓ R := by
  set G₀ := gens (outbSchreierGens R reps σ) with hG₀
  have hle : G₀ ≤ K' ⊓ R := by
    rw [hG₀, GI.Cited.gens, Subgroup.closure_le]
    intro y hy
    rw [Set.mem_setOf_eq, mem_outbSchreierGens] at hy
    obtain ⟨s, hs, k, hk, rfl⟩ := hy
    have hkK' : k ∈ K' := by rw [← hK']; exact Subgroup.subset_closure hk
    have hsk : s * k ∈ K' := K'.mul_mem (hsub s hs) hkK'
    obtain ⟨hR, s', hs', heq⟩ := outbRebElem_spec (hcov _ hsk)
    refine ⟨?_, hR⟩
    rw [heq]
    exact K'.mul_mem hsk (K'.inv_mem (hsub s' hs'))
  refine le_antisymm hle ?_
  have hstep : ∀ x, (∃ s ∈ reps, x * s⁻¹ ∈ G₀) →
      ∀ k ∈ σ, ∃ s' ∈ reps, (x * k) * s'⁻¹ ∈ G₀ := by
    rintro x ⟨s, hs, hxs⟩ k hk
    have hkK' : k ∈ K' := by rw [← hK']; exact Subgroup.subset_closure hk
    have hsk : s * k ∈ K' := K'.mul_mem (hsub s hs) hkK'
    obtain ⟨-, s', hs', heq⟩ := outbRebElem_spec (hcov _ hsk)
    have hmem : outbRebElem R reps (s * k) ∈ G₀ := by
      rw [hG₀]
      exact Subgroup.subset_closure (mem_outbSchreierGens.2 ⟨s, hs, k, hk, rfl⟩)
    rw [heq] at hmem
    refine ⟨s', hs', ?_⟩
    have := G₀.mul_mem hxs hmem
    convert this using 1; group
  have hpow : ∀ x, (∃ s ∈ reps, x * s⁻¹ ∈ G₀) →
      ∀ k ∈ σ, ∀ m : ℕ, ∃ s' ∈ reps, (x * k ^ m) * s'⁻¹ ∈ G₀ := by
    intro x hx k hk m
    induction m with
    | zero => simpa using hx
    | succ m ih => rw [pow_succ, ← mul_assoc]; exact hstep _ ih k hk
  have hind : ∀ x ∈ K', ∃ s ∈ reps, x * s⁻¹ ∈ G₀ := by
    rw [← hK']
    intro x hx
    induction hx using Subgroup.closure_induction_right with
    | one => exact ⟨1, h1, by simp [G₀.one_mem]⟩
    | mul_right y _ k hk ih => exact hstep y ih k hk
    | mul_inv_cancel y _ k hk ih =>
      rw [tmRp_mul_inv_eq_pow]
      exact hpow y ih k hk _
  intro x ⟨hxK', hxR⟩
  obtain ⟨s, hs, hxs⟩ := hind x hxK'
  have hxsR : x * s⁻¹ ∈ R := (hle hxs).2
  have hs1 : s = 1 := outbReb_unique hd hs h1 hxsR (by simpa using hxR)
  subst hs1
  simpa using hxs

/-- Conjugating `(1 :: gs)` by `r` generates `r ⟨gs⟩ r⁻¹`. -/
theorem outbReb_mem_gens_conj (r : Perm (Fin n)) (gs : List (Perm (Fin n))) (x : Perm (Fin n)) :
    x ∈ gens ((1 :: gs).map (fun k => r * k * r⁻¹)) ↔ r⁻¹ * x * r ∈ gens gs := by
  constructor
  · intro hx
    have hle : gens ((1 :: gs).map (fun k => r * k * r⁻¹)) ≤
        (gens gs).comap (MulAut.conj r⁻¹).toMonoidHom := by
      rw [GI.Cited.gens, Subgroup.closure_le]
      intro y hy
      rw [Set.mem_setOf_eq, List.mem_map] at hy
      obtain ⟨k, hk, rfl⟩ := hy
      simp only [SetLike.mem_coe, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom,
        MulAut.conj_apply]
      have : r⁻¹ * (r * k * r⁻¹) * r⁻¹⁻¹ = k := by group
      rw [this]
      rcases List.mem_cons.1 hk with rfl | hk
      · exact (gens gs).one_mem
      · exact Subgroup.subset_closure hk
    have := hle hx
    simpa [Subgroup.mem_comap, MulAut.conj_apply] using this
  · intro hx
    have hle : gens gs ≤
        (gens ((1 :: gs).map (fun k => r * k * r⁻¹))).comap (MulAut.conj r).toMonoidHom := by
      rw [GI.Cited.gens, Subgroup.closure_le]
      intro k hk
      simp only [SetLike.mem_coe, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom,
        MulAut.conj_apply]
      exact Subgroup.subset_closure (List.mem_map.2 ⟨k, List.mem_cons_of_mem _ hk, rfl⟩)
    have := hle hx
    simp only [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at this
    convert this using 1; group

theorem outbReb_conj_sub {H : Subgroup (Perm (Fin n))} {r : Perm (Fin n)} (hr : r ∈ H)
    {gs : List (Perm (Fin n))} (hgs : gens gs ≤ H) :
    ∀ k' ∈ (1 :: gs).map (fun k => r * k * r⁻¹), k' ∈ H := by
  intro k' hk'
  obtain ⟨k, hk, rfl⟩ := List.mem_map.1 hk'
  have hkH : k ∈ H := by
    rcases List.mem_cons.1 hk with rfl | hk
    · exact H.one_mem
    · exact hgs (Subgroup.subset_closure hk)
  exact H.mul_mem (H.mul_mem hr hkH) (H.inv_mem hr)

/-- **When `(g r⁻¹)` is not covered by `reps`, the coset intersection with `R` is empty.** -/
theorem outbReb_empty_of_not_cov {R : Subgroup (Perm (Fin n))}
    {r g : Perm (Fin n)} {gs reps : List (Perm (Fin n))}
    (hcov : ∀ x ∈ gens ((1 :: gs).map (fun k => r * k * r⁻¹)), TmRpCov R reps x)
    (hncov : ¬ TmRpCov R reps (g * r⁻¹)) :
    {u | u ∈ R ∧ u * r ∈ (fun k => g * k) '' (gens gs : Set (Perm (Fin n)))} = ∅ := by
  ext u
  simp only [Set.mem_setOf_eq, Set.mem_image, SetLike.mem_coe, Set.mem_empty_iff_false,
    iff_false, not_and]
  rintro huR ⟨k, hk, hur⟩
  have hk' : r * k⁻¹ * r⁻¹ ∈ gens ((1 :: gs).map (fun k => r * k * r⁻¹)) := by
    rw [outbReb_mem_gens_conj]
    have : r⁻¹ * (r * k⁻¹ * r⁻¹) * r = k⁻¹ := by group
    rw [this]
    exact (gens gs).inv_mem hk
  obtain ⟨s, hs, hms⟩ := hcov _ hk'
  apply hncov
  refine ⟨s, hs, ?_⟩
  have heq : (g * r⁻¹) * s⁻¹ = u * ((r * k⁻¹ * r⁻¹) * s⁻¹) := by
    have hu : u = g * k * r⁻¹ := by rw [hur]; group
    rw [hu]; group
  rw [heq]
  exact R.mul_mem huR hms

/-- **When `(g r⁻¹) s⁻¹ ∈ R` for `s ∈ reps`, the coset intersection with `R` is the left coset
`((g r⁻¹) s⁻¹) (K' ∩ R)`.** -/
theorem outbReb_coset_of_cov {R : Subgroup (Perm (Fin n))}
    {r g : Perm (Fin n)} {gs reps : List (Perm (Fin n))}
    (hsub : ∀ s ∈ reps, s ∈ gens ((1 :: gs).map (fun k => r * k * r⁻¹)))
    {s : Perm (Fin n)} (hs : s ∈ reps) (hu0 : (g * r⁻¹) * s⁻¹ ∈ R) :
    {u | u ∈ R ∧ u * r ∈ (fun k => g * k) '' (gens gs : Set (Perm (Fin n)))} =
      (fun w => ((g * r⁻¹) * s⁻¹) * w) ''
        (((gens ((1 :: gs).map (fun k => r * k * r⁻¹)) ⊓ R :
          Subgroup (Perm (Fin n))) : Set (Perm (Fin n)))) := by
  set K' := gens ((1 :: gs).map (fun k => r * k * r⁻¹))
  set u0 := (g * r⁻¹) * s⁻¹
  have hsK' : s ∈ K' := hsub s hs
  ext u
  simp only [Set.mem_setOf_eq, Set.mem_image, SetLike.mem_coe, Subgroup.mem_inf]
  constructor
  · rintro ⟨huR, k, hk, hur⟩
    refine ⟨u0⁻¹ * u, ⟨?_, R.mul_mem (R.inv_mem hu0) huR⟩, by group⟩
    have heq : u0⁻¹ * u = s * (r * k * r⁻¹) := by
      have hu : u = g * k * r⁻¹ := by rw [hur]; group
      simp only [u0, hu]; group
    rw [heq]
    refine K'.mul_mem hsK' ?_
    rw [outbReb_mem_gens_conj]
    have : r⁻¹ * (r * k * r⁻¹) * r = k := by group
    rw [this]; exact hk
  · rintro ⟨w, ⟨hwK', hwR⟩, rfl⟩
    refine ⟨R.mul_mem hu0 hwR, r⁻¹ * (s⁻¹ * w) * r, ?_, by simp only [u0]; group⟩
    rw [← outbReb_mem_gens_conj]
    exact K'.mul_mem (K'.inv_mem hsK') hwK'

/-- Conjugating a left coset `x₀ ⟨gs⟩` on the right by `r`:
`(x₀ ⟨gs⟩) r = (x₀ r) ⟨r⁻¹ gs r⟩`. -/
theorem outbReb_right_translate (x0 r : Perm (Fin n)) (gs : List (Perm (Fin n))) :
    (fun z => z * r) '' ((fun k => x0 * k) '' (gens gs : Set (Perm (Fin n)))) =
      (fun k => (x0 * r) * k) ''
        (gens (gs.map (fun g => r⁻¹ * g * r)) : Set (Perm (Fin n))) := by
  have hmem : ∀ k : Perm (Fin n),
      k ∈ gens (gs.map (fun g => r⁻¹ * g * r)) ↔ r * k * r⁻¹ ∈ gens gs := by
    intro k
    constructor
    · intro hk
      have hle : gens (gs.map (fun g => r⁻¹ * g * r)) ≤
          (gens gs).comap (MulAut.conj r).toMonoidHom := by
        rw [GI.Cited.gens, Subgroup.closure_le]
        intro y hy
        rw [Set.mem_setOf_eq, List.mem_map] at hy
        obtain ⟨g, hg, rfl⟩ := hy
        simp only [SetLike.mem_coe, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom,
          MulAut.conj_apply]
        have : r * (r⁻¹ * g * r) * r⁻¹ = g := by group
        rw [this]
        exact Subgroup.subset_closure hg
      have := hle hk
      simpa [Subgroup.mem_comap, MulAut.conj_apply] using this
    · intro hk
      have hle : gens gs ≤
          (gens (gs.map (fun g => r⁻¹ * g * r))).comap (MulAut.conj r⁻¹).toMonoidHom := by
        rw [GI.Cited.gens, Subgroup.closure_le]
        intro g hg
        simp only [SetLike.mem_coe, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom,
          MulAut.conj_apply]
        exact Subgroup.subset_closure (List.mem_map.2 ⟨g, hg, rfl⟩)
      have := hle hk
      simp only [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at this
      convert this using 1; group
  ext h
  simp only [Set.mem_image, SetLike.mem_coe]
  constructor
  · rintro ⟨_, ⟨k, hk, rfl⟩, rfl⟩
    refine ⟨r⁻¹ * k * r, ?_, by group⟩
    rw [hmem]
    have : r * (r⁻¹ * k * r) * r⁻¹ = k := by group
    rw [this]; exact hk
  · rintro ⟨k', hk', rfl⟩
    refine ⟨x0 * (r * k' * r⁻¹), ⟨r * k' * r⁻¹, (hmem k').1 hk', rfl⟩, by group⟩

end PermSchreier

end GI.Impl
