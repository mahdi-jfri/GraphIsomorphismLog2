import Workspace.SolvableSupplement
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.GroupTheory.GroupAction.ConjAct

namespace GI.RadicalSocle

variable {G : Type*} [Group G]

/-- Minimality among nontrivial normal subgroups, not among all subgroups. -/
def MinimalNormal (N : Subgroup G) : Prop :=
  N.Normal ∧ N ≠ ⊥ ∧ ∀ M : Subgroup G, M.Normal → M ≤ N → M = ⊥ ∨ M = N

theorem exists_minimal_normal_le [Finite G] (N : Subgroup G) [N.Normal] (hne : N ≠ ⊥) :
    ∃ M : Subgroup G, MinimalNormal M ∧ M ≤ N := by
  classical
  let candidates : Set (Subgroup G) := {M | M.Normal ∧ M ≠ ⊥ ∧ M ≤ N}
  have hnonempty : candidates.Nonempty := ⟨N, inferInstance, hne, le_rfl⟩
  obtain ⟨M, hM, hmin'⟩ := Set.Finite.exists_minimalFor id candidates
    (Set.toFinite candidates) hnonempty
  have hmin : ∀ K ∈ candidates, K ≤ M → M = K :=
    fun K hK hKM => le_antisymm (hmin' hK hKM) hKM
  refine ⟨M, ⟨hM.1, hM.2.1, ?_⟩, hM.2.2⟩
  intro K hK hKM
  by_cases hzero : K = ⊥
  · exact Or.inl hzero
  · exact Or.inr (hmin K ⟨hK, hzero, hKM.trans hM.2.2⟩ hKM).symm

/-- The actual subgroup generated by the minimal normal subgroups. Taking
normal closure gives its normality directly, since every generator subgroup
is already normal. -/
def socle (G : Type*) [Group G] : Subgroup G :=
  Subgroup.normalClosure {g | ∃ N : Subgroup G, MinimalNormal N ∧ g ∈ N}

instance socle_normal : (socle G).Normal := Subgroup.normalClosure_normal

theorem minimalNormal_le_socle {N : Subgroup G} (hN : MinimalNormal N) : N ≤ socle G := by
  intro g hg
  exact Subgroup.subset_normalClosure ⟨N, hN, hg⟩

theorem socle_le_normal (N : Subgroup G) [N.Normal]
    (h : ∀ M : Subgroup G, MinimalNormal M → M ≤ N) : socle G ≤ N := by
  apply Subgroup.normalClosure_le_normal
  rintro g ⟨M, hM, hg⟩
  exact h M hM hg

/-- The centralizer of an actual normal subgroup is normal. -/
theorem centralizer_normal (N : Subgroup G) [N.Normal] :
    (Subgroup.centralizer (N : Set G)).Normal := by
  constructor
  intro c hc g
  change ∀ n ∈ N, n * (g * c * g⁻¹) = (g * c * g⁻¹) * n
  intro n hn
  have hn' : g⁻¹ * n * g ∈ N := by
    simpa only [inv_inv] using (inferInstance : N.Normal).conj_mem n hn g⁻¹
  have he := congrArg (fun z : G => g * z * g⁻¹) (hc (g⁻¹ * n * g) hn')
  simpa only [mul_assoc, mul_inv_cancel_left, inv_mul_cancel_left, mul_inv_cancel_right,
    inv_mul_cancel_right, mul_inv_cancel, mul_one] using he

/-- A finite group with no nontrivial solvable normal subgroup has trivial
socle centralizer. No classification or simple-factor decomposition is used. -/
theorem socle_centralizer_eq_bot [Finite G]
    (radicalFree : ∀ N : Subgroup G, N.Normal → IsSolvable N → N = ⊥) :
    Subgroup.centralizer (socle G : Set G) = ⊥ := by
  classical
  by_contra hn
  let C := Subgroup.centralizer (socle G : Set G)
  letI : C.Normal := centralizer_normal (socle G)
  obtain ⟨M, hM, hMC⟩ := exists_minimal_normal_le C hn
  have hMS := minimalNormal_le_socle hM
  have hcomm : ∀ x y : M, x * y = y * x := by
    intro x y
    apply Subtype.ext
    exact (hMC x.property y (hMS y.property)).symm
  have hsolv : IsSolvable M := isSolvable_of_comm hcomm
  exact hM.2.1 (radicalFree M hM.1 hsolv)

def socleConjugation : G →* MulAut (socle G) := MulAut.conjNormal

theorem socleConjugation_ker :
    (socleConjugation (G := G)).ker = Subgroup.centralizer (socle G : Set G) := by
  ext g
  constructor
  · intro hg
    change socleConjugation g = 1 at hg
    intro x hx
    have he := congrArg (fun f : MulAut (socle G) => (f ⟨x, hx⟩ : G)) hg
    change g * x * g⁻¹ = x at he
    have hh := congrArg (fun z : G => z * g) he
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using hh.symm
  · intro hg
    change socleConjugation g = 1
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    change g * x.val * g⁻¹ = x.val
    rw [← hg x.val x.property]
    simp only [mul_assoc, mul_inv_cancel, mul_one]

/-- The faithful conjugation embedding needed at the beginning of A.24. -/
theorem socleConjugation_injective [Finite G]
    (radicalFree : ∀ N : Subgroup G, N.Normal → IsSolvable N → N = ⊥) :
    Function.Injective (socleConjugation (G := G)) := by
  apply (socleConjugation (G := G)).ker_eq_bot_iff.mp
  rw [socleConjugation_ker, socle_centralizer_eq_bot radicalFree]

end GI.RadicalSocle
