import Workspace.Assembly.Refinement
import Workspace.Lang.Lib.Tabulate

/-!
# The pair state of Algorithm 1, entry by entry

`BuildSpec` (`Workspace/Assembly/Refinement.lean`) asks for the value of `graphState G H` on the
positions `Fin (n * n)` (`pairEnum n`). This file computes the entries of that value as numbers,
so that a program can produce them one by one (`Workspace/Assembly/Build.lean`).

* **Group.** The diagonal action of `Sym(n)` is generated by the diagonal images of all
  transpositions `(i j)` (`gens_pairGens`). Position `p` is the pair `(p / n, p % n)`, so the
  image of `(i j)` sends `p` to `s (p % n) + n * s (p / n)`, where `s` swaps `i` and `j`
  (`pairSwap_val`).
* **Colors.** The color of position `p` is `2 [p / n = p % n] + [p / n ~ p % n]`
  (`pairColor_code`).
-/

namespace GI.Assembly

open GI.Algorithm GI.Lang GI.Paper Equiv Equiv.Perm
open GI.Cited (Val encPerm encPerms encGroup gens)
open scoped Pointwise

variable {n : ℕ}

/-! ### Transpositions on numbers -/

/-- The transposition of `i` and `j`, on numbers. -/
def swapNat (i j x : ℕ) : ℕ := if x = i then j else if x = j then i else x

theorem swapNat_lt {i j x : ℕ} (hi : i < n) (hj : j < n) (hx : x < n) : swapNat i j x < n := by
  unfold swapNat; split_ifs <;> assumption

theorem swap_val (i j x : Fin n) : (swap i j x : ℕ) = swapNat i j x := by
  rw [swap_apply_def, swapNat]
  by_cases h1 : x = i
  · simp [h1]
  · by_cases h2 : x = j
    · subst h2; simp [h1, Fin.val_ne_of_ne h1]
    · simp [h1, h2, Fin.val_ne_of_ne h1, Fin.val_ne_of_ne h2]

/-! ### The generators -/

/-- The diagonal image of the transposition `(i j)`, on the positions `Fin (n * n)`. -/
def pairSwap (i j : Fin n) : Perm (Fin (n * n)) :=
  toFin (pairEnum n) (diagonalHom (Fin n) (swap i j))

theorem pairEnum_symm_apply (p : Fin (n * n)) : (pairEnum n).symm p = (p.divNat, p.modNat) :=
  rfl

theorem pairEnum_val (a : Fin n × Fin n) : ((pairEnum n a : Fin (n * n)) : ℕ) = a.2 + n * a.1 :=
  rfl

/-- **The entries of a generator.** -/
theorem pairSwap_val (i j : Fin n) (p : Fin (n * n)) :
    (pairSwap i j p : ℕ) = swapNat i j (p % n) + n * swapNat i j (p / n) := by
  show ((pairEnum n (diagonalHom (Fin n) (swap i j) ((pairEnum n).symm p)) : Fin (n * n)) : ℕ) = _
  rw [pairEnum_symm_apply, diagonalHom_apply, pairEnum_val, swap_val, swap_val]
  rfl

/-- The generators: the diagonal images of `(i j)` for every position `t = (i, j)`. -/
def pairGens (n : ℕ) : List (Perm (Fin (n * n))) :=
  (List.finRange (n * n)).map fun t => pairSwap t.divNat t.modNat

/-- The diagonal action on positions, as a homomorphism. -/
def pairHom (n : ℕ) : Perm (Fin n) →* Perm (Fin (n * n)) :=
  (toFin (pairEnum n)).toMonoidHom.comp (diagonalHom (Fin n))

theorem pairHom_apply (σ : Perm (Fin n)) : pairHom n σ = toFin (pairEnum n) (diagonalHom _ σ) :=
  rfl

theorem pairHom_injective : Function.Injective (pairHom n) :=
  (toFin (pairEnum n)).injective.comp diagonalHom_injective

/-- The group of `graphState`, on positions, is the image of `pairHom`. -/
theorem groupFin_graphState (G H : SimpleGraph (Fin n)) [DecidableRel G.Adj]
    [DecidableRel H.Adj] : groupFin (pairEnum n) (graphState G H).G = (pairHom n).range := by
  simp only [graphState, groupFin, pairHom, MonoidHom.range_comp]

theorem mem_pairGens {g : Perm (Fin (n * n))} :
    g ∈ pairGens n ↔ ∃ a b : Fin n, pairHom n (swap a b) = g := by
  simp only [pairGens, List.mem_map, List.mem_finRange, true_and]
  constructor
  · rintro ⟨t, rfl⟩; exact ⟨_, _, rfl⟩
  · rintro ⟨a, b, rfl⟩
    refine ⟨pairEnum n (a, b), ?_⟩
    have h := (pairEnum n).symm_apply_apply (a, b)
    rw [pairEnum_symm_apply] at h
    simp only [Prod.mk.injEq] at h
    rw [h.1, h.2]; rfl

/-- **The generators generate the diagonal action.** -/
theorem gens_pairGens : gens (pairGens n) = (pairHom n).range := by
  have hS : {g | g ∈ pairGens n} = pairHom n '' {σ | ∃ a b : Fin n, swap a b = σ} := by
    ext g
    simp only [Set.mem_setOf_eq, mem_pairGens, Set.mem_image]
    constructor
    · rintro ⟨a, b, rfl⟩; exact ⟨_, ⟨a, b, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨a, b, rfl⟩, rfl⟩; exact ⟨a, b, rfl⟩
  have htop : Subgroup.closure {σ : Perm (Fin n) | ∃ a b : Fin n, swap a b = σ} = ⊤ := by
    refine top_le_iff.mp ?_
    rw [← closure_isSwap]
    refine Subgroup.closure_mono ?_
    rintro σ ⟨a, b, -, rfl⟩
    exact ⟨a, b, rfl⟩
  rw [gens, hS, ← MonoidHom.map_closure, htop, ← MonoidHom.range_eq_map]

/-- The group value of the pair state. -/
theorem groupVal_pairGens (G H : SimpleGraph (Fin n)) [DecidableRel G.Adj] [DecidableRel H.Adj] :
    GroupVal (n * n) (encGroup (pairGens n)) (groupFin (pairEnum n) (graphState G H).G) := by
  rw [groupFin_graphState]
  exact GensVal.groupVal gens_pairGens

/-! ### The colors -/

open Classical in
/-- The adjacency entry of `G` at `(a, b)`, as a number. -/
noncomputable def adjNat (G : SimpleGraph (Fin n)) (a b : Fin n) : ℕ := if G.Adj a b then 1 else 0

open Classical in
/-- **The color of a position.** -/
theorem pairColor_code (G : SimpleGraph (Fin n)) (p : Fin (n * n)) :
    pairCode (pairColor G ((pairEnum n).symm p)) =
      2 * (if (p : ℕ) / n = (p : ℕ) % n then 1 else 0) + adjNat G p.divNat p.modNat := by
  rw [pairEnum_symm_apply, pairCode, pairColor, adjNat]
  simp only [Fin.ext_iff, Fin.coe_divNat, Fin.coe_modNat]
  by_cases h1 : (p : ℕ) / n = (p : ℕ) % n <;> by_cases h2 : G.Adj p.divNat p.modNat <;>
    simp [h1, h2]

theorem pairCode_le (c : Bool × Bool) : pairCode c ≤ 3 := by
  rcases c with ⟨a, b⟩; cases a <;> cases b <;> simp [pairCode]

end GI.Assembly
