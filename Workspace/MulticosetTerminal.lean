module

public import Workspace.MulticosetRadical
public import Mathlib.GroupTheory.SpecificGroups.Alternating

@[expose] public section

/-!
# Theorem A.23: the transitive-kernel terminal

The setting of the subsubsection "An exact terminal supplied by the row normal form". A string
on `B × [m]` is a row tuple `x : Fin m → Ω`, where `Ω` is the set of strings on `B` with the
right action of `Sym(B)`. The normal data are `N ◁ H ≤ Sym(B)` and a homomorphism
`φ : N → A` to an abelian group (the quotient map `N → N/N*`).

* `J = 𝓜 R₀` is modeled by pairs `(μ, π)`: `μ ∈ N^m` with label sum `∏ φ(μ_i) = 1`, and
  `π` an even permutation of the rows (`InJ`). The pair acts by
  `(x^{(μ, π)})_{π i} = x_i^{μ_i}` (`rowAct`).
* `G = K R₀`, with `K = ⋃_h k(h) 𝓜` for blockwise lifts `k_i(h) = h d_i(h)`, `d_i(h) ∈ N`
  (`InG`). These lifts are supplied by Theorem A.18.
* The `N`-type of a row is its `N`-orbit (`orbitN`), and `types x` is the multiset of types.

The results:

* `exists_jIso_iff_label`: for a fixed even matching `π` with local transporters `n_i`,
  a `J`-isomorphism with that matching exists exactly when `∏ φ(n_i)` lies in
  `B(x)` (`labelGroup`), the group generated by the images of the row stabilizers. This is the
  zero-sum condition.
* `exists_jIso_iff_totals`: the same test in terms of chosen representatives: the totals
  agree modulo `B(x)`.
* `exists_even_iff_exists_of_repeat`: if a type repeats, parity is free.
* `terminalTransport_eq`: the terminal procedure (Corollary A.22 on the type multisets, then the
  `J`-test above each residual element) returns the full transporter `Iso_G(x, y)`. In
  particular every answer carries the type multiset of `x` to that of `y` (the residual-action
  condition) and passes the zero-sum and parity test.
-/

namespace GI.Multicoset

open Classical

universe u

/-! ### Types: `N`-orbits of rows -/

section Types

variable {G : Type*} [Group G] {Ω : Type*} [RAct G Ω]

/-- The action on sets of objects by images. -/
instance setRAct : RAct G (Set Ω) where
  act S g := (fun w => w ↼ g) '' S
  act_one S := by simp
  act_mul S g h := by rw [Set.image_image]; simp [act_act]

theorem set_act_def (S : Set Ω) (g : G) : S ↼ g = (fun w => w ↼ g) '' S := rfl

/-- The `N`-orbit `z^N` of a row: its `N`-type. -/
def orbitN (N : Subgroup G) (z : Ω) : Set Ω := {w | ∃ n ∈ N, z ↼ n = w}

theorem orbitN_kernel {N : Subgroup G} {z : Ω} {n : G} (hn : n ∈ N) :
    orbitN N (z ↼ n) = orbitN N z := by
  ext w
  simp only [orbitN, Set.mem_setOf_eq]
  constructor
  · rintro ⟨n', hn', rfl⟩
    exact ⟨n * n', N.mul_mem hn hn', by rw [act_act]⟩
  · rintro ⟨n', hn', rfl⟩
    exact ⟨n⁻¹ * n', N.mul_mem (N.inv_mem hn) hn', by rw [act_act, mul_inv_cancel_left]⟩

/-- An `N`-type `[z]_N` is carried by `h` to `[z^h]_N`; this uses that `H` normalizes `N`. -/
theorem orbitN_act {H N : Subgroup G} (hn : Normalizes H N) {h : G} (hh : h ∈ H) (z : Ω) :
    orbitN N z ↼ h = orbitN N (z ↼ h) := by
  ext w
  simp only [set_act_def, Set.mem_image, orbitN, Set.mem_setOf_eq]
  constructor
  · rintro ⟨_, ⟨n, hnN, rfl⟩, rfl⟩
    refine ⟨h⁻¹ * n * h, hn.inv hh hnN, ?_⟩
    simp [act_act, mul_assoc]
  · rintro ⟨n, hnN, rfl⟩
    refine ⟨z ↼ (h * n * h⁻¹), ⟨_, hn h hh n hnN, rfl⟩, ?_⟩
    simp [act_act, mul_assoc]

theorem orbitN_fixed {N : Subgroup G} {n : G} (hn : n ∈ N) (z : Ω) :
    orbitN N z ↼ n = orbitN N z := by
  rw [orbitN_act (normalizes_self N) hn, orbitN_kernel hn]

variable {m : ℕ}

/-- The multiset of `N`-types of the rows of `x`. -/
def types (N : Subgroup G) (x : Fin m → Ω) : Multiset (Set Ω) :=
  Finset.univ.val.map (fun i => orbitN N (x i))

@[simp] theorem card_types (N : Subgroup G) (x : Fin m → Ω) :
    Multiset.card (types N x) = m := by
  simp [types]

/-- `N` fixes every type. -/
theorem fixes_types (N : Subgroup G) (x : Fin m → Ω) : Fixes N (types N x) := by
  intro n hn S hS
  obtain ⟨i, -, rfl⟩ := Multiset.mem_map.mp hS
  exact orbitN_fixed hn _

end Types

/-! ### Row tuples, labels and the group `J` -/

section Rows

variable {P : Type*} [Group P] {Ω : Type*} [RAct P Ω] {m : ℕ}

/-- The action of `(d, π)`: row `i` is moved by `d_i` and placed in position `π i`. -/
def rowAct (d : Fin m → P) (π : Equiv.Perm (Fin m)) (x : Fin m → Ω) : Fin m → Ω :=
  fun j => x (π.symm j) ↼ d (π.symm j)

theorem rowAct_eq_iff {d : Fin m → P} {π : Equiv.Perm (Fin m)} {x y : Fin m → Ω} :
    rowAct d π x = y ↔ ∀ i, x i ↼ d i = y (π i) := by
  constructor
  · rintro rfl i
    simp [rowAct]
  · intro h
    funext j
    simpa [rowAct] using h (π.symm j)

/-- First a blockwise element `d`, then `(μ, π)`. -/
theorem rowAct_mul (d μ : Fin m → P) (π : Equiv.Perm (Fin m)) (x : Fin m → Ω) :
    rowAct (d * μ) π x = rowAct μ π (rowAct d 1 x) := by
  funext j
  simp [rowAct, act_act, Equiv.Perm.one_symm]

variable (N : Subgroup P) {A : Type*} [CommGroup A] (φ : N →* A)

/-- The label `[g] = φ(g)` of `g ∈ N`, extended by `1` off `N`. -/
noncomputable def phiT (g : P) : A := if hg : g ∈ N then φ ⟨g, hg⟩ else 1

variable {N φ}

theorem phiT_one : phiT N φ 1 = 1 := by
  simp only [phiT, dif_pos N.one_mem]
  exact map_one φ

theorem phiT_mul {g h : P} (hg : g ∈ N) (hh : h ∈ N) :
    phiT N φ (g * h) = phiT N φ g * phiT N φ h := by
  simp only [phiT, dif_pos hg, dif_pos hh, dif_pos (N.mul_mem hg hh)]
  rw [← map_mul]
  rfl

theorem phiT_inv {g : P} (hg : g ∈ N) : phiT N φ g⁻¹ = (phiT N φ g)⁻¹ := by
  simp only [phiT, dif_pos hg, dif_pos (N.inv_mem hg)]
  rw [← map_inv]
  rfl

theorem phiT_conj {c s : P} (hc : c ∈ N) (hs : s ∈ N) : phiT N φ (c * s * c⁻¹) = phiT N φ s := by
  rw [phiT_mul (N.mul_mem hc hs) (N.inv_mem hc), phiT_mul hc hs, phiT_inv hc, mul_right_comm,
    mul_inv_cancel, one_mul]

variable (N φ)

/-- Membership in `J = 𝓜 R₀`: `μ_i ∈ N`, label sum zero, `π` even. -/
def InJ (μ : Fin m → P) (π : Equiv.Perm (Fin m)) : Prop :=
  (∀ i, μ i ∈ N) ∧ ∏ i, phiT N φ (μ i) = 1 ∧ π ∈ alternatingGroup (Fin m)

/-- The group `B(x)`: products of labels of row stabilizers `Aut_N(x_i)`. It is the sum of the
groups `B_i = φ(Aut_N(x_i))`; rows of the same type give the same `B_i`
(`exists_label_aut_act_iff`), so it is the paper's `∑_a B_a` over the occurring types. -/
def labelGroup (x : Fin m → Ω) : Subgroup A where
  carrier := {a | ∃ s : Fin m → P, (∀ i, s i ∈ Aut N (x i)) ∧ ∏ i, phiT N φ (s i) = a}
  one_mem' := ⟨fun _ => 1, fun _ => (Aut N _).one_mem, by simp [phiT_one]⟩
  mul_mem' := by
    rintro _ _ ⟨s, hs, rfl⟩ ⟨t, ht, rfl⟩
    refine ⟨s * t, fun i => (Aut N _).mul_mem (hs i) (ht i), ?_⟩
    simp only [Pi.mul_apply]
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun i _ => phiT_mul (aut_le _ _ (hs i)) (aut_le _ _ (ht i))
  inv_mem' := by
    rintro _ ⟨s, hs, rfl⟩
    refine ⟨s⁻¹, fun i => (Aut N _).inv_mem (hs i), ?_⟩
    simp only [Pi.inv_apply]
    rw [← Finset.prod_inv_distrib]
    exact Finset.prod_congr rfl fun i _ => phiT_inv (aut_le _ _ (hs i))

variable {N φ}

/-- `B_a` does not depend on the representative: `Aut_N(z^c)` and `Aut_N(z)` have the same
labels for `c ∈ N`, since they are conjugate in `N` and `A` is abelian. -/
theorem exists_label_aut_act_iff {z : Ω} {c : P} (hc : c ∈ N) (a : A) :
    (∃ s ∈ Aut N (z ↼ c), phiT N φ s = a) ↔ ∃ s ∈ Aut N z, phiT N φ s = a := by
  constructor
  · rintro ⟨s, hs, rfl⟩
    obtain ⟨hsN, hsz⟩ := mem_aut.mp hs
    refine ⟨c * s * c⁻¹, mem_aut.mpr ⟨N.mul_mem (N.mul_mem hc hsN) (N.inv_mem hc), ?_⟩,
      phiT_conj hc hsN⟩
    rw [← act_act, ← act_act, hsz, act_act_inv]
  · rintro ⟨s, hs, rfl⟩
    obtain ⟨hsN, hsz⟩ := mem_aut.mp hs
    refine ⟨c⁻¹ * s * c, mem_aut.mpr ⟨N.mul_mem (N.mul_mem (N.inv_mem hc) hsN) hc, ?_⟩, ?_⟩
    · rw [act_act, show c * (c⁻¹ * s * c) = s * c by group, ← act_act, hsz]
    · simpa using phiT_conj (φ := φ) (N.inv_mem hc) hsN

/-- **The zero-sum test** ("for a prescribed type matching `σ`, the possible local transporter
images in `A` are the cosets `α_{y,σ(i)} - α_{x,i} + B_{a_i}`. Their sum can be zero exactly
when ..."). For an even matching `π` with local transporters `x_i^{n_i} = y_{π i}`, a
`J`-element with matching `π` carries `x` to `y` exactly when `∏ φ(n_i) ∈ B(x)`. -/
theorem exists_jIso_iff_label {x y : Fin m → Ω} {π : Equiv.Perm (Fin m)}
    (hπ : π ∈ alternatingGroup (Fin m)) {n : Fin m → P} (hn : ∀ i, n i ∈ N)
    (hxy : ∀ i, x i ↼ n i = y (π i)) :
    (∃ μ, InJ N φ μ π ∧ rowAct μ π x = y) ↔ ∏ i, phiT N φ (n i) ∈ labelGroup N φ x := by
  constructor
  · rintro ⟨μ, ⟨hμN, hμ1, -⟩, hμ⟩
    rw [rowAct_eq_iff] at hμ
    refine ⟨fun i => n i * (μ i)⁻¹, fun i => ?_, ?_⟩
    · refine mem_aut.mpr ⟨N.mul_mem (hn i) (N.inv_mem (hμN i)), ?_⟩
      rw [← act_act, hxy i, ← hμ i, act_act_inv]
    · calc ∏ i, phiT N φ (n i * (μ i)⁻¹)
          = ∏ i, (phiT N φ (n i) * (phiT N φ (μ i))⁻¹) :=
            Finset.prod_congr rfl fun i _ => by
              rw [phiT_mul (hn i) (N.inv_mem (hμN i)), phiT_inv (hμN i)]
        _ = (∏ i, phiT N φ (n i)) * (∏ i, phiT N φ (μ i))⁻¹ := by
            rw [Finset.prod_mul_distrib, Finset.prod_inv_distrib]
        _ = ∏ i, phiT N φ (n i) := by rw [hμ1, inv_one, mul_one]
  · rintro ⟨s, hs, hprod⟩
    refine ⟨fun i => (s i)⁻¹ * n i,
      ⟨fun i => N.mul_mem (N.inv_mem (aut_le _ _ (hs i))) (hn i), ?_, hπ⟩, ?_⟩
    · calc ∏ i, phiT N φ ((s i)⁻¹ * n i)
          = ∏ i, ((phiT N φ (s i))⁻¹ * phiT N φ (n i)) :=
            Finset.prod_congr rfl fun i _ => by
              rw [phiT_mul (N.inv_mem (aut_le _ _ (hs i))) (hn i), phiT_inv (aut_le _ _ (hs i))]
        _ = (∏ i, phiT N φ (s i))⁻¹ * ∏ i, phiT N φ (n i) := by
            rw [Finset.prod_mul_distrib, Finset.prod_inv_distrib]
        _ = 1 := by rw [hprod, inv_mul_cancel]
    · rw [rowAct_eq_iff]
      intro i
      have hsi := (mem_aut.mp ((Aut N (x i)).inv_mem (hs i))).2
      rw [← act_act, hsi, hxy i]

/-- **The zero-sum test with totals** ("their sum can be zero exactly when the totals agree").
Write `x_i = r_i^{a_i}` and `y_j = r'_j^{c_j}` with representatives `r, r'` and `a_i, c_j ∈ N`.
For an even matching `π` of equal representatives, a `J`-element with matching `π` carries `x`
to `y` exactly when the totals `∏ φ(c_j)` and `∏ φ(a_i)` agree modulo `B(x)`. -/
theorem exists_jIso_iff_totals {x y r r' : Fin m → Ω} {a c : Fin m → P} {π : Equiv.Perm (Fin m)}
    (hπ : π ∈ alternatingGroup (Fin m)) (ha : ∀ i, a i ∈ N) (hc : ∀ j, c j ∈ N)
    (hx : ∀ i, r i ↼ a i = x i) (hy : ∀ j, r' j ↼ c j = y j) (hr : ∀ i, r i = r' (π i)) :
    (∃ μ, InJ N φ μ π ∧ rowAct μ π x = y) ↔
      (∏ j, phiT N φ (c j)) * (∏ i, phiT N φ (a i))⁻¹ ∈ labelGroup N φ x := by
  have hxy : ∀ i, x i ↼ ((a i)⁻¹ * c (π i)) = y (π i) := by
    intro i
    rw [← act_act, ← hx i, act_act_inv, hr i, hy]
  rw [exists_jIso_iff_label hπ (fun i => N.mul_mem (N.inv_mem (ha i)) (hc (π i))) hxy]
  have hprod : ∏ i, phiT N φ ((a i)⁻¹ * c (π i)) =
      (∏ j, phiT N φ (c j)) * (∏ i, phiT N φ (a i))⁻¹ := by
    calc ∏ i, phiT N φ ((a i)⁻¹ * c (π i))
        = ∏ i, ((phiT N φ (a i))⁻¹ * phiT N φ (c (π i))) :=
          Finset.prod_congr rfl fun i _ => by
            rw [phiT_mul (N.inv_mem (ha i)) (hc (π i)), phiT_inv (ha i)]
      _ = (∏ i, phiT N φ (a i))⁻¹ * ∏ i, phiT N φ (c (π i)) := by
          rw [Finset.prod_mul_distrib, Finset.prod_inv_distrib]
      _ = _ := by rw [Equiv.prod_comp π (fun j => phiT N φ (c j)), mul_comm]
  rw [hprod]

variable (N φ) in
/-- A matching `π` passes the label test: local transporters `x_i^{n_i} = y_{π i}` exist and
their label sum lies in `B(x)`. -/
def LabelOK (x y : Fin m → Ω) (π : Equiv.Perm (Fin m)) : Prop :=
  ∃ n : Fin m → P, (∀ i, n i ∈ N) ∧ (∀ i, x i ↼ n i = y (π i)) ∧
    ∏ i, phiT N φ (n i) ∈ labelGroup N φ x

/-- The `J`-orbit test ("two strings are `J`-isomorphic exactly when their type multisets agree,
their total labels agree, and a matching of their fiber types can be chosen even"). -/
theorem exists_jIso_iff {x y : Fin m → Ω} :
    (∃ μ π, InJ N φ μ π ∧ rowAct μ π x = y) ↔
      ∃ π ∈ alternatingGroup (Fin m), LabelOK N φ x y π := by
  constructor
  · rintro ⟨μ, π, hJ, hμ⟩
    refine ⟨π, hJ.2.2, μ, hJ.1, rowAct_eq_iff.mp hμ, ?_⟩
    rw [hJ.2.1]
    exact (labelGroup N φ x).one_mem
  · rintro ⟨π, hπ, n, hn, hxy, hlab⟩
    exact ⟨_, π, ((exists_jIso_iff_label hπ hn hxy).mpr hlab).choose_spec⟩

/-- Exchanging two rows of equal type keeps the label test ("exchanging two equal-type matches
reverses parity without changing the possible sum"). -/
theorem labelOK_swap {x y : Fin m → Ω} {π : Equiv.Perm (Fin m)} {i j : Fin m} (hij : i ≠ j)
    {c : P} (hc : c ∈ N) (hcij : x i ↼ c = x j) (h : LabelOK N φ x y π) :
    LabelOK N φ x y (π * Equiv.swap i j) := by
  obtain ⟨n, hn, hxy, hlab⟩ := h
  let e : Fin m → P := fun k => if k = i then c else if k = j then c⁻¹ else 1
  have he : ∀ k, e k ∈ N := by
    intro k
    simp only [e]
    split_ifs
    exacts [hc, N.inv_mem hc, N.one_mem]
  have hji : x j ↼ c⁻¹ = x i := by rw [← hcij, act_act_inv]
  refine ⟨fun k => e k * n (Equiv.swap i j k), fun k => N.mul_mem (he k) (hn _), ?_, ?_⟩
  · intro k
    rw [← act_act, Equiv.Perm.mul_apply, ← hxy]
    simp only [e]
    by_cases hki : k = i
    · subst hki
      rw [if_pos rfl, hcij, Equiv.swap_apply_left]
    · by_cases hkj : k = j
      · subst hkj
        rw [if_neg hki, if_pos rfl, hji, Equiv.swap_apply_right]
      · rw [if_neg hki, if_neg hkj, act_one, Equiv.swap_apply_of_ne_of_ne hki hkj]
  · have he1 : ∏ k, phiT N φ (e k) = 1 := by
      rw [Finset.prod_eq_mul i j hij]
      · simp only [e, if_neg hij.symm, ↓reduceIte]
        rw [phiT_inv hc, mul_inv_cancel]
      · intro k _ hk
        simp only [e, if_neg hk.1, if_neg hk.2, phiT_one]
      · intro h; exact absurd (Finset.mem_univ i) h
      · intro h; exact absurd (Finset.mem_univ j) h
    have hprod : ∏ k, phiT N φ (e k * n (Equiv.swap i j k)) = ∏ k, phiT N φ (n k) := by
      rw [Finset.prod_congr rfl fun k _ => phiT_mul (he k) (hn (Equiv.swap i j k)),
        Finset.prod_mul_distrib, he1, one_mul,
        Equiv.prod_comp (Equiv.swap i j) (fun k => phiT N φ (n k))]
    rw [hprod]
    exact hlab

/-- **Parity is free when a type repeats.** If two distinct rows of `x` have the same
`N`-type, an even matching passing the label test exists exactly when any matching does. -/
theorem exists_even_iff_exists_of_repeat {x y : Fin m → Ω} {i j : Fin m} (hij : i ≠ j)
    {c : P} (hc : c ∈ N) (hcij : x i ↼ c = x j) :
    (∃ π ∈ alternatingGroup (Fin m), LabelOK N φ x y π) ↔ ∃ π, LabelOK N φ x y π := by
  constructor
  · rintro ⟨π, -, h⟩
    exact ⟨π, h⟩
  · rintro ⟨π, h⟩
    by_cases hπ : π ∈ alternatingGroup (Fin m)
    · exact ⟨π, hπ, h⟩
    · refine ⟨π * Equiv.swap i j, ?_, labelOK_swap hij hc hcij h⟩
      rw [Equiv.Perm.mem_alternatingGroup] at hπ ⊢
      rw [Equiv.Perm.sign_mul, Equiv.Perm.sign_swap hij]
      rcases Int.units_eq_one_or (Equiv.Perm.sign π) with h1 | h1
      · exact absurd h1 hπ
      · rw [h1]; rfl

/-- `J` preserves the type multiset. -/
theorem types_rowAct_J {μ : Fin m → P} (hμ : ∀ i, μ i ∈ N) (π : Equiv.Perm (Fin m))
    (x : Fin m → Ω) : types N (rowAct μ π x) = types N x := by
  have : (fun j => orbitN N (rowAct μ π x j)) = (fun i => orbitN N (x i)) ∘ π.symm := by
    funext j
    simp only [rowAct, Function.comp]
    exact orbitN_kernel (hμ _)
  rw [types, this, ← Multiset.map_map, Multiset.map_univ_val_equiv, types]

end Rows

/-! ### The terminal procedure -/

section Terminal

variable {P : Type u} [Group P] {Ω : Type u} [RAct P Ω] {m : ℕ}
variable (H N : Subgroup P) {A : Type*} [CommGroup A] (φ : N →* A) (k : P → Fin m → P)

/-- Membership in `G = K R₀`: `(k(h) μ, π)` with `h ∈ H` and `(μ, π) ∈ J`. -/
def InG (d : Fin m → P) (π : Equiv.Perm (Fin m)) : Prop :=
  ∃ h ∈ H, ∃ μ, InJ N φ μ π ∧ d = k h * μ

/-- The transporter `Iso_G(x, y)`. -/
def isoG (x y : Fin m → Ω) : Set ((Fin m → P) × Equiv.Perm (Fin m)) :=
  {p | InG H N φ k p.1 p.2 ∧ rowAct p.1 p.2 x = y}

/-- **The procedure of Theorem A.23.** First compute the residual transporter of the type
multisets by Corollary A.22 (`radicalTransport` on the `N`-types). Above each residual element
`h`, keep the `J`-elements carrying the aligned string `x^{k(h)}` to `y`, which is the zero-sum
and parity test of `exists_jIso_iff_label` and `exists_even_iff_exists_of_repeat`. -/
noncomputable def terminalTransport [Finite P] (x y : Fin m → Ω) :
    Set ((Fin m → P) × Equiv.Perm (Fin m)) :=
  {p | ∃ h ∈ (radicalTransport H N (types N x) (types N y)).set, ∃ μ, InJ N φ μ p.2 ∧
    p.1 = k h * μ ∧ rowAct μ p.2 (rowAct (k h) 1 x) = y}

variable {H N φ k}

/-- Lifts move types by the residual action: `types(x^{k(h)}) = types(x)^h`. -/
theorem types_lift (hn : Normalizes H N) (hk : ∀ h ∈ H, ∀ i, h⁻¹ * k h i ∈ N) {h : P}
    (hh : h ∈ H) (x : Fin m → Ω) : types N (rowAct (k h) 1 x) = types N x ↼ h := by
  rw [types, types, multiset_act_def, Multiset.map_map]
  refine Multiset.map_congr rfl fun i _ => ?_
  simp only [rowAct, Function.comp, Equiv.Perm.one_symm, Equiv.Perm.one_apply]
  rw [show k h i = h * (h⁻¹ * k h i) by group, ← act_act, orbitN_kernel (hk h hh i),
    orbitN_act hn hh]

/-- **Correctness of Theorem A.23's procedure**: it returns the full transporter
`Iso_G(x, y)`. Every element of `Iso_G(x, y)` lies over a residual element carrying the type
multiset of `x` to that of `y`. -/
theorem terminalTransport_eq [Finite P] (hNH : N ≤ H) (hn : Normalizes H N)
    (hk : ∀ h ∈ H, ∀ i, h⁻¹ * k h i ∈ N) (x y : Fin m → Ω) :
    terminalTransport H N φ k x y = isoG H N φ k x y := by
  ext ⟨d, π⟩
  simp only [terminalTransport, isoG, InG, Set.mem_setOf_eq]
  rw [radicalTransport_set hNH hn (fixes_types N x) (fixes_types N y)]
  constructor
  · rintro ⟨h, ⟨hh, -⟩, μ, hJ, rfl, hxy⟩
    exact ⟨⟨h, hh, μ, hJ, rfl⟩, by rw [rowAct_mul]; exact hxy⟩
  · rintro ⟨⟨h, hh, μ, hJ, rfl⟩, hxy⟩
    rw [rowAct_mul] at hxy
    refine ⟨h, ⟨hh, ?_⟩, μ, hJ, rfl, hxy⟩
    rw [← types_lift hn hk hh, ← hxy, types_rowAct_J hJ.1]

/-- The degree-`b` string-isomorphism calls of Theorem A.23, computed once: `m²` orbit tests
to classify the rows into `N`-types, at most `m²` stored cosets `Iso_H(z_a, z_c)`, and at most
`m` stabilizers `Aut_H(z_a)`. The rest of the procedure makes no string calls. -/
def terminalStringCalls (m : ℕ) : ℕ := 2 * m ^ 2 + m

/-- The count of Theorem A.23: the residual step is Corollary A.22 on `m` type objects. -/
theorem terminalTransport_calls_exp (dixon : GI.Cited.DixonDerivedLength) {B : Type u}
    [Fintype B] [DecidableEq B] {Ω : Type u} [RAct (Equiv.Perm B) Ω]
    {H N : Subgroup (Equiv.Perm B)} (hNH : N ≤ H) (hn : Normalizes H N)
    (hidx : (((radicalSubgroup H N).subgroupOf H).index : ℝ) ≤
      (Fintype.card B : ℝ) ^ (2 * Real.logb 2 (Fintype.card B)))
    (x y : Fin m → Ω) :
    ((radicalTransport H N (types N x) (types N y)).calls : ℝ) ≤
      Real.exp (45 * (Real.log ((Fintype.card B : ℝ) + 2) ^ 2 +
        Real.log ((m : ℝ) + 2) * Real.log ((Fintype.card B : ℝ) + 2))) :=
  radicalTransport_calls_exp dixon hNH hn _ _ m (by simp) (by simp) hidx

end Terminal

end GI.Multicoset
