-- Proved in `Workspace/Proved/` or taken as axioms in `Workspace/Axioms/AlgoPermGroups.lean` (see each docstring)
import Workspace.Cited.Encoding
import Mathlib.GroupTheory.Perm.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.Solvable
import Mathlib.SetTheory.Cardinal.Finite

/-!
# Stage 2 tasks: basic permutation-group algorithms

**Each docstring says how its task enters the main theorem.** Ten tasks are proved in
`Workspace/Proved/`. Four (`ChiefSeriesAlgo`, `SylowAlgo`, `SylowConjugate`,
`QuotientCentralizer`) are axioms of `Workspace/Axioms/AlgoPermGroups.lean`. Two (`Orbits`,
`CompositionSeriesAlgo`) are not assumed by the main theorem. Each task is a `PolyTimeAt`
statement of stage 2.

Sources. [H] = Helfgott, Bajpai, Dona, arXiv:1710.04574v1, Section 2.1 (Schreier–Sims,
Exercise 2.1, orbits and blocks). [LM] = Luks, Miyazaki, *Polynomial-time normalizers*, DMTCS
13:4 (2011) 61–96, Theorem 3.1 (verbatim): "Given `G = ⟨S⟩ ≤ Sym(Ω)`, in polynomial time one can
solve the following problems. (i) Given `α ∈ Ω`, list the orbit `α^G` and test the
transitivity of `G`. (ii) Test whether `G` is primitive and, if not, find a non-trivial block
system. (iii) … (iv) Find `|G|`. (v) Given `x ∈ Sym(Ω)`, test whether `x ∈ G` and, if so,
exhibit a straight-line program to reach `x` from `S`. (vi) Given a homomorphism
`π : G → Sym(Ω')` (defined on generators), (a) find `Ker π`, (b) for given `M ≤ π(G)`, find
`π^{-1}(M)`. (vii) Find the derived series of `G` and test the solvability of `G`. (viii) Given
`N ≤ Sym(Ω)` such that `N` is normalized by `G`, (a) find `C_G(N)` …, (b) find `G ∩ N`, (c) for
given `x ∈ GN`, find `g ∈ G` and `n ∈ N` such that `x = gn`. (ix) Find a composition series of
`G`. (x) Find a chief series of `G`. (xi) (CFSG) Given a prime `p` dividing `|G|`, find a Sylow
`p`-subgroup of `G`; furthermore, given such subgroups `P₁` and `P₂` of `G`, find `g ∈ G` such
that `P₁^g = P₂`." [LM, Lemma 3.2] and [LM, Proposition 3.9] are quoted at their tasks.

Conventions.
* A group is given by generators, encoded by `encGroup gs = encPerms (1 :: gs)`. The identity is
  prepended so that the encoding always contains `n` cells with values below `n`; then every
  number in the input, including `n`, is at most the number of cells, even when `gs = []`.
* An instance that needs a hypothesis (a normal subgroup, a prime dividing the order, …) is a
  structure carrying a proof of it; the encoding forgets the proof. The axiom then says nothing
  about inputs that violate the hypothesis.
* A subgroup in an output is "some generating list with at most `n²` entries" (`GensOf`): the
  output relation names the subgroup, never one particular list. The bound `n²` is part of the
  output relation, so that the size of every correct output, not only of some, is polynomial;
  `GensOf` explains why every algorithm can meet it.
* A series in an output has at most `n² + 1` terms, each given by at most `n²` generators
  (`SeriesOf`). A labeling of the points has exactly `n` labels, each below `n` (`LabelsOf`).
* Permutations compose as functions: `(g * h) x = g (h x)`.

The requirements of `Task.ofVal`, checked for every task below: (1) every number in the input
encoding is at most a polynomial in its number of cells (all numbers are `n`, points `< n`,
small tags, or a prime `p ≤ |G| ≤ n!`, see `SylowTask`); (2) every instance has a correct output,
and every correct output has a number of cells polynomial in the size of the input (the bounds
of `GensOf`, `SeriesOf` and `LabelsOf`, and `n` is at most the number of cells of the input).
-/

namespace GI.Cited

open Equiv

/-- The subgroup generated by a list. -/
def gens {n : ℕ} (gs : List (Perm (Fin n))) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure {g | g ∈ gs}

/-- A group by generators, with the identity prepended (so `n` cells of values `< n` occur). -/
def encGroup {n : ℕ} (gs : List (Perm (Fin n))) : Val := encPerms (1 :: gs)

/-- A list of points. -/
def encPts {n : ℕ} (S : List (Fin n)) : Val := .list (S.map fun i => .nat i)

/-- The output "a generating list of the subgroup `H`, with at most `n²` generators".

*Why every algorithm can meet the bound.* Let `g₁, …, g_m` be any generating list of `H`, for
example the one an algorithm of [LM, Theorem 3.1] returns. Go through it once and keep `gᵢ` only
when it is not in the group generated by the kept ones; this is one membership test per
generator ([LM, Theorem 3.1(v)]), so polynomial time. The kept list still generates `H`, since
every dropped `gᵢ` lies in the group of the kept ones. Each kept generator at least doubles the
order of the group generated so far: the old group is a proper subgroup of the new one, so by
Lagrange's theorem its index is at least 2. Hence `2^(number kept) ≤ |H| ≤ n! ≤ n^n ≤ 2^(n²)`,
and at most `n²` generators are kept. (This is the usual subgroup-chain bound
`log₂ |H| ≤ log₂ n!`, see for example Seress, *Permutation Group Algorithms*, Cambridge 2003,
Section 4.1.) `GI.CitedChecks.exists_gensOf` checks that every subgroup has such a list. -/
def GensOf {n : ℕ} (H : Subgroup (Perm (Fin n))) (v : Val) : Prop :=
  ∃ hs : List (Perm (Fin n)), v = .list (hs.map encPerm) ∧ hs.length ≤ n ^ 2 ∧ gens hs = H

/-- The output "a labeling of the points by numbers below `n`, with property `Q`": the list of
the `n` labels. Any labeling can be renamed to one with labels below `n` without changing which
points share a label (label each point by the least point with the same label), so the bound
costs an algorithm only a linear pass. -/
def LabelsOf {n : ℕ} (Q : (Fin n → ℕ) → Prop) (v : Val) : Prop :=
  ∃ lab : Fin n → ℕ, v = .list ((List.finRange n).map fun i => .nat (lab i)) ∧
    (∀ i, lab i < n) ∧ Q lab

/-- An instance: a group given by generators. -/
structure GroupInst where
  n : ℕ
  gs : List (Perm (Fin n))

/-! ### Schreier–Sims: membership and order -/

/-- An instance of membership: a group and a permutation. -/
structure MemberInst where
  n : ℕ
  gs : List (Perm (Fin n))
  x : Perm (Fin n)

/-- **Membership** ([H, Exercise 2.1(a)]; [LM, Theorem 3.1(v)]). Output `1` if `x ∈ ⟨gs⟩`,
`0` otherwise. -/
def MembershipTask : Task MemberInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encPerm I.x])
    (fun I v => (v = .nat 1 ∧ I.x ∈ gens I.gs) ∨ (v = .nat 0 ∧ I.x ∉ gens I.gs))

/-- Proved as `GI.Proved.membership` in `Workspace/Proved/SSMembership.lean`. -/
def Membership : Prop := ∃ p, PolyTimeAt MembershipTask p

/-- **Order** ([H, Section 2.1]; [LM, Theorem 3.1(iv)]). Output `|⟨gs⟩|` as one number (at most
`n!`; the machine is log-cost, so writing it costs `O(n log n)`). The output is determined, so it
needs no size bound: `|⟨gs⟩| ≤ n! ≤ n^n ≤ 2^(n²)`, so it has at most `n² + 1` bits
(`GI.CitedChecks.card_lt_two_pow`). -/
def GroupOrderTask : Task GroupInst :=
  Task.ofVal (fun I => encGroup I.gs) (fun I v => v = .nat (Nat.card (gens I.gs)))

/-- Proved as `GI.Proved.groupOrder` in `Workspace/Proved/SSGroupOrder.lean`. -/
def GroupOrder : Prop := ∃ p, PolyTimeAt GroupOrderTask p

/-! ### Pointwise stabilizers, kernels and preimages -/

/-- An instance: a group and a list of points. -/
structure PointsInst where
  n : ℕ
  gs : List (Perm (Fin n))
  S : List (Fin n)

/-- The pointwise stabilizer of the points `S` in `G`. -/
def pointwiseStab {n : ℕ} (G : Subgroup (Perm (Fin n))) (S : List (Fin n)) :
    Subgroup (Perm (Fin n)) where
  carrier := {g | g ∈ G ∧ ∀ i ∈ S, g i = i}
  one_mem' := ⟨G.one_mem, fun _ _ => rfl⟩
  mul_mem' := fun ha hb => ⟨G.mul_mem ha.1 hb.1, fun i hi => by
    simp [Perm.mul_apply, hb.2 i hi, ha.2 i hi]⟩
  inv_mem' := fun ha => ⟨G.inv_mem ha.1, fun i hi => by
    rw [Perm.inv_eq_iff_eq]; exact (ha.2 i hi).symm⟩

/-- **Pointwise stabilizer** ([H, Section 2.1]: "The Schreier-Sims algorithm describes the
pointwise stabilizer `G_{(x₁,…,x_k)}` for arbitrary `x₁, …, x_k ∈ Ω`"). Output a generating
list of `G_{(S)}` with at most `n²` generators (`GensOf`).

The kernel of an action is a pointwise stabilizer: for `π : G → Sym(Γ)` given on generators,
let `G` act on `Fin (n + n')` by `g ⊕ π g` (the paper, proof of Proposition A.1: "Compute
`ker π` using the simultaneous action on `Ω ⊔ Γ` and a pointwise stabilizer"); `ker π` is the
restriction to `Ω` of the pointwise stabilizer of the `Γ` points. So kernels need no separate
task ([LM, Theorem 3.1(vi)(a)]). -/
def PointwiseStabTask : Task PointsInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encPts I.S])
    (fun I v => GensOf (pointwiseStab (gens I.gs) I.S) v)

/-- Proved as `GI.Proved.pointwiseStab` in `Workspace/Proved/SSPointwiseStab.lean`. -/
def PointwiseStab : Prop := ∃ p, PolyTimeAt PointwiseStabTask p

/-- An instance of a preimage: a group `D ≤ Sym(n + n')` given by generators (in the paper, the
graph `{g ⊕ π g}` of a homomorphism given on generators), and generators of `M ≤ Sym(n')`.
The generators of `D` preserve the two parts (`preserves`), and `M` lies in the image of `D` on
the second part (`ms_le`); both hold in the paper's use, where `D` is the graph of `π` and
`M ≤ π(G)`. -/
structure PreimageInst where
  n : ℕ
  n' : ℕ
  ds : List (Perm (Fin n ⊕ Fin n'))
  ms : List (Perm (Fin n'))
  preserves : ∀ d ∈ ds, ∀ i : Fin n, ∃ j : Fin n, d (Sum.inl i) = Sum.inl j
  ms_le : ∀ m ∈ ms, ∃ g : Perm (Fin n), Equiv.sumCongr g m ∈ Subgroup.closure {d | d ∈ ds}

/-- A permutation of `Fin n ⊕ Fin n'` as a permutation of `Fin (n + n')`. -/
def sumToFin {n n' : ℕ} (g : Perm (Fin n ⊕ Fin n')) : Perm (Fin (n + n')) :=
  (finSumFinEquiv.symm.trans g).trans finSumFinEquiv

/-- The preimage of `M` in the graph group: the `g` such that `g ⊕ h ∈ D` for some `h ∈ M`. -/
def preimageSet (I : PreimageInst) : Set (Perm (Fin I.n)) :=
  {g | ∃ h ∈ Subgroup.closure {m | m ∈ I.ms},
    Equiv.sumCongr g h ∈ Subgroup.closure {d | d ∈ I.ds}}

/-- **Preimage** ([H, Exercise 2.1(c)]: "Given a homomorphism `φ : G → Sym(Ω')` … and a
subgroup `H < Sym(Ω')`, describe `φ^{-1}(H)`"; [LM, Theorem 3.1(vi)(b)]). Stated for the graph
group `D`, so that every instance is meaningful: output a generating list of the group of `g`
with `g ⊕ h ∈ D` for some `h ∈ M`. When `D = {g ⊕ π g}` this is `π^{-1}(M)`. The paper's
"constructive membership in the image" (lifting generators of `M ≤ π(G)`) is this task.

*Why `preserves` and `ms_le`.* Without them the task is not known to be polynomial. Without `preserves`, take `M = Sym(n')`: the output is the restriction to
`Fin n` of the setwise stabilizer of `Fin n` in an arbitrary `D ≤ Sym(n + n')`, and set
stabilizers are as hard as graph isomorphism (Luks 1982). For example `D = ⟨(inl 0, inr 0)⟩`
does not preserve the parts. Without `ms_le`, take `D = {g ⊕ g | g ∈ A}` for `n = n'`: the output
is `A ∩ M`, a general group intersection, which the paper explicitly does not assume ("A general
polynomial-time intersection algorithm is not assumed", before Lemma A.19). [LM, Theorem
3.1(vi)(b)] reads "for given `M ≤ π(G)`, find `π^{-1}(M)`", which is the fixed form: lift the
generators of `M` by constructive membership in `π(D)` ([LM, Theorem 3.1(v)]) and add the kernel,
a pointwise stabilizer.

*Output size.* At most `n²` generators, as in `GensOf`: the preimage set is a subgroup of
`Sym(n)` (`GI.CitedChecks.preimageSubgroup`). -/
def PreimageTask : Task PreimageInst :=
  Task.ofVal
    (fun I => .list [.nat I.n, encGroup (I.ds.map sumToFin), encGroup I.ms])
    (fun I v => ∃ hs : List (Perm (Fin I.n)), v = .list (hs.map encPerm) ∧
      hs.length ≤ I.n ^ 2 ∧ ((gens hs : Set (Perm (Fin I.n))) = preimageSet I))

/-- Proved as `GI.Proved.preimage` in `Workspace/Proved/NClPreimage.lean`. -/
def Preimage : Prop := ∃ p, PolyTimeAt PreimageTask p

/-! ### Blocks and orbits -/

/-- The orbit labels: `lab i = lab j` exactly when `i, j` lie in one orbit. -/
def IsOrbitLabeling {n : ℕ} (G : Subgroup (Perm (Fin n))) (lab : Fin n → ℕ) : Prop :=
  ∀ i j, lab i = lab j ↔ ∃ g ∈ G, g i = j

/-- **Orbits** ([H, Section 2.1.2]; [LM, Theorem 3.1(i)]). Output a list of `n` labels below `n`
whose classes are the orbits (`LabelsOf`). -/
def OrbitsTask : Task GroupInst :=
  Task.ofVal (fun I => encGroup I.gs) (fun I v => LabelsOf (IsOrbitLabeling (gens I.gs)) v)

/-- Not assumed by the main theorem. -/
def Orbits : Prop := ∃ p, PolyTimeAt OrbitsTask p

/-- A labeling `lab` of the points is `G`-invariant: `g` maps classes to classes. -/
def InvariantLabeling {n : ℕ} (G : Subgroup (Perm (Fin n))) (lab : Fin n → ℕ) : Prop :=
  ∀ g ∈ G, ∀ i j, lab (g i) = lab (g j) ↔ lab i = lab j

/-- `lab` is a minimal block system ([H, Section 2.1.2]: "A system of blocks is minimal if the
action of `G` on it is primitive"): it is invariant, has at least two classes, and every
invariant labeling coarser than `lab` is `lab` itself or has one class. -/
def IsMinimalBlocks {n : ℕ} (G : Subgroup (Perm (Fin n))) (lab : Fin n → ℕ) : Prop :=
  InvariantLabeling G lab ∧ (∃ i j, lab i ≠ lab j) ∧
  ∀ lab' : Fin n → ℕ, InvariantLabeling G lab' → (∀ i j, lab i = lab j → lab' i = lab' j) →
    (∀ i j, lab' i = lab' j ↔ lab i = lab j) ∨ (∀ i j, lab' i = lab' j)

/-- A transitive group on at least two points. -/
structure TransitiveInst where
  n : ℕ
  gs : List (Perm (Fin n))
  two_le : 2 ≤ n
  transitive : ∀ i j : Fin n, ∃ g ∈ gens gs, g i = j

/-- **A minimal block system** ([H, Section 2.1.2]: "By iterating the procedure, we will obtain a
system of minimal blocks in polynomial time"; [LM, Theorem 3.1(ii)]). For transitive `G` on
`n ≥ 2` points, output `n` labels below `n` forming a minimal block system (`LabelsOf`). One
exists: among the invariant labelings with at least two classes (the point labeling is one) take
one with the fewest classes. -/
def MinimalBlocksTask : Task TransitiveInst :=
  Task.ofVal (fun I => encGroup I.gs) (fun I v => LabelsOf (IsMinimalBlocks (gens I.gs)) v)

/-- Proved as `GI.Proved.minimalBlocks` in `Workspace/Proved/MBlk.lean`. -/
def MinimalBlocks : Prop := ∃ p, PolyTimeAt MinimalBlocksTask p

/-! ### Normal closures and series -/

/-- An instance: a group and a list of further permutations. -/
structure TwoListInst where
  n : ℕ
  gs : List (Perm (Fin n))
  hs : List (Perm (Fin n))

/-- **Normal closure** (standard, [LM, Section 3.1, references [17], [35]]). Output a
generating list of the normal closure of `⟨hs⟩` in `⟨gs, hs⟩`, i.e. the smallest subgroup that
contains `hs` and is normalized by `gs`. -/
def NormalClosureTask : Task TwoListInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encGroup I.hs])
    (fun I v => GensOf (Subgroup.closure
      {x | ∃ g ∈ gens (I.gs ++ I.hs), ∃ h ∈ I.hs, x = g * h * g⁻¹}) v)

/-- Proved as `GI.Proved.normalClosure` in `Workspace/Proved/NClNormal.lean`. -/
def NormalClosure : Prop := ∃ p, PolyTimeAt NormalClosureTask p

/-- **Derived subgroup** ([LM, Theorem 3.1(vii)]: "Find the derived series of `G`"; used by the
recursion of Theorem A.20 on the derived series of the solvable supplement). Output a generating
list of `[G, G]`; iterating gives the derived series. -/
def DerivedSubgroupTask : Task GroupInst :=
  Task.ofVal (fun I => encGroup I.gs) (fun I v => GensOf ⁅gens I.gs, gens I.gs⁆ v)

/-- Proved as `GI.Proved.derivedSubgroup` in `Workspace/Proved/NClDerived.lean`. -/
def DerivedSubgroup : Prop := ∃ p, PolyTimeAt DerivedSubgroupTask p

/-- `Hs` is a composition series of `G`: it starts at `G`, ends at `1`, each term is a maximal
normal proper subgroup of the previous one. -/
def IsCompositionSeries {n : ℕ} (G : Subgroup (Perm (Fin n)))
    (Hs : List (Subgroup (Perm (Fin n)))) : Prop :=
  Hs.head? = some G ∧ Hs.getLast? = some ⊥ ∧
  ∀ i (h : i + 1 < Hs.length),
    Hs[i + 1] < Hs[i] ∧ (∀ x ∈ Hs[i], ∀ y ∈ Hs[i + 1], x * y * x⁻¹ ∈ Hs[i + 1]) ∧
    ∀ N : Subgroup (Perm (Fin n)), Hs[i + 1] ≤ N → N ≤ Hs[i] →
      (∀ x ∈ Hs[i], ∀ y ∈ N, x * y * x⁻¹ ∈ N) → N = Hs[i + 1] ∨ N = Hs[i]

/-- `Hs` is a chief series of `G`: it starts at `G`, ends at `1`, every term is normal in `G`,
and each factor is a minimal normal subgroup of `G` modulo the next term. -/
def IsChiefSeries {n : ℕ} (G : Subgroup (Perm (Fin n)))
    (Hs : List (Subgroup (Perm (Fin n)))) : Prop :=
  Hs.head? = some G ∧ Hs.getLast? = some ⊥ ∧
  (∀ H ∈ Hs, ∀ x ∈ G, ∀ y ∈ H, x * y * x⁻¹ ∈ H) ∧
  ∀ i (h : i + 1 < Hs.length),
    Hs[i + 1] < Hs[i] ∧
    ∀ N : Subgroup (Perm (Fin n)), Hs[i + 1] ≤ N → N ≤ Hs[i] →
      (∀ x ∈ G, ∀ y ∈ N, x * y * x⁻¹ ∈ N) → N = Hs[i + 1] ∨ N = Hs[i]

/-- A list of at most `n² + 1` subgroups, each by some generating list of at most `n²`
generators.

*Why every algorithm can meet the bounds.* In a composition or chief series every term is a
proper subgroup of the one before, so by Lagrange's theorem its order is at most half of it. A
series `G = H₀ > H₁ > … > H_m = 1` therefore has `2^m ≤ |G| ≤ n! ≤ 2^(n²)`, so `m ≤ n²` and it
has at most `n² + 1` terms. Each term's generating list is reduced to at most `n²` generators as
in `GensOf`. -/
def SeriesOf {n : ℕ} (P : List (Subgroup (Perm (Fin n))) → Prop) (v : Val) : Prop :=
  ∃ L : List (List (Perm (Fin n))),
    v = .list (L.map fun hs => .list (hs.map encPerm)) ∧ L.length ≤ n ^ 2 + 1 ∧
      (∀ hs ∈ L, hs.length ≤ n ^ 2) ∧ P (L.map gens)

/-- **Composition series** ([LM, Theorem 3.1(ix)]). Its length is at most `log₂ n! ≤ n²`. -/
def CompositionSeriesTask : Task GroupInst :=
  Task.ofVal (fun I => encGroup I.gs) (fun I v => SeriesOf (IsCompositionSeries (gens I.gs)) v)

/-- Not assumed by the main theorem. -/
def CompositionSeriesAlgo : Prop := ∃ p, PolyTimeAt CompositionSeriesTask p

/-- **Chief series** ([LM, Theorem 3.1(x)]; used after Lemma A.21: "Compute a chief series of
`H`"). -/
def ChiefSeriesTask : Task GroupInst :=
  Task.ofVal (fun I => encGroup I.gs) (fun I v => SeriesOf (IsChiefSeries (gens I.gs)) v)

/-- Taken as the axiom `GI.Axioms.chiefSeriesAlgo` (`Workspace/Axioms/AlgoPermGroups.lean`). -/
def ChiefSeriesAlgo : Prop := ∃ p, PolyTimeAt ChiefSeriesTask p

/-! ### Normalized subgroups (Luks–Miyazaki, Theorem 3.1 (viii)) -/

/-- An instance: `G` normalizes `N`. -/
structure NormalizedInst where
  n : ℕ
  gs : List (Perm (Fin n))
  ns : List (Perm (Fin n))
  normalizes : ∀ g ∈ gs, ∀ x ∈ gens ns, g * x * g⁻¹ ∈ gens ns

/-- **Intersection with a normalized subgroup** ([LM, Theorem 3.1(viii)(b)]; used in the proof of
Lemma A.19 and after Lemma A.21). Output a generating list of `G ∩ N`. -/
def NormalizedIntersectionTask : Task NormalizedInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encGroup I.ns])
    (fun I v => GensOf (gens I.gs ⊓ gens I.ns) v)

/-- Proved as `GI.Proved.normalizedIntersection` in `Workspace/Proved/NInt.lean`. -/
def NormalizedIntersection : Prop := ∃ p, PolyTimeAt NormalizedIntersectionTask p

/-- An instance of factorization: `G` normalizes `N` and `x ∈ GN`. -/
structure FactorInst where
  n : ℕ
  gs : List (Perm (Fin n))
  ns : List (Perm (Fin n))
  normalizes : ∀ g ∈ gs, ∀ x ∈ gens ns, g * x * g⁻¹ ∈ gens ns
  x : Perm (Fin n)
  mem : ∃ g ∈ gens gs, ∃ m ∈ gens ns, x = g * m

/-- **Factorization in a normalized product** ([LM, Theorem 3.1(viii)(c)]: "for given `x ∈ GN`,
find `g ∈ G` and `n ∈ N` such that `x = gn`"; used after Lemma A.19 and in Theorem A.23). Output
some such pair `[g, m]`. -/
def NormalizedFactorTask : Task FactorInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encGroup I.ns, encPerm I.x])
    (fun I v => ∃ g ∈ gens I.gs, ∃ m ∈ gens I.ns, I.x = g * m ∧ v = .list [encPerm g, encPerm m])

/-- Proved as `GI.Proved.normalizedFactor` in `Workspace/Proved/NInt.lean`. -/
def NormalizedFactor : Prop := ∃ p, PolyTimeAt NormalizedFactorTask p

/-! ### Sylow subgroups (CFSG) -/

/-- An instance: a group and a prime dividing its order. The prime is at most `n`, since it
divides `|G|`, which divides `n!`; so the input bound of `Task.ofVal` holds. -/
structure SylowInst where
  n : ℕ
  gs : List (Perm (Fin n))
  p : ℕ
  prime : p.Prime
  dvd : p ∣ Nat.card (gens gs)

/-- `P` is a Sylow `p`-subgroup of `G`: a `p`-subgroup of `G` whose index in `G` is prime to
`p`. -/
def IsSylowOf {n : ℕ} (p : ℕ) (G P : Subgroup (Perm (Fin n))) : Prop :=
  P ≤ G ∧ IsPGroup p P ∧ ¬ p ∣ (P.subgroupOf G).index

/-- **A Sylow subgroup** ([LM, Theorem 3.1(xi)], CFSG, Kantor; used in the proof of Lemma A.19).
Output a generating list of some Sylow `p`-subgroup, with at most `n²` generators (`GensOf`).

*Input bound.* A prime dividing `|G|`, `G ≤ Sym(n)`, divides `n!`, so `p ≤ n`. -/
def SylowTask : Task SylowInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, .nat I.p])
    (fun I v => ∃ S, GensOf S v ∧ IsSylowOf I.p (gens I.gs) S)

/-- Taken as the axiom `GI.Axioms.sylowAlgo` (`Workspace/Axioms/AlgoPermGroups.lean`). -/
def SylowAlgo : Prop := ∃ p, PolyTimeAt SylowTask p

/-- An instance: two Sylow `p`-subgroups of `G`. -/
structure SylowConjInst where
  n : ℕ
  gs : List (Perm (Fin n))
  p : ℕ
  prime : p.Prime
  p_le : p ≤ n
  P₁ : List (Perm (Fin n))
  P₂ : List (Perm (Fin n))
  syl₁ : IsSylowOf p (gens gs) (gens P₁)
  syl₂ : IsSylowOf p (gens gs) (gens P₂)

/-- **Conjugating Sylow subgroups** ([LM, Theorem 3.1(xi)]: "given such subgroups `P₁` and `P₂`
of `G`, find `g ∈ G` such that `P₁^g = P₂`"). Output some `g ∈ G` with `g⁻¹ P₁ g = P₂`
(`P^g = g⁻¹ P g`). One exists by Sylow's theorem. -/
def SylowConjugateTask : Task SylowConjInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, .nat I.p, encGroup I.P₁, encGroup I.P₂])
    (fun I v => ∃ g ∈ gens I.gs, v = encPerm g ∧
      ∀ x, x ∈ gens I.P₂ ↔ g * x * g⁻¹ ∈ gens I.P₁)

/-- Taken as the axiom `GI.Axioms.sylowConjugate` (`Workspace/Axioms/AlgoPermGroups.lean`). -/
def SylowConjugate : Prop := ∃ p, PolyTimeAt SylowConjugateTask p

/-! ### Centralizers in quotients (Kantor–Luks, CFSG) -/

/-- An instance of a quotient centralizer: `K ⊴ G`, and subgroups `H, N` of `G` containing `K`
with `H` normalizing `N`. -/
structure QuotCentInst where
  n : ℕ
  gs : List (Perm (Fin n))
  ks : List (Perm (Fin n))
  hs : List (Perm (Fin n))
  ns : List (Perm (Fin n))
  K_le : gens ks ≤ gens gs
  K_normal : ∀ g ∈ gens gs, ∀ k ∈ gens ks, g * k * g⁻¹ ∈ gens ks
  K_le_H : gens ks ≤ gens hs
  K_le_N : gens ks ≤ gens ns
  H_le : gens hs ≤ gens gs
  N_le : gens ns ≤ gens gs
  normalizes : ∀ h ∈ gens hs, ∀ x ∈ gens ns, h * x * h⁻¹ ∈ gens ns

/-- The preimage in `H` of `C_{H/K}(N/K)`: the `h ∈ H` whose commutators with `N` lie in `K`. -/
def quotCentralizer (I : QuotCentInst) : Subgroup (Perm (Fin I.n)) where
  carrier := {h | h ∈ gens I.hs ∧ ∀ x ∈ gens I.ns, h * x * h⁻¹ * x⁻¹ ∈ gens I.ks}
  one_mem' := ⟨(gens I.hs).one_mem, fun x _ => by simp⟩
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨(gens I.hs).mul_mem ha hb, fun x hx => ?_⟩
    -- `ab x (ab)⁻¹ x⁻¹ = a (b x b⁻¹ x⁻¹) a⁻¹ · (a x a⁻¹ x⁻¹)`
    have h1 := ha' x hx
    have h2 := hb' x hx
    have h3 : a * (b * x * b⁻¹ * x⁻¹) * a⁻¹ ∈ gens I.ks :=
      I.K_normal a (I.H_le ha) _ h2
    have := (gens I.ks).mul_mem h3 h1
    simpa [mul_assoc] using this
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    refine ⟨(gens I.hs).inv_mem ha, fun x hx => ?_⟩
    -- `a⁻¹ x a x⁻¹ = (a y a⁻¹ y⁻¹)⁻¹` with `y = a⁻¹ x a ∈ N`.
    have hy : a⁻¹ * x * a ∈ gens I.ns := by
      have := I.normalizes a⁻¹ ((gens I.hs).inv_mem ha) x hx
      simpa using this
    have h1 := (gens I.ks).inv_mem (ha' _ hy)
    have e : (a * (a⁻¹ * x * a) * a⁻¹ * (a⁻¹ * x * a)⁻¹)⁻¹ = a⁻¹ * x * a⁻¹⁻¹ * x⁻¹ := by group
    rw [e] at h1
    exact h1

/-- **Centralizers in quotients** ([LM, Lemma 3.2] (Kantor–Luks, CFSG), verbatim: "For
`Ḡ = G/K`, where `K ⊴ G ≤ Sym(Ω)`, given `H̄, N̄ ≤ Ḡ` such that `H̄` normalizes `N̄`, one can find
`C_H̄(N̄)` (including, in particular, `Z(H̄)`) in polynomial time"; used after Lemma A.21 for
`C_{H/V}(U/V)`). Output a generating list of the preimage of `C_{H/K}(N/K)` in `H`. -/
def QuotientCentralizerTask : Task QuotCentInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encGroup I.ks, encGroup I.hs, encGroup I.ns])
    (fun I v => GensOf (quotCentralizer I) v)

/-- Taken as the axiom `GI.Axioms.quotientCentralizer` (`Workspace/Axioms/AlgoPermGroups.lean`). -/
def QuotientCentralizer : Prop := ∃ p, PolyTimeAt QuotientCentralizerTask p

/-! ### Solvable coset intersections (Luks–Miyazaki, Proposition 3.9) -/

/-- An instance: a solvable group `G`, a group `H`, and a permutation `x`. -/
structure SolvCosetInst where
  n : ℕ
  gs : List (Perm (Fin n))
  solvable : IsSolvable (gens gs)
  hs : List (Perm (Fin n))
  x : Perm (Fin n)

/-- **Coset intersection with a solvable group** ([LM, Proposition 3.9], verbatim: "Problem 9.
Given: `G, H ≤ Sym(Ω)` such that `G ∈ Γ_d` and `x ∈ Sym(Ω)`. Find: `Gx ∩ H`. Proposition 3.9
Problem 9 is in polynomial time." A solvable group lies in `Γ_d` for every `d`; used after
Lemma A.19 for point stabilizers and transporters). Output `0` if `Gx ∩ H = ∅`; otherwise
`[y, L]` with `y ∈ Gx ∩ H` and `L` a generating list of `G ∩ H` with at most `n²` generators
(`GensOf`; then `Gx ∩ H = (G ∩ H) y`). -/
def SolvableCosetIntersectionTask : Task SolvCosetInst :=
  Task.ofVal (fun I => .list [encGroup I.gs, encGroup I.hs, encPerm I.x])
    (fun I v =>
      (v = .nat 0 ∧ ∀ g ∈ gens I.gs, g * I.x ∉ gens I.hs) ∨
      ∃ y : Perm (Fin I.n), (∃ g ∈ gens I.gs, y = g * I.x) ∧ y ∈ gens I.hs ∧
        ∃ L : Val, v = .list [encPerm y, L] ∧ GensOf (gens I.gs ⊓ gens I.hs) L)

/-- Proved as `GI.Proved.solvableCosetIntersection` in `Workspace/Proved/SCosFinal.lean`. -/
def SolvableCosetIntersection : Prop := ∃ p, PolyTimeAt SolvableCosetIntersectionTask p

end GI.Cited
