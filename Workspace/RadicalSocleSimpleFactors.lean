module

public import Workspace.RadicalSocleProduct
public import Mathlib.GroupTheory.Subgroup.Simple

@[expose] public section

namespace GI.RadicalSocle

variable {G : Type*} [Group G]

theorem centralizer_le_normalizer (H : Subgroup G) :
    Subgroup.centralizer (H : Set G) ≤ (Subgroup.normalizer H) := by
  intro g hg
  have hforward : ∀ k ∈ Subgroup.centralizer (H : Set G),
      ∀ x ∈ H, k * x * k⁻¹ ∈ H := by
    intro k hk x hx
    rw [← hk x hx, mul_inv_cancel_right]
    exact hx
  apply Subgroup.mem_normalizer_iff.mpr
  intro x
  constructor
  · exact hforward g hg x
  · intro hx
    have h := hforward g⁻¹ (Subgroup.inv_mem _ hg) (g * x * g⁻¹) hx
    simpa only [inv_inv, mul_assoc, inv_mul_cancel_left, inv_mul_cancel_right,
      inv_mul_cancel, mul_one] using h

/-- In a group generated by its minimal normal subgroups, every minimal
normal subgroup is simple. Normality inside one factor extends to the whole
group because the other factors centralize it. -/
theorem minimalNormal_simple_of_socle_eq_top (hsoc : socle G = ⊤)
    {N : Subgroup G} (hN : MinimalNormal N) : IsSimpleGroup N := by
  letI : Nontrivial N := (Subgroup.nontrivial_iff_ne_bot N).mpr hN.2.1
  constructor
  intro K hK
  letI := hK
  let M := K.map N.subtype
  have hNM : N ≤ (Subgroup.normalizer M) := by
    have h := Subgroup.le_normalizer_map (H := K) N.subtype
    rwa [Subgroup.normalizer_eq_top, ← MonoidHom.range_eq_map, Subgroup.range_subtype] at h
  have hsocM : socle G ≤ (Subgroup.normalizer M) := by
    rw [socle_eq_iSup]
    refine iSup_le fun L => ?_
    by_cases he : L.val = N
    · simpa only [he] using hNM
    · apply le_trans ?_ (centralizer_le_normalizer M)
      intro l hl m hm
      obtain ⟨k, _, rfl⟩ := hm
      exact minimalNormal_commute hN L.property (Ne.symm he) k ⟨l, hl⟩
  haveI : M.Normal := Subgroup.normalizer_eq_top_iff.mp
    (top_unique (hsoc ▸ hsocM))
  rcases hN.2.2 M inferInstance (Subgroup.map_subtype_le K) with hb | he
  · exact Or.inl ((Subgroup.map_eq_bot_iff_of_injective K N.subtype_injective).mp hb)
  · right
    apply Subgroup.map_injective N.subtype_injective
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact he

/-- The radical of a normal subgroup of a radical-free finite group is
trivial: it is characteristic in that subgroup and hence normal in the
ambient group. -/
theorem normal_subgroup_radical_eq_bot [Finite G]
    (radicalFree : ∀ N : Subgroup G, N.Normal → IsSolvable N → N = ⊥)
    (N : Subgroup G) [N.Normal] : solvableRadical N = ⊥ := by
  let R := solvableRadical N
  haveI : (R.map N.subtype).Normal := inferInstance
  have hsolv : Group.IsSolvable (R.map N.subtype) :=
    solvable_of_surjective (N.subtype.subgroupMap_surjective R)
  exact (Subgroup.map_eq_bot_iff_of_injective R N.subtype_injective).mp
    (radicalFree (R.map N.subtype) inferInstance hsolv)

theorem normal_subgroup_radicalFree [Finite G]
    (radicalFree : ∀ N : Subgroup G, N.Normal → IsSolvable N → N = ⊥)
    (N : Subgroup G) [N.Normal] :
    ∀ K : Subgroup N, K.Normal → IsSolvable K → K = ⊥ := by
  intro K hK hs
  letI := hK
  letI : Group.IsSolvable K := hs
  apply le_bot_iff.mp
  have h := le_solvableRadical K
  rwa [normal_subgroup_radical_eq_bot radicalFree N] at h

/-- For a finite minimal normal subgroup, its own socle is the whole group.
This uses actual characteristic-subgroup minimality and actual existence of
a minimal normal subgroup, not a structure assumption. -/
theorem minimalNormal_socle_eq_top [Finite G]
    {N : Subgroup G} (hN : MinimalNormal N) : socle N = ⊤ := by
  letI : Nontrivial N := (Subgroup.nontrivial_iff_ne_bot N).mpr hN.2.1
  rcases minimalNormal_characteristic_subgroup hN (socle N) with hb | ht
  · obtain ⟨K, hK, _⟩ := exists_minimal_normal_le (⊤ : Subgroup N) top_ne_bot
    have hle := minimalNormal_le_socle hK
    rw [hb] at hle
    exact (hK.2.1 (le_bot_iff.mp hle)).elim
  · exact ht

theorem minimalNormal_simple_factors [Finite G]
    {N : Subgroup G} (hN : MinimalNormal N) (K : MinimalNormals N) :
    IsSimpleGroup K.val :=
  minimalNormal_simple_of_socle_eq_top (minimalNormal_socle_eq_top hN) K.property

theorem minimalNormal_factors_nonabelian [Finite G]
    (radicalFree : ∀ N : Subgroup G, N.Normal → IsSolvable N → N = ⊥)
    {N : Subgroup G} (hN : MinimalNormal N) (K : MinimalNormals N) :
    ∃ x y : K.val, x * y ≠ y * x := by
  letI := hN.1
  exact minimalNormal_nonabelian (normal_subgroup_radicalFree radicalFree N) K.property

noncomputable def minimalNormalProductEquiv [Finite G]
    (radicalFree : ∀ N : Subgroup G, N.Normal → IsSolvable N → N = ⊥)
    {N : Subgroup G} (hN : MinimalNormal N) :
    (∀ K : MinimalNormals N, K.val) ≃* N := by
  letI := hN.1
  exact (socleProductEquiv (normal_subgroup_radicalFree radicalFree N)).trans
    ((MulEquiv.subgroupCongr (minimalNormal_socle_eq_top hN)).trans (Subgroup.topEquiv))

end GI.RadicalSocle
