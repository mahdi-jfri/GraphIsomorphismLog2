import Workspace.Algorithm.Certificates
import Workspace.Algorithm.RefineFn

/-!
# The canonical structure of an aggregation round and its equivariance

Section A.3, "Aggregation and orbital colors": "Every genuine parent isomorphism conjugates the
two anchored subgroups and carries the chosen source orbital to one of the enumerated target
orbitals. Consequently the branches cover every parent isomorphism, while their further colors
are canonically defined from the binary graph." Section 4.1: "Aggregate the full certificates,
and use the comparison classes of the nonfull certificates as tuple colors."

This file defines the structure on the label set `Γ = [q]` from which the aggregation round
computes its branches, as a function of one string, and proves that every parent isomorphism
`g` maps the structure of `x` to the structure of `y` through its label permutation `π(g)`
(`canon_equivariant`). That is the paper's covering argument.

## The structure

The local certificates are computed on the faithful image `G|_dom` of the state on its domain
(Section 3: "Every fresh call uses the faithful permutation image on its own active domain"),
with a label map `π_d : G|_dom → Alt(Γ)` through which the supplied map `π` factors. For a string
`z` on the domain:

* `certGroup z`: the subgroup `F_z` generated by the full certificates `K(T)` of the test sets
  `T` of size `κ` (Section A.3, "The aggregation in [H, Section 6.2] uses two properties of the
  full certificates: the generated subgroup `F_x` lies in `Aut_G(x)`, and the assignment
  `x ↦ F_x` is equivariant under the parent isomorphisms");
* `idealGrp z = π(F_z)`, its image on the labels;
* `tcol nm z`: the comparison-class coloring of `κ`-tuples, extended to noninjective tuples by
  their equality patterns (Section A.3: "Its classes provide the tuple colors needed for the
  Design Lemma. Extend this coloring from injective tuples to all of `Γ^k` … Use the same palette
  for both inputs");
* `rcol`, `rcol'`: the coherent refinement of the tuple colorings of `x` and `y`, made jointly
  with one palette (`JointFn`; Section A.3: "Canonical coherent refinement may then be applied
  to the resulting full tuple structure").

A `Canon q κ ℓ` is such a structure together with an individualized tuple of `ℓ` labels (the
bounded source tuple of Section 4.1: "We fix a bounded source tuple, branch over its target
images and the image of a source orbital"). `Perm(Γ)` acts on it by relabeling.

## Equivariance

* `certGroup_of_iso`: a parent isomorphism conjugates `F_x` to `F_y`, from the equivariance of
  the full certificates (`GI.Paper.comparison_equivariance`).
* `tcol_of_iso`: it maps the tuple colors of `x` to those of `y`, from the equivariance of the
  extended comparison relation (`GI.Paper.noninjective_extension`).
* `rcol_of_iso`: so does the joint refinement, by its relabeling clause (`JointFn.carries`).
* `canon_equivariant`: hence `π(g) · canon(x, t) = canon'(y, π(g) t)`.
-/

namespace GI.Algorithm

open Equiv Equiv.Perm GI.Endpoint GI.LocalGroups GI.LocalCertificates
open scoped Pointwise

/-! ### Structures on the labels -/

/-- **A canonical structure on the labels** `[q]`: a group of label permutations (the ideal image
of the certificate group), a coloring of the `κ`-tuples of labels (the refined comparison
colors), and an individualized `ℓ`-tuple of labels. -/
@[ext] structure Canon (q κ ℓ : ℕ) where
  grp : Subgroup (Perm (Fin q))
  col : (Fin κ → Fin q) → ℕ
  tup : Fin ℓ → Fin q

namespace Canon

variable {q κ ℓ : ℕ}

/-- The conjugate `σ H σ⁻¹`. -/
def conjGrp (σ : Perm (Fin q)) (H : Subgroup (Perm (Fin q))) : Subgroup (Perm (Fin q)) :=
  H.map (MulAut.conj σ).toMonoidHom

theorem mem_conjGrp {σ h : Perm (Fin q)} {H : Subgroup (Perm (Fin q))} :
    h ∈ conjGrp σ H ↔ σ⁻¹ * h * σ ∈ H := by
  simp only [conjGrp, Subgroup.mem_map, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
  constructor
  · rintro ⟨a, ha, rfl⟩
    simpa [mul_assoc] using ha
  · intro h'
    exact ⟨_, h', by simp [mul_assoc]⟩

/-- **Relabeling** of a structure by a label permutation `σ`: conjugate the group, move the
tuple colors, and move the individualized tuple. -/
instance : MulAction (Perm (Fin q)) (Canon q κ ℓ) where
  smul σ X := ⟨conjGrp σ X.grp, fun t => X.col (σ.symm ∘ t), σ ∘ X.tup⟩
  one_smul X := by
    ext
    · change _ ∈ conjGrp 1 X.grp ↔ _
      simp [mem_conjGrp]
    · rfl
    · rfl
  mul_smul σ τ X := by
    ext
    · change _ ∈ conjGrp (σ * τ) X.grp ↔ _ ∈ conjGrp σ (conjGrp τ X.grp)
      simp only [mem_conjGrp, mul_inv_rev]
      constructor <;> intro h <;> simpa [mul_assoc] using h
    · rfl
    · rfl

@[simp] theorem smul_grp (σ : Perm (Fin q)) (X : Canon q κ ℓ) :
    (σ • X).grp = conjGrp σ X.grp := rfl
@[simp] theorem smul_col (σ : Perm (Fin q)) (X : Canon q κ ℓ) :
    (σ • X).col = fun t => X.col (σ.symm ∘ t) := rfl
@[simp] theorem smul_tup (σ : Perm (Fin q)) (X : Canon q κ ℓ) :
    (σ • X).tup = σ ∘ X.tup := rfl

end Canon

/-! ### The certificate structure of a string on the domain of a state -/

section Setup

variable {Ω C : Type} (S : State Ω C) [Fintype S.dom] [DecidableEq S.dom] {q : ℕ}
  (πd : S.domGroup →* alternatingGroup (Fin q)) (κ : ℕ)

/-- The string `z` on the domain. -/
def dstr (z : Ω → C) : S.dom → C := fun v => z v

/-- **The certificate group** `F_z`: generated by the full certificates `K(T)` of the full test
sets `T` of size `κ` (Section 4.1: "Aggregate the full certificates"). -/
noncomputable def certGroup (z : S.dom → C) : Subgroup (Perm S.dom) :=
  ⨆ (T : Finset (Fin q)) (_ : T.card = κ ∧ IsFull (phiT S.domGroup πd T) z),
    fullCert (phiT S.domGroup πd T) z

theorem certGroup_le (z : S.dom → C) : certGroup S πd κ z ≤ S.domGroup :=
  iSup_le fun _ => iSup_le fun _ =>
    fun _ hg => Pgrp_le ((fullCert_le_automorphisms _ z) hg).1

/-- **The certificate group consists of automorphisms** of `z` ("the generated subgroup `F_x`
lies in `Aut_G(x)`"). -/
theorem certGroup_le_automorphisms (z : S.dom → C) :
    certGroup S πd κ z ≤ GI.automorphisms S.domGroup z :=
  iSup_le fun _ => iSup_le fun _ =>
    fun _ hg => ⟨Pgrp_le ((fullCert_le_automorphisms _ z) hg).1,
      ((fullCert_le_automorphisms _ z) hg).2⟩

/-- **The ideal image** `π(F_z) ≤ Alt(Γ) ≤ Sym(Γ)` of the certificate group. -/
noncomputable def idealGrp (z : S.dom → C) : Subgroup (Perm (Fin q)) :=
  (((certGroup S πd κ z).subgroupOf S.domGroup).map πd).map (alternatingGroup (Fin q)).subtype

/-- The comparison class of a tuple: the pairs (string, tuple) related to `(z, t)` by the
extended comparison relation of Section A.3. -/
def tcls (z : S.dom → C) (t : Fin κ → Fin q) : Set ((S.dom → C) × (Fin κ → Fin q)) :=
  {p | tupleRel S.domGroup πd κ p (z, t)}

open Classical in
/-- The common palette of the two strings `x, y`: their comparison classes ("Use the same
palette for both inputs"). -/
noncomputable def palette (x y : S.dom → C) : Finset (Set ((S.dom → C) × (Fin κ → Fin q))) :=
  Finset.univ.image (tcls S πd κ x) ∪ Finset.univ.image (tcls S πd κ y)

/-- **A numbering of the comparison classes**: a map from classes to color numbers. The paper
leaves the names of the tuple colors open; a program numbers the classes in the order it meets
them. The model asks only that the numbering is injective on the classes of `x` (`NumOK`). Under a
parent isomorphism the classes of `y` are the classes of `x`, so then this is injectivity on the
common palette (`faudit_numOK_palette_of_iso`). -/
abbrev ClassNum (S : State Ω C) (κ q : ℕ) := Set ((S.dom → C) × (Fin κ → Fin q)) → ℕ

open Classical in
/-- **The numbering separates the classes of `x`.** The round uses only this. Classes of `y`
that are not classes of `x` may share a number: such a class rules out every parent isomorphism
(`tcls_of_iso`). This lets a program keep the numbers at most `q^κ`, as the cited refinement
task asks. The argument `y` is not used. -/
def NumOK (nm : ClassNum S κ q) (x _y : S.dom → C) : Prop :=
  Set.InjOn nm ↑(Finset.univ.image (tcls S πd κ x))

open Classical in
/-- **The default numbering**: the index of a class in the common palette (`Finset.equivFin`). -/
noncomputable def palNum (x y : S.dom → C) : ClassNum S κ q := fun c =>
  if h : c ∈ palette S πd κ x y then ((palette S πd κ x y).equivFin ⟨_, h⟩ : ℕ) else 0

theorem palNum_ok (x y : S.dom → C) : NumOK S πd κ (palNum S πd κ x y) x y := by
  classical
  intro c hc d hd h
  have hc' : c ∈ palette S πd κ x y := Finset.mem_union_left _ (Finset.mem_coe.1 hc)
  have hd' : d ∈ palette S πd κ x y := Finset.mem_union_left _ (Finset.mem_coe.1 hd)
  simp only [palNum, dif_pos hc', dif_pos hd'] at h
  have := (palette S πd κ x y).equivFin.injective (Fin.ext h)
  exact congrArg Subtype.val this

/-- **The tuple coloring** of a string: the number of the comparison class of each tuple. -/
def tcol (nm : ClassNum S κ q) (z : S.dom → C) (t : Fin κ → Fin q) : ℕ :=
  nm (tcls S πd κ z t)

theorem tcls_mem_palette_left (x y : S.dom → C) (t : Fin κ → Fin q) :
    tcls S πd κ x t ∈ palette S πd κ x y := by
  classical
  exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ _))

open Classical in
theorem tcls_mem_classes (x : S.dom → C) (t : Fin κ → Fin q) :
    tcls S πd κ x t ∈ Finset.univ.image (tcls S πd κ x) :=
  Finset.mem_image_of_mem _ (Finset.mem_univ _)

/-- **The refined tuple coloring of `x`**: the first side of the joint coherent refinement of
the tuple colorings of `x` and `y`. -/
noncomputable def rcol (hK : JointFn) (nm : ClassNum S κ q) (x y : S.dom → C) :
    (Fin κ → Fin q) → ℕ :=
  (hK q κ (tcol S πd κ nm x) (tcol S πd κ nm y)).1.1

/-- **The refined tuple coloring of `y`**: the second side of the joint refinement. -/
noncomputable def rcol' (hK : JointFn) (nm : ClassNum S κ q) (x y : S.dom → C) :
    (Fin κ → Fin q) → ℕ :=
  (hK q κ (tcol S πd κ nm x) (tcol S πd κ nm y)).1.2

/-- **The canonical structure of `x`**, with an individualized tuple `t`. -/
noncomputable def canon (hK : JointFn) (nm : ClassNum S κ q) (x y : S.dom → C) {ℓ : ℕ}
    (t : Fin ℓ → Fin q) : Canon q κ ℓ :=
  ⟨idealGrp S πd κ x, rcol S πd κ hK nm x y, t⟩

/-- **The canonical structure of `y`**, with an individualized tuple `t`. -/
noncomputable def canon' (hK : JointFn) (nm : ClassNum S κ q) (x y : S.dom → C) {ℓ : ℕ}
    (t : Fin ℓ → Fin q) : Canon q κ ℓ :=
  ⟨idealGrp S πd κ y, rcol' S πd κ hK nm x y, t⟩

/-- The refined coloring of `x` is a coherent configuration (first clause of `JointOK`). -/
theorem rcol_coherent (hK : JointFn) (nm : ClassNum S κ q) (x y : S.dom → C) :
    GI.Cited.IsConfiguration (rcol S πd κ hK nm x y) ∧
      GI.Cited.IsCoherent (rcol S πd κ hK nm x y) :=
  ⟨(hK q κ _ _).2.1, (hK q κ _ _).2.2.1⟩

/-- The refined coloring of `x` refines its comparison classes (`JointOK`). -/
theorem rcol_refines (hK : JointFn) (nm : ClassNum S κ q) (x y : S.dom → C)
    (t t' : Fin κ → Fin q) (h : rcol S πd κ hK nm x y t = rcol S πd κ hK nm x y t') :
    tcol S πd κ nm x t = tcol S πd κ nm x t' :=
  (hK q κ _ _).2.2.2.2.2.1 _ _ h

/-! #### Equivariance -/

variable {S πd κ}

/-- **Parent isomorphisms conjugate the certificate groups**: if `g ∈ G|_dom` transports `x` to
`y`, then `F_y = g F_x g⁻¹`. The full test sets of `y` are the images of those of `x` and
`K(T^{π(g)}) = g K(T) g⁻¹` (`GI.Paper.comparison_equivariance`). -/
theorem certGroup_of_iso {x y : S.dom → C} {g : Perm S.dom} (hg : g ∈ S.domGroup)
    (hxy : GI.Transports x y g) :
    certGroup S πd κ y = cmap g (certGroup S πd κ x) := by
  obtain ⟨-, h2, -⟩ := GI.Paper.comparison_equivariance S.domGroup πd hg hxy
  set e : Finset (Fin q) ≃ Finset (Fin q) := Equiv.finsetCongr (lab S.domGroup πd g)
  have he : ∀ T, e T = wmap (lab S.domGroup πd g) T := fun T => rfl
  unfold certGroup
  rw [← e.iSup_comp]
  simp only [cmap, Subgroup.map_iSup]
  refine iSup_congr fun T => ?_
  rw [he]
  have hp : ((wmap (lab S.domGroup πd g) T).card = κ ∧
      IsFull (phiT S.domGroup πd (wmap (lab S.domGroup πd g) T)) y) ↔
      (T.card = κ ∧ IsFull (phiT S.domGroup πd T) x) := by
    rw [Finset.card_map, (h2 T).1]
  rw [iSup_congr_Prop hp fun _ => rfl]
  refine iSup_congr fun _ => ?_
  exact (h2 T).2

omit [Fintype S.dom] [DecidableEq S.dom] in
/-- `π_d(g h g⁻¹) = π_d(g) π_d(h) π_d(g)⁻¹` on the subgroups of `G|_dom`. -/
theorem ideal_cmap {A : Subgroup (Perm S.dom)} (hA : A ≤ S.domGroup) {g : Perm S.dom}
    (hg : g ∈ S.domGroup) :
    (((cmap g A).subgroupOf S.domGroup).map πd).map (alternatingGroup (Fin q)).subtype =
      Canon.conjGrp (lab S.domGroup πd g)
        (((A.subgroupOf S.domGroup).map πd).map (alternatingGroup (Fin q)).subtype) := by
  have hlab : lab S.domGroup πd g = (πd ⟨g, hg⟩ : Perm (Fin q)) := lab_of_mem hg
  ext a
  rw [Canon.mem_conjGrp, hlab]
  simp only [Subgroup.mem_map, Subgroup.mem_subgroupOf, Subgroup.coe_subtype]
  constructor
  · rintro ⟨_, ⟨h, hh, rfl⟩, rfl⟩
    rw [mem_cmap] at hh
    refine ⟨πd ⟨g⁻¹ * h * g, hA hh⟩, ⟨⟨_, _⟩, hh, rfl⟩, ?_⟩
    have : (⟨g⁻¹ * h * g, hA hh⟩ : S.domGroup) = ⟨g, hg⟩⁻¹ * h * ⟨g, hg⟩ := rfl
    rw [this, map_mul, map_mul, map_inv]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  · rintro ⟨_, ⟨h, hh, rfl⟩, hb⟩
    refine ⟨_, ⟨⟨g, hg⟩ * h * ⟨g, hg⟩⁻¹, ?_, rfl⟩, ?_⟩
    · change g * (h : Perm S.dom) * g⁻¹ ∈ cmap g A
      exact conj_mem_cmap hh
    · rw [map_mul, map_mul, map_inv]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      rw [hb]
      group

/-- **Parent isomorphisms conjugate the ideal images** of the certificate groups. -/
theorem idealGrp_of_iso {x y : S.dom → C} {g : Perm S.dom} (hg : g ∈ S.domGroup)
    (hxy : GI.Transports x y g) :
    idealGrp S πd κ y = Canon.conjGrp (lab S.domGroup πd g) (idealGrp S πd κ x) := by
  unfold idealGrp
  rw [certGroup_of_iso hg hxy]
  exact ideal_cmap (certGroup_le S πd κ x) hg

/-- **Parent isomorphisms preserve the comparison classes**: the class of `(y, π(g) t)` is the
class of `(x, t)` (`GI.Paper.noninjective_extension`). -/
theorem tcls_of_iso {x y : S.dom → C} {g : Perm S.dom} (hg : g ∈ S.domGroup)
    (hxy : GI.Transports x y g) (t : Fin κ → Fin q) :
    tcls S πd κ y (lab S.domGroup πd g ∘ t) = tcls S πd κ x t := by
  obtain ⟨heq, -, -, hiso⟩ := GI.Paper.noninjective_extension (C := C) S.domGroup πd κ
  have hr : tupleRel S.domGroup πd κ (x, t) (y, lab S.domGroup πd g ∘ t) := hiso hg hxy t
  ext p
  exact ⟨fun h => heq.trans h (heq.symm hr), fun h => heq.trans h hr⟩

/-- **Parent isomorphisms preserve the tuple colors**: `tcol(y) = tcol(x) ∘ π(g)⁻¹`, for every
numbering of the classes. -/
theorem tcol_of_iso (nm : ClassNum S κ q) {x y : S.dom → C} {g : Perm S.dom}
    (hg : g ∈ S.domGroup) (hxy : GI.Transports x y g) :
    tcol S πd κ nm y = fun t => tcol S πd κ nm x ((lab S.domGroup πd g).symm ∘ t) := by
  funext t
  have ht : t = lab S.domGroup πd g ∘ ((lab S.domGroup πd g).symm ∘ t) := by
    funext i; simp
  conv_lhs => rw [ht]
  unfold tcol
  rw [tcls_of_iso hg hxy]

/-- **Parent isomorphisms carry the refined colors of `x` to those of `y`** (the relabeling
clause of the joint refinement, `JointFn.carries`). -/
theorem rcol_of_iso (hK : JointFn) (nm : ClassNum S κ q) {x y : S.dom → C} {g : Perm S.dom}
    (hg : g ∈ S.domGroup) (hxy : GI.Transports x y g) :
    rcol' S πd κ hK nm x y = fun t => rcol S πd κ hK nm x y ((lab S.domGroup πd g).symm ∘ t) := by
  have hc : CarriesTo (lab S.domGroup πd g) (tcol S πd κ nm x) (tcol S πd κ nm y) :=
    (carriesTo_iff _ _ _).2 (tcol_of_iso nm hg hxy)
  exact (carriesTo_iff _ _ _).1 (hK.carries q κ hc)

/-- **The canonical structure is equivariant**: a parent isomorphism `g` of the domain strings
maps the structure of `(x, t)` to that of `(y, π(g) t)`. -/
theorem canon_of_iso (hK : JointFn) (nm : ClassNum S κ q) {x y : S.dom → C}
    {g : Perm S.dom} (hg : g ∈ S.domGroup) (hxy : GI.Transports x y g) {ℓ : ℕ}
    (t : Fin ℓ → Fin q) :
    lab S.domGroup πd g • canon S πd κ hK nm x y t =
      canon' S πd κ hK nm x y (lab S.domGroup πd g ∘ t) := by
  ext1
  · exact (idealGrp_of_iso hg hxy).symm
  · exact (rcol_of_iso hK nm hg hxy).symm
  · rfl

end Setup

/-! ### Parent isomorphisms of a state -/

section State

variable {Ω C : Type} {S : State Ω C} [Fintype S.dom] [DecidableEq S.dom] {κ : ℕ}

omit [Fintype S.dom] [DecidableEq S.dom] in
/-- A parent isomorphism `g ∈ S.answer` restricts to an isomorphism of the domain strings. -/
theorem transports_dstr {g : Perm Ω} (hg : g ∈ S.answer) :
    GI.Transports (dstr S S.x) (dstr S S.y) (S.domHom ⟨g, hg.1⟩) :=
  fun v => hg.2 v v.2

/-- **The covering argument** (Section A.3: "Every genuine parent isomorphism … carries the chosen
source orbital to one of the enumerated target orbitals. Consequently the branches cover every
parent isomorphism"). Let `π_d : G|_dom → Alt(Γ)` agree with the supplied map `π` on `G`
(`hπ`). Every parent isomorphism `g` maps the canonical structure of `(x, src)` to that of
`(y, π(g) src)`. -/
theorem canon_equivariant (L : GiantLabels S) (πd : S.domGroup →* alternatingGroup (Fin L.q))
    (hπ : ∀ g : S.G, πd ⟨S.domHom g, g, rfl⟩ = L.π g)
    (hK : JointFn) (nm : ClassNum S κ L.q) {ℓ : ℕ} (src : Fin ℓ → Fin L.q)
    {g : Perm Ω} (hg : g ∈ S.answer) :
    (L.π ⟨g, hg.1⟩ : Perm (Fin L.q)) • canon S πd κ hK nm (dstr S S.x) (dstr S S.y) src =
      canon' S πd κ hK nm (dstr S S.x) (dstr S S.y) ((L.π ⟨g, hg.1⟩ : Perm (Fin L.q)) ∘ src) := by
  have hmem : S.domHom ⟨g, hg.1⟩ ∈ S.domGroup := ⟨⟨g, hg.1⟩, rfl⟩
  have h := canon_of_iso (πd := πd) (κ := κ) hK nm hmem (transports_dstr hg) src
  have hlab : lab S.domGroup πd (S.domHom ⟨g, hg.1⟩) = (L.π ⟨g, hg.1⟩ : Perm (Fin L.q)) := by
    rw [lab_of_mem hmem, ← hπ ⟨g, hg.1⟩]
  rw [hlab] at h
  exact h

end State

end GI.Algorithm
