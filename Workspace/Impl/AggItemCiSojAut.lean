import Workspace.Impl.AggItemCiSojAns

/-!
# Rebuilding the matrix automorphism generators from complete transporter cosets

All nonempty physical queries have the same source automorphism subgroup. After
projection, their union is the complete permitted matrix transporter. Pick its
first representative. The source subgroup, together with the differences from
that representative to the other representatives, generates the full matrix
source automorphism group. No extra recursive source--source query is needed.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang GI.Rectangle Equiv Equiv.Perm
open scoped Pointwise

variable {q : ℕ} {W R : Finset (Fin q)}

/-- The subgroup generated by a list in any group. -/
def itcsClosure {G : Type*} [Group G] (gs : List G) : Subgroup G :=
  Subgroup.closure {g | g ∈ gs}

/-- All permitted source matrix automorphisms. -/
def itcsMatrixAut (M : W → R → Bool) : Subgroup (permitted W R) where
  carrier := {g | MatrixTransports M M g}
  one_mem' := matrixTransports_one M
  mul_mem' ha hb := matrixTransports_mul ha hb
  inv_mem' := matrixTransports_inv

/-- The finite list of differences, followed by the common source subgroup generators. -/
def itcsDiffGens (p₀ : permitted W R) (rs gs : List (permitted W R)) :
    List (permitted W R) := rs.map (p₀⁻¹ * ·) ++ gs

/-- A complete transporter written as a union of cosets gives exactly these source generators.
The hypotheses are set equalities of complete cosets, not individual sound representatives. -/
theorem itcs_matrix_aut_gens (M N : W → R → Bool) (rs gs : List (permitted W R))
    {p₀ : permitted W R} (h₀ : p₀ ∈ rs)
    (hcover : ∀ p : permitted W R,
      MatrixTransports M N p ↔ ∃ r ∈ rs, p ∈ r • (itcsClosure gs : Set (permitted W R))) :
    itcsClosure (itcsDiffGens p₀ rs gs) = itcsMatrixAut M := by
  have hrep : ∀ r ∈ rs, MatrixTransports M N r := by
    intro r hr
    exact (hcover r).2 ⟨r, hr, 1, (itcsClosure gs).one_mem, by simp⟩
  have hp₀ := hrep p₀ h₀
  have hsrc : ∀ g ∈ itcsClosure gs, MatrixTransports M M g := by
    intro g hg
    have ht : MatrixTransports M N (p₀ * g) :=
      (hcover _).2 ⟨p₀, h₀, g, hg, rfl⟩
    have hd := matrixTransports_mul (matrixTransports_inv hp₀) ht
    simpa only [inv_mul_cancel_left] using hd
  apply le_antisymm
  · apply (Subgroup.closure_le _).2
    intro g hg
    rcases List.mem_append.1 hg with hdiff | hgen
    · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hdiff
      exact matrixTransports_mul (matrixTransports_inv hp₀) (hrep r hr)
    · exact hsrc g (Subgroup.subset_closure hgen)
  · intro g hg
    have ht : MatrixTransports M N (p₀ * g) := matrixTransports_mul hp₀ hg
    obtain ⟨r, hr, k, hk, he⟩ := (hcover _).1 ht
    have hdiff : p₀⁻¹ * r ∈ itcsClosure (itcsDiffGens p₀ rs gs) :=
      Subgroup.subset_closure (List.mem_append_left _ (List.mem_map.2 ⟨r, hr, rfl⟩))
    have hk' : k ∈ itcsClosure (itcsDiffGens p₀ rs gs) := by
      exact Subgroup.closure_mono (fun p hp => List.mem_append_right _ hp) hk
    have hgEq : g = (p₀⁻¹ * r) * k := by
      calc g = p₀⁻¹ * (p₀ * g) := (inv_mul_cancel_left p₀ g).symm
        _ = p₀⁻¹ * (r * k) := by rw [← he]; rfl
        _ = (p₀⁻¹ * r) * k := (mul_assoc _ _ _).symm
    rw [hgEq]
    exact Subgroup.mul_mem _ hdiff hk'

end GI.Impl
