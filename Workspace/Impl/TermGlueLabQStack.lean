import Workspace.Impl.TermGlueLabQMath
import Workspace.Impl.LinCoordinates
import Mathlib.Algebra.Group.Subgroup.Finsupp

/-!
# A quotient of a presented abelian group by given elements

Step 5 of the label program. The label group is `A/B(x)`, where `A = N/N*` has a
presentation (`linAbelianCoordinates`: generators `a_i` of `N`, a square relation matrix `M`),
and `B(x)` is generated by the images of given elements (the generators `b_j` of the groups
`Aut_N(x_j)` of the representative rows). Each `b_j` has a coordinate vector `Z_j` with
`[b_j] = Σ_i (Z_j)_i [a_i]` (`linElementCoordinates`). Then `A/B(x)` is presented by the
rows of `M` and of `Z` together (`tmGLQ_stack_iff`). This stacked matrix has full column rank,
since `M` is nonsingular (`tmGLQ_stack_inj`), so the quotient program of `TermGlueLabQ`
applies to it.

The statement is generic: `v : Fin t → A` are the images of the generators, and `B ≤ A`.
-/

namespace GI.Impl

open Matrix

variable {t s : ℕ}

/-- **The stacked relation matrix**: the rows of `M`, then the rows of `Z`. -/
def tmGLQStack (M : Matrix (Fin t) (Fin t) ℤ) (Z : Matrix (Fin s) (Fin t) ℤ) :
    Matrix (Fin (t + s)) (Fin t) ℤ :=
  Matrix.of (Fin.append (fun i => M i) (fun j => Z j))

theorem tmGLQStack_vecMul (M : Matrix (Fin t) (Fin t) ℤ) (Z : Matrix (Fin s) (Fin t) ℤ)
    (y : Fin (t + s) → ℤ) :
    Matrix.vecMul y (tmGLQStack M Z) =
      Matrix.vecMul (fun i => y (Fin.castAdd s i)) M +
        Matrix.vecMul (fun j => y (Fin.natAdd t j)) Z := by
  funext k
  simp only [Matrix.vecMul, dotProduct, Pi.add_apply, tmGLQStack, Matrix.of_apply]
  rw [Fin.sum_univ_add]
  simp [Fin.append_left, Fin.append_right]

/-- The stacked matrix has full column rank when `M` is nonsingular. -/
theorem tmGLQ_stack_inj (M : Matrix (Fin t) (Fin t) ℤ) (hM : M.det ≠ 0)
    (Z : Matrix (Fin s) (Fin t) ℤ) : Function.Injective (tmGLQStack M Z).mulVec := by
  have hMi : Function.Injective M.mulVec := by
    intro x y hxy
    apply sub_eq_zero.mp
    apply Matrix.eq_zero_of_mulVec_eq_zero hM
    rw [Matrix.mulVec_sub, hxy, sub_self]
  intro x y hxy
  apply hMi
  funext i
  have := congrFun hxy (Fin.castAdd s i)
  simpa [Matrix.mulVec, dotProduct, tmGLQStack, Fin.append_left] using this

variable {A : Type*} [CommGroup A]

/-- **The quotient by the given elements is presented by the stacked matrix.** If the
coordinate map of `v` has kernel the row lattice of `M`, and `B` is generated by the images of
the rows of `Z`, then a coordinate vector `z` maps into `B` exactly when it lies in the row
lattice of the stacked matrix. -/
theorem tmGLQ_stack_iff (v : Fin t → A) (M : Matrix (Fin t) (Fin t) ℤ)
    (hM : ∀ z, linCoordMap v z = 0 ↔ ∃ y, Matrix.vecMul y M = z)
    (Z : Matrix (Fin s) (Fin t) ℤ) (B : Subgroup A)
    (hB : B = Subgroup.closure (Set.range fun j => Additive.toMul (linCoordMap v (Z j))))
    (z : Fin t → ℤ) :
    Additive.toMul (linCoordMap v z) ∈ B ↔ ∃ y, Matrix.vecMul y (tmGLQStack M Z) = z := by
  have hZ : ∀ w : Fin s → ℤ, linCoordMap v (Matrix.vecMul w Z) =
      ∑ j, w j • linCoordMap v (Z j) := by
    intro w
    have : Matrix.vecMul w Z = ∑ j, w j • Z j := by
      funext k
      simp [Matrix.vecMul, dotProduct, Finset.sum_apply, mul_comm]
    rw [this, map_sum]
    exact Finset.sum_congr rfl fun j _ => map_smul _ _ _
  have hprod : ∀ w : Fin s → ℤ, (∏ j, (Additive.toMul (linCoordMap v (Z j))) ^ w j) =
      Additive.toMul (linCoordMap v (Matrix.vecMul w Z)) := by
    intro w
    rw [hZ, toMul_sum]
    simp [toMul_zsmul]
  rw [hB, Subgroup.mem_closure_range_iff_of_fintype]
  constructor
  · rintro ⟨w, hw⟩
    rw [hprod] at hw
    have hw' : linCoordMap v z = linCoordMap v (Matrix.vecMul w Z) := Additive.toMul.injective hw
    have h0 : linCoordMap v (z - Matrix.vecMul w Z) = 0 := by
      rw [map_sub, hw', sub_self]
    obtain ⟨y, hy⟩ := (hM _).mp h0
    refine ⟨Fin.append y w, ?_⟩
    rw [tmGLQStack_vecMul]
    simp only [Fin.append_left, Fin.append_right]
    rw [hy]
    abel
  · rintro ⟨y, hy⟩
    refine ⟨fun j => y (Fin.natAdd t j), ?_⟩
    rw [tmGLQStack_vecMul] at hy
    have h0 := (hM (Matrix.vecMul (fun i => y (Fin.castAdd s i)) M)).mpr ⟨_, rfl⟩
    rw [hprod, ← hy, map_add, h0, zero_add]

end GI.Impl
