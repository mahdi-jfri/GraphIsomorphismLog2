module

public import Workspace.Impl.TermJGlueLab

@[expose] public section

/-!
# The `J`-answer: `TermJSpec` from the layout of its programs

`tmJ_termJSpec`: if the top function `tmJTopF ne` sits at `f`, the program of the nonempty case
at `ne` (`TmJNEAt`) and the per-label program at `p` (`TmJHAt`), and the primitives sit at their
indices, then `Iface.TermJSpec P K D f` holds. This is the last paragraph of the proof of
Theorem A.23: "Finally lift the surviving quotient representative and correct it by the
constructed `J`-transporter … adjoin `Aut_J(x)`".

The proof checks the preconditions that `tmJ_ne_spec` and `tmJH_spec` leave to their caller at
the row terminal, and reads the output coset off with `tmJ_alg_list`, `tmJ_aut_closure`,
`tmJ_autJ_rt` and `tmJ_ansC_of`.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Multicoset GI.Paper GI.Lang Equiv Equiv.Perm
open GI.Cited (Val encPerm encGroup gens GroupOrder ConstructiveMembership
  NormalizedIntersection HermiteFullRank PointwiseStab Membership NormalizedFactor)
open scoped IsMulCommutative Pointwise

/-- The map of a generated subgroup is generated by the images. -/
theorem tmJ_gens_map' {α : Type} {n : ℕ} (e : α ≃ Fin n) (l : List (Perm α)) :
    gens (l.map (toFin e)) = (Subgroup.closure {x | x ∈ l}).map (toFin e).toMonoidHom := by
  unfold gens
  rw [MonoidHom.map_closure]
  congr 1
  ext g
  simp only [Set.mem_setOf_eq, List.mem_map, Set.mem_image, MulEquiv.coe_toMonoidHom]

theorem tmJ_toFin_refl {k : ℕ} (a : Perm (Fin k)) : toFin (Equiv.refl (Fin k)) a = a := by
  ext i; simp [toFin, Equiv.permCongrHom]

/-- The label set from its canonical answer. -/
theorem tmJ_lab_of_ansC {k : ℕ} {A : Set (Perm (Fin k))} {h0 : Perm (Fin k)}
    {U : List (Perm (Fin k))}
    (hA : toFin (Equiv.refl (Fin k)) '' A = h0 • (gens U : Set (Perm (Fin k)))) :
    A = (h0 * ·) '' (Subgroup.closure {u | u ∈ U} : Set (Perm (Fin k))) := by
  have e : toFin (Equiv.refl (Fin k)) '' A = A := by
    ext σ; simp [tmJ_toFin_refl]
  rw [e] at hA
  rw [hA]
  ext σ
  simp only [Set.mem_smul_set, Set.mem_image, smul_eq_mul]
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- **The `J`-answer** from the layout of its programs. -/
theorem tmJ_termJSpec (hm : Membership) (hfac : NormalizedFactor)
    (hcm : ConstructiveMembership) (hH : HermiteFullRank) (ho : GroupOrder)
    (hni : NormalizedIntersection) (hst : PointwiseStab) :
    ∃ K D : ℕ, ∀ {P : Program} {f ne pr lb au ou jo jni jst : ℕ} {p : TmJHPos},
      P.funs[f]? = some (tmJTopF ne) → TmJNEAt P ne pr lb au ou p.b jo p.jm jni p.jh jst →
      TmJHAt P p →
      P.prims[jo]? = some (groupOrderPrim ho) → P.prims[p.jm]? = some (linMembershipPrim hcm) →
      P.prims[jni]? = some (normalizedIntersectionPrim hni) →
      P.prims[p.jh]? = some (linHermitePrim hH) →
      P.prims[jst]? = some (pointwiseStabPrim hst) →
      P.prims[p.jmem]? = some (membershipPrim hm) →
      P.prims[p.jf]? = some (normalizedFactorPrim hfac) →
      Iface.TermJSpec P K D f := by
  obtain ⟨KH, DH, hHs⟩ := tmJH_spec hm hfac hcm hH
  obtain ⟨Kn, Dn, hNE⟩ := tmJ_ne_spec ho hcm hni hH hst KH DH
  refine ⟨4 * Kn + 130, Dn + 1, ?_⟩
  intro P f ne pr lb au ou jo jni jst p hf hA hHA hjo hjm hjni hjh hjst hjmem hjf
  intro Ω C _ S k e c _ sv lv L hsv _ _ _ _ label hnat hq m h0 E hP σH σN σS hσH hσN hσS htr
    _ _ _ hcard hsN hN hqα us vs hus hvs R' hRH hNR hsolv r hr w hw
  set F := RowForm.ofPure hnat hq E hP ⟨0, h0⟩ with hF
  set T := F.rowTerminalWith P₀ htr hcard hsN hN hqα R' hRH hNR hsolv with hT
  haveI : Nonempty T.B := ⟨⟨0, h0⟩⟩
  have hσN' : gens σN = T.Nb := hσN
  have hq1 : 0 < L.q := by omega
  -- the quotient `⟨σN⟩ / ⟨σS⟩` (row normal form)
  have hleS : gens σS ≤ gens σN := by rw [hσN, hσS]; exact tmJ_rt_le F
  have hconj : ∀ x ∈ gens σS, ∀ y ∈ gens σN, y * x * y⁻¹ ∈ gens σS := by
    rw [hσN, hσS]; exact tmJ_rt_conj F
  have hcomm : ∀ x ∈ gens σN, ∀ y ∈ gens σN, x * y * x⁻¹ * y⁻¹ ∈ gens σS := by
    rw [hσN, hσS]; exact tmJ_rt_comm F
  haveI hnorm := tmJ_normal_of hleS hconj
  haveI hab := tmJ_comm_of (σS := σS) hcomm
  have hker : ∀ n : T.Nb, T.φ n = 1 ↔ n.val ∈ gens σS := fun n => by
    rw [hσS]; exact T.φ_ker n
  have hk : TmJSameKer T.φ (tmJHPsi σS σN) := tmJ_sameKer_of hσN' hker
  have hS : T.φ.ker.map T.Nb.subtype = gens σS := by
    ext g
    constructor
    · rintro ⟨n, hn, rfl⟩; exact (hker n).1 hn
    · intro hg
      have hgN : g ∈ T.Nb := by rw [← hσN']; exact hleS hg
      exact ⟨⟨g, hgN⟩, (hker _).2 hg, rfl⟩
  -- the table of the `N`-tests
  set O := tmJOOf (m := m) us L.q with hO
  obtain ⟨hO1, hO2, hO3⟩ := tmJO_props E σN hus
  have hloc : ∀ a, ∃ r gs, O a a = some (r, gs) ∧
      Subgroup.closure {s | s ∈ gs} = tmJRowAut T.Nb (rowTuple T.e S.x a) := by
    intro a
    obtain ⟨r', gs, h1, h2⟩ := hO1 a
    exact ⟨r', gs, h1, by rw [h2, hσN']; rfl⟩
  have hsome : ∀ a a' b gs, O a a' = some (b, gs) →
      b ∈ T.Nb ∧ rowTuple T.e S.x a ∘ b = rowTuple T.e S.x a' := by
    intro a a' b gs h
    obtain ⟨h1, h2⟩ := hO2 a a' b gs h
    exact ⟨by rw [← hσN']; exact h1, h2⟩
  have hnone : ∀ a a', O a a' = none → ∀ b ∈ T.Nb,
      rowTuple T.e S.x a ∘ b ≠ rowTuple T.e S.x a' := by
    intro a a' h b hb
    exact hO3 a a' h b (by rw [hσN']; exact hb)
  have hlg := tmJTab_lg_mem (N := T.Nb) (x := rowTuple T.e S.x) hloc
  have hlgN : ∀ k : Fin (tmJLgList O).length, ((tmJLgList O).get k).2 ∈ T.Nb := fun k =>
    (hlg k).1
  have hTl := tmJTab_tl_mem (N := T.Nb) (x := rowTuple T.e S.x) hsome
  have hAut := (tmJTab_aut (N := T.Nb) (x := rowTuple T.e S.x) hloc hsome hnone).ge
  -- the stored coset calls
  set Ac : Fin L.q × Fin L.q → Set (Perm (Fin m)) := fun ij =>
    (tmCosetState S E σH ij).answer with hAcd
  have hAc : ∀ ij, Ac ij = (T.cosetCall ij).answer := by
    intro ij
    simp only [hAcd]
    unfold RowTerminal.cosetCall tmCosetState
    rw [hσH]
    rfl
  -- `N^q`
  have hNq : ∀ σ, σ ∈ gens ((tmJNqList (q := L.q) σN).map
      (toFin (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q)))) ↔
      ∃ d : Fin L.q → Perm T.B, (∀ i, d i ∈ T.Nb) ∧
        σ = toFin (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q)) (tmJP (d, 1)) := by
    intro σ
    rw [tmJ_gens_map', Subgroup.mem_map]
    constructor
    · rintro ⟨τ, hτ, rfl⟩
      obtain ⟨d, hd, rfl⟩ := (tmJNq_mem_iff σN τ).1 hτ
      exact ⟨d, fun i => by rw [← hσN']; exact hd i, rfl⟩
    · rintro ⟨d, hd, rfl⟩
      exact ⟨_, (tmJNq_mem_iff σN _).2 ⟨d, fun i => by
        change d i ∈ gens σN; rw [hσN']; exact hd i, rfl⟩, rfl⟩
  -- the input of the top function
  have hs : (domFin e S.dom).length = m * L.q := by
    have h1 := Nat.card_congr (domEquiv e S.dom)
    rw [Nat.card_eq_fintype_card (α := Fin _), Fintype.card_fin] at h1
    rw [← h1, ← Fintype.card_fin m, hcard]; rfl
  have hrH : r ∈ T.Hb := hr
  have hAdef : ∀ a j, Ac (a, j) = {u | u ∈ T.Hb ∧ rowTuple T.e S.x a ∘ ⇑u = rowTuple T.e S.y j} := by
    intro a j
    rw [hAc]
    ext u
    exact tmJ_coset_answer T a j u
  have hlocN : ∀ a, ∃ r gs, O a a = some (r, gs) ∧
      GI.Multicoset.Normalizes (gens gs) (gens σS) := by
    intro a
    obtain ⟨r', gs, h1, h2⟩ := hloc a
    refine ⟨r', gs, h1, fun g hg n hn => hconj n hn g ?_⟩
    have : g ∈ tmJRowAut T.Nb (rowTuple T.e S.x a) := by rw [← h2]; exact hg
    rw [hσN']; exact this.1
  have hlgN' : ∀ p ∈ tmJLgList O, p.2 ∈ gens σN := by
    intro p hp
    obtain ⟨k, rfl⟩ := List.mem_iff_get.1 hp
    rw [hσN']; exact hlgN k
  have hwf : w = .list [] ∨ ∃ (x : Perm (Fin m)) (U : List (Perm (Fin m))),
      w = .list [encPerm x, encGroup U] := by
    rcases hw with ⟨rfl, -⟩ | ⟨x, U, rfl, -, -⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨x, U, rfl⟩
  set V := Val.list [.list [sv, lv, coordsVal e S E, a18Out σH σN σS 0,
    encFun (rowLab e L.con.blocks)], .list us, .list vs] with hV
  have hTop := tmJ_topF_spec (m := m) hf V (encPerm r) w
    (fun u => AnsC (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q)) u
      (tmJSet (tmCosetT T r))) (B := Kn * ((Val.list [V, w]).wt + 1) ^ Dn) hwf ?_ ?_
  · refine hTop.mono fun u cst hu => ⟨hu.1, ?_⟩
    obtain ⟨X, hX⟩ : ∃ X, (Val.list [V, encPerm r, w]).wt = X := ⟨_, rfl⟩
    have hW : (Val.list [V, w]).wt ≤ X := by
      rw [← hX]
      exact wt_list_sublist (List.Sublist.cons_cons _ (List.Sublist.cons _ (List.Sublist.refl _)))
    have h2 := hu.2
    rw [hX] at h2 ⊢
    have p1 : ((Val.list [V, w]).wt + 1) ^ Dn ≤ (X + 1) ^ (Dn + 1) :=
      (Nat.pow_le_pow_left (by omega) Dn).trans (Nat.pow_le_pow_right (by omega) (by omega))
    have p2 : X + 1 ≤ (X + 1) ^ (Dn + 1) := Nat.le_self_pow (by omega) _
    have p3 := Nat.mul_le_mul_left Kn p1
    have e1 : (4 * Kn + 130) * (X + 1) ^ (Dn + 1) =
        4 * (Kn * (X + 1) ^ (Dn + 1)) + 130 * (X + 1) ^ (Dn + 1) := by ring
    rw [e1]
    generalize Kn * ((Val.list [V, w]).wt + 1) ^ Dn = A at *
    generalize Kn * (X + 1) ^ (Dn + 1) = A' at *
    generalize (X + 1) ^ (Dn + 1) = Y at *
    omega
  · rintro rfl
    rcases hw with ⟨-, hE⟩ | ⟨x, U, he, -, -⟩
    · refine Or.inl ⟨rfl, ?_⟩
      rw [tmJSet_eq_image]
      ext σ
      simp only [Set.mem_empty_iff_false, iff_false]
      intro hσ
      obtain ⟨h, hh, -⟩ := tmJ_T_lab T hσ
      rw [hE] at hh
      exact hh
    · exact absurd he (by simp)
  · intro hne
    rcases hw with ⟨rfl, -⟩ | ⟨x, U, rfl, -, hAimg⟩
    · exact absurd rfl hne
    have hLab := tmJ_lab_of_ansC hAimg
    have hlabs : ∀ h ∈ tmJLabs x U, h ∈ tmGlLab T r := by
      intro h hh
      rw [hLab]
      obtain ⟨u, hu, rfl⟩ := List.mem_map.1 hh
      refine ⟨u, ?_, rfl⟩
      rcases List.mem_cons.1 hu with rfl | hu
      · exact Subgroup.one_mem _
      · exact Subgroup.subset_closure hu
    refine (hNE hA hjo hjm hjni hjh hjst e c hsv E hs hq1 σH σN σS hleS hcomm O hlocN us
      (tmJO_hus hus) hlgN' vs lv (encFun (rowLab e L.con.blocks)) x U
      (fun gs h out => TmJHOut T.Nb T.φ (tmJGList e S E gs)
        ((tmJNqList (q := L.q) σN).map (toFin (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q))))
        Ac (tmJLgList O) (tmJTlList O) h out) ?_ ?_).mono ?_
    · intro gs h out hout
      obtain ⟨-, -, -, d', π', -, d, π, c', odd, -, -, -, -, rfl⟩ := hout
      exact ⟨_, rfl⟩
    · intro gs Bm M hgs hB hcert h hh
      have hG : gens (tmJGList e S E gs) =
          (tmJG T).map (toFin (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q))).toMonoidHom :=
        tmJGList_gens e S E hgs
      obtain ⟨hx, hmatch, hcorr⟩ :=
        tmJ_label_hyps T finProdFinEquiv hG hNq Ac hAc hlg hTl hAut hrH (hlabs h hh)
      have hnG := tmJH_normalizes T finProdFinEquiv hG hNq
      exact hHs hHA hjm hjh hjmem hjf _ _ vs σS σN hleS hk (tmJLgList O) (tmJTlList O) Bm M
        hcert hlgN hB h0 hq1 T.Hb T.normalizes hσN' (rowTuple T.e S.x) (rowTuple T.e S.y) Ac
        hAdef hvs hnG h hx hmatch hcorr
    · rintro out cst ⟨⟨gs, Bm, M, hgs, hB, hcert, τ0, τs, hF2, al, hal, hs', rfl, hgens, hlen⟩,
        hcst⟩
      refine ⟨?_, hcst⟩
      have hG : gens (tmJGList e S E gs) =
          (tmJG T).map (toFin (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q))).toMonoidHom :=
        tmJGList_gens e S E hgs
      set ρ := toFin (finProdFinEquiv : Fin m × Fin L.q ≃ Fin (m * L.q)) with hρ
      have hR : List.Forall₂ (fun h t => t ∈ tmJP '' tmCosetT T r ∧ t ∈ tmJCls T.Nb h)
          (tmJLabs x U) ((τ0 :: τs).map ρ.symm) := by
        have h1 := (List.forall₂_and_left _ _).2 ⟨fun h hh => hh, hF2⟩
        rw [List.forall₂_map_right_iff] at h1
        rw [List.forall₂_map_right_iff]
        refine h1.imp ?_
        rintro h τ ⟨hh, hout⟩
        obtain ⟨g, hg, hw, d', π', hd', d, π, c', odd, hd, he, hc, hodd, hout⟩ := hout
        have hτ : τ = ρ (tmJP (d', π') * tmJCorrE (tmJTlList O) odd (tmJLgList O) c') := by
          rw [map_mul]; exact GI.Lang.encPerm_injective hout
        rw [hτ, MulEquiv.symm_apply_apply]
        exact tmJ_label_out T finProdFinEquiv hG hNq Ac hAc hlg hTl hAut hrH (hlabs h hh) hg hw
          hd' hd he c' hc odd hodd
      rw [List.map_cons] at hR
      have hks := (tmJ_aut_closure h0 (rowTuple T.e S.x) hσN' hS hk O hloc hsome hnone hcert hB
        al hal).trans (tmJ_autJ_rt T)
      have hpiece := tmJ_alg_list T hrH x U hLab _ _ hR al hks
      have hgs' : gens hs' = (Subgroup.closure ({a | ∃ t ∈ ρ.symm τ0 :: τs.map ρ.symm,
          a = (ρ.symm τ0)⁻¹ * t} ∪ {k | k ∈ al})).map ρ.toMonoidHom := by
        rw [hgens]
        have eL : (τ0 :: τs).map (τ0⁻¹ * ·) ++ al.map ρ =
            ((ρ.symm τ0 :: τs.map ρ.symm).map ((ρ.symm τ0)⁻¹ * ·) ++ al).map ρ := by
          simp only [List.map_append, List.map_map, List.map_cons]
          congr 2
          · simp
          · refine List.map_congr_left fun τ _ => ?_
            simp
        rw [eL, tmJ_gens_map']
        congr 2
        ext a
        simp only [Set.mem_setOf_eq, List.mem_append, List.mem_map, Set.mem_union]
        constructor
        · rintro (⟨t, ht, rfl⟩ | ha)
          · exact Or.inl ⟨t, ht, rfl⟩
          · exact Or.inr ha
        · rintro (⟨t, ht, rfl⟩ | ha)
          · exact Or.inl ⟨t, ht, rfl⟩
          · exact Or.inr ha
      have hans := tmJ_ansC_of hpiece hs' hgs' hlen
      rwa [MulEquiv.apply_symm_apply] at hans

end GI.Impl
