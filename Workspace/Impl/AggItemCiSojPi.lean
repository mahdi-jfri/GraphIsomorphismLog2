module

public import Workspace.Impl.AggItemCiSojQuery
public import Workspace.Impl.LabelLift

@[expose] public section

/-!
# Projecting a physical answer through the stored graph homomorphism

The parent records generator pairs `(g, πg)`. Swap their two components and use
the existing normalized-factor lift program. Given a physical element `g`, it
returns the unique label element paired with it, namely `πg`. This is the same
constructive group routine used by the paper to move representatives through its
stored homomorphisms.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Cited (Val encPerm NormalizedFactor)

variable {k q : ℕ}

/-- Swap the two permutation factors. -/
def itcsSwapHom (k q : ℕ) : Perm (Fin k) × Perm (Fin q) →* Perm (Fin q) × Perm (Fin k) where
  toFun := Prod.swap
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The graph generated by swapped pairs is the swapped graph. -/
theorem itcs_swapped_gens (ps : List (Perm (Fin k) × Perm (Fin q))) :
    Subgroup.closure {p | p ∈ ps.map Prod.swap} =
      (Subgroup.closure {p | p ∈ ps}).map (itcsSwapHom k q) := by
  rw [MonoidHom.map_closure]
  congr 1
  ext p
  simp [itcsSwapHom]

variable {Ω C : Type} {S : State Ω C} {L : GiantLabels S} (e : Ω ≃ Fin k)

/-- Every physical parent element has a paired label in the swapped graph. -/
theorem itcs_pi_precondition {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L S.G ps) {g : Perm Ω} (hg : g ∈ S.G) :
    ∃ a, (a, toFin e g) ∈ Subgroup.closure {p | p ∈ ps.map Prod.swap} := by
  rw [itcs_swapped_gens, hps]
  refine ⟨(L.π ⟨g, hg⟩ : Perm (Fin L.q)), ?_⟩
  exact ⟨(toFin e g, (L.π ⟨g, hg⟩ : Perm (Fin L.q))),
    (mem_graphOf e L).2 ⟨g, hg, hg, rfl, rfl⟩, rfl⟩

/-- A paired label is unique because the first projection of the original graph is injective. -/
theorem itcs_pi_unique {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L S.G ps) {g : Perm Ω} (hg : g ∈ S.G) {a : Perm (Fin L.q)}
    (ha : (a, toFin e g) ∈ Subgroup.closure {p | p ∈ ps.map Prod.swap}) :
    a = (L.π ⟨g, hg⟩ : Perm (Fin L.q)) := by
  rw [itcs_swapped_gens, hps] at ha
  obtain ⟨p, hp, hswap⟩ := ha
  obtain ⟨g', hg', -, hfst, hsnd⟩ := (mem_graphOf e L).1 hp
  have hp1 : p.1 = toFin e g := congrArg Prod.snd hswap
  have hp2 : p.2 = a := congrArg Prod.fst hswap
  have he : g' = g := (toFin e).injective (hfst.trans hp1)
  subst g'
  exact hp2.symm.trans hsnd.symm

/-- The existing lift body, on the swapped graph context, computes the exact label image.
Its normalization precondition and the existence of a paired element are proved here. -/
theorem itcs_pi_prog (hfac : NormalizedFactor) {Pg : Program} {f sb sp jfac : ℕ}
    (hf : Pg.funs[f]? = some (liftLabF sb sp jfac)) (hsh : ShiftAt Pg sb)
    (hsp : Pg.HasAt sp (pSplitFuns sp)) (hj : Pg.prims[jfac]? = some (normalizedFactorPrim hfac))
    (ps : List (Perm (Fin k) × Perm (Fin L.q))) (hps : PairGens e L S.G ps)
    (g : Perm Ω) (hg : g ∈ S.G) :
    FunDet Pg f (.list [liftLabCtx L.q k (ps.map Prod.swap), encPerm (toFin e g)])
      (encPerm (L.π ⟨g, hg⟩ : Perm (Fin L.q)))
      (liftLabCost (normalizedFactorPrim hfac) (ps.length + L.q + k + 2)) := by
  have h := liftLab_spec hfac hf hsh hsp hj (ps.map Prod.swap)
    (itcs_pi_precondition e hps hg)
  refine FunAll.mono h fun w cost ⟨a, hw, ha, hc⟩ => ?_
  rw [itcs_pi_unique e hps hg ha] at hw
  exact ⟨hw, by simpa only [List.length_map] using hc⟩

end GI.Impl
