import Workspace.Impl.TermJData

/-!
# Few generators of `N ≀ Sym(q)`

`tmJ_wreath_gens2`: for `q ≥ 2`, `N ≀ Sym(q)` is generated by the local generators at the first
coordinate, `(g at 0; 1)` for `g` in a generating list of `N`, and the two pure top
permutations `(1; rotation)`, `(1; (0 1))`. The two top permutations generate `Sym(q)`
(a full cycle and an adjacent transposition), and conjugating `(g at 0; 1)` by `(1; π)` moves
`g` to the coordinate `π 0`. So the closure contains the generators of `tmJ_wreath_gens`.
-/

namespace GI.Impl

open Equiv Equiv.Perm

variable {B : Type} {q : ℕ}

/-- The pure top permutations form a homomorphism. -/
theorem tmJP_top_mul (π π' : Perm (Fin q)) :
    tmJP ((1 : Fin q → Perm B), π) * tmJP ((1 : Fin q → Perm B), π') =
      tmJP ((1 : Fin q → Perm B), π * π') := by
  rw [tmJP_mul]
  congr 2

/-- Conjugating a local generator by a pure top permutation moves its coordinate. -/
theorem tmJP_top_conj_loc (π : Perm (Fin q)) (a : Fin q) (g : Perm B) :
    tmJP ((1 : Fin q → Perm B), π) * tmJLoc a g * (tmJP ((1 : Fin q → Perm B), π))⁻¹ =
      tmJLoc (π a) g := by
  unfold tmJLoc
  rw [tmJP_inv, tmJP_mul, tmJP_mul]
  congr 1
  simp only [Pi.one_apply, inv_one, mul_one, one_mul, Prod.mk.injEq]
  refine ⟨?_, by group⟩
  funext i
  simp only [Pi.mulSingle_apply]
  by_cases h : i = π a
  · subst h; simp
  · rw [if_neg h, if_neg]
    intro h'
    apply h
    rw [← h']
    simp

/-- **Few generators of `N ≀ Sym(q)`.** -/
theorem tmJ_wreath_gens2 (hq : 2 ≤ q) (N : Subgroup (Perm B)) (σN : List (Perm B))
    (hN : Subgroup.closure {s | s ∈ σN} = N) :
    Subgroup.closure ({σ | ∃ g ∈ σN, σ = tmJLoc (q := q) ⟨0, by omega⟩ g} ∪
      {tmJP ((1 : Fin q → Perm B), finRotate q),
        tmJP ((1 : Fin q → Perm B), swap ⟨0, by omega⟩ ⟨1, by omega⟩)}) = tmJW N := by
  set C := Subgroup.closure ({σ | ∃ g ∈ σN, σ = tmJLoc (q := q) ⟨0, by omega⟩ g} ∪
      {tmJP ((1 : Fin q → Perm B), finRotate q),
        tmJP ((1 : Fin q → Perm B), swap ⟨0, by omega⟩ ⟨1, by omega⟩)}) with hC
  -- every pure top permutation lies in `C`
  let φ : Perm (Fin q) →* Perm (B × Fin q) :=
    { toFun := fun π => tmJP ((1 : Fin q → Perm B), π)
      map_one' := tmJP_one
      map_mul' := fun π π' => (tmJP_top_mul π π').symm }
  have htop : ∀ π : Perm (Fin q), tmJP ((1 : Fin q → Perm B), π) ∈ C := by
    obtain ⟨n, rfl⟩ : ∃ n, q = n + 2 := ⟨q - 2, by omega⟩
    have hgen : Subgroup.closure ({finRotate (n + 2), swap 0 (finRotate (n + 2) 0)} :
        Set (Perm (Fin (n + 2)))) = ⊤ :=
      closure_cycle_adjacent_swap isCycle_finRotate support_finRotate 0
    have hle : (⊤ : Subgroup (Perm (Fin (n + 2)))) ≤ C.comap φ := by
      rw [← hgen, Subgroup.closure_le]
      rintro π (rfl | rfl)
      · exact Subgroup.subset_closure (Or.inr (Or.inl rfl))
      · have e1 : (finRotate (n + 2) 0) = ⟨1, by omega⟩ := by
          ext; simp
        change tmJP (1, swap 0 (finRotate (n + 2) 0)) ∈ C
        rw [e1]
        exact Subgroup.subset_closure (Or.inr (Or.inr rfl))
    intro π
    exact hle (Subgroup.mem_top π)
  -- every local generator lies in `C`
  have hloc : ∀ a : Fin q, ∀ g ∈ σN, tmJLoc a g ∈ C := by
    intro a g hg
    have h0 : tmJLoc (q := q) ⟨0, by omega⟩ g ∈ C :=
      Subgroup.subset_closure (Or.inl ⟨g, hg, rfl⟩)
    have := C.mul_mem (C.mul_mem (htop (swap ⟨0, by omega⟩ a)) h0)
      (C.inv_mem (htop (swap ⟨0, by omega⟩ a)))
    rwa [tmJP_top_conj_loc, swap_apply_left] at this
  have hW : ∀ π : Perm (Fin q), tmJP ((1 : Fin q → Perm B), π) ∈ tmJW N :=
    fun π => ⟨_, fun _ => N.one_mem, rfl⟩
  apply le_antisymm
  · rw [hC, Subgroup.closure_le]
    rintro σ (⟨g, hg, rfl⟩ | rfl | rfl)
    · rw [← tmJ_wreath_gens N σN hN]
      exact Subgroup.subset_closure (Or.inl ⟨_, g, hg, rfl⟩)
    · exact hW _
    · exact hW _
  · rw [← tmJ_wreath_gens N σN hN, Subgroup.closure_le]
    rintro σ (⟨a, g, hg, rfl⟩ | ⟨a, a', rfl⟩)
    · exact hloc a g hg
    · exact htop _

end GI.Impl
