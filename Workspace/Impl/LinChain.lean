module

public import Workspace.Cited.AlgoTerminal
public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.OrderOfElement

@[expose] public section

/-! The prefix chain and cyclic relations in A.20. Work in the group A itself.
The commutator hypothesis is precisely the assertion that A/N is abelian.
No assumption that N is normal in the ambient symmetric group is needed. -/
namespace GI.Impl

/-- The subgroup generated by N and the first i quotient generators. -/
def linChain {G : Type*} [Group G] (N : Subgroup G) (as : List G) (i : ℕ) : Subgroup G :=
  N ⊔ Subgroup.closure {g | g ∈ as.take i}

@[simp] theorem linChain_zero {G : Type*} [Group G] (N : Subgroup G) (as : List G) :
    linChain N as 0 = N := by simp [linChain]

/-- Prefixes form an increasing subgroup chain. -/
theorem linChain_mono {G : Type*} [Group G] (N : Subgroup G) (as : List G)
    {i j : ℕ} (hij : i ≤ j) : linChain N as i ≤ linChain N as j := by
  apply sup_le_sup_left
  apply Subgroup.closure_mono
  intro g hg
  have ht := List.take_sublist i (as.take j)
  have ht' : (as.take i).Sublist (as.take j) := by
    simpa only [List.take_take, Nat.min_eq_left hij] using ht
  exact ht'.subset hg

/-- N is contained in every prefix. -/
theorem linChain_base_le {G : Type*} [Group G] (N : Subgroup G) (as : List G) (i : ℕ) :
    N ≤ linChain N as i := le_sup_left

/-- Every intermediate subgroup is normal because all commutators lie in N. -/
theorem linChain_normal {G : Type*} [Group G] (N : Subgroup G) (as : List G)
    (hcomm : ∀ x y : G, x * y * x⁻¹ * y⁻¹ ∈ N) (i : ℕ) :
    (linChain N as i).Normal := by
  constructor
  intro y hy x
  have hc := linChain_base_le N as i (hcomm x y)
  have hm := (linChain N as i).mul_mem hc hy
  simpa only [mul_assoc, inv_mul_cancel, mul_one] using hm

/-- The newly added generator belongs to the next prefix. -/
theorem linChain_generator {G : Type*} [Group G] (N : Subgroup G) (as : List G)
    (i : ℕ) (hi : i < as.length) : as[i] ∈ linChain N as (i + 1) := by
  apply (show Subgroup.closure {g | g ∈ as.take (i + 1)} ≤ linChain N as (i + 1) from le_sup_right)
  exact Subgroup.subset_closure (List.mem_take_iff_getElem.mpr ⟨i, by omega, rfl⟩)

/-- The relation a_i^e_i lies in the preceding prefix, so constructive membership applies. -/
theorem linChain_power {G : Type*} [Group G] (N : Subgroup G) (as : List G)
    (hcomm : ∀ x y : G, x * y * x⁻¹ * y⁻¹ ∈ N) (i : ℕ) (hi : i < as.length) :
    as[i] ^ (linChain N as i).relIndex (linChain N as (i + 1)) ∈ linChain N as i := by
  letI := linChain_normal N as hcomm i
  exact Subgroup.pow_relIndex_mem _ (linChain_generator N as i hi)

/-- The ratio computed by group-order calls is exactly the relative index. -/
theorem linChain_orderRatio {G : Type*} [Group G] [Finite G] (H K : Subgroup G) (hHK : H ≤ K) :
    H.relIndex K = Nat.card K / Nat.card H := by
  have hc := (H.subgroupOf K).index_mul_card
  change H.relIndex K * Nat.card (H.subgroupOf K) = Nat.card K at hc
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hHK).toEquiv] at hc
  exact Nat.eq_div_of_mul_eq_left (Nat.ne_of_gt Nat.card_pos) hc

/-- The successive cyclic orders telescope, including redundant generators of order one. -/
theorem linChain_product {G : Type*} [Group G] (N : Subgroup G) (as : List G) (m : ℕ) :
    (∏ i ∈ Finset.range m, (linChain N as i).relIndex (linChain N as (i + 1))) =
      N.relIndex (linChain N as m) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Finset.prod_range_succ, ih]
    exact Subgroup.relIndex_mul_relIndex _ _ _ (linChain_base_le N as m)
      (linChain_mono N as (Nat.le_succ m))

/-- If the chosen generators generate A modulo N, the product is |A/N|. -/
theorem linChain_product_quotient {G : Type*} [Group G] (N : Subgroup G) (as : List G)
    (hgen : N ⊔ Subgroup.closure {g | g ∈ as} = ⊤) :
    (∏ i ∈ Finset.range as.length,
      (linChain N as i).relIndex (linChain N as (i + 1))) = Nat.card (G ⧸ N) := by
  rw [linChain_product]
  have ht : linChain N as as.length = ⊤ := by simpa only [linChain, List.take_length] using hgen
  rw [ht, Subgroup.relIndex_top_right]
  rfl

end GI.Impl
