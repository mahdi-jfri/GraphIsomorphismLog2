import Workspace.Impl.TermJAutJ2

/-!
# Generators of `Aut_J(x)` (the theorem)

`tmJAutJ φ x`: the elements of `Aut_{N≀Sym}(X)` with label `1` and even top. `tmJ_autJ_gens`:
it is generated by the local `N*`-stabilizers, the local products of generators of the kernel
of the sum map, and the products `t₀ t` of lifted transpositions of two different rows.
-/

namespace GI.Impl

open Equiv Equiv.Perm GI.Multicoset

variable {B : Type} [Nonempty B] {q : ℕ} {N : Subgroup (Perm B)} {A : Type*} [CommGroup A]
  (φ : N →* A) {C : Type} (x : Fin q → B → C)

/-- `Aut_J(X)`: the elements of `Aut_{N≀Sym}(X)` with label `1` and even top. -/
noncomputable def tmJAutJ : Subgroup (Perm (B × Fin q)) where
  carrier := {σ | σ ∈ tmJW N ∧ tmJStr x ∘ σ = tmJStr x ∧ tmJLabOf φ σ = 1 ∧
    sign (tmJTop N σ) = 1}
  one_mem' := by
    refine ⟨(tmJW N).one_mem, rfl, ?_, ?_⟩
    · rw [tmJLabOf, dif_pos (tmJW N).one_mem]; exact map_one _
    · rw [tmJTop, dif_pos (tmJW N).one_mem]; rw [show tmJTopHom (N := N) (q := q) ⟨1, _⟩ = 1 from map_one _]; exact Perm.sign_one
  mul_mem' := by
    rintro σ τ ⟨h1, h2, h3, h4⟩ ⟨k1, k2, k3, k4⟩
    refine ⟨(tmJW N).mul_mem h1 k1, (tmJStab (tmJStr x)).mul_mem h2 k2, ?_, ?_⟩
    · rw [tmJLabOf_mul h1 k1, h3, k3, mul_one]
    · rw [tmJTop_mul h1 k1, Perm.sign_mul, h4, k4, mul_one]
  inv_mem' := by
    rintro σ ⟨h1, h2, h3, h4⟩
    refine ⟨(tmJW N).inv_mem h1, (tmJStab (tmJStr x)).inv_mem h2, ?_, ?_⟩
    · rw [tmJLabOf_inv h1, h3, inv_one]
    · rw [tmJTop_inv h1, Perm.sign_inv, h4]

variable {φ x}

/-- An element of `N ≀ Sym(q)` with trivial top is a pair `(d, 1)`. -/
theorem tmJ_top_one {σ : Perm (B × Fin q)} (hσ : σ ∈ tmJW N) (h1 : tmJTop N σ = 1) : ∃ d : Fin q → Perm B, (∀ i, d i ∈ N) ∧ σ = tmJP (d, 1) := by
  obtain ⟨p, hp, rfl⟩ := hσ
  rw [tmJTop_tmJP hp] at h1
  exact ⟨p.1, hp, by rw [← h1]⟩

/-- **Generators of `Aut_J(x)`.** -/
theorem tmJ_autJ_gens (L0 : Set (Perm (B × Fin q)))
    (h0 : ∀ σ ∈ L0, σ ∈ tmJW N ∧ tmJTop N σ = 1) (Tl : List (Fin q × Fin q × Perm B))
    (hTl : ∀ t ∈ Tl, t.1 ≠ t.2.1 ∧ t.2.2 ∈ N)
    (hAut : Subgroup.closure (L0 ∪ {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2}) =
      tmJW N ⊓ tmJStab (tmJStr x))
    (lg : List (Fin q × Perm B)) (hlg : ∀ a, Subgroup.closure {g | (a, g) ∈ lg} = tmJRowAut N (x a))
    (ns : Fin q → List (Perm B))
    (hns : ∀ a, Subgroup.closure {s | s ∈ ns a} = tmJRowAut (φ.ker.map N.subtype) (x a))
    (Cs : List (Fin lg.length → ℤ))
    (hC : ∀ e, e ∈ AddSubgroup.closure {c | c ∈ Cs} ↔ tmJSumT N φ lg e = 1) :
    Subgroup.closure ({σ | ∃ a, ∃ s ∈ ns a, σ = tmJLoc a s} ∪ {σ | ∃ c ∈ Cs, σ = tmJLam lg c} ∪
      {σ | ∃ t0 ∈ Tl.head?, ∃ t ∈ Tl, σ = tmJSw t0.1 t0.2.1 t0.2.2 * tmJSw t.1 t.2.1 t.2.2}) =
      tmJAutJ φ x := by
  classical
  -- facts on the local generators
  have hlgR : ∀ k : Fin lg.length, (lg.get k).2 ∈ tmJRowAut N (x (lg.get k).1) := by
    intro k
    rw [← hlg]
    exact Subgroup.subset_closure (by simp only [Set.mem_setOf_eq]; exact List.get_mem lg k)
  have hlgN : ∀ k : Fin lg.length, (lg.get k).2 ∈ N := fun k => (hlgR k).1
  have hstab : ∀ d : Fin q → Perm B, (∀ a, d a ∈ tmJRowAut N (x a)) →
      tmJStr x ∘ tmJP (d, 1) = tmJStr x := fun d hd =>
    (tmJ_mem_iso x x (d, 1)).2 fun i => (hd i).2
  have hlab1 : ∀ d : Fin q → Perm B, (∀ a, d a ∈ N) →
      tmJLabOf φ (tmJP (d, 1)) = ∏ a, phiT N φ (d a) := fun d hd =>
    tmJLabOf_tmJP (p := (d, 1)) hd
  have htop1 : ∀ d : Fin q → Perm B, (∀ a, d a ∈ N) → tmJTop N (tmJP (d, 1)) = 1 := fun d hd =>
    tmJTop_tmJP (p := (d, 1)) hd
  have hloc : ∀ (a : Fin q) (s : Perm B), tmJLoc a s = tmJP (Pi.mulSingle a s, 1) :=
    fun _ _ => rfl
  have hsingle : ∀ (a : Fin q) (s : Perm B) (K : Subgroup (Perm B)), s ∈ tmJRowAut K (x a) →
      ∀ i, (Pi.mulSingle a s : Fin q → Perm B) i ∈ tmJRowAut K (x i) := by
    intro a s K hs i
    by_cases hi : i = a
    · subst hi; simpa using hs
    · rw [Pi.mulSingle_eq_of_ne hi]; exact Subgroup.one_mem _
  have hNstar : ∀ {s : Perm B}, s ∈ φ.ker.map N.subtype → s ∈ N ∧ phiT N φ s = 1 := by
    rintro s ⟨n, hn, rfl⟩
    refine ⟨n.2, ?_⟩
    simp only [phiT, Subgroup.coe_subtype, dif_pos n.2]
    exact hn
  have hTW : ∀ σ ∈ {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2}, σ ∈ tmJW N := by
    rintro σ ⟨t, ht, rfl⟩; exact tmJSw_mem (hTl t ht).2
  have hTAut : ∀ σ ∈ Subgroup.closure {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2},
      σ ∈ tmJW N ⊓ tmJStab (tmJStr x) := by
    intro σ hσ
    rw [← hAut]
    exact Subgroup.closure_mono Set.subset_union_right hσ
  have hTlab : ∀ σ ∈ Subgroup.closure {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2},
      tmJLabOf φ σ = 1 := by
    intro σ hσ
    induction hσ using Subgroup.closure_induction with
    | mem σ h =>
      obtain ⟨t, ht, rfl⟩ := h
      exact tmJLabOf_sw (hTl t ht).1 (hTl t ht).2
    | one => rw [tmJLabOf, dif_pos (tmJW N).one_mem]; exact map_one _
    | mul σ τ hσ hτ ihσ ihτ => rw [tmJLabOf_mul (hTAut σ hσ).1 (hTAut τ hτ).1, ihσ, ihτ, mul_one]
    | inv σ hσ ih => rw [tmJLabOf_inv (hTAut σ hσ).1, ih, inv_one]
  have hsw1 : ∀ t ∈ Tl, sign (tmJTop N (tmJSw t.1 t.2.1 t.2.2)) = -1 := fun t ht => by
    rw [tmJTop_sw (hTl t ht).2, sign_swap (hTl t ht).1]
  set S1 := {σ | ∃ a, ∃ s ∈ ns a, σ = tmJLoc a s}
  set S2 := {σ | ∃ c ∈ Cs, σ = tmJLam lg c}
  set S3 := {σ | ∃ t0 ∈ Tl.head?, ∃ t ∈ Tl, σ = tmJSw t0.1 t0.2.1 t0.2.2 * tmJSw t.1 t.2.1 t.2.2}
  apply le_antisymm
  · -- every generator lies in `Aut_J(X)`
    rw [Subgroup.closure_le]
    rintro σ ((⟨a, s, hs, rfl⟩ | ⟨c, hc, rfl⟩) | ⟨t0, ht0, t, ht, rfl⟩)
    · have hs' : s ∈ tmJRowAut (φ.ker.map N.subtype) (x a) := by
        rw [← hns]; exact Subgroup.subset_closure hs
      obtain ⟨hsN, hs1⟩ := hNstar hs'.1
      have hsR : s ∈ tmJRowAut N (x a) := ⟨hsN, hs'.2⟩
      have hd := hsingle a s N hsR
      refine ⟨⟨_, fun i => (hd i).1, rfl⟩, hstab _ hd, ?_, ?_⟩
      · rw [hloc, hlab1 _ fun i => (hd i).1]
        exact (tmJLab_loc (N := N) (φ := φ) a s).trans hs1
      · rw [hloc, htop1 _ fun i => (hd i).1, Perm.sign_one]
    · have hd := tmJLamD_mem hlgR c
      refine ⟨⟨_, fun i => (hd i).1, rfl⟩, hstab _ hd, ?_, ?_⟩
      · unfold tmJLam
        rw [hlab1 _ fun i => (hd i).1]
        simp_rw [phiT_lamD hlgN]
        rw [tmJSum_prod]
        exact (hC c).1 (AddSubgroup.subset_closure hc)
      · unfold tmJLam
        rw [htop1 _ fun i => (hd i).1, Perm.sign_one]
    · have ht0' : t0 ∈ Tl := List.mem_of_mem_head? ht0
      have h1 := hTAut _ (Subgroup.subset_closure ⟨t0, ht0', rfl⟩)
      have h2 := hTAut _ (Subgroup.subset_closure ⟨t, ht, rfl⟩)
      refine ⟨(tmJW N).mul_mem h1.1 h2.1, (tmJStab (tmJStr x)).mul_mem h1.2 h2.2, ?_, ?_⟩
      · rw [tmJLabOf_mul h1.1 h2.1, tmJLabOf_sw (hTl t0 ht0').1 (hTl t0 ht0').2,
          tmJLabOf_sw (hTl t ht).1 (hTl t ht).2, mul_one]
      · rw [tmJTop_mul h1.1 h2.1, Perm.sign_mul, hsw1 t0 ht0', hsw1 t ht]; decide
  · rintro σ ⟨hW, hX, hl, hs⟩
    set G := Subgroup.closure (S1 ∪ S2 ∪ S3)
    have hσA : σ ∈ Subgroup.closure (L0 ∪ {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2}) := by
      rw [hAut]; exact ⟨hW, hX⟩
    obtain ⟨w, hw, hwt⟩ := tmJ_top_match h0 hTW hσA
    -- the transposition part
    have hwG : w ∈ G := by
      cases hT : Tl with
      | nil =>
        have : {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2} = ∅ := by
          rw [hT]; ext σ; simp
        rw [this, Subgroup.closure_empty, Subgroup.mem_bot] at hw
        rw [hw]; exact G.one_mem
      | cons t0 Tr =>
        have ht0 : t0 ∈ Tl := by rw [hT]; exact List.mem_cons_self
        have hev := tmJ_even_part hTl ht0 hw (by rw [hwt]; exact hs)
        refine Subgroup.closure_mono ?_ hev
        rintro τ ⟨t, ht, rfl⟩
        exact Or.inr ⟨t0, by rw [hT]; rfl, t, ht, rfl⟩
    have hwA := hTAut w hw
    -- the rest has trivial top
    have hyW : σ * w⁻¹ ∈ tmJW N := (tmJW N).mul_mem hW ((tmJW N).inv_mem hwA.1)
    have hyt : tmJTop N (σ * w⁻¹) = 1 := by
      rw [tmJTop_mul hW ((tmJW N).inv_mem hwA.1), tmJTop_inv hwA.1, hwt, mul_inv_cancel]
    obtain ⟨d, hdN, hyd⟩ := tmJ_top_one hyW hyt
    have hyX : tmJStr x ∘ tmJP (d, 1) = tmJStr x := by
      rw [← hyd]; exact (tmJStab (tmJStr x)).mul_mem hX ((tmJStab (tmJStr x)).inv_mem hwA.2)
    have hdR : ∀ a, d a ∈ tmJRowAut N (x a) := fun a =>
      ⟨hdN a, (tmJ_mem_iso x x (d, 1)).1 hyX a⟩
    have hyl : ∏ a, phiT N φ (d a) = 1 := by
      rw [← hlab1 d hdN, ← hyd, tmJLabOf_mul hW ((tmJW N).inv_mem hwA.1), tmJLabOf_inv hwA.1,
        hTlab w hw, hl, inv_one, mul_one]
    -- the exponents of each coordinate
    have hexp : ∀ a, ∀ g ∈ Subgroup.closure {g | (a, g) ∈ lg}, ∃ e : Fin lg.length → ℤ,
        phiT N φ g = tmJSum N φ lg e a := by
      intro a g hg
      have hcl : Subgroup.closure {g | (a, g) ∈ lg} ≤ N := by
        rw [hlg]; exact fun g h => h.1
      induction hg using Subgroup.closure_induction with
      | mem g h =>
        obtain ⟨k, hk⟩ := List.mem_iff_get.1 h
        refine ⟨Pi.single k 1, ?_⟩
        rw [tmJSum_single, hk, if_pos rfl]
      | one => exact ⟨0, by rw [phiT_one, tmJSum_zero]⟩
      | mul g g' hg hg' ih ih' =>
        obtain ⟨e, he⟩ := ih
        obtain ⟨e', he'⟩ := ih'
        exact ⟨e + e', by rw [phiT_mul (hcl hg) (hcl hg'), he, he', tmJSum_add]⟩
      | inv g hg ih =>
        obtain ⟨e, he⟩ := ih
        exact ⟨-e, by rw [phiT_inv (hcl hg), he, tmJSum_neg]⟩
    choose ea hea using fun a => hexp a (d a) (by rw [hlg]; exact hdR a)
    set e : Fin lg.length → ℤ := fun k => ea (lg.get k).1 k
    have he : ∀ a, tmJSum N φ lg e a = phiT N φ (d a) := by
      intro a
      rw [hea a]
      unfold tmJSum
      refine Finset.prod_congr rfl fun k _ => ?_
      split_ifs with h
      · simp only [e, h]
      · rfl
    have heC : e ∈ AddSubgroup.closure {c | c ∈ Cs} := by
      rw [hC, ← tmJSum_prod]
      simp_rw [he]
      exact hyl
    -- the local products realize every kernel vector
    have hreal : ∀ e ∈ AddSubgroup.closure {c | c ∈ Cs}, ∃ d' : Fin q → Perm B,
        tmJP (d', 1) ∈ G ∧ (∀ a, d' a ∈ tmJRowAut N (x a)) ∧
        ∀ a, phiT N φ (d' a) = tmJSum N φ lg e a := by
      intro e he
      induction he using AddSubgroup.closure_induction with
      | mem c hc =>
        exact ⟨tmJLamD lg c, Subgroup.subset_closure (Or.inl (Or.inr ⟨c, hc, rfl⟩)),
          tmJLamD_mem hlgR c, phiT_lamD hlgN c⟩
      | zero =>
        have h1 : tmJP ((1 : Fin q → Perm B), (1 : Perm (Fin q))) ∈ G := by
          rw [tmJP_one]; exact G.one_mem
        refine ⟨1, h1, fun a => Subgroup.one_mem _, fun a => ?_⟩
        rw [Pi.one_apply, phiT_one, tmJSum_zero]
      | add e e' _ _ ih ih' =>
        obtain ⟨d1, h1, r1, p1⟩ := ih
        obtain ⟨d2, h2, r2, p2⟩ := ih'
        refine ⟨fun i => d2 i * d1 i, ?_, fun a => Subgroup.mul_mem _ (r2 a) (r1 a), fun a => ?_⟩
        · have := G.mul_mem h1 h2
          rw [tmJP_mul] at this
          exact this
        · rw [phiT_mul (r2 a).1 (r1 a).1, p1, p2, tmJSum_add, mul_comm]
      | neg e _ ih =>
        obtain ⟨d1, h1, r1, p1⟩ := ih
        refine ⟨fun i => (d1 i)⁻¹, ?_, fun a => Subgroup.inv_mem _ (r1 a), fun a => ?_⟩
        · have := G.inv_mem h1
          rw [tmJP_inv] at this
          exact this
        · rw [phiT_inv (r1 a).1, p1, tmJSum_neg]
    obtain ⟨d', hzG, hd'R, hd'p⟩ := hreal e heC
    -- the remaining local part lies in the local `N*`-stabilizers
    have hrest : tmJP (fun i => (d' i)⁻¹ * d i, 1) ∈ G := by
      have hmem := tmJ_pi_mem (fun a => {s | s ∈ ns a}) (d := fun i => (d' i)⁻¹ * d i) (by
        intro a
        rw [hns]
        have hmN : (d' a)⁻¹ * d a ∈ N := N.mul_mem (N.inv_mem (hd'R a).1) (hdN a)
        refine ⟨⟨⟨_, hmN⟩, ?_, rfl⟩, ((tmJRowAut N (x a)).mul_mem
          ((tmJRowAut N (x a)).inv_mem (hd'R a)) (hdR a)).2⟩
        have : phiT N φ ((d' a)⁻¹ * d a) = 1 := by
          rw [phiT_mul (N.inv_mem (hd'R a).1) (hdN a), phiT_inv (hd'R a).1, hd'p, he,
            inv_mul_cancel]
        simpa [phiT, dif_pos hmN] using this)
      exact Subgroup.closure_mono (fun τ h => Or.inl (Or.inl h)) hmem
    have e1 : σ = tmJP (fun i => (d' i)⁻¹ * d i, 1) * tmJP (d', 1) * w := by
      have e2 : tmJP (fun i => (d' i)⁻¹ * d i, 1) * tmJP (d', 1) = tmJP (d, 1) := by
        rw [tmJP_mul]
        congr 1
        refine Prod.ext ?_ (mul_one _)
        funext i
        simp
      rw [e2, ← hyd]; group
    rw [e1]
    exact G.mul_mem (G.mul_mem hrest hzG) hwG

end GI.Impl
