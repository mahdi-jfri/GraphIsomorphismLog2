module

public import Workspace.Impl.TermGlueLabPair

@[expose] public section

/-!
# Generators of `Aut_{N ≀ Sym(q)}(Y)` from the `N`-test table

Proof of Theorem A.23: `Aut_J(x)` uses "the local `N*`-stabilizers ... and
lifted generators of the even Young group on equal-type fibers". Here the full stabilizer of a
string under `N ≀ Sym(q)` is generated by two kinds of elements, both read off the `N`-test
table:

* the local stabilizers `tmGLAt j s = (s at row j; 1)`, `s ∈ Aut_N(y_j)`;
* the exchanges `tmGLSw j j' c = (c at j, c⁻¹ at j'; (j j'))`, with `c ∈ N`, `y_j^c = y_{j'}`.

`tmGL_young`: an element `(μ; π)` of the stabilizer with `π ≠ 1` is moved closer to the identity
by an exchange on a moved row (`Equiv.Perm.card_support_swap_mul`); when `π = 1` it is a product
of local stabilizers.
-/

namespace GI.Impl

open Equiv GI.Multicoset

variable {B : Type} {q : ℕ} {C : Type}

/-- `s` at row `j`, the identity elsewhere. -/
def tmGLAt (j : Fin q) (s : Perm B) : Perm (B × Fin q) :=
  tmGLP (Pi.mulSingle j s, 1)

/-- The exchange of rows `j` and `j'` by `c` (`c` on row `j`, `c⁻¹` on row `j'`). -/
def tmGLSw (j j' : Fin q) (c : Perm B) : Perm (B × Fin q) :=
  tmGLP (fun i => if i = j then c else if i = j' then c⁻¹ else 1, swap j j')

theorem tmGLAt_mul (j : Fin q) (s s' : Perm B) :
    tmGLAt j s * tmGLAt j s' = tmGLAt j (s' * s) := by
  unfold tmGLAt
  rw [tmGL_mul]
  congr 2
  · funext i
    by_cases hi : i = j
    · subst hi; simp
    · simp [Pi.mulSingle_eq_of_ne hi]

theorem tmGLAt_one (j : Fin q) : tmGLAt (B := B) j 1 = 1 := by
  unfold tmGLAt
  rw [show (Pi.mulSingle j (1 : Perm B) : Fin q → Perm B) = 1 by simp, tmGL_one]

theorem tmGLAt_inv (j : Fin q) (s : Perm B) : tmGLAt j s⁻¹ = (tmGLAt j s)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, tmGLAt_mul, mul_inv_cancel, tmGLAt_one]

/-- The image of a generated subgroup under `tmGLAt j` lies in the generated subgroup. -/
theorem tmGLAt_mem_closure {j : Fin q} {Sg : Set (Perm B)} {T : Set (Perm (B × Fin q))}
    (hT : ∀ s ∈ Sg, tmGLAt j s ∈ T) {s : Perm B} (hs : s ∈ Subgroup.closure Sg) :
    tmGLAt j s ∈ Subgroup.closure T := by
  induction hs using Subgroup.closure_induction with
  | mem x hx => exact Subgroup.subset_closure (hT x hx)
  | one => rw [tmGLAt_one]; exact Subgroup.one_mem _
  | mul x y _ _ hx hy => rw [← tmGLAt_mul]; exact Subgroup.mul_mem _ hy hx
  | inv x _ hx => rw [tmGLAt_inv]; exact Subgroup.inv_mem _ hx

variable (y : Fin q → B → C)

theorem tmGLAt_mem_aut {j : Fin q} {s : Perm B} (hs : y j ∘ s = y j) :
    tmGLAt j s ∈ tmGLAut (tmGLStr y) := by
  rw [mem_tmGLAut, tmGLAt, tmGL_str_comp]
  intro i
  by_cases hi : i = j
  · subst hi; simpa using hs
  · simp [Pi.mulSingle_eq_of_ne hi]

theorem tmGLSw_mem_aut {j j' : Fin q} (hjj : j ≠ j') {c : Perm B} (hc : y j ∘ c = y j') :
    tmGLSw j j' c ∈ tmGLAut (tmGLStr y) := by
  rw [mem_tmGLAut, tmGLSw, tmGL_str_comp]
  intro i
  by_cases hi : i = j
  · subst hi; simpa using hc
  · by_cases hi' : i = j'
    · subst hi'
      simp only [if_neg hi, ↓reduceIte, swap_apply_right]
      rw [← hc, Function.comp_assoc, Perm.coe_inv]
      simp
    · simp [hi, hi', swap_apply_of_ne_of_ne hi hi']

theorem tmGLAt_mem_W {N : Subgroup (Perm B)} {j : Fin q} {s : Perm B} (hs : s ∈ N) :
    tmGLAt j s ∈ tmGLW N := by
  rw [mem_tmGLW]
  refine ⟨_, _, rfl, fun i => ?_⟩
  by_cases hi : i = j
  · subst hi; simpa using hs
  · simp [Pi.mulSingle_eq_of_ne hi]

theorem tmGLSw_mem_W {N : Subgroup (Perm B)} {j j' : Fin q} {c : Perm B}
    (hc : c ∈ N) : tmGLSw j j' c ∈ tmGLW N := by
  rw [mem_tmGLW]
  refine ⟨_, _, rfl, fun i => ?_⟩
  split_ifs
  exacts [hc, N.inv_mem hc, N.one_mem]

/-- **Young generation.** Let `Sg j` generate `Aut_N(y_j)`, and let `c j j'` be an element of
`N` carrying `y_j` to `y_{j'}` whenever one exists (`E j j'`). Then `Aut_{N ≀ Sym(q)}(Y)` is
generated by the local stabilizers `tmGLAt j s` (`s ∈ Sg j`) and the exchanges
`tmGLSw j j' (c j j')` (`j ≠ j'`, `E j j'`). -/
theorem tmGL_young {N : Subgroup (Perm B)} (Sg : Fin q → Set (Perm B))
    (hSg : ∀ j s, s ∈ N → y j ∘ s = y j → s ∈ Subgroup.closure (Sg j))
    (E : Fin q → Fin q → Prop) (c : Fin q → Fin q → Perm B)
    (hE : ∀ j j' (n : Perm B), n ∈ N → y j ∘ n = y j' → E j j')
    (T : Set (Perm (B × Fin q)))
    (hTa : ∀ j, ∀ s ∈ Sg j, tmGLAt j s ∈ T)
    (hTs : ∀ j j', j ≠ j' → E j j' → tmGLSw j j' (c j j') ∈ T)
    (hc : ∀ j j', E j j' → c j j' ∈ N ∧ y j ∘ c j j' = y j') :
    tmGLAut (tmGLStr y) ⊓ tmGLW N ≤ Subgroup.closure T := by
  classical
  -- the case `π = 1`: a product of local stabilizers, row by row
  have hbase : ∀ μ : Fin q → Perm B, (∀ i, μ i ∈ N) → (∀ i, y i ∘ μ i = y i) →
      ∀ s : Finset (Fin q),
        tmGLP ((fun i => if i ∈ s then μ i else 1), 1) ∈ Subgroup.closure T := by
    intro μ hμN hμ s
    induction s using Finset.induction_on with
    | empty => simp only [Finset.notMem_empty, ↓reduceIte]; rw [show (fun _ : Fin q =>
        (1 : Perm B)) = 1 from rfl, tmGL_one]; exact Subgroup.one_mem _
    | insert a s has ih =>
      have ha : tmGLAt a (μ a) ∈ Subgroup.closure T :=
        tmGLAt_mem_closure (hTa a) (hSg a _ (hμN a) (hμ a))
      have he : tmGLP ((fun i => if i ∈ insert a s then μ i else 1), (1 : Perm (Fin q))) =
          tmGLP ((fun i => if i ∈ s then μ i else 1), 1) * tmGLAt a (μ a) := by
        unfold tmGLAt
        rw [tmGL_mul]
        congr 2
        · funext i
          by_cases hi : i = a
          · subst hi; simp [has]
          · by_cases his : i ∈ s <;> simp [Finset.mem_insert, hi, his]
      rw [he]
      exact Subgroup.mul_mem _ ih ha
  -- induction on the number of moved rows
  have key : ∀ n (μ : Fin q → Perm B) (π : Perm (Fin q)), π.support.card = n →
      (∀ i, μ i ∈ N) → (∀ i, y i ∘ μ i = y (π i)) →
      tmGLP (μ, π) ∈ Subgroup.closure T := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro μ π hn hμN hμ
    by_cases hπ : π = 1
    · subst hπ
      have := hbase μ hμN (fun i => by simpa using hμ i) Finset.univ
      simpa using this
    · obtain ⟨i, hi⟩ : ∃ i, π i ≠ i := by
        by_contra h
        push Not at h
        exact hπ (Equiv.ext h)
      set j := π i with hj
      have hE' : E i j := hE i j (μ i) (hμN i) (hμ i)
      have hij : i ≠ j := fun h => hi (h ▸ rfl)
      obtain ⟨hcN, hcy⟩ := hc i j hE'
      have ht : tmGLSw i j (c i j) ∈ Subgroup.closure T :=
        Subgroup.subset_closure (hTs i j hij hE')
      -- the product `t σ` moves fewer rows
      set t := tmGLSw i j (c i j)
      have hprod : t * tmGLP (μ, π) = tmGLP (fun k => μ k *
          (fun k => if k = i then c i j else if k = j then (c i j)⁻¹ else 1) (π k),
          swap i j * π) := tmGL_mul _ _ _ _
      have hlt : (swap i j * π).support.card < n := by
        rw [← hn, hj]; exact Equiv.Perm.card_support_swap_mul hi
      have hmem := ih _ hlt _ _ rfl (fun k => by
          refine N.mul_mem (hμN k) (?_ : (if π k = i then c i j else if π k = j then (c i j)⁻¹
            else 1) ∈ N)
          split_ifs
          exacts [hcN, N.inv_mem hcN, N.one_mem])
        (fun k => by
          -- `t σ` stabilizes `Y`
          have h1 : tmGLStr y ∘ tmGLP (μ, π) = tmGLStr y := (tmGL_str_comp y y μ π).mpr hμ
          have h2 : tmGLStr y ∘ t = tmGLStr y := tmGLSw_mem_aut y hij hcy
          have h3 : tmGLStr y ∘ ⇑(t * tmGLP (μ, π)) = tmGLStr y := by
            rw [Perm.coe_mul, ← Function.comp_assoc, h2, h1]
          rw [hprod, tmGL_str_comp] at h3
          exact h3 k)
      rw [← hprod] at hmem
      have : tmGLP (μ, π) = t⁻¹ * (t * tmGLP (μ, π)) := by group
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ ht) hmem
  rintro σ ⟨hσY, hσW⟩
  obtain ⟨μ, π, rfl, hμN⟩ := mem_tmGLW.mp hσW
  exact key _ μ π rfl hμN ((tmGL_str_comp y y μ π).mp hσY)

end GI.Impl
