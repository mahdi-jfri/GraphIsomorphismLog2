import Workspace.Impl.AggItemCiCfgE

/-!
# The configuration query: the automorphisms of a configuration on its fiber

`itciMG X`: the permutations of `Fin q` that map `X` to itself (`PairCfg.Maps X X`): they keep
the fiber with its pair colors and every outer color class. It is generated by the lifts of
generators of the automorphisms `itciAut X` of the pair colors of the fiber (`Aut(C)`), and by
the transpositions of two outer points of the same color, which generate the Young groups on
the outer color classes (`itci_mg_closure`). The even part of `itciMG X` is `autE X`
(`itci_autE_map`), the group `K` of Lemma A.12.
-/

set_option linter.unusedSectionVars false

namespace GI.Impl

open GI.Algorithm GI.Lang Equiv Equiv.Perm Finset

noncomputable section

variable {q : ℕ}

/-- The permutations that map `X` to itself. -/
def itciMG (X : PairCfg q) : Subgroup (Perm (Fin q)) where
  carrier := {σ | PairCfg.Maps X X σ}
  one_mem' := PairCfg.Maps.one X
  mul_mem' {σ τ} hσ hτ := PairCfg.Maps.comp hτ hσ
  inv_mem' {σ} hσ := PairCfg.Maps.inv hσ

theorem itci_mem_mg {X : PairCfg q} {σ : Perm (Fin q)} : σ ∈ itciMG X ↔ PairCfg.Maps X X σ :=
  Iff.rfl

/-- The automorphisms of the pair colors of the fiber, numbered by `Fin n`. -/
def itciAut (X : PairCfg q) : Subgroup (Perm (Fin X.fiber.card)) where
  carrier := {a | ItciKeeps X X rfl a}
  one_mem' i k := rfl
  mul_mem' {a b} ha hb i k := by
    change X.col (X.emb rfl (a (b i))) (X.emb rfl (a (b k))) = _
    rw [ha, hb]
  inv_mem' {a} ha i k := by
    have := ha (a⁻¹ i) (a⁻¹ k)
    rw [Perm.apply_inv_self, Perm.apply_inv_self] at this
    exact this.symm

theorem itciE0_self (X : PairCfg q) : itciE0 X X = 1 := by
  rw [itciE0, mul_inv_cancel]

theorem itci_lift_mg {X : PairCfg q} {a : Perm (Fin X.fiber.card)} (ha : a ∈ itciAut X) :
    itciLift X a ∈ itciMG X := by
  have := itci_ext_maps (X := X) (Y := X) rfl (p := a) ha (itci_al_self X)
  rwa [itciExt, itciE0_self, one_mul] at this

/-- The transpositions of two outer points of the same color (the identity for two points of
different colors): generators of the Young groups on the outer color classes. -/
def itciCsw (X : PairCfg q) : List (Perm (Fin q)) :=
  (itciFo X).flatMap fun a => (itciFo X).map fun b =>
    if X.col a a = X.col b b then swap a b else 1

theorem itci_swap_mg {X : PairCfg q} {a b : Fin q} (ha : a ∉ X.fiber) (hb : b ∉ X.fiber)
    (hab : X.col a a = X.col b b) : swap a b ∈ itciMG X := by
  have hfix : ∀ c ∈ X.fiber, swap a b c = c := fun c hc =>
    swap_apply_of_ne_of_ne (fun h => ha (h ▸ hc)) (fun h => hb (h ▸ hc))
  refine ⟨fun c => ?_, fun c hc d hd => by rw [hfix c hc, hfix d hd], fun c hc => ?_⟩
  · by_cases hc : c ∈ X.fiber
    · rw [hfix c hc]
    · have : swap a b c ∉ X.fiber := by
        rcases eq_or_ne c a with rfl | h1
        · rw [swap_apply_left]; exact hb
        rcases eq_or_ne c b with rfl | h2
        · rw [swap_apply_right]; exact ha
        rw [swap_apply_of_ne_of_ne h1 h2]; exact hc
      exact ⟨fun h => absurd h this, fun h => absurd h hc⟩
  · rcases eq_or_ne c a with rfl | h1
    · rw [swap_apply_left]; exact hab.symm
    rcases eq_or_ne c b with rfl | h2
    · rw [swap_apply_right]; exact hab
    rw [swap_apply_of_ne_of_ne h1 h2]

theorem itci_csw_mg {X : PairCfg q} {s : Perm (Fin q)} (hs : s ∈ itciCsw X) : s ∈ itciMG X := by
  simp only [itciCsw, List.mem_flatMap, List.mem_map] at hs
  obtain ⟨a, ha, b, hb, rfl⟩ := hs
  rw [itci_mem_fo] at ha hb
  split_ifs with hab
  · exact itci_swap_mg ha hb hab
  · exact (itciMG X).one_mem

/-- A permutation that fixes the fiber pointwise and keeps the outer colors is a product of
transpositions of outer points of the same color (induction on the support:
`swap x (τ x) * τ` fixes `x`). -/
theorem itci_fix_mem {X : PairCfg q} {τ : Perm (Fin q)} (hτ : ∀ c ∈ X.fiber, τ c = c)
    (hcol : ∀ a, a ∉ X.fiber → X.col (τ a) (τ a) = X.col a a) :
    τ ∈ Subgroup.closure {s | s ∈ itciCsw X} := by
  classical
  induction h : τ.support.card using Nat.strong_induction_on generalizing τ with
  | _ n ih =>
    by_cases h1 : τ = 1
    · rw [h1]; exact Subgroup.one_mem _
    obtain ⟨x, hx⟩ : ∃ x, τ x ≠ x := by
      by_contra hn
      push_neg at hn
      exact h1 (Equiv.ext hn)
    have hxf : x ∉ X.fiber := fun hm => hx (hτ x hm)
    have htx : τ x ∉ X.fiber := fun hm => hx (τ.injective (hτ _ hm))
    have hsw : swap x (τ x) ∈ Subgroup.closure {s | s ∈ itciCsw X} := by
      refine Subgroup.subset_closure ?_
      simp only [Set.mem_setOf_eq, itciCsw, List.mem_flatMap, List.mem_map]
      exact ⟨x, itci_mem_fo.2 hxf, τ x, itci_mem_fo.2 htx, by rw [if_pos (hcol x hxf).symm]⟩
    have hsm := itci_swap_mg hxf htx (hcol x hxf).symm
    have hrest : swap x (τ x) * τ ∈ Subgroup.closure {s | s ∈ itciCsw X} := by
      refine ih _ (h ▸ card_support_swap_mul hx) (fun c hc => ?_) (fun a ha => ?_) rfl
      · rw [Perm.mul_apply, hτ c hc]
        exact swap_apply_of_ne_of_ne (fun e => hxf (e ▸ hc)) (fun e => htx (e ▸ hc))
      · have hta : τ a ∉ X.fiber := fun hm => ha (by
          have := hτ _ hm; rw [τ.injective this] at hm; exact hm)
        rw [Perm.mul_apply, hsm.2.2 _ hta, hcol a ha]
    have := Subgroup.mul_mem _ hsw hrest
    rwa [← mul_assoc, swap_mul_self, one_mul] at this

/-- **Generators of `itciMG X`**: the lifts of generators of `Aut(C)` and the transpositions of
outer points of the same color. -/
theorem itci_mg_closure (X : PairCfg q) {A : List (Perm (Fin X.fiber.card))}
    (hA : Subgroup.closure {a | a ∈ A} = itciAut X) :
    Subgroup.closure {s | s ∈ A.map (itciLift X) ++ itciCsw X} = itciMG X := by
  classical
  refine le_antisymm ((Subgroup.closure_le _).2 fun s hs => ?_) fun σ hσ => ?_
  · rcases List.mem_append.1 hs with h | h
    · obtain ⟨a, ha, rfl⟩ := List.mem_map.1 h
      exact itci_lift_mg (hA ▸ Subgroup.subset_closure ha)
    · exact itci_csw_mg h
  · have hσ' : ∀ x, σ x ∈ X.fiber ↔ x ∈ X.fiber := hσ.1
    set a : Perm (Fin X.fiber.card) := (itciFE X).symm.permCongr (σ.subtypePerm (p := fun x => x ∈ X.fiber) hσ')
    have hla : itciLift X a = Perm.ofSubtype (σ.subtypePerm (p := fun x => x ∈ X.fiber) hσ') := by
      show Perm.ofSubtype ((itciFE X).permCongr a) = _
      congr 1
      ext x
      simp [a, Equiv.permCongr_apply]
    have haA : a ∈ itciAut X := by
      intro i k
      have h1 := itciLift_emb X a i
      have h2 := itciLift_emb X a k
      rw [hla] at h1 h2
      rw [← h1, ← h2, Perm.ofSubtype_apply_of_mem _ (X.emb_mem rfl i),
        Perm.ofSubtype_apply_of_mem _ (X.emb_mem rfl k)]
      exact hσ.2.1 _ (X.emb_mem rfl i) _ (X.emb_mem rfl k)
    have hfix : ∀ c ∈ X.fiber, ((itciLift X a)⁻¹ * σ) c = c := fun c hc => by
      rw [Perm.mul_apply, Perm.inv_eq_iff_eq, hla, Perm.ofSubtype_apply_of_mem _ hc]
      rfl
    have hcol : ∀ c, c ∉ X.fiber → X.col (((itciLift X a)⁻¹ * σ) c) (((itciLift X a)⁻¹ * σ) c) =
        X.col c c := fun c hc => by
      have hσc : σ c ∉ X.fiber := fun hm => hc ((hσ' c).1 hm)
      have e : (itciLift X a)⁻¹ (σ c) = σ c := by
        rw [Perm.inv_eq_iff_eq, itciLift_out X a hσc]
      rw [Perm.mul_apply, e]
      exact hσ.2.2 c hc
    have hL : itciLift X a ∈ Subgroup.closure {s | s ∈ A.map (itciLift X) ++ itciCsw X} := by
      have : a ∈ Subgroup.closure {a | a ∈ A} := hA ▸ haA
      have hm := Subgroup.mem_map_of_mem (itciLift X) this
      rw [MonoidHom.map_closure] at hm
      refine (Subgroup.closure_mono ?_) hm
      rintro _ ⟨b, hb, rfl⟩
      exact List.mem_append_left _ (List.mem_map_of_mem hb)
    have hT := (Subgroup.closure_mono (fun s (hs : s ∈ itciCsw X) =>
      (List.mem_append_right _ hs : s ∈ A.map (itciLift X) ++ itciCsw X))) (itci_fix_mem hfix hcol)
    have := Subgroup.mul_mem _ hL hT
    rwa [mul_inv_cancel_left] at this

/-- **The even part is `autE X`.** -/
theorem itci_autE_map (X : PairCfg q) :
    X.autE.map (alternatingGroup (Fin q)).subtype = itciMG X ⊓ alternatingGroup (Fin q) := by
  ext σ
  constructor
  · rintro ⟨e, he, rfl⟩
    exact ⟨he, e.2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨⟨σ, h2⟩, h1, rfl⟩

end

end GI.Impl
