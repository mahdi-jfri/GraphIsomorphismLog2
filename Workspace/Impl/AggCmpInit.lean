module

public import Workspace.Impl.AggCosets
public import Workspace.Impl.AggCmpTup

@[expose] public section

/-!
# The first coset of a comparison

The lockstep run of the comparison of `(z, t)` with `(z', t')` starts from the stage-`0` coset
`lockstep 0`. At stage `0` the windows are empty (`win_zero`), so the masks are constant and the
coset is the set of `g ∈ G|_dom` whose label permutation maps the tuple `t` to `t'`
(`cm_lockstep_zero`). It does not depend on the strings.

The program finds an element of it with the orbit program of the label points of `t` under the
graph pairs of `G` (`graphTup_spec`): the coset is nonempty exactly when the label points of `t'`
lie in that orbit (`cm_init_empty`), and the first part of the transversal element of that point,
restricted to the domain, lies in the coset (`cm_init_mem`).
-/

set_option linter.unusedSectionVars false

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm GI.LocalGroups GI.Endpoint
  GI.LocalCertificates
open GI.Cited (Val encPerm gens)

variable {k κ : ℕ} {Ω C : Type}

/-- The label points `k + t i` of a tuple, in order. -/
def cmLabPts (k : ℕ) {q : ℕ} (t : Fin κ → Fin q) : List (Fin (k + q)) :=
  labPts k ((List.finRange κ).map t)

section Zero

variable {V Γ C₀ : Type} [Fintype V] [DecidableEq V] [Fintype Γ] [DecidableEq Γ]
  (G : Subgroup (Perm V)) (π : G →* alternatingGroup Γ)

/-- **The first coset of a comparison** is the set of `g ∈ G` with `π(g) ∘ t = t'`: the windows
of stage `0` are empty, so the masks transport under every permutation. -/
theorem cm_lockstep_zero (x y : V → C₀) (t t' : Fin κ → Γ) (g : Perm V) :
    g ∈ lockstep G π 0 x t y t' ↔ g ∈ G ∧ ∀ i, lab G π g (t i) = t' i := by
  unfold lockstep
  simp only [Set.mem_setOf_eq, win_zero]
  constructor
  · exact fun h => ⟨h.1, h.2.1⟩
  · intro h
    refine ⟨h.1, h.2, fun v => ?_⟩
    simp [mask]

end Zero

variable {e : Ω ≃ Fin k} {S : State Ω C} [DecidableEq Ω] [Fintype S.dom] {L : GiantLabels S}
  (πd : S.domGroup →* alternatingGroup (Fin L.q))

/-- The label permutation of a restriction is that of the labels. -/
theorem cm_lab_domHom (hπ : ∀ g : S.G, πd ⟨S.domHom g, g, rfl⟩ = L.π g) {g : Perm Ω}
    (hg : g ∈ S.G) :
    lab S.domGroup πd (S.domHom ⟨g, hg⟩) = (L.π ⟨g, hg⟩ : Perm (Fin L.q)) := by
  have hm : S.domHom ⟨g, hg⟩ ∈ S.domGroup := ⟨⟨g, hg⟩, rfl⟩
  rw [lab_of_mem hm, ← hπ]

/-- **A transversal element gives a member of the first coset**: if a pair `p` of the group
generated by the graph pairs of `G` maps the label points of `t` to those of `t'`, the
restriction of its first part lies in the first coset. -/
theorem cm_init_mem (hπ : ∀ g : S.G, πd ⟨S.domHom g, g, rfl⟩ = L.π g)
    {ps : List (Perm (Fin k) × Perm (Fin L.q))} (hps : PairGens e L S.G ps)
    {p : Perm (Fin k) × Perm (Fin L.q)} (hp : encPair p ∈ gens (ps.map encPair))
    {t t' : Fin κ → Fin L.q} (hmap : (cmLabPts k t).map (encPair p) = cmLabPts k t')
    {C₀ : Type} (x y : S.dom → C₀) :
    domOfPos e S p.1 ∈ lockstep S.domGroup πd 0 x t y t' := by
  obtain ⟨p', hp'', he⟩ := mem_gens_encPair.1 hp
  have := encPair_injective he
  subst this
  rw [hps] at hp''
  obtain ⟨g, hg, -, h1, h2⟩ := (mem_graphOf e L).1 hp''
  rw [← h1, domOfPos_toFin e S hg, cm_lockstep_zero]
  refine ⟨⟨⟨g, hg⟩, rfl⟩, fun i => ?_⟩
  rw [cm_lab_domHom πd hπ hg, h2]
  unfold cmLabPts at hmap
  rw [map_encPair_labPts] at hmap
  have := congrArg (fun l => l[(i : ℕ)]?) (labPts_injective hmap)
  simpa using this

/-- **The first coset is empty** when the label points of `t'` are not in the orbit of those of
`t` under the group generated by the graph pairs of `G`. -/
theorem cm_init_empty (hπ : ∀ g : S.G, πd ⟨S.domHom g, g, rfl⟩ = L.π g)
    {ps : List (Perm (Fin k) × Perm (Fin L.q))} (hps : PairGens e L S.G ps)
    {t t' : Fin κ → Fin L.q}
    (hno : cmLabPts k t' ∉ actOrbit (fun g (xs : List (Fin (k + L.q))) => xs.map g)
      (ps.map encPair) (cmLabPts k t))
    {C₀ : Type} (x y : S.dom → C₀) :
    lockstep S.domGroup πd 0 x t y t' = ∅ := by
  refine Set.eq_empty_iff_forall_notMem.2 fun a ha => hno ?_
  obtain ⟨hdom, hlab⟩ := (cm_lockstep_zero _ _ x y t t' a).1 ha
  obtain ⟨⟨g, hg⟩, rfl⟩ := hdom
  refine mem_tupOrbit.2 ⟨_, (mem_gens_snd hps _).2 ⟨g, hg, hg, rfl⟩, ?_⟩
  unfold cmLabPts
  rw [List.map_map]
  congr 1
  refine List.map_congr_left fun i _ => ?_
  simp only [Function.comp_apply]
  rw [← cm_lab_domHom πd hπ hg]
  exact hlab i

end GI.Impl
