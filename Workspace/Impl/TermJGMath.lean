module

public import Workspace.Impl.TermCosetRel
public import Workspace.Impl.TermJGroup

@[expose] public section

/-!
# Generators of `G|_dom` on the pair numbering

The state stores generators `gs` of `G` on `Fin k`. Restricted to the domain positions
(`restrP`, as in `DomRestrict.lean`) they generate `G|_dom` on `Fin s`, numbered by
`domEquiv`. Relabeled by the inverse of `tmCsRho e E : Fin (m q) ≃ Fin s` they generate the
image of the domain group on the pairs, `(G|_dom ∘ E)` numbered by `finProdFinEquiv`
(`tmJ_gens_dom`). This is the group `tmJG` of `TermJGroup.lean`.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv
open GI.Cited (Val encPerm encGroup gens)

variable {Ω C : Type} {k : ℕ}

/-- The domain group on the pairs, for coordinates `E`. -/
def tmJGE (S : State Ω C) {m q : ℕ} (E : Fin m × Fin q ≃ S.dom) :
    Subgroup (Perm (Fin m × Fin q)) :=
  S.domGroup.comap (Equiv.permCongrHom E).toMonoidHom

/-- The map of a generated subgroup is generated by the images. -/
theorem tmJ_gens_map {s t : ℕ} (ρ : Fin s ≃ Fin t) (gs : List (Perm (Fin s))) :
    gens (gs.map (toFin ρ)) = (gens gs).map (toFin ρ).toMonoidHom := by
  unfold gens
  rw [MonoidHom.map_closure]
  congr 1
  ext g
  simp only [Set.mem_setOf_eq, List.mem_map, Set.mem_image, MulEquiv.coe_toMonoidHom]

/-- **Generators of the domain group on the pairs.** -/
theorem tmJ_gens_dom (e : Ω ≃ Fin k) (S : State Ω C) {m q : ℕ} (E : Fin m × Fin q ≃ S.dom)
    {gs : List (Perm (Fin k))} (hgs : gens gs = groupFin e S.G) :
    gens ((gs.map (restrP e S.G S.dom S.dom_inv)).map (toFin (tmCsRho e E).symm)) =
      (tmJGE S E).map (toFin (finProdFinEquiv : Fin m × Fin q ≃ Fin (m * q))).toMonoidHom := by
  rw [tmJ_gens_map, gens_restrP e S.G S.dom S.dom_inv hgs]
  have h1 : (restrictHom S.G S.dom S.dom_inv).range = S.domGroup := rfl
  rw [h1]
  unfold groupFin tmJGE
  rw [Subgroup.map_map]
  ext τ
  simp only [Subgroup.mem_map, Subgroup.mem_comap, MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom,
    Function.comp_apply]
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨(Equiv.permCongrHom E).symm y, ?_, ?_⟩
    · rw [MulEquiv.apply_symm_apply]; exact hy
    · ext t
      simp [toFin, tmCsRho, Equiv.permCongr_apply, Equiv.permCongrHom]
  · rintro ⟨σ, hσ, rfl⟩
    refine ⟨Equiv.permCongrHom E σ, hσ, ?_⟩
    ext t
    simp [toFin, tmCsRho, Equiv.permCongr_apply, Equiv.permCongrHom]

end GI.Impl
