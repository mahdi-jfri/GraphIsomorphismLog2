module

public import Workspace.Impl.SCosPaste3

@[expose] public section

/-!
# The paste function when some answer is nonempty

The branch of `scosPasteF` after the test, on the environment `[as, fs]` with `fs` the nonempty
answers `[zⱼ, lvⱼ]` (`scosPaste_then`). It returns `[z₁, w]` with `w` a group value of the
group generated by the generators of `lv₁` and the `z₁⁻¹ zⱼ`.
-/

namespace GI.Impl

open GI.Cited GI.Lang GI.Proved Equiv

variable {n : ℕ}

/-- Bounds on the powers of `M`. -/
theorem scosPaste_Mpow {M : ℕ} (hM : 1 ≤ M) :
    M ≤ M ^ 6 ∧ M ^ 2 ≤ M ^ 6 ∧ M ^ 3 ≤ M ^ 6 ∧ M ^ 4 ≤ M ^ 6 ∧ 1 ≤ M ^ 4 := by
  refine ⟨?_, ?_, ?_, ?_, Nat.one_le_pow _ _ hM⟩
  · simpa using Nat.pow_le_pow_right hM (show 1 ≤ 6 by omega)
  all_goals exact Nat.pow_le_pow_right hM (by omega)

section Prog

variable {c : ℕ} {hps : PointwiseStab} {hpre : Preimage} {hmb : MinimalBlocks}

local notation "𝒫" => scosProgram c hps hpre hmb

/-- The pointwise stabilizer call at the end of the paste. -/
theorem scosPaste_pstabCall {env : List Val} {hs : List (Perm (Fin (n + n)))}
    (henv : env[5]? = some (encGroup hs)) {M : ℕ} (hM : 1 ≤ M)
    (hg : (encGroup hs).wt ≤ 4173160 * M ^ 4) :
    EvalAll 𝒫 env (.call 117 (mk2 (.var 5) .nil)) (fun w cost =>
      GroupVal (n + n) w (gens hs) ∧ w.wt ≤ 320 * (n + n + 1) ^ 6 ∧
      cost ≤ (pointwiseStabPrim hps).boundSize (10000000 * M ^ 4) +
        pstabK * (10000000 * M ^ 4) ^ 9 + 100000000 * M ^ 4 + 1000 * (n + n + 1) ^ 6) := by
  refine EvalAll.call_funAll (Det.mk2 (Det.var' (P := 𝒫) henv) Det.nil) fun v ca h => ?_
  obtain ⟨rfl, hca⟩ := h
  refine (pstab_spec hps scos_pstab scos_prim0 (GensVal.groupVal rfl) []).mono
    fun w cost hw => ⟨?_, hw.2.1, ?_⟩
  · have := hw.1; rwa [scosPaste_pstabNil] at this
  · have hv : (Val.list [encGroup hs, encPts ([] : List (Fin (n + n)))]).wt ≤
        10000000 * M ^ 4 := by
      have := wt_list2_le (encGroup hs) (encPts ([] : List (Fin (n + n))))
      have h4 : (encPts ([] : List (Fin (n + n)))).wt = 4 := by simp [encPts]
      have := Nat.one_le_pow 4 M hM
      omega
    have hb := GI.Lang.Prim.bound_le (pointwiseStabPrim hps)
      ((Val.list [encGroup hs, encPts ([] : List (Fin (n + n)))]).size_le_wt.trans hv)
    have hp9 := Nat.mul_le_mul_left pstabK (Nat.pow_le_pow_left hv 9)
    have h4 : (Val.list [encGroup hs, Val.list []]).wt =
        (Val.list [encGroup hs, encPts ([] : List (Fin (n + n)))]).wt := rfl
    have hc := hw.2.2
    have hww := hw.2.1
    have := Nat.one_le_pow 4 M hM
    simp only [encPts] at hv hb hp9 hc h4
    omega

/-- **The paste, when some answer is nonempty.** -/
theorem scosPaste_then {K : Subgroup (ScosPair n)} {Φ : Finset (Fin n)} {z₁ : ScosPair n}
    {zr : List (ScosPair n)} {gs₁ : List (Perm (Fin (n + n)))} {fr : List Val} {v0 : Val}
    (hgood : List.Forall₂ (ScosPasteGood n K Φ) (z₁ :: zr)
      (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr))
    (hlv : (encGroup gs₁).wt ≤ scosW n) (hlen : fr.length + 1 ≤ (n + n + 1) ^ c) :
    EvalAll 𝒫 [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr)]
      (.letE (.get (.var 1) (.nat 0))
      (.letE (.call 75 (.get (.var 2) (.nat 0)))
      (.letE (.call 247 (mk2 (.var 3) (.var 1)))
      (.letE (.call 150 (mk2 (.length (.var 3))
        (.call 250 (mk2 (.get (.get (.var 2) (.nat 1)) (.nat 1)) (.var 4)))))
      (mk2 (.get (.var 2) (.nat 0)) (.call 117 (mk2 (.var 5) .nil)))))))
      (fun w cost => ∃ w', w = .list [encPerm (nintSum z₁), w'] ∧
        GroupVal (n + n) w' (gens ((1 :: gs₁) ++
          (z₁ :: zr).map (fun z => (nintSum z₁)⁻¹ * nintSum z))) ∧ w'.wt ≤ scosW n ∧
        cost ≤ (pointwiseStabPrim hps).boundSize (scosPasteGW n c) +
          pstabK * scosPasteGW n c ^ 9 + 100000000000000 * scosPasteM n c ^ 6) := by
  have hQ := scosPaste_Q n
  have hlen' : (Val.list [encPerm (nintSum z₁), encGroup gs₁] :: fr).length ≤
      (n + n + 1) ^ c := by simpa using hlen
  have hM := scosPaste_M n c hlen'
  have hMp := scosPaste_Mpow hM.2.2.2
  obtain ⟨hQ1, hQ2, hQ3, hQ4, hQ5⟩ := hQ
  obtain ⟨hMp1, hMp2, hMp3, hMp4, hMp5⟩ := hMp
  have hzl : (z₁ :: zr).length = (Val.list [encPerm (nintSum z₁), encGroup gs₁] :: fr).length :=
    hgood.length_eq
  -- weights of the nonempty answers
  have wfs : ∀ a ∈ Val.list [encPerm (nintSum z₁), encGroup gs₁] :: fr,
      a.wt ≤ 700 * (n + n + 1) ^ 6 := fun a ha => by
    obtain ⟨z, -, lv, rfl, -, hlv'⟩ := scosPaste_mem_right hgood ha
    have := wt_list2_le (encPerm (nintSum z)) lv
    have := scosPaste_wt_perm (nintSum z)
    unfold scosW at hlv'
    omega
  have Wfs := GI.Lang.wt_list_le_of _ wfs
  have wa₁ := wfs _ (List.mem_cons_self ..)
  have wlv : (encGroup gs₁).wt ≤ 320 * (n + n + 1) ^ 6 := hlv
  have wz₁ := scosPaste_wt_perm (nintSum z₁)
  have we₁ := scosPaste_wt_perm (nintSum z₁)⁻¹
  generalize hfs : Val.list [encPerm (nintSum z₁), encGroup gs₁] :: fr = fs at hzl Wfs hM
  have hLQ : fs.length * (n + n + 1) ^ 6 + (n + n + 1) ^ 6 ≤ scosPasteM n c := by
    have := hM.2.1; rw [Nat.add_mul, Nat.one_mul] at this; exact this
  have e1 : fs.length * (2 * (700 * (n + n + 1) ^ 6) + 1) =
      1400 * (fs.length * (n + n + 1) ^ 6) + fs.length := by ring
  rw [e1] at Wfs
  subst hfs
  have hM1 := hM.1
  have hM3 := hM.2.2.1
  -- step: the first answer
  have d2 := Det.get' (Det.var' (P := 𝒫)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr)]) (i := 1) rfl)
    (Det.nat 0) (v := .list [encPerm (nintSum z₁), encGroup gs₁]) rfl
  refine EvalAll.letE d2 fun v2 c2 h2 => ?_
  obtain ⟨rfl, hc2⟩ := h2
  have hc2' : c2 ≤ 3000 * scosPasteM n c ^ 6 := by omega
  clear hc2
  -- step: `z₁⁻¹`
  have d3 := Det.call (Det.get' (Det.var' (P := 𝒫)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr),
      .list [encPerm (nintSum z₁), encGroup gs₁]]) (i := 2) rfl) (Det.nat 0)
      (v := encPerm (nintSum z₁)) rfl) (inv_spec scos_inv (nintSum z₁))
  refine EvalAll.letE d3 fun v3 c3 h3 => ?_
  obtain ⟨rfl, hc3⟩ := h3
  have hc3' : c3 ≤ 200000 * scosPasteM n c ^ 6 := by
    have h4 : invK * (n + n + 1) ^ 4 ≤ 100000 * (n + n + 1) ^ 6 := by
      unfold invK; exact Nat.mul_le_mul_left _ hQ5
    omega
  clear hc3
  -- step: the `z₁⁻¹ zⱼ`
  have hf : ∀ a ∈ Val.list [encPerm (nintSum z₁), encGroup gs₁] :: fr,
      FunAll 𝒫 9 (.list [encPerm (nintSum z₁)⁻¹, a]) (fun w cost =>
        (fun a w => ∀ (z : ScosPair n) (lv : Val), a = .list [encPerm (nintSum z), lv] →
          w = encPerm ((nintSum z₁)⁻¹ * nintSum z)) a w ∧
        cost ≤ (fun _ => 100000 * (n + n + 1) ^ 6) a) := by
    intro a ha
    obtain ⟨z, -, lv, rfl, -, hlv'⟩ := scosPaste_mem_right hgood ha
    refine FunAll.mono (scosPaste_extraStep (c := c) (hps := hps) (hpre := hpre) (hmb := hmb) _ _
      hlv') fun w cost h => ⟨fun z' lv' heq => ?_, h.2⟩
    simp only [Val.list.injEq, List.cons.injEq] at heq
    rw [h.1, nintSum_injective (encPerm_injective heq.1)]
  have hmapD : FunAll 𝒫 247 (.list [encPerm (nintSum z₁)⁻¹,
      .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr)]) (fun w' cost =>
      w' = .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm) ∧
      cost ≤ (fr.length + 1) * (100000 * (n + n + 1) ^ 6) + mapK * (fr.length + 1 + 1) *
        ((Val.list [encPerm (nintSum z₁)⁻¹,
          .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr)]).wt +
        (Val.list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)).wt
          + 1)) :=
    (map_spec scos_extraMap hf).mono fun w cost h => by
      obtain ⟨ws, hw, h2, hc⟩ := h
      have := scosPaste_ws hgood h2
      subst hw; subst this
      simp only [List.map_const', List.sum_replicate, smul_eq_mul, List.length_cons] at hc
      exact ⟨rfl, hc⟩
  have d4 := Det.call (Det.mk2 (Det.var' (P := 𝒫)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr),
      .list [encPerm (nintSum z₁), encGroup gs₁], encPerm (nintSum z₁)⁻¹]) (i := 3) rfl)
      (Det.var' (i := 1) rfl)) hmapD
  refine EvalAll.letE d4 fun v4 c4 h4 => ?_
  obtain ⟨rfl, hc4⟩ := h4
  -- weights of the list of the `z₁⁻¹ zⱼ`
  have wW : (Val.list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)).wt ≤
      9 * scosPasteM n c + 4 := by
    have h1 := GI.Lang.wt_list_le_of
      (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)
      (c := 4 * (n + n + 1) ^ 6) fun v hv => by
        obtain ⟨σ, -, rfl⟩ := List.mem_map.mp hv
        exact scosPaste_wt_perm σ
    simp only [List.length_map] at h1
    rw [hzl] at h1
    have e : (Val.list [encPerm (nintSum z₁), encGroup gs₁] :: fr).length *
        (2 * (4 * (n + n + 1) ^ 6) + 1) = 8 * ((Val.list [encPerm (nintSum z₁), encGroup gs₁]
          :: fr).length * (n + n + 1) ^ 6) + (Val.list [encPerm (nintSum z₁), encGroup gs₁]
          :: fr).length := by ring
    rw [e] at h1
    have := hM.2.2.1
    omega
  have hc4' : c4 ≤ 10000000 * scosPasteM n c ^ 6 := by
    have w2 := wt_list2_le (encPerm (nintSum z₁)⁻¹)
      (.list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr))
    simp only [List.length_cons] at Wfs hLQ hM
    have hin : (Val.list [encPerm (nintSum z₁)⁻¹,
          .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr)]).wt +
        (Val.list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)).wt
          + 1 ≤ 4000 * scosPasteM n c := by omega
    have hov := Nat.mul_le_mul (Nat.mul_le_mul_left mapK hM.2.2.1) hin
    have e : mapK * scosPasteM n c * (4000 * scosPasteM n c) = 4000000 * scosPasteM n c ^ 2 := by
      unfold mapK; ring
    have hl : (fr.length + 1) * (100000 * (n + n + 1) ^ 6) ≤ 100000 * scosPasteM n c := by
      nlinarith
    omega
  clear hc4 hmapD hf
  -- step: the group value of the generators
  have dlen := Det.length (Det.var' (P := 𝒫)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr),
      .list [encPerm (nintSum z₁), encGroup gs₁], encPerm (nintSum z₁)⁻¹,
      .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)]) (i := 3)
      (v := .list ((List.finRange (n + n)).map fun i => .nat ((nintSum z₁)⁻¹ i))) rfl)
  simp only [List.length_map, List.length_finRange] at dlen
  have dget := Det.get' (Det.get' (Det.var' (P := 𝒫)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr),
      .list [encPerm (nintSum z₁), encGroup gs₁], encPerm (nintSum z₁)⁻¹,
      .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)]) (i := 2) rfl)
      (Det.nat 1) (v := encGroup gs₁) rfl) (Det.nat 1) (v := .list ((1 :: gs₁).map encPerm)) rfl
  have happD : FunAll 𝒫 250 (.list [.list ((1 :: gs₁).map encPerm),
      .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)])
      (fun w' cost => w' = .list ((1 :: gs₁).map encPerm ++
        ((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm) ∧
      cost ≤ loopModK * ((((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map
        encPerm).length + 1) * ((Val.list [.list ((1 :: gs₁).map encPerm),
        .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)]).wt +
        (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm).length +
        (Val.list ((1 :: gs₁).map encPerm ++
          ((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)).wt + 1)) :=
    (append_spec scos_append2 _ _).mono fun w cost h => by
      obtain ⟨rfl, hc⟩ := h
      exact ⟨rfl, hc⟩
  have dapp := Det.call (Det.mk2 dget (Det.var' (i := 4) rfl)) happD
  rw [← List.map_append] at dapp
  have d5 := Det.call (Det.mk2 dlen dapp) (mkGroup_spec scos_mkGroup
    ((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z))
  refine EvalAll.letE d5 fun v5 c5 h5 => ?_
  obtain ⟨rfl, hc5⟩ := h5
  -- weights of the generators
  have hgl : (1 :: gs₁).length ≤ 320 * (n + n + 1) ^ 6 := by
    have h1 := length_lt_wt_list ((1 :: gs₁).map encPerm)
    have h2 : (Val.list ((1 :: gs₁).map encPerm)).wt < (encGroup gs₁).wt :=
      wt_le_wt_list (vs := [.nat (n + n), .list ((1 :: gs₁).map encPerm)]) (by simp)
    rw [List.length_map] at h1
    omega
  have hhl : ((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).length + 2 ≤
      323 * scosPasteM n c := by
    rw [List.length_append, List.length_map, hzl]
    have h1 := hM.2.2.1
    simp only [List.length_cons] at h1 hgl ⊢
    omega
  have hNM : n + n + 1 ≤ scosPasteM n c := hQ2.trans hM.1
  have hprod : (((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).length + 2) *
      (n + n + 1) ≤ 323 * scosPasteM n c ^ 2 := by
    calc _ ≤ 323 * scosPasteM n c * scosPasteM n c := Nat.mul_le_mul hhl hNM
      _ = 323 * scosPasteM n c ^ 2 := by ring
  have hmk : mkGroupK * ((((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).length
      + 2) * (n + n + 1)) ^ 3 ≤ 3369826700000 * scosPasteM n c ^ 6 := by
    calc _ ≤ mkGroupK * (323 * scosPasteM n c ^ 2) ^ 3 :=
          Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hprod 3)
      _ = 3369826700000 * scosPasteM n c ^ 6 := by unfold mkGroupK; ring
  have heg : (encGroup ((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z)).wt ≤
      4173160 * scosPasteM n c ^ 4 := by
    have h1 := wt_encGroup_le ((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z)
    calc _ ≤ _ := h1
      _ ≤ 40 * (323 * scosPasteM n c ^ 2) ^ 2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hprod 2)
      _ = 4173160 * scosPasteM n c ^ 4 := by ring
  have hgw : (Val.list (((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map
      encPerm)).wt ≤ 2907 * scosPasteM n c ^ 2 + 4 := by
    have h1 := GI.Lang.wt_list_le_of
      (((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)
      (c := 4 * (n + n + 1) ^ 6) fun v hv => by
        obtain ⟨σ, -, rfl⟩ := List.mem_map.mp hv
        exact scosPaste_wt_perm σ
    rw [List.length_map] at h1
    have h2 : (((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).length) *
        (2 * (4 * (n + n + 1) ^ 6) + 1) ≤ (323 * scosPasteM n c) * (9 * scosPasteM n c) :=
      Nat.mul_le_mul (by omega) (by have := hM.1; omega)
    have e : (323 * scosPasteM n c) * (9 * scosPasteM n c) = 2907 * scosPasteM n c ^ 2 := by ring
    omega
  have hc5' : c5 ≤ 10000000000000 * scosPasteM n c ^ 6 := by
    have e0 : (Val.list ((List.finRange (n + n)).map fun i => Val.nat ((nintSum z₁)⁻¹ i))).wt =
        (encPerm (nintSum z₁)⁻¹).wt := rfl
    have hWl : (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm).length =
        fr.length + 1 := by
      simp only [List.length_map]; rw [hzl]; simp
    have wn := wt_nat_le (n + n)
    have w1 := wt_list2_le (.nat (n + n))
      (.list (((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm))
    have w2 := wt_list2_le (.list ((1 :: gs₁).map encPerm))
      (.list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm))
    have hxs : (Val.list ((1 :: gs₁).map encPerm)).wt < (encGroup gs₁).wt :=
      wt_le_wt_list (vs := [.nat (n + n), .list ((1 :: gs₁).map encPerm)]) (by simp)
    have hMM : scosPasteM n c ≤ scosPasteM n c ^ 2 := Nat.le_self_pow (by omega) _
    have hl3 : fr.length + 1 + 1 ≤ scosPasteM n c := by simpa using hM3
    have hin : (Val.list [.list ((1 :: gs₁).map encPerm),
        .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)]).wt +
        (fr.length + 1) + (Val.list (((1 :: gs₁) ++ (z₁ :: zr).map
          fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm)).wt + 1 ≤
        4000 * scosPasteM n c ^ 2 := by omega
    have hov := Nat.mul_le_mul (Nat.mul_le_mul_left loopModK hl3) hin
    have e : loopModK * scosPasteM n c * (4000 * scosPasteM n c ^ 2) =
        4000000 * scosPasteM n c ^ 3 := by unfold loopModK; ring
    rw [List.map_append] at hgw
    rw [hWl] at hc5
    omega
  clear hc5
  -- step: the answer
  have dz := Det.get' (Det.var' (P := 𝒫)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr),
      .list [encPerm (nintSum z₁), encGroup gs₁], encPerm (nintSum z₁)⁻¹,
      .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm),
      encGroup ((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z)]) (i := 2) rfl)
    (Det.nat 0) (v := encPerm (nintSum z₁)) rfl
  have dp := scosPaste_pstabCall (c := c) (hps := hps) (hpre := hpre) (hmb := hmb)
    (env := [v0, .list (.list [encPerm (nintSum z₁), encGroup gs₁] :: fr),
      .list [encPerm (nintSum z₁), encGroup gs₁], encPerm (nintSum z₁)⁻¹,
      .list (((z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z).map encPerm),
      encGroup ((1 :: gs₁) ++ (z₁ :: zr).map fun z => (nintSum z₁)⁻¹ * nintSum z)])
    rfl hM.2.2.2 heg
  refine (EvalAll.mk2_last dz dp).mono fun w cost h => ?_
  obtain ⟨vb, cb, ⟨hvb, hwvb, hcb⟩, rfl, hcost⟩ := h
  refine ⟨vb, rfl, hvb, hwvb, ?_⟩
  have ww := wt_list2_le (encPerm (nintSum z₁)) vb
  unfold scosPasteGW
  omega

end Prog

end GI.Impl
