module

public import Workspace.Impl.VsFMatPow
public import Workspace.Impl.VStabLinAll

@[expose] public section

/-!
# A basis of the algebra generated by matrices

We want a basis of the unital algebra `𝔽_p[g_1, …, g_m]` spanned by the products of the
generators. We keep a list `Bm` of matrices of the algebra, together with an echelon basis of
their flattened forms (the matrices read as vectors of length `d²`). We start with `I · I`. Then
we go through `Bm` in order. For the matrix `M = Bm[i]` and each generator `g`, we insert the
flattened product `M g` into the echelon basis. When it is new, `M g` is appended to `Bm`.

Since the flattened matrices of `Bm` are independent, `Bm` has at most `d²` matrices, so `d²`
passes reach every matrix of `Bm`. At the end the span of `Bm` contains `1` and is closed under
right multiplication by the generators, so it is the whole algebra
(`GI.Proved.vsFAlgSpanL_span` in `Proved/VsFAlgSpanMath.lean`).

The tags of the insertion are not used here, so they are empty.

* `vsFAUpd`, `vsFAInner`: one insertion of a product `M g`.
* `vsFAOuter`: the pass for `Bm[i]`, over all generators.
* `vsFAlgSpanL`: `D` passes, starting from the insertion of `I · I`.
-/

namespace GI.Impl

/-- The state after an insertion `a` of the product `Mg`: append `Mg` to the matrices when
the echelon basis grew. -/
def vsFAUpd (st : (List VsRow × List (List ℕ)) × List (List (List ℕ)))
    (a : List VsRow × List (List ℕ)) (Mg : List (List ℕ)) :
    (List VsRow × List (List ℕ)) × List (List (List ℕ)) :=
  (a, if st.1.1.length < a.1.length then st.2 ++ [Mg] else st.2)

/-- Insert the product `M g` (start vector `z` of the product). -/
def vsFAInner (p : ℕ) (z : List ℕ) (M : List (List ℕ))
    (st : (List VsRow × List (List ℕ)) × List (List (List ℕ))) (g : List (List ℕ)) :
    (List VsRow × List (List ℕ)) × List (List (List ℕ)) :=
  vsFAUpd st (vsAllStep p st.1 ((vsFMatMulL p M g z).flatten, [])) (vsFMatMulL p M g z)

/-- Pass `i`: if there is a matrix `Bm[i]`, insert its products with all generators. -/
def vsFAOuter (p : ℕ) (z : List ℕ) (gs : List (List (List ℕ)))
    (st : (List VsRow × List (List ℕ)) × List (List (List ℕ))) (i : ℕ) :
    (List VsRow × List (List ℕ)) × List (List (List ℕ)) :=
  if i < st.2.length then gs.foldl (vsFAInner p z (st.2.getD i [])) st else st

/-- The basis of the algebra: `D` passes, starting from the insertion of `I · I`. -/
def vsFAlgSpanL (p : ℕ) (z : List ℕ) (I : List (List ℕ)) (gs : List (List (List ℕ))) (D : ℕ) :
    (List VsRow × List (List ℕ)) × List (List (List ℕ)) :=
  (List.range D).foldl (vsFAOuter p z gs) (vsFAInner p z I (([], []), []) I)

end GI.Impl
