import Workspace.Impl.VsHQ8P

/-!
# What the `Q₈` branch returns

From the orbit list `Lo` and the stabilizer `⟨ks⟩` of `vsHQ8_spec`:

* `vsHQ8_cover`: every `c ∈ ⟨ccs⟩` is `u k` with `u` a transversal element and `k ∈ ⟨ks⟩`;
* `vsHQ8_stab`: `h ∈ ⟨ks⟩` iff `h ∈ ⟨ccs⟩` and `ρ h` centralizes `Ȳ = ⟨ρ B⟩ S`.
-/

open Matrix

namespace GI.Impl

open GI.Lang GI.Cited GI.Proved Equiv

variable {I : VecStabInst} {s : VsQSt I}

theorem vsH_genGroup_one (ccs : List (Perm (Fin I.n))) : genGroup (1 :: ccs) = gens ccs := by
  apply le_antisymm
  · exact (Subgroup.closure_le _).2 fun g hg => by
      rcases List.mem_cons.1 hg with rfl | hg
      · exact one_mem _
      · exact Subgroup.subset_closure hg
  · exact Subgroup.closure_mono fun g hg => List.mem_cons_of_mem _ hg

/-- **Coverage.** -/
theorem vsHQ8_cover (hs : VsQStOK s) {ccs B ks : List (Perm (Fin I.n))} (hcc : gens ccs ≤ gens s.hs)
    {Lo : List (List (Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) × Perm (Fin I.n))}
    (hLo : VsQOrbL (vsHAlT s) (1 :: ccs) (B.map (vsHT s)) Lo)
    (hks : ∀ h, h ∈ gens ks ↔ h ∈ gens ccs ∧ vsHAlT s h (B.map (vsHT s)) = B.map (vsHT s)) :
    (∀ u ∈ Lo.map Prod.snd, u ∈ gens ccs) ∧
      ∀ c ∈ gens ccs, ∃ u ∈ Lo.map Prod.snd, u⁻¹ * c ∈ gens ks := by
  have hα := vsH_conjT_act hs
  have hgg := vsH_genGroup_one ccs
  refine ⟨fun u hu => ?_, fun c hc => ?_⟩
  · obtain ⟨q, hq, rfl⟩ := List.mem_map.1 hu
    exact hgg ▸ (hLo.pr q hq).1
  · have hmem : vsHAlT s c (B.map (vsHT s)) ∈ vsQOrb (vsHAlT s) (1 :: ccs) (B.map (vsHT s)) :=
      ⟨c, hgg ▸ hc, rfl⟩
    obtain ⟨q, hq, hq1⟩ := List.mem_map.1 ((hLo.mem _).2 hmem)
    obtain ⟨hu, hu1⟩ := hLo.pr q hq
    have hu' : q.2 ∈ gens ccs := hgg ▸ hu
    refine ⟨q.2, List.mem_map_of_mem hq, (hks _).2 ⟨mul_mem (inv_mem hu') hc, ?_⟩⟩
    rw [hα.mul _ (inv_mem (hcc hu')) _ (hcc hc), ← hq1, ← hu1,
      ← hα.mul _ (inv_mem (hcc hu')) _ (hcc hu'), inv_mul_cancel, hα.one]

/-- **The stabilizer is the centralizer of `Ȳ` in `C`.** -/
theorem vsHQ8_stab [Fact I.p.Prime] (hs : VsQStOK s) {as ccs B : List (Perm (Fin I.n))}
    (hB : ∀ b ∈ B, b ∈ gens s.hs) (hcc : gens ccs ≤ gens s.hs)
    (hccC : vsPBar hs (gens ccs) ≤ Subgroup.centralizer (vsPBar hs (gens as) : Set _))
    {h : Perm (Fin I.n)} (hh : h ∈ gens ccs) :
    vsHAlT s h (B.map (vsHT s)) = B.map (vsHT s) ↔
      vsPRho hs h ∈ Subgroup.centralizer ((Subgroup.closure (vsPRho hs '' {b | b ∈ B}) ⊔
        vsMScal (vsPBar hs (gens as)) : Subgroup _) : Set (Module.End (ZMod I.p)
          (Fin (vsQD s) → ZMod I.p))ˣ) := by
  rw [vsH_q8_fix hs hB (hcc hh)]
  have hC : vsPRho hs h ∈ Subgroup.centralizer (vsPBar hs (gens as) : Set _) :=
    hccC (vsPRho_mem_vsPBar hs hh (hcc hh))
  constructor
  · intro H
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    -- `y` is in the subgroup generated by the `ρ b` and `S`, all commuting with `ρ h`
    have hle : Subgroup.closure (vsPRho hs '' {b | b ∈ B}) ⊔ vsMScal (vsPBar hs (gens as)) ≤
        Subgroup.centralizer {vsPRho hs h} := by
      refine sup_le ((Subgroup.closure_le _).2 ?_) ?_
      · rintro _ ⟨b, hb, rfl⟩
        rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
        intro z hz
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact H b hb
      · intro t ht
        rw [Subgroup.mem_centralizer_iff]
        intro z hz
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact vsM_comm_scal hC ht
    have := Subgroup.mem_centralizer_iff.1 (hle hy) (vsPRho hs h) rfl
    exact this.symm
  · intro H b hb
    have hbY : vsPRho hs b ∈ Subgroup.closure (vsPRho hs '' {b | b ∈ B}) ⊔
        vsMScal (vsPBar hs (gens as)) :=
      Subgroup.mem_sup_left (Subgroup.subset_closure ⟨b, hb, rfl⟩)
    exact (Subgroup.mem_centralizer_iff.1 H _ hbY).symm

end GI.Impl
