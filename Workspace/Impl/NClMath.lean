module

public import Workspace.Lang.Prims.Reduce

@[expose] public section

/-!
# The mathematics of the normal closure loop

The normal closure of `⟨hs⟩` in `G = ⟨gs, hs⟩` is computed as in Luks (1993, DIMACS 11, item
(3.11), p. 145) and Seress (*Permutation Group Algorithms*, Section 5.1.4). Keep a list `L`
whose group `⟨L⟩` lies in the normal closure. For each entry `l` of `L` and each generator `g`
of `G`, add `g l g⁻¹` to `L` when it is not yet in `⟨L⟩`. Additions are made by the doubling
filter `keepStep` of `Workspace.Lang.Prims.Reduce`, so `2 ^ |L| ≤ |⟨L⟩|` throughout and
`|L| ≤ n²`.

The entries of `1 :: L` are processed in order, one per round (`nclProc`), for `n² + 1` rounds
(`nclLoop`). New entries go to the end of `L`, so they are processed in later rounds. Since `L`
never has more than `n²` entries, all entries have been processed after the last round. Then
`⟨L⟩` is normalized by every generator of `G`, hence by `G` (a finite group, `ncl_normalizes`),
and it contains `hs`; so it contains the normal closure (`ncl_correct`).
-/

namespace GI.Impl

open GI.Cited GI.Lang Equiv

variable {n : ℕ}

/-! ### Conjugation and closures -/

/-- If conjugation by `g` maps a generating set into `H`, it maps the generated group into `H`. -/
theorem ncl_conj_closure {S : Set (Perm (Fin n))} {H : Subgroup (Perm (Fin n))}
    {g : Perm (Fin n)} (h : ∀ y ∈ S, g * y * g⁻¹ ∈ H) :
    ∀ x ∈ Subgroup.closure S, g * x * g⁻¹ ∈ H := by
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem y hy => exact h y hy
  | one => simp
  | mul x y _ _ hx hy =>
    have e : g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) := by group
    rw [e]; exact H.mul_mem hx hy
  | inv x _ hx =>
    have e : g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ := by group
    rw [e]; exact H.inv_mem hx

/-- **A finite subgroup normalized by generators is normalized by the group they generate.**
Conjugation by `g` maps `H` into itself and is injective, so on the finite set `H` it is onto;
hence `g` lies in the normalizer of `H`, and so does the group generated by such `g`. -/
theorem ncl_normalizes {H : Subgroup (Perm (Fin n))} {A : Set (Perm (Fin n))}
    (h : ∀ g ∈ A, ∀ x ∈ H, g * x * g⁻¹ ∈ H) :
    ∀ g ∈ Subgroup.closure A, ∀ x ∈ H, g * x * g⁻¹ ∈ H := by
  have hle : Subgroup.closure A ≤ Subgroup.normalizer (H : Set (Perm (Fin n))) := by
    rw [Subgroup.closure_le]
    intro g hg
    rw [SetLike.mem_coe, Subgroup.mem_normalizer_iff]
    intro x
    refine ⟨h g hg x, fun hx => ?_⟩
    let f : H → H := fun y => ⟨g * y * g⁻¹, h g hg y y.2⟩
    have hf : Function.Injective f := fun a b hab => by
      have : g * (a : Perm (Fin n)) * g⁻¹ = g * b * g⁻¹ := congrArg Subtype.val hab
      exact Subtype.ext (by simpa using this)
    obtain ⟨y, hy⟩ := (Finite.injective_iff_surjective.mp hf) ⟨_, hx⟩
    have : g * (y : Perm (Fin n)) * g⁻¹ = g * x * g⁻¹ := congrArg Subtype.val hy
    have e : (y : Perm (Fin n)) = x := by simpa using this
    exact e ▸ y.2
  intro g hg x hx
  exact (Subgroup.mem_normalizer_iff.mp (hle hg) x).mp hx

/-! ### The doubling filter -/

theorem keepStep_prefix (L : List (Perm (Fin n))) (x : Perm (Fin n)) : L <+: keepStep L x := by
  classical
  unfold keepStep; split_ifs
  · exact List.prefix_refl L
  · exact List.prefix_append L [x]

theorem gens_mono_prefix {L L' : List (Perm (Fin n))} (h : L <+: L') : gens L ≤ gens L' :=
  Subgroup.closure_mono fun _ hg => h.subset hg

theorem mem_gens_keepStep (L : List (Perm (Fin n))) (x : Perm (Fin n)) : x ∈ gens (keepStep L x) := by
  classical
  unfold keepStep; split_ifs with hx
  · exact hx
  · exact Subgroup.subset_closure (by simp)

theorem mem_keepStep {L : List (Perm (Fin n))} {x y : Perm (Fin n)} (hy : y ∈ keepStep L x) :
    y ∈ L ∨ y = x := by
  classical
  unfold keepStep at hy; split_ifs at hy
  · exact Or.inl hy
  · simpa using hy

theorem nclGood_length_keepStep_le {L : List (Perm (Fin n))} (hl : L.length ≤ n ^ 2)
    (x : Perm (Fin n)) : (keepStep L x).length ≤ n ^ 2 + 1 := by
  classical
  unfold keepStep; split_ifs
  · omega
  · simp only [List.length_append, List.length_singleton]; omega

theorem wt_encGroup_succ {L : List (Perm (Fin n))} (hl : L.length ≤ n ^ 2 + 1) :
    (encGroup L).wt ≤ 360 * (n + 1) ^ 6 := by
  have h1 := wt_encGroup_le L
  have h2 : (L.length + 2) * (n + 1) ≤ 3 * (n + 1) ^ 3 := by
    have e : (n + 1) ^ 3 = (n + 1) ^ 2 * (n + 1) := by ring
    have e2 : (n + 1) ^ 2 = n ^ 2 + 2 * n + 1 := by ring
    rw [e]
    exact le_trans (Nat.mul_le_mul_right _ (show L.length + 2 ≤ 3 * (n + 1) ^ 2 by omega))
      (by rw [Nat.mul_assoc])
  have h3 := Nat.pow_le_pow_left h2 2
  have e : (3 * (n + 1) ^ 3) ^ 2 = 9 * (n + 1) ^ 6 := by ring
  omega

/-- `L` was built by the doubling filter: `2 ^ |L| ≤ |⟨L⟩|`. -/
def NclGood (L : List (Perm (Fin n))) : Prop := 2 ^ L.length ≤ Nat.card (gens L)

theorem nclGood_keepStep {L : List (Perm (Fin n))} (h : NclGood L) (x : Perm (Fin n)) :
    NclGood (keepStep L x) := card_foldl_keepStep [x] L h

theorem nclGood_keepList (l : List (Perm (Fin n))) : NclGood (keepList l) :=
  card_foldl_keepStep l [] Nat.card_pos

/-- **At most `n²` entries**: `2 ^ |L| ≤ |⟨L⟩| ≤ n! ≤ 2 ^ (n²)`. -/
theorem NclGood.length_le {L : List (Perm (Fin n))} (h : NclGood L) : L.length ≤ n ^ 2 := by
  have h2 : Nat.card (gens L) ≤ 2 ^ (n ^ 2) := by
    have := Subgroup.card_le_of_le (le_top : gens L ≤ ⊤)
    rw [Subgroup.card_top] at this
    exact this.trans (GI.CitedChecks.card_perm_le n)
  exact (Nat.pow_le_pow_iff_right (by norm_num)).mp (h.trans h2)

/-! ### The loop -/

/-- Add the conjugate `g l g⁻¹` by the filter. -/
noncomputable def nclConj (l : Perm (Fin n)) (L : List (Perm (Fin n))) (g : Perm (Fin n)) :
    List (Perm (Fin n)) :=
  keepStep L (g * l * g⁻¹)

/-- Round `i`: process entry `i` of `1 :: L`, if there is one, with every `g ∈ A`. -/
noncomputable def nclProc (A L : List (Perm (Fin n))) (i : ℕ) : List (Perm (Fin n)) :=
  if h : i < (1 :: L).length then A.foldl (nclConj ((1 :: L)[i])) L else L

/-- The first `k` rounds. -/
noncomputable def nclLoop (A L : List (Perm (Fin n))) (k : ℕ) : List (Perm (Fin n)) :=
  (List.range k).foldl (nclProc A) L

theorem nclLoop_succ (A L : List (Perm (Fin n))) (k : ℕ) :
    nclLoop A L (k + 1) = nclProc A (nclLoop A L k) k := by
  simp [nclLoop, List.range_succ, List.foldl_append]

/-- The facts kept by the conjugation fold: prefix, the filter bound, entries in `N`, and every
conjugate is in the group of the result. -/
theorem foldl_nclConj {N : Subgroup (Perm (Fin n))} (l : Perm (Fin n)) (hl : l ∈ N) :
    ∀ (A L : List (Perm (Fin n))), (∀ g ∈ A, ∀ x ∈ N, g * x * g⁻¹ ∈ N) → NclGood L →
      (∀ y ∈ L, y ∈ N) →
      L <+: A.foldl (nclConj l) L ∧ NclGood (A.foldl (nclConj l) L) ∧
      (∀ y ∈ A.foldl (nclConj l) L, y ∈ N) ∧
      ∀ g ∈ A, g * l * g⁻¹ ∈ gens (A.foldl (nclConj l) L)
  | [], L, _, hg, hN => ⟨List.prefix_refl L, hg, hN, by simp⟩
  | g :: A, L, hA, hg, hN => by
    rw [List.foldl_cons]
    have hN' : ∀ y ∈ nclConj l L g, y ∈ N := fun y hy => by
      rcases mem_keepStep hy with hy | rfl
      · exact hN y hy
      · exact hA g (by simp) l hl
    obtain ⟨p, gd, mN, hc⟩ := foldl_nclConj l hl A (nclConj l L g)
      (fun g' hg' => hA g' (by simp [hg'])) (nclGood_keepStep hg _) hN'
    refine ⟨(keepStep_prefix L _).trans p, gd, mN, fun g' hg' => ?_⟩
    rcases List.mem_cons.mp hg' with rfl | hg'
    · exact gens_mono_prefix p (mem_gens_keepStep L _)
    · exact hc g' hg'

theorem nclGood_foldl (l : Perm (Fin n)) (A : List (Perm (Fin n))) {L : List (Perm (Fin n))}
    (hg : NclGood L) : NclGood (A.foldl (nclConj l) L) :=
  (foldl_nclConj (N := ⊤) l trivial A L (by simp) hg (by simp)).2.1

theorem nclProc_facts {N : Subgroup (Perm (Fin n))} (A L : List (Perm (Fin n))) (i : ℕ)
    (hA : ∀ g ∈ A, ∀ x ∈ N, g * x * g⁻¹ ∈ N) (hg : NclGood L) (hN : ∀ y ∈ L, y ∈ N) :
    L <+: nclProc A L i ∧ NclGood (nclProc A L i) ∧ (∀ y ∈ nclProc A L i, y ∈ N) ∧
      ∀ hi : i < (1 :: L).length, ∀ g ∈ A, g * (1 :: L)[i] * g⁻¹ ∈ gens (nclProc A L i) := by
  unfold nclProc
  split_ifs with hi
  · have hl : (1 :: L)[i] ∈ N := by
      rcases List.mem_cons.mp (List.getElem_mem hi) with h1 | h1
      · rw [h1]; exact N.one_mem
      · exact hN _ h1
    obtain ⟨p, gd, mN, hc⟩ := foldl_nclConj _ hl A L hA hg hN
    exact ⟨p, gd, mN, fun _ => hc⟩
  · exact ⟨List.prefix_refl L, hg, hN, fun h => absurd h hi⟩

theorem nclGood_nclProc (A : List (Perm (Fin n))) {L : List (Perm (Fin n))} (hg : NclGood L)
    (i : ℕ) : NclGood (nclProc A L i) :=
  (nclProc_facts (N := ⊤) A L i (by simp) hg (by simp)).2.1

theorem nclGood_nclLoop (A : List (Perm (Fin n))) {L : List (Perm (Fin n))} (hg : NclGood L) :
    ∀ k, NclGood (nclLoop A L k)
  | 0 => hg
  | k + 1 => by rw [nclLoop_succ]; exact nclGood_nclProc A (nclGood_nclLoop A hg k) k

/-- The rounds below `k` are done: their entries have all conjugates in `⟨L⟩`. -/
def NclDone (A L : List (Perm (Fin n))) (k : ℕ) : Prop :=
  ∀ i < k, ∀ hi : i < (1 :: L).length, ∀ g ∈ A, g * (1 :: L)[i] * g⁻¹ ∈ gens L

theorem prefix_getElem {L L' : List (Perm (Fin n))} (p : L <+: L') {i : ℕ}
    (hi : i < (1 :: L).length) :
    ∃ hi' : i < (1 :: L').length, (1 :: L')[i] = (1 :: L)[i] := by
  have p' : (1 :: L) <+: (1 :: L') := (List.prefix_cons_inj 1).mpr p
  exact ⟨lt_of_lt_of_le hi p'.length_le, (p'.getElem hi).symm⟩

/-- **The loop.** After `k` rounds from `L₀`: the filter bound, entries in `N`, `L₀` a prefix,
and the first `k` rounds done. -/
theorem nclLoop_facts {N : Subgroup (Perm (Fin n))} (A L₀ : List (Perm (Fin n)))
    (hA : ∀ g ∈ A, ∀ x ∈ N, g * x * g⁻¹ ∈ N) (hg : NclGood L₀) (hN : ∀ y ∈ L₀, y ∈ N) :
    ∀ k, NclGood (nclLoop A L₀ k) ∧ (∀ y ∈ nclLoop A L₀ k, y ∈ N) ∧
      L₀ <+: nclLoop A L₀ k ∧ NclDone A (nclLoop A L₀ k) k
  | 0 => ⟨hg, hN, List.prefix_refl _, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  | k + 1 => by
    obtain ⟨gd, mN, p0, dn⟩ := nclLoop_facts A L₀ hA hg hN k
    set L := nclLoop A L₀ k
    obtain ⟨p, gd', mN', hc⟩ := nclProc_facts A L k hA gd mN
    rw [nclLoop_succ]
    refine ⟨gd', mN', p0.trans p, fun i hi hi' g hgA => ?_⟩
    by_cases hiL : i < (1 :: L).length
    · obtain ⟨_, e⟩ := prefix_getElem p hiL
      rw [e]
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
      · exact gens_mono_prefix p (dn i hi hiL g hgA)
      · exact hc hiL g hgA
    · -- round `k` found no entry, so `L` did not change
      have hk : ¬ k < (1 :: L).length := fun h => hiL (by omega)
      have e : nclProc A L k = L := by unfold nclProc; rw [dif_neg hk]
      rw [e] at hi'
      exact absurd hi' hiL

/-! ### Correctness -/

/-- The target: the closure of the conjugates `g h g⁻¹`, `g ∈ ⟨gs, hs⟩`, `h ∈ hs`. -/
def nclTarget (gs hs : List (Perm (Fin n))) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure {x | ∃ g ∈ gens (gs ++ hs), ∃ h ∈ hs, x = g * h * g⁻¹}

/-- The generators `A` used by the program: `1 :: gs` followed by `1 :: hs`. -/
def nclGens (gs hs : List (Perm (Fin n))) : List (Perm (Fin n)) := (1 :: gs) ++ (1 :: hs)

theorem nclGens_mem {gs hs : List (Perm (Fin n))} {g : Perm (Fin n)} (hg : g ∈ nclGens gs hs) :
    g ∈ gens (gs ++ hs) := by
  simp only [nclGens, List.mem_append, List.mem_cons] at hg
  rcases hg with (rfl | hg) | (rfl | hg)
  · exact Subgroup.one_mem _
  · exact Subgroup.subset_closure (by simp [hg])
  · exact Subgroup.one_mem _
  · exact Subgroup.subset_closure (by simp [hg])

theorem gens_le_closure_nclGens (gs hs : List (Perm (Fin n))) :
    gens (gs ++ hs) ≤ Subgroup.closure {g | g ∈ nclGens gs hs} :=
  Subgroup.closure_mono fun g hg => by
    simp only [Set.mem_setOf_eq, List.mem_append, nclGens, List.mem_cons] at hg ⊢
    tauto

/-- The target is normalized by `⟨gs, hs⟩`. -/
theorem nclTarget_normal (gs hs : List (Perm (Fin n))) :
    ∀ g ∈ gens (gs ++ hs), ∀ x ∈ nclTarget gs hs, g * x * g⁻¹ ∈ nclTarget gs hs := by
  intro g hg
  refine ncl_conj_closure fun y hy => ?_
  obtain ⟨g', hg', h, hh, rfl⟩ := hy
  refine Subgroup.subset_closure ⟨g * g', Subgroup.mul_mem _ hg hg', h, hh, by group⟩

/-- The result of the program, as a list. -/
noncomputable def nclResult (gs hs : List (Perm (Fin n))) : List (Perm (Fin n)) :=
  nclLoop (nclGens gs hs) (keepList hs) (n * n + 1)

/-- **The loop computes the normal closure**, with at most `n²` generators. -/
theorem ncl_correct (gs hs : List (Perm (Fin n))) :
    (nclResult gs hs).length ≤ n ^ 2 ∧ gens (nclResult gs hs) = nclTarget gs hs := by
  set N := nclTarget gs hs
  have hA : ∀ g ∈ nclGens gs hs, ∀ x ∈ N, g * x * g⁻¹ ∈ N := fun g hg =>
    nclTarget_normal gs hs g (nclGens_mem hg)
  have hhs : ∀ h ∈ hs, h ∈ N := fun h hh =>
    Subgroup.subset_closure ⟨1, Subgroup.one_mem _, h, hh, by group⟩
  have hN0 : ∀ y ∈ keepList hs, y ∈ N := fun y hy => by
    have : y ∈ gens hs := gens_keepList hs ▸ Subgroup.subset_closure hy
    exact (Subgroup.closure_le N).mpr (fun h hh => hhs h hh) this
  obtain ⟨gd, mN, p0, dn⟩ := nclLoop_facts (nclGens gs hs) (keepList hs) hA
    (nclGood_keepList hs) hN0 (n * n + 1)
  unfold nclResult
  set L := nclLoop (nclGens gs hs) (keepList hs) (n * n + 1)
  have hlen : L.length ≤ n ^ 2 := gd.length_le
  refine ⟨hlen, le_antisymm ((Subgroup.closure_le N).mpr fun y hy => mN y hy) ?_⟩
  -- every entry of `L` was processed
  have hconj : ∀ g ∈ nclGens gs hs, ∀ y ∈ L, g * y * g⁻¹ ∈ gens L := by
    intro g hg y hy
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hy
    have h1 : i + 1 < (1 :: L).length := by simpa using hi
    have := dn (i + 1) (by rw [sq] at hlen; omega) h1 g hg
    simpa using this
  have hnorm := ncl_normalizes (A := {g | g ∈ nclGens gs hs}) fun g hg =>
    ncl_conj_closure (H := gens L) fun y hy => hconj g hg y hy
  refine (Subgroup.closure_le _).mpr ?_
  rintro x ⟨g, hg, h, hh, rfl⟩
  have hhL : h ∈ gens L := gens_mono_prefix p0 (gens_keepList hs ▸ Subgroup.subset_closure hh)
  exact hnorm g (gens_le_closure_nclGens gs hs hg) h hhL

end GI.Impl
