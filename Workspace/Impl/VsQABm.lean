module

public import Workspace.Impl.VsHPsP
public import Workspace.Proved.VsQA2

@[expose] public section

/-!
# The algebra basis of the A-loop

The A-loop computes `Lb = vsHBm s (1 :: as)`, the basis of the algebra generated by the local
matrices of `1` and `as`. It spans the algebra of `as` (`vsQABm_span`), so `VsQAHyp` holds for it
(`VsQAHyp.of_bm`).
-/

open Matrix

namespace GI.Impl

open GI.Lang GI.Cited GI.Proved Equiv

variable {I : VecStabInst} {s : VsQSt I}

theorem vsQABm_adjoin (hs : VsQStOK s) (as : List (Perm (Fin I.n))) :
    Algebra.adjoin (ZMod I.p) {X | ∃ a ∈ 1 :: as, vsQLam s a = X} =
      Algebra.adjoin (ZMod I.p) {X | ∃ a ∈ as, vsQLam s a = X} := by
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨a, ha, rfl⟩
    rcases List.mem_cons.mp ha with rfl | ha
    · rw [vsQLam_one hs]; exact Subalgebra.one_mem _
    · exact Algebra.subset_adjoin ⟨a, ha, rfl⟩
  · exact Algebra.adjoin_mono fun X ⟨a, ha, he⟩ => ⟨a, List.mem_cons_of_mem _ ha, he⟩

/-- **The span of the basis** is the algebra of `as`, in the stored (transposed) form. -/
theorem vsQABm_span (hs : VsQStOK s) (as : List (Perm (Fin I.n))) :
    vsFMatSpan I.p (vsQD s) (vsHBm s (1 :: as)) = Subalgebra.toSubmodule
      (vsFAlgOf I.p (vsQD s) (as.map (vsPLocL I s.ws' (vsQCs s)))) := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  have hset : {X | ∃ M ∈ as.map (vsPLocL I s.ws' (vsQCs s)), vsFMatrix I.p (vsQD s) M = X} =
      Matrix.transpose '' {X | ∃ a ∈ as, vsQLam s a = X} := by
    ext X
    simp only [List.mem_map, Set.mem_setOf_eq, Set.mem_image]
    constructor
    · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨vsQLam s a, ⟨a, ha, rfl⟩, (vsFMatrix_loc a).symm⟩
    · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨_, ⟨a, ha, rfl⟩, vsFMatrix_loc a⟩
  have e : Submodule.span (ZMod I.p) {X | ∃ M ∈ vsHBm s (1 :: as), vsWM I.p (vsQD s) M = X} =
      (vsFMatSpan I.p (vsQD s) (vsHBm s (1 :: as))).map
        (Matrix.transposeLinearEquiv (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p) (ZMod I.p)).toLinearMap := by
    rw [vsFMatSpan, Submodule.map_span]
    congr 1
    ext X
    simp only [Set.mem_setOf_eq, Set.mem_image, LinearEquiv.coe_coe, Matrix.transposeLinearEquiv_apply]
    constructor
    · rintro ⟨M, hM, rfl⟩; exact ⟨_, ⟨M, hM, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨M, hM, rfl⟩, rfl⟩; exact ⟨M, hM, rfl⟩
  ext X
  have key := vsP_adjoin_transpose (X := Xᵀ) (S := {X | ∃ a ∈ as, vsQLam s a = X})
  rw [transpose_transpose] at key
  rw [Subalgebra.mem_toSubmodule, vsFAlgOf, hset, key, ← vsQABm_adjoin hs,
    ← vsHBm_span, e, Submodule.mem_map]
  constructor
  · intro hX; exact ⟨X, hX, by simp⟩
  · rintro ⟨Y, hY, he⟩
    have : Y = X := by simpa using he
    rwa [← this]

/-- `VsQAHyp` for the computed basis. -/
theorem VsQAHyp.of_bm (hs : VsQStOK s) {as : List (Perm (Fin I.n))} (has : gens as ≤ gens s.hs)
    (hasn : VsPNormd (gens s.hs) (gens as)) (hal : as.length ≤ I.n ^ 2)
    (habl : vsPBar hs (gens as) ≤ Subgroup.centralizer (vsPBar hs (gens as) : Set _)) :
    VsQAHyp hs as (vsHBm s (1 :: as)) := by
  haveI : Fact I.p.Prime := ⟨I.prime⟩
  exact ⟨has, hasn, hal, habl, fun M hM => vsFSq_of_wSq (vsHBm_sq _ M hM), vsQABm_span hs as,
    vsHBm_length _⟩

end GI.Impl

namespace GI.Impl

open GI.Lang GI.Cited GI.Proved Equiv

variable {I : VecStabInst} {s : VsQSt I}

/-- The algebra basis of `1 :: as`, on `[lc, encGroup as]`. -/
def vsQABmE (mp idp alg : ℕ) : Expr :=
  .letE (.call mp (mk2 (mk2 (.get (.get (arg 0) (.nat 0)) (.nat 0)) (.get (arg 0) (.nat 1)))
    (.get (arg 1) (.nat 1))))
  (.letE (.call idp (.get (arg 0) (.nat 2)))
  (.get (.call alg (mk4 (.get (.get (.get (arg 0) (.nat 1)) (.nat 0)) (.nat 0)) (.var 1)
    (.get (.get (.get (arg 0) (.nat 1)) (.nat 0)) (.nat 3)) (.var 2))) (.nat 1)))

/-- The layout of the basis program. -/
structure VsQABmAt (P : Program) (f mp it loc phi idp alg : ℕ) : Prop where
  hf : P.funs[f]? = some (vsQABmE mp idp alg)
  hmp : P.HasAt mp (mapFuns mp it)
  hit : P.funs[it]? = some (vsHLocItE loc)
  hloc : P.funs[loc]? = some (vsPLocE phi (loc + 1))
  hwl : P.HasAt (loc + 1) (vsWLocFuns (loc + 1))
  hidp : P.HasAt idp (vsWIdFuns idp)
  halg : P.HasAt alg (vsFAlgSpanFuns alg)

/-- The cost of the basis program. -/
def vsQABmCost (Cφ N : ℕ) : ℕ := (N + 1) * (vsPLocCost Cφ N + 10 ^ 4 * (N + 1) ^ 3) + 10 ^ 12 * (N + 1) ^ 7

set_option maxHeartbeats 8000000 in
/-- **The basis program.** On `[lc, encGroup as]` it returns the algebra basis of `1 :: as`. -/
theorem vsQABm_spec [Fact I.p.Prime] {P : Program} {f mp it loc phi idp alg : ℕ}
    (L : VsQABmAt P f mp it loc phi idp alg) {Cφ N : ℕ}
    (hphi : ∀ g ∈ gens I.gs, FunDet P phi (.list [vsQGam I, encPerm g])
      (vsQE I.p I.d (vsQExp I) (vsQPhi I g)) Cφ)
    (hs : VsQStOK s) {as : List (Perm (Fin I.n))}
    (hsz : VsQSz I.p I.d (vsQExp I) N) (hΓ : (vsQGam I).wt ≤ N) (hn : I.n ≤ N)
    (hfr : VsWFrOK I.p N I.d s.ws' (vsQCs s)) (has : gens as ≤ gens s.hs)
    (hN : 1 + vsQD s * vsQD s * (1 :: as).length ≤ N)
    (hLl : (1 :: as).length ≤ N) (hW : (vsQLCV s).wt ≤ N) :
    FunDet P f (.list [vsQLCV s, encGroup as]) (vsFMatsVal (vsHBm s (1 :: as))) (vsQABmCost Cφ N) := by
  haveI : NeZero I.p := ⟨I.prime.ne_zero⟩
  have hpN := hsz.pN
  set D := vsQD s
  set LL := 1 :: as
  set lc := vsQLCV s
  set fr := vsWFrVal I.p I.d s.ws' (vsQCs s)
  set F0 := Val.list [.nat I.p, .nat I.d, natList (vsWZ I.d), natList (vsWZ (vsQCs s).length)]
  set vs := [lc, encGroup as]
  have elc : lc = .list [vsQStV I s, fr, .nat D, vsFMatsVal (vsQMs s)] := rfl
  have rl : ∀ rest : List Val, Det P (Val.list vs :: rest) (arg 0) lc (2 * (Val.list vs).wt + 0 + 5) := fun rest =>
    Det.arg' (P := P) (vs := vs) (rest := rest) (j := 0) rfl
  have hlc : lc.wt < (Val.list vs).wt := wt_le_wt_list (by simp [vs])
  have hst : (vsQStV I s).wt < lc.wt := wt_le_wt_list (by simp [elc])
  have hfr' : fr.wt < lc.wt := wt_le_wt_list (by simp [elc, fr])
  have hF0 : F0.wt < fr.wt := wt_le_wt_list (by simp [fr, F0, vsWFrVal])
  have hpF : (Val.nat I.p).wt < F0.wt := wt_le_wt_list (by simp [F0])
  have hzF : (natList (vsWZ (vsQCs s).length)).wt < F0.wt := wt_le_wt_list (by simp [F0])
  have hDl : (Val.nat D).wt < lc.wt := wt_le_wt_list (by simp [elc, D])
  have hGs : (vsQGam I).wt < (vsQStV I s).wt := wt_le_wt_list (by simp [vsQStV])
  have w0 := wt_nat_le 0; have w1 := wt_nat_le 1; have w2 := wt_nat_le 2; have w3 := wt_nat_le 3
  have eSt : (Val.list [vsQGam I, encGroup s.hs, vsWVs s.ws', vsWVs s.ws, natList s.x, natList s.y]).wt =
    (vsQStV I s).wt := rfl
  have eF0 : (Val.list [.nat I.p, .nat I.d, natList (vsWZ I.d), natList (vsWZ (vsQCs s).length)]).wt =
    F0.wt := rfl
  have rF : ∀ rest : List Val, ∃ c, Det P (Val.list vs :: rest) (.get (arg 0) (.nat 1)) fr c ∧
      c ≤ 3 * (Val.list vs).wt + 20 := fun rest =>
    ⟨_, Det.get' (rl rest) (Det.nat 1) rfl, by omega⟩
  have rG : ∀ rest : List Val, ∃ c, Det P (Val.list vs :: rest) (.get (.get (arg 0) (.nat 0)) (.nat 0))
      (vsQGam I) c ∧ c ≤ 6 * (Val.list vs).wt + 40 := fun rest =>
    ⟨_, Det.get' (Det.get' (rl rest) (Det.nat 0) rfl) (Det.nat 0) rfl, by omega⟩
  have rp : ∀ rest : List Val, ∃ c, Det P (Val.list vs :: rest)
      (.get (.get (.get (arg 0) (.nat 1)) (.nat 0)) (.nat 0)) (.nat I.p) c ∧
      c ≤ 20 * (Val.list vs).wt + 100 := by
    intro rest
    obtain ⟨c, d, hc⟩ := rF rest
    exact ⟨_, Det.get' (Det.get' d (Det.nat 0) rfl) (Det.nat 0) rfl, by omega⟩
  have rz : ∀ rest : List Val, ∃ c, Det P (Val.list vs :: rest)
      (.get (.get (.get (arg 0) (.nat 1)) (.nat 0)) (.nat 3)) (natList (vsWZ D)) c ∧
      c ≤ 20 * (Val.list vs).wt + 100 := by
    intro rest
    obtain ⟨c, d, hc⟩ := rF rest
    exact ⟨_, Det.get' (Det.get' d (Det.nat 0) rfl) (Det.nat 3) rfl, by
      have e : (natList (vsWZ D)).wt = (natList (vsWZ (vsQCs s).length)).wt := rfl
      omega⟩
  have rD : ∀ rest : List Val, ∃ c, Det P (Val.list vs :: rest) (.get (arg 0) (.nat 2)) (.nat D) c ∧
      c ≤ 3 * (Val.list vs).wt + 20 := fun rest =>
    ⟨_, Det.get' (rl rest) (Det.nat 2) rfl, by omega⟩
  -- 1. the stored local matrices
  have dL : Det P [Val.list vs] (.get (arg 1) (.nat 1)) (.list (LL.map encPerm)) _ :=
    Det.get' (Det.arg' (P := P) (vs := vs) (rest := []) (j := 1) rfl) (Det.nat 1) rfl
  have hLs : ∀ g ∈ LL, g ∈ gens s.hs := fun g hg => by
    rcases List.mem_cons.1 hg with rfl | hg
    · exact one_mem _
    · exact has (Subgroup.subset_closure hg)
  have hitm : ∀ g ∈ LL, FunDet P it (.list [.list [vsQGam I, fr], encPerm g])
      (vsWVs (vsPLocL I s.ws' (vsQCs s) g)) (vsPLocCost Cφ N + 10 ^ 4 * (N + 1) ^ 3) := by
    intro g hg
    have c0 := Det.arg' (P := P) (vs := [.list [vsQGam I, fr], encPerm g]) (rest := []) (j := 0) rfl
    have c1 := Det.arg' (P := P) (vs := [.list [vsQGam I, fr], encPerm g]) (rest := []) (j := 1) rfl
    have cΓ := Det.get' c0 (Det.nat 0) (show [vsQGam I, fr][0]? = some (vsQGam I) from rfl)
    have cF := Det.get' c0 (Det.nat 1) (show [vsQGam I, fr][1]? = some fr from rfl)
    refine FunDet.intro L.hit ((Det.call (Det.mk3 cΓ cF c1) (vsPLoc_spec L.hloc L.hwl hphi hsz hΓ hn hfr
      (hs.prob.le (hLs g hg)))).mono ?_)
    have wF : fr.wt ≤ 500 * (N + 1) ^ 3 := wt_vsWFrVal_le hfr
    have wg := wt_encPerm_le g
    have hn2 : (I.n + 1) ^ 2 ≤ (N + 1) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have q23 : (N + 1) ^ 2 ≤ (N + 1) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
    have l1 := wt_list2_le (vsQGam I) fr
    have l2 := wt_list2_le (Val.list [vsQGam I, fr]) (encPerm g)
    have l3 := wt_list3_le (vsQGam I) fr (encPerm g)
    have hsq := vsPLocL_sq (I := I) (ws' := s.ws') (cs := vsQCs s) g
    have hDN' : (vsQCs s).length ≤ N := by have := hfr.hl; omega
    have wL := wt_vsWVs_le (N := N) (VsWFit.bnd hsq.1 hpN hDN') (by rw [hsq.2]; omega)
    have q13 : N + 1 ≤ (N + 1) ^ 3 := Nat.le_self_pow (by omega) _
    omega
  obtain ⟨cG, dG, hcG⟩ := rG []
  obtain ⟨cF, dF, hcF⟩ := rF []
  have d1 := Det.call (Det.mk2 (Det.mk2 dG dF) dL)
    (vsQ_map L.hmp LL encPerm (fun g => vsWVs (vsPLocL I s.ws' (vsQCs s) g)) encPerm_injective hitm)
  have eG : Val.list (LL.map fun g => vsWVs (vsPLocL I s.ws' (vsQCs s) g)) = vsFMatsVal (vsHGms s LL) := by
    simp [vsFMatsVal, vsHGms, vsWVs, List.map_map, Function.comp_def]
  rw [eG] at d1
  set G := vsHGms s LL
  have hGl : G.length = LL.length := by simp [G, vsHGms]
  -- 2. the identity
  have hDD : D * D ≤ N := by
    have : D * D ≤ D * D * LL.length := Nat.le_mul_of_pos_right _ (by simp [LL])
    omega
  have hDN : D ≤ N := (Nat.le_mul_self D).trans hDD
  obtain ⟨cD2, dD2, hcD2⟩ := rD [vsFMatsVal G]
  have d2 := Det.call dD2 (vsWId_spec L.hidp hDN)
  -- 3. the algebra
  set E3 := [Val.list vs, vsFMatsVal G, vsWVs (vsWId D)]
  obtain ⟨cp3, dp3, hcp3⟩ := rp [vsFMatsVal G, vsWVs (vsWId D)]
  obtain ⟨cz3, dz3, hcz3⟩ := rz [vsFMatsVal G, vsWVs (vsWId D)]
  have halg := vsFAlgSpan_spec L.halg I.prime.pos hpN hDD (gs := G) (z := vsWZ D)
      (fun g hg => vsFSq_of_wSq (vsHGms_sq LL g hg)) (by rw [hGl]; exact hN)
      (by rw [hGl]; exact hLl)
      (fun y hy => by have := I.prime.pos; simp [vsWZ] at hy; omega) (by simp [vsWZ])
      (vsWId_sq I.prime.one_lt D)
  have dalg := Det.call (Det.mk4 dp3 (Det.var' (P := P) (env := E3) (i := 1) rfl) dz3
    (Det.var' (P := P) (env := E3) (i := 2) rfl)) halg
  set st := vsFAlgSpanL I.p (vsWZ D) (vsWId D) G (D * D)
  have dBm := Det.get' dalg (Det.nat 1)
    (show [vsAccVal st.1, vsFMatsVal st.2][1]? = some (vsFMatsVal st.2) from rfl)
  have eBm : st.2 = vsHBm s LL := rfl
  rw [eBm] at dBm
  refine FunDet.intro L.hf ((Det.letE d1 (Det.letE d2 dBm)).mono ?_)
  -- weights
  have q12 : N + 1 ≤ (N + 1) ^ 2 := Nat.le_self_pow (by omega) _
  have q23 : (N + 1) ^ 2 ≤ (N + 1) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  have q34 : (N + 1) ^ 3 ≤ (N + 1) ^ 4 := Nat.pow_le_pow_right (by omega) (by omega)
  have q47 : (N + 1) ^ 4 ≤ (N + 1) ^ 7 := Nat.pow_le_pow_right (by omega) (by omega)
  have wLL := vsP_wt_perms hn LL (by omega)
  have wga : (encGroup as).wt ≤ 100 * (N + 1) ^ 3 := by
    have e : encGroup as = .list [.nat I.n, .list (LL.map encPerm)] := rfl
    have := wt_list2_le (Val.nat I.n) (Val.list (LL.map encPerm))
    have := wt_nat_le I.n
    have : N + 1 ≤ (N + 1) ^ 3 := Nat.le_self_pow (by omega) _
    rw [e]; omega
  have wvs := wt_list2_le lc (encGroup as)
  have wF : fr.wt ≤ 500 * (N + 1) ^ 3 := wt_vsWFrVal_le hfr
  have wG : (vsFMatsVal G).wt ≤ 40 * (N + 1) ^ 4 :=
    wt_vsFMatsVal_le hpN hDN (fun g hg => vsFSq_of_wSq (vsHGms_sq LL g hg)) (by rw [hGl]; omega)
  have wId : (vsWVs (vsWId D)).wt ≤ 11 * (N + 1) ^ 3 + 4 :=
    wt_vsWVs_le (fun u hu => ⟨fun y hy => ((vsWId_fit I.prime.one_lt D u hu).1 y hy).le.trans hpN,
      by rw [(vsWId_fit I.prime.one_lt D u hu).2]; exact hDN⟩) (by simp [vsWId]; omega)
  have wSt : (vsFAVal st).wt < 10 ^ 9 * (N + 1) ^ 7 := FunDet.wt_lt' halg
  have eSt : (Val.list [vsAccVal st.1, vsFMatsVal (vsHBm s LL)]).wt = (vsFAVal st).wt := rfl
  have l4 := wt_list2_le (vsQGam I) fr
  have l5 := wt_list2_le (Val.list [vsQGam I, fr]) (Val.list (LL.map encPerm))
  have hM1 : LL.length * (vsPLocCost Cφ N + 10 ^ 4 * (N + 1) ^ 3) ≤
      (N + 1) * (vsPLocCost Cφ N + 10 ^ 4 * (N + 1) ^ 3) := Nat.mul_le_mul_right _ (by omega)
  have hM2 : mapK * (LL.length + 1) * ((Val.list [Val.list [vsQGam I, fr],
      Val.list (List.map encPerm LL)]).wt + (vsFMatsVal G).wt + 1) ≤
      1000 * (N + 1) * (2000 * (N + 1) ^ 4) :=
    Nat.mul_le_mul (Nat.mul_le_mul (le_refl _) (by omega)) (by omega)
  have eM2 : 1000 * (N + 1) * (2000 * (N + 1) ^ 4) = 2 * 10 ^ 6 * (N + 1) ^ 5 := by ring
  have q57 : (N + 1) ^ 5 ≤ (N + 1) ^ 7 := Nat.pow_le_pow_right (by omega) (by omega)
  have mk : mapK = 1000 := rfl
  have wBm : (vsFMatsVal (vsHBm s LL)).wt < (vsFAVal st).wt := by
    rw [← eSt]; exact wt_le_wt_list (by simp)
  have hzD : (natList (vsWZ D)).wt ≤ 5 * (N + 1) ^ 2 :=
    wt_natList_le_sq (fun y hy => by simp [vsWZ] at hy; omega) (by simp [vsWZ]; omega)
  have wp := wt_nat_le I.p
  have l1 := wt_list_le [Val.nat I.p, vsFMatsVal G, natList (vsWZ D), vsWVs (vsWId D)]
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, List.length_cons,
    List.length_nil] at l1
  unfold vsQABmCost
  linarith

end GI.Impl
