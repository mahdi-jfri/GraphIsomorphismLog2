import Workspace.Impl.SCosPaste1

/-!
# Pasting the answers of the children, the mathematics

The children answer the problems `[kv, x t, ind]` for coset representatives `t` of `K` in `𝒢`.
The paste function keeps the nonempty answers `[zⱼ, lvⱼ]` (`scosPasteGood`). We collect the
points `zⱼ` in a list `zs` (`scosPaste_collect`). Each `zⱼ` lies in the subcoset `C(x 𝒢, Φ)`,
and every point `y` of that subcoset lies in some `zⱼ L(K, Φ)` (`scosPaste_facts`, from
`scosC_union` and `scosC_eq`). When `zs` is empty the subcoset is empty. Otherwise
`L(𝒢, Φ)` is generated by `L(K, Φ)` and the `z₁⁻¹ zⱼ` (`scosL_paste`), and the same holds for
the images under `nintSum` (`scosPaste_gens`).
-/

namespace GI.Impl

open GI.Cited GI.Lang GI.Proved Equiv
open scoped Pointwise

variable {n : ℕ}

/-- The test of the filter: whether a value is a nonempty list. -/
def scosPasteGood : Val → Bool
  | .list l => decide (0 < l.length)
  | _ => false

/-- A nonempty answer `[z, lv]` of a child, with `lv` a group value of `L(K, Φ)`. -/
def ScosPasteGood (n : ℕ) (K : Subgroup (ScosPair n)) (Φ : Finset (Fin n)) (z : ScosPair n)
    (a : Val) : Prop :=
  ∃ lv, a = .list [encPerm (nintSum z), lv] ∧
    GroupVal (n + n) lv ((scosL K Φ).map nintSum) ∧ lv.wt ≤ scosW n

/-- **Collecting the nonempty answers.** -/
theorem scosPaste_collect {K : Subgroup (ScosPair n)} {x : ScosPair n} {Φ : Finset (Fin n)}
    {ts : List (ScosPair n)} {as : List Val}
    (has : List.Forall₂ (fun t a => ScosAns n a (x * t) K Φ) ts as) :
    ∃ zs : List (ScosPair n), List.Forall₂ (ScosPasteGood n K Φ) zs (as.filter scosPasteGood) ∧
      (∀ z ∈ zs, ∃ t ∈ ts, z ∈ scosC (x * t) K Φ) ∧
      (∀ t ∈ ts, scosC (x * t) K Φ = ∅ ∨ ∃ z ∈ zs, z ∈ scosC (x * t) K Φ) := by
  induction has with
  | nil => exact ⟨[], by simp, by simp, by simp⟩
  | @cons t a ts as h1 _ ih =>
    obtain ⟨zs, hzs, hin, hcov⟩ := ih
    rcases h1 with ⟨rfl, he⟩ | ⟨z, hz, lv, rfl, hlv, hw⟩
    · refine ⟨zs, ?_, fun z hz => ?_, fun t' ht' => ?_⟩
      · simpa [scosPasteGood] using hzs
      · obtain ⟨t', ht', h⟩ := hin z hz
        exact ⟨t', List.mem_cons_of_mem _ ht', h⟩
      · rcases List.mem_cons.mp ht' with rfl | ht'
        · exact Or.inl he
        · exact hcov t' ht'
    · refine ⟨z :: zs, ?_, fun z' hz' => ?_, fun t' ht' => ?_⟩
      · simpa [scosPasteGood] using List.Forall₂.cons ⟨lv, rfl, hlv, hw⟩ hzs
      · rcases List.mem_cons.mp hz' with rfl | hz'
        · exact ⟨t, List.mem_cons_self .., hz⟩
        · obtain ⟨t', ht', h⟩ := hin z' hz'
          exact ⟨t', List.mem_cons_of_mem _ ht', h⟩
      · rcases List.mem_cons.mp ht' with rfl | ht'
        · exact Or.inr ⟨z, List.mem_cons_self .., hz⟩
        · rcases hcov t' ht' with h | ⟨z', hz', h⟩
          · exact Or.inl h
          · exact Or.inr ⟨z', List.mem_cons_of_mem _ hz', h⟩

/-- **The collected points.** They lie in the subcoset, every point of the subcoset lies in
some `z L(K, Φ)`, and the subcoset is empty when there are none. -/
theorem scosPaste_facts {𝒢 K : Subgroup (ScosPair n)} {x : ScosPair n} {Φ : Finset (Fin n)}
    {ts zs : List (ScosPair n)} (hinv : ScosInv 𝒢 Φ) (hK : K ≤ 𝒢) (hts : ∀ t ∈ ts, t ∈ 𝒢)
    (hcov : ∀ g ∈ 𝒢, ∃ t ∈ ts, t⁻¹ * g ∈ K)
    (hin : ∀ z ∈ zs, ∃ t ∈ ts, z ∈ scosC (x * t) K Φ)
    (hcz : ∀ t ∈ ts, scosC (x * t) K Φ = ∅ ∨ ∃ z ∈ zs, z ∈ scosC (x * t) K Φ) :
    (∀ z ∈ zs, z ∈ scosC x 𝒢 Φ) ∧
    (∀ y ∈ scosC x 𝒢 Φ, ∃ z ∈ zs, z⁻¹ * y ∈ scosL K Φ) ∧
    (zs = [] → scosC x 𝒢 Φ = ∅) := by
  have hcov' : ∀ y ∈ scosC x 𝒢 Φ, ∃ z ∈ zs, z⁻¹ * y ∈ scosL K Φ := by
    intro y hy
    obtain ⟨t, ht, hyt⟩ := (scosC_union ts hts hK hcov).mp hy
    rcases hcz t ht with he | ⟨z, hz, hzt⟩
    · rw [he] at hyt; exact absurd hyt (Set.notMem_empty _)
    · refine ⟨z, hz, ?_⟩
      rw [scosC_eq (scosInv_mono hinv hK) hzt] at hyt
      obtain ⟨l, hl, rfl⟩ := hyt
      simpa [smul_eq_mul] using hl
  refine ⟨fun z hz => ?_, hcov', fun h0 => ?_⟩
  · obtain ⟨t, ht, hzt⟩ := hin z hz
    exact (scosC_union ts hts hK hcov).mpr ⟨t, ht, hzt⟩
  · subst h0
    ext y
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hy
    obtain ⟨z, hz, -⟩ := hcov' y hy
    simp at hz

/-- **The generators of the pasted group.** -/
theorem scosPaste_gens {𝒢 K : Subgroup (ScosPair n)} {x z₁ : ScosPair n} {Φ : Finset (Fin n)}
    {zs : List (ScosPair n)} {gs : List (Perm (Fin (n + n)))} (hinv : ScosInv 𝒢 Φ)
    (hK : K ≤ 𝒢) (hz₁ : z₁ ∈ zs) (hzs : ∀ z ∈ zs, z ∈ scosC x 𝒢 Φ)
    (hcov : ∀ y ∈ scosC x 𝒢 Φ, ∃ z ∈ zs, z⁻¹ * y ∈ scosL K Φ)
    (hgs : gens gs = (scosL K Φ).map nintSum) :
    gens ((1 :: gs) ++ zs.map (fun z => (nintSum z₁)⁻¹ * nintSum z)) =
      (scosL 𝒢 Φ).map nintSum := by
  have hL' : scosL K Φ ≤ scosL 𝒢 Φ := inf_le_inf_right _ hK
  rw [scosL_paste hinv zs hz₁ hzs hL' hcov, Subgroup.map_sup, MonoidHom.map_closure, ← hgs,
    List.cons_append, gens_one_cons]
  unfold gens
  rw [← Subgroup.closure_union]
  congr 1
  ext g
  simp only [List.mem_append, List.mem_map, Set.mem_union, Set.mem_setOf_eq, Set.mem_image]
  constructor
  · rintro (h | ⟨z, hz, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨z₁⁻¹ * z, ⟨z, hz, rfl⟩, by simp [map_mul, map_inv]⟩
  · rintro (h | ⟨u, ⟨z, hz, rfl⟩, rfl⟩)
    · exact Or.inl h
    · exact Or.inr ⟨z, hz, by simp [map_mul, map_inv]⟩

end GI.Impl
