import Workspace.Impl.VsQABm
import Workspace.Impl.VsHSplitOK
import Workspace.Proved.VsMBlocks

/-!
# The blocks of the pieces

When `L = 𝔽_p[Λ(as)]` has at least two pieces and `H` moves piece `0` onto every piece, `H`
permutes the pieces transitively. Here:

* `vsQAPi`: the action of `H̄` on the pieces, as a homomorphism to `Perm (Fin m)`.
* `vsQATbl_eq`: the table of a generator is this permutation.
* `vsQAPi_range`: the image of `H̄` is generated by the tables of the generators of `H`.
* `vsQAPi_trans`: the action is transitive.
-/

open Matrix Module

namespace GI.Impl

open GI.Lang GI.Cited GI.Proved Equiv

variable {I : VecStabInst} {s : VsQSt I} [Fact I.p.Prime]

/-- Piece `k`, as a subspace. -/
noncomputable def vsQAU (s : VsQSt I) (Lb : List (List (List ℕ))) (k : Fin (vsQAPcs s Lb).length) :
    Submodule (ZMod I.p) (Fin (vsQD s) → ZMod I.p) :=
  vsWSp I.p (vsQD s) (vsQAPcs s Lb)[k]

theorem vsQAU_ne {Lb : List (List (List ℕ))} (k : Fin (vsQAPcs s Lb).length) : vsQAU s Lb k ≠ ⊥ :=
  ((vsFEigL_pieces I.prime _ (vsQAFix_sq (s := s) Lb)).1 _ (List.getElem_mem k.2)).2.1

variable {hs : VsQStOK s} {as : List (Perm (Fin I.n))} {Lb : List (List (List ℕ))}

theorem vsQAU_inj (h : VsQAHyp hs as Lb) : Function.Injective (vsQAU s Lb) := by
  intro k₁ k₂ he
  by_contra hne
  have hd := vsQA_pcs_disj h k₁ k₂ hne
  change Disjoint (vsQAU s Lb k₁) (vsQAU s Lb k₂) at hd
  rw [he, disjoint_self] at hd
  exact vsQAU_ne k₂ hd

/-- An element of `H̄` maps each piece onto a piece. -/
theorem vsQAU_map (h : VsQAHyp hs as Lb) {u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ}
    (hu : u ∈ vsPBar hs (gens s.hs)) (k : Fin (vsQAPcs s Lb).length) :
    ∃ j, (vsQAU s Lb k).map (u : Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) = vsQAU s Lb j := by
  obtain ⟨x, -, hx, rfl⟩ := (vsPBar_mem_iff hs).1 hu
  obtain ⟨Q', hQ', hm⟩ := vsQA_piece_map h hx (List.getElem_mem k.2)
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hQ'
  refine ⟨⟨j, hj⟩, ?_⟩
  rw [vsPRho_of hs hx, vsQRho_eq_toLin' hs hx]
  exact hm

open Classical in
/-- Where `u` sends piece `k`. -/
noncomputable def vsQAIdx (s : VsQSt I) (Lb : List (List (List ℕ)))
    (u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ) (k : Fin (vsQAPcs s Lb).length) :
    Fin (vsQAPcs s Lb).length :=
  if hk : ∃ j, (vsQAU s Lb k).map (u : Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) = vsQAU s Lb j
  then hk.choose else k

theorem vsQAIdx_spec (h : VsQAHyp hs as Lb) {u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ}
    (hu : u ∈ vsPBar hs (gens s.hs)) (k : Fin (vsQAPcs s Lb).length) :
    (vsQAU s Lb k).map (u : Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) =
      vsQAU s Lb (vsQAIdx s Lb u k) := by
  have hk := vsQAU_map h hu k
  rw [vsQAIdx, dif_pos hk]
  exact hk.choose_spec

theorem vsQAIdx_eq (h : VsQAHyp hs as Lb) {u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ}
    (hu : u ∈ vsPBar hs (gens s.hs)) {k j : Fin (vsQAPcs s Lb).length}
    (hj : (vsQAU s Lb k).map (u : Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) = vsQAU s Lb j) :
    vsQAIdx s Lb u k = j :=
  vsQAU_inj h ((vsQAIdx_spec h hu k).symm.trans hj)

theorem vsQAIdx_mul (h : VsQAHyp hs as Lb) {u v : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ}
    (hu : u ∈ vsPBar hs (gens s.hs)) (hv : v ∈ vsPBar hs (gens s.hs)) (k : Fin (vsQAPcs s Lb).length) :
    vsQAIdx s Lb (u * v) k = vsQAIdx s Lb u (vsQAIdx s Lb v k) := by
  refine vsQAIdx_eq h (mul_mem hu hv) ?_
  rw [Units.val_mul, Module.End.mul_eq_comp, Submodule.map_comp, vsQAIdx_spec h hv,
    vsQAIdx_spec h hu]

theorem vsQAIdx_one (h : VsQAHyp hs as Lb) (k : Fin (vsQAPcs s Lb).length) :
    vsQAIdx s Lb 1 k = k := by
  refine vsQAIdx_eq h (one_mem _) ?_
  rw [Units.val_one, Module.End.one_eq_id, Submodule.map_id]

/-- **The action of `H̄` on the pieces.** -/
noncomputable def vsQAPi (h : VsQAHyp hs as Lb) : vsPBar hs (gens s.hs) →* Perm (Fin (vsQAPcs s Lb).length) where
  toFun u :=
    { toFun := vsQAIdx s Lb u
      invFun := vsQAIdx s Lb (u⁻¹ : vsPBar hs (gens s.hs))
      left_inv := fun k => by
        rw [← vsQAIdx_mul h (u⁻¹ : vsPBar hs (gens s.hs)).2 u.2]
        simp only [Subgroup.coe_inv, inv_mul_cancel]
        exact vsQAIdx_one h k
      right_inv := fun k => by
        rw [← vsQAIdx_mul h u.2 (u⁻¹ : vsPBar hs (gens s.hs)).2]
        simp only [Subgroup.coe_inv, mul_inv_cancel]
        exact vsQAIdx_one h k }
  map_one' := Equiv.ext fun k => vsQAIdx_one h k
  map_mul' u v := Equiv.ext fun k => vsQAIdx_mul h u.2 v.2 k

theorem vsQAPi_apply (h : VsQAHyp hs as Lb) (u : vsPBar hs (gens s.hs)) (k : Fin (vsQAPcs s Lb).length) :
    vsQAPi h u k = vsQAIdx s Lb u k := rfl

theorem vsQAPi_map (h : VsQAHyp hs as Lb) (u : vsPBar hs (gens s.hs)) (k : Fin (vsQAPcs s Lb).length) :
    (vsQAU s Lb k).map ((u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ) :
      Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) = vsQAU s Lb (vsQAPi h u k) :=
  vsQAIdx_spec h u.2 k

open Classical in
/-- The permutation of the pieces made by a permutation `g` of `H` (`1` outside `H`). -/
noncomputable def vsQAPiG (h : VsQAHyp hs as Lb) (g : Perm (Fin I.n)) : Perm (Fin (vsQAPcs s Lb).length) :=
  if hg : g ∈ gens s.hs then vsQAPi h ⟨vsPRho hs g, vsPRho_mem_vsPBar hs hg hg⟩ else 1

theorem vsQAPiG_mul (h : VsQAHyp hs as Lb) {g g' : Perm (Fin I.n)} (hg : g ∈ gens s.hs)
    (hg' : g' ∈ gens s.hs) : vsQAPiG h (g * g') = vsQAPiG h g * vsQAPiG h g' := by
  rw [vsQAPiG, dif_pos (mul_mem hg hg'), vsQAPiG, dif_pos hg, vsQAPiG, dif_pos hg', ← map_mul]
  congr 1
  exact Subtype.ext (vsPRho_mul hs hg hg')

theorem vsQAPiG_one (h : VsQAHyp hs as Lb) : vsQAPiG h 1 = 1 := by
  have e := vsQAPiG_mul h (one_mem (gens s.hs)) (one_mem (gens s.hs))
  rw [one_mul] at e
  exact (mul_eq_left.1 e.symm)

/-- **The table of a generator is its permutation of the pieces.** -/
theorem vsQATbl_eq (h : VsQAHyp hs as Lb) {g : Perm (Fin I.n)} (hg : g ∈ gens s.hs) :
    vsQATbl s Lb g = (List.finRange (vsQAPcs s Lb).length).map fun k => ((vsQAPiG h g k : ℕ)) := by
  apply List.ext_getElem (by simp [vsQATbl])
  intro i h1 h2
  have hi : i < (vsQAPcs s Lb).length := by simpa [vsQATbl] using h1
  obtain ⟨hj, hmap⟩ := vsQATbl_spec h hg hi
  simp only [List.getElem_map, List.getElem_finRange]
  simp only [vsQAPiG, dif_pos hg, vsQAPi_apply]
  have := vsQAIdx_eq h (u := vsPRho hs g) (vsPRho_mem_vsPBar hs hg hg) (k := ⟨i, hi⟩)
    (j := ⟨_, hj⟩) (by
      rw [vsPRho_of hs hg, vsQRho_eq_toLin' hs hg]
      exact hmap)
  simp only [Fin.cast_mk]; rw [this]

theorem vsQAPiG_inv (h : VsQAHyp hs as Lb) {g : Perm (Fin I.n)} (hg : g ∈ gens s.hs) :
    vsQAPiG h g⁻¹ = (vsQAPiG h g)⁻¹ := by
  have e := vsQAPiG_mul h (inv_mem hg) hg
  rw [inv_mul_cancel, vsQAPiG_one] at e
  exact eq_inv_of_mul_eq_one_left e.symm

theorem vsQAPi_eq (h : VsQAHyp hs as Lb) {g : Perm (Fin I.n)} (hg : g ∈ gens s.hs) :
    vsQAPi h ⟨vsPRho hs g, vsPRho_mem_vsPBar hs hg hg⟩ = vsQAPiG h g := by
  rw [vsQAPiG, dif_pos hg]

/-- **The image of `H̄` is generated by the tables of the generators.** -/
theorem vsQAPi_range (h : VsQAHyp hs as Lb) : (vsQAPi h).range = gens (s.hs.map (vsQAPiG h)) := by
  have aux : ∀ x (hx : x ∈ gens s.hs), vsQAPiG h x ∈ gens (s.hs.map (vsQAPiG h)) := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      exact Subgroup.subset_closure (List.mem_map_of_mem hx)
    | one => rw [vsQAPiG_one]; exact one_mem _
    | mul x y hx hy px py => rw [vsQAPiG_mul h hx hy]; exact mul_mem px py
    | inv x hx px => rw [vsQAPiG_inv h hx]; exact inv_mem px
  apply le_antisymm
  · rintro _ ⟨u, rfl⟩
    obtain ⟨x, -, hx, hxu⟩ := (vsPBar_mem_iff hs).1 u.2
    have eu : u = ⟨vsPRho hs x, vsPRho_mem_vsPBar hs hx hx⟩ := Subtype.ext hxu.symm
    rw [eu, vsQAPi_eq h hx]
    exact aux x hx
  · refine (Subgroup.closure_le _).2 ?_
    intro σ hσ
    obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hσ
    have hg' : g ∈ gens s.hs := Subgroup.subset_closure hg
    rw [← vsQAPi_eq h hg']
    exact ⟨_, rfl⟩

/-- **Transitivity.** -/
theorem vsQAPi_trans (h : VsQAHyp hs as Lb) (h0 : 0 < (vsQAPcs s Lb).length) (htop : vsQAW s Lb = ⊤)
    (i j : Fin (vsQAPcs s Lb).length) : ∃ σ ∈ (vsQAPi h).range, σ i = j := by
  have key : ∀ j : Fin (vsQAPcs s Lb).length, ∃ σ ∈ (vsQAPi h).range, σ ⟨0, h0⟩ = j := by
    intro j
    obtain ⟨g, hg, hm⟩ := vsQA_trans h h0 htop j
    refine ⟨vsQAPi h ⟨vsPRho hs g, vsPRho_mem_vsPBar hs hg hg⟩, ⟨_, rfl⟩, ?_⟩
    rw [vsQAPi_apply]
    refine vsQAIdx_eq h (vsPRho_mem_vsPBar hs hg hg) ?_
    rw [vsPRho_of hs hg, vsQRho_eq_toLin' hs hg]
    exact hm
  obtain ⟨σ, hσ, hσj⟩ := key j
  obtain ⟨τ, hτ, hτi⟩ := key i
  refine ⟨σ * τ⁻¹, mul_mem hσ (inv_mem hτ), ?_⟩
  rw [Perm.mul_apply, ← hτi, Perm.inv_apply_self, hσj]

/-- `H̄` is solvable. -/
theorem vsQA_solv (hs : VsQStOK s) : IsSolvable (vsPBar hs (gens s.hs)) := by
  haveI : IsSolvable (gens I.gs) := I.solvable
  haveI : IsSolvable (gens s.hs) :=
    solvable_of_solvable_injective (f := Subgroup.inclusion hs.prob.le) (Subgroup.inclusion_injective _)
  haveI : IsSolvable ((gens s.hs).subgroupOf (gens s.hs)) := inferInstance
  exact solvable_of_surjective (MonoidHom.subgroupMap_surjective (GI.Proved.vsQRho hs)
    ((gens s.hs).subgroupOf (gens s.hs)))

/-- The pieces are independent. -/
theorem vsQAU_indep (h : VsQAHyp hs as Lb) : iSupIndep (vsQAU s Lb) := by
  obtain ⟨a, hainj, ha⟩ := vsQA_pcs_eig h
  have hB := vsTAlg_comm h.abNormal.2.2
  have hind := vsFEig_indep _ hB (vsQAFix s Lb) (fun k => (h.fix k).1) (fun k => (h.fix k).2)
  have e : vsQAU s Lb = (fun c => vsFEig (vsQAFix s Lb) c) ∘ a := funext ha
  rw [e]
  exact hind.comp hainj

/-- The pieces span everything. -/
theorem vsQAU_top (h : VsQAHyp hs as Lb) : ⨆ k, vsQAU s Lb k = ⊤ := by
  have hP := vsFEigL_pieces I.prime _ (vsQAFix_sq (s := s) Lb)
  have hB := vsTAlg_comm h.abNormal.2.2
  have hsup := vsFEig_iSup _ hB (vsQAFix s Lb) (fun k => (h.fix k).1) (fun k => (h.fix k).2)
  rw [eq_top_iff, ← hsup]
  refine iSup_le fun c => ?_
  by_cases hc : vsFEig (vsQAFix s Lb) c = ⊥
  · rw [hc]; exact bot_le
  · obtain ⟨Q, hQ, hQc⟩ := hP.2 c hc
    obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hQ
    have : vsFEig (vsQAFix s Lb) c = vsQAU s Lb ⟨k, hk⟩ := hQc.symm
    rw [this]
    exact le_iSup (vsQAU s Lb) ⟨k, hk⟩

/-! ### Block sums -/

/-- The block with label `c`: the pieces with label `c`, put together. -/
def vsQABlk (Pcs : List (List (List ℕ))) (labL : List ℕ) (c : ℕ) : List (List ℕ) :=
  ((List.range Pcs.length).map fun i => if labL.getD i 0 = c then Pcs.getD i [] else []).flatten

/-- The nonempty blocks, in the order of their labels. -/
def vsQABlks (Pcs : List (List (List ℕ))) (labL : List ℕ) : List (List (List ℕ)) :=
  ((List.range Pcs.length).map (vsQABlk Pcs labL)).filter fun b => decide (0 < b.length)

section blocks

variable {Pcs : List (List (List ℕ))} {lab : Fin Pcs.length → ℕ}

theorem vsQA_labL_getD (i : Fin Pcs.length) :
    ((List.finRange Pcs.length).map lab).getD i 0 = lab i := by
  simp

theorem vsQA_mem_blk {c : ℕ} {u : List ℕ} :
    u ∈ vsQABlk Pcs ((List.finRange Pcs.length).map lab) c ↔ ∃ i : Fin Pcs.length, lab i = c ∧ u ∈ Pcs[i] := by
  simp only [vsQABlk, List.mem_flatten, List.mem_map, List.mem_range]
  constructor
  · rintro ⟨_, ⟨i, hi, rfl⟩, hu⟩
    have e := vsQA_labL_getD (lab := lab) ⟨i, hi⟩
    simp only at e
    rw [e] at hu
    split_ifs at hu with hc
    · refine ⟨⟨i, hi⟩, hc, ?_⟩
      simpa [List.getD_eq_getElem?_getD, hi] using hu
    · simp at hu
  · rintro ⟨i, hc, hu⟩
    refine ⟨_, ⟨i, i.2, rfl⟩, ?_⟩
    have e := vsQA_labL_getD (lab := lab) i
    rw [e, if_pos hc]
    simpa [List.getD_eq_getElem?_getD] using hu

theorem vsQA_sp_blk {p D : ℕ} [Fact p.Prime] (c : ℕ) :
    vsWSp p D (vsQABlk Pcs ((List.finRange Pcs.length).map lab) c) =
      vsMBlockSum (fun i : Fin Pcs.length => vsWSp p D Pcs[i]) lab c := by
  apply le_antisymm
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨u, hu, rfl⟩
    obtain ⟨i, hc, hu⟩ := vsQA_mem_blk.1 hu
    exact (le_iSup₂_of_le (f := fun i (_ : lab i = c) => vsWSp p D Pcs[i]) i hc le_rfl)
      (vsWV_mem_vsWSp D hu)
  · refine iSup₂_le fun i hc => Submodule.span_mono ?_
    rintro _ ⟨u, hu, rfl⟩
    exact ⟨u, vsQA_mem_blk.2 ⟨i, hc, hu⟩, rfl⟩

theorem vsQA_blk_pos (hne : ∀ i : Fin Pcs.length, Pcs[i] ≠ []) (c : ℕ) :
    0 < (vsQABlk Pcs ((List.finRange Pcs.length).map lab) c).length ↔ ∃ i, lab i = c := by
  rw [List.length_pos_iff_exists_mem]
  constructor
  · rintro ⟨u, hu⟩
    obtain ⟨i, hc, -⟩ := vsQA_mem_blk.1 hu
    exact ⟨i, hc⟩
  · rintro ⟨i, hc⟩
    obtain ⟨u, hu⟩ := List.exists_mem_of_ne_nil _ (hne i)
    exact ⟨u, vsQA_mem_blk.2 ⟨i, hc, hu⟩⟩

/-- The labels that occur, in increasing order. -/
def vsQALabs (lab : Fin Pcs.length → ℕ) : List ℕ :=
  (List.range Pcs.length).filter fun c => decide (∃ i, lab i = c)

theorem vsQA_blks_eq (hne : ∀ i : Fin Pcs.length, Pcs[i] ≠ []) :
    vsQABlks Pcs ((List.finRange Pcs.length).map lab) =
      (vsQALabs lab).map (vsQABlk Pcs ((List.finRange Pcs.length).map lab)) := by
  rw [vsQABlks, vsQALabs, List.filter_map]
  congr 1
  refine List.filter_congr fun c _ => ?_
  simp only [Function.comp_apply, decide_eq_decide]
  exact vsQA_blk_pos hne c

theorem vsQALabs_nodup : (vsQALabs lab).Nodup := (List.nodup_range).filter _

theorem vsQA_mem_labs (hlt : ∀ i, lab i < Pcs.length) {c : ℕ} :
    c ∈ vsQALabs lab ↔ ∃ i, lab i = c := by
  simp only [vsQALabs, List.mem_filter, List.mem_range, decide_eq_true_eq]
  constructor
  · exact fun h => h.2
  · rintro ⟨i, rfl⟩; exact ⟨hlt i, i, rfl⟩

/-- The labels, as the points of `Set.range lab`. -/
def vsQALabE (hlt : ∀ i, lab i < Pcs.length) (k : Fin (vsQALabs lab).length) : Set.range lab :=
  ⟨(vsQALabs lab)[k], (vsQA_mem_labs hlt).1 (List.getElem_mem k.2)⟩

theorem vsQALabE_bij (hlt : ∀ i, lab i < Pcs.length) : Function.Bijective (vsQALabE hlt) := by
  constructor
  · intro k₁ k₂ he
    have e : (vsQALabs lab)[k₁] = (vsQALabs lab)[k₂] := congrArg Subtype.val he
    exact Fin.ext ((vsQALabs_nodup.getElem_inj_iff).1 e)
  · rintro ⟨c, hc⟩
    obtain ⟨k, hk, e⟩ := List.mem_iff_getElem.1 ((vsQA_mem_labs hlt).2 hc)
    exact ⟨⟨k, hk⟩, Subtype.ext e⟩

end blocks

/-! ### The split by the block sums -/

/-- The facts on the block sums that the split needs. -/
structure VsQABlkFacts (s : VsQSt I) (Ps : List (List (List ℕ))) : Prop where
  fit : ∀ P ∈ Ps, VsWFit I.p (vsQD s) P
  two : 2 ≤ Ps.length
  ind : iSupIndep fun i : Fin Ps.length => vsWSp I.p (vsQD s) Ps[i]
  dim : ∃ e, 0 < e ∧ ∀ i : Fin Ps.length, finrank (ZMod I.p) (vsWSp I.p (vsQD s) Ps[i]) = e
  top : (⨆ i : Fin Ps.length, vsWSp I.p (vsQD s) Ps[i]) = ⊤
  orb24 : (vsQOrb (vsQTAct s) s.hs (Ps.map (vsWSp I.p (vsQD s)))).ncard ≤ (Ps.length + 1) ^ 24

theorem vsQA_pcs_ne_nil (k : Fin (vsQAPcs s Lb).length) : (vsQAPcs s Lb)[k] ≠ [] := by
  intro he
  apply vsQAU_ne k
  change vsWSp I.p (vsQD s) (vsQAPcs s Lb)[k] = ⊥
  rw [he, vsWSp_nil]

/-- **The block sums of a minimal block system.** -/
theorem vsQA_blkFacts (h : VsQAHyp hs as Lb) (h2 : 2 ≤ (vsQAPcs s Lb).length) (htop : vsQAW s Lb = ⊤)
    {lab : Fin (vsQAPcs s Lb).length → ℕ} (hlt : ∀ i, lab i < (vsQAPcs s Lb).length)
    (hmin : IsMinimalBlocks (gens (s.hs.map (vsQAPiG h))) lab) :
    VsQABlkFacts s (vsQABlks (vsQAPcs s Lb) ((List.finRange (vsQAPcs s Lb).length).map lab)) := by
  classical
  have h0 : 0 < (vsQAPcs s Lb).length := by omega
  -- the space is nontrivial
  haveI : Nontrivial (Fin (vsQD s) → ZMod I.p) := by
    obtain ⟨x, -, hx⟩ := (Submodule.ne_bot_iff _).1 (vsQAU_ne (s := s) (Lb := Lb) ⟨0, h0⟩)
    exact ⟨⟨x, 0, hx⟩⟩
  have hmin' : IsMinimalBlocks (vsQAPi h).range lab := by rw [vsQAPi_range h]; exact hmin
  have htr : ∀ i j, ∃ u, vsQAPi h u i = j := fun i j => by
    obtain ⟨σ, ⟨u, rfl⟩, hσ⟩ := vsQAPi_trans h h0 htop i j
    exact ⟨u, hσ⟩
  obtain ⟨hcard, hind, htopB, hdimB, -, hidx⟩ := vsM_blocks (p := I.p)
    (V := Fin (vsQD s) → ZMod I.p) (vsPBar hs (gens s.hs)) (vsQAU s Lb) (vsQAPi h) lab (vsQA_solv hs)
    vsQAU_ne (vsQAU_indep h) (vsQAU_top h) (vsQAPi_map h) htr hmin'
  obtain ⟨X, hX⟩ : ∃ X : Set.range lab → Submodule (ZMod I.p) (Fin (vsQD s) → ZMod I.p),
      X = fun c : Set.range lab => vsMBlockSum (vsQAU s Lb) lab c := ⟨_, rfl⟩
  have hbij := vsQALabE_bij hlt
  rw [vsQA_blks_eq vsQA_pcs_ne_nil]
  obtain ⟨Ps, hPs⟩ : ∃ Ps, Ps = (vsQALabs lab).map
      (vsQABlk (vsQAPcs s Lb) ((List.finRange (vsQAPcs s Lb).length).map lab)) := ⟨_, rfl⟩
  rw [← hPs]
  have hlen : Ps.length = (vsQALabs lab).length := by rw [hPs, List.length_map]
  have hsp : ∀ k : Fin Ps.length, vsWSp I.p (vsQD s) Ps[k] = X (vsQALabE hlt (Fin.cast hlen k)) := by
    intro k
    subst hPs
    rw [hX]
    simp only [Fin.getElem_fin, List.getElem_map]
    exact vsQA_sp_blk (lab := lab) _
  have hspf : (fun k : Fin Ps.length => vsWSp I.p (vsQD s) Ps[k]) =
      X ∘ vsQALabE hlt ∘ Fin.cast hlen := funext hsp
  have hbij' : Function.Bijective (vsQALabE hlt ∘ Fin.cast hlen) :=
    hbij.comp (finCongr hlen).bijective
  have hnc : (Set.range lab).ncard = Ps.length := by
    rw [← Nat.card_coe_set_eq, ← Nat.card_congr (Equiv.ofBijective _ hbij'), Nat.card_eq_fintype_card,
      Fintype.card_fin]
  have hD : 0 < vsQD s := by
    have := Module.finrank_pos (R := ZMod I.p) (M := Fin (vsQD s) → ZMod I.p)
    rwa [Module.finrank_fin_fun] at this
  have hdk : ∀ k : Fin Ps.length, (Set.range lab).ncard *
      finrank (ZMod I.p) (vsWSp I.p (vsQD s) Ps[k]) = vsQD s := by
    intro k
    rw [hsp, hX]
    have h1 := hdimB _ (vsQALabE hlt (Fin.cast hlen k)).2
    rwa [Module.finrank_fin_fun] at h1
  refine ⟨?_, by rw [← hnc]; exact hcard, ?_, ?_, ?_, ?_⟩
  · -- fit
    intro P hP
    rw [hPs] at hP
    obtain ⟨c, -, rfl⟩ := List.mem_map.1 hP
    intro u hu
    obtain ⟨i, -, hu⟩ := vsQA_mem_blk.1 hu
    exact ((vsFEigL_pieces I.prime _ (vsQAFix_sq (s := s) Lb)).1 _ (List.getElem_mem i.2)).1 u hu
  · rw [hspf, hX]; exact hind.comp hbij'.1
  · -- equal dimensions
    have hn : 0 < (Set.range lab).ncard := by omega
    have hq : ∀ k : Fin Ps.length, vsQD s / (Set.range lab).ncard =
        finrank (ZMod I.p) (vsWSp I.p (vsQD s) Ps[k]) := fun k =>
      Nat.div_eq_of_eq_mul_right hn (hdk k).symm
    refine ⟨vsQD s / (Set.range lab).ncard, ?_, fun k => (hq k).symm⟩
    have k0 : 0 < Ps.length := by rw [← hnc]; omega
    have h1 := hdk ⟨0, k0⟩
    rw [hq ⟨0, k0⟩]
    rcases Nat.eq_zero_or_pos (finrank (ZMod I.p) (vsWSp I.p (vsQD s) Ps[(⟨0, k0⟩ : Fin Ps.length)])) with hz | hz
    · rw [hz, mul_zero] at h1; omega
    · exact hz
  · rw [hspf, ← htopB]
    have := hbij'.2.iSup_comp X
    rw [hX] at this ⊢
    exact this
  · refine (vsH_tup_orbit hs (X := X) ?_).trans ?_
    · intro V hV
      obtain ⟨P, hP, rfl⟩ := List.mem_map.1 hV
      obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.1 hP
      exact ⟨_, hsp ⟨k, hk⟩⟩
    · rw [← hnc, hX]
      exact hidx

theorem VsQABlkFacts.orb {Ps : List (List (List ℕ))} (H : VsQABlkFacts s Ps) :
    (vsQOrb (vsQTAct s) s.hs (Ps.map (vsWSp I.p (vsQD s)))).ncard ≤ (Ps.length + 1) ^ 278 :=
  H.orb24.trans (Nat.pow_le_pow_right (by omega) (by omega))

/-- **The split by the block sums.** -/
theorem VsQABlkFacts.splitOK {Ps : List (List (List ℕ))} (H : VsQABlkFacts s Ps) (hs : VsQStOK s)
    {Tm : ℕ} {L : List (VsQTup s × Perm (Fin I.n))} {ks : List (Perm (Fin I.n))}
    (hL : VsQOrbL (vsQTAct s) s.hs (Ps.map (vsWSp I.p (vsQD s))) L)
    (hks : gens ks = vsQStabG (vsQTAct_act hs) le_rfl (Ps.map (vsWSp I.p (vsQD s))))
    (hksl : ks.length ≤ I.n ^ 2) (hTm : L.length ≤ Tm) (hnab : ¬ s.Ab) :
    VsQSplitOK s 278 Tm (L.map Prod.snd) ks (vsQTLows s (vsQTQs Ps)) :=
  vsH_splitOK_of hs H.fit H.two H.ind H.dim H.top H.orb hL hks hksl hTm hnab

