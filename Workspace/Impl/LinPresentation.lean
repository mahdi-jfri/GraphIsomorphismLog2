import Workspace.Impl.LinSolve
import Mathlib.LinearAlgebra.FreeModule.Finite.CardQuotient
import Mathlib.LinearAlgebra.Matrix.Nondegenerate
import Mathlib.LinearAlgebra.Matrix.Block

/-! The counting argument for the complete triangular presentation in A.20.
The quotient is by the integer row lattice, so it is an abelian presentation.
The isomorphism below is induced by the given coordinate map. -/
namespace GI.Impl
open Matrix

/-- The subgroup of integer relations generated by the rows of M. -/
def linRelations {r c : ℕ} (M : Matrix (Fin r) (Fin c) ℤ) : Submodule ℤ (Fin c → ℤ) :=
  LinearMap.range M.vecMulLinear

/-- To validate the presentation map, it suffices to validate the individual relation rows. -/
theorem linRelations_le_ker {r c : ℕ} {Q : Type*} [AddCommGroup Q]
    (M : Matrix (Fin r) (Fin c) ℤ) (f : (Fin c → ℤ) →ₗ[ℤ] Q)
    (hrows : ∀ i, f (M i) = 0) : linRelations M ≤ LinearMap.ker f := by
  rw [linRelations, range_vecMulLinear]
  apply Submodule.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact hrows i

/-- A nonsingular square row matrix presents a group of order |det M|. -/
theorem linPresentation_card {n : ℕ} (M : Matrix (Fin n) (Fin n) ℤ) (hM : M.det ≠ 0) :
    Nat.card ((Fin n → ℤ) ⧸ linRelations M) = M.det.natAbs := by
  have hi : Function.Injective M.vecMulLinear := by
    intro x y hxy
    apply sub_eq_zero.mp
    apply M.eq_zero_of_vecMul_eq_zero hM
    rw [sub_vecMul, ← Matrix.vecMulLinear_apply, ← Matrix.vecMulLinear_apply, hxy, sub_self]
  let e := LinearEquiv.ofInjective M.vecMulLinear hi
  have hc := Submodule.natAbs_det_equiv (linRelations M) e
  have he : (linRelations M).subtype ∘ₗ
      AddMonoidHom.toIntLinearMap e.toAddEquiv.toAddMonoidHom =
      M.vecMulLinear := by
    ext x i
    rfl
  change (LinearMap.det ((linRelations M).subtype ∘ₗ
    AddMonoidHom.toIntLinearMap e.toAddEquiv.toAddMonoidHom)).natAbs = _ at hc
  rw [he, ← M.mulVecLin_transpose, ← Matrix.toLin'_apply', LinearMap.det_toLin',
    Matrix.det_transpose] at hc
  exact hc.symm

/-- In the paper the diagonal consists of the successive cyclic quotient orders. -/
theorem linTriangularPresentation_card {n : ℕ} (M : Matrix (Fin n) (Fin n) ℤ)
    (htri : M.BlockTriangular OrderDual.toDual) (e : Fin n → ℕ)
    (he : ∀ i, M i i = (e i : ℤ)) (hpos : ∀ i, 0 < e i) :
    Nat.card ((Fin n → ℤ) ⧸ linRelations M) = ∏ i, e i := by
  have hd : M.det = ∏ i, (e i : ℤ) := by
    rw [Matrix.det_of_lowerTriangular M htri]
    simp_rw [he]
  have hn : M.det ≠ 0 := by
    rw [hd]
    exact Finset.prod_ne_zero_iff.mpr fun i _ => by exact_mod_cast (Nat.ne_of_gt (hpos i))
  rw [linPresentation_card M hn, hd]
  change Int.natAbsHom (∏ i, (e i : ℤ)) = _
  rw [map_prod]
  simp

/-- A coordinate map killing all relation vectors factors through the presentation.
If the target has the determinant order, this map is an isomorphism. -/
noncomputable def linPresentationEquiv {n : ℕ} {Q : Type*} [AddCommGroup Q]
    (M : Matrix (Fin n) (Fin n) ℤ) (hM : M.det ≠ 0)
    (f : (Fin n → ℤ) →ₗ[ℤ] Q) (hf : Function.Surjective f)
    (hrel : linRelations M ≤ LinearMap.ker f) (hcard : Nat.card Q = M.det.natAbs) :
    ((Fin n → ℤ) ⧸ linRelations M) ≃ₗ[ℤ] Q := by
  let g := (linRelations M).liftQ f hrel
  have hg : Function.Surjective g := by
    intro q
    obtain ⟨z, hz⟩ := hf q
    exact ⟨(linRelations M).mkQ z, hz⟩
  haveI : Finite ((Fin n → ℤ) ⧸ linRelations M) := Nat.finite_of_card_ne_zero (by
    rw [linPresentation_card M hM]
    exact Int.natAbs_ne_zero.mpr hM)
  apply LinearEquiv.ofBijective g
  exact (Nat.bijective_iff_surjective_and_card g).mpr
    ⟨hg, (linPresentation_card M hM).trans hcard.symm⟩

/-- The isomorphism sends an integer vector to its image under the original coordinate map. -/
@[simp] theorem linPresentationEquiv_mk {n : ℕ} {Q : Type*} [AddCommGroup Q]
    (M : Matrix (Fin n) (Fin n) ℤ) (hM : M.det ≠ 0)
    (f : (Fin n → ℤ) →ₗ[ℤ] Q) (hf : Function.Surjective f)
    (hrel : linRelations M ≤ LinearMap.ker f) (hcard : Nat.card Q = M.det.natAbs)
    (z : Fin n → ℤ) :
    linPresentationEquiv M hM f hf hrel hcard ((linRelations M).mkQ z) = f z := rfl

end GI.Impl
