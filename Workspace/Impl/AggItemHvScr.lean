module

public import Workspace.Impl.AggItemStepC1
public import Workspace.Impl.AggItemHvPc

@[expose] public section

/-!
# Case 2a: the item scripts of the rounds of the base set

In Case 2a the item of every branch is `halvingItem` (`AggregationPlan.lean`). It depends on the
round only through the dominant sets `Φ` of `X` and `Φ'` of `Y`, the certificate lift and the
halving choices `align Φ Φ'` and `twist Φ`. For the rounds of the base set (`itSBase K`):

* `Φ` and `Φ'` are the dominant sets of the groups generated by the second parts of `fx` and of
  `fy` (`itS_grps`), the same for every branch (`itHvPhi`, `itHvPhi'`);
* the certificate lift is the same for all rounds (`cm_certLift_eq`).

So once the program has fixed `τ₀` and `t`, every round whose choices are `τ₀` and `t`
(`itHvD`) has the same item script `(itHvH K τ₀ t).script` in every branch
(`it_hv_items_some`). If the sizes of `Φ` and `Φ'` differ, or `|Φ| < 2`, the item is empty
(`it_hv_items_none`). The set `itHvD` is not empty when `τ₀` and `t` meet the facts of the
alignment and of the twist (`itHvD_nonempty`): the round `itUpd … (itHvChoice …)` lies in it.
-/

set_option linter.unusedSectionVars false

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Cited (Val encPerm gens encGroup)

variable {Ω C : Type} {k : ℕ}

section Scr

variable {S : State Ω C} {L : SuppliedLabels S}

/-- The dominant set `Φ` of the source structure. -/
noncomputable def itHvPhi (K : ItSCtx k S L) : Finset (Fin L.q) :=
  domSet (gens (K.fx.map Prod.snd))

/-- The dominant set `Φ'` of the target structures. -/
noncomputable def itHvPhi' (K : ItSCtx k S L) : Finset (Fin L.q) :=
  domSet (gens (K.fy.map Prod.snd))

/-- The test of `halvingItem`: `|Φ| = |Φ'|` and `|Φ| ≥ 2`. -/
def ItHvCond (K : ItSCtx k S L) : Prop :=
  (itHvPhi K).card = (itHvPhi' K).card ∧ 2 ≤ (itHvPhi K).card

/-- The halving data of the context for the choices `τ₀` and `t`. -/
noncomputable def itHvH (K : ItSCtx k S L) (τ₀ t : Perm Ω) : Halving S L.toGiantLabels where
  Φ := itHvPhi K
  τ₀ := τ₀
  t := t
  A := certLift S L.toGiantLabels K.Ag₀.fin K.Ag₀.πd P₀.κ ⊓
    L.toGiantLabels.lift (GI.Rectangle.evenSides (itHvPhi K) (itHvPhi K)ᶜ)

/-- The rounds of the base set whose halving choices at `(Φ, Φ')` are `τ₀` and `t`. -/
def itHvD (K : ItSCtx k S L) (τ₀ t : Perm Ω) : Set (Aggregation P₀ S L.toGiantLabels) :=
  {Ag | Ag ∈ itSBase K ∧ Ag.halv.align (itHvPhi K) (itHvPhi' K) = τ₀ ∧
    Ag.halv.twist (itHvPhi K) = t}

theorem itHvD_sub (K : ItSCtx k S L) (τ₀ t : Perm Ω) : itHvD K τ₀ t ⊆ itSBase K :=
  fun _ h => h.1

variable {e : Ω ≃ Fin k} {c : C → ℕ} {K : ItSCtx k S L}

/-- **The set `itHvD` is not empty** for choices that meet the facts of the alignment and of the
twist. -/
theorem itHvD_nonempty (hK : K.OK e c) {τ₀ t : Perm Ω}
    (hal : (itHvPhi K).card = (itHvPhi' K).card → 2 ≤ (itHvPhi K).card →
      ItHvAl L.toGiantLabels (itHvPhi K) (itHvPhi' K) τ₀)
    (htw : 2 ≤ (itHvPhi K).card → ItHvTw L.toGiantLabels (itHvPhi K) t) :
    (itHvD K τ₀ t).Nonempty :=
  ⟨_, itSBase_upd hK rfl (itHvChoice L.toGiantLabels (itHvPhi K) (itHvPhi' K) τ₀ t hal htw)
    SojChoice.default K.Ag₀.rep,
    itHvChoice_align _ _ _ _ _ hal htw, itHvChoice_twist _ _ _ _ _ hal htw⟩

/-- In Case 2a the item of a round of the base set is `halvingItem`. -/
theorem itS_items_twoA (hK : K.OK e c) {Ag : Aggregation P₀ S L.toGiantLabels}
    (hAg : Ag ∈ itSBase K) (hc : K.case = .twoA) (b : Fin (P₀.κ + 1) → Fin L.q) :
    Ag.items b = halvingItem Ag.fin Ag.πd Ag.halv (Ag.strX Ag.src) (Ag.strY b) := by
  have h := itS_case_eq hK hAg
  rw [hc] at h
  unfold Aggregation.items plan
  rw [h]

/-- **The empty item**: if the test of `halvingItem` fails, the item script is finished with
nothing. -/
theorem it_hv_items_none (hK : K.OK e c) {Ag : Aggregation P₀ S L.toGiantLabels}
    (hAg : Ag ∈ itSBase K) (hc : K.case = .twoA) (b : Fin (P₀.κ + 1) → Fin L.q)
    (hn : ¬ ItHvCond K) : (Ag.items b).script = .done ⟨[], []⟩ := by
  obtain ⟨hX, hY⟩ := itS_grps hK hAg b
  rw [itS_items_twoA hK hAg hc b, halvingItem, hX, hY]
  unfold ItHvCond itHvPhi itHvPhi' at hn
  rw [if_neg hn]
  rfl

/-- **The halving item**: if the test passes, a round of `itHvD K τ₀ t` has the item
`.halving (itHvH K τ₀ t)` in every branch. -/
theorem it_hv_items_some (hK : K.OK e c) {τ₀ t : Perm Ω} {Ag : Aggregation P₀ S L.toGiantLabels}
    (hAg : Ag ∈ itHvD K τ₀ t) (hc : K.case = .twoA) (b : Fin (P₀.κ + 1) → Fin L.q)
    (hy : ItHvCond K) : Ag.items b = .halving (itHvH K τ₀ t) := by
  obtain ⟨hB, hal, htw⟩ := hAg
  obtain ⟨hX, hY⟩ := itS_grps hK hB b
  have hR : Ag ∈ asRounds L := hK.sub (itSBase_sub hB)
  have hR0 : K.Ag₀ ∈ asRounds L := hK.sub hK.mem
  have hcl : certLift S L.toGiantLabels Ag.fin Ag.πd P₀.κ =
      certLift S L.toGiantLabels K.Ag₀.fin K.Ag₀.πd P₀.κ := cm_certLift_eq hR hR0 S.x
  rw [itS_items_twoA hK hB hc b, halvingItem, hX, hY]
  unfold ItHvCond itHvPhi itHvPhi' at hy
  rw [if_pos hy]
  unfold itHvPhi itHvPhi' at hal
  unfold itHvPhi at htw
  rw [hal, htw, hcl]
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- **The halving data are valid** (`items_valid`). -/
theorem it_hv_valid (hK : K.OK e c) {τ₀ t : Perm Ω} {Ag : Aggregation P₀ S L.toGiantLabels}
    (hAg : Ag ∈ itHvD K τ₀ t) (hc : K.case = .twoA) (hy : ItHvCond K) :
    (itHvH K τ₀ t).Valid P₀ := by
  have h := Ag.items_valid (fun _ => ⟨0, it_q_pos Ag⟩)
  rw [it_hv_items_some hK hAg hc _ hy] at h
  exact h.1

/-- The kernel of the halving data is `itHvKer`. -/
theorem itHvH_ker (K : ItSCtx k S L) (τ₀ t : Perm Ω) :
    (itHvH K τ₀ t).ker = itHvKer L.toGiantLabels (itHvPhi K) := rfl

end Scr

end GI.Impl
