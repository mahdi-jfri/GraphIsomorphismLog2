import Workspace.Impl.TermSupFix

/-!
# T4, one descent of the Frattini reduction

The proof of Lemma A.19: "Start with `S = H` and `K = N`. If `K` is not nilpotent, choose a
nonnormal Sylow subgroup `P` of `K`. For each generator `s` of `S`, … Let `S₁` be generated by
these corrected elements. … Replace `(S, K)` by `(S₁, K₁)`. The invariants `SN = H` and
`K = S ∩ N` persist."

One step of the loop, on `[[gens R, gens N], i, [flag, gens S]]` (`supDescBody`):
* if the flag is `1`, the descent has ended (`K` is nilpotent) and the state stays;
* otherwise `K = S ∩ N` (the cited **NormalizedIntersection**: `S ≤ R` normalizes `N`), then the
  search (`supFind_spec`). If it finds a Sylow `p`-subgroup `P` that `K` does not normalize, every
  generator of `S` is corrected (`supFix_spec`, mapped over the generators); else `K` is
  nilpotent and the flag becomes `1`.

The invariant `SupDescInv R N i` (after `i` steps): `S ≤ R`, `S ⊔ N = R`, `S` has at most `m²`
generators, and either the flag is `1` and `S ∩ N` is nilpotent, or the flag is `0` and
`2^i |S ∩ N| ≤ |N|`. The halving is `sup_corr_step`: `K₁ = S₁ ∩ N` lies in the normalizer of `P`
in `K`, a proper subgroup of `K`. So after `m² + 1` steps the flag is `1`, since
`|N| < 2^(m² + 1)` (`supDesc_done`).
-/

namespace GI.Impl

open GI.Lang GI.Cited Equiv
open GI.Machine (BinOp)

variable {n : ℕ}

/-! ### Mathematics of the step -/

/-- An element of `R` conjugates `N` into itself when `N ⊴ R`. -/
theorem sup_conj_mem {R N : Subgroup (Perm (Fin n))} [hN : (N.subgroupOf R).Normal]
    (hNR : N ≤ R) {g x : Perm (Fin n)} (hg : g ∈ R) (hx : x ∈ N) : g * x * g⁻¹ ∈ N := by
  have h := hN.conj_mem ⟨x, hNR hx⟩ (by simpa [Subgroup.mem_subgroupOf] using hx) ⟨g, hg⟩
  simpa [Subgroup.mem_subgroupOf] using h

theorem sup_forall₂_mem_right {α β : Type*} {Q : α → β → Prop} :
    ∀ {l₁ : List α} {l₂ : List β}, List.Forall₂ Q l₁ l₂ → ∀ t ∈ l₂, ∃ s ∈ l₁, Q s t
  | _, _, List.Forall₂.nil => fun _ h => absurd h List.not_mem_nil
  | _, _, List.Forall₂.cons (a := a) h hr => fun t ht => by
    rcases List.mem_cons.mp ht with rfl | ht
    · exact ⟨a, List.mem_cons_self .., h⟩
    · obtain ⟨s, hs, hq⟩ := sup_forall₂_mem_right hr t ht
      exact ⟨s, List.mem_cons_of_mem _ hs, hq⟩

theorem sup_forall₂_mem_left {α β : Type*} {Q : α → β → Prop} :
    ∀ {l₁ : List α} {l₂ : List β}, List.Forall₂ Q l₁ l₂ → ∀ s ∈ l₁, ∃ t ∈ l₂, Q s t
  | _, _, List.Forall₂.nil => fun _ h => absurd h List.not_mem_nil
  | _, _, List.Forall₂.cons (b := b) h hr => fun s hs => by
    rcases List.mem_cons.mp hs with rfl | hs
    · exact ⟨b, List.mem_cons_self .., h⟩
    · obtain ⟨t, ht, hq⟩ := sup_forall₂_mem_left hr s hs
      exact ⟨t, List.mem_cons_of_mem _ ht, hq⟩

/-- The value of a list of generators. -/
def supSv (ss : List (Perm (Fin n))) : Val := .list (ss.map encPerm)

/-- **The invariant of the descent** after `i` steps. -/
def SupDescInv (R N : Subgroup (Perm (Fin n))) (i : ℕ) (acc : Val) : Prop :=
  ∃ ss : List (Perm (Fin n)), ss.length ≤ n ^ 2 ∧ gens ss ≤ R ∧ gens ss ⊔ N = R ∧
    ((acc = .list [.nat 1, supSv ss] ∧ Group.IsNilpotent (gens ss ⊓ N : Subgroup _)) ∨
      (acc = .list [.nat 0, supSv ss] ∧
        2 ^ i * Nat.card (gens ss ⊓ N : Subgroup _) ≤ Nat.card N))

theorem sup_desc_wt {R N : Subgroup (Perm (Fin n))} {i : ℕ} {acc : Val}
    (h : SupDescInv R N i acc) : acc.wt ≤ 40 * (n + 1) ^ 6 := by
  obtain ⟨ss, hl, -, -, h⟩ := h
  have h1 : (supSv ss).wt ≤ 13 * (n + 1) ^ 6 := wt_list_encPerms_le_sq hl
  have h0 := wt_nat_le 0
  have h1' := wt_nat_le 1
  have hk : 1 ≤ (n + 1) ^ 6 := Nat.one_le_pow _ _ (by omega)
  rcases h with ⟨rfl, -⟩ | ⟨rfl, -⟩
  · have := wt_list2_le (.nat 1) (supSv ss); omega
  · have := wt_list2_le (.nat 0) (supSv ss); omega

/-- **The end of the descent**: after `m² + 1` steps the flag is `1`. -/
theorem supDesc_done {R N : Subgroup (Perm (Fin n))} {acc : Val}
    (h : SupDescInv R N (n ^ 2 + 1) acc) :
    ∃ ss : List (Perm (Fin n)), ss.length ≤ n ^ 2 ∧ gens ss ≤ R ∧ gens ss ⊔ N = R ∧
      acc = .list [.nat 1, supSv ss] ∧ Group.IsNilpotent (gens ss ⊓ N : Subgroup _) := by
  obtain ⟨ss, hl, hle, hsup, ⟨rfl, hnil⟩ | ⟨rfl, hc⟩⟩ := h
  · exact ⟨ss, hl, hle, hsup, rfl, hnil⟩
  · exfalso
    have h1 := GI.CitedChecks.card_lt_two_pow N
    have h2 : 0 < Nat.card (gens ss ⊓ N : Subgroup _) := Nat.card_pos
    have : 2 ^ (n ^ 2 + 1) ≤ 2 ^ (n ^ 2 + 1) * Nat.card (gens ss ⊓ N : Subgroup _) :=
      Nat.le_mul_of_pos_right _ h2
    omega

/-! ### The step -/

/-- **One descent** on `[[gens R, gens N], i, [flag, gens S]]`. Environment
`[a, gens S, gens of S ∩ N, gens K, search result]`. -/
def supDescBody (mg jni fd mf : ℕ) : Expr :=
  .ite (.get (arg 2) (.nat 0)) (arg 2)
  (.letE (.call mg (mk2 (.get (.get (arg 0) (.nat 0)) (.nat 0)) (.get (arg 2) (.nat 1))))
  (.letE (.prim jni (mk2 (.var 1) (.get (arg 0) (.nat 1))))
  (.letE (.call mg (mk2 (.get (.get (arg 0) (.nat 0)) (.nat 0)) (.var 2)))
  (.letE (.call fd (.var 3))
  (.ite (.get (.var 4) (.nat 1))
    (mk2 (.nat 0) (.call mf (mk2 (mk3 (.var 3) (.get (.var 4) (.nat 2)) (.get (.var 4) (.nat 3)))
      (.get (arg 2) (.nat 1)))))
    (mk2 (.nat 1) (.get (arg 2) (.nat 1))))))))

/-- Where the descent step and its modules sit. -/
structure SupDescAt (P : Program) (g mg jni fd mf fx it gs le jsy jnc jord jm iv mc cj cp jsc : ℕ)
    (hni : NormalizedIntersection) (hsy : SylowAlgo) (hnc : NormalClosure) (hord : GroupOrder)
    (hmem : Membership) (hsc : SylowConjugate) : Prop where
  step : P.funs[g]? = some (supDescBody mg jni fd mf)
  ni : P.prims[jni]? = some (normalizedIntersectionPrim hni)
  find : SupFindAt P fd it gs mg le jsy jnc jord jm hsy hnc hord hmem
  map : P.HasAt mf (mapFuns mf fx)
  fix : SupFixAt P fx iv mc cj cp jsc hsc

/-- The cost bound of one descent, for `[gens R, gens N]` of weight `W`. -/
def supDescCost (pni psy pnc pord pm psc : Prim) (n W : ℕ) : ℕ :=
  pni.boundSize (10 ^ 4 * (W + 1) ^ 6) + supFindCost psy pnc pord pm n +
    (n + 1) ^ 2 * supFixCost psc n + 10 ^ 9 * (W + 1) ^ 9

set_option maxHeartbeats 1600000 in
open Classical in
/-- **One descent** keeps `SupDescInv`, from `i` to `i + 1`. -/
theorem supDesc_step {hni : NormalizedIntersection} {hsy : SylowAlgo} {hnc : NormalClosure}
    {hord : GroupOrder} {hmem : Membership} {hsc : SylowConjugate} {P : Program}
    {g mg jni fd mf fx it gs le jsy jnc jord jm iv mc cj cp jsc : ℕ}
    (hP : SupDescAt P g mg jni fd mf fx it gs le jsy jnc jord jm iv mc cj cp jsc hni hsy hnc hord
      hmem hsc)
    {σR σN : List (Perm (Fin n))} (hNR : gens σN ≤ gens σR)
    [((gens σN).subgroupOf (gens σR)).Normal] {i : ℕ} (hi : i ≤ n ^ 2) {acc : Val}
    (hinv : SupDescInv (gens σR) (gens σN) i acc) :
    FunAll P g (.list [.list [encGroup σR, encGroup σN], .nat i, acc]) (fun w c =>
      SupDescInv (gens σR) (gens σN) (i + 1) w ∧
      c ≤ supDescCost (normalizedIntersectionPrim hni) (sylowPrim hsy) (normalClosurePrim hnc)
        (groupOrderPrim hord) (membershipPrim hmem) (sylowConjugatePrim hsc) n
        (Val.list [encGroup σR, encGroup σN]).wt) := by
  set c := Val.list [encGroup σR, encGroup σN] with hc
  set W := c.wt with hW
  set C := supDescCost (normalizedIntersectionPrim hni) (sylowPrim hsy) (normalClosurePrim hnc)
    (groupOrderPrim hord) (membershipPrim hmem) (sylowConjugatePrim hsc) n W with hC
  have haw := sup_desc_wt hinv
  have hRw : (encGroup σR).wt < W := wt_le_wt_list (by simp)
  have hNw : (encGroup σN).wt < W := wt_le_wt_list (by simp)
  have hnW : n + 1 ≤ W := by
    have := S_le_wt_encGroup σR
    have : n + 1 ≤ (σR.length + 2) * (n + 1) := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hW6 : (n + 1) ^ 6 ≤ (W + 1) ^ 6 := Nat.pow_le_pow_left (by omega) _
  have hW69 : (W + 1) ^ 6 ≤ (W + 1) ^ 9 := Nat.pow_le_pow_right (by omega) (by omega)
  have hW1 : W + 1 ≤ (W + 1) ^ 6 := Nat.le_self_pow (by norm_num) _
  set a := Val.list [c, .nat i, acc] with ha
  have hn2 : n ^ 2 ≤ (n + 1) ^ 6 :=
    (Nat.pow_le_pow_left (by omega) 2).trans (Nat.pow_le_pow_right (by omega) (by omega))
  have hiw := wt_nat_le i
  have h3 := wt_list3_le c (.nat i) acc
  refine FunAll.intro hP.step ?_
  unfold supDescBody
  obtain ⟨ss, hl, hle, hsup, ⟨rfl, hnil⟩ | ⟨rfl, hcard⟩⟩ := hinv
  · -- the descent has ended
    have dacc := Det.arg' (P := P) (vs := [c, .nat i, .list [.nat 1, supSv ss]]) (rest := [])
      (j := 2) rfl
    have d1 := Det.get' dacc (Det.nat 0) (v := .nat 1) rfl
    refine (Det.ite_pos d1 one_ne_zero dacc).post fun c' hc' => ⟨⟨ss, hl, hle, hsup,
      Or.inl ⟨rfl, hnil⟩⟩, ?_⟩
    have := wt_nat_le 1
    have : 10 ^ 9 * (W + 1) ^ 6 ≤ C := by
      simp only [hC, supDescCost]
      have := Nat.mul_le_mul_left (10 ^ 9) hW69
      omega
    omega
  -- the descent goes on
  set acc := Val.list [.nat 0, supSv ss] with hacc
  have hsvw : (supSv ss).wt ≤ 13 * (n + 1) ^ 6 := wt_list_encPerms_le_sq hl
  have hmk : 8 * mkGroupK * (n + 1) ^ 9 ≤ 10 ^ 6 * (W + 1) ^ 9 := by
    have : (n + 1) ^ 9 ≤ (W + 1) ^ 9 := Nat.pow_le_pow_left (by omega) _
    simp only [mkGroupK]; omega
  have hW8 : (W + 1) ^ 6 ≤ (W + 1) ^ 8 := Nat.pow_le_pow_right (by omega) (by omega)
  have hW89 : (W + 1) ^ 8 ≤ (W + 1) ^ 9 := Nat.pow_le_pow_right (by omega) (by omega)
  set NB := (normalizedIntersectionPrim hni).boundSize (10 ^ 4 * (W + 1) ^ 6) with hNB
  set FC := supFindCost (sylowPrim hsy) (normalClosurePrim hnc) (groupOrderPrim hord)
    (membershipPrim hmem) n with hFC
  set Fx := supFixCost (sylowConjugatePrim hsc) n with hFx
  have hCe : C = NB + FC + (n + 1) ^ 2 * Fx + 10 ^ 9 * (W + 1) ^ 9 := by
    rw [hC]; rfl
  have hnw := wt_nat_le n
  have hn6 : n + 1 ≤ (n + 1) ^ 6 := Nat.le_self_pow (by norm_num) _
  have dacc := Det.arg' (P := P) (vs := [c, .nat i, acc]) (rest := []) (j := 2) rfl
  have d0 := Det.get' dacc (Det.nat 0) (v := .nat 0) rfl
  refine (sup_ite (R := fun w c' => SupDescInv (gens σR) (gens σN) (i + 1) w ∧
    c' + 1000 * (W + 1) ^ 6 ≤ C) d0 (fun h => absurd rfl h) fun _ => ?_).mono fun w c' h => ?_
  rotate_left
  · obtain ⟨ce, ⟨hI, hce⟩, hc'⟩ := h
    have := sup_desc_wt hI
    have := wt_nat_le 0
    exact ⟨hI, by omega⟩
  -- the group value of `S`
  have dc := Det.arg' (P := P) (vs := [c, .nat i, acc]) (rest := []) (j := 0) rfl
  have dn := Det.get' (Det.get' dc (Det.nat 0) (v := encGroup σR) rfl) (Det.nat 0) (v := .nat n) rfl
  have dsv := Det.get' dacc (Det.nat 1) (v := supSv ss) rfl
  obtain ⟨hs, hsl, hsg, dS, hSw⟩ := rad_mk_det hP.find.step.mg dn dsv
    (⟨ss, rfl, hl, rfl⟩ : GensVal n (supSv ss) (gens ss))
  refine EvalAll.letE dS fun v1 c1 h1 => ?_
  obtain ⟨rfl, hc1⟩ := h1
  -- `S ∩ N`
  have dS1 := Det.var' (P := P) (env := [a, encGroup hs]) (i := 1) (v := encGroup hs) rfl
  have dc' := Det.arg' (P := P) (vs := [c, .nat i, acc]) (rest := [encGroup hs]) (j := 0) rfl
  have dNv := Det.get' dc' (Det.nat 1) (v := encGroup σN) rfl
  have hnorm : GI.Lang.Normalizes (gens hs) (gens σN) := fun x hx y hy =>
    sup_conj_mem hNR (hle (hsg ▸ hx)) hy
  refine EvalAll.letE (normalizedIntersection_call hni hP.ni (Det.mk2 dS1 dNv) ⟨hs, rfl, rfl⟩
    ⟨σN, rfl, rfl⟩ hnorm) fun v2 c2 h2 => ?_
  obtain ⟨hKv, hc2⟩ := h2
  have hv2w := GensVal.wt_le hKv
  have hSNw := wt_list2_le (encGroup hs) (encGroup σN)
  have hNIb := (normalizedIntersectionPrim hni).bound_le
    (show (Val.list [encGroup hs, encGroup σN]).size ≤ 10 ^ 4 * (W + 1) ^ 6 from
      (Val.size_le_wt _).trans (by have := wt_list2_le (encGroup hs) (encGroup σN); omega))
  -- the group value of `K`
  have dn2 := Det.get' (Det.get' (Det.arg' (P := P) (vs := [c, .nat i, acc])
    (rest := [encGroup hs, v2]) (j := 0) rfl) (Det.nat 0) (v := encGroup σR) rfl) (Det.nat 0)
    (v := .nat n) rfl
  obtain ⟨ks, hkl, hkg, dK, hKw⟩ := rad_mk_det hP.find.step.mg dn2
    (Det.var' (P := P) (env := [a, encGroup hs, v2]) (i := 2) (v := v2) rfl) hKv
  rw [hsg] at hkg
  refine EvalAll.letE dK fun v3 c3 h3 => ?_
  obtain ⟨rfl, hc3⟩ := h3
  -- the search
  set env := [a, encGroup hs, v2, encGroup ks] with henv
  have dK3 := Det.var' (P := P) (env := env) (i := 3) (v := encGroup ks) rfl
  refine EvalAll.letE (Ra := fun w cw => SupSearchInv (gens ks) (n + 1) w ∧
      cw ≤ (encGroup ks).wt + 1 + supFindCost (sylowPrim hsy) (normalClosurePrim hnc)
        (groupOrderPrim hord) (membershipPrim hmem) n + 700 * (n + 1) ^ 6 + 1)
    (EvalAll.call_funAll dK3 fun v ca hv => ?_) fun v4 c4 h4 => ?_
  · obtain ⟨rfl, hca⟩ := hv
    exact (supFind_spec hP.find hkl).mono fun w cw h => ⟨h.1, by
      have := sup_search_wt h.1; have := h.2; omega⟩
  obtain ⟨hres, hc4⟩ := h4
  have hv4w := sup_search_wt hres
  set env4 := env ++ [v4] with henv4
  have dres := Det.var' (P := P) (env := env4) (i := 4) (v := v4) rfl
  have dsv4 := Det.get' (Det.arg' (P := P) (vs := [c, .nat i, acc])
    (rest := [encGroup hs, v2, encGroup ks, v4]) (j := 2) rfl) (Det.nat 1) (v := supSv ss) rfl
  rcases hres with ⟨r, rfl, hsv⟩ | ⟨p, ps, rfl, hpl, hp, hpn, hsyl, hnn⟩
  · -- `K` is nilpotent: the flag becomes `1`
    have dt := Det.get' dres (Det.nat 1) (v := .nat 0) rfl
    refine (Det.ite_zero dt (Det.mk2 (Det.nat 1) dsv4)).post fun c' hc' => ⟨⟨ss, hl, hle, hsup,
      Or.inl ⟨rfl, ?_⟩⟩, ?_⟩
    · rw [← hkg]; exact sup_sieve_end hsv
    · have := wt_list2_le (.nat 1) (supSv ss)
      have := wt_list2_le (.nat n) (supSv ss)
      have := wt_list2_le (.nat n) v2
      have := wt_nat_le 1
      have := wt_nat_le 0
      clear dS dK dres dsv4 dt dK3 dS1 dc' dNv dn2 dc dn dsv dacc d0
      omega
  · -- a Sylow subgroup that `K` does not normalize: correct every generator
    have dt := Det.get' dres (Det.nat 1) (v := .nat 1) rfl
    have dk := Det.var' (P := P) (env := env4) (i := 3) (v := encGroup ks) rfl
    have dp := Det.get' dres (Det.nat 2) (v := .nat p) rfl
    have dps := Det.get' dres (Det.nat 3) (v := encGroup ps) rfl
    have dfa := Det.mk2 (Det.mk3 dk dp dps) dsv4
    have hsK : ∀ s ∈ ss, ∀ k ∈ gens ks, s * k * s⁻¹ ∈ gens ks := by
      intro s hs k hk
      rw [hkg] at hk ⊢
      have hs' : s ∈ gens ss := Subgroup.subset_closure hs
      exact ⟨(gens ss).mul_mem ((gens ss).mul_mem hs' hk.1) ((gens ss).inv_mem hs'),
        sup_conj_mem hNR (hle hs') hk.2⟩
    have hmap := map_spec hP.map (c := .list [encGroup ks, .nat p, encGroup ps])
      (xs := ss.map encPerm)
      (R := fun x w => ∀ s, x = encPerm s → ∃ t, w = encPerm t ∧
        (∃ g ∈ gens ks, t = g * s ∧ t ∈ Subgroup.normalizer (gens ps : Set (Perm (Fin n)))))
      (B := fun _ => Fx) (fun x hx => by
        obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hx
        exact (supFix_spec hP.fix hkl hpl hp hpn hsyl s (hsK s hs)).mono fun w cw h => by
          obtain ⟨g, hg, rfl, hgn, hcw⟩ := h
          exact ⟨fun s' hs' => by
            obtain rfl := encPerm_injective hs'
            exact ⟨g * s, rfl, g, hg, rfl, hgn⟩, hcw⟩)
    refine (sup_ite (R := fun w cw => SupDescInv (gens σR) (gens σN) (i + 1) w ∧
      cw ≤ (n + 1) ^ 2 * Fx + 5 * 10 ^ 6 * (W + 1) ^ 8) dt (fun _ => ?_)
      fun h => absurd h one_ne_zero).mono fun w cw h => ?_
    rotate_left
    · obtain ⟨ce, ⟨hI, hce⟩, hcw⟩ := h
      refine ⟨hI, ?_⟩
      have := sup_desc_wt hI
      have := wt_list2_le (.nat n) (supSv ss)
      have := wt_list2_le (.nat n) v2
      have := wt_nat_le 1
      have := wt_nat_le 0
      clear dS dK dres dsv4 dt dK3 dS1 dc' dNv dn2 dc dn dsv dacc d0 dk dp dps dfa hmap
      omega
    refine (EvalAll.mk2_last (Det.nat 0) (EvalAll.call_funAll (Q := fun w cb =>
      ∃ ts : List (Perm (Fin n)), w = supSv ts ∧ ts.length = ss.length ∧
        List.Forall₂ (fun s t => ∃ g ∈ gens ks, t = g * s ∧
          t ∈ Subgroup.normalizer (gens ps : Set (Perm (Fin n)))) ss ts ∧
          cb ≤ (n + 1) ^ 2 * Fx + 4 * 10 ^ 6 * (W + 1) ^ 8)
      dfa fun v ca hv => ?_)).mono fun w cw h => ?_
    · obtain ⟨rfl, hca⟩ := hv
      refine hmap.mono fun w cb h => ?_
      obtain ⟨ws, rfl, h2, hcb⟩ := h
      obtain ⟨ts, rfl, hts⟩ := sup_forall₂_perm h2
      refine ⟨ts, rfl, hts.length_eq.symm, hts, ?_⟩
      have htl : ts.length ≤ n ^ 2 := hts.length_eq ▸ hl
      have hsum : ((ss.map encPerm).map fun _ => Fx).sum ≤ (n + 1) ^ 2 * Fx := by
        rw [List.map_const', List.sum_replicate, smul_eq_mul, List.length_map]
        exact Nat.mul_le_mul_right _ (by nlinarith)
      have htw : (supSv ts).wt ≤ 13 * (n + 1) ^ 6 := wt_list_encPerms_le_sq htl
      have hc4' := wt_list3_le (encGroup ks) (.nat p) (encGroup ps)
      have hPw := wt_encGroup_le_sq hpl
      have hpw := wt_nat_le p
      have h2' := wt_list2_le (.list [encGroup ks, .nat p, encGroup ps]) (supSv ss)
      have hL : mapK * ((ss.map encPerm).length + 1) * ((Val.list [.list [encGroup ks, .nat p,
          encGroup ps], .list (ss.map encPerm)]).wt + (Val.list (ts.map encPerm)).wt + 1) ≤
          3 * 10 ^ 6 * (W + 1) ^ 8 := by
        have e1 : (Val.list (ss.map encPerm)).wt = (supSv ss).wt := rfl
        have e2 : (Val.list (ts.map encPerm)).wt = (supSv ts).wt := rfl
        have hlen : (ss.map encPerm).length + 1 ≤ (W + 1) ^ 2 := by
          rw [List.length_map]
          have : n ^ 2 ≤ (W + 1) ^ 2 := Nat.pow_le_pow_left (by omega) _
          have : n ^ 2 + 1 ≤ (W + 1) ^ 2 := by nlinarith
          omega
        calc _ ≤ mapK * (W + 1) ^ 2 * (3000 * (W + 1) ^ 6) :=
              Nat.mul_le_mul (Nat.mul_le_mul_left _ hlen) (by
                have : (Val.list [Val.list [encGroup ks, .nat p, encGroup ps],
                  .list (ss.map encPerm)]).wt = (Val.list [Val.list [encGroup ks, .nat p,
                    encGroup ps], supSv ss]).wt := rfl
                omega)
          _ = 3 * 10 ^ 6 * (W + 1) ^ 8 := by simp only [mapK]; ring
      have e2 : (Val.list (ts.map encPerm)).wt = (supSv ts).wt := rfl
      have := wt_list3_le (encGroup ks) (.nat p) (encGroup ps)
      have := wt_list2_le (.list [encGroup ks, .nat p, encGroup ps]) (supSv ss)
      have := wt_nat_le 1
