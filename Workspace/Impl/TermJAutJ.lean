import Workspace.Impl.TermJLabHom

/-!
# Generators of `Aut_J(x)`

Proof of Theorem A.23: "It also constructs `Aut_J(x)`: use the local `N*`-stabilizers, the kernel
of the sum map on the product of local stabilizer images, and lifted generators of the even
Young group on equal-type fibers."

Here `Aut_J(X)` is the set of `σ ∈ Aut_{N≀Sym}(X)` with label `1` and even top (`tmJAutJ`; at a
row terminal this is `Aut_{N≀Sym}(X) ⊓ J`, by `tmJJ_iff_lab`). `tmJ_autJ_gens`: it is generated by

* `S₁`: the local generators `(s at a; 1)`, `s` in generators of `Aut_{N*}(x_a)`;
* `S₂`: for `c` in generators of the kernel `{e : ∏_k φ(g_k)^{e_k} = 1}` of the sum map,
  the local product `tmJLam lg c`, where `lg` lists pairs `(a_k, g_k)` with the `g_k` for `a_k = a`
  generating `Aut_N(x_a)`;
* `S₃`: `t₀ t` for lifted transpositions `t` of two different equal-type rows (the even Young
  group; their labels are `1`, so the sum correction is trivial).
-/

namespace GI.Impl

open Equiv Equiv.Perm GI.Multicoset

variable {B : Type} [Nonempty B] {q : ℕ} {N : Subgroup (Perm B)} {A : Type*} [CommGroup A]
  (φ : N →* A)

open Classical in
/-- The top permutation of any permutation (`1` off `N ≀ Sym(q)`). -/
noncomputable def tmJTop (N : Subgroup (Perm B)) (σ : Perm (B × Fin q)) : Perm (Fin q) :=
  if h : σ ∈ tmJW N then tmJTopHom (N := N) ⟨σ, h⟩ else 1

open Classical in
/-- The label of any permutation (`1` off `N ≀ Sym(q)`). -/
noncomputable def tmJLabOf (σ : Perm (B × Fin q)) : A :=
  if h : σ ∈ tmJW N then tmJLabHom φ ⟨σ, h⟩ else 1

variable {φ}

theorem tmJTop_mul {σ τ : Perm (B × Fin q)} (hσ : σ ∈ tmJW N) (hτ : τ ∈ tmJW N) :
    tmJTop N (σ * τ) = tmJTop N σ * tmJTop N τ := by
  unfold tmJTop
  rw [dif_pos ((tmJW N).mul_mem hσ hτ), dif_pos hσ, dif_pos hτ, ← map_mul]
  rfl

theorem tmJTop_inv {σ : Perm (B × Fin q)} (hσ : σ ∈ tmJW N) :
    tmJTop N σ⁻¹ = (tmJTop N σ)⁻¹ := by
  unfold tmJTop
  rw [dif_pos ((tmJW N).inv_mem hσ), dif_pos hσ, ← map_inv]
  rfl

theorem tmJLabOf_mul {σ τ : Perm (B × Fin q)} (hσ : σ ∈ tmJW N) (hτ : τ ∈ tmJW N) :
    tmJLabOf φ (σ * τ) = tmJLabOf φ σ * tmJLabOf φ τ := by
  unfold tmJLabOf
  rw [dif_pos ((tmJW N).mul_mem hσ hτ), dif_pos hσ, dif_pos hτ, ← map_mul]
  rfl

theorem tmJLabOf_inv {σ : Perm (B × Fin q)} (hσ : σ ∈ tmJW N) :
    tmJLabOf φ σ⁻¹ = (tmJLabOf φ σ)⁻¹ := by
  unfold tmJLabOf
  rw [dif_pos ((tmJW N).inv_mem hσ), dif_pos hσ, ← map_inv]
  rfl

theorem tmJTop_tmJP {p : (Fin q → Perm B) × Perm (Fin q)} (hp : ∀ i, p.1 i ∈ N) :
    tmJTop N (tmJP p) = p.2 := by
  unfold tmJTop
  rw [dif_pos ⟨p, hp, rfl⟩]
  exact tmJTopHom_tmJP hp

theorem tmJLabOf_tmJP {p : (Fin q → Perm B) × Perm (Fin q)} (hp : ∀ i, p.1 i ∈ N) :
    tmJLabOf φ (tmJP p) = tmJLab N φ p.1 := by
  unfold tmJLabOf
  rw [dif_pos ⟨p, hp, rfl⟩]
  exact tmJLabHom_tmJP φ hp

omit [Nonempty B] in
/-- A pair with trivial top whose coordinates lie in the closures of `gs a` is a product of the
local generators. -/
theorem tmJ_pi_mem (gs : Fin q → Set (Perm B)) {d : Fin q → Perm B}
    (hd : ∀ a, d a ∈ Subgroup.closure (gs a)) :
    tmJP (d, 1) ∈ Subgroup.closure {σ | ∃ a, ∃ s ∈ gs a, σ = tmJLoc a s} := by
  set Gen := {σ | ∃ a, ∃ s ∈ gs a, σ = tmJLoc (B := B) a s}
  let ψ : (Fin q → Perm B) →* Perm (B × Fin q) :=
    { toFun := fun d => tmJP (d⁻¹, 1)
      map_one' := by simpa using tmJP_one (B := B) (q := q)
      map_mul' := fun d d' => by
        rw [tmJP_mul]; congr 1 }
  have hle : Subgroup.pi Set.univ (fun i => Subgroup.closure (gs i)) ≤
      (Subgroup.closure Gen).comap ψ := by
    rw [Subgroup.pi_le_iff]
    intro i
    rw [MonoidHom.map_closure, Subgroup.closure_le]
    rintro _ ⟨g, hg, rfl⟩
    change ψ (Pi.mulSingle i g) ∈ Subgroup.closure Gen
    have hgen : tmJLoc i g ∈ Subgroup.closure Gen :=
      Subgroup.subset_closure ⟨i, g, hg, rfl⟩
    have : ψ (Pi.mulSingle i g) = (tmJLoc i g)⁻¹ := by
      change tmJP ((Pi.mulSingle i g)⁻¹, 1) = (tmJP (Pi.mulSingle i g, 1))⁻¹
      rw [tmJP_inv]; congr 1
    rw [this]; exact Subgroup.inv_mem _ hgen
  have hd' : d⁻¹ ∈ Subgroup.pi Set.univ (fun i => Subgroup.closure (gs i)) :=
    fun i _ => Subgroup.inv_mem _ (hd i)
  have := Subgroup.mem_comap.1 (hle hd')
  change tmJP ((d⁻¹)⁻¹, 1) ∈ _ at this
  rwa [inv_inv] at this

/-- **The tops come from the transpositions.** If `L₀` has trivial tops, every element of
`⟨L₀, T⟩` has the top of an element of `⟨T⟩`. -/
theorem tmJ_top_match {L0 T : Set (Perm (B × Fin q))}
    (h0 : ∀ σ ∈ L0, σ ∈ tmJW N ∧ tmJTop N σ = 1) (hT : ∀ σ ∈ T, σ ∈ tmJW N) {σ : Perm (B × Fin q)}
    (hσ : σ ∈ Subgroup.closure (L0 ∪ T)) :
    ∃ w ∈ Subgroup.closure T, tmJTop N w = tmJTop N σ := by
  have hTW : Subgroup.closure T ≤ tmJW N := (Subgroup.closure_le _).2 fun σ h => hT σ h
  have hW : Subgroup.closure (L0 ∪ T) ≤ tmJW N :=
    (Subgroup.closure_le _).2 (Set.union_subset (fun σ h => (h0 σ h).1) fun σ h => hT σ h)
  induction hσ using Subgroup.closure_induction with
  | mem σ h =>
    rcases h with h | h
    · refine ⟨1, Subgroup.one_mem _, ?_⟩
      rw [(h0 σ h).2, tmJTop, dif_pos (tmJW N).one_mem]; exact map_one _
    · exact ⟨σ, Subgroup.subset_closure h, rfl⟩
  | one => exact ⟨1, Subgroup.one_mem _, rfl⟩
  | mul σ τ hσ hτ ihσ ihτ =>
    obtain ⟨w, hw, e⟩ := ihσ
    obtain ⟨w', hw', e'⟩ := ihτ
    refine ⟨w * w', Subgroup.mul_mem _ hw hw', ?_⟩
    rw [tmJTop_mul (hTW hw) (hTW hw'), tmJTop_mul (hW hσ) (hW hτ), e, e']
  | inv σ hσ ih =>
    obtain ⟨w, hw, e⟩ := ih
    refine ⟨w⁻¹, Subgroup.inv_mem _ hw, ?_⟩
    rw [tmJTop_inv (hTW hw), tmJTop_inv (hW hσ), e]

/-! ### Lifted transpositions of two different rows -/

omit [Nonempty B] in
theorem tmJSwD_mem {a a' : Fin q} {b : Perm B} (hb : b ∈ N) (i : Fin q) : tmJSwD a a' b i ∈ N := by
  unfold tmJSwD
  rw [Function.update_apply]
  split_ifs
  · exact N.inv_mem hb
  · by_cases hi : i = a
    · subst hi; simpa using hb
    · rw [Pi.mulSingle_eq_of_ne hi]; exact N.one_mem

omit [Nonempty B] in
theorem tmJSw_mem {a a' : Fin q} {b : Perm B} (hb : b ∈ N) : tmJSw a a' b ∈ tmJW N :=
  ⟨_, tmJSwD_mem hb, rfl⟩

omit [Nonempty B] in
theorem tmJSw_sq {a a' : Fin q} (haa : a ≠ a') (b : Perm B) :
    tmJSw a a' b * tmJSw a a' b = 1 := by
  unfold tmJSw
  rw [tmJP_mul, ← tmJP_one]
  congr 1
  simp only [swap_mul_self, Prod.mk.injEq, and_true]
  funext i
  simp only [Pi.one_apply, tmJSwD]
  by_cases h1 : i = a'
  · subst h1
    rw [swap_apply_right, Function.update_self, Function.update_of_ne haa, Pi.mulSingle_eq_same,
      inv_mul_cancel]
  · by_cases h2 : i = a
    · subst h2
      rw [swap_apply_left, Function.update_self, Function.update_of_ne h1, Pi.mulSingle_eq_same,
        mul_inv_cancel]
    · rw [swap_apply_of_ne_of_ne h2 h1, Function.update_of_ne h1, Pi.mulSingle_eq_of_ne h2,
        one_mul]

theorem tmJTop_sw {a a' : Fin q} {b : Perm B} (hb : b ∈ N) :
    tmJTop N (tmJSw a a' b) = swap a a' :=
  tmJTop_tmJP (p := (tmJSwD a a' b, swap a a')) (tmJSwD_mem hb)

theorem tmJLabOf_sw {a a' : Fin q} (haa : a ≠ a') {b : Perm B} (hb : b ∈ N) :
    tmJLabOf φ (tmJSw a a' b) = 1 := by
  rw [tmJSw, tmJLabOf_tmJP (p := (tmJSwD a a' b, swap a a')) (tmJSwD_mem hb)]
  exact tmJLab_sw haa hb

/-- **The even part of the group of lifted transpositions.** -/
theorem tmJ_even_part {Tl : List (Fin q × Fin q × Perm B)}
    (hTl : ∀ t ∈ Tl, t.1 ≠ t.2.1 ∧ t.2.2 ∈ N) {t0 : Fin q × Fin q × Perm B} (ht0 : t0 ∈ Tl)
    {w : Perm (B × Fin q)} (hw : w ∈ Subgroup.closure {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2})
    (hs : sign (tmJTop N w) = 1) :
    w ∈ Subgroup.closure {σ | ∃ t ∈ Tl,
      σ = tmJSw t0.1 t0.2.1 t0.2.2 * tmJSw t.1 t.2.1 t.2.2} := by
  classical
  -- work in the subgroup `N ≀ Sym(q)`
  let χ : tmJW (q := q) N →* ℤˣ := Perm.sign.comp tmJTopHom
  let sw : Fin q × Fin q × Perm B → tmJW (q := q) N := fun t =>
    if h : t.2.2 ∈ N then ⟨tmJSw t.1 t.2.1 t.2.2, tmJSw_mem h⟩ else 1
  have hsw : ∀ t ∈ Tl, ((sw t : tmJW (q := q) N) : Perm (B × Fin q)) = tmJSw t.1 t.2.1 t.2.2 :=
    fun t ht => by simp only [sw, dif_pos (hTl t ht).2]
  have hS : ∀ s ∈ Tl.map sw, s * s = 1 ∧ χ s = -1 := by
    intro s hs
    obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hs
    refine ⟨Subtype.ext ?_, ?_⟩
    · change (sw t : Perm (B × Fin q)) * sw t = 1
      rw [hsw t ht]; exact tmJSw_sq (hTl t ht).1 _
    · change sign (tmJTopHom (sw t)) = -1
      have := tmJTop_sw (a := t.1) (a' := t.2.1) (hTl t ht).2
      rw [tmJTop, dif_pos (tmJSw_mem (hTl t ht).2)] at this
      have e : sw t = ⟨tmJSw t.1 t.2.1 t.2.2, tmJSw_mem (hTl t ht).2⟩ := Subtype.ext (hsw t ht)
      rw [e, this, sign_swap (hTl t ht).1]
  have hE := tmJ_even_gens χ (List.mem_map_of_mem ht0) hS
  have hmap : ∀ (U : Set (tmJW (q := q) N)),
      (Subgroup.closure U).map (tmJW N).subtype = Subgroup.closure ((tmJW N).subtype '' U) :=
    fun U => MonoidHom.map_closure _ _
  have e1 : (tmJW N).subtype '' {s | s ∈ Tl.map sw} =
      {σ | ∃ t ∈ Tl, σ = tmJSw t.1 t.2.1 t.2.2} := by
    ext σ
    simp only [Set.mem_image, Set.mem_setOf_eq, List.mem_map, Subgroup.coe_subtype]
    constructor
    · rintro ⟨_, ⟨t, ht, rfl⟩, rfl⟩; exact ⟨t, ht, (hsw t ht)⟩
    · rintro ⟨t, ht, rfl⟩; exact ⟨sw t, ⟨t, ht, rfl⟩, hsw t ht⟩
  have e2 : (tmJW N).subtype '' {g | ∃ s ∈ Tl.map sw, g = sw t0 * s} =
      {σ | ∃ t ∈ Tl, σ = tmJSw t0.1 t0.2.1 t0.2.2 * tmJSw t.1 t.2.1 t.2.2} := by
    ext σ
    simp only [Set.mem_image, Set.mem_setOf_eq, List.mem_map, Subgroup.coe_subtype]
    constructor
    · rintro ⟨_, ⟨s, ⟨t, ht, rfl⟩, rfl⟩, rfl⟩
      refine ⟨t, ht, ?_⟩
      rw [Subgroup.coe_mul, hsw t ht, hsw t0 ht0]
    · rintro ⟨t, ht, rfl⟩
      exact ⟨sw t0 * sw t, ⟨sw t, ⟨t, ht, rfl⟩, rfl⟩, by rw [Subgroup.coe_mul, hsw t0 ht0, hsw t ht]⟩
  rw [← e1, ← hmap] at hw
  obtain ⟨w', hw', rfl⟩ := hw
  rw [← e2, ← hmap]
  refine ⟨w', ?_, rfl⟩
  rw [hE]
  refine ⟨hw', ?_⟩
  change sign (tmJTopHom w') = 1
  have : tmJTop N (w' : Perm (B × Fin q)) = tmJTopHom w' := by
    rw [tmJTop, dif_pos w'.2]
  rw [← this]; exact hs

end GI.Impl
