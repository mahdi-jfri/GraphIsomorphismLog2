import Workspace.Impl.AggGraph
import Workspace.Impl.GenChild
import Workspace.Impl.SmallInv
import Mathlib.Algebra.Order.Floor.Semifield

/-!
# `LiftAndContinue` of an aggregation round: the mathematics

An overcoset of the round is `(ρ(σ), π⁻¹(E₀))` for a label permutation `σ ∈ Alt(q)` and a subgroup
`E₀ ≤ Alt(q)` (`Aggregation.overs_cap`). `LiftAndContinue` continues under `π⁻¹(E₀)` on
`(x, y ∘ τ)` for an element `τ` of the overcoset, and keeps the parent's bookkeeping, with the
cap of the selected interval lowered to `min(c, ⌊βq⌋)` (`Aggregation.newHier`).

This file has the facts the program needs, for a graph-form generating list `ps` of `G`
(`PairGens e L S.G ps`):

* `lc_hms`: every even label permutation is the label part of a pair of the graph of `G` (the
  precondition of the preimage call and of the label lift);
* `lc_groupFin`: the first parts of the preimage call's output generate `π⁻¹(E₀)` on positions;
* `lc_tau_mem`: a lift `a` of `σ` (with `(a, σ)` in the graph group) gives an element
  `τ = e⁻¹ a` of the overcoset;
* `lcHier`: the new hierarchy, equal to `newHier` (`lcHier_eq_newHier`);
* `lc_keep`: the continuation group keeps the carrier of the retained rows, so the child
  `lcChild` has the parent's bookkeeping (`lcChild_book`);
* `canon_lcChild`: the child value is canonical, with `SmallInv` from the parent
  (`SmallInv.capUpdate`).
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Cited (Val encPerm encGroup gens)
open scoped Pointwise

variable {Ω C : Type} {k : ℕ}

section Graph

variable {e : Ω ≃ Fin k} {S : State Ω C} {L : GiantLabels S}

/-- **Every even label permutation is the label part of a pair of the graph of `G`**, since `π`
maps `G` onto `Alt(q)`. -/
theorem lc_hms {ps : List (Perm (Fin k) × Perm (Fin L.q))} (hps : PairGens e L S.G ps)
    {m : Perm (Fin L.q)} (hm : m ∈ alternatingGroup (Fin L.q)) :
    ∃ p ∈ Subgroup.closure {p | p ∈ ps}, MonoidHom.snd _ _ p = m := by
  obtain ⟨g, hg⟩ := L.π_surj ⟨m, hm⟩
  refine ⟨(toFin e g, m), ?_, rfl⟩
  rw [hps, mem_graphOf]
  exact ⟨g, g.2, g.2, rfl, by rw [hg]⟩

/-- The preimage in `G` of the even subgroup generated by `ms` is the lift of `E₀`. -/
theorem labPre_eq_lift {E₀ : Subgroup (alternatingGroup (Fin L.q))} {ms : List (Perm (Fin L.q))}
    (hms : gens ms = E₀.map (alternatingGroup (Fin L.q)).subtype) :
    S.G ⊓ labPre (L := L) (gens ms) = L.lift E₀ := by
  ext g
  rw [Subgroup.mem_inf, L.mem_lift, hms]
  constructor
  · rintro ⟨hg, hg', hm⟩
    refine ⟨hg, ?_⟩
    obtain ⟨x, hx, hxe⟩ := Subgroup.mem_map.1 hm
    have : x = L.π ⟨g, hg'⟩ := Subtype.ext hxe
    rw [← this]; exact hx
  · rintro ⟨hg, hE⟩
    exact ⟨hg, hg, Subgroup.mem_map.2 ⟨_, hE, rfl⟩⟩

/-- **The first parts of the preimage output generate the lift of `E₀`** on positions. -/
theorem lc_groupFin {ps qs : List (Perm (Fin k) × Perm (Fin L.q))} (hps : PairGens e L S.G ps)
    {E₀ : Subgroup (alternatingGroup (Fin L.q))} {ms : List (Perm (Fin L.q))}
    (hms : gens ms = E₀.map (alternatingGroup (Fin L.q)).subtype)
    (hqs : Subgroup.closure {p | p ∈ qs} =
      Subgroup.closure {p | p ∈ ps} ⊓ (gens ms).comap (MonoidHom.snd _ _)) :
    gens (qs.map Prod.fst) = groupFin e (L.lift E₀) := by
  have hq : PairGens e L (L.lift E₀) qs := by
    unfold PairGens
    rw [hqs, hps, ← labPre_eq_lift hms, graphOf_inf_labPre]
  ext a
  rw [mem_gens_fst hq a]
  constructor
  · rintro ⟨g, -, hg, rfl⟩
    exact ⟨g, hg, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨g, L.lift_le E₀ hg, hg, rfl⟩

/-- **A lift of `σ` lies in the overcoset** `ρ(σ) π⁻¹(E₀)`. -/
theorem lc_tau_mem {ps : List (Perm (Fin k) × Perm (Fin L.q))} (hps : PairGens e L S.G ps)
    (σ : alternatingGroup (Fin L.q)) (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    {a : Perm (Fin k)} (ha : (a, (σ : Perm (Fin L.q))) ∈ Subgroup.closure {p | p ∈ ps}) :
    (toFin e).symm a ∈ L.rep σ • (L.lift E₀ : Set (Perm Ω)) := by
  rw [hps, mem_graphOf] at ha
  obtain ⟨g, hg, -, h1, h2⟩ := ha
  have h1' : toFin e g = a := h1
  have hga : (toFin e).symm a = g := by rw [← h1', MulEquiv.symm_apply_apply]
  rw [hga]
  refine ⟨(L.rep σ)⁻¹ * g, ?_, by simp [smul_eq_mul]⟩
  have hr := L.rep_mem σ
  have hm : (L.rep σ)⁻¹ * g ∈ S.G := S.G.mul_mem (S.G.inv_mem hr) hg
  refine (L.mem_lift).2 ⟨hm, ?_⟩
  have e1 : (⟨(L.rep σ)⁻¹ * g, hm⟩ : S.G) = (⟨L.rep σ, hr⟩ : S.G)⁻¹ * ⟨g, hg⟩ := rfl
  have e2 : L.π ⟨g, hg⟩ = σ := Subtype.ext h2
  rw [e1, map_mul, map_inv, L.π_rep, e2, inv_mul_cancel]
  exact E₀.one_mem

end Graph

/-! ### The child -/

section Child

variable (S : State Ω C)

/-- **The hierarchy of a continuation**: the cap of interval `i` lowered to `min(cap, c)`. -/
def lcHier (i : ℕ) (c : ℕ) : List (Interval Ω) :=
  if h : i < S.hier.length then S.hier.set i { S.hier[i] with cap := min S.hier[i].cap c }
  else S.hier

theorem lcHier_eq_newHier {P : Params} {L : GiantLabels S} (I : Aggregation P S L)
    (o : Perm Ω × Subgroup (Perm Ω)) : lcHier S I.sel ⌊P.β * L.q⌋₊ = I.newHier o := by
  simp [lcHier, Aggregation.newHier, I.sel.2]

/-- The cap of the selected interval for `β = 9/10`: `⌊9q/10⌋ = 9q / 10`. -/
theorem lc_floor (q : ℕ) : ⌊(9 / 10 : ℝ) * q⌋₊ = 9 * q / 10 := by
  rw [show (9 / 10 : ℝ) * q = ((9 * q : ℕ) : ℝ) / ((10 : ℕ) : ℝ) by push_cast; ring]
  exact Nat.floor_div_eq_div _ _

theorem lcHier_modify (i c : ℕ) :
    lcHier S i c = S.hier.modify i fun I => { I with cap := min I.cap c } := by
  unfold lcHier
  split_ifs with h
  · refine List.ext_getElem (by simp) fun j h1 h2 => ?_
    rw [List.getElem_set, List.getElem_modify]
    split_ifs <;> simp_all
  · rw [List.modify_eq_self (by omega)]

/-- **The continuation group keeps the carrier** of the retained rows: `π⁻¹(E₀)` contains every
element of `G` that fixes the retained columns (`Constituent.kills`), and the cap update keeps
the partitions (`map_part_set_cap`). -/
theorem lc_keep {L : GiantLabels S} (con : L.Constituent) (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    (i c : ℕ) : CarrierOK (L.lift E₀) S.dom S.rows (lcHier S i c) := by
  refine S.carrier.mono (L.lift_le E₀) (fun R c' hR hc g hg hf => ?_) fun c' h => h.of_parts ?_
  · refine L.mem_lift.2 ⟨hg, ?_⟩
    rw [con.kills R c' hR hc ⟨g, hg⟩ hf]
    exact E₀.one_mem
  · unfold lcHier
    split_ifs with h
    · exact map_part_set_cap _ _ h _
    · rfl

/-- **The child of a continuation** on the overcoset with group `π⁻¹(E₀)`, representative `τ`
and hierarchy `lcHier S i c`. -/
noncomputable def lcChild {L : GiantLabels S} (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    (τ : Perm Ω) (i c : ℕ) : State Ω C :=
  S.restrict (L.lift E₀) (L.lift_le E₀) S.x (S.y ∘ τ) (lcHier S i c)

theorem lcChild_book {L : GiantLabels S} (con : L.Constituent)
    (E₀ : Subgroup (alternatingGroup (Fin L.q))) (τ : Perm Ω) (i c : ℕ) :
    (lcChild S E₀ τ i c).book = S.book := by
  have hk := lc_keep S con E₀ i c
  simp only [lcChild, State.book, State.restrict_rows_of _ _ _ _ _ _ hk,
    State.restrict_floor_of _ _ _ _ _ _ hk, State.restrict_h_of _ _ _ _ _ _ hk]

theorem lcChild_inst {L : GiantLabels S} (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    (τ : Perm Ω) (i c : ℕ) : (lcChild S E₀ τ i c).Inst (L.lift E₀) S.dom S.x (S.y ∘ τ) :=
  ⟨rfl, rfl, rfl, rfl⟩

theorem lcChild_N {L : GiantLabels S} (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    (τ : Perm Ω) (i c : ℕ) : (lcChild S E₀ τ i c).N = S.N := rfl

theorem lcChild_hier {L : GiantLabels S} (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    (τ : Perm Ω) (i c : ℕ) : (lcChild S E₀ τ i c).hier = lcHier S i c := rfl

end Child

/-! ### The value of the new hierarchy -/

theorem lcForall₂_set {α β : Type*} {R : α → β → Prop} :
    ∀ {l₁ : List α} {l₂ : List β}, List.Forall₂ R l₁ l₂ → ∀ (i : ℕ) {a : α} {b : β}, R a b →
      List.Forall₂ R (l₁.set i a) (l₂.set i b)
  | [], [], .nil, _, _, _, _ => .nil
  | _ :: _, _ :: _, .cons _ t, 0, _, _, hab => .cons hab t
  | _ :: _, _ :: _, .cons h t, i + 1, _, _, hab => .cons h (lcForall₂_set t i hab)

/-- The entry of the new hierarchy. -/
theorem lc_intervalVal {e : Ω ≃ Fin k} {v : Val} {I : Interval Ω} (h : IntervalValC e v I)
    (c : ℕ) : ∃ pv, v = .list [pv, .nat I.ratio, .nat I.cap, .nat I.origin] ∧
      IntervalValC e (.list [pv, .nat I.ratio, .nat (I.cap - (I.cap - c)), .nat I.origin])
        { I with cap := min I.cap c } := by
  obtain ⟨pv, hp, rfl⟩ := h
  refine ⟨pv, rfl, pv, hp, ?_⟩
  rw [Nat.sub_sub_eq_min]

/-- **The value of the new hierarchy**: the entry `i` of the hierarchy value replaced. -/
theorem hierValC_lcHier {e : Ω ≃ Fin k} {S : State Ω C} {vs : List Val}
    (h : HierValC e (.list vs) S.hier) {i : ℕ} (hi : i < S.hier.length) (c : ℕ) {w : Val}
    (hw : IntervalValC e w { S.hier[i] with cap := min S.hier[i].cap c }) :
    HierValC e (.list (vs.set i w)) (lcHier S i c) := by
  obtain ⟨vs', hv, h2⟩ := h
  cases hv
  refine ⟨_, rfl, ?_⟩
  simp only [lcHier, dif_pos hi]
  exact lcForall₂_set h2 i hw

/-- **The child value is canonical.** -/
theorem canon_lcChild {e : Ω ≃ Fin k} {c : C → ℕ} {gv dv xv yv hv rv fv hh : Val} {N : ℕ}
    {S : State Ω C} (hcan : Canon e c (.list [.nat k, gv, dv, xv, yv, hv, rv, fv, hh, .nat N]) S)
    {L : GiantLabels S} (con : L.Constituent) (E₀ : Subgroup (alternatingGroup (Fin L.q)))
    (τ : Perm Ω) (i cap : ℕ) {gv' yv' hv' : Val}
    (hg : GroupValC k gv' (groupFin e (L.lift E₀))) (hy : ColorVal e c yv' (S.y ∘ τ))
    (hhv : HierValC e hv' (lcHier S i cap)) :
    Canon e c (dispChildVal k gv' dv xv yv' hv' rv fv hh N) (lcChild S E₀ τ i cap) := by
  obtain ⟨gv0, dv0, xv0, yv0, hv0, rv0, -, hd, hx, -, -, hr, heq⟩ := hcan.val
  simp only [Val.list.injEq, List.cons.injEq] at heq
  obtain ⟨-, -, rfl, rfl, -, -, rfl, rfl, rfl, hNe, -⟩ := heq
  have hbk := lcChild_book S con E₀ τ i cap
  have hrows : (lcChild S E₀ τ i cap).rows = S.rows := congrArg Prod.fst hbk
  have hfl : (lcChild S E₀ τ i cap).floor = S.floor := congrArg (fun b => b.2.1) hbk
  have hhT : (lcChild S E₀ τ i cap).h = S.h := congrArg (fun b => b.2.2) hbk
  refine ⟨⟨gv', dv, xv, yv', hv', rv, hg, hd, hx, hy, hhv, hrows ▸ hr, ?_⟩,
    fun a => ⟨(hcan.colors a).1, (hcan.colors (τ a)).2⟩, hcan.fits, ?_⟩
  · simp only [dispChildVal, hfl, hhT, hNe]; rfl
  · refine hcan.small.capUpdate rfl i (min ((S.hier[i]?).elim 0 Interval.cap) cap) ?_ ?_ ?_
    · exact min_le_left _ _
    · rw [lcChild_hier, lcHier_modify]
      refine List.ext_getElem (by simp) fun j h1 h2 => ?_
      simp only [List.getElem_modify]
      split_ifs with hij
      · subst hij
        simp [List.getElem?_eq_getElem (by simpa using h1)]
      · rfl
    · intro R hR
      rw [hrows] at hR
      exact hcan.small.2.2 R hR

end GI.Impl
