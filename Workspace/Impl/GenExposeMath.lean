@[expose] public section

/-!
# Exposure as a program: the mathematics

The exposure program (`Workspace/Impl/GenExpose.lean`) numbers the classes of a partition of the
domain by its own rule, and computes the action of the generators on these numbers. This file
has the facts it needs about such numberings.

* `numEquiv`: two numberings of the same classes differ by a bijection of the numbers.
* `PrimitiveQuotient.relabel`: a primitive quotient with its blocks renumbered. The hierarchy is
  unchanged, so the program may use its own block numbering (`relabel_blk`, `relabel_rho`).
* `classRho`: the action of `G` on the classes of an invariant partition of the domain, through
  any numbering of the classes (`classRho_apply`).
* `range_eq_gens`: the image of a group given by generators is generated by the images of the
  generators. The program computes exactly these images.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Cited (Val gens)

variable {Ω C : Type} {k : ℕ}

/-! ### Two numberings of the same classes -/

/-- **Two numberings of the same classes differ by a bijection.** If `b₁, b₂` are onto from `D`
and have the same fibers on `D`, there is `σ` with `σ (b₁ v) = b₂ v` on `D`. -/
theorem exists_numEquiv {D : Set Ω} {d₁ d₂ : ℕ} (b₁ : Ω → Fin d₁) (b₂ : Ω → Fin d₂)
    (h₁ : ∀ i, ∃ v ∈ D, b₁ v = i) (h₂ : ∀ i, ∃ v ∈ D, b₂ v = i)
    (hb : ∀ v ∈ D, ∀ w ∈ D, b₁ v = b₁ w ↔ b₂ v = b₂ w) :
    ∃ σ : Fin d₁ ≃ Fin d₂, ∀ v ∈ D, σ (b₁ v) = b₂ v := by
  classical
  choose p hpD hp using h₁
  let f : Fin d₁ → Fin d₂ := fun i => b₂ (p i)
  have hf : ∀ v ∈ D, f (b₁ v) = b₂ v := fun v hv =>
    (hb _ (hpD _) v hv).1 (hp _)
  have hinj : Function.Injective f := by
    intro i j hij
    rw [← hp i, ← hp j]
    exact (hb _ (hpD _) _ (hpD _)).2 hij
  have hsurj : Function.Surjective f := by
    intro j
    obtain ⟨v, hv, rfl⟩ := h₂ j
    exact ⟨b₁ v, hf v hv⟩
  exact ⟨Equiv.ofBijective f ⟨hinj, hsurj⟩, hf⟩

/-! ### Renumbering the blocks of a primitive quotient -/

namespace PrimitiveQuotientR

variable {S : State Ω C} (Q : PrimitiveQuotient S)

/-- The block action conjugated by a renumbering. -/
noncomputable def conjRho {d' : ℕ} (σ : Fin Q.d ≃ Fin d') : S.G →* Perm (Fin d') :=
  σ.permCongrHom.toMonoidHom.comp Q.ρ

theorem conjRho_apply {d' : ℕ} (σ : Fin Q.d ≃ Fin d') (g : S.G) (i : Fin Q.d) :
    conjRho Q σ g (σ i) = σ (Q.ρ g i) := by
  simp [conjRho, Equiv.permCongrHom, Equiv.permCongr_apply]

end PrimitiveQuotientR

end GI.Impl

namespace GI.Algorithm.PrimitiveQuotient

open GI.Impl
variable {Ω C : Type}
variable {S : State Ω C} (Q : PrimitiveQuotient S)

/-- **A primitive quotient with renumbered blocks** (`σ`, with `b v = σ (Q.blk v)` on the
domain). The hierarchy is that of `Q`. -/
noncomputable def relabelBy {d' : ℕ} (σ : Fin Q.d ≃ Fin d') (b : Ω → Fin d')
    (hb : ∀ v ∈ S.dom, σ (Q.blk v) = b v) : PrimitiveQuotient S where
  d := d'
  blk := b
  ρ := PrimitiveQuotientR.conjRho Q σ
  equivariant g v hv := by
    rw [← hb v hv, PrimitiveQuotientR.conjRho_apply, ← Q.equivariant g v hv,
      hb _ ((S.dom_inv g.1 g.2 v).2 hv)]
  onto i := by
    obtain ⟨v, hv, hvi⟩ := Q.onto (σ.symm i)
    exact ⟨v, hv, by rw [← hb v hv, hvi, Equiv.apply_symm_apply]⟩
  primitive := by
    haveI := Q.primitive
    let φ : Q.ρ.range → (PrimitiveQuotientR.conjRho Q σ).range := fun x =>
      ⟨σ.permCongrHom x.1, by
        obtain ⟨g, hg⟩ := x.2
        exact ⟨g, by rw [← hg]; rfl⟩⟩
    let f : Fin Q.d →ₑ[φ] Fin d' :=
      { toFun := σ
        map_smul' := fun x i => by
          show σ (x.1 i) = (σ.permCongrHom x.1) (σ i)
          simp [Equiv.permCongrHom, Equiv.permCongr_apply] }
    have hφ : Function.Surjective φ := by
      rintro ⟨y, g, rfl⟩
      exact ⟨⟨Q.ρ g, g, rfl⟩, rfl⟩
    exact (MulAction.isPreprimitive_congr hφ (f := f) σ.bijective).1 Q.primitive
  two_le := by
    have := Q.two_le
    have := Fintype.card_congr σ
    simp only [Fintype.card_fin] at this
    omega
  pre := Q.pre
  top := Q.top
  post := Q.post
  rho_le := Q.rho_le
  Q_le := Q.Q_le
  drop := Q.drop
  ratio_eq := by
    rw [Q.ratio_eq]
    have := Fintype.card_congr σ
    simpa only [Fintype.card_fin] using this
  fine_eq v hv w hw := by
    rw [Q.fine_eq v hv w hw, ← hb v hv, ← hb w hw, σ.apply_eq_iff_eq]
  top_univ := Q.top_univ
  tower := Q.tower
  from_old := Q.from_old

/-- **A primitive quotient with its blocks numbered by `b`**, any map onto the numbers whose
fibers on the domain are the blocks. -/
theorem exists_relabel {d' : ℕ} (b : Ω → Fin d') (honto : ∀ i, ∃ v ∈ S.dom, b v = i)
    (hb : ∀ v ∈ S.dom, ∀ w ∈ S.dom, b v = b w ↔ Q.blk v = Q.blk w) :
    ∃ Q' : PrimitiveQuotient S, Q'.d = d' ∧ (∀ v ∈ S.dom, (Q'.blk v : ℕ) = b v) ∧
      Q'.pre = Q.pre ∧ Q'.top = Q.top ∧ Q'.post = Q.post ∧
      (∀ v ∈ S.dom, ∀ w ∈ S.dom, Q'.blk v = Q'.blk w ↔ Q.blk v = Q.blk w) ∧
      (Q.KillsCols → Q'.KillsCols) ∧ (Q.KeepsLevels → Q'.KeepsLevels) ∧
      (Q.AboveCols → Q'.AboveCols) := by
  obtain ⟨σ, hσ⟩ := exists_numEquiv Q.blk b Q.onto honto fun v hv w hw => (hb v hv w hw).symm
  refine ⟨Q.relabelBy σ b hσ, rfl, fun _ _ => rfl, rfl, rfl, rfl, hb, ?_, fun h => h, ?_⟩
  · intro hk R c hR hc g hg
    have h1 := hk R c hR hc g hg
    show PrimitiveQuotientR.conjRho Q σ g = 1
    simp only [PrimitiveQuotientR.conjRho, MonoidHom.comp_apply, h1, map_one]
  · intro hA c hc hcc v hv w hw hvw
    show b v = b w
    rw [← hσ v hv, ← hσ w hw, hA c hc hcc v hv w hw hvw]

end GI.Algorithm.PrimitiveQuotient

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Cited (Val gens)

variable {Ω C : Type} {k : ℕ}

/-! ### The action on numbered classes -/

/-- **The action of `G` on the classes of an invariant partition**, through a numbering `b` of
the classes on the domain. -/
theorem exists_classRho (S : State Ω C) (M : Setoid Ω)
    (hM : ∀ g ∈ S.G, ∀ v ∈ S.dom, ∀ w ∈ S.dom, M.r (g v) (g w) ↔ M.r v w) {d : ℕ}
    (b : Ω → Fin d) (honto : ∀ i, ∃ v ∈ S.dom, b v = i)
    (hb : ∀ v ∈ S.dom, ∀ w ∈ S.dom, b v = b w ↔ M.r v w) :
    ∃ ρ : S.G →* Perm (Fin d), ∀ g : S.G, ∀ v ∈ S.dom, ρ g (b v) = b ((g : Perm Ω) v) := by
  let τ : BlockT S M → Fin d := Quotient.lift (fun v : S.dom => b v.1)
    (fun v w h => (hb v.1 v.2 w.1 w.2).2 h)
  have hτ : Function.Bijective τ := by
    refine ⟨fun x y hxy => ?_, fun i => ?_⟩
    · induction x using Quotient.inductionOn with
      | h v =>
      induction y using Quotient.inductionOn with
      | h w =>
      exact Quotient.sound ((hb v.1 v.2 w.1 w.2).1 hxy)
    · obtain ⟨v, hv, rfl⟩ := honto i
      exact ⟨Quotient.mk _ ⟨v, hv⟩, rfl⟩
  let τe := Equiv.ofBijective τ hτ
  refine ⟨τe.permCongrHom.toMonoidHom.comp (stateBlockHom S M hM), fun g v hv => ?_⟩
  have h1 : τe.symm (b v) = Quotient.mk _ ⟨v, hv⟩ := by
    rw [Equiv.symm_apply_eq]; rfl
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Equiv.permCongrHom,
    MulEquiv.coe_mk, Equiv.permCongr_apply, h1, stateBlockHom_mk]
  rfl

/-- A permutation of `Fin k`, read through `e`, under a homomorphism on `S.G` (`1` off `S.G`). -/
noncomputable def homFin (e : Ω ≃ Fin k) {G : Subgroup (Perm Ω)} {d : ℕ}
    (ρ : G →* Perm (Fin d)) (g : Perm (Fin k)) : Perm (Fin d) :=
  open Classical in if h : (toFin e).symm g ∈ G then ρ ⟨_, h⟩ else 1

theorem homFin_apply (e : Ω ≃ Fin k) {G : Subgroup (Perm Ω)} {d : ℕ}
    (ρ : G →* Perm (Fin d)) (g : G) : homFin e ρ (toFin e g) = ρ g := by
  unfold homFin
  have h : (toFin e).symm (toFin e (g : Perm Ω)) ∈ G := by
    rw [MulEquiv.symm_apply_apply]; exact g.2
  rw [dif_pos h]
  congr 1
  exact Subtype.ext (MulEquiv.symm_apply_apply _ _)

theorem homFin_one (e : Ω ≃ Fin k) {G : Subgroup (Perm Ω)} {d : ℕ}
    (ρ : G →* Perm (Fin d)) : homFin e ρ 1 = 1 := by
  have := homFin_apply e ρ 1
  rwa [OneMemClass.coe_one, map_one, map_one] at this

/-- **The image of a group given by generators is generated by the images of the
generators.** -/
theorem range_eq_gens (e : Ω ≃ Fin k) {G : Subgroup (Perm Ω)} {d : ℕ}
    (ρ : G →* Perm (Fin d)) {gs : List (Perm (Fin k))} (hgs : gens gs = groupFin e G) :
    gens (gs.map (homFin e ρ)) = ρ.range := by
  have hmem : ∀ g ∈ gs, ∃ h : (toFin e).symm g ∈ G, homFin e ρ g = ρ ⟨_, h⟩ := by
    intro g hg
    have : g ∈ groupFin e G := hgs ▸ Subgroup.subset_closure hg
    obtain ⟨g', hg', rfl⟩ := Subgroup.mem_map.1 this
    refine ⟨show (toFin e).symm (toFin e g') ∈ G by rw [MulEquiv.symm_apply_apply]; exact hg', ?_⟩
    unfold homFin
    rw [dif_pos]
    change (toFin e).symm (toFin e g') ∈ G
    simpa only [MulEquiv.symm_apply_apply] using hg'
  apply le_antisymm
  · rw [gens, Subgroup.closure_le]
    intro x hx
    obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hx
    obtain ⟨h, hh⟩ := hmem g hg
    exact ⟨_, hh.symm⟩
  · rintro _ ⟨g, rfl⟩
    -- `toFin g` lies in the closure of `gs`; follow it through the closure.
    have hg : toFin e (g : Perm Ω) ∈ gens gs := by
      rw [hgs]; exact Subgroup.mem_map.2 ⟨g, g.2, rfl⟩
    have key : ∀ x ∈ gens gs, ∀ h : (toFin e).symm x ∈ G,
        ρ ⟨_, h⟩ ∈ gens (gs.map (homFin e ρ)) := by
      intro x hx
      induction hx using Subgroup.closure_induction with
      | mem x hx =>
        intro h
        obtain ⟨h', hh⟩ := hmem x hx
        rw [← hh]
        exact Subgroup.subset_closure (List.mem_map.2 ⟨x, hx, rfl⟩)
      | one =>
        intro h
        have : (⟨(toFin e).symm 1, h⟩ : G) = 1 := Subtype.ext (map_one _)
        rw [this, map_one]; exact Subgroup.one_mem _
      | mul x y hx hy ihx ihy =>
        intro h
        have hx' : (toFin e).symm x ∈ G := by
          have h2 : x ∈ groupFin e G := hgs ▸ (hx : x ∈ gens gs)
          obtain ⟨x', hx', rfl⟩ := Subgroup.mem_map.1 h2
          show (toFin e).symm (toFin e x') ∈ G
          rw [MulEquiv.symm_apply_apply]; exact hx'
        have hy' : (toFin e).symm y ∈ G := by
          have h2 : y ∈ groupFin e G := hgs ▸ (hy : y ∈ gens gs)
          obtain ⟨y', hy', rfl⟩ := Subgroup.mem_map.1 h2
          show (toFin e).symm (toFin e y') ∈ G
          rw [MulEquiv.symm_apply_apply]; exact hy'
        have : (⟨(toFin e).symm (x * y), h⟩ : G) = ⟨_, hx'⟩ * ⟨_, hy'⟩ :=
          Subtype.ext (map_mul _ _ _)
        rw [this, map_mul]
        exact Subgroup.mul_mem _ (ihx hx') (ihy hy')
      | inv x hx ihx =>
        intro h
        have hx' : (toFin e).symm x ∈ G := by
          have h2 : x ∈ groupFin e G := hgs ▸ (hx : x ∈ gens gs)
          obtain ⟨x', hx', rfl⟩ := Subgroup.mem_map.1 h2
          show (toFin e).symm (toFin e x') ∈ G
          rw [MulEquiv.symm_apply_apply]; exact hx'
        have : (⟨(toFin e).symm x⁻¹, h⟩ : G) = (⟨_, hx'⟩ : G)⁻¹ := Subtype.ext (map_inv _ _)
        rw [this, map_inv]
        exact Subgroup.inv_mem _ (ihx hx')
    have := key _ hg (by rw [MulEquiv.symm_apply_apply]; exact g.2)
    convert this using 2
    exact Subtype.ext (MulEquiv.symm_apply_apply _ _).symm

/-! ### Numbering the classes of a labeling on the domain

The program numbers the classes of a labeling `lab` on the domain (indicator `dm`) as follows.
The key of a point is its label on the domain and `k` off it (`keyOf`). The representative of a
point is the first point with the same key (`repOf`). The representatives on the domain, in
increasing order, are `repsOf`; the number of a point of the domain is the position of its
representative in that list, and the number of a point off the domain is the length of the
list (`numOf`). -/

namespace Cls

variable (lab dm : Fin k → ℕ)

/-- The key: the label on the domain, `k` off it. -/
def keyOf (i : Fin k) : ℕ := if dm i = 0 then k else lab i

variable (key : Fin k → ℕ)

/-- The first point with the same key. -/
def repOf (i : Fin k) : ℕ := ((List.finRange k).map key).findIdx fun x => decide (x = key i)

/-- The test of a representative on the domain. -/
def repTest (j : ℕ) : Bool :=
  if h : j < k then dm ⟨j, h⟩ != 0 && repOf key ⟨j, h⟩ == j else false

/-- The representatives on the domain, in increasing order. -/
def repsOf : List ℕ := (List.range k).filter (repTest dm key)

/-- The number of a point. -/
def numOf (i : Fin k) : ℕ :=
  if dm i = 0 then (repsOf dm key).length
  else (repsOf dm key).findIdx fun x => decide (x = repOf key i)

theorem repOf_lt (i : Fin k) : repOf key i < k := by
  have := List.findIdx_lt_length_of_exists (p := fun x => decide (x = key i))
    (xs := (List.finRange k).map key) ⟨key i, List.mem_map_of_mem (List.mem_finRange i), by simp⟩
  simpa [repOf] using this

theorem key_repOf (i : Fin k) : key ⟨repOf key i, repOf_lt key i⟩ = key i := by
  have hw : ((List.finRange k).map key).findIdx (fun x => decide (x = key i)) <
      ((List.finRange k).map key).length := by
    rw [List.length_map, List.length_finRange]; exact repOf_lt key i
  have := List.findIdx_getElem (w := hw)
  simpa [repOf] using this

theorem repOf_eq_iff (i j : Fin k) : repOf key i = repOf key j ↔ key i = key j := by
  constructor
  · intro h
    rw [← key_repOf key i, ← key_repOf key j]
    exact congrArg key (Fin.ext h)
  · intro h; unfold repOf; rw [h]

theorem repOf_idem (i : Fin k) : repOf key ⟨repOf key i, repOf_lt key i⟩ = repOf key i :=
  (repOf_eq_iff key _ _).2 (key_repOf key i)

theorem mem_repsOf {j : ℕ} : j ∈ repsOf dm key ↔ ∃ h : j < k, dm ⟨j, h⟩ ≠ 0 ∧
    repOf key ⟨j, h⟩ = j := by
  unfold repsOf repTest
  simp only [List.mem_filter, List.mem_range]
  constructor
  · rintro ⟨hj, h⟩
    rw [dif_pos hj] at h
    simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq] at h
    exact ⟨hj, h⟩
  · rintro ⟨hj, h⟩
    refine ⟨hj, ?_⟩
    rw [dif_pos hj]
    simpa using h

theorem nodup_repsOf : (repsOf dm key).Nodup := (List.nodup_range).filter _

theorem repsOf_length_le : (repsOf dm key).length ≤ k := by
  have := List.length_filter_le (repTest dm key) (List.range k)
  simpa [repsOf] using this

/-- The labels on the domain are below `k`. -/
def LabOK : Prop := ∀ i, dm i ≠ 0 → lab i < k

variable {lab dm}

theorem keyOf_lt_iff (hl : LabOK lab dm) (i : Fin k) : keyOf lab dm i < k ↔ dm i ≠ 0 := by
  unfold keyOf; split_ifs with h
  · simp [h]
  · simp [h, hl i h]

/-- The representative of a point of the domain lies in the domain. -/
theorem dm_repOf (hl : LabOK lab dm) {i : Fin k} (hi : dm i ≠ 0) :
    dm ⟨repOf (keyOf lab dm) i, repOf_lt _ i⟩ ≠ 0 := by
  rw [← keyOf_lt_iff hl, key_repOf (keyOf lab dm) i, keyOf_lt_iff hl]
  exact hi

theorem repOf_mem (hl : LabOK lab dm) {i : Fin k} (hi : dm i ≠ 0) :
    repOf (keyOf lab dm) i ∈ repsOf dm (keyOf lab dm) :=
  (mem_repsOf dm _).2 ⟨repOf_lt _ i, dm_repOf hl hi, repOf_idem _ i⟩

theorem numOf_lt (hl : LabOK lab dm) {i : Fin k} (hi : dm i ≠ 0) :
    numOf dm (keyOf lab dm) i < (repsOf dm (keyOf lab dm)).length := by
  unfold numOf
  rw [if_neg hi]
  exact List.findIdx_lt_length_of_exists ⟨_, repOf_mem hl hi, by simp⟩

theorem getElem_numOf (hl : LabOK lab dm) {i : Fin k} (hi : dm i ≠ 0) :
    (repsOf dm (keyOf lab dm))[numOf dm (keyOf lab dm) i]'(numOf_lt hl hi) =
      repOf (keyOf lab dm) i := by
  have h := List.findIdx_getElem (p := fun x => decide (x = repOf (keyOf lab dm) i))
    (xs := repsOf dm (keyOf lab dm)) (w := by have := numOf_lt hl hi; unfold numOf at this; rwa [if_neg hi] at this)
  simp only [decide_eq_true_eq] at h
  convert h using 2
  unfold numOf; rw [if_neg hi]

/-- **Two points of the domain have the same number exactly when they have the same label.** -/
theorem numOf_eq_iff (hl : LabOK lab dm) {i j : Fin k} (hi : dm i ≠ 0) (hj : dm j ≠ 0) :
    numOf dm (keyOf lab dm) i = numOf dm (keyOf lab dm) j ↔ lab i = lab j := by
  have hkey : keyOf lab dm i = keyOf lab dm j ↔ lab i = lab j := by
    simp [keyOf, hi, hj]
  rw [← hkey, ← repOf_eq_iff (keyOf lab dm)]
  constructor
  · intro h
    rw [← getElem_numOf hl hi, ← getElem_numOf hl hj]
    simp only [h]
  · intro h; unfold numOf; rw [if_neg hi, if_neg hj, h]

/-- The number of a point of the domain is its position in the list of representatives. -/
theorem numOf_getElem {t : ℕ} (ht : t < (repsOf dm (keyOf lab dm)).length) :
    ∃ h : (repsOf dm (keyOf lab dm))[t] < k,
      dm ⟨_, h⟩ ≠ 0 ∧ numOf dm (keyOf lab dm) ⟨_, h⟩ = t := by
  obtain ⟨h1, h2, h3⟩ := (mem_repsOf dm _).1 (List.getElem_mem ht)
  refine ⟨h1, h2, ?_⟩
  unfold numOf
  rw [if_neg h2, h3]
  rw [List.findIdx_eq ht]
  refine ⟨by simp, fun j hj => ?_⟩
  simp only [decide_eq_false_iff_not]
  intro heq
  have := (nodup_repsOf dm _).getElem_inj_iff.1 heq
  omega

theorem numOf_off {i : Fin k} (hi : dm i = 0) (key : Fin k → ℕ) :
    numOf dm key i = (repsOf dm key).length := by
  unfold numOf; rw [if_pos hi]

end Cls

end GI.Impl

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Cited (Val gens)

variable {Ω C : Type} {k : ℕ}

namespace Cls

theorem indF_ne_zero (e : Ω ≃ Fin k) (D : Set Ω) (v : Ω) : indF e D (e v) ≠ 0 ↔ v ∈ D := by
  classical
  unfold indF; simp only [Equiv.symm_apply_apply]; split_ifs with h <;> simp [h]

/-- **The numbering of the classes of a partition on the domain**: the numbers of the points of
the domain are below `d`, they agree exactly when the points are in one class, and every number
below `d` occurs. -/
structure Numbering (e : Ω ≃ Fin k) (D : Set Ω) (R : Setoid Ω) (num : Fin k → ℕ) (d : ℕ) :
    Prop where
  lt : ∀ v ∈ D, num (e v) < d
  eq_iff : ∀ v ∈ D, ∀ w ∈ D, num (e v) = num (e w) ↔ R.r v w
  onto : ∀ t < d, ∃ v ∈ D, num (e v) = t
  off : ∀ v, v ∉ D → num (e v) = d

/-- The program's numbering of the classes of a labeling of the partition `R`. -/
theorem numbering (e : Ω ≃ Fin k) (D : Set Ω) (R : Setoid Ω) (lab : Fin k → ℕ)
    (hlt : ∀ i, lab i < k) (hR : ∀ i j, lab i = lab j ↔ R.r (e.symm i) (e.symm j)) :
    Numbering e D R (numOf (indF e D) (keyOf lab (indF e D)))
      (repsOf (indF e D) (keyOf lab (indF e D))).length := by
  have hl : LabOK lab (indF e D) := fun i _ => hlt i
  refine ⟨fun v hv => numOf_lt hl ((indF_ne_zero e D v).2 hv), fun v hv w hw => ?_,
    fun t ht => ?_, fun v hv => numOf_off (by
      have := (indF_ne_zero e D v).not.2 hv; omega) _⟩
  · rw [numOf_eq_iff hl ((indF_ne_zero e D v).2 hv) ((indF_ne_zero e D w).2 hw), hR]
    simp
  · obtain ⟨h, h1, h2⟩ := numOf_getElem (lab := lab) (dm := indF e D) ht
    refine ⟨e.symm ⟨_, h⟩, (indF_ne_zero e D _).1 (by simpa using h1), by simpa using h2⟩

variable {e : Ω ≃ Fin k} {D : Set Ω} {R : Setoid Ω} {num : Fin k → ℕ} {d : ℕ}

/-- The numbering as a map to `Fin d` (`0` off the domain, when `d > 0`). -/
noncomputable def Numbering.toMap (_h : Numbering e D R num d) (hd : 0 < d) (v : Ω) : Fin d :=
  open Classical in if hv : v ∈ D then ⟨num (e v), _h.lt v hv⟩ else ⟨0, hd⟩

theorem Numbering.toMap_val (h : Numbering e D R num d) (hd : 0 < d) {v : Ω} (hv : v ∈ D) :
    (h.toMap hd v : ℕ) = num (e v) := by
  unfold toMap; rw [dif_pos hv]

theorem Numbering.toMap_onto (h : Numbering e D R num d) (hd : 0 < d) (t : Fin d) :
    ∃ v ∈ D, h.toMap hd v = t := by
  obtain ⟨v, hv, hvt⟩ := h.onto t t.2
  exact ⟨v, hv, Fin.ext (by rw [h.toMap_val hd hv, hvt])⟩

theorem Numbering.toMap_eq_iff (h : Numbering e D R num d) (hd : 0 < d) {v w : Ω} (hv : v ∈ D)
    (hw : w ∈ D) : h.toMap hd v = h.toMap hd w ↔ R.r v w := by
  rw [← h.eq_iff v hv w hw, Fin.ext_iff, h.toMap_val hd hv, h.toMap_val hd hw]

/-- **The action on the numbered classes.** For an invariant partition, the action of `G` on the
numbers; the program computes it on the generators as `t ↦ num (g r_t)` for a point `r_t` with
number `t`. -/
theorem Numbering.exists_rho {S : State Ω C} (h : Numbering e S.dom R num d) (hd : 0 < d)
    (hR : ∀ g ∈ S.G, ∀ v ∈ S.dom, ∀ w ∈ S.dom, R.r (g v) (g w) ↔ R.r v w) :
    ∃ ρ : S.G →* Perm (Fin d), (∀ g : S.G, ∀ v ∈ S.dom, ρ g (h.toMap hd v) =
      h.toMap hd ((g : Perm Ω) v)) ∧
      ∀ g : Perm (Fin k), (toFin e).symm g ∈ S.G → ∀ (r : Fin k) (hr : e.symm r ∈ S.dom),
        ((homFin e ρ g) ⟨num r, by simpa using h.lt _ hr⟩ : ℕ) = num (g r) := by
  obtain ⟨ρ, hρ⟩ := exists_classRho S R hR (h.toMap hd) (h.toMap_onto hd)
    fun v hv w hw => h.toMap_eq_iff hd hv hw
  refine ⟨ρ, hρ, fun g hg r hr => ?_⟩
  have hgr : (toFin e).symm g (e.symm r) ∈ S.dom := (S.dom_inv _ hg _).2 hr
  have h1 : (⟨num r, by simpa using h.lt _ hr⟩ : Fin d) = h.toMap hd (e.symm r) :=
    Fin.ext (by rw [h.toMap_val hd hr]; simp)
  unfold homFin
  rw [dif_pos hg, h1, hρ ⟨_, hg⟩ _ hr, h.toMap_val hd hgr]
  congr 1
  simp [toFin, Equiv.permCongrHom, Equiv.permCongr_apply]

end Cls

