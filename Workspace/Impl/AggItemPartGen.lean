import Workspace.Impl.AggItemPart

/-!
# Case 1: generators of the stabilizer of a partition

For a labeling `lab : Fin q → ℕ` with a center map `c` (a point `c x` of the block of `x`, the
least one: for orbit labels `c x = lab x`), the stabilizer of the partition `itpPart lab` is
generated by

* the transpositions `(c x, x)`, which generate the permutations inside the blocks, and
* the block swaps `itpBs lab (c x) (c y)` for two blocks of the same size: the point of rank `r`
  in one block goes to the point of rank `r` in the other (`itpBs_lab`).

This is `itp_closure_eq`. The proof goes in two steps, both by induction on a number of points.
A permutation that keeps every label is a product of transpositions inside blocks: compose with
`(y, σ y)` to fix one more point (`itp_mem_of_lab`). A general element of the stabilizer moves
some block onto another block of the same size; compose with the block swap to send that
block back, which lowers the number of points whose label changes (`itp_closure_eq`).
-/

namespace GI.Impl

open GI.Algorithm Equiv Equiv.Perm Finset

variable {q : ℕ} {lab : Fin q → ℕ}

/-! ### Centers and ranks -/

/-- The least point of a block has rank `0`. -/
theorem itpRk_eq_zero {u : Fin q} (hu : ∀ y, lab y = lab u → u ≤ y) : itpRk lab u = 0 := by
  rw [itpRk, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro y _ ⟨h1, h2⟩
  exact absurd (hu y h1) (not_le.2 (Fin.lt_def.2 h2))

/-- The rank is strictly increasing inside a block. -/
theorem itpRk_lt_of_lt {y z : Fin q} (h : lab y = lab z) (hyz : y < z) :
    itpRk lab y < itpRk lab z := by
  refine Finset.card_lt_card ⟨fun w hw => ?_, fun hsub => ?_⟩
  · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hw ⊢
    exact ⟨hw.1.trans h, hw.2.trans (Fin.lt_def.1 hyz)⟩
  · have := hsub (show y ∈ univ.filter fun w => lab w = lab z ∧ (w : ℕ) < z by
      simp [h, hyz])
    simp at this

/-- Every rank below the block size is the rank of a point of the block. -/
theorem itpRk_surj (a : Fin q) {i : ℕ} (hi : i < itpSz lab a) :
    ∃ w, lab w = lab a ∧ itpRk lab w = i := by
  classical
  have hinj : ∀ y₁ ∈ itpBlk lab a, ∀ y₂ ∈ itpBlk lab a, itpRk lab y₁ = itpRk lab y₂ → y₁ = y₂ := by
    intro y₁ h₁ y₂ h₂ he
    rw [itp_mem_blk] at h₁ h₂
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · exact (itpRk_lt_of_lt (h₁.trans h₂.symm) hlt).ne he
    · exact (itpRk_lt_of_lt (h₂.trans h₁.symm) hlt).ne he.symm
  obtain ⟨w, hw, hwi⟩ := Finset.surj_on_of_inj_on_of_card_le (s := itpBlk lab a)
    (t := Finset.range (itpSz lab a)) (fun y _ => itpRk lab y)
    (fun y hy => Finset.mem_range.2 (by
      rw [itp_mem_blk] at hy
      rw [itpSz_congr hy.symm]; exact itpRk_lt y))
    (fun y₁ y₂ h₁ h₂ he => hinj y₁ h₁ y₂ h₂ he) (by simp [itpSz]) i (Finset.mem_range.2 hi)
  exact ⟨w, itp_mem_blk.1 hw, hwi.symm⟩

/-- The position of a point is the position of the least point of its block plus its rank. -/
theorem itpPos_center {u z : Fin q} (hu : itpRk lab u = 0) (h : lab z = lab u) :
    itpPos lab z = itpPos lab u + itpRk lab z := by
  rw [itpPos_eq z, itpPos_eq u, hu, itpSz_congr h]
  have := (itp_lab_eq_iff.1 h).2
  rw [this]; omega

/-! ### Block swaps -/

variable (lab) in
/-- The point at position `p`, or `d` if `p ≥ q`. -/
noncomputable def itpAt (p : ℕ) (d : Fin q) : Fin q :=
  if h : p < q then (itpPosE lab).symm ⟨p, h⟩ else d

theorem itpAt_pos (w d : Fin q) : itpAt lab (itpPos lab w) d = w := by
  rw [itpAt, dif_pos (itpPos_lt w)]
  exact (Equiv.symm_apply_eq _).2 rfl

variable (lab) in
/-- The block swap as a function: the block of `u` goes to that of `u'` and back, keeping ranks. -/
noncomputable def itpBsF (u u' z : Fin q) : Fin q :=
  if lab z = lab u then itpAt lab (itpPos lab z - itpPos lab u + itpPos lab u') z
  else if lab z = lab u' then itpAt lab (itpPos lab z - itpPos lab u' + itpPos lab u) z
  else z

/-- The conditions of a block swap: two least points of blocks of the same size. -/
def ItpBsOK (lab : Fin q → ℕ) (u u' : Fin q) : Prop :=
  itpRk lab u = 0 ∧ itpRk lab u' = 0 ∧ itpSz lab u = itpSz lab u'

/-- **The shift to another block**: the point of the block of `u'` with the rank of `z`. -/
theorem itp_shift {u u' z : Fin q} (h : ItpBsOK lab u u') (hz : lab z = lab u) :
    ∃ w, lab w = lab u' ∧ itpRk lab w = itpRk lab z ∧
      itpAt lab (itpPos lab z - itpPos lab u + itpPos lab u') z = w := by
  have hr : itpRk lab z < itpSz lab u' := by
    rw [← h.2.2, ← itpSz_congr hz]; exact itpRk_lt z
  obtain ⟨w, hw, hwr⟩ := itpRk_surj u' hr
  refine ⟨w, hw, hwr, ?_⟩
  have e : itpPos lab z - itpPos lab u + itpPos lab u' = itpPos lab w := by
    rw [itpPos_center h.1 hz, itpPos_center h.2.1 hw, hwr]; omega
  rw [e]
  exact itpAt_pos w z

/-- The block swap on the block of `u`. -/
theorem itpBsF_of_u {u u' z : Fin q} (h : ItpBsOK lab u u') (hz : lab z = lab u) :
    ∃ w, lab w = lab u' ∧ itpRk lab w = itpRk lab z ∧ itpBsF lab u u' z = w := by
  obtain ⟨w, hw, hwr, he⟩ := itp_shift h hz
  exact ⟨w, hw, hwr, by rw [itpBsF, if_pos hz, he]⟩

theorem itpBsOK_symm {u u' : Fin q} (h : ItpBsOK lab u u') : ItpBsOK lab u' u :=
  ⟨h.2.1, h.1, h.2.2.symm⟩

/-- The block swap on the block of `u'`, when the two blocks differ. -/
theorem itpBsF_of_u' {u u' z : Fin q} (h : ItpBsOK lab u u') (hne : lab u ≠ lab u')
    (hz : lab z = lab u') :
    ∃ w, lab w = lab u ∧ itpRk lab w = itpRk lab z ∧ itpBsF lab u u' z = w := by
  obtain ⟨w, hw, hwr, he⟩ := itp_shift (itpBsOK_symm h) hz
  refine ⟨w, hw, hwr, ?_⟩
  rw [itpBsF, if_neg (fun e => hne (e.symm.trans hz)), if_pos hz, he]

/-- Two points of one block with the same rank are equal. -/
theorem itp_eq_of_rk {y z : Fin q} (h : lab y = lab z) (hr : itpRk lab y = itpRk lab z) :
    y = z := by
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · exact (itpRk_lt_of_lt h hlt).ne hr
  · exact (itpRk_lt_of_lt h.symm hlt).ne hr.symm

/-- The block swap is an involution. -/
theorem itpBsF_involutive {u u' : Fin q} (h : ItpBsOK lab u u') :
    Function.Involutive (itpBsF lab u u') := by
  intro z
  by_cases hne : lab u = lab u'
  · -- the two blocks are one: the swap is the identity
    have hid : ∀ y, itpBsF lab u u' y = y := by
      intro y
      by_cases hy : lab y = lab u
      · obtain ⟨w, hw, hwr, he⟩ := itpBsF_of_u h hy
        rw [he]
        exact itp_eq_of_rk (hw.trans (hne.symm.trans hy.symm)) hwr
      · rw [itpBsF, if_neg hy, if_neg (fun e => hy (e.trans hne.symm))]
    rw [hid, hid]
  by_cases hz : lab z = lab u
  · obtain ⟨w, hw, hwr, he⟩ := itpBsF_of_u h hz
    obtain ⟨w', hw', hwr', he'⟩ := itpBsF_of_u' h hne hw
    rw [he, he']
    exact itp_eq_of_rk (hw'.trans hz.symm) (hwr'.trans hwr)
  by_cases hz' : lab z = lab u'
  · obtain ⟨w, hw, hwr, he⟩ := itpBsF_of_u' h hne hz'
    obtain ⟨w', hw', hwr', he'⟩ := itpBsF_of_u h hw
    rw [he, he']
    exact itp_eq_of_rk (hw'.trans hz'.symm) (hwr'.trans hwr)
  · have e : itpBsF lab u u' z = z := by rw [itpBsF, if_neg hz, if_neg hz']
    rw [e, e]

open Classical in
variable (lab) in
/-- **The block swap** of the blocks of `u` and `u'` (the identity if the conditions fail). -/
noncomputable def itpBs (u u' : Fin q) : Perm (Fin q) :=
  if h : ItpBsOK lab u u' then (itpBsF_involutive h).toPerm _ else 1

theorem itpBs_apply {u u' : Fin q} (h : ItpBsOK lab u u') (z : Fin q) :
    itpBs lab u u' z = itpBsF lab u u' z := by
  rw [itpBs, dif_pos h]; rfl

/-- **The block swap exchanges the two labels.** -/
theorem itpBs_lab {u u' : Fin q} (h : ItpBsOK lab u u') (z : Fin q) :
    lab (itpBs lab u u' z) = Equiv.swap (lab u) (lab u') (lab z) := by
  rw [itpBs_apply h, Equiv.swap_apply_def]
  by_cases hz : lab z = lab u
  · obtain ⟨w, hw, -, he⟩ := itpBsF_of_u h hz
    rw [he, hw, if_pos hz]
  rw [if_neg hz]
  by_cases hz' : lab z = lab u'
  · by_cases hne : lab u = lab u'
    · exact absurd (hz'.trans hne.symm) hz
    obtain ⟨w, hw, -, he⟩ := itpBsF_of_u' h hne hz'
    rw [he, hw, if_pos hz']
  · rw [if_neg hz', itpBsF, if_neg hz, if_neg hz']

/-- A permutation acting on labels by a bijection of `ℕ` stabilizes the partition. -/
theorem itp_mem_stab_of_lab {σ : Perm (Fin q)} (τ : Perm ℕ) (h : ∀ z, lab (σ z) = τ (lab z)) :
    σ ∈ MulAction.stabilizer (Perm (Fin q)) (itpPart lab) := by
  rw [itp_mem_stab]
  intro a b
  rw [h, h, τ.injective.eq_iff]

theorem itpBs_mem_stab {u u' : Fin q} (h : ItpBsOK lab u u') :
    itpBs lab u u' ∈ MulAction.stabilizer (Perm (Fin q)) (itpPart lab) :=
  itp_mem_stab_of_lab _ (itpBs_lab h)

/-- A transposition inside a block stabilizes the partition. -/
theorem itp_swap_lab {x y : Fin q} (h : lab x = lab y) (z : Fin q) :
    lab (Equiv.swap x y z) = lab z := by
  rw [Equiv.swap_apply_def]
  split_ifs with h1 h2
  · rw [h1, h]
  · rw [h2, h]
  · rfl

theorem itp_swap_mem_stab {x y : Fin q} (h : lab x = lab y) :
    Equiv.swap x y ∈ MulAction.stabilizer (Perm (Fin q)) (itpPart lab) :=
  itp_mem_stab_of_lab 1 fun z => itp_swap_lab h z

/-! ### Generation -/

section Gen

variable {c : Fin q → Fin q} (hc1 : ∀ x, lab (c x) = lab x) (hc2 : ∀ x y, lab x = lab y → c x ≤ y)
  {S : Set (Perm (Fin q))}

include hc1 hc2 in
theorem itp_c_congr {x y : Fin q} (h : lab x = lab y) : c x = c y :=
  le_antisymm (hc2 x (c y) (by rw [hc1, h])) (hc2 y (c x) (by rw [hc1, h]))

include hc1 hc2 in
theorem itp_c_rk (x : Fin q) : itpRk lab (c x) = 0 :=
  itpRk_eq_zero fun y hy => hc2 x y (hy.trans (hc1 x)).symm

include hc1 hc2 in
/-- A transposition inside a block is in the closure of the transpositions with the centers. -/
theorem itp_swap_mem (htr : ∀ x, Equiv.swap (c x) x ∈ S) {x y : Fin q} (h : lab x = lab y) :
    Equiv.swap x y ∈ Subgroup.closure S := by
  have hcxy := itp_c_congr hc1 hc2 h
  by_cases hxy : x = y
  · rw [hxy, Equiv.swap_self]; exact Subgroup.one_mem _
  by_cases hux : c x = x
  · rw [← hux, hcxy]; exact Subgroup.subset_closure (htr y)
  by_cases huy : c x = y
  · rw [← huy, Equiv.swap_comm]; exact Subgroup.subset_closure (htr x)
  have e := Equiv.swap_mul_swap_mul_swap (x := y) (y := c x) (z := x) (Ne.symm huy) (Ne.symm hxy)
  rw [← e, Equiv.swap_comm y (c x)]
  refine Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) ?_
  · exact Subgroup.subset_closure (htr x)
  · rw [hcxy]; exact Subgroup.subset_closure (htr y)
  · exact Subgroup.subset_closure (htr x)

include hc1 hc2 in
/-- **Permutations that keep every label** are in the closure of the transpositions. -/
theorem itp_mem_of_lab (htr : ∀ x, Equiv.swap (c x) x ∈ S) :
    ∀ (n : ℕ) (σ : Perm (Fin q)), (∀ z, lab (σ z) = lab z) →
      (univ.filter fun z => σ z ≠ z).card ≤ n → σ ∈ Subgroup.closure S := by
  intro n
  induction n with
  | zero =>
    intro σ _ hn
    rw [Nat.le_zero, Finset.card_eq_zero, Finset.filter_eq_empty_iff] at hn
    have : σ = 1 := Equiv.ext fun z => by simpa using hn (Finset.mem_univ z)
    rw [this]; exact Subgroup.one_mem _
  | succ n ih =>
    intro σ hσ hn
    by_cases h1 : ∀ z, σ z = z
    · have : σ = 1 := Equiv.ext h1
      rw [this]; exact Subgroup.one_mem _
    push Not at h1
    obtain ⟨y, hy⟩ := h1
    set τ := Equiv.swap y (σ y)
    have hτ : τ ∈ Subgroup.closure S := itp_swap_mem hc1 hc2 htr (hσ y).symm
    have hσ' : ∀ z, lab ((τ * σ) z) = lab z := fun z => by
      rw [Perm.mul_apply, itp_swap_lab (hσ y).symm, hσ]
    have hsub : (univ.filter fun z => (τ * σ) z ≠ z) ⊂ univ.filter fun z => σ z ≠ z := by
      refine ⟨fun z hz => ?_, fun hsub => ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
        intro hfix
        apply hz
        have hzy : z ≠ y := fun e => hy (e ▸ hfix)
        have hzσ : z ≠ σ y := fun e => hy (σ.injective (by rw [← e, hfix, e]))
        rw [Perm.mul_apply, hfix, Equiv.swap_apply_of_ne_of_ne hzy hzσ]
      · have := hsub (show y ∈ univ.filter fun z => σ z ≠ z by simpa using hy)
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, Perm.mul_apply, τ,
          Equiv.swap_apply_right, ne_eq, not_true_eq_false] at this
    have hmem := ih (τ * σ) hσ' (by have := Finset.card_lt_card hsub; omega)
    have e : σ = τ * (τ * σ) := by rw [← mul_assoc, Equiv.swap_mul_self, one_mul]
    rw [e]
    exact Subgroup.mul_mem _ hτ hmem

include hc1 hc2 in
/-- **The stabilizer of the partition is generated** by the transpositions with the centers and
the block swaps of the centers of two blocks of the same size. -/
theorem itp_closure_eq (hS : S ⊆ MulAction.stabilizer (Perm (Fin q)) (itpPart lab))
    (htr : ∀ x, Equiv.swap (c x) x ∈ S)
    (hbs : ∀ x y, itpSz lab x = itpSz lab y → lab x ≠ lab y → itpBs lab (c x) (c y) ∈ S) :
    Subgroup.closure S = MulAction.stabilizer (Perm (Fin q)) (itpPart lab) := by
  refine le_antisymm ((Subgroup.closure_le _).2 hS) fun σ hσ => ?_
  suffices h : ∀ (n : ℕ) (σ : Perm (Fin q)),
      σ ∈ MulAction.stabilizer (Perm (Fin q)) (itpPart lab) →
      (univ.filter fun z => lab (σ z) ≠ lab z).card ≤ n → σ ∈ Subgroup.closure S from
    h _ σ hσ le_rfl
  intro n
  induction n with
  | zero =>
    intro σ _ hn
    rw [Nat.le_zero, Finset.card_eq_zero, Finset.filter_eq_empty_iff] at hn
    exact itp_mem_of_lab hc1 hc2 htr _ σ (fun z => by simpa using hn (Finset.mem_univ z)) le_rfl
  | succ n ih =>
    intro σ hσ hn
    by_cases h1 : ∀ z, lab (σ z) = lab z
    · exact itp_mem_of_lab hc1 hc2 htr _ σ h1 le_rfl
    push Not at h1
    obtain ⟨y, hy⟩ := h1
    have hsz : itpSz lab y = itpSz lab (σ y) := (itpSz_of_smul hσ y).symm
    have hok : ItpBsOK lab (c y) (c (σ y)) :=
      ⟨itp_c_rk hc1 hc2 y, itp_c_rk hc1 hc2 (σ y), by
        rw [itpSz_congr (hc1 y), itpSz_congr (hc1 (σ y)), hsz]⟩
    set β := itpBs lab (c y) (c (σ y))
    have hβ : β ∈ S := hbs y (σ y) hsz (Ne.symm hy)
    have hlabβ : ∀ z, lab ((β * σ) z) =
        Equiv.swap (lab y) (lab (σ y)) (lab (σ z)) := fun z => by
      rw [Perm.mul_apply, itpBs_lab hok, hc1, hc1]
    have hstab : β * σ ∈ MulAction.stabilizer (Perm (Fin q)) (itpPart lab) :=
      Subgroup.mul_mem _ (hS hβ) hσ
    have hsσ := (itp_mem_stab (lab := lab)).1 hσ
    have hsub : (univ.filter fun z => lab ((β * σ) z) ≠ lab z) ⊂
        univ.filter fun z => lab (σ z) ≠ lab z := by
      refine ⟨fun z hz => ?_, fun hsub => ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
        intro hfix
        apply hz
        rw [hlabβ, hfix]
        refine Equiv.swap_apply_of_ne_of_ne (fun e => ?_) (fun e => ?_)
        · -- `z` in the block of `y`: then `σ z` is in the block of `σ y`, not of `y`
          have : lab (σ z) = lab (σ y) := (hsσ z y).2 e
          exact hy (this.symm.trans (hfix.trans e))
        · have : lab z = lab y := (hsσ z y).1 (hfix.trans e)
          exact hy (e.symm.trans this)
      · have := hsub (show y ∈ univ.filter fun z => lab (σ z) ≠ lab z by simpa using hy)
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at this
        apply this
        rw [hlabβ, Equiv.swap_apply_right]
    have hmem := ih (β * σ) hstab (by have := Finset.card_lt_card hsub; omega)
    have e : σ = β⁻¹ * (β * σ) := by rw [inv_mul_cancel_left]
    rw [e]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.subset_closure hβ)) hmem

end Gen

end GI.Impl
