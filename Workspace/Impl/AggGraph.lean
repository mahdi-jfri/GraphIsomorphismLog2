import Workspace.Impl.GiantSelMath
import Workspace.Impl.DomMath

/-!
# Subgroups of `G` with their labels: the graph form

The certificate phase of an aggregation round works with subgroups `A ≤ G` and their label
images `π(A) ≤ Alt(Γ)` (the stages `A_t`, the test groups `P_T`, the kernels `ker(φ_T|_A)`). A
program cannot apply `π` to an arbitrary element: `π` is given only on the generators of `G`
(the label value lists the pairs `[g, π g]`). So the program keeps every subgroup `A` in
*graph form*: a list of pairs `(a, π a)` that generates the graph `{(a, π a) : a ∈ A}`
(`PairGens`). Then

* the label image `π(A)` is generated by the second parts (`mem_gens_snd`), and `A` by the
  first parts (`mem_gens_fst`), with no cited call;
* the cited **Preimage** task, run on the graph group `{(a, π a) ⊕ π a}`, returns the graph
  form of `A ∩ π⁻¹(M)` for any `M ≤ π(A)` (`mem_preimageSet_snd`); run on
  `{(a, π a) ⊕ a}` it returns the graph form of `⟨ms⟩` for generators `ms` of a subgroup of `A`
  (`mem_preimageSet_fst`);
* the cited **PointwiseStab** task, run on the graph group, returns the graph form of the
  pointwise stabilizer of points of `Ω` (`mem_pointwiseStab_pairs`).

A pair `(a, b)` of permutations of `Fin k` and `Fin q` is passed to the cited tasks as the
permutation `a ⊕ b` of `Fin (k + q)` (`encPair`), an injective homomorphism.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly Equiv Equiv.Perm
open GI.Cited (gens sumToFin PreimageInst preimageSet pointwiseStab)

variable {k q : ℕ}

/-! ### Pairs as permutations of `Fin (k + q)` -/

/-- `(a, b) ↦ a ⊕ b`, as a permutation of `Fin (k + q)`. -/
def encPairHom (k q : ℕ) : Perm (Fin k) × Perm (Fin q) →* Perm (Fin (k + q)) :=
  (finSumFinEquiv.permCongrHom.toMonoidHom).comp (Perm.sumCongrHom (Fin k) (Fin q))

/-- The permutation `a ⊕ b` of `Fin (k + q)` of a pair. -/
def encPair (p : Perm (Fin k) × Perm (Fin q)) : Perm (Fin (k + q)) := encPairHom k q p

theorem encPair_eq (p : Perm (Fin k) × Perm (Fin q)) :
    encPair p = sumToFin (Perm.sumCongr p.1 p.2) := by
  ext i
  simp [encPair, encPairHom, sumToFin, Equiv.permCongrHom, Equiv.permCongr_apply]

theorem encPairHom_injective : Function.Injective (encPairHom k q) := by
  intro p p' h
  have h' : Perm.sumCongr p.1 p.2 = Perm.sumCongr p'.1 p'.2 := by
    have := congrArg (fun σ : Perm (Fin (k + q)) => (finSumFinEquiv.permCongr).symm σ) h
    simpa [encPairHom] using this
  obtain ⟨h1, h2⟩ := sumCongr_inj' h'
  exact Prod.ext h1 h2

theorem encPair_injective : Function.Injective (encPair (k := k) (q := q)) :=
  encPairHom_injective

/-- The group generated by the encoded pairs is the image of the group generated by the pairs. -/
theorem gens_map_encPair (ps : List (Perm (Fin k) × Perm (Fin q))) :
    gens (ps.map encPair) = (Subgroup.closure {p | p ∈ ps}).map (encPairHom k q) := by
  unfold gens
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  simp [encPair]

theorem mem_gens_encPair {ps : List (Perm (Fin k) × Perm (Fin q))} {x : Perm (Fin (k + q))} :
    x ∈ gens (ps.map encPair) ↔ ∃ p ∈ Subgroup.closure {p | p ∈ ps}, encPair p = x := by
  rw [gens_map_encPair, Subgroup.mem_map]
  rfl

/-- The first part of a pair generates the first projection. -/
theorem gens_fst (ps : List (Perm (Fin k) × Perm (Fin q))) :
    gens (ps.map Prod.fst) = (Subgroup.closure {p | p ∈ ps}).map (MonoidHom.fst _ _) := by
  unfold gens
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  simp

/-- The second part of a pair generates the second projection. -/
theorem gens_snd (ps : List (Perm (Fin k) × Perm (Fin q))) :
    gens (ps.map Prod.snd) = (Subgroup.closure {p | p ∈ ps}).map (MonoidHom.snd _ _) := by
  unfold gens
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  simp

/-! ### The preimage instances -/

/-- **The preimage instance on a graph group**: the generators `(a ⊕ b) ⊕ f(a, b)` on
`Fin (k + q) ⊕ Fin n'`, for a projection `f` (`fst` or `snd`), and generators `ms` of a subgroup
of the projection of the group of the pairs. -/
def pairInst {n' : ℕ} (f : Perm (Fin k) × Perm (Fin q) →* Perm (Fin n'))
    (ps : List (Perm (Fin k) × Perm (Fin q))) (ms : List (Perm (Fin n')))
    (hms : ∀ m ∈ ms, ∃ p ∈ Subgroup.closure {p | p ∈ ps}, f p = m) : PreimageInst where
  n := k + q
  n' := n'
  ds := ps.map fun p => Perm.sumCongr (encPair p) (f p)
  ms := ms
  preserves := fun d hd i => by
    obtain ⟨p, -, rfl⟩ := List.mem_map.mp hd
    exact ⟨encPair p i, by simp⟩
  ms_le := fun m hm => by
    obtain ⟨p, hp, rfl⟩ := hms m hm
    refine ⟨encPair p, ?_⟩
    have hhom : ∀ a ∈ (⊤ : Subgroup (Perm (Fin k) × Perm (Fin q))), ∀ b ∈ (⊤ : Subgroup _),
        (fun p : Perm (Fin k) × Perm (Fin q) => Perm.sumCongr (encPair p) (f p)) (a * b) =
          Perm.sumCongr (encPair a) (f a) * Perm.sumCongr (encPair b) (f b) := by
      intro a _ b _
      simp [encPair, Perm.sumCongr_mul]
    have hc : Subgroup.closure {d | d ∈ ps.map fun p => Perm.sumCongr (encPair p) (f p)} =
        (Subgroup.closure {p | p ∈ ps}).map
          ((Perm.sumCongrHom _ _).comp ((encPairHom k q).prod f)) := by
      rw [MonoidHom.map_closure]
      congr 1
      ext x
      simp [encPair]
    rw [hc]
    exact ⟨p, hp, rfl⟩

/-- **What the preimage instance returns**: the encoded pairs `p` of the group of the pairs
whose projection `f p` lies in `⟨ms⟩`. -/
theorem mem_preimageSet_pairInst {n' : ℕ} (f : Perm (Fin k) × Perm (Fin q) →* Perm (Fin n'))
    (ps : List (Perm (Fin k) × Perm (Fin q))) (ms : List (Perm (Fin n')))
    (hms : ∀ m ∈ ms, ∃ p ∈ Subgroup.closure {p | p ∈ ps}, f p = m) (x : Perm (Fin (k + q))) :
    x ∈ preimageSet (pairInst f ps ms hms) ↔
      ∃ p ∈ Subgroup.closure {p | p ∈ ps}, f p ∈ gens ms ∧ encPair p = x := by
  have hc : Subgroup.closure {d | d ∈ (pairInst f ps ms hms).ds} =
      (Subgroup.closure {p | p ∈ ps}).map
        ((Perm.sumCongrHom _ _).comp ((encPairHom k q).prod f)) := by
    show Subgroup.closure {d | d ∈ ps.map fun p => Perm.sumCongr (encPair p) (f p)} = _
    rw [MonoidHom.map_closure]
    congr 1
    ext x
    simp [encPair]
  show (∃ h ∈ Subgroup.closure {m | m ∈ ms}, Perm.sumCongr x h ∈
    Subgroup.closure {d | d ∈ (pairInst f ps ms hms).ds}) ↔ _
  rw [hc]
  constructor
  · rintro ⟨h, hh, p, hp, he⟩
    have he' : Perm.sumCongr (encPair p) (f p) = Perm.sumCongr x h := he
    obtain ⟨h1, h2⟩ := sumCongr_inj' he'
    exact ⟨p, hp, h2 ▸ hh, h1⟩
  · rintro ⟨p, hp, hf, rfl⟩
    exact ⟨f p, hf, p, hp, rfl⟩

/-! ### The pointwise stabilizer of points of the first part -/

/-- The points of the first part, inside `Fin (k + q)`. -/
def leftPts (X : List (Fin k)) : List (Fin (k + q)) := X.map (Fin.castAdd q)

theorem mem_pointwiseStab_pairs (ps : List (Perm (Fin k) × Perm (Fin q))) (X : List (Fin k))
    (x : Perm (Fin (k + q))) :
    x ∈ pointwiseStab (gens (ps.map encPair)) (leftPts X) ↔
      ∃ p ∈ Subgroup.closure {p | p ∈ ps}, (∀ i ∈ X, p.1 i = i) ∧ encPair p = x := by
  show (x ∈ gens (ps.map encPair) ∧ ∀ i ∈ leftPts X, x i = i) ↔ _
  rw [mem_gens_encPair]
  constructor
  · rintro ⟨⟨p, hp, rfl⟩, hfix⟩
    refine ⟨p, hp, fun i hi => ?_, rfl⟩
    have := congrArg Fin.val (hfix (Fin.castAdd q i) (List.mem_map_of_mem hi))
    rw [encPair_eq, sumToFin_sumCongr_castAdd] at this
    exact Fin.ext this
  · rintro ⟨p, hp, hfix, rfl⟩
    refine ⟨⟨p, hp, rfl⟩, fun j hj => ?_⟩
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hj
    apply Fin.ext
    rw [encPair_eq, sumToFin_sumCongr_castAdd, hfix i hi]
    rfl

/-! ### The graph of a subgroup of `G` -/

section Graph

variable {Ω C : Type} (e : Ω ≃ Fin k) {S : State Ω C} (L : GiantLabels S)

/-- `g ↦ (g on positions, π g)` on `G`. -/
noncomputable def gpair : S.G →* Perm (Fin k) × Perm (Fin L.q) :=
  MonoidHom.prod ((toFin e).toMonoidHom.comp S.G.subtype)
    ((alternatingGroup (Fin L.q)).subtype.comp L.π)

/-- **The graph of a subgroup** `A` of `G`: the pairs `(a, π a)` for `a ∈ A ∩ G`. -/
noncomputable def graphOf (A : Subgroup (Perm Ω)) : Subgroup (Perm (Fin k) × Perm (Fin L.q)) :=
  (A.subgroupOf S.G).map (gpair e L)

/-- **A graph-form generating list** of `A`: pairs that generate the graph of `A`. -/
def PairGens (A : Subgroup (Perm Ω)) (ps : List (Perm (Fin k) × Perm (Fin L.q))) : Prop :=
  Subgroup.closure {p | p ∈ ps} = graphOf e L A

theorem mem_graphOf {A : Subgroup (Perm Ω)} {p : Perm (Fin k) × Perm (Fin L.q)} :
    p ∈ graphOf e L A ↔ ∃ g, ∃ hg : g ∈ S.G, g ∈ A ∧ toFin e g = p.1 ∧
      ((L.π ⟨g, hg⟩ : alternatingGroup (Fin L.q)) : Perm (Fin L.q)) = p.2 := by
  simp only [graphOf, Subgroup.mem_map, Subgroup.mem_subgroupOf]
  constructor
  · rintro ⟨⟨g, hg⟩, hA, rfl⟩
    exact ⟨g, hg, hA, rfl, rfl⟩
  · rintro ⟨g, hg, hA, h1, h2⟩
    exact ⟨⟨g, hg⟩, hA, Prod.ext h1 h2⟩

/-- **The graph is a function**: two pairs of graphs with the same first part are equal. -/
theorem graph_fst_inj {A B : Subgroup (Perm Ω)} {p p' : Perm (Fin k) × Perm (Fin L.q)}
    (hp : p ∈ graphOf e L A) (hp' : p' ∈ graphOf e L B) (h : p.1 = p'.1) : p = p' := by
  obtain ⟨g, hg, -, h1, h2⟩ := (mem_graphOf e L).1 hp
  obtain ⟨g', hg', -, h1', h2'⟩ := (mem_graphOf e L).1 hp'
  have hgg : g = g' := (toFin e).injective (h1.trans (h.trans h1'.symm))
  subst hgg
  exact Prod.ext h (h2.symm.trans h2')

variable {e L}

/-- **The label image of `A`** is generated by the second parts. -/
theorem mem_gens_snd {A : Subgroup (Perm Ω)} {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L A ps) (σ : Perm (Fin L.q)) :
    σ ∈ gens (ps.map Prod.snd) ↔ ∃ g, ∃ hg : g ∈ S.G, g ∈ A ∧
      ((L.π ⟨g, hg⟩ : alternatingGroup (Fin L.q)) : Perm (Fin L.q)) = σ := by
  rw [gens_snd, hps, Subgroup.mem_map]
  constructor
  · rintro ⟨p, hp, rfl⟩
    obtain ⟨g, hg, hA, -, h2⟩ := (mem_graphOf e L).1 hp
    exact ⟨g, hg, hA, h2⟩
  · rintro ⟨g, hg, hA, rfl⟩
    exact ⟨gpair e L ⟨g, hg⟩, (mem_graphOf e L).2 ⟨g, hg, hA, rfl, rfl⟩, rfl⟩

/-- **`A ∩ G` (on positions)** is generated by the first parts. -/
theorem mem_gens_fst {A : Subgroup (Perm Ω)} {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L A ps) (a : Perm (Fin k)) :
    a ∈ gens (ps.map Prod.fst) ↔ ∃ g ∈ S.G, g ∈ A ∧ toFin e g = a := by
  rw [gens_fst, hps, Subgroup.mem_map]
  constructor
  · rintro ⟨p, hp, rfl⟩
    obtain ⟨g, hg, hA, h1, -⟩ := (mem_graphOf e L).1 hp
    exact ⟨g, hg, hA, h1⟩
  · rintro ⟨g, hg, hA, rfl⟩
    exact ⟨gpair e L ⟨g, hg⟩, (mem_graphOf e L).2 ⟨g, hg, hA, rfl, rfl⟩, rfl⟩

/-- The preimage of `M ≤ Sym(Γ)` under `π`, inside `G`. -/
def labPre (M : Subgroup (Perm (Fin L.q))) : Subgroup (Perm Ω) where
  carrier := {g | ∃ hg : g ∈ S.G, ((L.π ⟨g, hg⟩ : alternatingGroup (Fin L.q)) : Perm (Fin L.q)) ∈ M}
  one_mem' := ⟨S.G.one_mem, by
    have : (⟨1, S.G.one_mem⟩ : S.G) = 1 := rfl
    rw [this, map_one]; exact M.one_mem⟩
  mul_mem' := fun {a b} ⟨ha, hma⟩ ⟨hb, hmb⟩ => ⟨S.G.mul_mem ha hb, by
    have : (⟨a * b, S.G.mul_mem ha hb⟩ : S.G) = ⟨a, ha⟩ * ⟨b, hb⟩ := rfl
    rw [this, map_mul]; exact M.mul_mem hma hmb⟩
  inv_mem' := fun {a} ⟨ha, hma⟩ => ⟨S.G.inv_mem ha, by
    have : (⟨a⁻¹, S.G.inv_mem ha⟩ : S.G) = (⟨a, ha⟩ : S.G)⁻¹ := rfl
    rw [this, map_inv]; exact M.inv_mem hma⟩

/-- The `k`-position preimage of a set of positions: the elements of `G` fixing them. -/
def fixPos (X : List (Fin k)) : Subgroup (Perm Ω) where
  carrier := {g | ∀ i ∈ X, toFin e g i = i}
  one_mem' := fun i _ => by simp
  mul_mem' := fun {a b} ha hb i hi => by
    rw [map_mul, Perm.mul_apply, hb i hi, ha i hi]
  inv_mem' := fun {a} ha i hi => by
    rw [map_inv, Perm.inv_eq_iff_eq, ha i hi]

/-- The graph of `A ∩ π⁻¹(M)` is the part of the graph of `A` with second part in `M`. -/
theorem graphOf_inf_labPre (A : Subgroup (Perm Ω)) (M : Subgroup (Perm (Fin L.q))) :
    graphOf e L (A ⊓ labPre (L := L) M) = graphOf e L A ⊓ M.comap (MonoidHom.snd _ _) := by
  ext p
  rw [Subgroup.mem_inf, mem_graphOf, mem_graphOf, Subgroup.mem_comap]
  constructor
  · rintro ⟨g, hg, ⟨hA, hg', hM⟩, h1, h2⟩
    refine ⟨⟨g, hg, hA, h1, h2⟩, ?_⟩
    show p.2 ∈ M
    rw [← h2]; exact hM
  · rintro ⟨⟨g, hg, hA, h1, h2⟩, hM⟩
    refine ⟨g, hg, ⟨hA, hg, ?_⟩, h1, h2⟩
    rw [h2]; exact hM

/-- The graph of `A ∩ Fix(X)` is the part of the graph of `A` whose first part fixes `X`. -/
theorem graphOf_inf_fixPos (A : Subgroup (Perm Ω)) (X : List (Fin k)) :
    graphOf e L (A ⊓ fixPos (e := e) X) = graphOf e L A ⊓
      (fixPos (e := Equiv.refl (Fin k)) X).comap ((toFin (Equiv.refl (Fin k))).toMonoidHom.comp
        (MonoidHom.fst _ _)) := by
  ext p
  rw [Subgroup.mem_inf, mem_graphOf, mem_graphOf, Subgroup.mem_comap]
  have hrefl : ∀ a : Perm (Fin k), toFin (Equiv.refl (Fin k)) a = a := fun a => by
    ext i; simp [toFin, Equiv.permCongrHom]
  constructor
  · rintro ⟨g, hg, ⟨hA, hX⟩, h1, h2⟩
    refine ⟨⟨g, hg, hA, h1, h2⟩, fun i hi => ?_⟩
    simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, Function.comp_apply,
      MonoidHom.coe_fst, hrefl]
    rw [← h1]; exact hX i hi
  · rintro ⟨⟨g, hg, hA, h1, h2⟩, hX⟩
    refine ⟨g, hg, ⟨hA, fun i hi => ?_⟩, h1, h2⟩
    have := hX i hi
    simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, Function.comp_apply,
      MonoidHom.coe_fst, hrefl] at this
    rw [h1]; exact this

/-- **Decoding**: a list of encoded pairs that generates the image of a subgroup of pairs
generates that subgroup as pairs. -/
theorem closure_of_gens_encPair {H : Subgroup (Perm (Fin k) × Perm (Fin q))}
    {qs : List (Perm (Fin k) × Perm (Fin q))}
    (h : gens (qs.map encPair) = H.map (encPairHom k q)) :
    Subgroup.closure {p | p ∈ qs} = H := by
  rw [gens_map_encPair] at h
  exact Subgroup.map_injective encPairHom_injective h

/-- The preimage set of `pairInst` as the image of a subgroup of pairs. -/
theorem preimageSet_pairInst_eq {n' : ℕ} (f : Perm (Fin k) × Perm (Fin q) →* Perm (Fin n'))
    (ps : List (Perm (Fin k) × Perm (Fin q))) (ms : List (Perm (Fin n')))
    (hms : ∀ m ∈ ms, ∃ p ∈ Subgroup.closure {p | p ∈ ps}, f p = m) :
    ∀ x : Perm (Fin (k + q)), x ∈ preimageSet (pairInst f ps ms hms) ↔
      x ∈ (Subgroup.closure {p | p ∈ ps} ⊓ (gens ms).comap f).map (encPairHom k q) := by
  intro x
  rw [mem_preimageSet_pairInst]
  simp only [Subgroup.mem_map, Subgroup.mem_inf, Subgroup.mem_comap]
  constructor
  · rintro ⟨p, hp, hf, rfl⟩; exact ⟨p, ⟨hp, hf⟩, rfl⟩
  · rintro ⟨p, ⟨hp, hf⟩, rfl⟩; exact ⟨p, hp, hf, rfl⟩

/-- **The preimage task gives the graph form of `A ∩ π⁻¹⟨ms⟩`**, for `ms ⊆ π(A)`: if the
returned list `qs.map encPair` generates the preimage set, then `qs` is a graph-form generating
list of `A ∩ π⁻¹⟨ms⟩`. -/
theorem pairGens_labPre {A : Subgroup (Perm Ω)} {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L A ps) (ms : List (Perm (Fin L.q)))
    (hms : ∀ m ∈ ms, ∃ p ∈ Subgroup.closure {p | p ∈ ps}, MonoidHom.snd _ _ p = m)
    {qs : List (Perm (Fin k) × Perm (Fin L.q))}
    (hqs : ∀ x : Perm (Fin (k + L.q)), x ∈ gens (qs.map encPair) ↔
      x ∈ preimageSet (pairInst (MonoidHom.snd _ _) ps ms hms)) :
    PairGens e L (A ⊓ labPre (L := L) (gens ms)) qs := by
  have h : gens (qs.map encPair) = _ := Subgroup.ext fun x =>
    (hqs x).trans (preimageSet_pairInst_eq _ ps ms hms x)
  have := closure_of_gens_encPair h
  unfold PairGens
  rw [this, graphOf_inf_labPre, hps]

/-- **The pointwise stabilizer task gives the graph form of `A ∩ Fix(X)`.** -/
theorem pairGens_fixPos {A : Subgroup (Perm Ω)} {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L A ps) (X : List (Fin k)) {qs : List (Perm (Fin k) × Perm (Fin L.q))}
    (hqs : gens (qs.map encPair) = pointwiseStab (gens (ps.map encPair)) (leftPts X)) :
    PairGens e L (A ⊓ fixPos (e := e) X) qs := by
  have hrefl : ∀ a : Perm (Fin k), toFin (Equiv.refl (Fin k)) a = a := fun a => by
    ext i; simp [toFin, Equiv.permCongrHom]
  have h : pointwiseStab (gens (ps.map encPair)) (leftPts X) =
      (Subgroup.closure {p | p ∈ ps} ⊓
        (fixPos (e := Equiv.refl (Fin k)) X).comap ((toFin (Equiv.refl (Fin k))).toMonoidHom.comp
          (MonoidHom.fst _ _))).map (encPairHom k L.q) := by
    ext x
    rw [mem_pointwiseStab_pairs]
    simp only [Subgroup.mem_map, Subgroup.mem_inf, Subgroup.mem_comap]
    constructor
    · rintro ⟨p, hp, hX, rfl⟩
      refine ⟨p, ⟨hp, fun i hi => ?_⟩, rfl⟩
      simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, Function.comp_apply,
        MonoidHom.coe_fst, hrefl]
      exact hX i hi
    · rintro ⟨p, ⟨hp, hX⟩, rfl⟩
      refine ⟨p, hp, fun i hi => ?_, rfl⟩
      have := hX i hi
      simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, Function.comp_apply,
        MonoidHom.coe_fst, hrefl] at this
      exact this
  rw [h] at hqs
  have := closure_of_gens_encPair hqs
  unfold PairGens
  rw [this, graphOf_inf_fixPos, hps]

end Graph

end GI.Impl
