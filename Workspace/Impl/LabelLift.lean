import Workspace.Impl.AggPairs
import Workspace.Impl.RowPart

/-!
# Lifting a label permutation to the group, with one factorization

The construction of Theorem A.17 lifts chosen permutations of the labels to elements of `G`
(Section A.5: "lifts of prescribed top permutations, are computable by pointwise stabilizers and
constructive membership"). One call of the cited **NormalizedFactor** task does this.

Let `H ≤ Sym(k) × Sym(q)` be generated by pairs `ps` (in the use, the graph `(g, π g)` of `G`),
and let `σ` be a label permutation with `(a, σ) ∈ H` for some `a`. On `Fin (k + q)`:

* the encoded pairs `a ⊕ b` of `H` form a group `Ĥ`;
* the elements `a ⊕ 1` for `a` in the first projection of `H` form a group `N̂`, which `Ĥ`
  normalizes (`normalizes_pairs`);
* `x = 1 ⊕ σ` lies in `Ĥ N̂`, since `1 ⊕ σ = (a ⊕ σ)(a⁻¹ ⊕ 1)`.

The task returns `x = h m` with `h = a' ⊕ b' ∈ Ĥ` and `m = n ⊕ 1 ∈ N̂`. Comparing the second
parts gives `b' = σ`, so `(a', σ) ∈ H` (`factor_lift`). The program splits `h` into its parts
(`pSplit_spec`) and returns `a'`.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm
open GI.Machine (BinOp)
open GI.Cited (Val encPerm encGroup gens sumToFin NormalizedFactor)

variable {k q : ℕ}

/-! ### The groups -/

/-- `(a, b) ↦ (a, 1)`. -/
def fstOne (k q : ℕ) : Perm (Fin k) × Perm (Fin q) →* Perm (Fin k) × Perm (Fin q) :=
  MonoidHom.prod (MonoidHom.fst _ _) 1

/-- The pairs `(a, 1)` of a list of pairs. -/
def onePairs (ps : List (Perm (Fin k) × Perm (Fin q))) : List (Perm (Fin k) × Perm (Fin q)) :=
  ps.map (fstOne k q)

theorem closure_onePairs (ps : List (Perm (Fin k) × Perm (Fin q))) :
    Subgroup.closure {p | p ∈ onePairs ps} = (Subgroup.closure {p | p ∈ ps}).map (fstOne k q) := by
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  simp [onePairs]

/-- **`Ĥ` normalizes `N̂`.** -/
theorem normalizes_pairs (ps : List (Perm (Fin k) × Perm (Fin q))) :
    Normalizes (gens (ps.map encPair)) (gens ((onePairs ps).map encPair)) := by
  intro g hg x hx
  obtain ⟨p, hp, rfl⟩ := mem_gens_encPair.1 hg
  obtain ⟨p', hp', rfl⟩ := mem_gens_encPair.1 hx
  rw [closure_onePairs] at hp'
  obtain ⟨r, hr, rfl⟩ := Subgroup.mem_map.1 hp'
  refine mem_gens_encPair.2 ⟨p * fstOne k q r * p⁻¹, ?_, ?_⟩
  · rw [closure_onePairs]
    refine Subgroup.mem_map.2 ⟨p * r * p⁻¹, ?_, ?_⟩
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hp hr) (Subgroup.inv_mem _ hp)
    · ext i <;> simp [fstOne]
  · simp only [encPair, map_mul, map_inv]

/-- **`1 ⊕ σ` lies in `Ĥ N̂`.** -/
theorem one_sigma_mem (ps : List (Perm (Fin k) × Perm (Fin q))) {σ : Perm (Fin q)}
    (hσ : ∃ a, (a, σ) ∈ Subgroup.closure {p | p ∈ ps}) :
    ∃ g ∈ gens (ps.map encPair), ∃ m ∈ gens ((onePairs ps).map encPair),
      encPair ((1 : Perm (Fin k)), σ) = g * m := by
  obtain ⟨a, ha⟩ := hσ
  refine ⟨encPair (a, σ), mem_gens_encPair.2 ⟨_, ha, rfl⟩, encPair (fstOne k q (a, σ)⁻¹),
    mem_gens_encPair.2 ⟨_, ?_, rfl⟩, ?_⟩
  · rw [closure_onePairs]
    exact Subgroup.mem_map.2 ⟨_, Subgroup.inv_mem _ ha, rfl⟩
  · simp only [encPair, ← map_mul]
    congr 1
    ext i <;> simp [fstOne]

/-- **The factorization gives a lift**: if `1 ⊕ σ = h m` with `h ∈ Ĥ`, `m ∈ N̂`, then
`h = a' ⊕ σ` for a pair `(a', σ)` of `H`. -/
theorem factor_labelLift (ps : List (Perm (Fin k) × Perm (Fin q))) {σ : Perm (Fin q)}
    {h m : Perm (Fin (k + q))} (hh : h ∈ gens (ps.map encPair))
    (hm : m ∈ gens ((onePairs ps).map encPair)) (hx : encPair ((1 : Perm (Fin k)), σ) = h * m) :
    ∃ a', h = encPair (a', σ) ∧ (a', σ) ∈ Subgroup.closure {p | p ∈ ps} := by
  obtain ⟨p, hp, rfl⟩ := mem_gens_encPair.1 hh
  obtain ⟨p', hp', rfl⟩ := mem_gens_encPair.1 hm
  rw [closure_onePairs] at hp'
  obtain ⟨r, -, rfl⟩ := Subgroup.mem_map.1 hp'
  have h2 : ((1 : Perm (Fin k)), σ) = p * fstOne k q r := by
    apply encPair_injective
    rw [hx]
    simp only [encPair, map_mul]
  have hs : σ = p.2 := by
    have := congrArg Prod.snd h2
    simpa [fstOne] using this
  refine ⟨p.1, ?_, ?_⟩
  · rw [hs]
  · rw [hs]; exact hp

/-! ### The program -/

/-- The four functions of `shiftApp` at `b + 1 … b + 8` (as in `NatAt`). -/
structure ShiftAt (P : Program) (b : ℕ) : Prop where
  shiftApp : P.funs[b + 1]? = some (shiftAppF (b + 2) (b + 5))
  append : P.HasAt (b + 2) (appendFuns (b + 2))
  addMap : P.HasAt (b + 5) (mapFuns (b + 5) (b + 8))
  addK : P.funs[b + 8]? = some addKF

theorem NatAt.shiftAt {P : Program} {b jpre : ℕ} (h : NatAt P b jpre) : ShiftAt P b :=
  ⟨h.shiftApp, h.append, h.addMap, h.addK⟩

/-- The context of the label lift: `[k, Ĥ, N̂, [k, [1_k, 1_q]]]`. -/
def liftLabCtx (k q : ℕ) (ps : List (Perm (Fin k) × Perm (Fin q))) : Val :=
  .list [.nat k, encGroup (ps.map encPair), encGroup ((onePairs ps).map encPair), pSplitCtx k q]

/-- **The label lift**, on `[ctx, σ]`: factor `1 ⊕ σ` in `Ĥ N̂` (the primitive at `jfac`), split
the first factor (the split module at `sp`), and return its first part. `shiftApp` sits at
`sb + 1`. -/
def liftLabF (sb sp jfac : ℕ) : Expr :=
  .letE (.prim jfac (mk3 (.get (arg 0) (.nat 1)) (.get (arg 0) (.nat 2))
      (.call (sb + 1) (mk3 (.get (.get (.get (arg 0) (.nat 3)) (.nat 1)) (.nat 0)) (arg 1)
        (.get (arg 0) (.nat 0))))))
    (.get (.call sp (mk2 (.get (arg 0) (.nat 3)) (.get (.var 1) (.nat 0)))) (.nat 0))

/-- A prim bound on an input of weight at most `W`. -/
theorem prim_bound_le_wt (p : Prim) {v : Val} {W : ℕ} (h : v.wt ≤ W) :
    p.bound v ≤ p.c * (W + 2) ^ p.k :=
  Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by have := v.size_le_wt; omega) _)

/-- The constant of the label lift. -/
def liftLabK : ℕ := 10 ^ 13

/-- The cost bound of the label lift, with `M = |ps| + k + q + 2`. -/
def liftLabCost (pf : Prim) (M : ℕ) : ℕ := pf.c * (2000 * M ^ 4 + 2) ^ pf.k + liftLabK * M ^ 6

theorem wt_liftLabCtx_le (ps : List (Perm (Fin k) × Perm (Fin q))) :
    (liftLabCtx k q ps).wt ≤ 400 * (ps.length + k + q + 2) ^ 4 := by
  set M := ps.length + k + q + 2 with hM
  have hm : (ps.length + 2) * (k + q + 1) ≤ M ^ 2 := by
    calc (ps.length + 2) * (k + q + 1) ≤ M * M := Nat.mul_le_mul (by omega) (by omega)
      _ = M ^ 2 := by ring
  have hm4 : ((ps.length + 2) * (k + q + 1)) ^ 2 ≤ M ^ 4 := by
    calc _ ≤ (M ^ 2) ^ 2 := Nat.pow_le_pow_left hm 2
      _ = M ^ 4 := by ring
  have g1 := wt_encGroup_le (ps.map encPair)
  have g2 := wt_encGroup_le ((onePairs ps).map encPair)
  simp only [List.length_map, onePairs] at g1 g2
  have h1 := wt_list4_le (.nat k) (encGroup (ps.map encPair))
    (encGroup ((onePairs ps).map encPair)) (pSplitCtx k q)
  have hk := wt_nat_le k
  have hs : (pSplitCtx k q).wt ≤ 50 * M ^ 2 := by
    have a1 := wt_list2_le (.nat k) (idsVal k q)
    have a2 := wt_list2_le (encPerm (1 : Perm (Fin k))) (encPerm (1 : Perm (Fin q)))
    have a3 := wt_encPerm_le (1 : Perm (Fin k))
    have a4 := wt_encPerm_le (1 : Perm (Fin q))
    have b1 : (k + 1) ^ 2 ≤ M ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have b2 : (q + 1) ^ 2 ≤ M ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have b3 : M ≤ M ^ 2 := Nat.le_self_pow (by norm_num) _
    unfold pSplitCtx idsVal at *
    omega
  have b4 : M ^ 2 ≤ M ^ 4 := Nat.pow_le_pow_right (by omega) (by omega)
  have b5 : M ≤ M ^ 2 := Nat.le_self_pow (by norm_num) _
  unfold liftLabCtx onePairs
  simp only [onePairs] at h1
  omega

/-- **The label lift.** For pairs `ps` generating `H` and a label permutation `σ` with
`(a, σ) ∈ H` for some `a`, the function returns `encPerm a'` for some `a'` with `(a', σ) ∈ H`.
It uses the cited task **NormalizedFactor** once. -/
theorem liftLab_spec (hfac : NormalizedFactor) {P : Program} {f sb sp jfac : ℕ}
    (hf : P.funs[f]? = some (liftLabF sb sp jfac)) (hs : ShiftAt P sb)
    (hsp : P.HasAt sp (pSplitFuns sp)) (hj : P.prims[jfac]? = some (normalizedFactorPrim hfac))
    (ps : List (Perm (Fin k) × Perm (Fin q))) {σ : Perm (Fin q)}
    (hσ : ∃ a, (a, σ) ∈ Subgroup.closure {p | p ∈ ps}) :
    FunAll P f (.list [liftLabCtx k q ps, encPerm σ]) (fun w c => ∃ a, w = encPerm a ∧
      (a, σ) ∈ Subgroup.closure {p | p ∈ ps} ∧
      c ≤ liftLabCost (normalizedFactorPrim hfac) (ps.length + k + q + 2)) := by
  set ctx := liftLabCtx k q ps with hctx
  set inp := Val.list [ctx, encPerm σ] with hinp
  set GV := encGroup (ps.map encPair) with hGV
  set NV := encGroup ((onePairs ps).map encPair) with hNV
  set M := ps.length + k + q + 2 with hM
  refine FunAll.intro hf ?_
  -- reads
  have g0 := Det.arg' (P := P) (vs := [ctx, encPerm σ]) (rest := []) (j := 0) rfl
  have g1 := Det.arg' (P := P) (vs := [ctx, encPerm σ]) (rest := []) (j := 1) rfl
  have dG := Det.get' g0 (Det.nat 1) (vs := [.nat k, GV, NV, pSplitCtx k q]) (v := GV) rfl
  have dN := Det.get' g0 (Det.nat 2) (vs := [.nat k, GV, NV, pSplitCtx k q]) (v := NV) rfl
  have dS := Det.get' g0 (Det.nat 3) (vs := [.nat k, GV, NV, pSplitCtx k q]) (v := pSplitCtx k q)
    rfl
  have dK := Det.get' g0 (Det.nat 0) (vs := [.nat k, GV, NV, pSplitCtx k q]) (v := .nat k) rfl
  have dI := Det.get' dS (Det.nat 1) (vs := [.nat k, idsVal k q]) (v := idsVal k q) rfl
  have d1 := Det.get' dI (Det.nat 0)
    (vs := [encPerm (1 : Perm (Fin k)), encPerm (1 : Perm (Fin q))]) (v := encPerm 1) rfl
  have dx := Det.call (Det.mk3 d1 g1 dK)
    (shiftApp_spec hs.shiftApp hs.append hs.addMap hs.addK (1 : Perm (Fin k)) σ)
  rw [← encPair_eq ((1 : Perm (Fin k)), σ)] at dx
  have da := Det.mk3 dG dN dx
  have hcall := normalizedFactor_call hfac hj da (G := gens (ps.map encPair))
    (N := gens ((onePairs ps).map encPair)) ⟨_, rfl, rfl⟩ ⟨_, rfl, rfl⟩ (normalizes_pairs ps)
    (one_sigma_mem ps hσ)
  refine EvalAll.letE hcall fun w cw hw => ?_
  obtain ⟨⟨h, hh, m, hm, hx, rfl⟩, hcw⟩ := hw
  obtain ⟨a', rfl, ha'⟩ := factor_labelLift ps hh hm hx
  -- split the first factor
  have e0 := Det.arg' (P := P) (vs := [ctx, encPerm σ])
    (rest := [.list [encPerm (encPair (a', σ)), encPerm m]]) (j := 0) rfl
  have eS := Det.get' e0 (Det.nat 3) (vs := [.nat k, GV, NV, pSplitCtx k q]) (v := pSplitCtx k q)
    rfl
  have eW := Det.var' (P := P) (env := [inp, .list [encPerm (encPair (a', σ)), encPerm m]])
    (i := 1) (v := .list [encPerm (encPair (a', σ)), encPerm m]) rfl
  have eH := Det.get' eW (Det.nat 0) (vs := [encPerm (encPair (a', σ)), encPerm m])
    (v := encPerm (encPair (a', σ))) rfl
  have eP := Det.call (Det.mk2 eS eH) (pSplit_spec hsp (a', σ))
  have eA := Det.get' eP (Det.nat 0) (vs := [encPerm a', encPerm σ]) (v := encPerm a') rfl
  refine eA.post fun c hc => ⟨a', rfl, ha', ?_⟩
  -- the cost
  clear eA eP eH eW eS e0 hcall da dx d1 dI dK dS dN dG g0 g1
  have hctxE : ctx = .list [.nat k, GV, NV, pSplitCtx k q] := rfl
  have hpw : (pairV (a', σ)).wt = (Val.list [encPerm a', encPerm σ]).wt := rfl
  have wctx : ctx.wt ≤ 400 * M ^ 4 := wt_liftLabCtx_le ps
  clear_value inp ctx GV NV M
  have hM2 : 2 ≤ M := by omega
  have q1 : (k + 1) ^ 2 ≤ M ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have q2 : (q + 1) ^ 2 ≤ M ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have q3 : (k + q + 1) ^ 2 ≤ M ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have q4 : (k + q + 1) ^ 3 ≤ M ^ 6 :=
    (Nat.pow_le_pow_left (show k + q + 1 ≤ M by omega) 3).trans
      (Nat.pow_le_pow_right (by omega) (by omega))
  have q5 : (k + q + 1) ^ 6 ≤ M ^ 6 := Nat.pow_le_pow_left (by omega) 6
  have p24 : M ^ 2 ≤ M ^ 4 := Nat.pow_le_pow_right (by omega) (by omega)
  have p46 : M ^ 4 ≤ M ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
  have p12 : M ≤ M ^ 2 := Nat.le_self_pow (by norm_num) _
  have wσ := wt_encPerm_le σ
  have w1k := wt_encPerm_le (1 : Perm (Fin k))
  have wa := wt_encPerm_le a'
  have wx := wt_encPerm_le (encPair ((1 : Perm (Fin k)), σ))
  have wh := wt_encPerm_le (encPair (a', σ))
  have wm := wt_encPerm_le m
  have wk := wt_nat_le k
  have winp := wt_list2_le ctx (encPerm σ)
  have wGV : GV.wt < ctx.wt := by
    rw [hctxE]; exact wt_le_wt_list (by simp only [List.mem_cons, true_or, or_true])
  have wNV : NV.wt < ctx.wt := by
    rw [hctxE]; exact wt_le_wt_list (by simp only [List.mem_cons, true_or, or_true])
  have wS : (pSplitCtx k q).wt < ctx.wt := by
    rw [hctxE]; exact wt_le_wt_list (by simp only [List.mem_cons, true_or, or_true])
  have wI : (idsVal k q).wt < (pSplitCtx k q).wt :=
    wt_le_wt_list (vs := [.nat k, idsVal k q]) (by simp only [List.mem_cons, true_or, or_true])
  have w3 := wt_list3_le (encPerm (1 : Perm (Fin k))) (encPerm σ) (.nat k)
  have w4 := wt_list3_le GV NV (encPerm (encPair ((1 : Perm (Fin k)), σ)))
  have w5 := wt_list2_le (encPerm (encPair (a', σ))) (encPerm m)
  have w6 := wt_list2_le (pSplitCtx k q) (encPerm (encPair (a', σ)))
  have w7 := wt_list2_le (encPerm a') (encPerm σ)
  have hW : (Val.list [GV, NV, encPerm (encPair ((1 : Perm (Fin k)), σ))]).wt ≤ 2000 * M ^ 4 := by
    omega
  have hb := prim_bound_le_wt (normalizedFactorPrim hfac) hW
  unfold pSplitCost at hc
  unfold shiftK at hcw
  unfold liftLabCost liftLabK
  clear hm hh hx ha' hσ hctxE
  omega

end GI.Impl
