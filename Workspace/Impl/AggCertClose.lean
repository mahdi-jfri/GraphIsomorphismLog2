module

public import Workspace.Impl.AggCertStart
public import Workspace.Impl.AggClosProg

@[expose] public section

/-!
# The end of a round, on program data

After the answer of the last window call of a round, the program forms the new stage: the
graph form of the lift of `A_{t+1} = ⟨⋃ τ · (answer of τ)⟩` from the collected generators
(`stageGens`) by one **Preimage** call on the graph of `G` (`clos_spec`), and the points outside
the new window `W_{t+1} = W_t ∪ V_t`.

* `pairGens_newStage'`: `pairGens_newStage` with the output form of `clos_spec`.
* `grp_succ_eq_union`: `A_{t+1}` is generated by the union of the translated exact answers of
  the representatives of the round.
* `CpRoundInv.close`: the data of round `t + 1`.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang GI.Endpoint GI.LocalGroups Equiv Equiv.Perm
open GI.Cited (Val encPerm encGroup encPts gens)
open scoped Pointwise

section Close

variable {k : ℕ} {Ω C : Type} {e : Ω ≃ Fin k} {S : State Ω C} {L : GiantLabels S}

/-- **The new stage in graph form**, from the output form of `clos_spec`. -/
theorem pairGens_newStage' {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L S.G ps) {ι : Type} (l : List ι)
    (a : ι → Perm (Fin k)) (o : ι → Option (Perm (Fin k) × List (Perm (Fin k))))
    (B : ι → Set (Perm Ω))
    (hg : ∀ i ∈ l, (toFin e).symm (a i) ∈ S.G) (ho : ∀ i ∈ l, AnsSet e (o i) (B i))
    (hB : ∀ i ∈ l, B i ⊆ S.G)
    (hBK : ∀ i ∈ l, ∀ b ∈ B i, ∀ c (hc : c ∈ S.G), S.domHom ⟨c, hc⟩ = 1 → b * c ∈ B i)
    (hne : ∃ i ∈ l, (B i).Nonempty)
    {qs : List (Perm (Fin k) × Perm (Fin L.q))}
    (hqs : Subgroup.closure {p | p ∈ qs} = Subgroup.closure {p | p ∈ ps} ⊓
      (gens (stageGens (l.map fun i => (a i, o i)))).comap (MonoidHom.fst _ _)) :
    PairGens e L (S.liftGroup (Subgroup.closure (⋃ i ∈ l, ⋃ hi : i ∈ l,
      S.domHom ⟨(toFin e).symm (a i), hg i hi⟩ • restrictAns S (B i)))) qs := by
  have h1 : PairGens e L (posPre (e := e) (S := S) (stageGens (l.map fun i => (a i, o i)))) qs := by
    unfold PairGens
    rw [hqs, hps, graphOf_posPre]
  have hcl := closure_translates_lift S l (fun i => (toFin e).symm (a i)) B hg hB hBK hne
  rw [← hcl]
  convert h1 using 1
  symm
  refine posPre_eq ?_ ?_
  · rw [Subgroup.closure_le]
    intro y hy
    simp only [Set.mem_iUnion] at hy
    obtain ⟨i, hi, b, hb, rfl⟩ := hy
    exact S.G.mul_mem (hg i hi) (hB i hi hb)
  · rw [MonoidHom.map_closure]
    unfold stageGens
    rw [List.flatMap_map]
    rw [gens_flatMap l _ (fun i => toFin e '' ((toFin e).symm (a i) • B i))
      fun i hi => closure_ansGens e (a i) (o i) (B i) (ho i hi)]
    congr 1
    ext y
    simp only [Set.mem_iUnion, Set.mem_image, MulEquiv.coe_toMonoidHom]
    constructor
    · rintro ⟨i, hi, z, hz, rfl⟩; exact ⟨z, ⟨i, hi, hz⟩, rfl⟩
    · rintro ⟨z, ⟨i, hi, hz⟩, rfl⟩; exact ⟨i, hi, z, hz, rfl⟩

variable [DecidableEq Ω] [Fintype S.dom]

/-- **The next group is generated by the translated exact answers** of the representatives
`R.reps` of the round. -/
theorem grp_succ_eq_union {Q C₀ : Type} [Group Q] {P' : Subgroup (Perm S.dom)}
    (phi : P' →* Q) (z : S.dom → C₀) (hP : P' ≤ S.domGroup) (R : CosetRepFn S.dom) (t : ℕ) :
    grp phi z (t + 1) = Subgroup.closure
      (⋃ s ∈ cpAcc S phi z t (R.reps (grp phi z t) (kernelIn phi (grp phi z t))), s) := by
  classical
  rw [cpUnion_eq S phi z hP R t]
  have hset : GI.Algorithm.answer (grp phi z t) (inc phi z t : Set S.dom) z z =
      (automorphisms (grp phi z t) (mask z (inc phi z t)) : Set (Perm S.dom)) := by
    ext g
    rw [SetLike.mem_coe, mem_autWindow_iff _ z _ (inc_invariant phi z t)]
    simp [GI.Algorithm.answer]
  rw [hset, Subgroup.closure_eq, grp_succ]

end Close

section Data

variable {k : ℕ} {Ω C : Type} [DecidableEq Ω] {e : Ω ≃ Fin k} {S : State Ω C} [Fintype S.dom]
  {L : GiantLabels S} {πd : S.domGroup →* alternatingGroup (Fin L.q)}

theorem domHom_symm {a : Perm (Fin k)} (hg : (toFin e).symm a ∈ S.G) :
    S.domHom ⟨_, hg⟩ = domOfPos e S a := by
  rw [← domOfPos_toFin e S hg, (toFin e).apply_symm_apply]

/-- The data of the next round after a round: the stage of round `t` (the graph form `ps` of
`A_t` and the positions `incP` of `V_t`) is logged. -/
def CpSt.close {k q : ℕ} (σ : CpSt k q) (qs : GPairs k q) (osP incP : List (Fin (k + q))) :
    CpSt k q :=
  { σ with t := σ.t + 1, ps := qs, osP := osP, lz := σ.lz ++ [(σ.ps, incP)] }

/-- **The end of a round**: with the graph form `qs` of the new stage (`clos_spec` on the graph
`gp` of `G` and the collected generators) and the points `os'` outside the new window, the data
of round `t + 1`. -/
theorem CpRoundInv.close {σ : CpSt k L.q} {acc : List (StagePair S)} {T : Finset (Fin L.q)}
    {rec : List ((Subgroup (Perm S.dom) × Subgroup (Perm S.dom)) × List (Perm S.dom))}
    (h : CpRoundInv e πd σ acc T rec) (ht : σ.t < Fintype.card S.dom)
    {gp : GPairs k L.q} (hgp : PairGens e L S.G gp)
    {dn : List (Perm (Fin k) × Option (Perm (Fin k) × List (Perm (Fin k))))}
    (hl : ((grp (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t,
      kernelIn (cpPhi S πd T) (grp (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t)),
      (dn.map Prod.fst).map (domOfPos e S)) ∈ rec)
    (hG : ∀ b ∈ dn.map Prod.fst, (toFin e).symm b ∈ S.G)
    (ho : ∀ p ∈ dn, AnsSet e p.2 (cpCall πd T σ.s σ.t (domOfPos e S p.1)).answer)
    {qs : GPairs k L.q}
    (hqs : Subgroup.closure {p | p ∈ qs} = Subgroup.closure {p | p ∈ gp} ⊓
      (gens (stageGens dn)).comap (MonoidHom.fst _ _))
    {incl : List S.dom} (hinc : ∀ v, v ∈ incl ↔ v ∈ inc (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t)
    (hndi : incl.Nodup) (hpsl : σ.ps.length ≤ (k + L.q) ^ 2)
    {os' : List S.dom} (hnd : os'.Nodup)
    (hos' : ∀ v, v ∈ os' ↔ v ∉ win (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t ∧ v ∉ incl) :
    CpRoundInv e πd (σ.close qs (os'.map (domPos e L.q)) (incl.map (domPos e L.q))) acc T rec := by
  classical
  set z := dstr S (cpZ S σ.s) with hz
  set phi := cpPhi S πd T
  have hG' : ∀ i ∈ dn, (toFin e).symm i.1 ∈ S.G := fun i hi => hG _ (List.mem_map_of_mem hi)
  obtain ⟨R, hR⟩ := h.cache.1.cands_nonempty (CosetRepFn.default S.dom)
  have hreps := cands_reps hR hl
  have hRok := h.cache.1.2.2 _ hl
  have hA : grp phi z σ.t ≤ S.domGroup := (grp_le _ _ _).trans Pgrp_le
  -- the new group
  have hgrp := grp_succ_eq_union phi z Pgrp_le R σ.t
  rw [hreps] at hgrp
  have key : (⋃ s ∈ cpAcc S phi z σ.t ((dn.map Prod.fst).map (domOfPos e S)), s) =
      ⋃ i ∈ dn, ⋃ hi : i ∈ dn, S.domHom ⟨(toFin e).symm i.1, hG' i hi⟩ •
        restrictAns S (cpCall πd T σ.s σ.t (domOfPos e S i.1)).answer := by
    ext y
    simp only [cpAcc, List.map_map, Set.mem_iUnion, List.mem_map, Function.comp_apply,
      exists_prop]
    constructor
    · rintro ⟨_, ⟨i, hi, rfl⟩, hy⟩
      exact ⟨i, hi, hi, by rw [domHom_symm]; exact hy⟩
    · rintro ⟨i, hi, _, hy⟩
      refine ⟨_, ⟨i, hi, rfl⟩, ?_⟩
      rw [domHom_symm] at hy
      exact hy
  rw [key] at hgrp
  have hps : PairGens e L (S.liftGroup (grp phi z (σ.t + 1))) qs := by
    rw [hgrp]
    refine pairGens_newStage' hgp dn Prod.fst Prod.snd
      (fun i => (cpCall πd T σ.s σ.t (domOfPos e S i.1)).answer) hG' ho
      (fun i _ => windowCall_answer_le S _ _ _)
      (fun i _ b hb c hc hc1 => windowCall_answer_mul S _ _ _ hb hc hc1) ?_ ?_
    · obtain ⟨τ, hτ, hne⟩ := windowCall_answer_nonempty S hA inf_le_left
        (cpInv S phi z σ.t) z _ hRok.1 hRok.2.1
      obtain ⟨i, hi, rfl⟩ := List.mem_map.1 (by rw [List.map_map] at hτ; exact hτ)
      exact ⟨i, hi, hne⟩
    · simpa using hqs
  have hnk := cp_card_dom_le (S := S) e
  have hd : CpStg e πd T (cpZ S σ.s) σ.lz.length (σ.ps, incl.map (domPos e L.q)) := by
    refine ⟨?_, hpsl, incl, hndi, ?_, rfl⟩
    · rw [h.lz_len]; exact h.ps
    · rw [h.lz_len]; exact hinc
  have hil : (incl.map (domPos e L.q)).length ≤ k := by
    rw [List.length_map]; exact cp_os_length_le e hndi
  refine { h with
    t_le := ht
    ps := hps
    os := ⟨os', hnd, fun v => ?_, rfl⟩
    lz_len := ?_
    lz := cp_idx_snoc h.lz hd
    loglen := { h.loglen with
      lz := cpLgLen_snoc h.loglen.lz (by rw [h.lz_len]; omega) ⟨hpsl, hil⟩ } }
  · show v ∈ os' ↔ v ∉ win phi z (σ.t + 1)
    rw [hos', win_succ, Finset.mem_union, hinc]
    tauto
  · simp only [CpSt.close, List.length_append, List.length_singleton, h.lz_len]

end Data

end GI.Impl

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang GI.Endpoint GI.LocalGroups Equiv Equiv.Perm
open GI.Cited (Val encPerm encGroup encPts gens)
open scoped Pointwise

section Answer

variable {k : ℕ} {Ω C : Type} [DecidableEq Ω] {e : Ω ≃ Fin k} {S : State Ω C} [Fintype S.dom]
  {L : GiantLabels S} {πd : S.domGroup →* alternatingGroup (Fin L.q)}

/-- **The answer of the last window call of a round**: the program continues at the start of
round `t + 1` with the new stage `qs` and the points `os'` outside the new window. -/
theorem cp_answer_close {par : Val} {D Bw M₀ NT m f : ℕ} {st : Val}
    {acc : List (StagePair S)} {T : Finset (Fin L.q)} {σ : CpSt k L.q}
    {rec : List ((Subgroup (Perm S.dom) × Subgroup (Perm S.dom)) × List (Perm S.dom))}
    {acc' : List (Set (Perm S.dom))} {u : Val}
    {dn : List (Perm (Fin k) × Option (Perm (Fin k) × List (Perm (Fin k))))} {a : Perm (Fin k)}
    {hs : List (Perm (Fin k))} {dv : Val} {incl : List S.dom}
    (hm : m = cpMeas (Fintype.card S.dom) D (.win acc T σ.Ts σ.s σ.t [] acc')) (hmf : m ≤ f)
    (hM : σ.cache.length + m ≤ M₀) (hNT : σ.res.length + σ.Ts.length + 1 ≤ NT)
    (hW : CpWinInv e πd σ acc T rec (cpInnerV [] (stageGens dn) hs dv (incl.map (domPos e L.q)) a)
      u [] acc')
    -- what the inner data says (the data of `hW`, read back)
    (hl : ((grp (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t,
      kernelIn (cpPhi S πd T) (grp (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t)),
      (dn.map Prod.fst ++ [a]).map (domOfPos e S)) ∈ rec)
    (hG : ∀ b ∈ dn.map Prod.fst ++ [a], (toFin e).symm b ∈ S.G)
    (ho : ∀ p ∈ dn, AnsSet e p.2 (cpCall πd T σ.s σ.t (domOfPos e S p.1)).answer)
    (hacc : acc' = cpAcc S (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t
      ((dn.map Prod.fst ++ [a]).map (domOfPos e S)))
    (hinc : ∀ v, v ∈ incl ↔ v ∈ inc (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t)
    (hndi : incl.Nodup) (hpsl : σ.ps.length ≤ (k + L.q) ^ 2)
    -- what the program computes
    {o : Option (Perm (Fin k) × List (Perm (Fin k)))}
    (hao : AnsSet e o (cpCall πd T σ.s σ.t (domOfPos e S a)).answer)
    {gp : GPairs k L.q} (hgp : PairGens e L S.G gp) {qs : GPairs k L.q}
    (hqs : Subgroup.closure {p | p ∈ qs} = Subgroup.closure {p | p ∈ gp} ⊓
      (gens (stageGens (dn ++ [(a, o)]))).comap (MonoidHom.fst _ _))
    {os' : List S.dom} (hnd : os'.Nodup)
    (hos' : ∀ v, v ∈ os' ↔ v ∉ win (cpPhi S πd T) (dstr S (cpZ S σ.s)) σ.t ∧ v ∉ incl)
    {u' : Val} (hT : T = σ.T) (hlen : CpLen D (σ.close qs (os'.map (domPos e L.q)) (incl.map (domPos e L.q))))
    (hwt : (Val.list [CpSt.val par (σ.close qs (os'.map (domPos e L.q)) (incl.map (domPos e L.q))) (.list []), u']).wt ≤ Bw) :
    ∃ m' st' Ss', m' < m ∧
      Ss' ⊆ (fun R => cpAt S πd (dstr S S.x) (dstr S S.y) R
        (.win acc T σ.Ts σ.s σ.t [] acc')) '' Cands rec ∧
      CpRep e πd par D Bw M₀ NT m' st' Ss' f ∧
      st' = .list [CpSt.val par (σ.close qs (os'.map (domPos e L.q)) (incl.map (domPos e L.q))) (.list []), u'] := by
  obtain ⟨hR, ht, -, -⟩ := hW
  have hR' := hR.close ht hgp (dn := dn ++ [(a, o)]) (by simpa using hl)
    (by simpa using hG) (fun p hp => by
      rcases List.mem_append.1 hp with hp | hp
      · exact ho p hp
      · rw [List.mem_singleton.1 hp]; exact hao) hqs hinc hndi hpsl hnd hos'
  set pos : CpPos S L.q := .round acc T σ.Ts σ.s (σ.t + 1)
  have hlt : cpMeas (Fintype.card S.dom) D pos < m := by
    rw [hm]; exact cpMeas_close ht
  refine ⟨_, _, _, hlt, ?_, ⟨pos, σ.close qs (os'.map (domPos e L.q)) (incl.map (domPos e L.q)), rec, rfl, by omega, hwt,
    by simp only [CpSt.close]; omega, by simp only [CpSt.close]; omega, hlen, rfl, hT, rfl, rfl,
    rfl, hR', u', rfl⟩, rfl⟩
  rintro _ ⟨R, hRm, rfl⟩
  refine ⟨R, hRm, ?_⟩
  have h := cpAt_close S πd (dstr S S.x) (dstr S S.y) hRm acc T σ.Ts σ.s σ.t
    (l := (dn.map Prod.fst ++ [a]).map (domOfPos e S)) (by rw [cpStr_dstr]; exact hl)
  rw [cpStr_dstr] at h
  rw [hacc]
  exact h

end Answer

end GI.Impl
