import Workspace.Impl.NClMath
import Workspace.CitedChecks.AlgoChecks
import Mathlib.GroupTheory.Perm.Finite

/-!
# The mathematics of the preimage

An instance gives `D = ⟨ds⟩ ≤ Sym(Ω ⊔ Δ)` (`Ω = Fin n`, `Δ = Fin n'`), whose generators preserve
`Ω`, and `M = ⟨ms⟩ ≤ Sym(Δ)` inside the image of `D` on `Δ`. The program works with
`D' = ⟨sumToFin ds⟩ ≤ Sym(n + n')`, where the point `k` of `Δ` is `n + k` (`nclInDelta k`).

Every element of `D` has the form `g ⊕ h` (`nclClosure_ds_sum`), so every `x ∈ D'` restricts to a
permutation `nclRestr x` of `Ω`. The preimage is generated by the restrictions of
* one lift `x ∈ D'` of each `m ∈ ms`, that is `x (n + k) = n + m k` for all `k`, and
* generators of the pointwise stabilizer of `Δ` in `D'`, the kernel (`nclPreimage_gens`).
This is [LM, Theorem 3.1(vi)(b)]: lift the generators of `M`, and add the kernel.

A lift is found by sifting (`nclSift_step`, `nclSift_exists`): if `x ∈ D'` agrees with `m` on the
first `k` points of `Δ`, then some `t` in the pointwise stabilizer of those points maps
`n + k` to `x⁻¹ (n + m k)`, and `x t` agrees with `m` on the first `k + 1` points.
-/

namespace GI.Impl

open GI.Cited Equiv

variable {n n' : ℕ}

/-! ### `sumToFin` -/

theorem nclSumToFin_apply (a : Perm (Fin n ⊕ Fin n')) (x : Fin n ⊕ Fin n') :
    sumToFin a (finSumFinEquiv x) = finSumFinEquiv (a x) := by
  simp [sumToFin]

theorem nclSumToFin_mul (a b : Perm (Fin n ⊕ Fin n')) : sumToFin (a * b) = sumToFin a * sumToFin b := by
  ext i; simp [sumToFin, Perm.mul_apply]

theorem nclSumToFin_one : sumToFin (1 : Perm (Fin n ⊕ Fin n')) = 1 := by
  ext i; simp [sumToFin]

theorem nclSc_mul (a c : Perm (Fin n)) (b d : Perm (Fin n')) :
    sumCongr a b * sumCongr c d = sumCongr (a * c) (b * d) := Perm.sumCongr_mul a b c d

theorem nclSc_inv (a : Perm (Fin n)) (b : Perm (Fin n')) :
    (sumCongr a b)⁻¹ = sumCongr a⁻¹ b⁻¹ := Perm.sumCongr_inv a b

theorem nclSc_one : sumCongr (1 : Perm (Fin n)) (1 : Perm (Fin n')) = 1 := Perm.sumCongr_one

/-- `sumToFin` as a homomorphism. -/
def nclSumToFinHom : Perm (Fin n ⊕ Fin n') →* Perm (Fin (n + n')) :=
  ⟨⟨sumToFin, nclSumToFin_one⟩, nclSumToFin_mul⟩

/-- The point `k` of `Δ` as a point of `Fin (n + n')`; its value is `n + k`. -/
def nclInDelta (k : Fin n') : Fin (n + n') := finSumFinEquiv (Sum.inr k)

theorem nclInDelta_val (k : Fin n') : (nclInDelta (n := n) k : ℕ) = n + k := by
  simp [nclInDelta]

/-- The points of `Δ` below `k`. -/
def nclDeltaPts (n : ℕ) (k : ℕ) : List (Fin (n + n')) :=
  ((List.finRange n').take k).map nclInDelta

theorem nclMem_take_finRange {k : ℕ} {j : Fin n'} : j ∈ (List.finRange n').take k ↔ (j : ℕ) < k := by
  rw [List.mem_iff_getElem]
  constructor
  · rintro ⟨a, ha, rfl⟩
    simp only [List.length_take, List.length_finRange, lt_min_iff] at ha
    simp [ha.1]
  · intro hj
    exact ⟨j, by simp [hj, j.2], by simp⟩

theorem nclMem_deltaPts {k : ℕ} {p : Fin (n + n')} :
    p ∈ nclDeltaPts n k ↔ ∃ j : Fin n', (j : ℕ) < k ∧ nclInDelta j = p := by
  simp only [nclDeltaPts, List.mem_map, nclMem_take_finRange]

theorem nclDeltaPts_succ {k : ℕ} (hk : k < n') :
    nclDeltaPts (n' := n') n (k + 1) = nclDeltaPts n k ++ [nclInDelta ⟨k, hk⟩] := by
  simp only [nclDeltaPts, List.take_add_one, List.map_append]
  congr
  rw [List.getElem?_eq_getElem (by simpa using hk)]
  simp

theorem nclDeltaPts_zero : nclDeltaPts (n' := n') n 0 = [] := by simp [nclDeltaPts]

theorem nclSumToFin_sumCongr_inDelta (g : Perm (Fin n)) (h : Perm (Fin n')) (k : Fin n') :
    sumToFin (sumCongr g h) (nclInDelta k) = nclInDelta (h k) := by
  rw [nclInDelta, nclSumToFin_apply]; rfl

theorem nclSumToFin_sumCongr_castAdd (g : Perm (Fin n)) (h : Perm (Fin n')) (i : Fin n) :
    sumToFin (sumCongr g h) (Fin.castAdd n' i) = Fin.castAdd n' (g i) := by
  have := nclSumToFin_apply (sumCongr g h) (Sum.inl i)
  simpa using this

theorem nclSumToFin_sumCongr_inj {g g' : Perm (Fin n)} {h h' : Perm (Fin n')}
    (e : sumToFin (sumCongr g h) = sumToFin (sumCongr g' h')) : g = g' ∧ h = h' := by
  constructor
  · ext i
    have := congrArg (fun σ => (σ (Fin.castAdd n' i) : ℕ)) e
    simpa [nclSumToFin_sumCongr_castAdd] using this
  · ext k
    have := congrArg (fun σ => (σ (nclInDelta (n := n) k) : ℕ)) e
    simpa [nclSumToFin_sumCongr_inDelta, nclInDelta_val] using this

/-! ### The groups of an instance -/

variable (I : PreimageInst)

/-- The generators of `D'`. -/
def nclPreDs : List (Perm (Fin (I.n + I.n'))) := I.ds.map sumToFin

/-- `D' = ⟨sumToFin ds⟩`. -/
def nclPreD : Subgroup (Perm (Fin (I.n + I.n'))) := gens (nclPreDs I)

/-- `M = ⟨ms⟩`. -/
def nclPreM : Subgroup (Perm (Fin I.n')) := Subgroup.closure {m | m ∈ I.ms}

/-- `D = ⟨ds⟩`. -/
def nclPreDD : Subgroup (Perm (Fin I.n ⊕ Fin I.n')) := Subgroup.closure {d | d ∈ I.ds}

/-- Every element of `D` has the form `g ⊕ h`. -/
theorem nclClosure_ds_sum : ∀ d ∈ nclPreDD I, ∃ g h, d = sumCongr g h := by
  have hle : nclPreDD I ≤ (Perm.sumCongrHom (Fin I.n) (Fin I.n')).range := by
    refine (Subgroup.closure_le _).mpr fun d hd => ?_
    refine Perm.mem_sumCongrHom_range_of_perm_mapsTo_inl ?_
    rintro _ ⟨i, rfl⟩
    obtain ⟨j, hj⟩ := I.preserves d hd i
    exact ⟨j, hj.symm⟩
  intro d hd
  obtain ⟨⟨g, h⟩, e⟩ := hle hd
  exact ⟨g, h, e.symm⟩

theorem nclPreD_eq : nclPreD I = (nclPreDD I).map nclSumToFinHom := by
  rw [nclPreD, gens, nclPreDD, MonoidHom.map_closure]
  congr 1
  ext x; simp [nclPreDs, nclSumToFinHom]

/-- An element of `D'` is `sumToFin (g ⊕ h)` with `g ⊕ h ∈ D`. -/
theorem nclMem_preD {x : Perm (Fin (I.n + I.n'))} (hx : x ∈ nclPreD I) :
    ∃ g h, sumCongr g h ∈ nclPreDD I ∧ x = sumToFin (sumCongr g h) := by
  rw [nclPreD_eq] at hx
  obtain ⟨d, hd, rfl⟩ := hx
  obtain ⟨g, h, rfl⟩ := nclClosure_ds_sum I d hd
  exact ⟨g, h, hd, rfl⟩

theorem nclSumToFin_mem_preD {g : Perm (Fin I.n)} {h : Perm (Fin I.n')} (hd : sumCongr g h ∈ nclPreDD I) :
    sumToFin (sumCongr g h) ∈ nclPreD I := by
  rw [nclPreD_eq]; exact ⟨_, hd, rfl⟩

/-! ### Restriction -/

open Classical in
/-- The restriction to `Ω` of an element of `D'`. -/
noncomputable def nclRestr (x : Perm (Fin (n + n'))) : Perm (Fin n) :=
  if h : ∃ g : Perm (Fin n), ∃ h' : Perm (Fin n'), x = sumToFin (sumCongr g h') then h.choose
  else 1

theorem nclRestr_sum (g : Perm (Fin n)) (h : Perm (Fin n')) : nclRestr (sumToFin (sumCongr g h)) = g := by
  have hex : ∃ g' : Perm (Fin n), ∃ h' : Perm (Fin n'),
      sumToFin (sumCongr g h) = sumToFin (sumCongr g' h') := ⟨g, h, rfl⟩
  unfold nclRestr
  rw [dif_pos hex]
  obtain ⟨h', e⟩ := hex.choose_spec
  exact (nclSumToFin_sumCongr_inj e).1.symm

/-! ### The generators of the preimage -/

/-- `x` lifts `m`: it maps `n + k` to `n + m k`. -/
def NclLifts (x : Perm (Fin (n + n'))) (m : Perm (Fin n')) : Prop := ∀ k, x (nclInDelta k) = nclInDelta (m k)

theorem nclLifts_sum {g : Perm (Fin n)} {h m : Perm (Fin n')} (hl : NclLifts (sumToFin (sumCongr g h)) m) :
    h = m := by
  ext k
  have := congrArg (fun p : Fin (n + n') => (p : ℕ)) (hl k)
  simp only [nclSumToFin_sumCongr_inDelta, nclInDelta_val] at this
  omega

/-- The elements of `⟨ks⟩` restrict into `⟨nclRestr ks⟩`. -/
theorem nclGens_restr {ks : List (Perm (Fin (I.n + I.n')))} (hks : ∀ y ∈ ks, y ∈ nclPreD I) :
    ∀ y ∈ gens ks, ∃ g ∈ gens (ks.map nclRestr), ∃ h, y = sumToFin (sumCongr g h) := by
  intro y hy
  induction hy using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨g, h, -, rfl⟩ := nclMem_preD I (hks y hy)
    exact ⟨g, Subgroup.subset_closure (List.mem_map.mpr ⟨_, hy, nclRestr_sum g h⟩), h, rfl⟩
  | one => exact ⟨1, Subgroup.one_mem _, 1, by rw [nclSc_one, nclSumToFin_one]⟩
  | mul y z _ _ hy hz =>
    obtain ⟨g, hg, h, rfl⟩ := hy
    obtain ⟨g', hg', h', rfl⟩ := hz
    exact ⟨g * g', Subgroup.mul_mem _ hg hg', h * h', by rw [← nclSumToFin_mul, nclSc_mul]⟩
  | inv y _ hy =>
    obtain ⟨g, hg, h, rfl⟩ := hy
    refine ⟨g⁻¹, Subgroup.inv_mem _ hg, h⁻¹, ?_⟩
    rw [← nclSc_inv]
    exact (map_inv (nclSumToFinHom (n := I.n) (n' := I.n')) (sumCongr g h)).symm

/-- **The preimage is generated by the restricted lifts and kernel.** -/
theorem nclPreimage_gens (xs ks : List (Perm (Fin (I.n + I.n'))))
    (hxs : ∀ x ∈ xs, x ∈ nclPreD I ∧ ∃ m ∈ nclPreM I, NclLifts x m)
    (hcov : ∀ m ∈ I.ms, ∃ x ∈ xs, NclLifts x m)
    (hks : gens ks = pointwiseStab (nclPreD I) (nclDeltaPts I.n I.n')) :
    gens ((xs ++ ks).map nclRestr) = GI.CitedChecks.preimageSubgroup I := by
  set S := gens ((xs ++ ks).map nclRestr)
  have hkD : ∀ y ∈ ks, y ∈ nclPreD I := fun y hy => by
    have : y ∈ gens ks := Subgroup.subset_closure hy
    rw [hks] at this; exact this.1
  have hkfix : ∀ y ∈ gens ks, ∀ k : Fin I.n', y (nclInDelta k) = nclInDelta k := fun y hy k => by
    rw [hks] at hy
    exact hy.2 _ (nclMem_deltaPts.mpr ⟨k, k.2, rfl⟩)
  refine le_antisymm ((Subgroup.closure_le _).mpr ?_) ?_
  · -- each generator lies in the preimage
    intro g hg
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hg
    rcases List.mem_append.mp hy with hy | hy
    · obtain ⟨hyD, m, hm, hl⟩ := hxs y hy
      obtain ⟨g, h, hd, rfl⟩ := nclMem_preD I hyD
      rw [nclRestr_sum]
      obtain rfl := nclLifts_sum hl
      exact ⟨h, hm, hd⟩
    · obtain ⟨g, h, hd, rfl⟩ := nclMem_preD I (hkD y hy)
      rw [nclRestr_sum]
      have h1 : h = 1 := nclLifts_sum (m := 1) fun k => by
        simpa using hkfix _ (Subgroup.subset_closure hy) k
      subst h1
      exact ⟨1, Subgroup.one_mem _, hd⟩
  · -- every element of the preimage lies in `S`
    have hC : ∀ h ∈ nclPreM I, ∃ a ∈ S, sumCongr a h ∈ nclPreDD I := by
      intro h hh
      induction hh using Subgroup.closure_induction with
      | mem m hm =>
        obtain ⟨x, hx, hl⟩ := hcov m hm
        obtain ⟨g, h, hd, rfl⟩ := nclMem_preD I (hxs x hx).1
        obtain rfl := nclLifts_sum hl
        exact ⟨g, Subgroup.subset_closure (List.mem_map.mpr ⟨_, List.mem_append_left _ hx,
          nclRestr_sum g h⟩), hd⟩
      | one => exact ⟨1, Subgroup.one_mem _, by rw [nclSc_one]; exact Subgroup.one_mem _⟩
      | mul h h' _ _ ih ih' =>
        obtain ⟨a, ha, hd⟩ := ih
        obtain ⟨a', ha', hd'⟩ := ih'
        exact ⟨a * a', Subgroup.mul_mem _ ha ha', by
          rw [← nclSc_mul]; exact Subgroup.mul_mem _ hd hd'⟩
      | inv h _ ih =>
        obtain ⟨a, ha, hd⟩ := ih
        exact ⟨a⁻¹, Subgroup.inv_mem _ ha, by
          rw [← nclSc_inv]; exact Subgroup.inv_mem _ hd⟩
    rintro g ⟨h, hh, hd⟩
    obtain ⟨a, ha, hda⟩ := hC h hh
    have hk : sumCongr (g * a⁻¹) 1 ∈ nclPreDD I := by
      have := Subgroup.mul_mem _ hd (Subgroup.inv_mem _ hda)
      rwa [nclSc_inv, nclSc_mul, mul_inv_cancel] at this
    have hy : sumToFin (sumCongr (g * a⁻¹) 1) ∈ gens ks := by
      rw [hks]
      refine ⟨nclSumToFin_mem_preD I hk, fun p hp => ?_⟩
      obtain ⟨k, -, rfl⟩ := nclMem_deltaPts.mp hp
      simp [nclSumToFin_sumCongr_inDelta]
    obtain ⟨g', hg', h', e⟩ := nclGens_restr I hkD _ hy
    obtain ⟨rfl, -⟩ := nclSumToFin_sumCongr_inj e
    have hS : gens (ks.map nclRestr) ≤ S := Subgroup.closure_mono fun y hy => by
      show y ∈ (xs ++ ks).map nclRestr
      rw [List.map_append]; exact List.mem_append_right _ hy
    have := Subgroup.mul_mem _ (hS hg') ha
    simpa using this

/-! ### Sifting -/

/-- `x` agrees with `m` on the points of `Δ` below `k`. -/
def NclAgreeBelow (x : Perm (Fin (n + n'))) (m : Perm (Fin n')) (k : ℕ) : Prop :=
  ∀ j : Fin n', (j : ℕ) < k → x (nclInDelta j) = nclInDelta (m j)

/-- Some element of `D'` lifts `m`, when `m ∈ 1 :: ms`. -/
theorem nclExists_lift {m : Perm (Fin I.n')} (hm : m ∈ 1 :: I.ms) :
    ∃ z ∈ nclPreD I, NclLifts z m := by
  rcases List.mem_cons.mp hm with rfl | hm
  · exact ⟨1, Subgroup.one_mem _, fun k => rfl⟩
  · obtain ⟨g, hg⟩ := I.ms_le m hm
    exact ⟨_, nclSumToFin_mem_preD I hg, fun k => nclSumToFin_sumCongr_inDelta g m k⟩

/-- **The target of a sifting step lies in the orbit.** -/
theorem nclSift_exists {m : Perm (Fin I.n')} (hm : ∃ z ∈ nclPreD I, NclLifts z m)
    {x : Perm (Fin (I.n + I.n'))} (hx : x ∈ nclPreD I) {k : Fin I.n'} (ha : NclAgreeBelow x m k) :
    ∃ y ∈ pointwiseStab (nclPreD I) (nclDeltaPts I.n k), y (nclInDelta k) = x⁻¹ (nclInDelta (m k)) := by
  obtain ⟨z, hz, hl⟩ := hm
  refine ⟨x⁻¹ * z, ⟨Subgroup.mul_mem _ (Subgroup.inv_mem _ hx) hz, fun p hp => ?_⟩, ?_⟩
  · obtain ⟨j, hj, rfl⟩ := nclMem_deltaPts.mp hp
    rw [Perm.mul_apply, hl j, ← ha j hj, Perm.inv_apply_self]
  · rw [Perm.mul_apply, hl k]

/-- **A sifting step.** -/
theorem nclSift_step {m : Perm (Fin I.n')} {x : Perm (Fin (I.n + I.n'))} (hx : x ∈ nclPreD I)
    {k : Fin I.n'} (ha : NclAgreeBelow x m k) {t : Perm (Fin (I.n + I.n'))}
    (ht : t ∈ pointwiseStab (nclPreD I) (nclDeltaPts I.n k))
    (htk : t (nclInDelta k) = x⁻¹ (nclInDelta (m k))) :
    x * t ∈ nclPreD I ∧ NclAgreeBelow (x * t) m (k + 1) := by
  refine ⟨Subgroup.mul_mem _ hx ht.1, fun j hj => ?_⟩
  rw [Perm.mul_apply]
  rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | hj
  · rw [ht.2 _ (nclMem_deltaPts.mpr ⟨j, hj, rfl⟩), ha j hj]
  · obtain rfl : j = k := Fin.ext hj
    rw [htk, Perm.apply_inv_self]

end GI.Impl
