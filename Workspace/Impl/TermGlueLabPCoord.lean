import Workspace.Impl.TermGlueLabQStack
import Workspace.Impl.LinPresentationKernel
import Workspace.Impl.LinElementMap

/-!
# Finite abelian coordinates of the label group `A/B(x)`

Step 5 of the label program (proof of Theorem A.23: "All local cosets here are
first mapped to the common quotient `A/B(x)`", with the coordinates of the proof of
Theorem A.20). We build the isomorphism `E : A/B(x) ≅ ∏_i ℤ/d_i` that the call of the affine
transporter procedure needs, from data the program computes:

* generators `as` of `N` and `ns` of `N*` with a presentation matrix `M` of `N/N*`
  (`linAbelianCoordinates_spec`, `linPermPresentation`);
* generators `b_j` of the groups `Aut_N(x_i)` (from the `N`-test table), with coordinate
  vectors `Z_j` (`linElementCoordinates_spec`, `linElementCoordinates_map`);
* the moduli `d` and the matrix `V` returned by the quotient program on the stacked matrix
  `[M; Z]` (`tmGLQ_spec`).

Steps.

1. `tmGLP_pres_ker`: the coordinate map of the `φ(a_i)` has kernel the row lattice of `M`
   (`φ` has kernel `N*`, so it is injective on `N/N*`).
2. `tmGLP_label_closure`: `B(x)` is generated by the `φ(b_j)`.
3. `tmGLP_ker`: so `z ↦ Σ z_i [a_i] ∈ A/B(x)` has kernel the row lattice of `[M; Z]`
   (`tmGLQ_stack_iff`), and it is onto because the `a_i` generate `N`.
4. `tmGLPE`: the isomorphism `A/B(x) ≃+ ∏ ℤ/d_i`. It sends the class of `n` to
   `((z V)_i mod d_i)_i` for any coordinate vector `z` of `n` (`tmGLPE_c`).
5. `tmGLPEo`: the same with the orientation coordinate `ℤˣ ≅ ℤ/2` in front.
-/

namespace GI.Impl

open GI.Multicoset GI.Cited Equiv Matrix
open scoped IsMulCommutative

/-! ### Coordinates as products -/

theorem tmGLP_toMul_coord {t : ℕ} {Q : Type*} [CommGroup Q] (v : Fin t → Q) (z : Fin t → ℤ) :
    Additive.toMul (linCoordMap v z) = ∏ i, v i ^ z i := by
  simp [linCoordMap, LinearMap.sum_apply, toMul_sum, toMul_zsmul]

/-! ### Step 1: the presentation of `N/N*` read through `φ` -/

set_option maxHeartbeats 1000000 in
/-- **The coordinate map of the `φ(a_i)` has kernel the row lattice of `M`**, when `M`
presents `⟨as⟩ / ⟨ns⟩`, `⟨as⟩ = N` and `φ` has kernel `⟨ns⟩`. -/
theorem tmGLP_pres_ker {n : ℕ} {N : Subgroup (Perm (Fin n))} {A : Type*} [CommGroup A]
    (φ : N →* A) (ns as : List (Perm (Fin n))) (hN : gens as = N)
    (hK : ∀ g (hg : g ∈ N), φ ⟨g, hg⟩ = 1 ↔ g ∈ gens ns)
    (M : Matrix (Fin as.length) (Fin as.length) ℤ) (hP : linPermPresentation ns as M)
    (z : Fin as.length → ℤ) :
    linCoordMap (fun i : Fin as.length => phiT N φ as[i.val]) z = 0 ↔
      ∃ y, Matrix.vecMul y M = z := by
  obtain ⟨hNn, hQ, hcert⟩ := hP
  letI := hNn
  letI := hQ
  set G' := gens as
  set K' := (gens ns).subgroupOf G'
  set f := linCoordMap (fun i : Fin as.length =>
    QuotientGroup.mk' K' (linIntoSubgroup G' as[i.val]))
  have hker := linPresentation_ker_eq M hcert.1 f hcert.2.1 hcert.2.2.1 hcert.2.2.2
  have hGN : G' ≤ N := hN.le
  have hmemG : ∀ i : Fin as.length, as[i.val] ∈ G' := fun i =>
    Subgroup.subset_closure (List.getElem_mem _)
  -- `φ` on `G'`, and its lift to the quotient
  let φ' : G' →* A := φ.comp (Subgroup.inclusion hGN)
  have hφ' : K' ≤ φ'.ker := by
    intro g hg
    rw [MonoidHom.mem_ker]
    exact (hK g.1 (hGN g.2)).mpr hg
  let φb := QuotientGroup.lift K' φ' hφ'
  have hinj : ∀ q : G' ⧸ K', φb q = 1 → q = 1 := by
    intro q
    induction q using QuotientGroup.induction_on with
    | H g =>
      intro h
      rw [QuotientGroup.eq_one_iff]
      exact (hK g.1 (hGN g.2)).mp h
  have hprod : ∀ z : Fin as.length → ℤ,
      φb (Additive.toMul (f z)) = Additive.toMul
        (linCoordMap (fun i : Fin as.length => phiT N φ as[i.val]) z) := by
    intro z
    rw [tmGLP_toMul_coord, tmGLP_toMul_coord, map_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [map_zpow]
    congr 1
    rw [phiT, dif_pos (hGN (hmemG i))]
    show φ (Subgroup.inclusion hGN (linIntoSubgroup G' as[i.val])) = φ ⟨as[i.val], _⟩
    congr 1
    apply Subtype.ext
    simp [linIntoSubgroup, hmemG i]
  have hrel : ∀ z, z ∈ linRelations M ↔ ∃ y, Matrix.vecMul y M = z := fun z => Iff.rfl
  rw [← hrel, ← hker, LinearMap.mem_ker]
  constructor
  · intro h
    have h1 : φb (Additive.toMul (f z)) = 1 := by rw [hprod, h]; rfl
    have h2 := hinj _ h1
    exact Additive.toMul.injective (h2.trans rfl)
  · intro h
    have h1 := hprod z
    rw [h] at h1
    have h2 : Additive.toMul (linCoordMap (fun i : Fin as.length => phiT N φ as[i.val]) z) = 1 := by
      rw [← h1]; exact map_one φb
    exact Additive.toMul.injective h2

/-! ### Step 2: `B(x)` is generated by the images of the stabilizer generators -/

section Label

variable {P : Type*} [Group P] {Ω : Type} [RAct P Ω] {q : ℕ}
variable {N : Subgroup P} {A : Type*} [CommGroup A] {φ : N →* A} {x : Fin q → Ω}

/-- **`B(x)` is generated by the `φ(b_j)`**, when each `b_j` lies in `Aut_N(x_{row j})` and
the `b_j` with `row j = i` generate `Aut_N(x_i)`. -/
theorem tmGLP_label_closure {s : ℕ} (b : Fin s → P) (row : Fin s → Fin q)
    (hb : ∀ j, b j ∈ Aut N (x (row j)))
    (hgen : ∀ i, (Aut N (x i) : Set P) ⊆ Subgroup.closure {g | ∃ j, row j = i ∧ b j = g}) :
    labelGroup N φ x = Subgroup.closure (Set.range fun j => phiT N φ (b j)) := by
  classical
  set C := Subgroup.closure (Set.range fun j => phiT N φ (b j))
  apply le_antisymm
  · rintro _ ⟨s, hs, rfl⟩
    refine Subgroup.prod_mem _ fun i _ => ?_
    have key : ∀ g (hg : g ∈ Subgroup.closure {g | ∃ j, row j = i ∧ b j = g}),
        g ∈ N ∧ phiT N φ g ∈ C := by
      intro g hg
      induction hg using Subgroup.closure_induction with
      | mem g hg =>
        obtain ⟨j, hj, rfl⟩ := hg
        exact ⟨aut_le _ _ (hb j), Subgroup.subset_closure ⟨j, rfl⟩⟩
      | one => exact ⟨N.one_mem, by rw [phiT_one]; exact C.one_mem⟩
      | mul g h _ _ ihg ihh =>
        exact ⟨N.mul_mem ihg.1 ihh.1, by rw [phiT_mul ihg.1 ihh.1]; exact C.mul_mem ihg.2 ihh.2⟩
      | inv g _ ih =>
        exact ⟨N.inv_mem ih.1, by rw [phiT_inv ih.1]; exact C.inv_mem ih.2⟩
    exact (key _ (hgen i (hs i))).2
  · rw [Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    refine ⟨Pi.mulSingle (row j) (b j), fun i => ?_, ?_⟩
    · by_cases hi : i = row j
      · subst hi; simpa using hb j
      · simp [Pi.mulSingle_eq_of_ne hi, (Aut N (x i)).one_mem]
    · rw [Finset.prod_eq_single (row j) (fun i _ hi => by simp [Pi.mulSingle_eq_of_ne hi, phiT_one])
        (by simp)]
      simp

/-! ### Step 3: the coordinate map onto `A/B(x)` -/

variable (N φ x)

/-- **The coordinate map** `z ↦ Σ_i z_i [a_i]` into `A/B(x)`. -/
noncomputable def tmGLPg {t : ℕ} (a : Fin t → P) : (Fin t → ℤ) →+ Additive (tmGLV N φ x) :=
  (linCoordMap fun i => tmGLc N φ x (a i)).toAddMonoidHom

variable {N φ x}

theorem tmGLPg_toMul {t : ℕ} {a : Fin t → P} (ha : ∀ i, a i ∈ N) (z : Fin t → ℤ) :
    tmGLψ N φ x (Additive.toMul (tmGLPg N φ x a z)) =
      QuotientGroup.mk (Additive.toMul (linCoordMap (fun i => phiT N φ (a i)) z)) := by
  change tmGLψ N φ x (Additive.toMul (linCoordMap (fun i => tmGLc N φ x (a i)) z)) = _
  rw [tmGLP_toMul_coord, tmGLP_toMul_coord, map_prod, QuotientGroup.mk_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_zpow, tmGLψ_c (ha i), QuotientGroup.mk_zpow]

/-- **The kernel of the coordinate map is the row lattice of `[M; Z]`.** -/
theorem tmGLP_ker {t s : ℕ} {a : Fin t → P} (ha : ∀ i, a i ∈ N) (M : Matrix (Fin t) (Fin t) ℤ)
    (hM : ∀ z, linCoordMap (fun i => phiT N φ (a i)) z = 0 ↔ ∃ y, Matrix.vecMul y M = z)
    (Z : Matrix (Fin s) (Fin t) ℤ)
    (hB : labelGroup N φ x = Subgroup.closure (Set.range fun j =>
      Additive.toMul (linCoordMap (fun i => phiT N φ (a i)) (Z j))))
    (z : Fin t → ℤ) :
    tmGLPg N φ x a z = 0 ↔ ∃ y, Matrix.vecMul y (tmGLQStack M Z) = z := by
  rw [← tmGLQ_stack_iff _ M hM Z _ hB z]
  constructor
  · intro h
    have h1 := tmGLPg_toMul (φ := φ) (x := x) ha z
    rw [h] at h1
    have h2 : (QuotientGroup.mk (Additive.toMul (linCoordMap (fun i => phiT N φ (a i)) z)) :
        A ⧸ labelGroup N φ x) = 1 := by rw [← h1]; exact map_one _
    exact (QuotientGroup.eq_one_iff _).mp h2
  · intro h
    have h1 := tmGLPg_toMul (φ := φ) (x := x) ha z
    rw [(QuotientGroup.eq_one_iff _).mpr h] at h1
    have h2 := tmGLψ_injective N φ x (h1.trans (map_one _).symm)
    exact Additive.toMul.injective h2

/-- **The coordinate map is onto** when the `a_i` generate `N`. -/
theorem tmGLPg_surj {t : ℕ} {a : Fin t → P} (ha : ∀ i, a i ∈ N)
    (hgen : N ≤ Subgroup.closure (Set.range a)) : Function.Surjective (tmGLPg N φ x a) := by
  let a' : Fin t → N := fun i => ⟨a i, ha i⟩
  have hgen' : (⊥ : Subgroup N) ⊔ Subgroup.closure (Set.range a') = ⊤ := by
    rw [bot_sup_eq, eq_top_iff]
    rintro ⟨g, hg⟩ -
    have h1 : g ∈ (Subgroup.closure (Set.range a')).map N.subtype := by
      rw [MonoidHom.map_closure, ← Set.range_comp]
      exact hgen hg
    obtain ⟨g', hg', he⟩ := h1
    have : g' = ⟨g, hg⟩ := Subtype.ext he
    rwa [← this]
  have hs := linCoordMap_surjective (QuotientGroup.mk' (tmGLf N φ x).ker)
    (QuotientGroup.mk'_surjective _) ⊥ bot_le a' hgen'
  intro y
  obtain ⟨z, hz⟩ := hs y
  refine ⟨z, ?_⟩
  rw [← hz]
  change linCoordMap (fun i => tmGLc N φ x (a i)) z = _
  congr 2
  funext i
  simp only [tmGLc, dif_pos (ha i)]
  rfl

end Label

end GI.Impl
