module

public import Workspace.Impl.TermGlueLabPBs
public import Workspace.Impl.TermGlueLabPS5Ad

@[expose] public section

/-!
# The coordinates `E` from the computed setup

Step 5 of the label program. The setup program (`tmGLPSet_spec`) returns the
presentation `M` of `N/N*`, the coordinate rows `Z` of the stabilizer generators `b_j`
(`tmGLPBs_spec`), and the quotient data `[d, V]` of `[M; Z]`. Here we show that these give the
coordinates `E : A/B(x) ≃+ ∏ ℤ/d_i` of `tmGLPE`, with `E(class of z) = z V mod d`:

* `tmGLP_label_closure'`: `B(x)` is generated by the `φ(b_j)` when every `b_j` lies in some
  `Aut_N(x_i)` and every `Aut_N(x_i)` lies in `⟨b_j⟩` (this is what `TmGLPBsOut` gives);
* `tmGLP_phi_coord`: `φ(b) = Σ_i z_i φ(a_i)` for a computed coordinate vector `z` of `b`;
* `tmGLP_set_E`: the map `E` with `hE'` (`tmGLPE_g`);
* `tmGLP_step5_s5`: the step-5 result in the form step 6 reads, for this `E`.
-/

namespace GI.Impl

open GI.Multicoset GI.Cited Equiv Matrix
open GI.Algorithm (State)
open GI.Lang (linVecVal)

section Label

variable {P : Type*} [Group P] {Ω : Type} [RAct P Ω] {q : ℕ}
variable {N : Subgroup P} {A : Type*} [CommGroup A] {φ : N →* A} {x : Fin q → Ω}

/-- **`B(x)` is generated by the `φ(b_j)`**, when every `b_j` lies in some `Aut_N(x_i)` and every
`Aut_N(x_i)` lies in the group generated by the `b_j`. -/
theorem tmGLP_label_closure' {s : ℕ} (b : Fin s → P) (hb : ∀ j, ∃ i, b j ∈ Aut N (x i))
    (hgen : ∀ i, (Aut N (x i) : Set P) ⊆ Subgroup.closure (Set.range b)) :
    labelGroup N φ x = Subgroup.closure (Set.range fun j => phiT N φ (b j)) := by
  classical
  set C := Subgroup.closure (Set.range fun j => phiT N φ (b j))
  have hbN : ∀ j, b j ∈ N := fun j => by
    obtain ⟨i, hi⟩ := hb j
    exact aut_le _ _ hi
  -- every element of `⟨b_j⟩` lies in `N` and has its image in `C`
  have key : ∀ g (hg : g ∈ Subgroup.closure (Set.range b)), g ∈ N ∧ phiT N φ g ∈ C := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨j, rfl⟩ := hg
      exact ⟨hbN j, Subgroup.subset_closure ⟨j, rfl⟩⟩
    | one => exact ⟨N.one_mem, by rw [phiT_one]; exact C.one_mem⟩
    | mul g h _ _ ihg ihh =>
      exact ⟨N.mul_mem ihg.1 ihh.1, by rw [phiT_mul ihg.1 ihh.1]; exact C.mul_mem ihg.2 ihh.2⟩
    | inv g _ ih =>
      exact ⟨N.inv_mem ih.1, by rw [phiT_inv ih.1]; exact C.inv_mem ih.2⟩
  apply le_antisymm
  · rintro _ ⟨s, hs, rfl⟩
    exact Subgroup.prod_mem _ fun i _ => (key _ (hgen i (hs i))).2
  · rw [Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    obtain ⟨i0, hi0⟩ := hb j
    refine ⟨Pi.mulSingle i0 (b j), fun i => ?_, ?_⟩
    · by_cases hi : i = i0
      · subst hi; simpa using hi0
      · simp [Pi.mulSingle_eq_of_ne hi, (Aut N (x i)).one_mem]
    · rw [Finset.prod_eq_single i0 (fun i _ hi => by simp [Pi.mulSingle_eq_of_ne hi, phiT_one])
        (by simp)]
      simp

end Label

variable {n : ℕ} {Ω : Type} [RAct (Perm (Fin n)) Ω] {q : ℕ}
variable {N : Subgroup (Perm (Fin n))} {A : Type*} [CommGroup A] {φ : N →* A} {x : Fin q → Ω}

/-- **A computed coordinate vector gives the image under `φ`**: `φ(b) = Σ_i z_i φ(a_i)`. -/
theorem tmGLP_phi_coord {σN : List (Perm (Fin n))} (hN : gens σN = N) {b : Perm (Fin n)}
    (hb : b ∈ gens σN) {z : Fin σN.length → ℤ} (hz : TmGLPCoordOf σN b z) :
    phiT N φ b = Additive.toMul
      (linCoordMap (fun i : Fin σN.length => phiT N φ (σN[i.val]'i.isLt)) z) := by
  obtain ⟨prog, hp, he⟩ := hz
  let π : gens σN →* A := φ.comp (Subgroup.inclusion hN.le)
  have hπ : ∀ w (hw : w ∈ gens σN), π ⟨w, hw⟩ = phiT N φ w := by
    intro w hw
    simp only [π, phiT, dif_pos (hN ▸ hw)]
    rfl
  have hm := linElementCoordinates_map σN π b hb prog z hp he
  have hv : (fun i : Fin σN.length => π (linIntoSubgroup (gens σN) σN[i.val])) =
      fun i => phiT N φ σN[i.val] := by
    funext i
    have hi : σN[i.val] ∈ gens σN := Subgroup.subset_closure (List.getElem_mem _)
    rw [show linIntoSubgroup (gens σN) σN[i.val] = ⟨σN[i.val], hi⟩ from by
      simp [linIntoSubgroup, dif_pos hi]]
    exact hπ _ hi
  rw [hv, hπ b hb] at hm
  exact hm.symm

/-- The stored generators of `N` generate `N`. -/
theorem tmGLP_stored_gen {σN : List (Perm (Fin n))} (hN : gens σN = N) :
    N ≤ Subgroup.closure (Set.range fun i : Fin σN.length => σN[i.val]'i.isLt) := by
  rw [← hN]
  refine Subgroup.closure_mono fun g hg => ?_
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hg
  exact ⟨⟨i, hi⟩, rfl⟩

/-- **The coordinates `E` from the setup.** If `φ` has kernel `⟨σS⟩`, the `b_j` meet
`TmGLPBsOut`, and `M`, `Z`, `V`, `D` are as in `TmGLPSetOut`, then there is
`E : A/B(x) ≃+ ∏ ℤ/D_ii` with `E(class of z) = z V mod D` (it is `tmGLPE`). -/
theorem tmGLP_set_E (φ : N →* A) {σS σN bs : List (Perm (Fin n))} (hN : gens σN = N)
    (hK : ∀ g (hg : g ∈ N), φ ⟨g, hg⟩ = 1 ↔ g ∈ gens σS) (hbs : TmGLPBsOut N x bs)
    {M : Matrix (Fin σN.length) (Fin σN.length) ℤ} (hP : linPermPresentation σS σN M)
    {Z : Matrix (Fin bs.length) (Fin σN.length) ℤ}
    (hZ : ∀ j : Fin bs.length, TmGLPCoordOf σN (bs[j.val]'j.isLt) (Z j))
    {V D : Matrix (Fin σN.length) (Fin σN.length) ℤ} (hV : IsUnit V.det) (hpos : ∀ i, 0 < D i i)
    (hrel : ∀ w, (∃ y, Matrix.vecMul y (tmGLQStack M Z) = w) ↔ ∀ i, D i i ∣ (Matrix.vecMul w V) i) :
    ∃ E' : Additive (tmGLV N φ x) ≃+ tmGLVec (tmGLQMod D),
      ∀ z, E' (tmGLPg N φ x (fun i => σN[i.val]) z) = tmGLQMap V D z := by
  have ha : ∀ i : Fin σN.length, σN[i.val] ∈ N := tmGLP_stored_mem hN
  have hgen := tmGLP_stored_gen hN
  have hM := tmGLP_pres_ker φ σS σN hN hK M hP
  have hbN : ∀ j : Fin bs.length, bs[j.val] ∈ gens σN := fun j => by
    obtain ⟨i, hi⟩ := hbs.1 _ (List.getElem_mem j.isLt)
    rw [hN]; exact aut_le _ _ hi
  have hB : labelGroup N φ x = Subgroup.closure (Set.range fun j =>
      Additive.toMul (linCoordMap (fun i : Fin σN.length => phiT N φ σN[i.val]) (Z j))) := by
    have hrange : Subgroup.closure (Set.range fun j : Fin bs.length => bs[j.val]) =
        Subgroup.closure {b | b ∈ bs} := by
      congr 1
      ext g
      constructor
      · rintro ⟨j, rfl⟩; exact List.getElem_mem _
      · intro hg
        obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hg
        exact ⟨⟨i, hi⟩, rfl⟩
    rw [tmGLP_label_closure' (φ := φ) (fun j : Fin bs.length => bs[j.val])
      (fun j => hbs.1 _ (List.getElem_mem j.isLt)) (fun i => by rw [hrange]; exact hbs.2 i)]
    congr 2
    funext j
    exact tmGLP_phi_coord hN (hbN j) (hZ j)
  exact ⟨tmGLPE ha hgen hM hB hV hpos hrel, tmGLPE_g ha hgen hM hB hV hpos hrel⟩

variable {Ω₀ C₀ : Type} {S : State Ω₀ C₀} {L : GI.Algorithm.GiantLabels S}
variable {H : Subgroup (Perm (Fin n))}

/-- **The step-5 result in the form step 6 reads, with its coordinates.** For the `b_j` of
`tmGLPBs_spec` and `φ` with kernel `⟨σS⟩`, the result of `tmGLPStep5_spec` gives the moduli `D`,
the matrix `V`, the coordinates `E'` with `E'(class of z) = z V mod D`, and the hypothesis `h5`
of step 6 for the items of `E'`. -/
theorem tmGLP_step5_s5 (hn : Normalizes H N) (hker : TmGLKer N H φ) (hNH : N ≤ H)
    {k : Perm (Fin n) → Fin L.q → Perm (Fin n)} (hk : TmGLLift N H φ k)
    (E : Fin n × Fin L.q ≃ S.dom) (i0 j0 : Fin L.q) {x : Fin L.q → Ω}
    (hyk : ∀ h ∈ H, ∀ y : Fin L.q → Perm (Fin n), GI.Paper.cleanRowPerm E y ∈ S.domGroup →
      y i0 = h → ∃ ν, TmGLZero N φ ν ∧ ∀ i, y i = k h i * ν i)
    {σS σN bs : List (Perm (Fin n))} (hN : gens σN = N)
    (hK : ∀ g (hg : g ∈ N), φ ⟨g, hg⟩ = 1 ↔ g ∈ gens σS) (hbs : TmGLPBsOut N x bs)
    {gs : List (Perm (Fin n))} (hgs : gens gs ≤ Aut H (types N x)) {w : Val}
    (hw : TmGLPStep5Out E i0 σS σN bs x gs w) :
    ∃ (U V D : Matrix (Fin σN.length) (Fin σN.length) ℤ)
      (E' : Additive (tmGLV N φ x) ≃+ tmGLVec (tmGLQMod D)),
      (∀ i, 0 < D i i) ∧ U * V = 1 ∧ V * U = 1 ∧
      (∀ z, E' (tmGLPg N φ x (fun i => σN[i.val]) z) = tmGLQMap V D z) ∧
      (∃ ws, w = .list [tmGLPMCtx U V (fun i => D i i), .list ws]) ∧
      TmGLS5Out (linVecVal (tmGLModZ (tmGLQMod D)))
        (gs.attach.map fun g => tmGLAffItem gs (tmGLQMod D) (tmGLρE E' (tmGLlam hn hker hgs hNH))
          (tmGLcE E' (tmGLo (tmGLPRep N x j0) k)) ⟨g.1, Subgroup.subset_closure g.2⟩) w := by
  obtain ⟨M, Z, U, V, D, ws, rfl, hMp, hZ, hV, hpos, hrel, hUV, hVU, hws⟩ := hw
  obtain ⟨E', hE'⟩ := tmGLP_set_E (x := x) φ hN hK hbs hMp hZ hV hpos hrel
  refine ⟨U, V, D, E', hpos, hUV, hVU, hE', ⟨ws, rfl⟩, .nat σN.length, encIntMatrix U,
    encIntMatrix V, ?_⟩
  have hitems := tmGLP_items_eq (F := fun g => tmGLAffItem gs (tmGLQMod D)
      (tmGLρE E' (tmGLlam hn hker hgs hNH)) (tmGLcE E' (tmGLo (tmGLPRep N x j0) k)) g)
    (fun g hg w hgw => tmGLP_gen_item hn hker hNH hk E i0 j0 hyk hN hpos hUV E' hE' hgs
      ⟨g, Subgroup.subset_closure hg⟩ hgw) hws
  rw [← hitems, ← tmGLP_modV hpos]
  rfl

end GI.Impl
