module

public import Workspace.Impl.VsHQ8Out
public import Workspace.Proved.VsWEigCount
public import Workspace.Proved.VsQAlg

@[expose] public section

/-!
# The algebra `𝔽_p[A ∪ E]` from stored local matrices

For a list `gs ⊆ ⟨hs⟩` of permutations, `vsMAlgE Ā (ρ ∘ gs)` is the algebra spanned by the local
units of `as ++ gs` (`vsH_algE_eq`), and a matrix `M` gives an element of it iff `M` lies in the
algebra generated by the local matrices `Λ(x)`, `x ∈ as ++ gs` (`vsH_algE_mem`).
-/

open Matrix

namespace GI.Impl

open GI.Lang GI.Cited GI.Proved Equiv

attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

variable {I : VecStabInst} {s : VsQSt I} [Fact I.p.Prime]

/-- The family `ρ ∘ gs`. -/
noncomputable def vsHEf (hs : VsQStOK s) (gs : List (Perm (Fin I.n))) :
    Fin gs.length → (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ :=
  fun i => vsPRho hs gs[i]

theorem vsH_unit_inv_mem {B : Subalgebra (ZMod I.p) (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))}
    (u : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ) (hu : (u : Module.End _ _) ∈ B) :
    ((u⁻¹ : (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p))ˣ) : Module.End _ _) ∈ B := by
  haveI : Finite (Module.End (ZMod I.p) (Fin (vsQD s) → ZMod I.p)) := Module.finite_of_finite (ZMod I.p)
  have hfin : IsOfFinOrder u := isOfFinOrder_of_finite u
  have e : u⁻¹ = u ^ (orderOf u - 1) := by
    rw [eq_comm, ← mul_eq_one_iff_eq_inv]
    rw [← pow_succ, Nat.sub_add_cancel (orderOf_pos_iff.2 hfin), pow_orderOf_eq_one]
  rw [e, Units.val_pow_eq_pow_val]
  exact pow_mem hu _

theorem vsH_algE_eq (hs : VsQStOK s) {as gs : List (Perm (Fin I.n))} (has : gens as ≤ gens s.hs)
    (hgs : ∀ g ∈ gs, g ∈ gens s.hs) :
    vsMAlgE (vsPBar hs (gens as)) (vsHEf hs gs) = vsTAlg (vsPBar hs (gens (as ++ gs))) := by
  have hall : ∀ x ∈ as ++ gs, x ∈ gens s.hs := fun x hx => by
    rcases List.mem_append.1 hx with hx | hx
    · exact has (Subgroup.subset_closure hx)
    · exact hgs x hx
  have hle : gens as ≤ gens (as ++ gs) := Subgroup.closure_mono fun x hx => List.mem_append_left _ hx
  apply le_antisymm
  · refine Algebra.adjoin_le ?_
    rintro _ (⟨u, hu, rfl⟩ | ⟨i, rfl⟩)
    · obtain ⟨x, hx, hxs, rfl⟩ := (vsPBar_mem_iff hs).1 hu
      exact Algebra.subset_adjoin ⟨_, vsPRho_mem_vsPBar hs (hle hx) hxs, rfl⟩
    · have hg : gs[i] ∈ as ++ gs := List.mem_append_right _ (List.getElem_mem i.2)
      exact Algebra.subset_adjoin ⟨_, vsPRho_mem_vsPBar hs (Subgroup.subset_closure hg) (hall _ hg), rfl⟩
  · refine Algebra.adjoin_le ?_
    rintro _ ⟨u, hu, rfl⟩
    rw [vsPBar_gens hs hall] at hu
    induction hu using Subgroup.closure_induction with
    | mem u hu =>
      obtain ⟨x, hx, rfl⟩ := hu
      rcases List.mem_append.1 hx with hx | hx
      · exact Algebra.subset_adjoin (Or.inl ⟨_, vsPRho_mem_vsPBar hs (Subgroup.subset_closure hx)
          (has (Subgroup.subset_closure hx)), rfl⟩)
      · obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
        exact Algebra.subset_adjoin (Or.inr ⟨⟨i, hi⟩, rfl⟩)
    | one => beta_reduce; rw [Units.val_one]; exact one_mem _
    | mul u v _ _ hu hv => beta_reduce at hu hv ⊢; rw [Units.val_mul]; exact mul_mem hu hv
    | inv u _ hu => beta_reduce at hu ⊢; exact vsH_unit_inv_mem u hu

/-- **Membership in `𝔽_p[A ∪ E]`.** -/
theorem vsH_algE_mem (hs : VsQStOK s) {as gs : List (Perm (Fin I.n))} (has : gens as ≤ gens s.hs)
    (hgs : ∀ g ∈ gs, g ∈ gens s.hs) (M : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) :
    Matrix.toLin' M ∈ vsMAlgE (vsPBar hs (gens as)) (vsHEf hs gs) ↔
      M ∈ Algebra.adjoin (ZMod I.p) {X | ∃ a ∈ as ++ gs, vsQLam s a = X} := by
  rw [vsH_algE_eq hs has hgs]
  exact vsP_mem_vsTAlg_iff hs ((Subgroup.closure_le _).2 fun x hx => by
    rcases List.mem_append.1 hx with hx | hx
    · exact has (Subgroup.subset_closure hx)
    · exact hgs x hx) M

theorem vsWM_loc (g : Perm (Fin I.n)) :
    vsWM I.p (vsQD s) (vsPLocL I s.ws' (vsQCs s) g) = vsQLam s g := rfl

/-- The stored local matrices of `as ++ gs`. -/
noncomputable def vsHGms (s : VsQSt I) (L : List (Perm (Fin I.n))) : List (List (List ℕ)) :=
  L.map (vsPLocL I s.ws' (vsQCs s))

/-- The basis of the algebra they generate. -/
noncomputable def vsHBm (s : VsQSt I) (L : List (Perm (Fin I.n))) : List (List (List ℕ)) :=
  (vsFAlgSpanL I.p (vsWZ (vsQD s)) (vsWId (vsQD s)) (vsHGms s L) (vsQD s * vsQD s)).2

/-- The Frobenius fixed points of that algebra. -/
noncomputable def vsHFx (s : VsQSt I) (L : List (Perm (Fin I.n))) : List (List (List ℕ)) :=
  vsFFixL I.p (vsQD s) (vsHBm s L)

theorem vsHGms_sq (L : List (Perm (Fin I.n))) : ∀ g ∈ vsHGms s L, VsWSq I.p (vsQD s) g := by
  intro g hg
  obtain ⟨x, -, rfl⟩ := List.mem_map.1 hg
  exact vsPLocL_sq x

theorem vsHBm_span (L : List (Perm (Fin I.n))) (X : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)) :
    X ∈ Submodule.span (ZMod I.p) {X | ∃ M ∈ vsHBm s L, vsWM I.p (vsQD s) M = X} ↔
      X ∈ Algebra.adjoin (ZMod I.p) {X | ∃ a ∈ L, vsQLam s a = X} := by
  have e : {X | ∃ g ∈ vsHGms s L, vsWM I.p (vsQD s) g = X} = {X | ∃ a ∈ L, vsQLam s a = X} := by
    ext X; simp [vsHGms, vsWM_loc]
  rw [vsHBm, vsQ_alg_span I.prime (vsHGms_sq L), e]

theorem vsHBm_sq (L : List (Perm (Fin I.n))) : ∀ M ∈ vsHBm s L, VsWSq I.p (vsQD s) M := by
  have h := (vsFAlgSpanL_span I.prime (vsWZ_zero I.prime.pos (vsQD s)) (vsWId_sq I.prime.one_lt _)
    (vsFMatrix_vsWId _) fun g hg => vsFSq_of_wSq (vsHGms_sq (s := s) L g hg)).1
  intro M hM
  have := h.sq M hM
  exact ⟨fun a ha => this.rows a ha, this.len⟩

/-- Commuting generators give a commutative basis. -/
theorem vsHBm_comm (hs : VsQStOK s) {L : List (Perm (Fin I.n))} (hL : ∀ x ∈ L, x ∈ gens s.hs)
    (hc : ∀ x ∈ L, ∀ y ∈ L, vsPRho hs x * vsPRho hs y = vsPRho hs y * vsPRho hs x) :
    VsWComm I.p (vsQD s) (vsHBm s L) := by
  have hgen : ∀ x ∈ L, ∀ y ∈ L, Commute (vsQLam s x) (vsQLam s y) := by
    intro x hx y hy
    have h1 := hc x hx y hy
    rw [← vsPRho_mul hs (hL x hx) (hL y hy), ← vsPRho_mul hs (hL y hy) (hL x hx),
      vsPRho_of hs (mul_mem (hL x hx) (hL y hy)), vsPRho_of hs (mul_mem (hL y hy) (hL x hx)),
      vsQRho_ext, vsQLam_mul hs (hL x hx) (hL y hy), vsQLam_mul hs (hL y hy) (hL x hx)] at h1
    exact h1
  set Ad := Algebra.adjoin (ZMod I.p) {X | ∃ a ∈ L, vsQLam s a = X}
  have hcomm : ∀ X ∈ Ad, ∀ Y ∈ Ad, Commute X Y := by
    intro X hX Y hY
    refine Algebra.commute_of_mem_adjoin_of_forall_mem_commute hY fun b hb => ?_
    obtain ⟨y, hy, rfl⟩ := hb
    refine (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hX fun a ha => ?_).symm
    obtain ⟨x, hx, rfl⟩ := ha
    exact hgen y hy x hx
  intro M hM M' hM'
  have h1 : vsWM I.p (vsQD s) M ∈ Ad :=
    (vsHBm_span L _).1 (Submodule.subset_span ⟨M, hM, rfl⟩)
  have h2 : vsWM I.p (vsQD s) M' ∈ Ad :=
    (vsHBm_span L _).1 (Submodule.subset_span ⟨M', hM', rfl⟩)
  exact hcomm _ h1 _ h2

/-- **The family of fixed points** satisfies the hypotheses of `VsMPiecesOut`. -/
theorem vsH_fix_family (hs : VsQStOK s) {as gs : List (Perm (Fin I.n))} (has : gens as ≤ gens s.hs)
    (hgs : ∀ g ∈ gs, g ∈ gens s.hs)
    (hc : ∀ x ∈ as ++ gs, ∀ y ∈ as ++ gs, vsPRho hs x * vsPRho hs y = vsPRho hs y * vsPRho hs x) :
    let Fx := vsHFx s (as ++ gs)
    let f := fun i : Fin Fx.length => vsWLin I.p (vsQD s) Fx[i]
    (∀ i, f i ∈ vsMAlgE (vsPBar hs (gens as)) (vsHEf hs gs)) ∧ (∀ i, f i ^ I.p = f i) ∧
      ∀ x ∈ vsMAlgE (vsPBar hs (gens as)) (vsHEf hs gs), x ^ I.p = x →
        x ∈ Submodule.span (ZMod I.p) (Set.range f) := by
  intro Fx f
  have hL : ∀ x ∈ as ++ gs, x ∈ gens s.hs := fun x hx => by
    rcases List.mem_append.1 hx with hx | hx
    · exact has (Subgroup.subset_closure hx)
    · exact hgs x hx
  have hC := vsHBm_comm hs hL hc
  have hfix := vsFFixL_span I.prime (vsHBm_sq (s := s) (as ++ gs)) hC
  have hin : ∀ i : Fin Fx.length, vsWM I.p (vsQD s) Fx[i] ∈ Submodule.span (ZMod I.p)
      {X | ∃ y ∈ vsFFixL I.p (vsQD s) (vsHBm s (as ++ gs)), vsWM I.p (vsQD s) y = X} :=
    fun i => Submodule.subset_span ⟨Fx[i], List.getElem_mem i.2, rfl⟩
  refine ⟨fun i => ?_, fun i => ?_, fun x hx hxp => ?_⟩
  · have h1 := ((hfix _).1 (hin i)).1
    exact (vsH_algE_mem hs has hgs _).2 ((vsHBm_span _ _).1 h1)
  · have h2 := ((hfix _).1 (hin i)).2
    show Matrix.toLin' _ ^ I.p = Matrix.toLin' _
    rw [← Matrix.toLin'_pow, h2]
  · obtain ⟨X, rfl⟩ : ∃ X, Matrix.toLin' X = x := ⟨LinearMap.toMatrix' x, Matrix.toLin'_toMatrix' x⟩
    have hX := (vsH_algE_mem hs has hgs X).1 hx
    have hXp : X ^ I.p = X := by
      apply Matrix.toLin'.injective
      rw [Matrix.toLin'_pow]; exact hxp
    have hmem := (hfix X).2 ⟨(vsHBm_span _ _).2 hX, hXp⟩
    have := Submodule.mem_map_of_mem (f := (Matrix.toLin' : Matrix (Fin (vsQD s)) (Fin (vsQD s)) (ZMod I.p)
      ≃ₗ[ZMod I.p] _).toLinearMap) hmem
    rw [Submodule.map_span] at this
    refine Submodule.span_mono ?_ this
    rintro _ ⟨_, ⟨y, hy, rfl⟩, rfl⟩
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hy
    exact ⟨⟨i, hi⟩, rfl⟩

end GI.Impl
