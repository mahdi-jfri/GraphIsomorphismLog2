theorem vsHBlocks_length (hard q8c : ℕ) : (vsQBlocks hard q8c ++ vsHBlocks).length = 474 := rfl

theorem spProg_all_funs {B : ℕ} {blks : List (List Expr)} {ps : List Prim} {n : ℕ} {e : Expr}
    (hB : 0 < B) (hk : n / B < blks.length) (h : (blks.getD (n / B) []).getD (n % B) .nil = e) :
    (spProg B blks ps).funs[n]? = some e := by
  have := spProg_funs (B := B) (blks := blks) (ps := ps) (k := n / B) (j := n % B) hk (Nat.mod_lt _ hB)
  rw [Nat.div_add_mod, h] at this
  exact this

theorem spProg_all_hasAt {B : ℕ} {blks : List (List Expr)} {ps : List Prim} {n : ℕ} {fs : List Expr}
    (hB : 0 < B) (hk : n / B < blks.length) (h : ((blks.getD (n / B) []).drop (n % B)).take fs.length = fs)
    (hl : n % B + fs.length ≤ B) : (spProg B blks ps).HasAt n fs := by
  have := spProg_app_hasAt (B := B) (A := blks) (E := []) (ps := ps) (n := n) (fs := fs)
    hB hk h hl
  simpa using this

