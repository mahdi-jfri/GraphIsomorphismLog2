      | exact spProg_all_funs (by norm_num) (by rw [vsHBlocks_length]; norm_num) rfl
      | exact spProg_all_hasAt (by norm_num) (by rw [vsHBlocks_length]; norm_num) rfl (by decide)
      | exact spProg_prim rfl
      | (show (_ : ℕ) = _; rfl))
  | ((fail_if_success show @Eq (Option _) _ _); constructor)))

