import Workspace.Impl.AggItemCiCfgT
import Workspace.Impl.AggItemCiCfgK

/-!
# The configuration query: the group of the pair structure as a program

The group of the pair structure is generated by the diagonal transpositions `itcqGs n`
(`itcq_group`). `itcqGrpF fr fm fa` on `n` builds `R = [0, …, n² - 1]` (the identity of
`Fin (n²)`), maps `itcqGenF` over `R` and returns `[n², [R] ++ gens]`, which is
`encGroup (itcqGs n)` (`itcq_grpF_spec`).
-/

set_option linter.unusedSectionVars false

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm Finset
open GI.Cited (Val encPerm gens encGroup encPerms)

/-- On `n`: the group value `encGroup (itcqGs n)`. -/
def itcqGrpF (fr fm fa : ℕ) : Expr :=
  .letE (.call fr (.arith .mul (.var 0) (.var 0)))
    (mk2 (.arith .mul (.var 0) (.var 0))
      (.call fa (mk2 (.snoc .nil (.var 1)) (.call fm (mk2 (mk2 (.var 0) (.var 1)) (.var 1))))))

/-- The cost bound of `itcqGrpF`, with `m = n²`. -/
def itcqGrpC (m : ℕ) : ℕ := 10 ^ 8 * (m + 2) ^ 5

theorem itcq_grpC_arith {m K nq r a ws b l o C : ℕ} (hK : K ≤ 40) (hnq : nq ≤ m + 2) (hl : l ≤ m)
    (hr : r ≤ 5 * (m + 1) ^ 2) (ha : a ≤ 30 * (m + 2) ^ 2) (hws : ws ≤ 10 * (m + 2) ^ 3)
    (hb : b ≤ 50 * (m + 2) ^ 3) (ho : o ≤ 40 * (m + 2) ^ 4)
    (hC : C ≤ K * (100 * (m + 2) ^ 4 + 1) + (loopModK * (m + 1) * (nq + m + r + 1) +
      (m * itcqGenC m + mapK * (m + 1) * (a + ws + 1)) +
        loopModK * (l + 1) * (b + l + o + 1))) :
    C ≤ itcqGrpC m := by
  unfold itcqGrpC
  unfold itcqGenC loopModK mapK at hC
  have p1 : (m + 1) ^ 2 ≤ (m + 2) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have p2 : m + 2 ≤ (m + 2) ^ 2 := by nlinarith
  have p3 : (m + 2) ^ 2 ≤ (m + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  have p4 : (m + 2) ^ 3 ≤ (m + 2) ^ 4 := Nat.pow_le_pow_right (by omega) (by omega)
  have p5 : (m + 2) ^ 4 ≤ (m + 2) ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  have e4 : (m + 2) * (m + 2) ^ 4 = (m + 2) ^ 5 := by ring
  have e3 : (m + 2) * (m + 2) ^ 3 = (m + 2) ^ 4 := by ring
  have h1 : 1000 * (m + 1) * (nq + m + r + 1) ≤ 1000 * ((m + 2) * (8 * (m + 2) ^ 2)) := by
    rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul (by omega) (by omega))
  have h2 : m * (10 ^ 6 * (m + 2) ^ 3) ≤ (m + 2) * (10 ^ 6 * (m + 2) ^ 3) :=
    Nat.mul_le_mul_right _ (by omega)
  have h3 : 1000 * (m + 1) * (a + ws + 1) ≤ 1000 * ((m + 2) * (42 * (m + 2) ^ 3)) := by
    rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul (by omega) (by omega))
  have h4 : 1000 * (l + 1) * (b + l + o + 1) ≤ 1000 * ((m + 2) * (91 * (m + 2) ^ 4)) := by
    rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ (Nat.mul_le_mul (by omega) (by omega))
  have h5 : K * (100 * (m + 2) ^ 4 + 1) ≤ 40 * (101 * (m + 2) ^ 4) :=
    Nat.mul_le_mul hK (by omega)
  have q1 : (m + 2) * (8 * (m + 2) ^ 2) ≤ 8 * (m + 2) ^ 5 := by
    have : (m + 2) * (8 * (m + 2) ^ 2) = 8 * ((m + 2) * (m + 2) ^ 2) := by ring
    have : (m + 2) * (m + 2) ^ 2 = (m + 2) ^ 3 := by ring
    omega
  have q2 : (m + 2) * (10 ^ 6 * (m + 2) ^ 3) = 10 ^ 6 * (m + 2) ^ 4 := by ring
  have q3 : (m + 2) * (42 * (m + 2) ^ 3) = 42 * (m + 2) ^ 4 := by ring
  have q4 : (m + 2) * (91 * (m + 2) ^ 4) = 91 * (m + 2) ^ 5 := by ring
  omega

section Prog

variable {P : Program}

/-- **Map over positions with values**: if `fp` on `[c, t]` gives `g t` for every position
`t < m`, then `map fp` on `[c, [0, …, m - 1]]` gives the list of the `g t`. -/
theorem itcq_mapPosV_spec {mb fp : ℕ} (hm : P.HasAt mb (mapFuns mb fp)) {c : Val} {m : ℕ}
    {g : Fin m → Val} {Bd : ℕ} (hf : ∀ t : Fin m, FunDet P fp (.list [c, .nat t]) (g t) Bd) :
    FunAll P mb (.list [c, natList (List.range m)]) (fun w cost =>
      w = .list ((List.finRange m).map g) ∧
        cost ≤ m * Bd + mapK * (m + 1) * ((Val.list [c, natList (List.range m)]).wt + w.wt + 1)) := by
  let F : Val → Val := fun x => match x with
    | .nat t => if ht : t < m then g ⟨t, ht⟩ else .nat 0
    | _ => .nat 0
  have key := map_spec (P := P) hm (c := c) (xs := (List.range m).map Val.nat)
    (R := fun x w => w = F x) (B := fun _ => Bd) (by
      intro x hx
      obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hx
      have ht' := List.mem_range.1 ht
      refine FunAll.mono (hf ⟨t, ht'⟩) fun w cost ⟨hw, hc⟩ => ⟨?_, hc⟩
      subst hw
      simp only [F, dif_pos ht'])
  refine key.mono fun w cost ⟨ws, hw, h2, hc⟩ => ?_
  have hval : w = .list ((List.finRange m).map g) := by
    rw [hw, itcq_f2_map h2, ← List.map_coe_finRange_eq_range]
    simp only [List.map_map]
    congr 1
    refine List.map_congr_left fun t _ => ?_
    simp only [Function.comp_apply, F, dif_pos t.isLt, Fin.eta]
  refine ⟨hval, ?_⟩
  simp only [List.map_const', List.sum_replicate, List.length_map, List.length_range,
    smul_eq_mul] at hc
  exact hc

/-- The generator list as the map over positions. -/
theorem itcq_gs_map (n : ℕ) : (itcqGs n).map encPerm = (List.finRange (n * n)).map fun t =>
    encPerm (itciD n (swap ((itciPE n).symm t).1 ((itciPE n).symm t).2)) := by
  simp [itcqGs, itcqSw, List.map_map]

/-- **The group of the pair structure** as a program, in cost `itcqGrpC (n²)`. -/
theorem itcq_grpF_spec {f fr fm fa fg fm' sw : ℕ} (hf : P.funs[f]? = some (itcqGrpF fr fm fa))
    (hr : P.HasAt fr (rangeFuns fr)) (hm : P.HasAt fm (mapFuns fm fg))
    (ha : P.HasAt fa (appendFuns fa)) (hg : P.funs[fg]? = some (itcqGenF fm'))
    (hm' : P.HasAt fm' (mapFuns fm' sw)) (hsw : P.funs[sw]? = some itcqSwF) (n : ℕ) :
    FunDet P f (.nat n) (encGroup (itcqGs n)) (itcqGrpC (n * n)) := by
  set m := n * n with hmd
  have hnm : n ≤ m := Nat.le_mul_self n
  set Wv := 100 * (m + 2) ^ 4 with hWv
  have p1 : (m + 1) ^ 2 ≤ (m + 2) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have p2 : m + 2 ≤ (m + 2) ^ 2 := by nlinarith
  have p3 : (m + 2) ^ 2 ≤ (m + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  have p4 : (m + 2) ^ 3 ≤ (m + 2) ^ 4 := Nat.pow_le_pow_right (by omega) (by omega)
  have hRw : (natList (List.range m)).wt ≤ 5 * (m + 1) ^ 2 := itcq_range_wt m
  have p0 : (m + 1) ^ 2 + m + 1 ≤ (m + 2) ^ 2 := by nlinarith
  have hnw := wt_nat_le n
  have hmw := wt_nat_le m
  -- the range
  have v0 := StDC.var' (P := P) (env := [.nat n]) (i := 0) (W := Wv) rfl (by omega)
  have mu := StDC.arith (op := .mul) v0 v0 (z := m) rfl (by omega)
  have hrd : FunDet P fr (.nat m) (natList (List.range m))
      (loopModK * (m + 1) * ((Val.nat m).wt + m + (natList (List.range m)).wt + 1)) :=
    (range_spec hr m).mono fun w c ⟨hw, hc⟩ => ⟨hw, by subst hw; exact hc⟩
  have cr := StDC.call mu hrd (by omega)
  -- the body, in the environment `[n, R]`
  set env : List Val := [.nat n, natList (List.range m)] with henv
  have b0 := StDC.var' (P := P) (env := env) (i := 0) (W := Wv) rfl (by omega)
  have b1 := StDC.var' (P := P) (env := env) (i := 1) (W := Wv) rfl (by omega)
  have bm := StDC.arith (op := .mul) b0 b0 (z := m) rfl (by omega)
  have hc2 := wt_list2_le (.nat n) (natList (List.range m))
  have c2 := StDC.mk2 b0 b1 (by omega) (by omega)
  have hin2 := wt_list2_le (.list [.nat n, natList (List.range m)]) (natList (List.range m))
  have c3 := StDC.mk2 c2 b1 (by omega) (by omega)
  -- the generators
  set gl := (itcqGs n).map encPerm with hgl
  have hgl1 : gl.length ≤ m := by
    rw [hgl, List.length_map, itcqGs, List.length_map]; exact itcq_sw_length n
  have hglw : (Val.list gl).wt ≤ 10 * (m + 2) ^ 3 := by
    have h1 := wt_list_le gl
    have h2 : (gl.map Val.wt).sum ≤ gl.length * (4 * (m + 1) ^ 2) := by
      have := List.sum_le_card_nsmul (gl.map Val.wt) (4 * (m + 1) ^ 2) (by
        intro x hx
        obtain ⟨v, hv, rfl⟩ := List.mem_map.1 hx
        obtain ⟨s, -, rfl⟩ := List.mem_map.1 hv
        exact wt_encPerm_le s)
      simpa using this
    have h3 : gl.length * (4 * (m + 1) ^ 2) ≤ (m + 2) * (4 * (m + 2) ^ 2) :=
      Nat.mul_le_mul (by omega) (by omega)
    have h4 : (m + 2) * (4 * (m + 2) ^ 2) = 4 * (m + 2) ^ 3 := by ring
    omega
  have hgen : FunDet P fm (.list [.list [.nat n, natList (List.range m)], natList (List.range m)])
      (.list gl) (m * itcqGenC m + mapK * (m + 1) *
        ((Val.list [.list [.nat n, natList (List.range m)], natList (List.range m)]).wt +
          (Val.list gl).wt + 1)) := by
    have key := itcq_mapPosV_spec (P := P) hm (c := .list [.nat n, natList (List.range m)])
      (m := m) (g := fun t => encPerm (itciD n (swap ((itciPE n).symm t).1 ((itciPE n).symm t).2)))
      (Bd := itcqGenC m) fun t => itcq_genF_spec hg hm' hsw t.isLt
    refine key.mono fun w c ⟨hw, hc⟩ => ?_
    have hw' : w = .list gl := by rw [hw, hgl, itcq_gs_map]
    subst hw'
    exact ⟨rfl, hc⟩
  have cg := StDC.call c3 hgen (by omega)
  have hR1 : (Val.list [natList (List.range m)]).wt ≤ 2 * (5 * (m + 1) ^ 2) + 5 := by
    have := wt_list1_le (natList (List.range m)); omega
  have sn := StDC.snoc (StDC.nil (P := P) (env := env) (W := Wv) (by omega)) b1
    (v := natList (List.range m)) (by simp only [List.nil_append]; omega)
  simp only [List.nil_append] at sn
  have hap2 := wt_list2_le (.list [natList (List.range m)]) (.list gl)
  have ap := StDC.mk2 sn cg (by omega) (by omega)
  -- the identity and the generators
  have hone : natList (List.range m) = encPerm (1 : Perm (Fin m)) := range_eq_encPerm_one
  have hgw : (encGroup (itcqGs n)).wt ≤ 40 * (m + 2) ^ 4 := by
    have h1 : (encGroup (itcqGs n)).wt ≤ 40 * (((itcqGs n).length + 2) * (m + 1)) ^ 2 :=
      wt_encGroup_le _
    have hl : (itcqGs n).length ≤ m := by
      rw [itcqGs, List.length_map]; exact itcq_sw_length n
    have h2 : ((itcqGs n).length + 2) * (m + 1) ≤ (m + 2) * (m + 2) :=
      Nat.mul_le_mul (by omega) (by omega)
    have h3 := Nat.pow_le_pow_left h2 2
    have h4 : ((m + 2) * (m + 2)) ^ 2 = (m + 2) ^ 4 := by ring
    omega
  have hgv : encGroup (itcqGs n) = .list [.nat m, .list ([natList (List.range m)] ++ gl)] := by
    rw [hone]; rfl
  have hinner : (Val.list ([natList (List.range m)] ++ gl)).wt ≤ 40 * (m + 2) ^ 4 := by
    have : (Val.list ([natList (List.range m)] ++ gl)).wt < (encGroup (itcqGs n)).wt := by
      rw [hgv]; exact wt_le_wt_list (by simp)
    omega
  have hapd : FunDet P fa (.list [.list [natList (List.range m)], .list gl])
      (.list ([natList (List.range m)] ++ gl))
      (loopModK * (gl.length + 1) * ((Val.list [.list [natList (List.range m)], .list gl]).wt +
        gl.length + (Val.list ([natList (List.range m)] ++ gl)).wt + 1)) :=
    (append_spec ha [natList (List.range m)] gl).mono fun w c ⟨hw, hc⟩ => ⟨hw, by subst hw; exact hc⟩
  have ca := StDC.call ap hapd (by omega)
  have body := StDC.mk2 bm ca (by rw [← hgv]; omega) (by omega)
  have l := StDC.letE cr body (by rw [← hgv]; omega)
  rw [← hgv] at l
  refine StDC.funDet hf l ?_
  show _ ≤ itcqGrpC m
  refine itcq_grpC_arith (m := m) (K := 40) le_rfl (nq := (Val.nat m).wt) (by omega) hgl1 hRw
    (a := (Val.list [.list [.nat n, natList (List.range m)], natList (List.range m)]).wt)
    (by omega) hglw (b := (Val.list [.list [natList (List.range m)], .list gl]).wt) (by omega)
    hinner ?_
  omega

end Prog

end GI.Impl
