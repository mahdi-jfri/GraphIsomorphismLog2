module

public import Workspace.Impl.TermGlueLabSRed

@[expose] public section

/-!
# The output of the label step (step 6, the answer)

Proof of Theorem A.23: "Adjoining `N` lifts the resulting label stabilizer and
transporter back to `D`." The affine call in the supplement `S` returns `[]` or `[t, gens L]`
with label transporter `t ⟨L⟩` in `S`. By `tmGL_lab_out` the label coset is
`t τ · τ⁻¹ (L ⊔ N) τ`. So the program

1. returns `[]` when the affine answer is `[]` (no transporter: `tmGL_lab_out_empty`);
2. otherwise cuts `L ++ σN` to at most `n²` generators `hs` of `L ⊔ N` (`tmGLSRed_spec`),
   computes `t τ` and `τ⁻¹`, and conjugates `hs` by `τ⁻¹` (Lemma A.19's conjugation map
   `supConjF`, mapped);
3. returns `[t τ, encGroup (τ⁻¹ hs τ)]`.

The conjugation is applied after the cut (the cut needs no conjugate, and `τ⁻¹ ⟨hs⟩ τ` is
generated by the conjugates of `hs`). This is an encoding choice: the answer is the same coset.

`tmGLSOutF red inv cp mc` on `[encGroup σN, encPerm τ, u]` (`tmGLSOut_spec`, cost `tmGLSOutC`).
-/

namespace GI.Impl

open GI.Lang Equiv
open GI.Cited (Val encPerm encGroup gens PointwiseStab)

variable {n : ℕ}

/-- The body for a nonempty affine answer `u = [t, gens L]`. -/
def tmGLSOutB (red inv cp mc : ℕ) : Expr :=
  .letE (.call red (mk2 (arg 0) (.get (arg 2) (.nat 1))))
    (.letE (.call inv (arg 1))
      (mk2 (.call cp (mk2 (.get (arg 2) (.nat 0)) (arg 1)))
        (mk2 (.get (arg 0) (.nat 0))
          (.call mc (mk2 (mk2 (.var 2) (arg 1)) (.get (.var 1) (.nat 1)))))))

/-- **The output program** on `[encGroup σN, encPerm τ, u]`: `[]` if `u = []`, else the body. -/
def tmGLSOutF (red inv cp mc : ℕ) : Expr := .ite (.length (arg 2)) (tmGLSOutB red inv cp mc) .nil

/-- The cost bound, for an input of weight `W`, with the constants `c`, `k` of the primitive. -/
def tmGLSOutC (c k W : ℕ) : ℕ := 2 * tmGLSRedC c k (2 * W + 6) + 10 ^ 10 * (W + 1) ^ 8

theorem tmGLSRedC_mono (c k : ℕ) {W W' : ℕ} (h : W ≤ W') : tmGLSRedC c k W ≤ tmGLSRedC c k W' := by
  unfold tmGLSRedC
  have h2 : (W + 1) ^ 2 ≤ (W' + 1) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h9 : (W + 1) ^ 9 ≤ (W' + 1) ^ 9 := Nat.pow_le_pow_left (by omega) 9
  exact Nat.add_le_add (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) _))
    (Nat.mul_le_mul_left _ h9)

/-- The result of the output program. -/
def TmGLSOutRes (σN : List (Perm (Fin n))) (τ : Perm (Fin n)) (u w : Val) : Prop :=
  (u = .list [] ∧ w = .list []) ∨ ∃ (t : Perm (Fin n)) (L hs : List (Perm (Fin n))),
    u = .list [encPerm t, encGroup L] ∧
    w = .list [encPerm (t * τ), encGroup (hs.map fun x => τ⁻¹ * x * τ)] ∧
    hs.length ≤ n ^ 2 ∧ gens hs = gens L ⊔ gens σN

set_option maxHeartbeats 2000000 in
/-- **The body.** -/
theorem tmGLSOutB_spec (h : PointwiseStab) {P : Program} {red app mg jp inv cp cj mc : ℕ}
    (hred : P.funs[red]? = some (tmGLSRedF app mg jp)) (happ : P.HasAt app (appendFuns app))
    (hmg : P.HasAt mg (mkGroupFuns mg)) (hj : P.prims[jp]? = some (pointwiseStabPrim h))
    (hinv : P.HasAt inv (invFuns inv)) (hcp : P.HasAt cp (composeFuns cp))
    (hcj : P.funs[cj]? = some (supConjF cp)) (hmc : P.HasAt mc (mapFuns mc cj))
    (σN : List (Perm (Fin n))) (τ t : Perm (Fin n)) (L : List (Perm (Fin n))) :
    EvalAll P [.list [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]]]
      (tmGLSOutB red inv cp mc) (fun w c =>
      (∃ hs : List (Perm (Fin n)),
        w = .list [encPerm (t * τ), encGroup (hs.map fun x => τ⁻¹ * x * τ)] ∧
        hs.length ≤ n ^ 2 ∧ gens hs = gens L ⊔ gens σN) ∧
      c ≤ tmGLSOutC (pointwiseStabPrim h).c (pointwiseStabPrim h).k
          (Val.list [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]]).wt) := by
  set a : Val := .list [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]] with ha
  have hwa : (Val.list [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]]).wt = a.wt := rfl
  set R := tmGLSRedC (pointwiseStabPrim h).c (pointwiseStabPrim h).k (2 * a.wt + 6) with hR
  -- weights
  have wr : (Val.list [encPerm t, encGroup L]).wt < a.wt := wt_le_wt_list (by simp)
  have wN : (encGroup σN).wt < a.wt := wt_le_wt_list (by simp)
  have wτ : (encPerm τ).wt < a.wt := wt_le_wt_list (by simp)
  have wL : (encGroup L).wt < (Val.list [encPerm t, encGroup L]).wt := wt_le_wt_list (by simp)
  have wt : (encPerm t).wt < (Val.list [encPerm t, encGroup L]).wt := wt_le_wt_list (by simp)
  have hnW : n < a.wt := by have := tmGLP_n_lt_wt τ; omega
  have hsum : (encGroup σN).wt + (encPerm τ).wt + (Val.list [encPerm t, encGroup L]).wt < a.wt := by
    have := sum_wt_lt_wt_list [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]]
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil] at this
    omega
  set Y := (a.wt + 1) ^ 8 with hY
  have hY1 : a.wt + 1 ≤ Y := Nat.le_self_pow (by norm_num) _
  have hYn : ∀ j, j ≤ 8 → (n + 1) ^ j ≤ Y := fun j hj =>
    (Nat.pow_le_pow_left (show n + 1 ≤ a.wt + 1 by omega) j).trans
      (Nat.pow_le_pow_right (by omega) hj)
  -- 1. the cut
  have e0 := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]])
    (rest := []) (j := 0) rfl
  have e2 := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]])
    (rest := []) (j := 2) rfl
  have eL := Det.get' e2 (Det.nat 1) (vs := [encPerm t, encGroup L]) rfl
  have win := wt_list2_le (encGroup σN) (encGroup L)
  have dred := tmGLSRed_spec h hred happ hmg hj σN L
  have hRC : tmGLSRedC (pointwiseStabPrim h).c (pointwiseStabPrim h).k
      (Val.list [encGroup σN, encGroup L]).wt ≤ R :=
    tmGLSRedC_mono _ _ (by omega)
  have dcall : EvalAll P [a] (.call red (mk2 (arg 0) (.get (arg 2) (.nat 1)))) (fun w c =>
      (∃ hs : List (Perm (Fin n)), w = encGroup hs ∧ hs.length ≤ n ^ 2 ∧
        gens hs = gens L ⊔ gens σN) ∧ c ≤ 2 * R + 20 * a.wt + 70) :=
    EvalAll.call_funAll (Det.mk2 e0 eL) fun v ca hv => by
      obtain ⟨rfl, hca⟩ := hv
      refine (FunAll.wt_lt dred).mono fun w cb ⟨⟨hs, hw, hl, hg, hcb⟩, hwt⟩ =>
        ⟨⟨hs, hw, hl, hg⟩, ?_⟩
      omega
  refine EvalAll.letE dcall fun v1 c1 hv1 => ?_
  obtain ⟨⟨hs, rfl, hl, hg⟩, hc1⟩ := hv1
  -- 2. `τ⁻¹`
  have f1 := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]])
    (rest := [encGroup hs]) (j := 1) rfl
  have wτi := wt_encPerm_le τ⁻¹
  have dinv := (Det.call f1 (inv_spec hinv τ)).mono (c' := 10 ^ 6 * Y) (by
    have := hYn 4 (by norm_num); have := hYn 2 (by norm_num); unfold invK; omega)
  refine EvalAll.letE dinv fun v2 c2 hv2 => ?_
  obtain ⟨rfl, hc2⟩ := hv2
  -- 3. `t τ`, `n`, and the conjugates
  have g0 := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]])
    (rest := [encGroup hs, encPerm τ⁻¹]) (j := 0) rfl
  have g1 := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]])
    (rest := [encGroup hs, encPerm τ⁻¹]) (j := 1) rfl
  have g2 := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, .list [encPerm t, encGroup L]])
    (rest := [encGroup hs, encPerm τ⁻¹]) (j := 2) rfl
  have gt := Det.get' g2 (Det.nat 0) (vs := [encPerm t, encGroup L]) rfl
  have wtτ := wt_encPerm_le (t * τ)
  have wtt := wt_list2_le (encPerm t) (encPerm τ)
  have dcp := (Det.call (Det.mk2 gt g1) (compose_spec hcp t τ)).mono (c' := 10 ^ 6 * Y) (by
    have := hYn 3 (by norm_num); have := hYn 2 (by norm_num); unfold permK; omega)
  have gn := (Det.get' g0 (Det.nat 0) (vs := [.nat n, .list ((1 :: σN).map encPerm)]) rfl).mono
    (c' := 10 * Y) (by have := wt_nat_le n; omega)
  have v2' := Det.var' (P := P) (env := [a, encGroup hs, encPerm τ⁻¹]) (i := 2) rfl
  have v1' := Det.var' (P := P) (env := [a, encGroup hs, encPerm τ⁻¹]) (i := 1) rfl
  have gl := Det.get' v1' (Det.nat 1) (vs := [.nat n, .list ((1 :: hs).map encPerm)]) rfl
  have hconj := supConjMap_det hcp hcj hmc τ⁻¹ hl
  rw [inv_inv] at hconj
  have whs := wt_encGroup_le_sq hl
  have hl' : (hs.map fun x => τ⁻¹ * x * τ).length ≤ n ^ 2 := by simpa using hl
  have whs' := wt_encGroup_le_sq hl'
  have wl1 : (Val.list ((1 :: hs).map encPerm)).wt ≤ (encGroup hs).wt :=
    (wt_le_wt_list (vs := [.nat n, .list ((1 :: hs).map encPerm)]) (by simp)).le
  have wl2 : (Val.list ((1 :: hs.map fun x => τ⁻¹ * x * τ).map encPerm)).wt ≤
      (encGroup (hs.map fun x => τ⁻¹ * x * τ)).wt :=
    (wt_le_wt_list (vs := [.nat n, .list ((1 :: hs.map fun x => τ⁻¹ * x * τ).map encPerm)])
      (by simp)).le
  have wii := wt_list2_le (encPerm τ⁻¹) (encPerm τ)
  have wiil := wt_list2_le (.list [encPerm τ⁻¹, encPerm τ]) (.list ((1 :: hs).map encPerm))
  have dmc := (Det.call (Det.mk2 (Det.mk2 v2' g1) gl) hconj).mono (c' := 10 ^ 9 * Y) (by
    have := hYn 8 (by norm_num); have := hYn 6 (by norm_num); have := hYn 2 (by norm_num)
    omega)
  have dout := Det.mk2 dcp (Det.mk2 gn dmc)
  refine dout.post fun c hc => ⟨⟨hs, rfl, hl, hg⟩, ?_⟩
  -- the cost
  have hw6 := hYn 6 (by norm_num)
  have hw2 := hYn 2 (by norm_num)
  have wn := wt_nat_le n
  have wo1 := wt_list2_le (.nat n) (.list ((1 :: hs.map fun x => τ⁻¹ * x * τ).map encPerm))
  have wo2 := wt_list2_le (encPerm (t * τ)) (.list [.nat n,
    .list ((1 :: hs.map fun x => τ⁻¹ * x * τ).map encPerm)])
  have ew : (encGroup (hs.map fun x => τ⁻¹ * x * τ)) =
      .list [.nat n, .list ((1 :: hs.map fun x => τ⁻¹ * x * τ).map encPerm)] := rfl
  unfold tmGLSOutC
  rw [← hR, ← hY]
  clear dout dmc dcp gn gl v1' v2' g0 g1 g2 gt dinv f1 dcall dred e0 e2 eL hconj
  omega

/-- **The output program.** On `[encGroup σN, encPerm τ, u]` with `u` an affine answer, the
result is `[]` for `u = []`, and `[t τ, encGroup (τ⁻¹ hs τ)]` with `⟨hs⟩ = ⟨L⟩ ⊔ ⟨σN⟩` and at
most `n²` generators for `u = [t, encGroup L]`. -/
theorem tmGLSOut_spec (h : PointwiseStab) {P : Program} {f red app mg jp inv cp cj mc : ℕ}
    (hf : P.funs[f]? = some (tmGLSOutF red inv cp mc))
    (hred : P.funs[red]? = some (tmGLSRedF app mg jp)) (happ : P.HasAt app (appendFuns app))
    (hmg : P.HasAt mg (mkGroupFuns mg)) (hj : P.prims[jp]? = some (pointwiseStabPrim h))
    (hinv : P.HasAt inv (invFuns inv)) (hcp : P.HasAt cp (composeFuns cp))
    (hcj : P.funs[cj]? = some (supConjF cp)) (hmc : P.HasAt mc (mapFuns mc cj))
    (σN : List (Perm (Fin n))) (τ : Perm (Fin n)) {u : Val}
    (hu : u = .list [] ∨ ∃ (t : Perm (Fin n)) (L : List (Perm (Fin n))),
      u = .list [encPerm t, encGroup L]) :
    FunAll P f (.list [encGroup σN, encPerm τ, u]) (fun w c => TmGLSOutRes σN τ u w ∧
      c ≤ 3 * tmGLSOutC (pointwiseStabPrim h).c (pointwiseStabPrim h).k
        (Val.list [encGroup σN, encPerm τ, u]).wt) := by
  apply FunAll.intro hf
  have du := Det.arg' (P := P) (vs := [encGroup σN, encPerm τ, u]) (rest := []) (j := 2) rfl
  have hC : 2 * (Val.list [encGroup σN, encPerm τ, u]).wt + 20 ≤
      tmGLSOutC (pointwiseStabPrim h).c (pointwiseStabPrim h).k
        (Val.list [encGroup σN, encPerm τ, u]).wt := by
    unfold tmGLSOutC
    have : (Val.list [encGroup σN, encPerm τ, u]).wt + 1 ≤
        ((Val.list [encGroup σN, encPerm τ, u]).wt + 1) ^ 8 := Nat.le_self_pow (by norm_num) _
    omega
  rcases hu with rfl | ⟨t, L, rfl⟩
  · -- `u = []`
    have dres := Det.ite_zero (t := tmGLSOutB red inv cp mc) (Det.length du)
      (Det.nil (P := P) (env := [.list [encGroup σN, encPerm τ, .list []]]))
    refine dres.post fun c hc => ⟨Or.inl ⟨rfl, rfl⟩, ?_⟩
    have h2 : (Val.list []).wt ≤ 5 := by decide
    simp only [List.length_nil] at hc
    omega
  · -- `u = [t, encGroup L]`
    have dl := Det.length du
    refine EvalAll.ite dl (fun _ _ h => ⟨2, h.1⟩) fun y cc hy => ?_
    obtain ⟨h1, h2⟩ := hy
    cases h1
    rw [if_neg (by simp)]
    refine (tmGLSOutB_spec h hred happ hmg hj hinv hcp hcj hmc σN τ t L).wt_lt.mono ?_
    intro w cb hw
    obtain ⟨⟨⟨hs, hw, hl, hg⟩, hcb⟩, hwt⟩ := hw
    refine ⟨Or.inr ⟨t, L, hs, rfl, hw, hl, hg⟩, ?_⟩
    simp only [List.length_cons, List.length_nil] at h2
    omega

end GI.Impl
