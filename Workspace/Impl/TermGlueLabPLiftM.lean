import Workspace.Impl.RowA18Link
import Workspace.Impl.AggPairs

/-!
# The lifts `k(s)` of the label step: the mathematics

Proof of Theorem A.23. The offsets `u(s)` need, for each generator `s` of `H`, a
blockwise element of `G|_dom` whose coordinate at row `0` is `s` (any one does: `tmGLu_indep`,
`tmGL_blockwise`). Theorem A.18: "Standard constructive quotient operations then
give all displayed maps and lifts." The program finds one in three steps:

1. the label kernel `K = G ∩ ker π` in graph form, by **PointwiseStab** (`rowKer_spec`);
2. the pairs `(a, a|_{row 0})` for the generators `a` of `K` (`partNat`); they generate the graph
   of the row-`0` restriction of `K` (`tmGLP_pairs`);
3. a lift `(a, s)` of `s` in that graph, by one **NormalizedFactor** call (`liftLab_spec`), and
   the parts of `a` on all rows (`partNat` again).

This file proves what the program needs:

* `tmGLP_pairs`: the pairs of step 2, as values, generate the image of `K` under
  `g ↦ (g, g|_{row 0})` (`tmGLPχ`);
* `tmGLP_pairs_exists`: every `s ∈ H` has some `(a, s)` in that image (by `mem_Hb_ofPure`);
* `tmGLP_lift_of_pair`: from `(a, s)` in the image, the parts of `a` on all rows, as the program
  computes them, encode a tuple `y` with `cleanRowPerm E y ∈ G|_dom` and `y 0 = s`.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang GI.Paper Equiv Equiv.Perm
open GI.Cited (Val encPerm gens)

variable {Ω C : Type} {n : ℕ} {e : Ω ≃ Fin n} {S : State Ω C} {L : GiantLabels S}
  {label : Ω → Fin L.q} {m : ℕ} (E : Fin m × Fin L.q ≃ S.dom)

section Pairs

variable (hnat : NaturalRows S L label) (hE : ∀ b i, label (E (b, i)) = i)

include hnat hE in
/-- The restriction of an element of the label kernel preserves every row. -/
theorem tmGLP_row (x : (kerG S L).subgroupOf S.G) : S.domHom x.val ∈ rowPres E :=
  (mem_rowPres_iff E hnat hE x.val).2 ((mem_kerG_iff x.val).1 (Subgroup.mem_subgroupOf.1 x.2))

variable (e)

/-- **The pair map** `g ↦ (g, g|_{row i0})` on the label kernel. -/
noncomputable def tmGLPχ (i0 : Fin L.q) :
    (kerG S L).subgroupOf S.G →* Perm (Fin n) × Perm (Fin m) :=
  MonoidHom.prod ((toFin e).toMonoidHom.comp (S.G.subtype.comp ((kerG S L).subgroupOf S.G).subtype))
    ((rowPart E i0).comp (MonoidHom.codRestrict
      (S.domHom.comp ((kerG S L).subgroupOf S.G).subtype) (rowPres E) (tmGLP_row E hnat hE)))

variable {e}

theorem tmGLPχ_apply (i0 : Fin L.q) (x : (kerG S L).subgroupOf S.G) :
    tmGLPχ e E hnat hE i0 x =
      (toFin e x.val.val, rowPart E i0 ⟨S.domHom x.val, tmGLP_row E hnat hE x⟩) := rfl

/-- **The pairs `(a, a|_{row i0})` generate the image of `tmGLPχ`.** -/
theorem tmGLP_pairs (i0 : Fin L.q) {qs : List (Perm (Fin n) × Perm (Fin L.q))}
    (hqs : PairGens e L (kerG S L) qs) :
    ∃ ps : List (Perm (Fin n) × Perm (Fin m)),
      qs.map (fun p => Val.list [encPerm p.1,
        natList (partNat ((rowList e E i0).map Fin.val) p.1)]) = ps.map pairV ∧
      ps.length = qs.length ∧
      Subgroup.closure {p | p ∈ ps} = (tmGLPχ e E hnat hE i0).range := by
  classical
  have hmem : ∀ p ∈ qs, ∃ x : S.G, x.val ∈ kerG S L ∧ gpair e L x = p := by
    intro p hp
    have : p ∈ graphOf e L (kerG S L) := hqs ▸ Subgroup.subset_closure hp
    obtain ⟨g, hg, hA, h1, h2⟩ := (mem_graphOf e L).1 this
    exact ⟨⟨g, hg⟩, hA, Prod.ext h1 h2⟩
  let xOf : {p // p ∈ qs} → (kerG S L).subgroupOf S.G := fun p =>
    ⟨(hmem p.1 p.2).choose, Subgroup.mem_subgroupOf.2 (hmem p.1 p.2).choose_spec.1⟩
  have hxp : ∀ p, gpair e L (xOf p).val = p.1 := fun p => (hmem p.1 p.2).choose_spec.2
  refine ⟨qs.attach.map fun p => tmGLPχ e E hnat hE i0 (xOf p), ?_, by simp, ?_⟩
  · conv_lhs => rw [← List.attach_map_subtype_val qs]
    rw [List.map_map, List.map_map]
    apply List.map_congr_left
    intro p _
    simp only [Function.comp_apply, tmGLPχ_apply]
    have h1 : p.1.1 = toFin e (xOf p).val.val := by rw [← hxp p]; rfl
    rw [h1, partNat_eq e E i0 _ (tmGLP_row E hnat hE (xOf p))]
    show Val.list [_, Val.list _] = Val.list [_, Val.list _]
    rw [List.map_map]
    rfl
  · -- the label kernel is generated by the elements `xOf p`
    set T : Set S.G := {x | gpair e L x ∈ qs} with hT
    have hK : Subgroup.closure T = (kerG S L).subgroupOf S.G := by
      apply Subgroup.map_injective (gpair_injective (L := L) (e := e))
      rw [MonoidHom.map_closure]
      show _ = graphOf e L (kerG S L)
      rw [← hqs]
      congr 1
      ext p
      simp only [Set.mem_image, Set.mem_setOf_eq, hT]
      constructor
      · rintro ⟨x, hx, rfl⟩; exact hx
      · intro hp
        obtain ⟨x, -, hx⟩ := hmem p hp
        exact ⟨x, hx ▸ hp, hx⟩
    have htop : Subgroup.closure ((((kerG S L).subgroupOf S.G).subtype) ⁻¹' T) = ⊤ := by
      have h := Subgroup.closure_closure_coe_preimage (k := T)
      rw [hK] at h
      exact h
    rw [MonoidHom.range_eq_map, ← htop, MonoidHom.map_closure]
    congr 1
    ext σ
    simp only [List.mem_map, List.mem_attach, true_and, Set.mem_setOf_eq, Set.mem_image,
      Set.mem_preimage, Subgroup.coe_subtype]
    constructor
    · rintro ⟨p, rfl⟩
      exact ⟨xOf p, by show gpair e L (xOf p).val ∈ qs; rw [hxp p]; exact p.2, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      refine ⟨⟨_, hx⟩, ?_⟩
      have : xOf ⟨_, hx⟩ = x := Subtype.ext (gpair_injective (hxp ⟨_, hx⟩))
      rw [this]

end Pairs

/-! ### The lift from a pair -/

/-- The rows of a row-preserving permutation, as the program computes them. -/
theorem tmGLP_parts (g : S.G) (hg : S.domHom g ∈ rowPres E) :
    ((List.finRange L.q).map fun i =>
        natList (partNat ((rowList e E i).map Fin.val) (toFin e g.val))) =
      (List.finRange L.q).map fun i => encPerm (rowPart E i ⟨_, hg⟩) := by
  apply List.map_congr_left
  intro i _
  rw [partNat_eq e E i g hg]
  show Val.list _ = Val.list _
  rw [List.map_map]
  rfl

/-- **A lift from a pair of the image.** If `(a, s)` lies in the image of `tmGLPχ` (row `i0`),
then the parts of `a` on all rows, as the program computes them, encode a tuple `y` with
`cleanRowPerm E y ∈ G|_dom` and `y i0 = s`. -/
theorem tmGLP_lift_of_pair (hnat : NaturalRows S L label) (hE : ∀ b i, label (E (b, i)) = i)
    (i0 : Fin L.q) {a : Perm (Fin n)} {s : Perm (Fin m)}
    (h : (a, s) ∈ (tmGLPχ e E hnat hE i0).range) :
    ∃ y : Fin L.q → Perm (Fin m),
      ((List.finRange L.q).map fun i => natList (partNat ((rowList e E i).map Fin.val) a)) =
        (List.finRange L.q).map (fun i => encPerm (y i)) ∧
      cleanRowPerm E y ∈ S.domGroup ∧ y i0 = s := by
  obtain ⟨x, hx⟩ := h
  rw [tmGLPχ_apply, Prod.mk.injEq] at hx
  obtain ⟨ha, hs⟩ := hx
  have hrow := tmGLP_row E hnat hE x
  refine ⟨fun i => rowPart E i ⟨_, hrow⟩, ?_, ?_, hs⟩
  · rw [← ha]
    exact tmGLP_parts E x.val hrow
  · rw [← eq_cleanRowPerm E ⟨_, hrow⟩]
    exact ⟨x.val, rfl⟩

/-- **Every `s ∈ H` has a pair in the image** (row `0`). -/
theorem tmGLP_pairs_exists (hnat : NaturalRows S L label) (hE : ∀ b i, label (E (b, i)) = i)
    (i0 : Fin L.q) {s : Perm (Fin m)}
    (hs : ∃ y : Fin L.q → Perm (Fin m), cleanRowPerm E y ∈ S.domGroup ∧ y i0 = s) :
    ∃ a, (a, s) ∈ (tmGLPχ e E hnat hE i0).range := by
  obtain ⟨y, ⟨g, hg⟩, rfl⟩ := hs
  have hrow : S.domHom g ∈ rowPres E := by rw [hg]; exact cleanRowPerm_mem_rowPres E y
  have hker : g.val ∈ kerG S L := (mem_kerG_iff g).2 ((mem_rowPres_iff E hnat hE g).1 hrow)
  refine ⟨toFin e g.val, ⟨⟨g, Subgroup.mem_subgroupOf.2 hker⟩, ?_⟩⟩
  rw [tmGLPχ_apply]
  refine Prod.ext rfl ?_
  show rowPart E i0 ⟨S.domHom g, _⟩ = y i0
  have : (⟨S.domHom g, tmGLP_row E hnat hE ⟨g, Subgroup.mem_subgroupOf.2 hker⟩⟩ : rowPres E) =
      ⟨cleanRowPerm E y, cleanRowPerm_mem_rowPres E y⟩ := Subtype.ext hg
  rw [this]
  exact rowPart_cleanRowPerm E y i0

end GI.Impl
