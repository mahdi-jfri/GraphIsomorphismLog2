module

public import Workspace.Impl.AggCmpPick
public import Workspace.Impl.AggCmpInit

@[expose] public section

/-!
# Lifted groups stand for restricted cosets

The comparison program keeps each comparison coset `g H ⊆ G|_dom` as a lifted group on the `k`
positions and a representative. The lift of `H` is the set of `g ∈ G` whose restriction lies
in `H`. It contains the kernel `G_(dom)` of the restriction (`cmKer`). This file shows that the
lifted groups carry the same information as the restricted ones, and gives the two cosets the
program builds.

* `cm_map_inj_of_ker_le`, `cm_liftGroup_inj`: the restriction is injective on groups above the
  kernel. So two lifted groups are equal exactly when the restricted groups are.
* `cmRes Hl`: the restriction of a group `Hl ≤ G`; `cm_lift_res`: its lift is `Hl` when `Hl`
  contains the kernel.
* `CmEntOK`: a cache value `(gs, a)` stands for an entry `(H, g)` (lifted group generated by
  `gs`, `a` the positions of a lift of `g`). `cm_entSet_eq_iff`: two such entries have the same
  coset exactly when `⟨gs⟩ = ⟨gs'⟩` and `a⁻¹ a' ∈ ⟨gs⟩`. These are two subgroup tests and one
  **Membership** test.
* `cm_next_entry`: the coset `g₀ · B|_dom` after a call with answer `x ⟨gs⟩` is the entry
  `(gs, a₀ x)`, with `a₀` the positions of the lift of `g₀`. The answer is closed under the kernel
  (`cm_answer_ker`), which makes `⟨gs⟩` contain the kernel.
* `cm_zero_entry`: the first coset of a comparison is the entry of the first parts of the graph
  stabilizer of the label points of `t`, with the first part of a transversal element.
-/

set_option linter.unusedSectionVars false

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Lang Equiv Equiv.Perm GI.LocalGroups GI.Endpoint
  GI.LocalCertificates
open GI.Cited (Val encPerm gens)
open scoped Pointwise

/-! ### Injectivity above the kernel -/

/-- **`Subgroup.map` is injective on groups above the kernel.** -/
theorem cm_map_inj_of_ker_le {G H : Type} [Group G] [Group H] (f : G →* H)
    {A B : Subgroup G} (hA : f.ker ≤ A) (hB : f.ker ≤ B) (h : A.map f = B.map f) : A = B :=
  Subgroup.map_injective_of_ker_le f hA hB h

section Lift

variable {k : ℕ} {Ω C : Type} {S : State Ω C}

/-- **The kernel of the restriction**: the elements of `G` that fix the domain pointwise. -/
def cmKer (S : State Ω C) : Subgroup (Perm Ω) := S.liftGroup ⊥

theorem mem_cmKer {g : Perm Ω} : g ∈ cmKer S ↔ ∃ hg : g ∈ S.G, S.domHom ⟨g, hg⟩ = 1 := by
  rw [cmKer, State.mem_liftGroup]
  simp [Subgroup.mem_bot]

/-- The kernel lies in every lifted group. -/
theorem cmKer_le_lift (N : Subgroup (Perm S.dom)) : cmKer S ≤ S.liftGroup N := by
  intro g hg
  obtain ⟨hg, h1⟩ := mem_cmKer.1 hg
  exact State.mem_liftGroup.2 ⟨hg, by rw [h1]; exact N.one_mem⟩

/-- **The lift is injective on subgroups of `G|_dom`.** -/
theorem cm_liftGroup_inj {N N' : Subgroup (Perm S.dom)} (hN : N ≤ S.domGroup)
    (hN' : N' ≤ S.domGroup) (h : S.liftGroup N = S.liftGroup N') : N = N' := by
  have key : ∀ {A B : Subgroup (Perm S.dom)}, A ≤ S.domGroup →
      S.liftGroup A = S.liftGroup B → A ≤ B := by
    intro A B hA hAB x hx
    obtain ⟨⟨g, hg⟩, rfl⟩ := hA hx
    have : g ∈ S.liftGroup A := State.mem_liftGroup.2 ⟨hg, hx⟩
    rw [hAB] at this
    obtain ⟨hg', hB⟩ := State.mem_liftGroup.1 this
    exact hB
  exact le_antisymm (key hN h) (key hN' h.symm)

/-- **The restriction of a group `Hl` of permutations of `Ω`** (its part in `G`). -/
def cmRes (S : State Ω C) (Hl : Subgroup (Perm Ω)) : Subgroup (Perm S.dom) :=
  (Hl.subgroupOf S.G).map S.domHom

theorem cmRes_le (Hl : Subgroup (Perm Ω)) : cmRes S Hl ≤ S.domGroup := by
  rintro _ ⟨g, -, rfl⟩
  exact ⟨g, rfl⟩

theorem mem_cmRes {Hl : Subgroup (Perm Ω)} {x : Perm S.dom} :
    x ∈ cmRes S Hl ↔ ∃ g, ∃ hg : g ∈ S.G, g ∈ Hl ∧ S.domHom ⟨g, hg⟩ = x := by
  simp only [cmRes, Subgroup.mem_map, Subgroup.mem_subgroupOf]
  constructor
  · rintro ⟨⟨g, hg⟩, h, rfl⟩
    exact ⟨g, hg, h, rfl⟩
  · rintro ⟨g, hg, h, rfl⟩
    exact ⟨⟨g, hg⟩, h, rfl⟩

/-- **A group between the kernel and `G` is the lift of its restriction.** -/
theorem cm_lift_res {Hl : Subgroup (Perm Ω)} (hG : Hl ≤ S.G) (hK : cmKer S ≤ Hl) :
    S.liftGroup (cmRes S Hl) = Hl := by
  ext g
  rw [State.mem_liftGroup]
  constructor
  · rintro ⟨hg, hr⟩
    obtain ⟨g', hg', hH, he⟩ := mem_cmRes.1 hr
    -- `g'⁻¹ g` lies in the kernel
    have hk : g'⁻¹ * g ∈ cmKer S := by
      refine mem_cmKer.2 ⟨S.G.mul_mem (S.G.inv_mem hg') hg, ?_⟩
      have : (⟨g'⁻¹ * g, S.G.mul_mem (S.G.inv_mem hg') hg⟩ : S.G) = (⟨g', hg'⟩ : S.G)⁻¹ * ⟨g, hg⟩ :=
        rfl
      rw [this, map_mul, map_inv, he, inv_mul_cancel]
    have := Hl.mul_mem hH (hK hk)
    rwa [mul_inv_cancel_left] at this
  · intro h
    exact ⟨hG h, mem_cmRes.2 ⟨g, hG h, h, rfl⟩⟩

/-- **Restriction is injective on groups between the kernel and `G`.** -/
theorem cm_res_inj {Hl Hl' : Subgroup (Perm Ω)} (hG : Hl ≤ S.G) (hK : cmKer S ≤ Hl)
    (hG' : Hl' ≤ S.G) (hK' : cmKer S ≤ Hl') (h : cmRes S Hl = cmRes S Hl') : Hl = Hl' := by
  rw [← cm_lift_res hG hK, ← cm_lift_res hG' hK', h]

/-- The restriction of a coset `g Hl` of a group `Hl ≤ G`, for `g ∈ G`. -/
theorem cm_restrict_coset {Hl : Subgroup (Perm Ω)} (hG : Hl ≤ S.G) {g : Perm Ω} (hg : g ∈ S.G) :
    restrictAns S (g • (Hl : Set (Perm Ω))) = S.domHom ⟨g, hg⟩ • (cmRes S Hl : Set (Perm S.dom)) := by
  ext x
  simp only [restrictAns, Set.mem_setOf_eq, Set.mem_smul_set, smul_eq_mul, SetLike.mem_coe]
  constructor
  · rintro ⟨_, hgh, ⟨h, hh, rfl⟩, rfl⟩
    refine ⟨S.domHom ⟨h, hG hh⟩, mem_cmRes.2 ⟨h, hG hh, hh, rfl⟩, ?_⟩
    rw [← map_mul]
    rfl
  · rintro ⟨_, hr, rfl⟩
    obtain ⟨h, hh, hH, rfl⟩ := mem_cmRes.1 hr
    exact ⟨g * h, S.G.mul_mem hg hh, ⟨h, hH, rfl⟩, by rw [← map_mul]; rfl⟩

end Lift

/-! ### Cache entries on positions -/

section Ent

variable {k : ℕ} {Ω C : Type} (e : Ω ≃ Fin k) (S : State Ω C)

/-- **A cache value `(gs, a)` stands for an entry `E = (H, g)`**: `H ≤ G|_dom`, the group
generated by `gs` is the lift of `H` on positions, and `a` is the positions of a lift of `g`. -/
def CmEntOK (p : List (Perm (Fin k)) × Perm (Fin k)) (E : CmEnt S.dom) : Prop :=
  E.1 ≤ S.domGroup ∧ gens p.1 = groupFin e (S.liftGroup E.1) ∧ (toFin e).symm p.2 ∈ S.G ∧
    domOfPos e S p.2 = E.2

variable {e S}

theorem domOfPos_of_mem {a : Perm (Fin k)} (h : (toFin e).symm a ∈ S.G) :
    domOfPos e S a = S.domHom ⟨_, h⟩ := by
  have := domOfPos_toFin e S h
  rwa [MulEquiv.apply_symm_apply] at this

theorem cm_mem_groupFin {H : Subgroup (Perm Ω)} {a : Perm (Fin k)} :
    a ∈ groupFin e H ↔ (toFin e).symm a ∈ H := by
  simp only [groupFin, Subgroup.mem_map, MulEquiv.coe_toMonoidHom]
  constructor
  · rintro ⟨g, hg, rfl⟩
    rwa [MulEquiv.symm_apply_apply]
  · intro h
    exact ⟨_, h, MulEquiv.apply_symm_apply _ _⟩

theorem cm_groupFin_inj {H H' : Subgroup (Perm Ω)} (h : groupFin e H = groupFin e H') : H = H' :=
  Subgroup.map_injective (toFin e).injective h

/-- **Two entries have the same coset** exactly when their lifted groups are equal and
`a⁻¹ a'` lies in the first one. -/
theorem cm_entSet_eq_iff {p p' : List (Perm (Fin k)) × Perm (Fin k)} {E E' : CmEnt S.dom}
    (h : CmEntOK e S p E) (h' : CmEntOK e S p' E') :
    cmEntSet E = cmEntSet E' ↔ gens p.1 = gens p'.1 ∧ p.2⁻¹ * p'.2 ∈ gens p.1 := by
  obtain ⟨hle, hgs, hG, hE⟩ := h
  obtain ⟨hle', hgs', hG', hE'⟩ := h'
  unfold cmEntSet
  rw [cm_coset_eq_iff, hgs, hgs', cm_mem_groupFin, map_mul, map_inv, State.mem_liftGroup,
    ← hE, ← hE', domOfPos_of_mem hG, domOfPos_of_mem hG']
  refine and_congr ⟨fun h => by rw [h], fun h => cm_liftGroup_inj hle hle' (cm_groupFin_inj h)⟩ ?_
  constructor
  · intro hm
    refine ⟨S.G.mul_mem (S.G.inv_mem hG) hG', ?_⟩
    have : (⟨((toFin e).symm p.2)⁻¹ * (toFin e).symm p'.2,
        S.G.mul_mem (S.G.inv_mem hG) hG'⟩ : S.G) = (⟨_, hG⟩ : S.G)⁻¹ * ⟨_, hG'⟩ := rfl
    rw [this, map_mul, map_inv]
    exact hm
  · rintro ⟨hm, hN⟩
    have : (⟨((toFin e).symm p.2)⁻¹ * (toFin e).symm p'.2, hm⟩ : S.G) =
        (⟨_, hG⟩ : S.G)⁻¹ * ⟨_, hG'⟩ := rfl
    rw [this, map_mul, map_inv] at hN
    exact hN

/-- **An entry from a lifted group**: if `gs` generates the positions of a group `Hl` between
the kernel and `G`, and `a` is the positions of an element of `G`, then `(gs, a)` stands for
the entry `(Hl|_dom, a|_dom)`. -/
theorem cmEntOK_of_lift {Hl : Subgroup (Perm Ω)} (hG : Hl ≤ S.G) (hK : cmKer S ≤ Hl)
    {gs : List (Perm (Fin k))} (hgs : gens gs = groupFin e Hl) {a : Perm (Fin k)}
    (ha : (toFin e).symm a ∈ S.G) :
    CmEntOK e S (gs, a) (cmRes S Hl, domOfPos e S a) :=
  ⟨cmRes_le Hl, by rw [cm_lift_res hG hK]; exact hgs, ha, rfl⟩

/-- The coset of such an entry is the restriction of the lifted coset. -/
theorem cm_entSet_lift {Hl : Subgroup (Perm Ω)} (hG : Hl ≤ S.G) {a : Perm (Fin k)}
    (ha : (toFin e).symm a ∈ S.G) :
    cmEntSet (cmRes S Hl, domOfPos e S a) =
      restrictAns S ((toFin e).symm a • (Hl : Set (Perm Ω))) := by
  rw [cm_restrict_coset hG ha, domOfPos_of_mem ha]
  rfl

end Ent

/-! ### The coset after a call -/

section Next

variable {k : ℕ} {Ω C : Type} [DecidableEq Ω] {e : Ω ≃ Fin k} {S : State Ω C} [Fintype S.dom]

/-- **The answer of a comparison call is closed under the kernel**: an element of the kernel
fixes the domain, so it changes neither the group condition nor the colors on the window. -/
theorem cm_answer_ker {C₀ : Type} {N : Subgroup (Perm S.dom)} {V : Finset S.dom}
    (hV : GI.Algorithm.Invariant N (V : Set S.dom)) (x y : S.dom → C₀) (g₀ : Perm S.dom)
    {b κ : Perm Ω} (hb : b ∈ (compareCall S N V hV x y g₀).answer) (hκ : κ ∈ cmKer S) :
    b * κ ∈ (compareCall S N V hV x y g₀).answer := by
  obtain ⟨hκG, hκ1⟩ := mem_cmKer.1 hκ
  have hfix : ∀ v ∈ S.dom, κ v = v := fun v hv => by
    have := congrArg (fun p : Perm S.dom => (p ⟨v, hv⟩ : Ω)) hκ1
    simpa using this
  rw [compareCall, State.queryChild_answer] at hb ⊢
  obtain ⟨hbL, hcol⟩ := hb
  refine ⟨Subgroup.mul_mem _ hbL (cmKer_le_lift N hκ), fun v hv => ?_⟩
  obtain ⟨w, hw, rfl⟩ := hv
  rw [Perm.mul_apply, hfix _ w.2]
  exact hcol _ ⟨w, hw, rfl⟩

/-- **The group of a coset closed under the kernel contains the kernel.** Let `A ⊆ G` be a set
of permutations with `toFin '' A = x ⟨gs⟩`, closed under right multiplication by the kernel.
Then the group `Hl` that `gs` generates on `Ω` lies between the kernel and `G`, and
`A = x̂ Hl` for the element `x̂` that `x` stands for. -/
theorem cm_coset_lift {A : Set (Perm Ω)} (hAG : A ⊆ S.G)
    (hK : ∀ b ∈ A, ∀ κ ∈ cmKer S, b * κ ∈ A) {x : Perm (Fin k)} {gs : List (Perm (Fin k))}
    (hA : toFin e '' A = x • (gens gs : Set (Perm (Fin k)))) :
    let Hl := (gens gs).map (toFin e).symm.toMonoidHom
    Hl ≤ S.G ∧ cmKer S ≤ Hl ∧ gens gs = groupFin e Hl ∧ (toFin e).symm x ∈ S.G ∧
      A = (toFin e).symm x • (Hl : Set (Perm Ω)) := by
  intro Hl
  have hmemHl : ∀ g, g ∈ Hl ↔ toFin e g ∈ gens gs := fun g => by
    simp only [Hl, Subgroup.mem_map, MulEquiv.coe_toMonoidHom]
    constructor
    · rintro ⟨a, ha, rfl⟩; rwa [MulEquiv.apply_symm_apply]
    · intro h; exact ⟨_, h, MulEquiv.symm_apply_apply _ _⟩
  -- `A` is the coset of `Hl` at `x̂`
  have hAeq : A = (toFin e).symm x • (Hl : Set (Perm Ω)) := by
    ext g
    have : g ∈ A ↔ toFin e g ∈ x • (gens gs : Set (Perm (Fin k))) := by
      rw [← hA]
      exact ⟨fun h => ⟨g, h, rfl⟩, fun ⟨g', h', he⟩ => (toFin e).injective he ▸ h'⟩
    rw [this]
    simp only [Set.mem_smul_set, smul_eq_mul, SetLike.mem_coe]
    constructor
    · rintro ⟨a, ha, he⟩
      refine ⟨(toFin e).symm a, (hmemHl _).2 (by rwa [MulEquiv.apply_symm_apply]), ?_⟩
      rw [← map_mul, he, MulEquiv.symm_apply_apply]
    · rintro ⟨h, hh, rfl⟩
      exact ⟨toFin e h, (hmemHl h).1 hh, by rw [map_mul, MulEquiv.apply_symm_apply]⟩
  have hx : (toFin e).symm x ∈ A := by
    rw [hAeq]; exact ⟨1, Hl.one_mem, by simp⟩
  have hxG := hAG hx
  refine ⟨fun h hh => ?_, fun κ hκ => ?_, ?_, hxG, hAeq⟩
  · have : (toFin e).symm x * h ∈ A := by rw [hAeq]; exact ⟨h, hh, rfl⟩
    have := S.G.mul_mem (S.G.inv_mem hxG) (hAG this)
    rwa [inv_mul_cancel_left] at this
  · have hb := hK _ hx κ hκ
    rw [hAeq] at hb
    obtain ⟨h, hh, he⟩ := hb
    simp only [smul_eq_mul] at he
    rw [mul_left_cancel he] at hh
    exact hh
  · ext a
    rw [cm_mem_groupFin, hmemHl, MulEquiv.apply_symm_apply]

/-- **The coset after a call.** Let `a₀` be the positions of an element `ĝ₀ ∈ G` with
restriction `g₀`, and let the answer `B` of the comparison call from `g₀` be `x ⟨gs⟩` on
positions. Then `g₀ · B|_dom` is the coset of an entry that `(gs, a₀ x)` stands for. -/
theorem cm_next_entry {C₀ : Type} {N : Subgroup (Perm S.dom)}
    {V : Finset S.dom} (hV : GI.Algorithm.Invariant N (V : Set S.dom)) (z z' : S.dom → C₀)
    {a₀ : Perm (Fin k)} (ha₀ : (toFin e).symm a₀ ∈ S.G) {x : Perm (Fin k)}
    {gs : List (Perm (Fin k))}
    (hB : toFin e '' (compareCall S N V hV z z' (domOfPos e S a₀)).answer =
      x • (gens gs : Set (Perm (Fin k)))) :
    ∃ E : CmEnt S.dom, CmEntOK e S (gs, a₀ * x) E ∧
      cmEntSet E = domOfPos e S a₀ • restrictAns S (compareCall S N V hV z z' (domOfPos e S a₀)).answer := by
  set B := (compareCall S N V hV z z' (domOfPos e S a₀)).answer with hBdef
  have hBG : B ⊆ S.G := fun b hb => by
    have : b ∈ S.liftGroup N := hb.1
    exact State.liftGroup_le N this
  obtain ⟨hG, hK, hgs, hxG, hBeq⟩ := cm_coset_lift (e := e) hBG
    (fun b hb κ hκ => cm_answer_ker hV z z' _ hb hκ) hB
  set Hl := (gens gs).map (toFin e).symm.toMonoidHom
  have hprod : (toFin e).symm (a₀ * x) = (toFin e).symm a₀ * (toFin e).symm x := map_mul _ _ _
  have hG' : (toFin e).symm (a₀ * x) ∈ S.G := by rw [hprod]; exact S.G.mul_mem ha₀ hxG
  refine ⟨_, cmEntOK_of_lift hG hK hgs hG', ?_⟩
  rw [cm_entSet_lift hG hG', hprod, hBeq, domOfPos_of_mem ha₀, cm_restrict_coset hG hxG,
    cm_restrict_coset hG (S.G.mul_mem ha₀ hxG), smul_smul]
  congr 1

/-- **An empty answer gives an empty coset.** -/
theorem cm_next_empty (g₀ : Perm S.dom) {B : Set (Perm Ω)} (hB : B = ∅) :
    g₀ • restrictAns S B = ∅ := by
  subst hB
  ext x
  simp [restrictAns]

end Next

/-! ### The first coset -/

section Zero

variable {k κ : ℕ} {Ω C : Type} [DecidableEq Ω] {e : Ω ≃ Fin k} {S : State Ω C} [Fintype S.dom]
  {L : GiantLabels S} (πd : S.domGroup →* alternatingGroup (Fin L.q))

/-- The permutations of the labels that fix every entry of `t`. -/
def cmFixT {q : ℕ} (t : Fin κ → Fin q) : Subgroup (Perm (Fin q)) where
  carrier := {σ | ∀ i, σ (t i) = t i}
  one_mem' := fun _ => rfl
  mul_mem' := fun {a b} ha hb i => by
    show a (b (t i)) = t i
    rw [hb i, ha i]
  inv_mem' := fun {a} ha i => by
    show a⁻¹ (t i) = t i
    rw [Perm.inv_eq_iff_eq, ha i]

/-- The lifted group of the first coset: the elements of `G` whose label permutation fixes every
entry of `t`. -/
def cmH0 (t : Fin κ → Fin L.q) : Subgroup (Perm Ω) := labPre (L := L) (cmFixT t)

theorem mem_cmH0 {t : Fin κ → Fin L.q} {g : Perm Ω} :
    g ∈ cmH0 (L := L) t ↔ ∃ hg : g ∈ S.G, ∀ i, (L.π ⟨g, hg⟩ : Perm (Fin L.q)) (t i) = t i :=
  Iff.rfl

theorem cmH0_le (t : Fin κ → Fin L.q) : cmH0 (L := L) t ≤ S.G := fun _ h => (mem_cmH0.1 h).1

theorem cmKer_le_H0 (hπ : ∀ g : S.G, πd ⟨S.domHom g, g, rfl⟩ = L.π g) (t : Fin κ → Fin L.q) :
    cmKer S ≤ cmH0 (L := L) t := by
  intro g hg
  obtain ⟨hgG, h1⟩ := mem_cmKer.1 hg
  refine mem_cmH0.2 ⟨hgG, fun i => ?_⟩
  rw [← hπ ⟨g, hgG⟩]
  have : (⟨S.domHom ⟨g, hgG⟩, ⟨g, hgG⟩, rfl⟩ : S.domGroup) = 1 := Subtype.ext h1
  rw [this, map_one]
  rfl

/-- **The graph stabilizer gives the lifted group of the first coset.** -/
theorem cm_pairGens_H0 {ps qs : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L S.G ps) (t : Fin κ → Fin L.q)
    (h : Subgroup.closure {p | p ∈ qs} =
      Subgroup.closure {p | p ∈ ps} ⊓ fixPts k L.q (cmLabPts k t)) :
    PairGens e L (cmH0 (L := L) t) qs := by
  unfold PairGens at *
  have hinf : cmH0 (L := L) t = S.G ⊓ cmH0 (L := L) t := (inf_eq_right.2 (cmH0_le t)).symm
  rw [h, hps, hinf, cmH0, graphOf_inf_labPre]
  congr 1
  ext p
  rw [Subgroup.mem_comap, MonoidHom.coe_snd]
  unfold cmLabPts
  rw [mem_fixPts_labPts]
  simp only [List.mem_map, List.mem_finRange, true_and, forall_exists_index,
    forall_apply_eq_imp_iff]
  rfl

/-- **The first coset is the coset of an entry**: for a member `ĝ ∈ G` of the transporter (on
positions `a`), the first coset is `ĝ|_dom · cmH0|_dom`. -/
theorem cm_zero_coset (hπ : ∀ g : S.G, πd ⟨S.domHom g, g, rfl⟩ = L.π g) {C₀ : Type}
    (x y : S.dom → C₀) (t t' : Fin κ → Fin L.q) {a : Perm (Fin k)}
    (ha : (toFin e).symm a ∈ S.G) (hmem : domOfPos e S a ∈ lockstep S.domGroup πd 0 x t y t') :
    lockstep S.domGroup πd 0 x t y t' = cmEntSet (cmRes S (cmH0 (L := L) t), domOfPos e S a) := by
  set g := (toFin e).symm a
  rw [cm_entSet_lift (cmH0_le t) ha]
  rw [domOfPos_of_mem ha, cm_lockstep_zero] at hmem
  obtain ⟨-, hlab⟩ := hmem
  rw [cm_lab_domHom πd hπ ha] at hlab
  ext h
  rw [cm_lockstep_zero]
  simp only [restrictAns, Set.mem_setOf_eq, Set.mem_smul_set, smul_eq_mul, SetLike.mem_coe]
  constructor
  · rintro ⟨⟨⟨h', hh'⟩, rfl⟩, hl⟩
    refine ⟨h', hh', ⟨g⁻¹ * h', mem_cmH0.2 ⟨S.G.mul_mem (S.G.inv_mem ha) hh', fun i => ?_⟩,
      mul_inv_cancel_left _ _⟩, rfl⟩
    rw [cm_lab_domHom πd hπ hh'] at hl
    have hmul : (⟨g⁻¹ * h', S.G.mul_mem (S.G.inv_mem ha) hh'⟩ : S.G) = (⟨g, ha⟩ : S.G)⁻¹ * ⟨h', hh'⟩ :=
      rfl
    rw [hmul, map_mul, map_inv]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Perm.mul_apply]
    rw [hl i, ← hlab i, Perm.inv_apply_self]
  · rintro ⟨h', hh', ⟨u, hu, rfl⟩, rfl⟩
    obtain ⟨huG, hfix⟩ := mem_cmH0.1 hu
    refine ⟨⟨⟨_, hh'⟩, rfl⟩, fun i => ?_⟩
    rw [cm_lab_domHom πd hπ hh']
    have hmul : (⟨g * u, hh'⟩ : S.G) = (⟨g, ha⟩ : S.G) * ⟨u, huG⟩ := rfl
    rw [hmul, map_mul]
    simp only [Subgroup.coe_mul, Perm.mul_apply]
    rw [hfix i, hlab i]

end Zero

end GI.Impl
