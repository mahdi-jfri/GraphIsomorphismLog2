module

public import Workspace.Impl.AggCosets
public import Workspace.Impl.ScriptCont

@[expose] public section

/-!
# The new stage of a round: the coset closure `A_{t+1}`

A round of Algorithm 2 asks one window call per coset representative `τ` of the kernel `N` in
`A_t`, and sets `A_{t+1} = ⟨⋃ τ · B_τ⟩`, where `B_τ` is the answer of the call restricted to the
domain (`winCont_nil`, `Workspace/Impl/ScriptCont.lean`). The program keeps groups as their lifts
to `G` in graph form (`PairGens`), so it must compute the graph form of the lift of `A_{t+1}`.

It knows, for each call, a lift `a_τ` of `τ` (a first part of the graph form of the lift of
`A_t`) and the answer as a coset `x_τ ⟨gs_τ⟩` of permutations of the positions (`AnsC`). The
elements `a_τ x_τ` and `a_τ x_τ h` (`h ∈ gs_τ`) generate the subgroup `⟨⋃ a_τ B_τ⟩` of `G`
(`closure_ansGens`). This subgroup is the whole lift of `A_{t+1}`, because it contains the kernel
of the restriction to the domain: every answer is closed under that kernel, and one answer is
nonempty (`closure_lift`). Its graph form comes from the cited **Preimage** task on the graph
group of `G` with the projection to the first part (`pairGens_fstPre`).

`pairGens_newStage` is the result used later.
-/

namespace GI.Impl

open GI.Algorithm GI.Assembly GI.Endpoint GI.LocalGroups Equiv Equiv.Perm
open GI.Cited (Val encPerm gens preimageSet)
open scoped Pointwise

variable {k : ℕ}

/-! ### Generators of a translated coset -/

/-- The generators of the group generated by the coset `c ⟨gs⟩`: `c` and `c h` for `h ∈ gs`. -/
def cosGens (c : Perm (Fin k)) (gs : List (Perm (Fin k))) : List (Perm (Fin k)) :=
  c :: gs.map (c * ·)

theorem closure_cosGens (c : Perm (Fin k)) (gs : List (Perm (Fin k))) :
    gens (cosGens c gs) = Subgroup.closure (c • (gens gs : Set (Perm (Fin k)))) := by
  apply le_antisymm
  · unfold gens
    rw [Subgroup.closure_le]
    intro m hm
    simp only [cosGens, Set.mem_setOf_eq, List.mem_cons, List.mem_map] at hm
    refine Subgroup.subset_closure ?_
    rcases hm with rfl | ⟨h, hh, rfl⟩
    · exact ⟨1, Subgroup.one_mem _, mul_one _⟩
    · exact ⟨h, Subgroup.subset_closure hh, rfl⟩
  · rw [Subgroup.closure_le]
    have hc : c ∈ gens (cosGens c gs) := Subgroup.subset_closure (by simp [cosGens])
    have hgs : gens gs ≤ gens (cosGens c gs) := by
      unfold gens
      rw [Subgroup.closure_le]
      intro h hh
      have hmem : c * h ∈ cosGens c gs := List.mem_cons_of_mem _ (List.mem_map_of_mem hh)
      have h1 : c * h ∈ gens (cosGens c gs) := Subgroup.subset_closure hmem
      have := (gens (cosGens c gs)).mul_mem ((gens (cosGens c gs)).inv_mem hc) h1
      rwa [inv_mul_cancel_left] at this
    intro z hz
    obtain ⟨y, hy, rfl⟩ := hz
    exact (gens (cosGens c gs)).mul_mem hc (hgs hy)

/-- The generators that one window answer contributes: none for an empty answer, and
`cosGens (a x) gs` for an answer `x ⟨gs⟩` with lift `a` of the representative. -/
def ansGens (a : Perm (Fin k)) : Option (Perm (Fin k) × List (Perm (Fin k))) → List (Perm (Fin k))
  | none => []
  | some (x, gs) => cosGens (a * x) gs

/-- What an answer value says, in a form without values: `none` for the empty answer, and
`some (x, gs)` for the coset `x ⟨gs⟩` of positions. -/
def AnsSet {Ω : Type} (e : Ω ≃ Fin k) (o : Option (Perm (Fin k) × List (Perm (Fin k))))
    (B : Set (Perm Ω)) : Prop :=
  match o with
  | none => B = ∅
  | some (x, gs) => toFin e '' B = x • (gens gs : Set (Perm (Fin k)))

theorem closure_ansGens {Ω : Type} (e : Ω ≃ Fin k) (a : Perm (Fin k))
    (o : Option (Perm (Fin k) × List (Perm (Fin k)))) (B : Set (Perm Ω)) (h : AnsSet e o B) :
    gens (ansGens a o) = Subgroup.closure (toFin e '' ((toFin e).symm a • B)) := by
  have himg : toFin e '' ((toFin e).symm a • B) = a • (toFin e '' B) := by
    ext y
    simp only [Set.mem_image, Set.mem_smul_set, smul_eq_mul]
    constructor
    · rintro ⟨_, ⟨b, hb, rfl⟩, rfl⟩
      exact ⟨toFin e b, ⟨b, hb, rfl⟩, by rw [map_mul, MulEquiv.apply_symm_apply]⟩
    · rintro ⟨_, ⟨b, hb, rfl⟩, rfl⟩
      exact ⟨(toFin e).symm a * b, ⟨b, hb, rfl⟩, by rw [map_mul, MulEquiv.apply_symm_apply]⟩
  rw [himg]
  match o, h with
  | none, h =>
    simp only [AnsSet] at h
    subst h
    simp [ansGens, gens]
  | some (x, gs), h =>
    simp only [AnsSet] at h
    rw [h, smul_smul, ansGens, closure_cosGens]

/-! ### The closure of the translated answers is a lift -/

section Lift

variable {Ω C : Type} (S : State Ω C)

/-- **A subgroup of `G` that contains the kernel of the restriction is the lift of its
restriction.** For `X ⊆ G` whose closure contains every element of `G` acting trivially on the
domain, `⟨X⟩` is the lift of `⟨X|_dom⟩`. -/
theorem closure_lift {X : Set (Perm Ω)} (hX : X ⊆ S.G)
    (hK : ∀ g (hg : g ∈ S.G), S.domHom ⟨g, hg⟩ = 1 → g ∈ Subgroup.closure X) :
    Subgroup.closure X = S.liftGroup (Subgroup.closure (restrictAns S X)) := by
  -- `X` as a subset of `G`.
  set X' : Set S.G := {g | (g : Perm Ω) ∈ X} with hX'
  have hsub : (Subgroup.closure X').map S.G.subtype = Subgroup.closure X := by
    rw [MonoidHom.map_closure]
    congr 1
    ext g
    simp only [Set.mem_image, Subgroup.coe_subtype, hX', Set.mem_setOf_eq]
    exact ⟨fun ⟨h, hh, he⟩ => he ▸ hh, fun hg => ⟨⟨g, hX hg⟩, hg, rfl⟩⟩
  have hres : restrictAns S X = S.domHom '' X' := by
    ext p
    simp only [restrictAns, Set.mem_setOf_eq, Set.mem_image, hX']
    constructor
    · rintro ⟨g, hg, hgX, rfl⟩; exact ⟨⟨g, hg⟩, hgX, rfl⟩
    · rintro ⟨g, hgX, rfl⟩; exact ⟨g, g.2, hgX, rfl⟩
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro g hg
    refine State.mem_liftGroup.2 ⟨hX hg, Subgroup.subset_closure ⟨g, hX hg, hg, rfl⟩⟩
  · intro g hg
    obtain ⟨hgG, hgA⟩ := State.mem_liftGroup.1 hg
    rw [hres, ← MonoidHom.map_closure] at hgA
    obtain ⟨h, hh, he⟩ := hgA
    have h1 : (h : Perm Ω) ∈ Subgroup.closure X := by
      rw [← hsub]; exact ⟨h, hh, rfl⟩
    have h2 : (h : Perm Ω)⁻¹ * g ∈ Subgroup.closure X := by
      have hm : (h : Perm Ω)⁻¹ * g ∈ S.G := S.G.mul_mem (S.G.inv_mem h.2) hgG
      refine hK _ hm ?_
      have : (⟨(h : Perm Ω)⁻¹ * g, hm⟩ : S.G) = h⁻¹ * ⟨g, hgG⟩ := rfl
      rw [this, map_mul, map_inv, he, inv_mul_cancel]
    have := (Subgroup.closure X).mul_mem h1 h2
    rwa [mul_inv_cancel_left] at this

/-- **The new stage as a lift.** For lifts `g_i ∈ G` and answers `B_i ⊆ G` that are closed under
the kernel of the restriction, one of them nonempty, the closure of the translates `g_i B_i` is
the lift of the closure of their restrictions `g_i|_dom · B_i|_dom`. -/
theorem closure_translates_lift {ι : Type} (l : List ι) (g : ι → Perm Ω) (B : ι → Set (Perm Ω))
    (hg : ∀ i ∈ l, g i ∈ S.G) (hB : ∀ i ∈ l, B i ⊆ S.G)
    (hBK : ∀ i ∈ l, ∀ b ∈ B i, ∀ c (hc : c ∈ S.G), S.domHom ⟨c, hc⟩ = 1 → b * c ∈ B i)
    (hne : ∃ i ∈ l, (B i).Nonempty) :
    Subgroup.closure (⋃ i ∈ l, g i • B i) =
      S.liftGroup (Subgroup.closure (⋃ i ∈ l, ⋃ hi : i ∈ l,
        S.domHom ⟨g i, hg i hi⟩ • restrictAns S (B i))) := by
  have hX : (⋃ i ∈ l, g i • B i) ⊆ S.G := by
    intro y hy
    simp only [Set.mem_iUnion] at hy
    obtain ⟨i, hi, b, hb, rfl⟩ := hy
    exact S.G.mul_mem (hg i hi) (hB i hi hb)
  rw [closure_lift S hX ?_]
  · congr 2
    ext p
    simp only [restrictAns, Set.mem_iUnion, Set.mem_setOf_eq, Set.mem_smul_set, smul_eq_mul]
    constructor
    · rintro ⟨y, hy, ⟨i, hi, b, hb, rfl⟩, rfl⟩
      refine ⟨i, hi, hi, S.domHom ⟨b, hB i hi hb⟩, ⟨b, hB i hi hb, hb, rfl⟩, ?_⟩
      rw [← map_mul]; rfl
    · rintro ⟨i, hi, -, _, ⟨b, hbG, hb, rfl⟩, rfl⟩
      refine ⟨g i * b, S.G.mul_mem (hg i hi) hbG, ⟨i, hi, b, hb, rfl⟩, ?_⟩
      rw [← map_mul]; rfl
  · intro c hc hc1
    obtain ⟨i, hi, b, hb⟩ := hne
    have h1 : g i * b ∈ Subgroup.closure (⋃ i ∈ l, g i • B i) :=
      Subgroup.subset_closure (by simp only [Set.mem_iUnion]; exact ⟨i, hi, b, hb, rfl⟩)
    have h2 : g i * (b * c) ∈ Subgroup.closure (⋃ i ∈ l, g i • B i) :=
      Subgroup.subset_closure (by
        simp only [Set.mem_iUnion]; exact ⟨i, hi, b * c, hBK i hi b hb c hc hc1, rfl⟩)
    have := (Subgroup.closure _).mul_mem ((Subgroup.closure _).inv_mem h1) h2
    have e : (g i * b)⁻¹ * (g i * (b * c)) = c := by simp [mul_assoc]
    rwa [e] at this

/-! ### The window answers -/

variable [DecidableEq Ω] [Fintype S.dom] {C₀ : Type}

/-- The answer of a window call lies in `G`. -/
theorem windowCall_answer_le {N : Subgroup (Perm S.dom)} {V : Finset S.dom}
    (hV : GI.Algorithm.Invariant N (V : Set S.dom)) (x : S.dom → C₀) (τ : Perm S.dom) :
    (windowCall S N V hV x τ).answer ⊆ S.G := fun _ hb =>
  State.liftGroup_le N hb.1

/-- **A window answer is closed under the kernel of the restriction**: an element of `G` that acts
trivially on the domain is in the lift of `N` and fixes the window and the colors. -/
theorem windowCall_answer_mul {N : Subgroup (Perm S.dom)} {V : Finset S.dom}
    (hV : GI.Algorithm.Invariant N (V : Set S.dom)) (x : S.dom → C₀) (τ : Perm S.dom)
    {b : Perm Ω} (hb : b ∈ (windowCall S N V hV x τ).answer) {c : Perm Ω} (hc : c ∈ S.G)
    (hc1 : S.domHom ⟨c, hc⟩ = 1) : b * c ∈ (windowCall S N V hV x τ).answer := by
  obtain ⟨hbN, hcol⟩ := hb
  have hcfix : ∀ v : S.dom, c v = v := fun v => by
    have := congrArg (fun p : Perm S.dom => (p v : Ω)) hc1
    simpa using this
  have hcN : c ∈ S.liftGroup N := State.mem_liftGroup.2 ⟨hc, by rw [hc1]; exact N.one_mem⟩
  refine ⟨(S.liftGroup N).mul_mem hbN hcN, ?_⟩
  rintro _ ⟨v, hv, rfl⟩
  rw [Perm.mul_apply, hcfix v]
  exact hcol _ ⟨v, hv, rfl⟩

/-- **Some window answer is nonempty**: the representatives cover `A`, so one of them, `τ`, lies
in `N` up to the inverse, and then `τ⁻¹` maps `x ∘ τ` to `x` on the window. -/
theorem windowCall_answer_nonempty {A N : Subgroup (Perm S.dom)} (hA : A ≤ S.domGroup)
    (hNA : N ≤ A) {V : Finset S.dom} (hV : GI.Algorithm.Invariant N (V : Set S.dom))
    (x : S.dom → C₀) (τs : List (Perm S.dom)) (hmem : ∀ τ ∈ τs, τ ∈ A)
    (hcov : (A : Set (Perm S.dom)) ⊆ ⋃ τ ∈ τs, τ • (N : Set (Perm S.dom))) :
    ∃ τ ∈ τs, (windowCall S N V hV x τ).answer.Nonempty := by
  have h1 := hcov A.one_mem
  simp only [Set.mem_iUnion, Set.mem_smul_set, smul_eq_mul] at h1
  obtain ⟨τ, hτ, n, hn, hτn⟩ := h1
  refine ⟨τ, hτ, ?_⟩
  have hans := windowCall_answer S (hNA.trans hA) hV x (hA (hmem τ hτ))
  have hn' : n = τ⁻¹ := eq_inv_of_mul_eq_one_right hτn
  have hmemN : τ⁻¹ ∈ GI.Algorithm.answer N (V : Set S.dom) x (x ∘ τ) :=
    ⟨hn' ▸ hn, fun v _ => by simp⟩
  rw [← hans] at hmemN
  obtain ⟨g, -, hg, -⟩ := hmemN
  exact ⟨g, hg⟩

end Lift

/-! ### The graph form from the preimage task -/

section Graph

variable {Ω C : Type} {e : Ω ≃ Fin k} {S : State Ω C} {L : GiantLabels S}

/-- The subgroup of `G` of the elements whose positions lie in `⟨ms⟩`. -/
def posPre (ms : List (Perm (Fin k))) : Subgroup (Perm Ω) :=
  S.G ⊓ (gens ms).comap (toFin e).toMonoidHom

/-- The graph of `G ∩ toFin⁻¹⟨ms⟩` is the part of the graph of `G` with first part in `⟨ms⟩`. -/
theorem graphOf_posPre (ms : List (Perm (Fin k))) :
    graphOf e L (posPre (e := e) (S := S) ms) =
      graphOf e L S.G ⊓ (gens ms).comap (MonoidHom.fst _ _) := by
  ext p
  rw [Subgroup.mem_inf, mem_graphOf, mem_graphOf, Subgroup.mem_comap]
  constructor
  · rintro ⟨g, hg, ⟨-, hm⟩, h1, h2⟩
    refine ⟨⟨g, hg, hg, h1, h2⟩, ?_⟩
    show p.1 ∈ gens ms
    rw [← h1]; exact hm
  · rintro ⟨⟨g, hg, -, h1, h2⟩, hm⟩
    refine ⟨g, hg, ⟨hg, ?_⟩, h1, h2⟩
    show toFin e g ∈ gens ms
    rw [h1]; exact hm

/-- **The preimage task on the first parts gives the graph form of `G ∩ toFin⁻¹⟨ms⟩`.** -/
theorem pairGens_fstPre {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L S.G ps) (ms : List (Perm (Fin k)))
    (hms : ∀ m ∈ ms, ∃ p ∈ Subgroup.closure {p | p ∈ ps}, MonoidHom.fst _ _ p = m)
    {qs : List (Perm (Fin k) × Perm (Fin L.q))}
    (hqs : ∀ x : Perm (Fin (k + L.q)), x ∈ gens (qs.map encPair) ↔
      x ∈ preimageSet (pairInst (MonoidHom.fst _ _) ps ms hms)) :
    PairGens e L (posPre (e := e) (S := S) ms) qs := by
  have h : gens (qs.map encPair) = _ := Subgroup.ext fun x =>
    (hqs x).trans (preimageSet_pairInst_eq _ ps ms hms x)
  have := closure_of_gens_encPair h
  unfold PairGens
  rw [this, graphOf_posPre, hps]

/-- If `⟨ms⟩` is the image on positions of a subgroup `H ≤ G`, then `G ∩ toFin⁻¹⟨ms⟩ = H`. -/
theorem posPre_eq {H : Subgroup (Perm Ω)} (hH : H ≤ S.G) {ms : List (Perm (Fin k))}
    (h : gens ms = H.map (toFin e).toMonoidHom) : posPre (e := e) (S := S) ms = H := by
  ext g
  simp only [posPre, Subgroup.mem_inf, Subgroup.mem_comap, h, Subgroup.mem_map]
  constructor
  · rintro ⟨-, g', hg', he⟩
    have : g' = g := (toFin e).injective he
    exact this ▸ hg'
  · intro hg
    exact ⟨hH hg, g, hg, rfl⟩

end Graph

/-! ### The new stage in graph form -/

section Stage

variable {Ω C : Type} {e : Ω ≃ Fin k} {S : State Ω C} {L : GiantLabels S}

/-- The generators of the new stage: for every window call, the lift `a` of its representative
and its answer `o`. -/
def stageGens (l : List (Perm (Fin k) × Option (Perm (Fin k) × List (Perm (Fin k))))) :
    List (Perm (Fin k)) :=
  l.flatMap fun p => ansGens p.1 p.2

theorem mem_stageGens {l : List (Perm (Fin k) × Option (Perm (Fin k) × List (Perm (Fin k))))}
    {m : Perm (Fin k)} : m ∈ stageGens l ↔ ∃ p ∈ l, m ∈ ansGens p.1 p.2 := by
  simp [stageGens]

/-- `⟨⋃ Xᵢ⟩` from generators of each `⟨Xᵢ⟩`. -/
theorem gens_flatMap {ι : Type} (l : List ι) (f : ι → List (Perm (Fin k)))
    (X : ι → Set (Perm (Fin k))) (h : ∀ i ∈ l, gens (f i) = Subgroup.closure (X i)) :
    gens (l.flatMap f) = Subgroup.closure (⋃ i ∈ l, X i) := by
  apply le_antisymm
  · unfold gens
    rw [Subgroup.closure_le]
    intro m hm
    simp only [Set.mem_setOf_eq, List.mem_flatMap] at hm
    obtain ⟨i, hi, hm⟩ := hm
    have : m ∈ Subgroup.closure (X i) := by rw [← h i hi]; exact Subgroup.subset_closure hm
    refine Subgroup.closure_mono ?_ this
    exact Set.subset_biUnion_of_mem (u := X) hi
  · rw [Subgroup.closure_le]
    intro m hm
    simp only [Set.mem_iUnion] at hm
    obtain ⟨i, hi, hm⟩ := hm
    have : m ∈ gens (f i) := by rw [h i hi]; exact Subgroup.subset_closure hm
    refine (Subgroup.closure_mono ?_) this
    intro y hy
    simp only [Set.mem_setOf_eq, List.mem_flatMap]
    exact ⟨i, hi, hy⟩

/-- **The graph form of the new stage.** Let the window calls be `l`, each with a lift `a` (the
positions of an element `g_a ∈ G` whose restriction is the representative) and an answer `o`
describing `B` (`AnsSet`). If the answers lie in `G`, are closed under the kernel of the
restriction, and one is nonempty, then the output `qs` of the preimage task on the generators
`stageGens l` is a graph form of the lift of `⟨⋃ g_a|_dom · B|_dom⟩`. -/
theorem pairGens_newStage {ps : List (Perm (Fin k) × Perm (Fin L.q))}
    (hps : PairGens e L S.G ps) {ι : Type} (l : List ι)
    (a : ι → Perm (Fin k)) (o : ι → Option (Perm (Fin k) × List (Perm (Fin k))))
    (B : ι → Set (Perm Ω))
    (hg : ∀ i ∈ l, (toFin e).symm (a i) ∈ S.G) (ho : ∀ i ∈ l, AnsSet e (o i) (B i))
    (hB : ∀ i ∈ l, B i ⊆ S.G)
    (hBK : ∀ i ∈ l, ∀ b ∈ B i, ∀ c (hc : c ∈ S.G), S.domHom ⟨c, hc⟩ = 1 → b * c ∈ B i)
    (hne : ∃ i ∈ l, (B i).Nonempty)
    (hms : ∀ m ∈ stageGens (l.map fun i => (a i, o i)),
      ∃ p ∈ Subgroup.closure {p | p ∈ ps}, MonoidHom.fst _ _ p = m)
    {qs : List (Perm (Fin k) × Perm (Fin L.q))}
    (hqs : ∀ x : Perm (Fin (k + L.q)), x ∈ gens (qs.map encPair) ↔
      x ∈ preimageSet (pairInst (MonoidHom.fst _ _) ps _ hms)) :
    PairGens e L (S.liftGroup (Subgroup.closure (⋃ i ∈ l, ⋃ hi : i ∈ l,
      S.domHom ⟨(toFin e).symm (a i), hg i hi⟩ • restrictAns S (B i)))) qs := by
  have h1 := pairGens_fstPre hps _ hms hqs
  have hcl := closure_translates_lift S l (fun i => (toFin e).symm (a i)) B hg hB hBK hne
  rw [← hcl]
  convert h1 using 1
  symm
  refine posPre_eq ?_ ?_
  · rw [Subgroup.closure_le]
    intro y hy
    simp only [Set.mem_iUnion] at hy
    obtain ⟨i, hi, b, hb, rfl⟩ := hy
    exact S.G.mul_mem (hg i hi) (hB i hi hb)
  · rw [MonoidHom.map_closure]
    unfold stageGens
    rw [List.flatMap_map]
    rw [gens_flatMap l _ (fun i => toFin e '' ((toFin e).symm (a i) • B i))
      fun i hi => closure_ansGens e (a i) (o i) (B i) (ho i hi)]
    congr 1
    ext y
    simp only [Set.mem_iUnion, Set.mem_image, MulEquiv.coe_toMonoidHom]
    constructor
    · rintro ⟨i, hi, z, hz, rfl⟩; exact ⟨z, ⟨i, hi, hz⟩, rfl⟩
    · rintro ⟨z, ⟨i, hi, hz⟩, rfl⟩; exact ⟨i, hi, z, hz, rfl⟩

end Stage

end GI.Impl
